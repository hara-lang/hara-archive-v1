#!/usr/bin/env python3
"""Generate the HARA-2 serialized language metadata migration.

The structural namespace cut is already complete. This script rewrites only
Hara-owned keyword literals and installs bounded legacy readers at named
metadata boundaries. It is deterministic and safe to run repeatedly.
"""

from __future__ import annotations

import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TEXT_SUFFIXES = {
    ".clj",
    ".cljs",
    ".edn",
    ".hal",
    ".java",
    ".js",
    ".json",
    ".md",
    ".rs",
    ".toml",
    ".ts",
    ".xml",
    ".yaml",
    ".yml",
}
REWRITE_ROOTS = (
    Path("core/lib/src/lang"),
    Path("core/lib/test-lang/lang"),
    Path("core/lib/integration"),
    Path("core/java/src"),
    Path("core/spec"),
)
EXCLUDED = {
    Path("core/spec/fixtures/lang-metadata-v1/legacy.edn"),
    Path("core/spec/fixtures/lang-metadata-v1/README.md"),
}


def write(path: Path, source: str) -> None:
    path.write_text(source, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    path = ROOT / relative
    source = path.read_text(encoding="utf-8")
    if new in source:
        return
    if old not in source:
        raise SystemExit(f"migration anchor not found in {relative}: {old[:80]!r}")
    write(path, source.replace(old, new, 1))


def insert_before(relative: str, anchor: str, insertion: str, marker: str) -> None:
    path = ROOT / relative
    source = path.read_text(encoding="utf-8")
    if marker in source:
        return
    if anchor not in source:
        raise SystemExit(f"migration insertion anchor not found in {relative}: {anchor!r}")
    write(path, source.replace(anchor, insertion + anchor, 1))


def rewrite_keyword_literals() -> tuple[int, int]:
    changed_files = 0
    replacements = 0
    for relative_root in REWRITE_ROOTS:
        root = ROOT / relative_root
        if not root.exists():
            continue
        for path in root.rglob("*"):
            if not path.is_file() or path.suffix.lower() not in TEXT_SUFFIXES:
                continue
            relative = path.relative_to(ROOT)
            if relative in EXCLUDED:
                continue
            source = path.read_text(encoding="utf-8")
            count = source.count(":tahto/") + source.count(":tahto.")
            if count == 0:
                continue
            rewritten = source.replace(":tahto/", ":lang/")
            rewritten = rewritten.replace(":tahto.", ":lang.")
            write(path, rewritten)
            changed_files += 1
            replacements += count
    return changed_files, replacements


# The canonical Hara implementation is the source of truth.  Keep this
# legacy migration coordinator on the native Hara implementation instead of
# carrying a second, drift-prone copy of generated Hara source.
PROVENANCE_SOURCE = (ROOT / "core/lib/src/lang/common/provenance.hal").read_text(
    encoding="utf-8"
)


def patch_compiler() -> None:
    path = "core/lib/src/lang/common/compiler.hal"
    replace_once(
        path,
        "(:require [lang.common.emit :as emit]",
        "(:require [lang.common.compat :as compat]\n            [lang.common.emit :as emit]",
    )
    replace_once(
        path,
        "    (merge entry\n           (or (first value) {})\n           {:form-input (second value)})",
        "    (merge entry\n           (compat/canonicalize-map (or (first value) {}))\n           {:form-input (second value)})",
    )
    replace_once(
        path,
        "        {:entry (merge entry\n                       (or (:metadata value) {})\n                       (or (:entry value) {}))",
        "        {:entry (merge entry\n                       (compat/canonicalize-map (or (:metadata value) {}))\n                       (compat/canonicalize-map (or (:entry value) {})))",
    )
    replace_once(
        path,
        "        (let [metadata (or (first value) {})]",
        "        (let [metadata (compat/canonicalize-map (or (first value) {}))]",
    )
    replace_once(
        path,
        "      (if (map? value)\n        (if (:entry value)\n          value\n          (assoc value :entry qualified))\n        (diagnostic",
        "      (if (map? value)\n        (let [value (compat/canonicalize-map value)]\n          (if (:entry value)\n            value\n            (assoc value :entry qualified)))\n        (diagnostic",
    )
    replace_once(
        path,
        "      {:grammar (:provenance selected)",
        "      {:grammar (compat/canonicalize-map (:provenance selected))",
    )
    replace_once(
        path,
        "  (compile-form [compiler raw selected context]\n    (let [normalized",
        "  (compile-form [compiler raw selected context]\n    (let [context (compat/canonicalize-map context)\n          normalized",
    )
    replace_once(
        path,
        "  (compile-entry [compiler entry selected context]\n    (let [formatted",
        "  (compile-entry [compiler entry selected context]\n    (let [entry (compat/canonicalize-map entry)\n          context (compat/canonicalize-map context)\n          formatted",
    )
    replace_once(
        path,
        "  ([publisher compiled context]\n   (let [selected (:grammar compiled)\n         entry (:entry compiled)",
        "  ([publisher compiled context]\n   (let [context (compat/canonicalize-map context)\n         selected (:grammar compiled)\n         entry (compat/canonicalize-map (:entry compiled))",
    )


def patch_emit() -> None:
    path = "core/lib/src/lang/common/emit.hal"
    replace_once(
        path,
        "(:require [std.foundation.string :as string]",
        "(:require [std.foundation.string :as string]\n            [lang.common.compat :as compat]",
    )
    replace_once(
        path,
        "  ([form selected context]\n   (emit-main form\n              (default-grammar (or (:grammar selected) selected))\n              context))",
        "  ([form selected context]\n   (emit-main form\n              (default-grammar (or (:grammar selected) selected))\n              (compat/canonicalize-map context)))",
    )
    replace_once(
        path,
        "   (let [mopts (select-keys mopts +option-keys+)]",
        "   (let [mopts (select-keys (compat/canonicalize-map mopts)\n                            +option-keys+)]",
    )


def patch_emit_rewrite() -> None:
    path = "core/lib/src/lang/common/emit_rewrite.hal"
    replace_once(
        path,
        "(ns lang.common.emit-rewrite)",
        "(ns lang.common.emit-rewrite\n  (:require [lang.common.compat :as compat]))",
    )
    replace_once(
        path,
        "        explicit (:lang/xtalk-context mopts)",
        "        explicit (compat/read-key mopts :lang/xtalk-context)",
    )


def patch_postgres() -> None:
    enum_path = "core/lib/src/lang/model/v1/spec_postgres/enum.hal"
    replace_once(
        enum_path,
        "(:require [std.foundation.string :as string]",
        "(:require [std.foundation.string :as string]\n            [lang.common.compat :as compat]",
    )
    replace_once(
        enum_path,
        "    (let [evaluator (or (:lang/eval-literal context)\n                        (:eval-literal context))]",
        "    (let [evaluator (or (compat/read-key context :lang/eval-literal)\n                        (:eval-literal context))]",
    )

    const_path = "core/lib/src/lang/model/v1/spec_postgres/const.hal"
    replace_once(
        const_path,
        "(:require [std.foundation.string :as string]",
        "(:require [std.foundation.string :as string]\n            [lang.common.compat :as compat]",
    )
    replace_once(
        const_path,
        "    (let [evaluator (or (:lang/eval-literal context)\n                        (:eval-literal context))]",
        "    (let [evaluator (or (compat/read-key context :lang/eval-literal)\n                        (:eval-literal context))]",
    )


def patch_evaluation() -> None:
    path = "core/lib/src/lang/core/eval.hal"
    replace_once(
        path,
        "(:require [std.foundation.promise :as promise]",
        "(:require [std.foundation.promise :as promise]\n            [lang.common.compat :as compat]",
    )
    replace_once(
        path,
        "  [id version phase transform]\n  (let [plugin {:id id",
        "  [id version phase transform]\n  (let [id (compat/canonical-key id)\n        plugin {:id id",
    )
    replace_once(
        path,
        "(defn plugin\n  [coordinate]\n  (or (get (deref +plugins+) coordinate)\n      (throw\n       (ex-info \"Evaluation plugin is not registered\"\n                {:plugin coordinate\n                 :registered (keys (deref +plugins+))}))))",
        "(defn plugin\n  [coordinate]\n  (let [coordinate (compat/canonical-coordinate coordinate)]\n    (or (get (deref +plugins+) coordinate)\n        (throw\n         (ex-info \"Evaluation plugin is not registered\"\n                  {:plugin coordinate\n                   :registered (keys (deref +plugins+))}))))",
    )


def patch_runtime() -> None:
    path = "core/lib/src/lang/core/runtime.hal"
    replace_once(
        path,
        "(:require [lang.protocol.runtime :as context-eval]",
        "(:require [lang.protocol.runtime :as context-eval]\n            [lang.common.compat :as compat]",
    )
    replace_once(
        path,
        "  [language runtime spec]\n  (let [entry (merge {:lang language\n                      :runtime runtime}\n                     spec)]",
        "  [language runtime spec]\n  (let [spec (compat/canonicalize-map spec)\n        spec (if (keyword? (:type spec))\n               (assoc spec :type (compat/canonical-key (:type spec)))\n               spec)\n        entry (merge {:lang language\n                      :runtime runtime}\n                     spec)]",
    )


def patch_compiler_test() -> None:
    path = "core/lib/test-lang/lang/common/compiler_test.hal"
    legacy_definitions = """(def legacy-actor-key (keyword \"tahto/actor\"))
(def legacy-source-key (keyword \"tahto/source\"))
(def legacy-work-key (keyword \"tahto/work\"))

(def compiled-legacy
  (compiler/compile
   instance '(+ 1 2) selected-v1
   (assoc {}
          legacy-actor-key :build/legacy
          legacy-source-key :source/legacy
          legacy-work-key :artifact/legacy)))

"""
    insert_before(path, "(def compiled-jsx", legacy_definitions, "(def compiled-legacy")
    legacy_fact = """(fact \"legacy worklog metadata is read but canonical output is written\"
  [(get-in compiled-legacy [:provenance :lang/actor])
   (get-in compiled-legacy [:provenance :lang/source])
   (get-in compiled-legacy [:provenance :lang/work])
   (has? (:provenance compiled-legacy) legacy-actor-key)
   (has? (:provenance compiled-legacy) legacy-source-key)
   (has? (:provenance compiled-legacy) legacy-work-key)]
  => [:build/legacy
      :source/legacy
      :artifact/legacy
      false
      false
      false])

"""
    insert_before(
        path,
        "(fact \"entry hydration returns schema contributions without publishing\"",
        legacy_fact,
        "legacy worklog metadata is read",
    )


def patch_namespace_plan() -> None:
    replace_once(
        "plans/lang-namespace-migration.md",
        "- Serialized data vocabulary such as `:tahto/error-code`, `:tahto/phase`, and\n  `:tahto/provenance` does not change in this structural migration.",
        "- Serialized data vocabulary was deliberately deferred from this structural\n  migration and is moved by HARA-2; see `plans/lang-metadata-migration.md`.",
    )


def run(*arguments: str) -> None:
    subprocess.run(arguments, cwd=ROOT, check=True)


def main() -> None:
    if not (ROOT / "core/lib/src/lang").is_dir():
        raise SystemExit("HARA-2 requires the completed lang.* namespace cut")
    if (ROOT / "core/lib/src/tahto").exists():
        raise SystemExit("legacy compiler namespace tree still exists")

    changed_files, replacements = rewrite_keyword_literals()
    patch_compiler()
    write(ROOT / "core/lib/src/lang/common/provenance.hal", PROVENANCE_SOURCE)
    patch_emit()
    patch_emit_rewrite()
    patch_postgres()
    patch_evaluation()
    patch_runtime()
    patch_compiler_test()
    patch_namespace_plan()

    run("python3", "scripts/runtime/sync-rust-hal-src")
    run("python3", "scripts/runtime/check-language-source-layout")
    run("python3", "scripts/runtime/check-no-tahto-namespaces")
    run("python3", "scripts/runtime/check-no-tahto-language-metadata")
    run("python3", "scripts/runtime/sync-rust-hal-src", "--check")
    run("git", "diff", "--check")

    print(
        "generated HARA-2 metadata migration: "
        f"{changed_files} files, {replacements} literal replacements"
    )


if __name__ == "__main__":
    main()
