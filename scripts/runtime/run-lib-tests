#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROJECT_ROOT="$REPO_ROOT/core"
cd "$REPO_ROOT"

backend=""
while (($#)); do
    case "$1" in
        --backend)
            if (($# < 2)); then
                echo "Missing value for --backend" >&2
                exit 2
            fi
            backend="$2"
            shift 2
            ;;
        --backend=*)
            backend="${1#*=}"
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [[ -n "$backend" && "$backend" != "interpreter" && "$backend" != "native" ]]; then
    echo "Unsupported Hara test backend: $backend" >&2
    exit 2
fi

collect_root() {
    local root="$1"
    if [ -d "$root" ]; then
        find "$root" -name '*.hal' \
            ! -name '.#*' ! -name '#*#' \
            -print
    fi
}

collect_files() {
    if [ "$#" -eq 0 ]; then
        collect_root core/lib/test
        collect_root core/lib/test-lang
        return
    fi

    local target
    for target in "$@"; do
        if [ -d "$target" ]; then
            find "$target" -name '*.hal' \
                ! -name '.#*' ! -name '#*#' \
                -print
        elif [ -f "$target" ]; then
                printf '%s\n' "$target"
        else
            echo "Test target not found: $target" >&2
            return 2
        fi
    done
}

mapfile -t TEST_FILES < <(collect_files "$@" | sort -u)

if [ "${#TEST_FILES[@]}" -eq 0 ]; then
    echo "No library test files selected" >&2
    exit 2
fi

ABSOLUTE_TEST_FILES=()
for test_file in "${TEST_FILES[@]}"; do
    if [[ "$test_file" = /* ]]; then
        ABSOLUTE_TEST_FILES+=("$test_file")
    else
        ABSOLUTE_TEST_FILES+=("$REPO_ROOT/$test_file")
    fi
done

HARA_TEST_ARGS=(--root "$PROJECT_ROOT")
if [[ -n "$backend" ]]; then
    HARA_TEST_ARGS+=(--backend "$backend")
fi

exec cargo run --quiet \
    --manifest-path "$REPO_ROOT/core/rust/Cargo.toml" \
    --bin hara-test -- \
    "${HARA_TEST_ARGS[@]}" \
    "${ABSOLUTE_TEST_FILES[@]}"
