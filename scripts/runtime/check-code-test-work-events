#!/usr/bin/env python3
"""Require a Foundation-style code.test facade and one canonical work graph."""

from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2]
FACADE = ROOT / "core/lib/src/code/test.hal"
EVENT_OWNER = ROOT / "core/lib/src/code/test/work.hal"
INTERNAL_ROOT = ROOT / "core/lib/src/code/test"

CANONICAL = [FACADE] + sorted(
    path for path in INTERNAL_ROOT.rglob("*.hal") if path.is_file()
)
AUDIT_ROOTS = [ROOT / "core/lib/src/code", ROOT / "core/lib/test/code"]
AUDIT_FILES = [ROOT / "core/lib/test/std/platform_imatch_test.hal"]
RETIRED_PATHS = [
    ROOT / "core/lib/src/code/test/protocol.hal",
    ROOT / "core/lib/src/code/test/task.hal",
]

FORBIDDEN_RUNTIME = [
    "code.test.protocol",
    "(defn report-event",
    "(defn report!",
    "(defn work-event-kind",
    "(defn work-reporter",
    "(defn reporter-for",
    "(defn event-reporter",
    "(defn reporter-events",
    "(defn function-clock",
    "(defn function-timer",
    "(defn function-control",
    "(defn run-selected",
    "(defn run-facts",
    "(defn run-fact-with-events",
    "(defn suite-work",
    "(defn remaining-items",
    "(defn cancelled-fact-result",
    "(defn cancelled-fact-results",
    "WorkReporter",
    "ITestReporter",
    ":test/reporter",
    ":test/clock",
    ":test/timer",
    ":test/control",
    ":run/start",
    ":run/end",
    ":fact/start",
    ":fact/end",
]
REQUIRED_EVENTS = [
    ":test/run-started",
    ":test/fact-started",
    ":test/fact-completed",
    ":test/run-completed",
]
REQUIRED_GRAPH = [
    "(def +runner-work+ (runner-work +default-revision+))",
    "code.test/fact-batch-items",
    "code.test/suite-scope",
    "code.test/fact-stop",
    "code.test/fact-cancel",
    "(defn resolve-subject-fact",
    "(defn fact-batch-work",
    "(defn run",
    "(defn start",
]
REQUIRED_FACADE = [
    "[code.test.cli :as cli]",
    "(def check process/check)",
    "(def register runtime/register)",
    "(def run test-work/run)",
    "(def start test-work/start)",
    "(def +runner-work+ test-work/+runner-work+)",
    "(defmacro fact",
    "(defmacro fact:global",
    "(def print-options cli/print-options)",
    "(def process-test-args cli/process-run-args)",
    "(def -main executive/main)",
]
FORBIDDEN_FACADE = [
    "[std.work",
    "(defstruct Matcher",
    "(defstruct ThrownValue",
    "(defstruct TimeoutValue",
    "(def +registry+",
    "(defn fact-registry-key",
    "(defn assertion-forms",
    "(def contains-in-form",
    "(def just-in-form",
    "(defn selector-match?",
    "(defn result-counts",
    "(defn fact-coordinate",
    "(defn fact-batch-work",
    "(defn runner-work",
    "work/emit!",
    "(work/step",
    "(work/batch",
    "[code.test.task",
    "task/print-options",
    "task/process-run-args",
    "task/main",
]
GRAPH_TOKENS = [
    "code.test/fact-batch-items",
    "code.test/suite-scope",
    "code.test/fact-stop",
    "code.test/fact-cancel",
]

errors = []

for path in RETIRED_PATHS:
    if path.exists():
        errors.append(f"retired code.test namespace exists: {path.relative_to(ROOT)}")

paths = []
for audit_root in AUDIT_ROOTS:
    if audit_root.exists():
        paths.extend(path for path in audit_root.rglob("*.hal") if path.is_file())
paths.extend(path for path in AUDIT_FILES if path.exists())
for path in paths:
    source = path.read_text(encoding="utf-8")
    for token in FORBIDDEN_RUNTIME:
        if token in source:
            errors.append(
                f"{path.relative_to(ROOT)} retains private test-runtime token {token!r}"
            )

owner_source = EVENT_OWNER.read_text(encoding="utf-8")
for token in REQUIRED_EVENTS + REQUIRED_GRAPH:
    if token not in owner_source:
        errors.append(f"{EVENT_OWNER.relative_to(ROOT)} is missing {token!r}")
if re.search(r"\[code\.test(?:\s|\])", owner_source):
    errors.append("code.test.work points back to the root facade")

facade_source = FACADE.read_text(encoding="utf-8")
for token in REQUIRED_FACADE:
    if token not in facade_source:
        errors.append(f"{FACADE.relative_to(ROOT)} is missing facade entry {token!r}")
for token in FORBIDDEN_FACADE + REQUIRED_EVENTS + GRAPH_TOKENS:
    if token in facade_source:
        errors.append(f"{FACADE.relative_to(ROOT)} is not facade-only: found {token!r}")
if re.search(r"^\(defn\s", facade_source, re.MULTILINE):
    errors.append(f"{FACADE.relative_to(ROOT)} contains a function implementation")

internal_sources = list(INTERNAL_ROOT.rglob("*.hal"))
root_require = re.compile(r"\[code\.test(?:\s|\])")
for path in internal_sources:
    source = path.read_text(encoding="utf-8")
    if root_require.search(source):
        errors.append(f"{path.relative_to(ROOT)} requires the root code.test facade")
    if path != EVENT_OWNER:
        for token in REQUIRED_EVENTS + GRAPH_TOKENS:
            if token in source:
                errors.append(
                    f"{path.relative_to(ROOT)} duplicates work-owned lifecycle token {token!r}"
                )

checker_source = (ROOT / "core/lib/src/code/test/checker/common.hal").read_text(
    encoding="utf-8"
)
if "(extend-type Checker IMatch" not in checker_source:
    errors.append("code.test.checker.common does not own the IMatch implementation")

cli_source = (ROOT / "core/lib/src/code/test/cli.hal").read_text(
    encoding="utf-8"
)
for token in ["(defn print-options", "(defn process-run-args"]:
    if token not in cli_source:
        errors.append(f"code.test.cli does not own canonical adapter {token!r}")

executive_source = (ROOT / "core/lib/src/code/test/base/executive.hal").read_text(
    encoding="utf-8"
)
if "(defn main" not in executive_source:
    errors.append("code.test.base.executive does not own the executable main adapter")

compile_source = (ROOT / "core/lib/src/code/test/compile.hal").read_text(
    encoding="utf-8"
)
for token in [
    "code.test.base.runtime/register",
    "code.test.base.process/check",
]:
    if token not in compile_source:
        errors.append(f"code.test.compile does not emit qualified canonical call {token!r}")

inventory = ROOT / "core/rust/standard-library.namespaces"
if inventory.exists():
    inventory_namespaces = inventory.read_text(encoding="utf-8").splitlines()
    for retired in ["code.test.protocol", "code.test.task"]:
        if retired in inventory_namespaces:
            errors.append(
                f"retired {retired} remains in the Rust namespace inventory"
            )

if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)

print(
    "code.test is a curated facade; code.test.work owns one durable fact-batch graph, "
    "and code.test.task is retired"
)
