#!/usr/bin/env bash
set -euo pipefail

language="${1:-}"

check_rust_format() {
  local base_sha="${CONNECTOR_BASE_SHA:-}"
  local head_sha="${CONNECTOR_HEAD_SHA:-}"

  if [[ "${CONNECTOR_FORMAT_SCOPE:-all}" != "changed" \
    || -z "$base_sha" || -z "$head_sha" ]] \
    || ! git cat-file -e "${base_sha}^{commit}" 2>/dev/null \
    || ! git cat-file -e "${head_sha}^{commit}" 2>/dev/null; then
    cargo fmt --manifest-path core/rust/Cargo.toml --all -- --check
    return
  fi

  local -a rust_files=()
  local file
  while IFS= read -r file; do
    if [[ "$file" == *.rs && -f "$file" ]]; then
      rust_files+=("$file")
    fi
  done < <(git diff --name-only "$base_sha" "$head_sha" -- core/rust)

  if ((${#rust_files[@]})); then
    rustfmt --edition 2021 --check "${rust_files[@]}"
  fi
}

case "$language" in
  rust)
    check_rust_format
    cargo clippy --manifest-path core/rust/Cargo.toml --all-targets
    cargo clippy --manifest-path core/rust/Cargo.toml --package hara-runtime --all-targets
    cargo test --manifest-path core/rust/Cargo.toml
    cargo test --manifest-path core/rust/Cargo.toml --package hara-runtime --lib
    cargo test --manifest-path core/rust/raw/Cargo.toml
    cargo run --manifest-path core/rust/Cargo.toml --bin hara -- eval '(+ 19 23)'
    ;;
  java)
    mvn -B -Ptruffle package --file core/java/pom.xml
    ./core/hara eval '(+ 19 23)'
    ;;
  hal)
    ./scripts/runtime/run-lib-tests
    ;;
  wasm)
    npm ci --prefix core/rust/web
    npm run test:hta --prefix core/rust/web
    npm run test:browser-packages --prefix core/rust/web
    ;;
  *)
    printf 'usage: %s <rust|java|hal|wasm>\n' "$0" >&2
    exit 2
    ;;
esac
