#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

VARIANT="${1:-vm}"

build_variant() {
  name="$1"
  features="$2"
  target_dir="$ROOT/core/target/raw-$name"
  arguments=(
    --manifest-path core/rust/raw/Cargo.toml
    --target wasm32-unknown-unknown
    --profile browser-release
  )
  if [[ -n "$features" ]]; then
    arguments+=(--features "$features")
  fi
  CARGO_TARGET_DIR="$target_dir" "$ROOT/scripts/runtime/cargo-wasm-build" "${arguments[@]}"
  source="$target_dir/wasm32-unknown-unknown/browser-release/hara_wasm_raw.wasm"
  output="$ROOT/core/rust/raw/target/wasm32-unknown-unknown/browser-release/$name.wasm"
  mkdir -p "$(dirname "$output")"
  cp "$source" "$output"
  echo "Built $output"
}

case "$VARIANT" in
  core|hara-wasm-core) build_variant hara-wasm-core "" ;;
  vm|hara-wasm-vm) build_variant hara-wasm-vm bytecode-vm ;;
  trace|hara-wasm-trace) build_variant hara-wasm-trace dev-trace ;;
  all)
    build_variant hara-wasm-core ""
    build_variant hara-wasm-vm bytecode-vm
    build_variant hara-wasm-trace dev-trace
    ;;
  *) echo "usage: $0 [core|vm|trace|all]" >&2; exit 2 ;;
esac
