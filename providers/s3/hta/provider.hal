;; Rich HTA provider source for hara/filesystem-s3.
;; Object-storage credentials, signing, HTTP, and bounded transfers remain in
;; the trusted host. The shared module supplies the portable façade.
(ns hara.hta.provider
  (:require [hara.hta.provider.common :as common]))

(def SERVICE "filesystem.s3")
(def ROUTE "hta-wasm")
(def provider (common/Provider SERVICE ROUTE))

(defn ^{:public true} dispatch
  [operation arguments]
  (common/dispatch provider operation arguments))
