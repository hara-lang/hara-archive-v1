;; Rich HTA provider source for hara/filesystem-github.
;; GitHub credentials, HTTP, Git object creation, and expected-head updates
;; remain in the trusted host. The shared module supplies the portable
;; filesystem protocol and apply-based façade.
(ns hara.hta.provider
  (:require [hara.hta.provider.common :as common]))

(def SERVICE "filesystem.github")
(def ROUTE "hta-wasm")
(def provider (common/Provider SERVICE ROUTE))

(defn ^{:public true} dispatch
  [operation arguments]
  (common/dispatch provider operation arguments))
