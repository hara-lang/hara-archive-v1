;; Rich HTA provider source for hara/filesystem-google-drive.
;; Drive IDs, OAuth tokens, REST transport, and bounded transfers remain in
;; the trusted host. The shared module supplies the portable façade.
(ns hara.hta.provider
  (:require [hara.hta.provider.common :as common]))

(def SERVICE "filesystem.google-drive")
(def ROUTE "hta-wasm")
(def provider (common/Provider SERVICE ROUTE))

^{:public true}
(defn dispatch
  [operation arguments]
  (common/dispatch provider operation arguments))
