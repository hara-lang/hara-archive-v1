{:namespace "fs.webdav.wasm.hta"
 :identity "hara/filesystem-webdav"
 :version "0.1.0"
 :provider :hta
 :abi :hta.v1
 :targets
 {:browser
  {:provider "browser/provider.mjs"
   :runtime :web-worker}}
 :capabilities [:filesystem :network]
 :host-calls
 {"filesystem.webdav"
  {:methods ["open" "request" "cancel" "close"]
   :capabilities [:filesystem :network]}}
 :exports
 {"describe" {:args [] :returns :value}
  "open" {:args [:options] :returns :value}
  "descriptor" {:args [:filesystem] :returns :value}
  "stat" {:args [:filesystem :path] :returns :value}
  "read" {:args [:filesystem :path] :returns :bytes}
  "write" {:args [:filesystem :path :bytes :options :mutation] :returns :value}
  "entries-page" {:args [:filesystem :path :request] :returns :value}
  "mkdir" {:args [:filesystem :path :options :mutation] :returns :value}
  "delete" {:args [:filesystem :path :options :mutation] :returns :value}
  "copy" {:args [:filesystem :source :target :options :mutation] :returns :value}
  "move" {:args [:filesystem :source :target :options :mutation] :returns :value}
  "close" {:args [:filesystem] :returns :value}}}
