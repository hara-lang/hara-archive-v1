;; Rich HTA provider source for hara/filesystem-sftp.
;; SSH credentials, host-key verification, SFTP connections, and transport
;; bounds remain in the trusted host. The shared module supplies the façade.
(ns hara.hta.provider
  (:require [hara.hta.provider.common :as common]))

(def SERVICE "filesystem.sftp")
(def ROUTE "hta-wasm")
(def provider (common/Provider SERVICE ROUTE))

(defn ^{:public true} dispatch
  [operation arguments]
  (common/dispatch provider operation arguments))
