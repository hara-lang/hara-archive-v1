(def legacy-operations
  [:analyse :extract :vars :docstrings :transform-code :import :purge
   :missing :todos :incomplete :incomplete-report :orphaned :scaffold
   :create-tests :in-order :arrange :factcheck-remove :factcheck-generate
   :snapto :isolate :locate-code :locate-test :grep :grep-replace :unclean
   :unchecked :commented :pedantic :refactor-code :refactor-test :ns-format
   :ns-rename :find-usages :require-file :heal-code])

(def editing-operations
  #{:transform-code :import :purge :scaffold :create-tests :arrange
    :factcheck-remove :factcheck-generate :snapto :isolate :grep-replace
    :refactor-code :refactor-test :ns-format :ns-rename :heal-code})

(def parity-inventory
  (reduce
   (fn [output operation]
     (assoc
      output
      operation
       {:status :supported
       :boundary
       (if (has? editing-operations operation)
         :pure-edit-plan
         :portable-inspection)}))
   {}
   legacy-operations))

(def +tasks+
  {:analyse analyse
   :extract extract
   :vars vars
   :docstrings docstrings
   :transform-code transform-code
   :import import
   :purge purge
   :missing missing
   :todos todos
   :incomplete incomplete
   :orphaned orphaned
   :scaffold scaffold
   :create-tests create-tests
   :in-order in-order?
   :arrange arrange
   :factcheck-remove factcheck-remove
   :factcheck-generate factcheck-generate
   :snapto snapto
   :isolate isolate
   :locate-code locate-code
   :locate-test locate-test
   :grep grep
   :grep-replace grep-replace
   :unclean unclean
   :unclean-findings unclean-findings
   :unchecked unchecked
   :commented commented
   :pedantic pedantic
   :refactor-code refactor-code
   :refactor-test refactor-test
   :ns-format ns-format
   :ns-rename ns-rename
   :find-usages find-usages
   :require-file require-file
   :heal-code heal-code})

(def operation-tasks +tasks+)

(defn command-task
  [operation]
  (or
   (get +tasks+ operation)
   (throw
   (ex :host {:operation operation} :ex/message "Unsupported code.manage workflow"))))

(defn result-edit
  [value]
  (if (and (map? value)
           (has? value :after))
    value
    nil))

(defn result-findings
  [value]
  (cond
    (and (map? value) (:finding value))
    [(:finding value)]

    (vector? value)
    (vec
     (filter
      (fn [entry]
        (and (map? entry)
             (:kind entry)))
      value))

    :else
    []))

(defn plan
  [operation input]
  (let [task-value (command-task operation)
        batch
        (work/run work/default-host task-value (context/task-input input))
        records (batch-records batch)
        values
        (vec
         (map
          (fn [record]
            (:data record))
          records))
        edits
        (vec
         (filter identity
                 (map result-edit values)))
        findings
        (reduce
         (fn [output value]
           (into output
                 (result-findings value)))
         []
         values)
        warnings
        (vec
         (filter
          (fn [record]
            (= :warn (:status record)))
          records))
        errors
        (vec
         (filter
          (fn [record]
            (or
             (= :error (:status record))
             (= :critical (:status record))))
          records))]
    {:operation operation
     :records records
     :results
     (vec
      (map
       (fn [record]
         {:item/id (:item/id record)
          :item/value (:data record)})
       records))
     :edits edits
     :findings findings
     :warnings warnings
     :errors errors
     :summary
     {:operation operation
      :count (count records)
      :changed
      (count
       (filter
        (fn [edit]
          (:changed edit))
        edits))
      :findings (count findings)
      :warnings (count warnings)
      :errors (count errors)}}))

(defn maintenance-work
  [operation]
  (command-task operation))

(defn run
  [operation input]
  (if (= operation :incomplete-report)
    (incomplete-report (:units input))
    (work/run work/default-host
              (command-task operation)
              (context/task-input input))))
