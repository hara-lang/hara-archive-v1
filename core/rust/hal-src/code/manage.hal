(ns code.manage
  (:config {:override [import]})
  (:require [code.manage.automation :as automation]
            [code.manage.context :as context]
            [code.manage.ns-format :as manage-format]
            [code.manage.ns-rename :as manage-rename]
            [code.manage.unit :as unit]
            [code.manage.unit.contract :as contract]
            [code.manage.unit.factcheck :as factcheck]
            [code.manage.unit.import :as unit-import]
            [code.manage.unit.isolate :as unit-isolate]
            [code.manage.unit.require :as unit-require]
            [code.manage.unit.scaffold :as unit-scaffold]
            [code.manage.unit.snapto :as unit-snapto]
            [code.manage.unit.template :as template]
            [code.manage.var :as var]
            [work.base :as work]))

;; Atomic operations live under code.manage.unit.*.  This namespace owns the
;; public task values composed around those tasklets, matching Foundation.

(defn- composed-task
  [operation tasklet-reference tasklet argcount]
  (template/task
   {:operation operation
    :construct
    {:input (fn [definition]
              (context/current-input operation
                                     (current-namespace)
                                     definition))}
    :main
    {:fn tasklet
     :symbol tasklet-reference
     :argcount argcount}}))

(def analyse
  (composed-task
   :analyse
   'code.manage.unit/analyse
   unit/analyse
   1))

(def extract
  (composed-task
   :extract
   'code.manage.unit/extract
