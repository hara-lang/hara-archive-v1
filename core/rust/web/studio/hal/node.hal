(ns studio.node
  (:require [std.substrate.frame :as frame]
            [std.substrate.json :as wire]))

;; The browser host binds this dynamically for every document generation.
;; ns+ source never receives or exposes its generated private module name.
(def ^:dynamic *node-id* nil)
(def ^:private *next-task* (atom 0))
(def ^:private *active-task* (atom nil))
(def ^:private *next-handler* (atom 0))
(def ^:private *handlers* (atom []))

(defn- require-node []
  (if *node-id*
    *node-id*
    (throw "node operation requires an active workspace node")))

(defn current-id []
  (require-node))

(defn start [f]
  (let [id (String/join "" ["task-" (str (swap! *next-task* inc))])
        node-id (require-node)]
    (do
      ;; The callback starts in a later HTA evaluation. Capture its document
      ;; node now instead of relying on the dynamic root surviving that task
      ;; boundary.
      (reset! *active-task* [id node-id f])
      id)))

(defn run-task [id]
  ;; Referring to *active-task* yields the atom itself. Dereference it once to
  ;; obtain [task-id node-id callback]; a second deref incorrectly treats that
  ;; vector as a reference and prevents every canvas generation from starting.
  (let [entry (deref *active-task*)]
    (if (= id (nth entry 0))
      (do
        ;; A task is launched by a separate session evaluation. Restore the
        ;; node captured by start before any draw/node host call is attempted.
        (set! *node-id* (nth entry 1))
        ((nth entry 2)))
      (throw (str "unknown node task " id)))))

(defn in [signal]
  (Host/call "node" "in" [(require-node) signal]))

(defn in-frame [signal]
  ;; Frames arriving from the browser transport are normalized through the
  ;; portable substrate contract before document code observes them.
  (wire/normalize-frame
   (Host/call "node" "in-frame" [(require-node) signal])))

(defn emit
  ([signal value]
   (emit signal value {}))
  ([signal value meta]
   (Host/call
    "node" "emit-frame"
    [(require-node)
     (wire/frame-create :stream (frame/rand-id "evt-" 6)
                         {:source (require-node)
                          :signal signal
                          :data value
                          :cause (get meta :cause)
                          :meta meta})])))

(defn call
  ([target action args]
   (call target action args {}))
  ([target action args opts]
   (Host/call
    "node" "call-frame"
    [(require-node)
     (wire/frame-create :request (get opts :id (frame/rand-id "req-" 6))
                         {:source (require-node)
                          :target target
                          :space (get opts :space)
                          :action action
                          :args args
                          :cause (get opts :cause)
                          :meta (get opts :meta {})})])))

(defn find-handler [entries handler-id index]
  (if (= index (count entries))
    nil
    (let [entry (nth entries index)]
      (if (= handler-id (nth entry 0))
        (nth entry 1)
        (find-handler entries handler-id (+ index 1))))))

(defn invoke-handler [handler-id args frame]
  (let [handler (find-handler (deref *handlers*) handler-id 0)]
    (if handler
      (handler args)
      (throw (str "unknown node handler " handler-id)))))

(defn handle
  ([action f] (handle action f {}))
  ([action f meta]
   (let [handler-id (str "handler-" (swap! *next-handler* inc))]
     (do (swap! *handlers* (fn [handlers] (conj handlers [handler-id f])))
         (Host/call "node" "handle"
                               [(require-node) action handler-id meta])))))

(defn stop [id]
  (do
    (reset! *active-task* nil)
    (Host/call "node" "stop" [(require-node) id])))

(defn info []
  (Host/call "node" "info" [(require-node)]))
