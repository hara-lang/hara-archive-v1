{
  "name": "@hara-lang/browser",
  "version": "0.1.0",
  "description": "Embeddable Hara browser runtime and CDN loader",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hara-lang/hara.git",
    "directory": "core/rust/web/packages/browser"
  },
  "homepage": "https://github.com/hara-lang/hara/tree/main/core/rust/web/packages/browser#readme",
  "dependencies": {
    "@hara-lang/hta": "0.1.0",
    "edn-data": "1.1.2",
    "fflate": "0.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/hara-wasm-vm/hara.d.ts",
      "import": "./dist/hara-wasm-vm/hara.mjs",
      "default": "./dist/hara-wasm-vm/hara.mjs"
    },
    "./vm": {
      "types": "./dist/hara-wasm-vm/hara.d.ts",
      "import": "./dist/hara-wasm-vm/hara.mjs",
      "default": "./dist/hara-wasm-vm/hara.mjs"
    },
    "./full": {
      "types": "./dist/hara-wasm-full/hara.d.ts",
      "import": "./dist/hara-wasm-full/hara.mjs",
      "default": "./dist/hara-wasm-full/hara.mjs"
    }
  },
  "unpkg": "./dist/hara-wasm-vm/hara.js",
  "jsdelivr": "./dist/hara-wasm-vm/hara.js",
  "files": [
    "dist/hara-wasm-vm",
    "dist/hara-wasm-full"
  ],
  "publishConfig": {
    "access": "public"
  }
}
