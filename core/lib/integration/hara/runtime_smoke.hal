(ns tool.runtime-smoke
  (:require [std.foundation.string :as string]
            [lang.common.emit :as emit]
            [lang.core :as tahto]
            [lang.core.eval :as evaluation]
            [lang.model.v1.spec-js :as spec-js]
            [lang.model.v1.spec-python :as spec-python]
            [lang.model.v1.spec-lua :as spec-lua]
            [lang.runtime.basic.transport-node :as transport-node]))

(defn collect-process-output
  [pending]
  (try
    (string/decode-utf8 (evaluation/await pending 1000))
    (catch Throwable error
      (str "<unavailable: " (or (ex-message error) (str error)) ">"))))

(defn eval-persistent!
  [runtime source]
  (try
    (tahto/rt-raw-eval runtime source)
    (catch Throwable error
      (let [transport (get runtime :transport)
            transport-state (transport-node/state transport)
            child (get transport-state :process)
            alive-before-stop (if child (Process/alive? child) false)
            _ (tahto/rt-stop runtime)
            stdout (if child
                     (collect-process-output (Process/stdout child))
                     nil)
            stderr (if child
                     (collect-process-output (Process/stderr child))
                     nil)]
        (throw
         (ex :hara/host (assoc {:source source
           :alive-before-stop alive-before-stop
           :transport-state transport-state
           :stdout stdout
           :stderr stderr
           :cause-data (ex-data error)} :ex/message "Persistent runtime evaluation failed" :ex/cause error)))))))

(def js-command-source
  (emit/emit '(console.log (+ 19 23))
             (spec-js/select)))

(def python-command-source
  (emit/emit '(print (+ 19 23))
             (spec-python/select)))

(def lua-command-source
  (emit/emit '(print (+ 19 23))
             (spec-lua/select)))

(def js-expression-source
  (emit/emit '(+ 19 23)
             (spec-js/select)))

(def python-expression-source
  (emit/emit '(+ 19 23)
             (spec-python/select)))

(println "tahto runtime smoke: creating oneshot and verify runtimes")

(def js-oneshot (tahto/rt-create :js :oneshot))
(def python-oneshot (tahto/rt-create :python :oneshot))
(def lua-oneshot (tahto/rt-create :lua :oneshot))
(def js-verify (tahto/rt-create :js :verify))
(def python-verify (tahto/rt-create :python :verify))
(def lua-verify (tahto/rt-create :lua :verify))

(println "tahto runtime smoke: verifying emitted JavaScript, Python, and Lua")
(def js-verified-source (tahto/rt-raw-eval js-verify js-command-source))
(def python-verified-source
  (tahto/rt-raw-eval python-verify python-command-source))
(def lua-verified-source (tahto/rt-raw-eval lua-verify lua-command-source))

;; A verifier must parse but never execute these valid programs.
(def js-nonexecuting-source
  "throw new Error('verification executed JavaScript');")
(def python-nonexecuting-source
  "raise RuntimeError('verification executed Python')")
(def lua-nonexecuting-source
  "error('verification executed Lua')")

(def js-nonexecuting-result
  (tahto/rt-raw-eval js-verify js-nonexecuting-source))
(def python-nonexecuting-result
  (tahto/rt-raw-eval python-verify python-nonexecuting-source))
(def lua-nonexecuting-result
  (tahto/rt-raw-eval lua-verify lua-nonexecuting-source))

(def js-verify-error
  (try
    (tahto/rt-raw-eval js-verify "function {")
    nil
    (catch Throwable error
      (ex-data error))))

(println "tahto runtime smoke: evaluating JavaScript oneshot")
(def js-oneshot-output (tahto/rt-raw-eval js-oneshot js-command-source))
(println "tahto runtime smoke: JavaScript oneshot complete")

(println "tahto runtime smoke: evaluating Python oneshot")
(def python-oneshot-output
  (tahto/rt-raw-eval python-oneshot python-command-source))
(println "tahto runtime smoke: Python oneshot complete")

(println "tahto runtime smoke: evaluating Lua oneshot")
(def lua-oneshot-output
  (tahto/rt-raw-eval lua-oneshot lua-command-source))
(println "tahto runtime smoke: Lua oneshot complete")

(println "tahto runtime smoke: starting JavaScript persistent runtime")
(def js-basic
  (tahto/rt-start (tahto/rt-create :js :basic {:timeout 15000})))
(def js-basic-transport (get-in js-basic [:process :transport]))

(println (str "tahto runtime smoke: JavaScript source: " js-expression-source))
(println "tahto runtime smoke: evaluating JavaScript persistent runtime")
(def js-basic-output (eval-persistent! js-basic js-expression-source))
(println "tahto runtime smoke: JavaScript persistent runtime complete")

(tahto/rt-stop js-basic)
(def js-basic-state (deref (get js-basic :state)))
(println "tahto runtime smoke: JavaScript persistent runtime stopped")

(println "tahto runtime smoke: starting Python persistent runtime")
(def python-basic
  (tahto/rt-start (tahto/rt-create :python :basic {:timeout 15000})))
(def python-basic-transport (get-in python-basic [:process :transport]))

(println (str "tahto runtime smoke: Python source: " python-expression-source))
(println "tahto runtime smoke: evaluating Python persistent runtime")
(def python-basic-output
  (eval-persistent! python-basic python-expression-source))
(println "tahto runtime smoke: Python persistent runtime complete")

(tahto/rt-stop python-basic)
(def python-basic-state (deref (get python-basic :state)))
(println "tahto runtime smoke: Python persistent runtime stopped")

(def expected-js-basic
  {:type "data"
   :return "number"
   :value 42})

(def expected-python-basic
  {:type "data"
   :return "int"
   :value 42})

(if (and (= js-command-source js-verified-source)
         (= python-command-source python-verified-source)
         (= lua-command-source lua-verified-source)
         (= js-nonexecuting-source js-nonexecuting-result)
         (= python-nonexecuting-source python-nonexecuting-result)
         (= lua-nonexecuting-source lua-nonexecuting-result)
         (= :verify (get js-verify-error :phase))
         (= :js (get js-verify-error :lang))
         (= :verify (get js-verify-error :runtime))
         (not= 0 (get js-verify-error :exit))
         (= "42" js-oneshot-output)
         (= "42" python-oneshot-output)
         (= "42" lua-oneshot-output)
         (= expected-js-basic js-basic-output)
         (= expected-python-basic python-basic-output)
         (= {:js 1 :python 1 :lua 1} (:versions tahto/+bootstrap+))
         (= 1 (tahto/registry-book-default-version :js))
         (= [1] (tahto/registry-book-versions :python))
         (= [1] (tahto/registry-book-versions :lua))
         (= :process-socket js-basic-transport)
         (= :process-socket python-basic-transport)
         (= :stopped (get js-basic-state :status))
         (= :stopped (get python-basic-state :status)))
  {:status :passed
   :bootstrap tahto/+bootstrap+
   :verify {:js js-verified-source
            :python python-verified-source
            :lua lua-verified-source
            :invalid-js js-verify-error}
   :oneshot {:js js-oneshot-output
             :python python-oneshot-output
             :lua lua-oneshot-output}
   :basic {:js js-basic-output
           :python python-basic-output
           :transport :process-socket
           :state {:js js-basic-state
                   :python python-basic-state}}}
  (throw
   (ex :hara/argument (assoc {:bootstrap tahto/+bootstrap+
             :sources {:js-command js-command-source
                       :python-command python-command-source
                       :lua-command lua-command-source
                       :js-expression js-expression-source
                       :python-expression python-expression-source}
             :verify {:js js-verified-source
                      :python python-verified-source
                      :lua lua-verified-source
                      :nonexecuting {:js js-nonexecuting-result
                                     :python python-nonexecuting-result
                                     :lua lua-nonexecuting-result}
                      :invalid-js js-verify-error}
             :oneshot {:js js-oneshot-output
                       :python python-oneshot-output
                       :lua lua-oneshot-output}
             :basic {:js js-basic-output
                     :python python-basic-output
                     :expected {:js expected-js-basic
                                :python expected-python-basic}
                     :transport {:js js-basic-transport
                                 :python python-basic-transport}
                     :state {:js js-basic-state
                             :python python-basic-state}}} :ex/message "Tahto runtime bootstrap smoke failed"))))
