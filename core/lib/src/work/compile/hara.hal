(ns work.compile.hara
  (:config {:role :internal})
  (:require [work.base :as work]))

(def lowering-version 1)

(def closure-state
  (atom {:next 0
         :values {}}))

(defn work-value?
  [value]
  (satisfies? IWork value))

(defn closure-value?
  [value]
  (and (function? value)
       (not (work-value? value))))

(declare form)

(defn ir-value
  [value]
  (cond
    (work-value? value)
    {:ir/kind :work
     :ir/value (ir-value (work/work-spec value))}

    (closure-value? value)
    {:ir/kind :closure
     :ir/value value}

    (map? value)
    (reduce
     (fn [output key]
       (assoc output key (ir-value (get value key))))
     {}
     (sort-by str (keys value)))

    (vector? value)
    (vec (map ir-value value))

    (set? value)
    (set (map ir-value (sort-by str value)))

    (instance? work/GraphInput value)
    {:ir/kind :graph-input
     :ir/key (:key value)}

    (instance? work/GraphNode value)
    {:ir/kind :graph-node
     :ir/dependencies (vec (map ir-value (sort-by str (:dependencies value))))
     :ir/function (ir-value (:function value))}

    (instance? work/GraphDeps value)
    {:ir/kind :graph-deps
     :ir/entries (ir-value (:entries value))}

    (list? value)
    (apply list (map ir-value value))

    :else value))

(defn ir
  "Returns the source-owned, inspectable Work IR for a Work value.

   Closures are explicit IR leaves. They retain the process-local executable
   value while the surrounding Work structure remains ordinary Hara data. This
   makes closure-bearing continuations visible to analysis without pretending
   that executable values are durable checkpoint data."
  [work-value]
  (if (not (work-value? work-value))
    (throw
     (ex :argument {:work/value work-value}
         :ex/message "Work lowering requires an IWork value")))
  {:ir/version lowering-version
   :ir/work (ir-value work-value)})

(defn reset-closures
  "Clears process-local closure references used by generated forms."
  []
  (reset! closure-state {:next 0
                         :values {}})
  nil)

(defn register-closure
  [value]
  (let [state (deref closure-state)
        token (inc (:next state))]
    (swap! closure-state
           (fn [current]
             (assoc current
                    :next token
                    :values (assoc (:values current) token value))))
    token))

(defn resolve-closure
  [token]
  (let [value (get-in (deref closure-state) [:values token])]
    (if (nil? value)
      (throw
       (ex :not-found {:closure/token token}
           :ex/message "Work lowering closure reference is not available")))
    value))

(defn form-value
  [value]
  (cond
    (work-value? value)
    (form value)

    (closure-value? value)
    (list 'work.compile.hara/resolve-closure
          (register-closure value))

    (map? value)
    (reduce
     (fn [output key]
       (assoc output key (form-value (get value key))))
     {}
     (sort-by str (keys value)))

    (vector? value)
    (vec (map form-value value))

    (set? value)
    (set (map form-value (sort-by str value)))

    (instance? work/GraphInput value)
    (list 'work.base/GraphInput (:key value))

    (instance? work/GraphNode value)
    (list 'work.base/GraphNode
          (vec (map form-value (:dependencies value)))
          (form-value (:function value)))

    (instance? work/GraphDeps value)
    (list 'work.base/GraphDeps (form-value (:entries value)))

    (list? value)
    (apply list (map form-value value))

    :else value))

(defn form
  "Lowers Work to an ordinary Hara form.

   The generated form only reconstructs the source-owned Work definition.
   Execution remains with the canonical evaluator, including `:bind` source,
   pure continuation, produced child, and frame lineage semantics."
  ([work-value]
   (form work-value {}))
  ([work-value options]
   (let [version (or (:ir/version options) lowering-version)]
     (if (not= version lowering-version)
       (throw
        (ex :argument {:ir/version version}
            :ex/message "Unsupported Work lowering version")))
     (if (not (work-value? work-value))
       (throw
        (ex :argument {:work/value work-value}
            :ex/message "Work lowering requires an IWork value")))
     (list 'work.base/definition
           (form-value (work/work-spec work-value))))))
