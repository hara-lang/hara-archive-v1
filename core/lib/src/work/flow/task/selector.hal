(ns work.flow.task.selector)

(defn ^{:public true} selector-options
  "Builds flat task options from the legacy selector, params, and environment forms.
   A map in the selector position is already an options map. The lookup position
   is intentionally absent from this portable selector surface."
  ([selector]
   (if (map? selector) selector {:selector selector}))
  ([selector params]
   (if (map? selector)
     (merge selector (or params {}))
     (assoc (or params {}) :selector selector)))
  ([selector params environment]
   (assoc (selector-options selector params)
          :environment environment)))

(defn ^{:public true} invocation-options
  "Normalises a selector task's public zero-to-three argument surface.
   A single map is options/params. Non-map values are selectors. Optional
   selector-key maps a domain key such as :namespace to generic :selector
   without introducing a lookup argument."
  ([arguments]
   (invocation-options arguments nil))
  ([arguments selector-key]
   (let [options
         (case (count arguments)
           0 {}
           1 (selector-options (first arguments))
           2 (selector-options (first arguments) (second arguments))
           3 (selector-options (first arguments)
                                (second arguments)
                                (nth arguments 2))
           (throw
            (ex :argument {:arguments arguments}
                :ex/message "Selector task invocation accepts at most selector, params, and environment")))]
     (if (and selector-key
              (has? options selector-key)
              (not (has? options :selector)))
       (assoc (dissoc options selector-key)
              :selector (get options selector-key))
       options))))

(defn matches?
  "Matches one task-flow selector against an item identifier. Scalars use
   prefix matching, regular expressions search the identifier, sets use exact
   membership, lists are conjunctions, and vectors are disjunctions. Collection
   forms are checked before callable predicates because Hara collections may
   themselves satisfy fn?."
  [selector identifier]
  (cond (or (nil? selector) (= :all selector)) true
        (list? selector)
        (reduce (fn [matched part]
                  (and matched
                       (work.flow.task.selector/matches? part identifier)))
                true selector)
        (vector? selector)
        (reduce (fn [matched part]
                  (or matched
                      (work.flow.task.selector/matches? part identifier)))
                false selector)
        (set? selector)
        (reduce (fn [matched value] (or matched (= value identifier)))
                false selector)
        (or (string? selector) (symbol? selector) (keyword? selector))
        (str/starts-with? (str identifier) (str selector))
        (regexp? selector)
        (not (nil? (re-find selector (str identifier))))
        (fn? selector) (if (selector identifier) true false)
        :else
        (throw (ex :argument {:selector selector :identifier identifier} :ex/message "Command selector is not valid"))))

(defn select
  [selector values]
  (vec (filter (fn [value] (matches? selector value)) values)))

(defn collection-match?
  [selector values]
  (reduce (fn [matched value]
            (or matched (matches? selector value)))
          false
          (or values [])))

(defn filter-match?
  "Matches generic include/exclude filter data against item metadata. :unit
   accepts any intersecting unit or tag, :refers matches a referenced symbol,
   and :namespaces matches the owning namespace."
  [metadata filter default]
  (let [units (or (:unit metadata) (:tags metadata) #{})
        refer (:refer metadata)
        namespace (:namespace metadata)
        unit-filter (:unit filter)
        refers-filter (:refers filter)
        namespace-filter (:namespaces filter)]
    [(if unit-filter
       (collection-match? unit-filter units)
       default)
     (if refers-filter
       (matches? refers-filter refer)
       default)
     (if namespace-filter
       (matches? namespace-filter namespace)
       default)]))

(defn include-match?
  [metadata filter]
  (reduce (fn [matched value] (and matched value))
          true
          (filter-match? metadata filter true)))

(defn exclude-match?
  [metadata filter]
  (reduce (fn [matched value] (or matched value))
          false
          (filter-match? metadata filter false)))

(defn matches-options?
  "Applies portable :include/:exclude filters to item metadata. Items carrying
   :unit remain opt-in when no include filters are supplied."
  [metadata options]
  (let [include (or (:include options) [])
        exclude (or (:exclude options) [])
        tagged (:unit metadata)]
    (and (not (and tagged (= 0 (count include))))
         (if (= 0 (count include))
           true
           (reduce (fn [matched filter]
                     (or matched (include-match? metadata filter)))
                   false
                   include))
         (reduce (fn [matched filter]
                   (and matched (not (exclude-match? metadata filter))))
                 true
                 exclude))))
