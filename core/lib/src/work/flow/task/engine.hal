(ns work.flow.task.engine
  (:config {:override [compile]})
  (:require [work.base :as work]
            [work.flow.task.command :as command]
            [work.flow.task.result :as result]
            [work.flow.task.command-task :as task-command]
            [work.flow.task.selector :as selector]
            [work.flow.task.report :as report]))

(def schema-id "work.flow.task.engine/0-alpha")
(def request-id "work.flow.task.engine.request/0-alpha")

(def parity-statuses
  #{:implemented :partial :host-adapted :intentional-change :obsolete :missing})

(def event-types
  [:task/run-started
   :task/input-prepared
   :task/items-listed
   :task/items-selected
   :task/item-started
   :task/item-completed
   :task/item-warning
   :task/item-error
   :task/results-ready
   :task/warnings-ready
   :task/errors-ready
   :task/summary-ready
   :task/run-completed])

(def feature-contract
  [{:feature :definition/id-version :status :implemented}
   {:feature :definition/defaults-by-type :status :implemented}
   {:feature :main/arity-adapter-1-4 :status :implemented}
   {:feature :main/additional-arguments :status :implemented}
   {:feature :construct/input :status :implemented}
   {:feature :construct/environment :status :implemented}
   {:feature :construct/lookup :status :implemented}
   {:feature :item/list :status :implemented}
   {:feature :item/select :status :implemented}
   {:feature :item/pre-run-post :status :implemented}
   {:feature :item/output :status :implemented}
   {:feature :item/display :status :implemented}
   {:feature :execution/random :status :intentional-change
    :reason "Portable task templates preserve deterministic input order; random scheduling belongs to an execution provider or explicit caller input."}
   {:feature :execution/parallel :status :host-adapted}
   {:feature :execution/deterministic-report-order :status :implemented}
   {:feature :execution/cancellation :status :host-adapted}
   {:feature :execution/timeout :status :host-adapted}
   {:feature :result/warnings-errors-results :status :implemented}
   {:feature :result/ignore-derived-format-order :status :implemented}
   {:feature :result/columns :status :implemented}
   {:feature :summary/aggregate :status :implemented}
   {:feature :summary/finalise :status :implemented}
   {:feature :summary/elapsed-cumulative :status :implemented}
   {:feature :summary/annotations :status :implemented}
   {:feature :report/title-sections-labels :status :implemented}
   {:feature :report/live-stage-events :status :implemented}
   {:feature :report/plain-terminal-renderers :status :implemented}
   {:feature :return/selection :status :implemented}
   {:feature :return/map-vector-packaging :status :implemented}])

(def default-execution
  {:order :input
   :parallel false
   :random false
   :fail-fast false})

(def default-return
  {:select :results
   :package :map})

(def default-task-options
  {:main {:argcount 4
          :args-required? false}
   :params {}
   :execution default-execution
   :return default-return})

(def ^:dynamic *task-defaults*
  (atom {:default default-task-options}))

(defn task-defaults
  "Returns the default task options for type, including :default options."
  [type]
  (let [registry (deref *task-defaults*)
        base (or (get registry :default) {})
        selected (if (= :default type)
                   {}
                   (or (get registry type) {}))]
    (merge-nested base selected)))

(defn install-defaults
  "Installs or extends defaults for one local task type."
  [type options]
  (swap! *task-defaults*
         (fn [registry]
           (assoc registry
                  type
                  (merge-nested (or (get registry type) {}) options))))
  (task-defaults type))

(defn uninstall-defaults
  "Removes local defaults for type. The :default profile cannot be removed."
  [type]
  (if (= :default type)
    (throw
     (ex :io {:task/type type} :ex/message "The default task profile cannot be removed"))
    (swap! *task-defaults* dissoc type)))

(defn feature-status
  [feature]
  (:status
   (first
    (filter
     (fn [entry] (= feature (:feature entry)))
     feature-contract))))

(defn incomplete-features
  []
  (vec
   (filter
    (fn [entry]
      (or (= :partial (:status entry))
          (= :missing (:status entry))))
    feature-contract)))

(defn request
  "Creates an explicit task invocation request.

   Recognised keys are :input, :params, :environment (or :env), :lookup,
   :args, :selector, and :mode. A request without :input asks the template to
   call :construct/input. Raw values passed to work/run remain ordinary input."
  ([]
   {:task/request request-id})
  ([options]
   (if (not (map? options))
     (throw
      (ex :io {:options options} :ex/message "Task request options must be a map"))
     (assoc options :task/request request-id))))

(defn invocation
  "Convenience constructor for explicit task input, parameters, and arguments."
  ([input]
   (request {:input input}))
  ([input params]
   (request {:input input :params params}))
  ([input params arguments]
   (request {:input input :params params :args arguments})))

(defn invocation-arguments
  "Restores the historical task call convention for zero to four arguments.
   A map in the single-argument position is params over constructed input.
   Values following :args are forwarded to the task main function. Selector
   profiles use the shared zero-to-three selector convention instead."
  ([arguments]
   (invocation-arguments arguments nil))
  ([arguments invocation]
   (if (= :selector (:mode (or invocation {})))
     (request
      (selector/invocation-options arguments (:selector-key invocation)))
     (let [marker
           (loop [index 0]
             (if (= index (count arguments))
               -1
               (if (= :args (nth arguments index))
                 index
                 (recur (inc index)))))
           task-arguments
           (if (= marker -1)
             arguments
             (vec (take marker arguments)))
           additional
           (if (= marker -1)
             []
             (vec (drop (inc marker) arguments)))
           total (count task-arguments)
           options
           (case total
             0 {}
             1 (let [value (first task-arguments)]
                 (if (map? value)
                   {:params value}
                   {:input value}))
             2 {:input (nth task-arguments 0)
                :params (nth task-arguments 1)}
             3 {:input (nth task-arguments 0)
                :params (nth task-arguments 1)
                :environment (nth task-arguments 2)}
             4 {:input (nth task-arguments 0)
                :params (nth task-arguments 1)
                :lookup (nth task-arguments 2)
                :environment (nth task-arguments 3)}
             (throw
              (ex :generic {:arguments task-arguments}
                  :ex/message "Task invocation accepts at most input, params, lookup, and environment")))]
       (request
        (if (empty? additional)
          options
          (assoc options :args additional)))))))

(defn invoke
  "Invokes compiled task work through the historical four-argument calling
   convention."
  [work-value definition arguments]
  (work/run
   (work/local-runtime)
   work-value
   (invocation-arguments arguments (:invocation definition))))

(defn callable
  [work-value definition]
  (work/definition
   (assoc
    (work/work-spec work-value)
    :work/invoke
    (fn [task & arguments]
      (work.flow.task.engine/invoke
       task
       definition
       arguments)))))

(defn request?
  [value]
  (and (map? value)
       (= request-id (:task/request value))))

(defn request-params
  "Returns task parameters from a request while removing invocation controls."
  [input]
  (merge
   (dissoc input
           :task/request :input :params :environment :env :lookup
           :args :selector :mode)
   (or (:params input) {})))

(defn normalise-request
  [input]
  (if (request? input)
    {:task/input (:input input)
     :task/input? (has? input :input)
     :task/params (request-params input)
     :task/environment
     (if (has? input :environment)
       (:environment input)
       (:env input))
     :task/environment?
     (or (has? input :environment)
         (has? input :env))
     :task/lookup (:lookup input)
     :task/lookup? (has? input :lookup)
     :task/args (vec (or (:args input) []))
     :task/selector (:selector input)
     :task/selector? (has? input :selector)
     :task/mode (or (:mode input) :run)}
    {:task/input input
     :task/input? true
     :task/params {}
     :task/environment nil
     :task/environment? false
     :task/lookup nil
     :task/lookup? false
     :task/args []
     :task/selector (if (map? input) (:selector input) nil)
     :task/selector? (and (map? input) (has? input :selector))
     :task/mode :run}))

(defn main-function
  "Adapts a Foundation-style main function with an explicit argument count.

   The returned function always accepts input, params, lookup, environment,
   and a vector of additional arguments."
  [function count]
  (case count
    4 (fn [input params lookup environment arguments]
        (apply function input params lookup environment arguments))
    3 (fn [input params lookup environment arguments]
        (apply function input params environment arguments))
    2 (fn [input params lookup environment arguments]
        (apply function input params arguments))
    1 (fn [input params lookup environment arguments]
        (apply function input arguments))
    (throw
     (ex :argument {:argcount count} :ex/message "Task main argcount must be between 1 and 4"))))

(defn assert-definition
  [definition]
  (if (not (map? definition))
    (throw
     (ex :argument {:definition definition} :ex/message "Task template definition must be a map")))
  (if (nil? (or (:task/id definition) (:id definition)))
    (throw (ex :dependency {} :ex/message "Task template requires an id")))
  (if (nil? (or (get-in definition [:item :run])
                (get-in definition [:main :fn])
                (:run definition)))
    (throw (ex :dependency {} :ex/message "Task template requires an item run function")))
  definition)

(defn normalise-definition
  [raw-definition]
  (let [type (or (:task/type raw-definition)
                 (:type raw-definition)
                 :default)
        defaults (merge-nested
                  (task-defaults type)
                  (or (:defaults raw-definition) {}))
        definition (assert-definition
                    (merge-nested defaults raw-definition))
        schema (or (:schema definition) schema-id)
        id (or (:task/id definition) (:id definition))
        version (or (:task/version definition) (:version definition) 1)
        item (or (:item definition) {})
        main (or (:main definition) {})
        item-run (or (:run item) (:run definition))
        main-run (:fn main)
        run-mode (if item-run :work :task)
        run (or item-run main-run)
        argcount (or (:argcount main) 4)
        list-mode
        (or (:list-mode item)
            (if (= :task run-mode)
              :lookup-environment
              :input-context))]
    (if (not= schema schema-id)
      (throw
       (ex :serialization {:schema schema} :ex/message "Task template schema is not supported")))
    (if (or (< argcount 1) (> argcount 4))
      (throw
       (ex :argument {:argcount argcount} :ex/message "Task main argcount must be between 1 and 4")))
    {:schema schema-id
     :task/id id
     :task/type type
     :task/version version
     :construct (or (:construct definition) {})
     :params (or (:params definition) {})
     :main (assoc main
                  :fn run
                  :argcount argcount
                  :invoke (if (= :task run-mode)
                            (main-function run argcount)
                            nil))
     :item (assoc item
                  :run run
                  :run-mode run-mode
                  :list-mode list-mode)
     :warning (or (:warning definition) {})
     :error (or (:error definition) {})
     :execution (merge-nested default-execution
                              (or (:execution definition) {}))
     :result (or (:result definition) {})
     :summary (or (:summary definition) {})
     :report (report/normalise-profile (:report definition))
     :return (merge-nested default-return
                           (or (:return definition) {}))
     :metadata (or (:metadata definition) {})
     :invocation (or (:invocation definition) {})}))

(defn task-item-id
  [value index]
  (if (and (map? value) (has? value :item/id))
    (:item/id value)
    (if (or (string? value) (number? value) (keyword? value) (symbol? value))
      value
      index)))

(defn task-item-value
  [value]
  (if (and (map? value) (has? value :item/value))
    (:item/value value)
    value))

(defn selected-values
  [values selector-value]
  (loop [source-index 0
         output []]
    (if (= source-index (count values))
      output
      (let [value (nth values source-index)
            id (task-item-id value source-index)]
        (recur
         (inc source-index)
         (if (selector/matches? selector-value id)
           (conj output
                 {:task/source-index source-index
                  :task/item-id id
                  :task/value (task-item-value value)})
           output))))))

(defn manifest
  [values selector-value prepared]
  (let [values (vec (or values []))
        selected (selected-values values selector-value)
        total (count selected)]
    (loop [index 0
           output []]
      (if (= index total)
        output
        (let [selected-value (nth selected index)
              id (:task/item-id selected-value)]
          (recur
           (inc index)
           (conj output
                 {:item/id id
                  :item/value
                  (merge prepared
                         selected-value
                         {:task/index index
                          :task/total total})})))))))

(defn construct-input
  [definition invocation]
  (if (:task/input? invocation)
    (:task/input invocation)
    (let [construct (get-in definition [:construct :input])]
      (if construct
        (construct
         (assoc definition
                :task/params (:task/params invocation)
                :task/selector (:task/selector invocation)
                :task/selector? (:task/selector? invocation)
                :task/environment (:task/environment invocation)))
        nil))))

(defn construct-environment
  [definition invocation params]
  (if (:task/environment? invocation)
    (:task/environment invocation)
    (let [construct
          (or (get-in definition [:construct :environment])
              (get-in definition [:construct :env]))]
      (if construct
        (construct (merge-nested definition params))
        {}))))

(defn construct-lookup
  [definition invocation params environment]
  (if (:task/lookup? invocation)
    (:task/lookup invocation)
    (let [construct (get-in definition [:construct :lookup])]
      (if construct
        (construct definition (merge-nested environment params))
        {}))))

(defn prepare-input
  [definition input context]
  (let [invocation (normalise-request input)
        params (merge-nested (:params definition)
                             (:task/params invocation))
        prepared-input (construct-input definition invocation)
        environment (construct-environment definition invocation params)
        lookup (construct-lookup definition invocation params environment)
        arguments (:task/args invocation)
        required?
        (or (get-in definition [:main :args-required?])
            (get-in definition [:main :args?]))
        selector-value
        (if (:task/selector? invocation)
          (:task/selector invocation)
          (or (get-in definition [:item :selector]) :all))
        clock (:clock/now context)
        started-at (if clock (clock) nil)]
    (if (and required? (empty? arguments))
      (throw
       (ex :dependency {:task/id (:task/id definition)
                 :task/type (:task/type definition)} :ex/message "Task invocation requires additional arguments")))
    (work/emit context :task/run-started
                {:task/id (:task/id definition)
                 :task/type (:task/type definition)
                 :task/version (:task/version definition)
                 :report/title (get-in definition [:report :title])
                 :report/profile (:report definition)})
    (work/emit context :task/input-prepared
                {:task/id (:task/id definition)
                 :selector selector-value
                 :argument-count (count arguments)})
    {:task/input prepared-input
     :task/params params
     :task/environment environment
     :task/lookup lookup
     :task/args arguments
     :task/selector selector-value
     :task/mode (:task/mode invocation)
     :task/started-at started-at}))

(defn list-values
  [definition prepared context]
  (let [item (:item definition)
        list-function (:list item)
        list-mode (:list-mode item)]
    (if list-function
      (case list-mode
        :lookup-environment
        (list-function
         (:task/lookup prepared)
         (:task/environment prepared))

        :input-context
        (list-function (:task/input prepared) context)

        (throw
         (ex :generic {:task/id (:task/id definition)
                   :list-mode list-mode} :ex/message "Task item list mode is not supported")))
      [(:task/input prepared)])))

(defn list-items
  [definition prepared context]
  (let [listed (vec (or (list-values definition prepared context) []))
        items (manifest listed (:task/selector prepared) prepared)]
    (work/emit context :task/items-listed
                {:task/id (:task/id definition)
                 :count (count listed)})
    (work/emit context :task/items-selected
                {:task/id (:task/id definition)
                 :count (count items)})
    items))

(def status-event task-command/status-event)

(defn invoke-item
  [definition subject prepared context]
  (let [item (:item definition)]
    (if (= :task (:run-mode item))
      ((get-in definition [:main :invoke])
       prepared
       (:task/params subject)
       (:task/lookup subject)
       (:task/environment subject)
       (:task/args subject))
      ((:run item) prepared context))))

(defn display-value
  [definition record]
  (task-command/display-value
   {:display (get-in definition [:item :display])}
   record))

(defn unit-options
  [definition]
  (let [item (:item definition)]
    {:id :task/process
     :version (:task/version definition)
     :input
     (fn [subject context]
       (:task/value subject))
     :item/meta
     (fn [subject context]
       (let [metadata
             {:item/id (:task/item-id subject)
              :item/index (:task/index subject)
              :item/source-index (:task/source-index subject)
              :item/total (:task/total subject)}]
         (if (has? item :status?)
           (assoc metadata :item/status? (:status? item))
           metadata)))
     :pre (:pre item)
     :run
     (fn [prepared context]
       (invoke-item definition
                    (:command/subject context)
                    prepared
                    context))
     :post (:post item)
     :display (:display item)
     :on-error (or (:on-error item)
                   (get-in definition [:execution :on-error])
                   :record)}))

(defn unit-work
  "Compiles the reusable one-item command for a normalised task definition."
  [definition]
  (task-command/unit (unit-options definition)))

(defn run-item
  "Compatibility entry point for the atomic task lifecycle.

   New composition should use unit-work so direct and bulk execution share the
   exact same ordinary IWork value."
  [definition subject context]
  (task-command/run-item
   (task-command/normalise-options (unit-options definition))
   subject
   context))

(defn result-options
  [definition]
  {:ignore (get-in definition [:result :ignore])})

(defn derived-key-specs
  [definition]
  (or (get-in definition [:result :keys]) []))

(defn derive-result
  [definition record]
  (reduce
   (fn [output entry]
     (let [key (nth entry 0)
           function (nth entry 1)]
       (assoc output key (function (:data record)))))
   (assoc record :key (:item/id record))
   (derived-key-specs definition)))

(defn result-order
  [definition params]
  (or (:order-by params)
      (get-in definition [:result :order])
      (get-in definition [:result :sort-by])))

(defn order-function
  [order]
  (cond
    (nil? order) nil
    (fn? order) order
    (keyword? order) (fn [record] (get record order))
    (vector? order)
    (fn [record]
      (vec
       (map
        (fn [key] (get record key))
        order)))
    :else
    (throw
     (ex :argument {:order order} :ex/message "Task result order must be a function, keyword, or key vector"))))

(defn order-results
  [definition params records]
  (let [function (order-function (result-order definition params))]
    (if function
      (vec (sort-by function records))
      (vec records))))

(defn format-result
  [definition params record]
  (reduce
   (fn [output entry]
     (let [key (nth entry 0)
           formatter (nth entry 1)]
       (if (has? output key)
         (assoc output key (formatter (get output key) params))
         output)))
   record
   (or (get-in definition [:result :format]) {})))

(defn project-diagnostic
  [definition kind record]
  (let [output (get-in definition [kind :output])]
    (if output
      (assoc record :data (output (:data record)))
      record)))

(defn elapsed-time
  [prepared context]
  (let [clock (:clock/now context)
        started-at (:task/started-at prepared)]
    (if (and clock (not (nil? started-at)))
      (- (clock) started-at)
      0)))

(defn normalise-annotations
  [value]
  (cond
    (nil? value) []
    (vector? value) value
    (list? value) (vec value)
    :else [value]))

(defn finalise-summary
  [definition base records results]
  (let [aggregated
        (result/aggregate
         base
         (get-in definition [:summary :aggregate])
         results)
        finalise (get-in definition [:summary :finalise])]
    (if finalise
      (finalise aggregated records results)
      aggregated)))

(defn summary-annotations
  [definition summary records results]
  (let [annotations (get-in definition [:summary :annotations])
        value (if (fn? annotations)
                (annotations summary records results)
                annotations)]
    (normalise-annotations value)))

(defn selected-order-completions
  "Orders supplied completion records by their selected item index.

   Providers may complete work out of order; portable reports remain stable
   and preserve the selected input order. Records without an item index keep
   their supplied relative position."
  [completions]
  (let [indexed
        (map-indexed (fn [index completion] [index completion]) completions)]
    (vec
     (map
      second
      (sort-by
       (fn [entry]
         (let [supplied-index (first entry)
               completion (second entry)
               selected-index
               (get-in completion [:item/value :item/index])]
           [(if (nil? selected-index) supplied-index selected-index)
            supplied-index]))
       indexed)))))

(defn prepare-bundle
  [definition batch context]
  (let [prepared (:input batch)
        params (or (:task/params prepared) {})
        ordered-batch
        (assoc batch
               :results
               (selected-order-completions (:results batch)))
        initial (result/summarise ordered-batch (result-options definition))
        records (:records initial)
        derived
        (vec
         (map
          (fn [record] (derive-result definition record))
          (:results initial)))
        ordered (order-results definition params derived)
        result-rows
        (vec
         (map
          (fn [record] (format-result definition params record))
          ordered))
        warning-rows
        (vec
         (map
          (fn [record] (project-diagnostic definition :warning record))
          (:warnings initial)))
        error-rows
        (vec
         (map
          (fn [record] (project-diagnostic definition :error record))
          (:errors initial)))
        base-summary
        {:items (count (:items initial))
         :results (count ordered)
         :warnings (count (:warnings initial))
         :errors (count (:errors initial))}
        summary
        (finalise-summary definition base-summary records ordered)
        summary
        (assoc summary
               :cumulative (get-in initial [:summary :cumulative])
               :elapsed (elapsed-time prepared context))
        annotations
        (summary-annotations definition summary records ordered)]
    (assoc initial
           :results ordered
           :result-rows result-rows
           :warning-rows warning-rows
           :error-rows error-rows
           :summary summary
           :annotations annotations)))

(defn report-status
  [definition bundle]
  (let [status-function (get-in definition [:report :status])]
    (if (fn? status-function)
      (status-function (:summary bundle) bundle)
      (cond
        (< 0 (count (:errors bundle))) :failed
        (< 0 (count (:warnings bundle))) :warning
        :else :completed))))

(defn report-section
  [definition bundle id]
  (let [labels (get-in definition [:report :labels])
        title (get labels id)]
    (case id
      :items
      (report/section id :progress (:records bundle) {:section/title title})
      :warnings
      (report/section id :diagnostics (:warning-rows bundle)
                      {:section/title title})
      :errors
      (report/section id :diagnostics (:error-rows bundle)
                      {:section/title title})
      :results
      (report/section id :table (:result-rows bundle)
                      {:section/title title
                       :section/columns (get-in definition [:result :columns])})
      :summary
      (report/section
       id
       :summary
       [(:summary bundle)]
       {:section/title title
        :section/fields
        (or (get-in definition [:summary :fields])
            (get-in definition [:report :summary-fields]))
        :section/strict-fields
        (get-in definition [:report :strict-summary-fields])})
      (report/section id :text [] {:section/title title}))))

(defn task-report
  [definition bundle]
  (let [profile (dissoc (:report definition) :status)
        initial
        (report/document
         (:task/id definition)
         {:profile profile
          :title (:title profile)
          :status (report-status definition bundle)
          :annotations (:annotations bundle)})]
    (loop [sections (:sections profile)
           document initial]
      (if (empty? sections)
        (report/complete document (report-status definition bundle))
        (recur (vec (rest sections))
               (report/add-section
                document
                (report-section definition bundle (first sections))))))))

(defn summarise
  [definition batch context]
  (let [bundle (prepare-bundle definition batch context)
        bundle (assoc bundle :report (task-report definition bundle))]
    (work/emit context :task/warnings-ready
                {:count (count (:warnings bundle))})
    (work/emit context :task/errors-ready
                {:count (count (:errors bundle))})
    (work/emit context :task/results-ready
                {:count (count (:results bundle))})
    (work/emit context :task/summary-ready
                {:summary (:summary bundle)
                 :annotations (:annotations bundle)})
    bundle))

(defn project-output
  [function value]
  (if function (function value) value))

(defn record-pairs
  [records output]
  (vec
   (map
    (fn [record]
      [(:item/id record)
       (project-output output (:data record))])
    records)))

(defn package-records
  [records output package]
  (cond
    (= :records package) (vec records)
    (= :vector package) (record-pairs records output)
    (= :map package) (into {} (record-pairs records output))
    :else
    (throw
     (ex :dependency {:package package} :ex/message "Task return package is not supported"))))

(defn package-section
  [definition bundle id package]
  (case id
    :items
    (package-records
     (:records bundle)
     (get-in definition [:item :output])
     package)

    :results
    (package-records
     (:results bundle)
     (get-in definition [:result :output])
     package)

    :warnings (:warnings bundle)
    :errors (:errors bundle)
    :summary (if (= :test (:task/type definition))
               (assoc (:summary bundle) :report (:report bundle))
               (:summary bundle))
    :annotations (:annotations bundle)
    :report (:report bundle)
    :records (:records bundle)
    (get bundle id)))

(defn package-selection
  [definition bundle selection package]
  (cond
    (= :all selection) bundle
    (keyword? selection)
    (package-section definition bundle selection package)
    :else
    (reduce
     (fn [output id]
       (assoc output
              id
              (package-section definition bundle id package)))
     {}
     selection)))

(defn finish
  [definition batch context]
  (let [bundle (or (:summary batch) batch)
        selection (get-in definition [:return :select])
        package (get-in definition [:return :package])
        output (package-selection definition bundle selection package)]
    (work/emit context :task/run-completed
                {:task/id (:task/id definition)
                 :status (report-status definition bundle)
                 :summary (:summary bundle)
                 :annotations (:annotations bundle)
                 :report (:report bundle)})
    output))

(defn compile
  "Compiles a local task definition into an ordinary work graph.

   The template owns task construction, result shaping, summaries, and report
   data; scheduling, cancellation, timeout, durability, and parallelism remain
   runtime policies."
  [definition]
  (let [definition (normalise-definition definition)
        id (:task/id definition)
        version (:task/version definition)]
    (callable
     (command/batch
      {:id id
       :version version
       :template/schema schema-id
       :template/definition definition}
      {:prepare
       (work/pure
        {:id :task/prepare :version version}
        (fn [input context]
          (prepare-input definition input context)))
       :list
       (work/step
        {:id :task/list :version version}
        (fn [prepared context]
          (list-items definition prepared context)))
       :process
       (unit-work definition)
       :summarise
       (work/pure
        {:id :task/summarise :version version}
        (fn [batch context]
          (summarise definition batch context)))
       :finish
       (work/pure
        {:id :task/finish :version version}
        (fn [batch context]
          (finish definition batch context)))})
     definition)))

(def template compile)

(defn task-work?
  [work-value]
  (= schema-id (:template/schema (work/work-spec work-value))))
