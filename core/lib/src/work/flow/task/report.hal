(ns work.flow.task.report
  (:require [work.base :as work]
            [std.lib.format.report :as format-report]
            [std.lib.format.terminal :as terminal]))

;; A report is portable data. Presentation is delegated to std.lib.format while
;; profiles, document construction, task-event interpretation, and replay
;; remain owned by work.flow.task.report.

(def schema-id "work.flow.task.report/0-alpha")

(def section-kinds
  #{:progress :diagnostics :table :summary :text})

(def style-roles
  #{:default :muted :index :success :warning :error :timeout :bold :critical :highlight})

(def default-sections
  [:items :warnings :errors :results :summary])

(def default-labels
  {:items "ITEMS"
   :warnings "WARNINGS"
   :errors "ERRORS"
   :results "RESULTS"
   :summary "SUMMARY"})

(def default-profile
  {:sections default-sections
   :labels default-labels
   :order :input
   :style true})

(defn contains-value?
  [values value]
  (reduce
   (fn [found candidate]
     (or found (= candidate value)))
   false
   (or values [])))

(defn distinct-values
  [values]
  (reduce
   (fn [output value]
     (if (contains-value? output value)
       output
       (conj output value)))
   []
   (or values [])))

(defn normalise-profile
  [profile]
  (let [profile (merge default-profile (or profile {}))
        sections (distinct-values (:sections profile))
        labels (merge default-labels (or (:labels profile) {}))]
    (assoc profile :sections sections :labels labels)))

(defn section-enabled?
  [profile id]
  (contains-value? (:sections (normalise-profile profile)) id))

(defn section
  ([id kind entries]
   (section id kind entries {}))
  ([id kind entries options]
   (if (not (contains-value? section-kinds kind))
     (throw
      (ex :generic {:section/id id
                :section/kind kind} :ex/message "Work report section kind is not supported")))
   (merge
    {:section/id id
     :section/kind kind
     :section/entries (vec (or entries []))}
    (or options {}))))

(defn document
  ([id]
   (document id {}))
  ([id options]
   (let [profile (normalise-profile (:profile options))]
     {:report/schema schema-id
      :report/id id
      :report/title (or (:title options) (:title profile))
      :report/status (or (:status options) :pending)
      :report/profile profile
      :report/sections []
      :report/annotations (vec (or (:annotations options) []))
      :report/exit-code (:exit-code options)})))

(defn add-section
  [document section]
  (update document :report/sections
          (fn [sections]
            (conj (vec sections) section))))

(defn annotate
  [document annotation]
  (update document :report/annotations
          (fn [annotations]
            (conj (vec annotations) annotation))))

(defn section-by-id
  [document id]
  (first
   (filter
    (fn [section]
      (= id (:section/id section)))
    (:report/sections document))))

(defn complete
  [document status]
  (assoc document :report/status status))

(defn report?
  [value]
  (and (map? value)
       (= schema-id (:report/schema value))
       (vector? (:report/sections value))))

(defn- started-event-document
  [event]
  (let [profile (normalise-profile (:report/profile event))
        sections
        (if (section-enabled? profile :items)
          [(section
            :items
            :progress
            []
            {:section/title
             (get-in profile [:labels :items])})]
          [])]
    {:report/title (:report/title event)
     :report/sections sections
     :report/annotations []}))

(defn- item-event-document
  [event]
  {:report/sections
   [(section
     :items
     :progress
     [(:record event)])]
   :report/annotations []})

(defn event-lines
  "Interprets one committed work event as structured presentation lines."
  ([event]
   (event-lines event {}))
  ([event options]
   (case (:event event)
     :task/run-started
     (format-report/report-lines
      (started-event-document event)
      (merge
       options
       {:include-annotations false
        :include-empty true}))

     :task/item-completed
     (format-report/report-lines
      (item-event-document event)
      (merge
       options
       {:include-title false
        :include-section-titles false
        :include-annotations false}))

     :task/run-completed
     (if (:report event)
       (let [group
             (format-report/report-lines
              (:report event)
              (merge
               options
               {:include-title false
                :exclude-sections
                (distinct-values
                 (conj
                  (vec
                   (or (:exclude-sections options) []))
                  :items))}))]
         (if (empty? group)
           []
           (vec
            (concat
             [{:line/text ""
               :line/role :default}]
             group))))
       [])

     [])))

(defn- events-lines
  [events options]
  (reduce
   (fn [output event]
     (vec
      (concat output (event-lines event options))))
   []
   events))

(defn render-events
  "Renders stored task events as plain text by default or ANSI when enabled."
  ([events]
   (render-events events {}))
  ([events options]
   (terminal/render
    (events-lines events options)
    options)))

(defn observer
  "Creates a report observer over committed work events.

   The output sink is injected through :emit. ANSI styling is optional and
   does not change the portable report document or event interpretation."
  ([]
   (observer {}))
  ([options]
   (work/observer
    (fn [event]
      (terminal/emit-lines
       (event-lines event options)
       options)))))

(defn replay
  "Replays stored events through the same projection as a live observer.

   Returns the number of emitted lines."
  ([events]
   (replay events {}))
  ([events options]
   (terminal/emit-lines
    (events-lines events options)
    options)))
