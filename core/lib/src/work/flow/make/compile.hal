(ns work.flow.make.compile
  (:config {:override [compile]})
  (:require [work.base :as work]))

(defn target-spec
  [value]
  (if (and (map? value)
           (or (has? value :entries)
               (has? value :pre)
               (has? value :post)))
    (assoc value :entries (vec (or (:entries value) [])))
    {:entries
     (cond
       (nil? value) []
       (vector? value) value
       :else [value])}))

(defn target-specs
  [definition]
  (let [sections (or (:sections definition) {})
        targets (merge sections (or (:targets definition) {}))
        targets (if (has? definition :default)
                  (assoc targets :default (:default definition))
                  targets)]
    (reduce
     (fn [output entry]
       (assoc output
              (nth entry 0)
              (target-spec (nth entry 1))))
     {}
     targets)))

(defn entry-id
  [entry index]
  (if (map? entry)
    (or (:id entry)
        (:name entry)
        (:file entry)
        index)
    index))

(defn entry-compiler
  [definition entry]
  (cond
    (fn? entry)
    entry

    (not (map? entry))
    (:compile-entry definition)

    :else
    (or (:compile entry)
        (get (or (:types definition) {}) (:type entry))
        (get (or (:formats definition) {}) (:format entry))
        (:compile-entry definition)
        (if (fn? (:main entry)) (:main entry) nil))))

(defn assert-entry-compiler
  [definition target entry index]
  (let [function (entry-compiler definition entry)]
    (if (not (fn? function))
      (throw
       (ex :hara/generic (assoc {:make/id (:make/id definition)
                 :make/target target
                 :make/index index
                 :make/entry entry} :ex/message "Make entry has no compiler"))))
    function))

(defn assert-hook
  [definition target id function]
  (if (and function (not (fn? function)))
    (throw
     (ex :hara/argument (assoc {:make/id (:make/id definition)
               :make/target target
               :make/hook id
               :make/value function} :ex/message "Make target hook must be a function"))))
  function)

(defn prepare-work
  [target]
  (work/pure
   {:id :make/prepare
    :make/target target}
   (fn [input context]
     {:make/input input
      :make/results []})))

(defn hook-work
  [definition target id function]
  (let [function (assert-hook definition target id function)]
    (work/step
     {:id id
      :make/target target}
     (fn [state context]
       (if function
         (function definition target (:make/input state) context)
         nil)
       state))))

(defn entry-work
  [definition target entry index]
  (let [function (assert-entry-compiler definition target entry index)]
    (work/step
     {:id :make/compile-entry
      :make/target target
      :make/index index}
     (fn [state context]
       (let [value
             (function definition
                       entry
                       (:make/input state)
                       context)
             result
             {:make/target target
              :make/index index
              :make/entry-id (entry-id entry index)
              :make/entry entry
              :make/value value}]
         (assoc state
                :make/results
                (conj (:make/results state) result)))))))

(defn complete-work
  [target]
  (work/pure
   {:id :make/complete
    :make/target target}
   (fn [state context]
     {:make/target target
      :make/input (:make/input state)
      :make/results (:make/results state)
      :make/count (count (:make/results state))})))

(defn compile-target
  "Compiles one make target into an ordinary work chain."
  [definition target spec]
  (let [spec (target-spec spec)
        entries (:entries spec)
        children
        (reduce
         (fn [output indexed]
           (conj output
                 (entry-work definition
                             target
                             (nth indexed 1)
                             (nth indexed 0))))
         [(prepare-work target)
          (hook-work definition target :make/pre (:pre spec))]
         (map-indexed vector entries))
        children
        (conj children
              (hook-work definition target :make/post (:post spec))
              (complete-work target))]
    (work/chain
     {:id target
      :make/id (:make/id definition)
      :make/target target}
     children)))

(defn compile-targets
  [definition specs]
  (reduce
   (fn [output entry]
     (let [target (nth entry 0)
           spec (nth entry 1)]
       (assoc output target (compile-target definition target spec))))
   {}
   specs))

(defn compile-plan
  "Compiles a complete immutable make plan before any live host is changed."
  [definition]
  (let [specs (target-specs definition)]
    {:make/id (:make/id definition)
     :make/definition definition
     :make/target-specs specs
     :make/targets (compile-targets definition specs)
     :make/triggers (vec (or (:triggers definition) []))
     :make/trigger-policy (or (:trigger-policy definition) :on-define)}))

(def compile compile-plan)

(defn matches-selector?
  [selector entry index]
  (cond
    (nil? selector) true
    (fn? selector) (selector entry)
    (map? selector)
    (every?
     (fn [criterion]
       (= (get entry (nth criterion 0))
          (nth criterion 1)))
     selector)
    :else
    (= selector (entry-id entry index))))

(defn select-spec
  [spec selector]
  (let [spec (target-spec spec)
        entries (:entries spec)]
    (assoc spec
           :entries
           (vec
            (map
             (fn [indexed] (nth indexed 1))
             (filter
              (fn [indexed]
                (matches-selector? selector
                                   (nth indexed 1)
                                   (nth indexed 0)))
              (map-indexed vector entries)))))))

(defn directive-parts
  [directive]
  (if (vector? directive)
    [(first directive)
     (if (> (count directive) 1)
       (nth directive 1)
       nil)]
    [directive nil]))

(defn target-work
  "Returns the work graph for a target or a filtered [target selector]."
  [plan directive]
  (let [parts (directive-parts directive)
        target (nth parts 0)
        selector (nth parts 1)
        specs (:make/target-specs plan)
        spec (get specs target)]
    (if (nil? spec)
      (throw
       (ex :hara/generic (assoc {:make/id (:make/id plan)
                 :make/target target
                 :make/available (vec (keys specs))} :ex/message "Make target is not defined"))))
    (if (nil? selector)
      (get (:make/targets plan) target)
      (compile-target (:make/definition plan)
                      target
                      (select-spec spec selector)))))
