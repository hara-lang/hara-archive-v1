(ns work.flow.task
  (:require [work.flow :as flow]
            [work.flow.task.engine :as engine]))

(def path [:task])

(defn profile-definition-options
  [profile]
  (let [options (:workflow/options profile)
        defaults (or (:defaults options) {})
        direct (dissoc options :defaults)]
    (flow/merge-options defaults direct)))

(defn normalise
  [profile qualified-name raw-definition]
  (if (not (map? raw-definition))
    (throw
     (ex :hara/argument (assoc {:workflow/name qualified-name
               :workflow/definition raw-definition} :ex/message "Task workflow definition must be a map"))))
  (let [options (profile-definition-options profile)
        definition (flow/merge-options options raw-definition)]
    (if (or (:task/id definition) (:id definition))
      definition
      (assoc definition :task/id qualified-name))))

(defn compile
  "Compiles a task definition into ordinary work.base primitives."
  ([definition]
   (engine/compile definition))
  ([profile definition]
   (engine/compile definition)))

(def task compile)

(defn invoke
  "Invokes one compiled task through its historical callable surface."
  [task-value & arguments]
  (apply task-value arguments))

(defn reconcile
  [profile previous candidate definition]
  candidate)

(def +flow+
  {:flow/path path
   :flow/version 1
   :flow/product :work
   :flow/defaults {:defaults engine/default-task-options}
   :flow/merge flow/merge-options
   :flow/normalise normalise
   :flow/compile compile
   :flow/reconcile reconcile
   :flow/invoke invoke})

(flow/register +flow+)

(def request engine/request)
(def invocation engine/invocation)
(def invocation-arguments engine/invocation-arguments)
(def task-work? engine/task-work?)
(def default-task-options engine/default-task-options)
(def schema-id engine/schema-id)
(def callable engine/callable)
(def task-defaults engine/task-defaults)

(defn register-profile
  [type options]
  (engine/install-defaults type options))

(defn unregister-profile
  [type]
  (engine/uninstall-defaults type))
