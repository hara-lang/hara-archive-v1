(ns work.flow.make
  (:require [work.flow :as flow]
            [work.flow.make.compile :as compiler]
            [work.flow.make.host :as host]
            [work.flow.make.trigger :as trigger]
            [work.base :as work]))

(def path [:make])

(defn profile-definition-options
  [profile]
  (let [options (:workflow/options profile)
        defaults (or (:defaults options) {})
        direct (dissoc options :defaults)]
    (flow/merge-options defaults direct)))

(defn normalise
  [profile qualified-name raw-definition]
  (if (not (map? raw-definition))
    (throw
     (ex :hara/argument (assoc {:workflow/name qualified-name
               :workflow/definition raw-definition} :ex/message "Make workflow definition must be a map"))))
  (let [options (profile-definition-options profile)
        definition (flow/merge-options options raw-definition)]
    (if (or (:make/id definition) (:id definition))
      (assoc definition :make/id (or (:make/id definition)
                                     (:id definition)))
      (assoc definition :make/id qualified-name))))

(defn compile
  "Compiles one normalised make definition into an immutable plan."
  ([definition]
   (compiler/compile-plan definition))
  ([profile definition]
   (compiler/compile-plan definition)))

(defn reconcile-existing
  [make-host candidate]
  (let [previous-plan (host/plan make-host)
        was-running? (host/running? make-host)
        starts-on-define?
        (= :on-define (:make/trigger-policy candidate))
        will-run? (or was-running? starts-on-define?)
        receipts
        (cond
          was-running?
          (trigger/transition-running make-host
                                      previous-plan
                                      candidate)

          starts-on-define?
          (trigger/install-all make-host candidate)

          :else
          [])
        status (if will-run? :running :stopped)]
    (host/install-plan make-host candidate status receipts)
    make-host))

(defn reconcile
  "Installs a candidate plan while preserving an existing host identity."
  [profile previous candidate definition]
  (if (host/host? previous)
    (reconcile-existing previous candidate)
    (let [make-host (host/create candidate)]
      (if (= :on-define (:make/trigger-policy candidate))
        (trigger/start make-host))
      make-host)))

(def +flow+
  {:flow/path path
   :flow/version 1
   :flow/product :host
   :flow/defaults {:defaults {:trigger-policy :on-define}}
   :flow/merge flow/merge-options
   :flow/normalise normalise
   :flow/compile compile
   :flow/reconcile reconcile})

(flow/register +flow+)

(defn plan
  [make-host]
  (host/plan make-host))

(defn targets
  [make-host]
  (:make/targets (plan make-host)))

(defn target-work
  [make-host directive]
  (compiler/target-work (plan make-host) directive))

(defn revision
  [make-host]
  (host/revision make-host))

(defn status
  [make-host]
  (host/status make-host))

(def host? host/host?)

(defn start
  [make-host]
  (trigger/start make-host))

(defn stop
  [make-host]
  (trigger/stop make-host))

(defn run
  "Runs one make target through work.base.

   A directive may be a target keyword or [target selector]."
  ([make-host]
   (run make-host :default nil {}))
  ([make-host directive]
   (run make-host directive nil {}))
  ([make-host directive input]
   (run make-host directive input {}))
  ([make-host directive input options]
   (let [runtime (or (:runtime options) (work/local-runtime))
         run-options (dissoc options :runtime)]
     (work/run runtime
               (target-work make-host directive)
               input
               run-options))))

(defn build
  ([make-host]
   (run make-host :default))
  ([make-host directive]
   (run make-host directive)))

(defn clean
  ([make-host]
   (clean make-host nil))
  ([make-host input]
   (let [current-plan (plan make-host)
         clean-target (get (:make/targets current-plan) :clean)
         definition (:make/definition current-plan)
         clean-function
         (or (get-in definition [:clean :fn])
             (if (fn? (:clean definition))
               (:clean definition)
               nil))]
     (cond
       clean-target
       (run make-host :clean input)

       clean-function
       (clean-function definition input)

       :else
       nil))))
