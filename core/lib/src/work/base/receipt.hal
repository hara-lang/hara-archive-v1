(ns work.base.receipt
  (:require [work.base.model :as base]
            [work.base.result :as result]
            [work.base.store :as store]))

(def protocol-version "hara.work.receipt/0-alpha")

(defn disabled-provider
  []
  {:provider/role :work/receipt
   :provider/id :disabled
   :provider/capabilities #{}
   :provider/operations {}})

(defn provider-operations
  [provider]
  (or (:provider/operations provider) {}))

(defn provider-id
  [provider]
  (or (:provider/id provider) :receipt))

(defn assert-role
  [provider]
  (if (not= :work/receipt (:provider/role provider))
    (throw
     (ex :generic {:provider/role (:provider/role provider)
               :provider/id (:provider/id provider)} :ex/message "Work provider does not have the receipt role")))
  provider)

(defn normalise-provider
  [provider]
  (cond
    (nil? provider)
    (disabled-provider)

    (and (map? provider)
         (= :work/receipt (:provider/role provider)))
    provider

    (and (map? provider)
         (:provider/role provider))
    (assert-role provider)

    (map? provider)
    {:provider/role :work/receipt
     :provider/id (or (:provider/id provider) :legacy-receipt)
     :provider/capabilities (or (:provider/capabilities provider) #{})
     :provider/retry (or (:provider/retry provider) {})
     :provider/operations provider
     :provider/legacy provider}

    :else
    (throw
     (ex :argument {:provider provider} :ex/message "Work receipt provider must be a descriptor or operation map"))))

(defn append-values
  [output values]
  (reduce
   (fn [items value]
     (conj items value))
   output
   (or values [])))

(defn canonical-run-updates
  [changes]
  (let [updates (or (:transition/run-updates changes) {})]
    (if (has? updates :run/status)
      (assoc updates :run/execution-status (:run/status updates))
      updates)))

(defn transition-run
  [run changes]
  (assoc
   (merge run (canonical-run-updates changes))
   :run/revision (inc (or (:run/revision run) 0))
   :run/receipt-status :pending))

(defn selected-run
  [run]
  {:run/id (:run/id run)
   :run/revision (:run/revision run)
   :run/status (:run/status run)
   :run/execution-status (:run/execution-status run)
   :run/receipt-status (:run/receipt-status run)
   :run/acceptance-status (:run/acceptance-status run)
   :run/work-root (:run/work-root run)
   :run/work-version (:run/work-version run)
   :run/runtime-version (:run/runtime-version run)
   :run/schema-version (:run/schema-version run)
   :run/input (:run/input run)
   :run/result (:run/result run)
   :run/error (:run/error run)
   :run/error-record (:run/error-record run)
   :run/attributes (or (:run/attributes run) {})})

(defn find-event
  [events event]
  (reduce
   (fn [found record]
     (if (and (nil? found)
              (= event (:event record)))
       record
       found))
   nil
   (or events [])))

(defn receipt-id
  [run revision kind identity]
  [protocol-version
   (:run/id run)
   revision
   kind
   identity])

(defn evidence-node-path
  [evidence]
  (or (:checkpoint/node-path evidence)
      (:node/path evidence)))

(defn evidence-item-id
  [evidence]
  (or (:checkpoint/item-id evidence)
      (:item/id evidence)))

(defn payload-root
  [kind run evidence id]
  (let [attributes (or (:run/attributes run) {})]
    (or (:receipt/payload-root evidence)
        (:checkpoint/state-root evidence)
        (:checkpoint/result-root evidence)
        (cond
          (= kind :work/run-created)
          (or (:work/input-root attributes)
              (:input/root attributes))

          (= kind :work/checkpoint)
          (or (:work/checkpoint-root attributes)
              (:checkpoint/root attributes))

          (= kind :work/run-completed)
          (or (:work/receipt-root attributes)
              (:work/result-root attributes)
              (:result/root attributes))

          (= kind :work/run-cancelled)
          (:work/cancellation-root attributes)

          :else
          (:work/execution-root attributes))
        id)))

(defn provenance
  [run evidence]
  (let [attributes (or (:run/attributes run) {})]
    {:executor/identity
     (or (:executor/identity attributes)
         (:agent/identity attributes))
     :capability/evidence
     (or (:capability/evidence evidence)
         (:capability/evidence attributes))
     :effect/evidence
     (or (:effect/evidence evidence)
         (:effect/evidence attributes))
     :node/path (evidence-node-path evidence)
     :item/id (evidence-item-id evidence)}))

(defn envelope
  [run revision kind identity evidence]
  (let [id (receipt-id run revision kind identity)]
    {:receipt/protocol protocol-version
     :receipt/id id
     :receipt/kind kind
     :receipt/run-id (:run/id run)
     :receipt/run-revision revision
     :receipt/work-root (:run/work-root run)
     :receipt/work-version (:run/work-version run)
     :receipt/runtime-version (:run/runtime-version run)
     :receipt/schema-version (:run/schema-version run)
     :receipt/payload-root (payload-root kind run evidence id)
     :receipt/run (selected-run run)
     :receipt/evidence evidence
     :receipt/provenance (provenance run evidence)}))

(defn outbox-entry
  [receipt]
  {:outbox/id (:receipt/id receipt)
   :outbox/key (:receipt/id receipt)
   :outbox/topic :work/receipt
   :outbox/kind (:receipt/kind receipt)
   :outbox/run-id (:receipt/run-id receipt)
   :outbox/run-revision (:receipt/run-revision receipt)
   :outbox/payload-root (:receipt/payload-root receipt)
   :outbox/payload receipt
   :outbox/status :pending
   :outbox/attempts 0})

(defn transition-receipts
  [run changes]
  (let [target (transition-run run changes)
        revision (:run/revision target)
        events (or (:transition/events changes) [])
        started (find-event events :work/run-started)
        cancelled (find-event events :work/run-cancel-requested)
        failed (find-event events :work/run-failed)
        completed (find-event events :work/run-completed)
        output []
        output
        (if started
          (let [output
                (if (= :created (:run/status run))
                  (conj
                   output
                   (outbox-entry
                    (envelope target
                              revision
                              :work/run-created
                              :run-created
                              started)))
                  output)]
            (conj
             output
             (outbox-entry
              (envelope target
                        revision
                        :work/run-started
                        :run-started
                        started))))
          output)
        output
        (reduce
         (fn [items checkpoint]
           (conj
            items
            (outbox-entry
             (envelope target
                       revision
                       :work/checkpoint
                       (:checkpoint/key checkpoint)
                       checkpoint))))
         output
         (or (:transition/checkpoints changes) []))
        output
        (if cancelled
          (conj
           output
           (outbox-entry
            (envelope target
                      revision
                      :work/run-cancelled
                      :run-cancelled
                      cancelled)))
          output)
        output
        (if failed
          (conj
           output
           (outbox-entry
            (envelope target
                      revision
                      :work/run-failed
                      :run-failed
                      failed)))
          output)]
    (if completed
      (conj
       output
       (outbox-entry
        (envelope target
                  revision
                  :work/run-completed
                  :run-completed
                  completed)))
      output)))

(defn transition-outbox
  [run changes]
  (append-values
   (vec (or (:transition/outbox changes) []))
   (transition-receipts run changes)))

(defn receipt-entry?
  [entry]
  (= :work/receipt (:outbox/topic entry)))

(defn entry-status
  [entry]
  (if (= :acked (:outbox/status entry))
    (or (get-in entry [:outbox/ack :receipt/status])
        :published)
    :pending))

(defn entry-view
  [entry]
  (assoc entry :receipt/status (entry-status entry)))

(defn entries
  [runtime reference]
  (let [run-id (if (nil? reference)
                 nil
                 (base/reference-id reference))
        query (if run-id {:run/id run-id} {})]
    (result/then
     (store/call (base/runtime-store runtime)
                 :list-outbox
                 query)
     (fn [values]
       (vec
        (map entry-view
             (filter receipt-entry? values)))))))

(defn any-status?
  [values status]
  (reduce
   (fn [found value]
     (or found (= status (:receipt/status value))))
   false
   values))

(defn all-status?
  [values status]
  (reduce
   (fn [valid value]
     (and valid (= status (:receipt/status value))))
   true
   values))

(defn aggregate-status
  [values]
  (let [values (vec values)]
    (cond
      (empty? values)
      :pending

      (any-status? values :rejected)
      :rejected

      (all-status? values :published)
      :published

      :else
      :pending)))

(defn status
  [runtime reference]
  (result/then
   (entries runtime reference)
   aggregate-status))

(defn positive-attempts
  [value]
  (if (and value (> value 0))
    value
    1))

(defn maximum-attempts
  [provider options]
  (positive-attempts
   (or (:maximum-attempts options)
       (get-in provider [:provider/retry :maximum-attempts])
       (get-in provider [:provider/retry :maximum])
       1)))

(defn normalize-outcome
  [published]
  (let [status
        (if (map? published)
          (or (:receipt/status published)
              (:status published))
          nil)]
    (cond
      (= status :rejected)
      (merge {:receipt/status :rejected} published)

      (or (= status :retry)
          (= status :pending)
          (= status :failed))
      (merge {:receipt/status :retry} published)

      :else
      {:receipt/status :published
       :provider/result published
       :provider/receipt-root
       (if (map? published)
         (or (:provider/receipt-root published)
             (:receipt/root published)
             (:root published))
         nil)})))

(defn attempt-once
  [function receipt attempt]
  (result/attempt
   (fn []
     (result/then
      (function receipt)
      (fn [published]
        (assoc (normalize-outcome published)
               :receipt/attempt attempt))))
   (fn [error]
     {:receipt/status :retry
      :receipt/attempt attempt
      :receipt/reason (str error)})))

(defn deliver-attempt
  [function receipt attempt maximum]
  (result/then
   (attempt-once function receipt attempt)
   (fn [outcome]
     (if (= :retry (:receipt/status outcome))
       (if (< attempt maximum)
         (deliver-attempt function receipt (inc attempt) maximum)
         (assoc outcome
                :receipt/status :pending
                :receipt/attempts attempt))
       (assoc outcome :receipt/attempts attempt)))))

(defn deliver
  [provider receipt options]
  (let [function (get (provider-operations provider) :publish)
        maximum (maximum-attempts provider options)]
    (if (nil? function)
      {:receipt/status :pending
       :receipt/attempts 0
       :receipt/reason "Receipt publication is disabled"}
      (deliver-attempt function receipt 1 maximum))))

(defn ack-data
  [provider outcome]
  {:receipt/status (:receipt/status outcome)
   :receipt/attempts (:receipt/attempts outcome)
   :receipt/reason (or (:receipt/reason outcome)
                       (:reason outcome))
   :provider/id (provider-id provider)
   :provider/result (:provider/result outcome)
   :provider/receipt-root
   (or (:provider/receipt-root outcome)
       (:receipt/root outcome)
       (:root outcome))})

(defn acknowledge
  [runtime provider claim-id entry outcome]
  (store/call
   (base/runtime-store runtime)
   :ack-outbox
   (:outbox/id entry)
   {:claim/id claim-id
    :ack/data (ack-data provider outcome)}))

(defn publication-report
  [entry outcome]
  (merge
   {:outbox/id (:outbox/id entry)
    :outbox/key (:outbox/key entry)
    :outbox/kind (:outbox/kind entry)
    :outbox/run-id (:outbox/run-id entry)}
   outcome))

(defn publish-entry
  [runtime provider claim-id entry options]
  (result/then
   (deliver provider (:outbox/payload entry) options)
   (fn [outcome]
     (let [status (:receipt/status outcome)
           report (publication-report entry outcome)]
       (if (or (= status :published)
               (= status :rejected))
         (result/then
          (acknowledge runtime provider claim-id entry outcome)
          (fn [_]
            report))
         report)))))

(defn sync-run-status
  [runtime run-id]
  (result/then
   (status runtime run-id)
   (fn [receipt-status]
     (result/then
      (store/query (base/runtime-store runtime)
                   {:work/query :run/load :run/id run-id})
      (fn [run]
        (if (and run
                 (not= :pending receipt-status)
                 (not= receipt-status (:run/receipt-status run)))
          (result/then
           (store/transact-current
            (base/runtime-store runtime)
            run-id
            {:transition/run-updates
             {:run/receipt-status receipt-status}})
           (fn [_]
             receipt-status))
          receipt-status))))))

(defn publish-entries-loop
  [runtime provider claim-id entries options index reports]
  (loop [index index
         reports reports]
    (if (= index (count entries))
      reports
      (let [report
            (publish-entry runtime
                            provider
                            claim-id
                            (nth entries index)
                            options)]
        (if (result/asynchronous? report)
          (result/then
           report
           (fn [resolved]
             (publish-entries-loop runtime
                                   provider
                                   claim-id
                                   entries
                                   options
                                   (inc index)
                                   (conj reports resolved))))
          (recur (inc index) (conj reports report)))))))

(defn publish-claimed
  [runtime provider claim-id claimed run-id options]
  (let [receipt-entries (vec (filter receipt-entry? claimed))]
    (result/then
     (publish-entries-loop runtime
                           provider
                           claim-id
                           receipt-entries
                           options
                           0
                           [])
     (fn [reports]
       (if run-id
         (result/then
          (sync-run-status runtime run-id)
          (fn [_]
            reports))
         reports)))))

(defn publish-pending
  ([runtime]
   (publish-pending runtime nil {}))
  ([runtime reference]
   (publish-pending runtime reference {}))
  ([runtime reference options]
   (let [provider (base/runtime-receipt runtime)
         function (get (provider-operations provider) :publish)]
     (if (nil? function)
       []
       (let [run-id (if (nil? reference)
                      nil
                      (base/reference-id reference))
             claim-id
             [protocol-version
              (provider-id provider)
              (or run-id :all)]]
         (result/then
          (store/call
           (base/runtime-store runtime)
           :claim-outbox
           {:run/id run-id
            :claim/id claim-id
            :claim/data
            {:provider/id (provider-id provider)
             :outbox/topic :work/receipt}
            :limit (or (:limit options) 100)})
          (fn [claimed]
            (publish-claimed runtime
                              provider
                              claim-id
                              claimed
                              run-id
                              options))))))))

(defn record
  [frame event data]
  {:receipt/run (:run/id frame)
   :receipt/work-root (:work/root frame)
   :receipt/node-path (:node/path frame)
   :receipt/item-id (:item/id frame)
   :receipt/event event
   :receipt/data (or data {})})

(defn publish
  [provider receipt]
  (let [function (get (provider-operations provider) :publish)]
    (if function
      (function receipt)
      receipt)))
