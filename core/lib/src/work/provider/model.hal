(ns work.provider.model)

;; Pure operational-store rules shared by immediate and durable providers.
;; This namespace contains no atoms, SQL, host calls or Promise handling.

(def status-transitions
  {:created #{:created :queued :running :cancelled}
   :queued #{:queued :running :cancelled}
   :running #{:running :completed :failed :cancelled}
   :failed #{:failed :running :cancelled}
   :completed #{:completed}
   :cancelled #{:cancelled}})

(defn contains-value?
  [values value]
  (reduce
   (fn [found candidate]
     (or found (= value candidate)))
   false
   (or values [])))

(defn validate-run-id
  [id]
  (if (nil? id)
    (throw (ex :hara/argument (assoc {} :ex/message "Work run identity cannot be nil"))))
  id)

(defn normalise-run
  [run]
  (let [status (or (:run/status run) :created)]
    (merge
     {:run/revision 0
      :run/status status
      :run/execution-status status
      :run/receipt-status :pending
      :run/acceptance-status :pending}
     run
     {:run/revision (or (:run/revision run) 0)
      :run/status status
      :run/execution-status status})))

(defn compatible-run?
  [existing proposed]
  (and (= (:run/work-root existing) (:run/work-root proposed))
       (= (:run/work-version existing) (:run/work-version proposed))
       (= (:run/input existing) (:run/input proposed))))

(defn assert-transition-revision
  [run transition]
  (let [expected (:transition/expected-revision transition)
        actual (or (:run/revision run) 0)]
    (if (not= expected actual)
      (throw
       (ex :hara/conflict (assoc {:run/id (:run/id run)
                 :expected/revision expected
                 :actual/revision actual} :ex/message "Work store revision conflict")))))
  run)

(defn assert-status-transition
  [run updates]
  (let [current (:run/status run)
        proposed (or (:run/status updates) current)
        allowed (get status-transitions current)]
    (if (not (contains-value? allowed proposed))
      (throw
       (ex :hara/generic (assoc {:run/id (:run/id run)
                 :run/status current
                 :run/proposed-status proposed} :ex/message "Work run status transition is not allowed")))))
  run)

(defn canonical-run-updates
  [updates]
  (let [updates (or updates {})]
    (if (has? updates :run/status)
      (assoc updates :run/execution-status (:run/status updates))
      updates)))

(defn same-checkpoint?
  [existing proposed]
  (= (dissoc existing :checkpoint/sequence)
     (dissoc proposed :checkpoint/sequence)))

(defn assert-checkpoint-run
  [run-id checkpoint]
  (let [checkpoint-run (:checkpoint/run checkpoint)]
    (if (and checkpoint-run (not= checkpoint-run run-id))
      (throw
       (ex :hara/generic (assoc {:run/id run-id
                 :checkpoint/run checkpoint-run
                 :checkpoint/key (:checkpoint/key checkpoint)} :ex/message "Checkpoint belongs to another work run")))))
  checkpoint)

(defn strip-outbox-state
  [entry]
  (dissoc entry
          :outbox/id
          :outbox/sequence
          :outbox/status
          :outbox/claim-id
          :outbox/claim
          :outbox/claim-until
          :outbox/ack))

(defn same-outbox-intent?
  [existing proposed]
  (= (strip-outbox-state existing)
     (strip-outbox-state proposed)))

(defn outbox-selected?
  [entry query]
  (and
   (or (nil? (:run/id query))
       (= (:run/id query) (:outbox/run entry)))
   (or (nil? (:status query))
       (= (:status query) (:outbox/status entry)))))

(defn claimable?
  [entry options]
  (and (= :pending (:outbox/status entry))
       (or (nil? (:run/id options))
           (= (:run/id options) (:outbox/run entry)))))
