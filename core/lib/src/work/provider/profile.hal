(ns work.provider.profile)

;; Provider descriptors remain data for discovery and configuration. This
;; profile makes their API and dependency tier explicit without changing the
;; existing operation-map compatibility boundary.

(def store-api :std.work.store/v1)
(def executor-api :std.work.executor/v1)
(def receipt-api :std.work.receipt/v1)
(def reporter-api :std.work.reporter/v1)

(def baseline-tier :baseline)
(def extension-tier :extension)
(def tiers #{baseline-tier extension-tier})

(def baseline-identities
  #{[:work/executor :inline]
    [:work/store :memory]
    [:work/receipt :disabled]})

(defn contains-value?
  [values value]
  (reduce
   (fn [found candidate]
     (or found (= candidate value)))
   false
   (or values [])))

(defn api-for-role
  [role]
  (case role
    :work/store store-api
    :work/executor executor-api
    :work/receipt receipt-api
    :work/reporter reporter-api
    (throw
     (ex :io {:provider/role role} :ex/message "Work provider role does not have a registered API"))))

(defn inferred-tier
  [provider]
  (if (contains-value?
       baseline-identities
       [(:provider/role provider) (:provider/id provider)])
    baseline-tier
    extension-tier))

(defn normalise
  "Adds the versioned provider API and baseline/extension tier. Existing
   descriptors without these fields remain readable during the migration."
  [provider]
  (let [provider (or (:descriptor provider) provider)]
    (if (not (map? provider))
      (throw
       (ex :io {:provider provider} :ex/message "Work provider profile requires a descriptor map")))
  (let [role (:provider/role provider)
        id (:provider/id provider)
        tier (or (:provider/tier provider)
                 (inferred-tier provider))
        api (or (:provider/api provider)
                (api-for-role role))]
    (if (nil? role)
      (throw (ex :io {} :ex/message "Work provider requires :provider/role")))
    (if (nil? id)
      (throw (ex :io {} :ex/message "Work provider requires :provider/id")))
    (if (not (contains-value? tiers tier))
      (throw
       (ex :io {:provider/id id
                 :provider/tier tier} :ex/message "Work provider tier is not supported")))
    (assoc
     (assoc provider :provider/api api)
     :provider/tier
     tier))))

(defn baseline
  [provider]
  (normalise (assoc provider :provider/tier baseline-tier)))

(defn extension
  [provider]
  (normalise (assoc provider :provider/tier extension-tier)))

(defn baseline?
  [provider]
  (= baseline-tier (:provider/tier (normalise provider))))

(defn extension?
  [provider]
  (= extension-tier (:provider/tier (normalise provider))))

(defn capability?
  [provider capability]
  (contains-value? (:provider/capabilities provider) capability))

(defn profile
  [provider]
  (let [provider (normalise provider)]
    {:provider/api (:provider/api provider)
     :provider/tier (:provider/tier provider)
     :provider/role (:provider/role provider)
     :provider/id (:provider/id provider)
     :provider/capabilities (:provider/capabilities provider)}))
