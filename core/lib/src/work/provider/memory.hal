(ns work.provider.memory
  (:require [work.provider.model :as model]
            [work.base.store :as store]))

(def status-transitions model/status-transitions)

(defn contains-value?
  [values value]
  (model/contains-value? values value))

(defn memory-validate-run-id
  [id]
  (model/validate-run-id id))

(defn memory-next-id
  [state]
  (let [updated
        (swap! state
               (fn [data]
                 (loop [counter (inc (or (:counter data) 0))]
                   (let [id (str "run-" counter)]
                     (if (nil? (get-in data [:runs id]))
                       (assoc data :counter counter)
                       (recur (inc counter)))))))]
    (str "run-" (:counter updated))))

(defn normalise-run
  [run]
  (model/normalise-run run))

(defn memory-create-run
  [state run]
  (let [run (normalise-run run)
        id (memory-validate-run-id (:run/id run))
        updated
        (swap! state
               (fn [data]
                 (let [existing (get-in data [:runs id])]
                   (cond
                     (nil? existing)
                     (assoc-in data [:runs id] run)

                     (model/compatible-run? existing run)
                     data

                     :else
                     (throw
                      (ex :hara/conflict (assoc {:run/id id
                                :existing/work (:run/work-root existing)
                                :proposed/work (:run/work-root run)} :ex/message "Work run identity conflicts with existing input")))))))]
    (get-in updated [:runs id])))

(defn memory-load-run
  [state id]
  (get-in (deref state) [:runs id]))

(defn memory-list-runs
  [state query]
  (let [runs (vals (:runs (deref state)))
        status (:status query)]
    (vec
     (if status
       (filter (fn [run] (= status (:run/status run))) runs)
       runs))))

(defn assert-transition-revision
  [run transition]
  (model/assert-transition-revision run transition))

(defn assert-status-transition
  [run updates]
  (model/assert-status-transition run updates))

(defn canonical-run-updates
  [updates]
  (model/canonical-run-updates updates))

(defn same-checkpoint?
  [existing proposed]
  (model/same-checkpoint? existing proposed))

(defn assert-checkpoint-run
  [run-id checkpoint]
  (model/assert-checkpoint-run run-id checkpoint))

(defn apply-checkpoints
  [data run-id checkpoints]
  (let [checkpoints (vec (or checkpoints []))]
    (loop [index 0
           data data
           committed []]
      (if (= index (count checkpoints))
        [data committed]
        (let [proposed
              (assoc (assert-checkpoint-run run-id (nth checkpoints index))
                     :checkpoint/run run-id)
              key (:checkpoint/key proposed)]
          (if (nil? key)
            (throw
             (ex :hara/dependency (assoc {:run/id run-id
                       :checkpoint proposed} :ex/message "Checkpoint requires :checkpoint/key"))))
          (let [existing (get-in data [:checkpoints key])]
            (if (and existing
                     (= :completed (:checkpoint/status existing)))
              (if (same-checkpoint? existing proposed)
                (recur (inc index) data (conj committed existing))
                (throw
                 (ex :hara/database (assoc {:run/id run-id
                           :checkpoint/key key} :ex/message "Completed work checkpoint is immutable"))))
              (let [sequence (inc (or (:checkpoint-sequence data) 0))
                    record (assoc proposed :checkpoint/sequence sequence)
                    data
                    (assoc-in
                     (assoc data :checkpoint-sequence sequence)
                     [:checkpoints key]
                     record)]
                (recur (inc index) data (conj committed record))))))))))

(defn apply-events
  [data run-id events]
  (let [events (vec (or events []))]
    (loop [index 0
           data data
           committed []]
      (if (= index (count events))
        [data committed]
        (let [sequence (inc (or (:event-sequence data) 0))
              record
              (assoc (nth events index)
                     :run/id run-id
                     :event/sequence sequence)
              existing (vec (or (get-in data [:events run-id]) []))
              data
              (assoc-in
               (assoc data :event-sequence sequence)
               [:events run-id]
               (conj existing record))]
          (recur (inc index) data (conj committed record)))))))

(defn strip-outbox-state
  [entry]
  (model/strip-outbox-state entry))

(defn same-outbox-intent?
  [existing proposed]
  (model/same-outbox-intent? existing proposed))

(defn apply-outbox
  [data run-id entries]
  (let [entries (vec (or entries []))]
    (loop [index 0
           data data
           committed []]
      (if (= index (count entries))
        [data committed]
        (let [proposed
              (merge {:outbox/run run-id
                      :outbox/status :pending}
                     (nth entries index)
                     {:outbox/run run-id})
              key (:outbox/key proposed)]
          (if (nil? key)
            (throw
             (ex :hara/dependency (assoc {:run/id run-id
                       :outbox proposed} :ex/message "Outbox entry requires :outbox/key"))))
          (let [existing-id (get-in data [:outbox-keys key])
                existing (if existing-id
                           (get-in data [:outbox existing-id])
                           nil)]
            (if existing
              (if (same-outbox-intent? existing proposed)
                (recur (inc index) data (conj committed existing))
                (throw
                 (ex :hara/conflict (assoc {:run/id run-id
                           :outbox/key key} :ex/message "Outbox key conflicts with an existing intent"))))
              (let [sequence (inc (or (:outbox-sequence data) 0))
                    id (or (:outbox/id proposed)
                           (str "outbox-" sequence))
                    record
                    (assoc proposed
                           :outbox/id id
                           :outbox/sequence sequence)
                    data
                    (assoc
                     (assoc-in
                      (assoc-in
                       (assoc data :outbox-sequence sequence)
                       [:outbox id]
                       record)
                      [:outbox-keys key]
                      id)
                     :outbox-order
                     (conj (vec (or (:outbox-order data) [])) id))]
                (recur (inc index) data (conj committed record))))))))))

(defn memory-create-transition
  [data transition]
  (let [run-id (memory-validate-run-id (:transition/run-id transition))
        proposed
        (normalise-run
         (assoc (:transition/create-run transition) :run/id run-id))
        existing (get-in data [:runs run-id])]
    (if (not= :absent (:transition/expected-revision transition))
      (throw
       (ex :hara/dependency (assoc {:run/id run-id
                 :transition/expected-revision
                 (:transition/expected-revision transition)} :ex/message "Work run creation requires an absent revision condition"))))
    (cond
      (nil? existing)
      (let [result
            {:transition/run proposed
             :transition/revision (:run/revision proposed)
             :transition/created? true
             :transition/checkpoints []
             :transition/events []}]
        (assoc
         (assoc-in data [:runs run-id] proposed)
         :last-transition result))

      (model/compatible-run? existing proposed)
      (assoc data
             :last-transition
             {:transition/run existing
              :transition/revision (:run/revision existing)
              :transition/created? false
              :transition/checkpoints []
              :transition/events []})

      :else
      (throw
       (ex :hara/conflict (assoc {:run/id run-id
                 :existing/work (:run/work-root existing)
                 :proposed/work (:run/work-root proposed)} :ex/message "Work run identity conflicts with existing input"))))))

(defn memory-commit-transition
  [data transition]
  (if (:transition/create-run transition)
    (memory-create-transition data transition)
  (let [run-id (memory-validate-run-id (:transition/run-id transition))
        run (get-in data [:runs run-id])]
    (if (nil? run)
      (throw (ex :hara/not-found (assoc {:run/id run-id} :ex/message "Work run does not exist"))))
    (assert-transition-revision run transition)
    (let [updates (canonical-run-updates (:transition/run-updates transition))
          _ (assert-status-transition run updates)
          revision (inc (or (:run/revision run) 0))
          committed-run
          (assoc (merge run updates)
                 :run/revision revision)
          [data checkpoints]
          (apply-checkpoints data
                             run-id
                             (:transition/checkpoints transition))
          [data events]
          (apply-events data
                        run-id
                        (:transition/events transition))
          [data outbox]
          (apply-outbox data
                        run-id
                        (:transition/outbox transition))
          data (assoc-in data [:runs run-id] committed-run)
          result
          {:transition/run committed-run
           :transition/revision revision
           :transition/checkpoints checkpoints
           :transition/events events
           :transition/outbox outbox
           :transition/event-sequences
           (vec (map (fn [event] (:event/sequence event)) events))
           :transition/outbox-sequences
           (vec (map (fn [entry] (:outbox/sequence entry)) outbox))}]
      (assoc data :last-transition result)))))

(defn memory-transact
  [state transition]
  (let [updated
        (swap! state
               (fn [data]
                 (memory-commit-transition data transition)))]
    (:last-transition updated)))

(defn current-transition
  [state run-id changes]
  (let [run (memory-load-run state run-id)]
    (if (nil? run)
      (throw (ex :hara/not-found (assoc {:run/id run-id} :ex/message "Work run does not exist"))))
    (memory-transact
     state
     (store/transition-request run-id
                               (or (:run/revision run) 0)
                               changes))))

(defn memory-update-run
  [state id updates]
  (:transition/run
   (current-transition state id {:transition/run-updates updates})))

(defn memory-append-event
  [state event]
  (let [result
        (current-transition
         state
         (:run/id event)
         {:transition/events [event]})]
    (first (:transition/events result))))

(defn memory-list-events
  [state id]
  (vec (or (get-in (deref state) [:events id]) [])))

(defn memory-load-checkpoint
  [state key]
  (get-in (deref state) [:checkpoints key]))

(defn memory-commit-checkpoint
  [state checkpoint]
  (let [result
        (current-transition
         state
         (:checkpoint/run checkpoint)
         {:transition/checkpoints [checkpoint]})]
    (first (:transition/checkpoints result))))

(defn memory-list-checkpoints
  [state id]
  (vec
   (sort-by
    (fn [checkpoint] (:checkpoint/sequence checkpoint))
    (reduce
     (fn [output checkpoint]
       (if (= id (:checkpoint/run checkpoint))
         (conj output checkpoint)
         output))
     []
     (vals (:checkpoints (deref state)))))))

(defn outbox-selected?
  [entry query]
  (model/outbox-selected? entry query))

(defn memory-list-outbox
  [state query]
  (let [data (deref state)]
    (reduce
     (fn [output id]
       (let [entry (get-in data [:outbox id])]
         (if (and entry (outbox-selected? entry (or query {})))
           (conj output entry)
           output)))
     []
     (vec (or (:outbox-order data) [])))))

(defn claimed-by
  [data claim-id]
  (reduce
   (fn [output id]
     (let [entry (get-in data [:outbox id])]
       (if (and (= :claimed (:outbox/status entry))
                (= claim-id (:outbox/claim-id entry)))
         (conj output entry)
         output)))
   []
   (vec (or (:outbox-order data) []))))

(defn claimable?
  [entry options]
  (model/claimable? entry options))

(defn memory-claim-outbox
  [state options]
  (let [options (or options {})
        limit (or (:limit options) 1)
        updated
        (swap! state
               (fn [data]
                 (let [claim-counter (inc (or (:claim-counter data) 0))
                       claim-id (or (:claim/id options)
                                    (str "claim-" claim-counter))
                       existing (claimed-by data claim-id)]
                   (if (not (empty? existing))
                     (assoc data :last-claim existing)
                     (let [[outbox claimed]
                           (loop [index 0
                                  outbox (:outbox data)
                                  claimed []]
                             (if (or (= index (count (vec (or (:outbox-order data) []))))
                                     (>= (count claimed) limit))
                               [outbox claimed]
                               (let [id (nth (vec (:outbox-order data)) index)
                                     entry (get outbox id)]
                                 (if (claimable? entry options)
                                   (let [record
                                         (assoc entry
                                                :outbox/status :claimed
                                                :outbox/claim-id claim-id
                                                :outbox/claim
                                                (or (:claim/data options) {}))]
                                     (recur (inc index)
                                            (assoc outbox id record)
                                            (conj claimed record)))
                                   (recur (inc index) outbox claimed)))))]
                       (assoc
                        (assoc data
                               :claim-counter claim-counter
                               :outbox outbox)
                        :last-claim claimed))))))]
    (:last-claim updated)))

(defn memory-ack-outbox
  [state id options]
  (let [options (or options {})
        updated
        (swap! state
               (fn [data]
                 (let [entry (get-in data [:outbox id])]
                   (if (nil? entry)
                     (throw
                      (ex :hara/not-found (assoc {:outbox/id id} :ex/message "Outbox entry does not exist"))))
                   (if (and (:claim/id options)
                            (:outbox/claim-id entry)
                            (not= (:claim/id options)
                                  (:outbox/claim-id entry)))
                     (throw
                      (ex :hara/generic (assoc {:outbox/id id
                                :claim/id (:claim/id options)
                                :outbox/claim-id (:outbox/claim-id entry)} :ex/message "Outbox acknowledgement claim does not match"))))
                   (let [record
                         (if (= :acked (:outbox/status entry))
                           entry
                           (assoc entry
                                  :outbox/status :acked
                                  :outbox/ack (or (:ack/data options) {})))]
                     (assoc
                      (assoc-in data [:outbox id] record)
                      :last-ack record)))))]
    (:last-ack updated)))

(defn memory-backend
  "Returns the compatibility operation map backed by atomic transitions."
  []
  (let [state
        (atom {:counter 0
               :event-sequence 0
               :checkpoint-sequence 0
               :outbox-sequence 0
               :claim-counter 0
               :runs {}
               :events {}
               :checkpoints {}
               :outbox {}
               :outbox-keys {}
               :outbox-order []})]
    {:state state
     :next-run-id (fn [] (memory-next-id state))
     :validate-run-id memory-validate-run-id
     :create-run (fn [run] (memory-create-run state run))
     :load-run (fn [id] (memory-load-run state id))
     :list-runs (fn [query] (memory-list-runs state query))
     :transact (fn [transition] (memory-transact state transition))
     :list-events (fn [id] (memory-list-events state id))
     :load-checkpoint (fn [key] (memory-load-checkpoint state key))
     :list-checkpoints (fn [id] (memory-list-checkpoints state id))
     :list-outbox (fn [query] (memory-list-outbox state query))
     :claim-outbox (fn [options] (memory-claim-outbox state options))
     :ack-outbox (fn [id options] (memory-ack-outbox state id options))

     ;; Deprecated compatibility operations. They delegate to :transact so
     ;; older callers cannot create a second non-atomic write path.
     :update-run (fn [id updates] (memory-update-run state id updates))
     :append-event (fn [event] (memory-append-event state event))
     :commit-checkpoint
     (fn [checkpoint] (memory-commit-checkpoint state checkpoint))}))

(defn memory-store
  "Returns the reference operational-store provider."
  []
  (let [backend (memory-backend)]
    (store/normalise-provider
     {:provider/role :work/store
      :provider/id :memory
      :provider/capabilities
      #{:runs :transactions :events :checkpoints :outbox}
      :provider/operations backend
      :provider/legacy backend
      :provider/state (:state backend)})))
