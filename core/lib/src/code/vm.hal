(ns code.vm
  (:config {:role :facade})
  (:require [code.vm.model :as model]
            [code.vm.source :as source]
            [code.vm.interpreter :as interpreter]
            [code.vm.halc :as halc]
            [code.vm.bytecode :as bytecode]
            [code.vm.instrument :as instrument]
            [code.vm.instrument.trace :as instrument-trace]
            [code.vm.conformance :as conformance]))

(intern-in
 [kinds model/+vm-kinds+]
 [statuses model/+vm-statuses+]
 [terminal-statuses model/+terminal-statuses+]
 [default-limits model/+default-limits+]
 [normalize-limits model/normalize-limits]
 [machine? model/machine?]
 [machine model/machine]
 [transition? model/transition?]
 [transition model/transition]
 [advance model/advance]
 [snapshot model/snapshot]
 [trace model/trace]
 [terminal? model/terminal?]
 [source? source/source?]
 [source-form? source/form?]
 [source-index source/index]
 [source-forms source/forms]
 [source-form-at source/form-at]
 [source-form-by-span source/form-by-span]
 [source-entry-form source/entry-form]
 [source-resolve source/resolve]
 [interpreter-journal-schema interpreter/+journal-schema+]
 [interpreter-journal? interpreter/journal?]
 [interpreter-machine? interpreter/interpreter-machine?]
 [interpreter-create interpreter/create]
 [interpreter-source-index interpreter/source-index]
 [interpreter-step interpreter/step]
 [interpreter-run interpreter/run]
 [interpreter-from-journal interpreter/from-journal]
 [halc-trace-schema halc/+trace-schema+]
 [halc-stages halc/+stages+]
 [halc-trace? halc/trace?]
 [halc-machine? halc/halc-machine?]
 [halc-create halc/create]
 [halc-source-index halc/source-index]
 [halc-step halc/step]
 [halc-run halc/run]
 [halc-from-trace halc/from-trace]
 [bytecode-trace-schema bytecode/+trace-schema+]
 [bytecode-event-kinds bytecode/+event-kinds+]
 [bytecode-trace? bytecode/trace?]
 [bytecode-machine? bytecode/bytecode-machine?]
 [bytecode-create bytecode/create]
 [bytecode-source-index bytecode/source-index]
 [bytecode-step bytecode/step]
 [bytecode-resume bytecode/resume]
 [bytecode-run bytecode/run]
 [bytecode-from-trace bytecode/from-trace]
 [instrumentation-protocol instrument/+protocol+]
 [instrumentation-event-schema instrument/+event-schema+]
 [instrumentation-registration instrument/registration]
 [instrumentation-registration? instrument/registration?]
 [instrumentation-target instrument/target]
 [instrumentation-target? instrument/target?]
 [instrumentation-event instrument/event]
 [instrumentation-event? instrument/event?]
 [instrumentation-trace-provenance instrument/trace-provenance]
 [live-trace-machine? instrument-trace/live-machine?]
 [live-trace-target instrument-trace/target]
 [live-trace-provenance instrument-trace/provenance]
 [live-trace-create instrument-trace/create]
 [live-trace-consume instrument-trace/consume]
 [live-trace-consume-all instrument-trace/consume-all]
 [live-trace-from-events instrument-trace/from-events]
 [conformance-schema conformance/+report-schema+]
 [conformance-statuses conformance/+report-statuses+]
 [conformance-stages conformance/+stage-kinds+]
 [conformance-report? conformance/report?]
 [conformance-stage-summary conformance/stage-summary]
 [conformance-teaching-annotations conformance/teaching-annotations]
 [conformance-report conformance/report]
 [conformance-run conformance/run])
