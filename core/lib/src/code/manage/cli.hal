(ns code.manage.cli
  (:require [code.manage :as manage]
            [code.manage.editor :as editor]
            [tool.cli.model :as model]
            [code.project :as project]
            [work.base :as work]))

(def +value-options+
  {"--match" :match "--replacement" :replacement
   "--from" :from "--to" :to "--needle" :needle
   "--form" :form "--var" :var
   "--added" :added "--format" :format})

(def +formats+ #{:edn :editor-json})

(def +test-only+
  #{:refactor-test :isolate :factcheck-remove :factcheck-generate :unchecked})

(def +source-and-test+
  #{:ns-rename :find-usages :grep :grep-replace})

(defn tail [values] (vec (rest values)))

(defn required [remaining option]
  (if (empty? remaining)
    (throw (ex :hara/dependency (assoc {:option option} :ex/message (str option " requires a value"))))
    (first remaining)))

(defn validate-parsed
  [parsed]
  (let [operation (:operation parsed)
        raw-options (:options parsed)
        format (keyword (or (:format raw-options) "edn"))
        options (dissoc raw-options :format)]
    (cond
      (not (has? +formats+ format))
      (throw (ex :hara/syntax (assoc {:format format} :ex/message (str "unsupported manage format " format))))

      (and (= operation :import) (:form options))
      (throw (ex :hara/syntax (assoc {:operation operation :option "--form"} :ex/message "import --form is obsolete; import reads matching fact titles")))

      (and (= operation :purge) (:patterns options))
      (throw (ex :hara/syntax (assoc {:operation operation :option "--pattern"} :ex/message "purge --pattern is obsolete; purge removes docstrings and :added metadata")))

      :else
      (assoc (assoc parsed :format format) :options options))))

(defn parse-arguments [arguments]
  (let [operation (keyword (or (first arguments) "analyse"))]
    (if (nil? (get manage/parity-inventory operation))
      (throw (ex :hara/syntax (assoc {:operation operation} :ex/message (str "unsupported manage operation " operation))))
      (loop [remaining (tail arguments)
             write false
             namespaces []
             patterns []
             options {}]
        (if (empty? remaining)
          (validate-parsed
           {:operation operation
            :write write
            :namespaces namespaces
            :options (if (empty? patterns)
                       options
                       (assoc options :patterns patterns))})
          (let [argument (first remaining)
                more (tail remaining)
                option-key (get +value-options+ argument)
                next-state
                (cond
                  (= argument "--write")
                  {:remaining more
                   :write true
                   :namespaces namespaces
                   :patterns patterns
                   :options options}

                  (= argument "--pattern")
                  {:remaining (tail more)
                   :write write
                   :namespaces namespaces
                   :patterns (conj patterns (required more argument))
                   :options options}

                  option-key
                  {:remaining (tail more)
                   :write write
                   :namespaces namespaces
                   :patterns patterns
                   :options (assoc options option-key (required more argument))}

                  (str/starts-with? argument "-")
                  (throw (ex :hara/syntax (assoc {:option argument} :ex/message (str "unknown manage option " argument))))

                  :else
                  {:remaining more
                   :write write
                   :namespaces (conj namespaces argument)
                   :patterns patterns
                   :options options})]
            (recur (:remaining next-state)
                   (:write next-state)
                   (:namespaces next-state)
                   (:patterns next-state)
                   (:options next-state))))))))


(defn selected? [path namespaces]
  (or (empty? namespaces)
      (not
       (empty?
        (filter
         (fn [namespace]
           (str/includes?
            path
            (str/replace
             (str/replace namespace "." "/") "-" "_")))
         namespaces)))))

(defn roots-for [project operation]
  (cond
    (has? +test-only+ operation) (:project/test-paths project)
    (has? +source-and-test+ operation)
    (vec (concat (:project/source-paths project) (:project/test-paths project)))
    :else (:project/source-paths project)))

(defn unit [path type]
  {:path path
   :type type
   :source (project/read-text path)})

(defn versioned-unit
  [base version]
  (assoc (assoc base :version version)
         :project-version version))

(defn paired-source-unit
  "Adds the mapped test and project-version fields required by manage workflows."
  [base version test-path test-source]
  (assoc (versioned-unit base version)
         :test-path test-path
         :test-source (or test-source "")))

(defn project-test-path
  "Maps an absolute source PATH through the project's corresponding test root."
  [current-project path]
  (project/paired-test-path current-project path))

(defn paired-unit
  [current-project path type]
  (let [version (:project/version current-project)
        base (unit path type)]
    (if (= type :source)
      (let [test-path (project-test-path current-project path)]
        (paired-source-unit
         base
         version
         test-path
         (if (deref (File/exists? test-path))
           (project/read-text test-path)
           "")))
      (versioned-unit base version))))


(defn units-for
  [project parsed]
  (let [test-roots (:project/test-paths project)
        paths (project/files-in project
                                (roots-for project (:operation parsed))
                                ".hal")]
    (reduce
     (fn [output path]
       (if (selected? path (:namespaces parsed))
         (conj output
               (paired-unit
                project
                path
                (if (not
                     (empty?
                      (filter
                       (fn [root]
                         (str/includes?
                          path
                          (File/join (:project/root project) root)))
                       test-roots)))
                  :test
                  :source)))
         output))
     []
     paths)))


(defn current-input
  "Constructs the current-namespace input used by callable code.manage tasks."
  [operation namespace]
  (let [cwd (OS/cwd)
        local-manifest (File/join cwd "project.edn")
        start (if (deref (File/exists? local-manifest))
                local-manifest
                cwd)
        current-project (project/discover start)
        parsed {:operation operation
                :write false
                :namespaces [(str namespace)]
                :format :edn
                :options {}}]
    {:units (units-for current-project parsed)
     :options {}}))

(defn current-source [path]
  (if (deref (File/exists? path)) (project/read-text path) ""))

(defn strip-trailing-separator
  [path]
  (if (and (> (str/length path) 1)
           (str/ends-with? path "/"))
    (strip-trailing-separator
     (str/slice path 0 (dec (str/length path))))
    path))

(defn normalized-path-text
  [path]
  (strip-trailing-separator
   (str/replace (str path) "\\" "/")))

(defn path-under-root?
  [root path]
  (let [root (normalized-path-text root)
        path (normalized-path-text path)]
    (or (= root path)
        (str/starts-with? path (str root "/")))))

(defn resolve-edit-path
  [root path]
  (let [resolved-root (File/resolve root "")
        resolved-path (File/resolve root path)]
    (if (path-under-root? resolved-root resolved-path)
      resolved-path
      (throw
       (ex :hara/io (assoc {:root resolved-root :path path :resolved resolved-path} :ex/message (str "code.manage edit escapes project root: " path)))))))

(defn validate-edit
  [root edit]
  (let [path (resolve-edit-path root (:path edit))
        current (current-source path)]
    (if (= (:before edit) current)
      (assoc edit :resolved-path path)
      (throw (ex :hara/conflict (assoc {:path path} :ex/message (str "code.manage stale edit: " path)))))))

(defn preflight
  [root edits]
  (vec (map (fn [edit] (validate-edit root edit)) edits)))

(defn write-edit
  [edit]
  (let [path (:resolved-path edit)
        parent (File/parent path)]
    (if parent (deref (File/mkdir parent)) nil)
    (deref (File/write path (str/encode-utf8 (:after edit))))
    edit))

(defn apply-edits
  [root edits]
  (let [validated (preflight root edits)]
    (vec (map write-edit validated))))

(defn render-plan
  [plan parsed]
  (if (= :editor-json (:format parsed))
    (Json/write (editor/payload plan (:write parsed)))
    (pr-str plan)))

(defn execute [request]
  (let [parsed (parse-arguments (:request/arguments request))
        start (or (:project (:request/options request))
                  (:root (:request/options request))
                  (:request/cwd request)
                  (OS/cwd))
        current-project (project/discover start)
        plan (manage/plan (:operation parsed)
                          {:units (units-for current-project parsed)
                           :options (:options parsed)})
        output (render-plan plan parsed)]
    (if (:write parsed)
      (apply-edits (:project/root current-project) (:edits plan))
      nil)
    (model/success plan [(model/message (str output "\n"))])))


(def +command-work+
  (work/step
   {:id 'code.manage/cli :version 1}
   (fn [request context] (execute request))))

(defn handler [request]
  (work/run work/default-host +command-work+ request))
