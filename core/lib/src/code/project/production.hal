(ns code.project.production)

(def +namespace-separator+ #{\/})
(def +path-separators+ #{\/ \\})

(def +report-format+ "hara.production-shake/0-alpha")

(def +build-defaults+
  {:build/tree-shake false
   :build/entrypoints #{}
   :build/default-entrypoint nil
   :build/keep-vars #{}
   :build/keep-namespaces #{}})

(defn fail
  ([message] (fail message {}))
  ([message data]
   (throw (ex :generic data :ex/message message))))

(defn identifier-text [value label]
  (cond
    (keyword? value) (str/slice (str value) 1)
    (symbol? value) (str value)
    (string? value) value
    :else (fail (str label " must be a keyword, symbol, or string")
                {:field label :value value})))

(defn profile-name [value]
  (let [text (identifier-text value ":profile/name")]
    (if (or (str/blank? text) (str/includes-any? text +namespace-separator+))
      (fail (str "invalid project profile name: " text)
            {:profile/name value})
      (keyword text))))

(defn namespace-symbol [value label]
  (let [text (cond
               (symbol? value) (str value)
               (string? value) value
               :else (fail (str label " must be a namespace symbol")
                           {:field label :value value}))]
    (if (or (str/blank? text) (str/includes-any? text +namespace-separator+))
      (fail (str label " must be an unqualified namespace symbol")
            {:field label :value value})
      (symbol text))))

(defn qualified-var-symbol [value label]
  (let [text (cond
               (symbol? value) (str value)
               (string? value) value
               :else (fail (str label " must contain qualified Var symbols")
                           {:field label :value value}))
        parts (str/split text "/")]
    (if (and (= 2 (count parts))
             (not (str/blank? (nth parts 0)))
             (not (str/blank? (nth parts 1))))
      (symbol text)
      (fail (str label " must contain qualified Var symbols")
            {:field label :value value}))))

(defn normalize-symbol-set [value label normalize]
  (let [values (if (nil? value) #{} value)]
    (if (not (set? values))
      (fail (str label " must be an EDN set")
            {:field label :value value})
      (reduce (fn [output item]
                (conj output (normalize item label)))
              #{}
              values))))

(defn normalize-language [value]
  (let [text (identifier-text value ":profile/language")]
    (if (or (str/blank? text) (str/includes-any? text +namespace-separator+))
      (fail ":profile/language must be an unqualified identifier"
            {:profile/language value})
      (keyword text))))

(defn normalize-build [value]
  (let [build (if (nil? value) {} value)]
    (if (not (map? build))
      (fail ":profile/build must be an EDN map"
            {:profile/build value})
      (let [tree-shake (get build :build/tree-shake false)
            entrypoints (normalize-symbol-set
                         (get build :build/entrypoints #{})
                         ":build/entrypoints"
                         qualified-var-symbol)
            requested-default-value (get build :build/default-entrypoint)
            requested-default (if (nil? requested-default-value)
                                nil
                                (qualified-var-symbol
                                 requested-default-value
                                 ":build/default-entrypoint"))
            keep-vars (normalize-symbol-set
                       (get build :build/keep-vars #{})
                       ":build/keep-vars"
                       qualified-var-symbol)
            keep-namespaces (normalize-symbol-set
                             (get build :build/keep-namespaces #{})
                             ":build/keep-namespaces"
                             namespace-symbol)]
        (if (not (boolean? tree-shake))
          (fail ":build/tree-shake must be a boolean"
                {:build/tree-shake tree-shake})
          nil)
        (if (and tree-shake (empty? entrypoints))
          (fail ":build/entrypoints must contain at least one qualified Var when tree-shaking is enabled"
                {:build/tree-shake true})
          nil)
        (let [default-entrypoint
              (cond
                requested-default requested-default
                (= 1 (count entrypoints)) (first entrypoints)
                (and tree-shake (< 1 (count entrypoints)))
                (fail ":build/default-entrypoint is required when multiple production entrypoints are declared"
                      {:build/entrypoints entrypoints})
                :else nil)]
          (if (and default-entrypoint
                   (not (has? entrypoints default-entrypoint)))
            (fail ":build/default-entrypoint must name one of :build/entrypoints"
                  {:build/default-entrypoint default-entrypoint
                   :build/entrypoints entrypoints})
            nil)
          (merge build
                 +build-defaults+
                 {:build/tree-shake tree-shake
                  :build/entrypoints entrypoints
                  :build/default-entrypoint default-entrypoint
                  :build/keep-vars keep-vars
                  :build/keep-namespaces keep-namespaces}))))))

(defn normalize-profile [name value]
  (if (not (map? value))
    (fail (str "project profile " name " must be an EDN map")
          {:profile/name name :profile/value value})
    (let [language (get value :profile/language)
          main (get value :profile/main)
          options (get value :profile/options {})
          build (normalize-build (get value :profile/build))]
      (if (nil? language)
        (fail (str "project profile " name " is missing :profile/language")
              {:profile/name name})
        nil)
      (if (not (map? options))
        (fail (str "project profile " name
                   " :profile/options must be an EDN map")
              {:profile/name name :profile/options options})
        nil)
      (merge
       (dissoc value :profile/main)
       {:profile/language (normalize-language language)
        :profile/options options
        :profile/build build}
       (if (nil? main)
         {}
         {:profile/main (namespace-symbol main ":profile/main")})))))

(defn normalize-profiles [value]
  (let [profiles (if (nil? value) {} value)]
    (if (not (map? profiles))
      (fail ":project/profiles must be an EDN map"
            {:project/profiles value})
      (reduce (fn [output pair]
                (let [name (profile-name (first pair))]
                  (if (has? output name)
                    (fail (str "duplicate project profile " name)
                          {:profile/name name})
                    (assoc output
                           name
                           (normalize-profile name (second pair))))))
              {}
              profiles))))

(defn normalize-project [project]
  (if (and (not (has? project :project/profiles))
           (not (has? project :project/default-profile)))
    project
    (let [profiles (normalize-profiles (:project/profiles project))
          default-value (:project/default-profile project)
          default-profile (if (nil? default-value)
                            nil
                            (profile-name default-value))]
      (if (and default-profile (not (has? profiles default-profile)))
        (fail (str "project default profile " default-profile
                   " is not declared in :project/profiles")
              {:project/default-profile default-profile})
        nil)
      (merge
       (dissoc project :project/default-profile)
       {:project/profiles profiles}
       (if default-profile
         {:project/default-profile default-profile}
         {})))))

(defn requested-profile-name [project requested]
  (let [selected (if (nil? requested)
                   (:project/default-profile project)
                   requested)]
    (if (nil? selected)
      (fail "project build requires --profile PROFILE or :project/default-profile"
            {})
      (profile-name selected))))

(defn resolve-profile [project requested]
  (let [project (normalize-project project)
        name (requested-profile-name project requested)
        declaration (std.foundation/get (:project/profiles project) name)]
    (if (nil? declaration)
      (fail (str "project profile " name " is not declared")
            {:profile/name name})
      (let [main (or (:profile/main declaration)
                     (:project/main project))]
        (if (nil? main)
          (fail (str "project profile " name
                     " has no :profile/main or :project/main namespace")
                {:profile/name name})
          {:profile/name name
           :profile/language (:profile/language declaration)
           :profile/main (namespace-symbol main ":profile/main")
           :profile/options (:profile/options declaration)
           :profile/build (:profile/build declaration)})))))

(defn sorted-symbols [values]
  (vec (sort-by str values)))

(defn artifact-stem [project]
  (let [value (str (:project/id project))
        stem (str/replace (str/replace value "/" "-") ":" "-")]
    (if (or (str/blank? stem)
            (= stem ".")
            (= stem "..")
            (str/includes-any? stem +path-separators+))
      (fail (str "project id cannot be used in a production artifact name: "
                 value)
            {:project/id (:project/id project)})
      stem)))

(defn output-paths [project requested-profile]
  (let [stem (artifact-stem project)
        profile (name (code.project.production/profile-name requested-profile))
        prefix (str stem "-" profile)
        bundle (str "target/" prefix ".hbx")
        report (str "target/" prefix ".shake.edn")
        root (:project/root project)]
    {:build/output-bundle bundle
     :build/output-report report
     :build/output-bundle-path (if root (file/join root bundle) bundle)
     :build/output-report-path (if root (file/join root report) report)}))

(defn build-plan [project requested]
  (let [profile (resolve-profile project requested)
        build (:profile/build profile)
        outputs (output-paths project (:profile/name profile))]
    (if (not= :hara (:profile/language profile))
      (fail (str "project build profile " (:profile/name profile)
                 " must use :profile/language :hara")
            {:profile/language (:profile/language profile)})
      nil)
    (if (not (:build/tree-shake build))
      (fail (str "project build profile " (:profile/name profile)
                 " must opt in with :build/tree-shake true")
            {:profile/name (:profile/name profile)})
      nil)
    (merge
     {:project/id (:project/id project)
      :project/version (:project/version project)
      :project/root (:project/root project)
      :profile/name (:profile/name profile)
      :profile/language (:profile/language profile)
      :profile/main (:profile/main profile)
      :build/tree-shake true
      :build/entrypoints (sorted-symbols (:build/entrypoints build))
      :build/default-entrypoint (:build/default-entrypoint build)
      :build/keep-vars (sorted-symbols (:build/keep-vars build))
      :build/keep-namespaces (sorted-symbols
                              (:build/keep-namespaces build))}
     outputs)))

(defn shake-report [plan]
  {:shake/format +report-format+
   :shake/status :pending-analysis
   :shake/project {:project/id (:project/id plan)
                   :project/version (:project/version plan)}
   :shake/profile (:profile/name plan)
   :shake/language (:profile/language plan)
   :shake/main (:profile/main plan)
   :shake/entrypoints (:build/entrypoints plan)
   :shake/default-entrypoint (:build/default-entrypoint plan)
   :shake/keep-vars (:build/keep-vars plan)
   :shake/keep-namespaces (:build/keep-namespaces plan)
   :shake/retained {:vars [] :namespaces []}
   :shake/removed {:vars [] :namespaces []}
   :shake/retention-reasons []
   :shake/dynamic-access-diagnostics []
   :shake/native-roots {:primitives [] :types [] :protocols []}
   :shake/sizes {:input-bytes nil :output-bytes nil}
   :shake/digests {:algorithm :sha-256 :input nil :output nil}
   :shake/output {:bundle (:build/output-bundle plan)
                  :report (:build/output-report plan)}})

(defn shake-report-source [report]
  (str
   "{:shake/format " (pr-str (:shake/format report))
   "\n :shake/status " (pr-str (:shake/status report))
   "\n :shake/project {:project/id "
   (pr-str (get-in report [:shake/project :project/id]))
   " :project/version "
   (pr-str (get-in report [:shake/project :project/version]))
   "}"
   "\n :shake/profile " (pr-str (:shake/profile report))
   "\n :shake/language " (pr-str (:shake/language report))
   "\n :shake/main " (pr-str (:shake/main report))
   "\n :shake/entrypoints " (pr-str (:shake/entrypoints report))
   "\n :shake/default-entrypoint " (pr-str (:shake/default-entrypoint report))
   "\n :shake/keep-vars " (pr-str (:shake/keep-vars report))
   "\n :shake/keep-namespaces "
   (pr-str (:shake/keep-namespaces report))
   "\n :shake/retained {:vars "
   (pr-str (get-in report [:shake/retained :vars]))
   " :namespaces "
   (pr-str (get-in report [:shake/retained :namespaces]))
   "}"
   "\n :shake/removed {:vars "
   (pr-str (get-in report [:shake/removed :vars]))
   " :namespaces "
   (pr-str (get-in report [:shake/removed :namespaces]))
   "}"
   "\n :shake/retention-reasons "
   (pr-str (:shake/retention-reasons report))
   "\n :shake/dynamic-access-diagnostics "
   (pr-str (:shake/dynamic-access-diagnostics report))
   "\n :shake/native-roots {:primitives "
   (pr-str (get-in report [:shake/native-roots :primitives]))
   " :types "
   (pr-str (get-in report [:shake/native-roots :types]))
   " :protocols "
   (pr-str (get-in report [:shake/native-roots :protocols]))
   "}"
   "\n :shake/sizes {:input-bytes "
   (pr-str (get-in report [:shake/sizes :input-bytes]))
   " :output-bytes "
   (pr-str (get-in report [:shake/sizes :output-bytes]))
   "}"
   "\n :shake/digests {:algorithm "
   (pr-str (get-in report [:shake/digests :algorithm]))
   " :input "
   (pr-str (get-in report [:shake/digests :input]))
   " :output "
   (pr-str (get-in report [:shake/digests :output]))
   "}"
   "\n :shake/output {:bundle "
   (pr-str (get-in report [:shake/output :bundle]))
   " :report "
   (pr-str (get-in report [:shake/output :report]))
   "}}\n"))
