(ns code.test.manage)

;; Namespace-scoped suite fixtures are distinct from the general compatibility
;; globals owned by code.test.base.runtime.
(def +global-settings+ (atom {}))

(defn fact:global-map [value] value)
(defn fact:global-fn [value] value)

(defn suite-settings
  [namespace]
  (or (get (deref +global-settings+) namespace)
      {}))

(defn set-suite-settings
  [namespace settings]
  (do
    (swap! +global-settings+ assoc namespace settings)
    settings))

(defn fact-global-form
  [settings]
  (let [setup (or (:setup settings) [])
        teardown (or (:teardown settings) [])]
    `(code.test.manage/set-suite-settings
      (ns-current)
      {:before-all (fn [] ~@setup)
       :after-all (fn [] ~@teardown)})))

(defmacro fact:global
  [settings]
  (fact-global-form settings))

(defn fact:ns-load [namespace] namespace)
(defn fact:ns-unload [namespace] namespace)
(defn fact:ns-alias [alias namespace] [alias namespace])
(defn fact:ns-unalias [alias] alias)
(defn fact:ns-intern [symbol value] [symbol value])
(defn fact:ns-unintern [symbol] symbol)
(defn fact:ns-import [symbol] symbol)
(defn fact:ns-unimport [symbol] symbol)
(defn fact:ns-fn [function] (function))
(defmacro fact:ns [& body] `(do ~@body))
