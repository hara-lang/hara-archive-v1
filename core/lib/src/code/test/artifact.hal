(ns code.test.artifact)

(def +run-dir+ ".tahto/runs")
(def +history-file+ "run-history.csv")
(def +history-header+ "time,command,failures,report\n")
(def +latest+ (atom {}))
(def +artifact-sequence+ (atom 0))

(declare report-edn)

(defn result-record
  "Projects a native Result into stable EDN report data."
  [result]
  (let [context (report-edn (Result/context result))]
    (if (Result/success? result)
      {:status :success
       :data (report-edn (Result/data result))
       :context context}
      (let [error (Result/error-value result)]
        {:status :error
         :error (ex-message error)
         :error-data (report-edn (ex-data error))
         :context context}))))

(defn report-edn-safe?
  [value]
  (or (nil? value)
      (boolean? value)
      (string? value)
      (char? value)
      (keyword? value)
      (symbol? value)
      (number? value)))

(defn report-edn
  [value]
  (cond
    (report-edn-safe? value) value
    (result? value) (result-record value)
    (map? value)
    (reduce (fn [output entry]
              (assoc output
                     (report-edn (nth entry 0))
                     (report-edn (nth entry 1))))
            {}
            value)
    (vector? value) (vec (map report-edn value))
    (set? value) (set (map report-edn value))
    (list? value) (apply list (map report-edn value))
    :else (str value)))

(defn report-entry
  [result]
  (report-edn
   (select-keys
    (assoc result :ns (:namespace result) :function (:name result))
    [:ns :function :namespace :name :status :checks :error :reason :elapsed])))

(defn failure-key
  [result]
  (case (:status result)
    :failed :failed
    :timeout :timeout
    :error :throw
    nil))

(defn failure-report
  [summary]
  (reduce
   (fn [output result]
     (let [key (failure-key result)]
       (if key
         (update output key
                 (fn [values] (conj (vec (or values []))
                                    (report-entry result))))
         output)))
   {}
   (or (:results summary) [])))

(defn failure-count
  [report]
  (+ (count (or (:failed report) []))
     (count (or (:throw report) []))
     (count (or (:timeout report) []))
     (count (or (:errored report) []))))

(defn report-file-path
  [options]
  (or (:report-path options)
      (File/join (File/join (or (:root options) ".") +run-dir+)
                 (str "run-" (get-in options [:test/config :started-at]) ".edn"))))

(defn report->run-path
  [path]
  (str/replace path ".edn" ".run.edn"))

(defn run-file-path
  [report-path options]
  (let [save-run (:save-run options)]
    (cond
      (string? save-run) save-run
      (map? save-run) (or (:path save-run) (report->run-path report-path))
      save-run (report->run-path report-path)
      :else nil)))

(defn history-file-path
  [run-path options]
  (let [save-run (:save-run options)]
    (if run-path
      (if (map? save-run)
        (or (:history save-run)
            (File/join (File/parent run-path) +history-file+))
        (File/join (File/parent run-path) +history-file+))
      nil)))

(defn run-file-options
  [options]
  (dissoc (merge (or (get-in options [:test/config :options]) {})
                 options)
          :test/config
          :test/context
          :report-path
          :save-run
          :root))

(defn run-file-form
  [options]
  (list 'code.test/run
        (list 'quote (run-file-options options))))

(defn csv-cell
  [value]
  (let [value (str (or value ""))
        escaped (str/replace value "\"" "\"\"")]
    (if (str/includes-any? value #{\, \" \newline \return})
      (str "\"" escaped "\"")
      value)))

(defn csv-row
  [values]
  (str (str/join "," (map csv-cell values)) "\n"))

(defn read-text
  [path]
  (str/decode-utf8 (deref (File/read path))))

(defn write-text
  [path content]
  (let [parent (File/parent path)]
    (if parent (deref (File/mkdir parent)) nil)
    (deref (File/write path (str/encode-utf8 content)))
    path))

(defn append-history
  [path row]
  (if path
    (let [exists? (deref (File/exists? path))
          current (if exists? (read-text path) +history-header+)]
      (write-text path (str current row)))
    nil))

(defn artifact-notices
  [artifacts]
  (reduce
   (fn [output entry]
     (let [key (nth entry 0)
           path (nth entry 1)
           label (case key
                   :report-path "Report saved to "
                   :run-path "Run helper saved to "
                   :history-path "Run history saved to "
                   nil)]
       (if (and label path) (conj output (str label path)) output)))
   []
   artifacts))

(defn save-report-paths
  [summary options]
  (let [failures (failure-report summary)
        report-path (if (or (< 0 (failure-count failures))
                            (:save-report options))
                      (report-file-path options)
                      nil)
        run-base (or report-path (report-file-path options))
        run-path (run-file-path run-base options)
        history-path (history-file-path run-path options)]
    (try
      (do
        (if report-path
          (write-text report-path (str (pr-str failures) "\n"))
          nil)
        (if run-path
          (write-text run-path (str (pr-str (run-file-form options)) "\n"))
          nil)
        (if history-path
          (append-history
           history-path
           (csv-row [(get-in options [:test/config :started-at])
                     (pr-str (run-file-form options))
                     (failure-count failures)
                     report-path]))
          nil)
        {:report-path report-path
         :run-path run-path
         :history-path history-path
         :notices (artifact-notices {:report-path report-path
                                     :run-path run-path
                                     :history-path history-path})})
      (catch Throwable error
        {:report-path report-path
         :run-path run-path
         :history-path history-path
         :artifact/error (str error)
         :notices []}))))

(defn record-run
  [summary options report]
  (let [started-at (or (get-in options [:test/config :started-at])
                       (swap! +artifact-sequence+ inc))
        options (assoc-in options [:test/config :started-at] started-at)
        failures (failure-report summary)
        artifacts (save-report-paths summary options)
        latest {:summary summary
                :failures failures
                :options options
                :report report
                :artifacts artifacts}]
    (reset! +latest+ latest)
    latest))

(defn load-report
  [path]
  (if (deref (File/exists? path))
    (read-string (read-text path))
    (throw (ex :not-found {:path path}
               :ex/message "Report file not found"))))

(defn report-failed-facts
  [report]
  (reduce
   (fn [output result]
     (let [namespace (or (:namespace result) (:ns result))
           name (or (:name result) (:function result))]
       (if namespace
         (update output namespace
                 (fn [names]
                   (if name (conj (or names #{}) name) (or names #{}))))
         output)))
   {}
   (concat (or (:failed report) [])
           (or (:throw report) [])
           (or (:timeout report) [])
           (or (:errored report) []))))
