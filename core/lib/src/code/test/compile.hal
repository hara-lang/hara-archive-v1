(ns code.test.compile
  (:require [code.test.base.process :as process]
            [code.test.base.runtime :as runtime]))

(def => '=>)
(def +arrows+ {'=> :test-equal})

(defn arrow? [value] (= value '=>))
(defn fact-allowed? [metadata] (not (:skip metadata)))
(defn fact-skip? [metadata] (if (:skip metadata) true false))
(defn rewrite-top-level [form] form)
(defn fact-id [description] description)
(defn fact-prepare-meta [metadata] metadata)
(defn fact-prepare-core [core] core)
(defn fact-thunk [function] function)

(defn create-fact
  [description function metadata]
  {:namespace (ns-current)
   :name description
   :function function
   :meta metadata})

(defn install-fact
  [fact]
  (runtime/register (:name fact) (:function fact) (:meta fact)))

(defn fact:compile
  [description function metadata]
  (install-fact (create-fact description function metadata)))

(defn fact-eval [fact] ((:function fact) {}))

(defn assertion-forms-strict
  [forms form-meta options]
  (loop [remaining forms
         output []]
    (if (= 0 (count remaining))
      output
      (if (< (count remaining) 3)
        (throw (ex :syntax {:remaining remaining :form-meta form-meta}
                   :ex/message "fact assertions must be actual => expected triples"))
        (let [actual (nth remaining 0)
              arrow (nth remaining 1)
              expected (nth remaining 2)
              check-options (list 'merge
                                  (list 'quote form-meta)
                                  options
                                  'run-options)]
          (if (not (= arrow '=>))
            (throw "fact expects => between actual and expected")
            (recur
             (vec (rest (rest (rest remaining))))
             (conj output
                   `(code.test.base.process/check
                     (fn [] ~actual)
                     ~expected
                     ~check-options)))))))))

(defn assertion-forms
  [forms form-meta options]
  (loop [remaining forms
         setup []]
    (if (= 0 (count remaining))
      (if (= 0 (count setup))
        []
        (apply list (quote do) (concat setup [[]])))
      (if (and (>= (count remaining) 3)
               (= (nth remaining 1) (quote =>)))
        (let [checks (assertion-forms-strict remaining form-meta options)]
          (if (= 0 (count setup))
            checks
            (apply list (quote do) (concat setup [checks]))))
        (recur (vec (rest remaining))
               (conj setup (first remaining)))))))

(defn fact-form
  "Builds the canonical registration form for one or more fact assertions."
  [description body form-meta]
  (let [forms (vec body)
        options (if (map? (first forms)) (first forms) {})
        assertions (if (map? (first forms)) (vec (rest forms)) forms)
        checks (assertion-forms assertions form-meta options)
        setup (:setup form-meta)
        teardown (:teardown form-meta)
        hooks (merge
               (if setup
                 {:before (apply list (quote fn) [] setup)}
                 {})
               (if teardown
                 {:after (apply list (quote fn) [] teardown)}
                 {}))
        registration-options (list (quote merge)
                                   (list (quote quote) form-meta)
                                   options
                                   hooks
                                   (if (= 0 (count checks))
                                     {:skip true}
                                     {}))]
    `(code.test.base.runtime/register
      ~description
      (fn [run-options] ~checks)
      ~registration-options)))

(defmacro fact
  "Registers one or more actual => expected assertions."
  [description & body]
  (fact-form description
             body
             (assoc (or (meta &form) {})
                    :test/namespace
                    (str (:ns &env)))))

(defn fact:purge [] (runtime/purge-facts))
(defn fact:list [] (map :name (runtime/tests)))
(defn fact:missing [] [])

(defmacro fact:all [& body] `(do ~@body))
(defmacro fact:get [name] `(code.test.base.runtime/get-fact ~name))
(defmacro fact:exec [name]
  `((:function (code.test.base.runtime/get-fact ~name)) {}))
(defmacro fact:setup [& body] `(do ~@body))
(defmacro fact:setup? [& body] `(do ~@body))
(defmacro fact:teardown [& body] `(do ~@body))
(defmacro fact:remove [name] `(code.test.base.runtime/remove-fact ~name))
(defmacro fact:symbol [name] name)
(defmacro fact:template [description & body]
  (fact-form description
             body
             (assoc (or (meta &form) {})
                    :test/namespace
                    (str (:ns &env)))))
