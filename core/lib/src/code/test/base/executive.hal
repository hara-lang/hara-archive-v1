(ns code.test.base.executive
  (:require [code.test.artifact :as artifact]
            [code.test.base.runtime :as runtime]
            [code.test.cli :as cli]
            [code.test.work :as test-work]))

(def +latest+ artifact/+latest+)

(def report-edn-safe? artifact/report-edn-safe?)
(def report-edn artifact/report-edn)
(def report->run-path artifact/report->run-path)
(def artifact-notices artifact/artifact-notices)
(def load-report artifact/load-report)
(def report-failed-facts artifact/report-failed-facts)

(defn report-file-path
  ([] (artifact/report-file-path {:test/config {:started-at 0}}))
  ([options] (artifact/report-file-path options)))

(defn run-file-path
  ([options]
   (artifact/run-file-path (artifact/report-file-path options) options))
  ([report-path options]
   (artifact/run-file-path report-path options)))

(defn history-file-path
  [options]
  (artifact/history-file-path (run-file-path options) options))

(def run-file-params artifact/run-file-options)

(defn run-file-form
  ([options] (artifact/run-file-form options))
  ([selector options]
   (artifact/run-file-form (assoc options :namespace selector))))

(defn save-run-history
  [report]
  (:history-path report))

(defn save-artifact
  ([artifact] artifact)
  ([label path content]
   (if path (artifact/write-text path content) nil)))

(defn save-report-paths
  ([summary] (artifact/save-report-paths summary {}))
  ([summary selector options]
   (artifact/save-report-paths summary
                               (assoc options :namespace selector))))

(defn announce-artifacts [artifacts] artifacts)
(defn accumulate [current result] (conj (or current []) result))
(defn interim [results] results)
(defn retrieve-line [key report] (or (get report key) []))

(defn summarise
  [summary]
  (select-keys summary
               [:files :facts :checks :passed :failed :throw :timeout]))

(defn summarise-bulk
  [summary items results]
  summary)

(defn save-report
  ([summary]
   (:run-path (artifact/save-report-paths summary {})))
  ([summary selector options]
   (:run-path
    (artifact/save-report-paths summary
                                (assoc options :namespace selector)))))

(defn unload-namespace [namespace params lookup env] namespace)
(defn load-namespace [namespace params lookup env] namespace)
(defn test-namespace [namespace params lookup env]
  (test-work/run {:namespace namespace}))
(defn run-namespace [namespace params lookup env]
  (let [summary (test-work/run (merge params {:namespace namespace}))]
    (reset! +latest+ summary)
    summary))
(defn run-current [input params lookup env]
  (run-namespace (ns-current) params lookup env))
(defn eval-namespace [namespace]
  (test-work/run {:namespace namespace}))

;; Public facade adapters preserve distinct Foundation workflow entry points
;; while delegating native execution to the canonical code.test.work graph.
(defn run:current
  ([] (test-work/run {:namespace (ns-current)}))
  ([options]
   (test-work/run (assoc options :namespace (ns-current)))))

(defn run:test
  "Evaluates facts already registered in the native test runtime."
  ([] (test-work/run {:namespace :all}))
  ([selector-or-options]
   (test-work/run selector-or-options)))

(defn namespace-selection
  [selector-or-options]
  (let [selection
        (if (map? selector-or-options)
          (:namespace selector-or-options)
          selector-or-options)]
    (cond
      (or (nil? selection) (= :all selection))
      (vec
       (distinct
        (map (fn [fact] (:namespace fact))
             (runtime/tests))))

      (or (vector? selection)
          (list? selection)
          (set? selection))
      (vec selection)

      :else [selection])))

(defn run:load
  "Resolves the namespace load workflow at the native host boundary. HAL
   definitions are already loaded by the runtime, so this returns the resolved
   namespaces without evaluating their tests."
  ([] (run:load :all))
  ([selector-or-options]
   (vec
    (map
     (fn [namespace]
       (load-namespace namespace {} {} {}))
     (namespace-selection selector-or-options)))))

(defn run:unload
  "Removes registered facts for selected namespaces without executing them."
  ([] (run:unload :all))
  ([selector-or-options]
   (let [namespaces (namespace-selection selector-or-options)
         _ (reduce (fn [_ namespace]
                     (runtime/purge-facts namespace))
                   nil
                   namespaces)]
     namespaces)))

(defn run-errored
  ([] (run-errored {}))
  ([options]
   (let [failures (:failures (deref artifact/+latest+))]
     (test-work/run
      (assoc options
             :test/filter
             (artifact/report-failed-facts failures))))))

(defn run:interrupt [] true)

(defn run:report
  ([path] (run:report path {}))
  ([path options]
   (let [report (artifact/load-report path)]
     (test-work/run
      (assoc options
             :test/filter
             (artifact/report-failed-facts report)))))
  ([path options project]
   (run:report path (assoc options :root (:root project)))))

(defn main
  "Runs code.test from command-line arguments using canonical CLI options."
  [& arguments]
  (test-work/run (cli/process-run-args arguments)))
