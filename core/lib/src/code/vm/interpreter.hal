(ns code.vm.interpreter
  (:config {:role :internal})
  (:require [code.vm.model :as model]
            [code.vm.source :as source]))

(def ^{:public true} +journal-schema+
  "hal.evaluation-journal/0-alpha")

(def +journal-statuses+
  #{:ok :error :truncated})

(def +event-kinds+
  #{:evaluation/start
    :macro/expand
    :operation/enter
    :operation/return
    :evaluation/error
    :journal/truncated})

(defn invalid
  [message data]
  (throw (ex :argument data :ex/message message)))

(defn map-value
  [label value]
  (if (map? value)
    value
    (invalid
     (str "code.vm.interpreter " label " must be a map")
     {:field label
      :value value})))

(defn vector-value
  [label value]
  (if (vector? value)
    value
    (invalid
     (str "code.vm.interpreter " label " must be a vector")
     {:field label
      :value value})))

(defn non-empty-string
  [label value]
  (if (and (string? value)
           (> (count value) 0))
    value
    (invalid
     (str "code.vm.interpreter " label " must be a non-empty string")
     {:field label
      :value value})))

(defn non-negative-integer
  [label value]
  (if (and (long? value)
           (>= value 0))
    value
    (invalid
     (str "code.vm.interpreter " label " must be a non-negative integer")
     {:field label
      :value value})))

(defn positive-integer
  [label value]
  (if (and (long? value)
           (> value 0))
    value
    (invalid
     (str "code.vm.interpreter " label " must be a positive integer")
     {:field label
      :value value})))

(defn member
  [label allowed value]
  (if (has? allowed value)
    value
    (invalid
     (str "Unsupported code.vm.interpreter " label ": " value)
     {:field label
      :value value
      :allowed allowed})))

(defn preview?
  [value]
  (and (map? value)
       (string? (:value/type value))
       (string? (:value/display value))
       (or (= true (:value/truncated value))
           (= false (:value/truncated value)))))

(defn event?
  [value]
  (and (map? value)
       (long? (:event/id value))
       (>= (:event/id value) 0)
       (long? (:event/sequence value))
       (>= (:event/sequence value) 0)
       (has? +event-kinds+ (:event/kind value))
       (or (nil? (:event/source value))
           (map? (:event/source value)))))

(defn ^{:public true} journal?
  [value]
  (and (map? value)
       (= +journal-schema+ (:journal/schema value))
       (string? (:journal/id value))
       (> (count (:journal/id value)) 0)
       (has? +journal-statuses+ (:journal/status value))
       (vector? (:journal/events value))
       (every? event? (:journal/events value))
       (or (nil? (:journal/result value))
           (preview? (:journal/result value)))
       (or (nil? (:journal/error value))
           (string? (:journal/error value)))))

(defn normalize-journal
  [value]
  (let [journal (map-value "journal" value)
        schema (:journal/schema journal)
        id (:journal/id journal)
        status (:journal/status journal)
        events (vector-value "journal events"
                             (:journal/events journal))]
    (if (not= +journal-schema+ schema)
      (invalid
       "Unsupported code.vm.interpreter journal schema"
       {:schema schema
        :expected +journal-schema+})
      nil)
    (non-empty-string "journal id" id)
    (member "journal status" +journal-statuses+ status)
    (reduce
     (fn [_ event]
       (if (event? event)
         nil
         (invalid
          "Invalid code.vm.interpreter journal event"
          {:event event})))
     nil
     events)
    (if (and (:journal/result journal)
             (not (preview? (:journal/result journal))))
      (invalid
       "Invalid code.vm.interpreter journal result"
       {:result (:journal/result journal)})
      nil)
    (if (and (:journal/error journal)
             (not (string? (:journal/error journal))))
      (invalid
       "Invalid code.vm.interpreter journal error"
       {:error (:journal/error journal)})
      nil)
    journal))

(defn ^{:public true} interpreter-machine?
  [value]
  (and (model/machine? value)
       (= :interpreter (:vm/kind value))
       (journal? (get-in value [:vm/options :journal]))
       (source/source? (get-in value [:vm/options :source/index]))))

(defn journal
  [machine]
  (if (interpreter-machine? machine)
    (get-in machine [:vm/options :journal])
    (invalid
     "code.vm.interpreter requires an interpreter machine"
     {:value machine})))

(defn ^{:public true} source-index
  [machine]
  (if (interpreter-machine? machine)
    (get-in machine [:vm/options :source/index])
    (invalid
     "code.vm.interpreter requires an interpreter machine"
     {:value machine})))

(defn validate-event-sources
  [source-index journal]
  (reduce
   (fn [_ event]
     (let [reference (:event/source event)]
       (if reference
         (if (source/resolve source-index reference)
           nil
           (invalid
            "code.vm.interpreter event source does not resolve"
            {:event event
             :reference reference}))
         nil)))
   nil
   (:journal/events journal))
  journal)

(defn initial-state
  [journal options]
  {:journal/schema (:journal/schema journal)
   :journal/id (:journal/id journal)
   :journal/status (:journal/status journal)
   :event/index 0
   :event/count (count (:journal/events journal))
   :event/kind nil
   :event/current nil
   :source/current nil
   :operation/current nil
   :operation/stack []
   :operation/sources {}
   :macro/current nil
   :namespace (non-empty-string
               "namespace"
               (or (:namespace options) "user"))
   :result nil
   :error nil
   :truncated (= :truncated (:journal/status journal))})

(defn ^{:public true} create
  ([input journal]
   (create input journal {}))
  ([input journal options]
   (let [options (map-value "options" (or options {}))
         normalized-journal (normalize-journal journal)
         source-options
         (map-value "source options"
                    (or (:source options) {}))
         source-index
         (source/index input source-options)
         validated-journal
         (validate-event-sources source-index normalized-journal)
         adapter-options
         (merge
          (map-value "adapter options"
                     (or (:options options) {}))
          {:journal validated-journal
           :source/index source-index})]
     (model/machine
      :interpreter
      input
      {:id (or (:id options)
               (str "vm/interpreter/" (:journal/id validated-journal)))
       :state (initial-state validated-journal options)
       :options adapter-options
       :limits (:limits options)}))))

(defn explicit-event-source
  [machine event]
  (source/resolve
   (source-index machine)
   (:event/source event)))

(defn retained-operation-source
  [machine event]
  (let [operation-id (:operation/id event)]
    (if operation-id
      (get-in machine [:vm/state :operation/sources operation-id])
      nil)))

(defn current-operation-source
  [machine]
  (let [stack (get-in machine [:vm/state :operation/stack])
        operation-id
        (if (> (count stack) 0)
          (nth stack (dec (count stack)))
          nil)]
    (if operation-id
      (get-in machine [:vm/state :operation/sources operation-id])
      nil)))

(defn resolved-event-source
  [machine event]
  (or
   (explicit-event-source machine event)
   (retained-operation-source machine event)
   (if (= :evaluation/error (:event/kind event))
     (current-operation-source machine)
     nil)
   (if (= :evaluation/start (:event/kind event))
     (source/entry-form (source-index machine))
     nil)))

(defn event-source
  [journal event form]
  (merge
   {:journal/id (:journal/id journal)
    :event/id (:event/id event)
    :event/sequence (:event/sequence event)
    :event/source (:event/source event)}
   (or form {})))

(defn event-stage-rule
  [event]
  (let [kind (:event/kind event)]
    (cond
      (= kind :evaluation/start) [:evaluate :evaluation/start]
      (= kind :macro/expand) [:expand :macro/expand]
      (= kind :operation/enter) [:call :operation/enter]
      (= kind :operation/return) [:return :operation/return]
      (= kind :evaluation/error) [:error :evaluation/error]
      (= kind :journal/truncated) [:trace :journal/truncated]
      :else
      (invalid
       "Unsupported code.vm.interpreter event kind"
       {:event event}))))

(defn retain-operation-source
  [state event form]
  (let [operation-id (:operation/id event)]
    (if (and operation-id form)
      (assoc (:operation/sources state) operation-id form)
      (:operation/sources state))))

(defn without-operation
  [stack operation-id]
  (loop [index 0
         output []]
    (if (= index (count stack))
      output
      (let [candidate (nth stack index)]
        (recur
         (inc index)
         (if (= candidate operation-id)
           output
           (conj output candidate)))))))

(defn event-state
  [machine event form]
  (let [state (:vm/state machine)
        kind (:event/kind event)
        base (assoc state
                    :event/index (inc (:event/index state))
                    :event/kind kind
                    :event/current event
                    :source/current form)]
    (cond
      (= kind :evaluation/start)
      (assoc base
             :result nil
             :error nil)

      (= kind :macro/expand)
      (assoc base
             :macro/current event)

      (= kind :operation/enter)
      (assoc
       (assoc
        (assoc base
               :operation/current event)
        :operation/stack
        (conj (:operation/stack state) (:operation/id event)))
       :operation/sources
       (retain-operation-source state event form))

      (= kind :operation/return)
      (assoc
       (assoc base
              :operation/current event)
       :operation/stack
       (without-operation
        (:operation/stack state)
        (:operation/id event)))

      (= kind :evaluation/error)
      (assoc base
             :error (:error/message event))

      (= kind :journal/truncated)
      (assoc base
             :truncated true
             :truncation/reason (:truncation/reason event))

      :else
      (invalid
       "Unsupported code.vm.interpreter event kind"
       {:event event}))))

(defn event-transition
  [machine journal event]
  (let [[stage rule] (event-stage-rule event)
        failed (= :evaluation/error (:event/kind event))
        form (resolved-event-source machine event)]
    (model/transition
     machine
     stage
     rule
     (event-state machine event form)
     {:source (event-source journal event form)
      :events [event]
      :status (if failed :failed :running)
      :error (if failed (:error/message event) nil)})))

(defn final-transition
  [machine journal]
  (let [failed (= :error (:journal/status journal))
        result (:journal/result journal)
        error (:journal/error journal)
        state (assoc (:vm/state machine)
                     :journal/status (:journal/status journal)
                     :event/current nil
                     :result result
                     :error error
                     :truncated (= :truncated
                                   (:journal/status journal)))]
    (model/transition
     machine
     :evaluate
     (if failed :evaluation/failed :evaluation/complete)
     state
     {:source {:journal/id (:journal/id journal)
               :event/sequence (count (:journal/events journal))}
      :status (if failed :failed :returned)
      :result (if failed nil result)
      :error (if failed error nil)})))

(defn ^{:public true} step
  [machine]
  (if (model/terminal? machine)
    machine
    (let [journal (journal machine)
          index (get-in machine [:vm/state :event/index])
          event (get (:journal/events journal) index)]
      (if event
        (model/advance
         machine
         (event-transition machine journal event))
        (model/advance
         machine
         (final-transition machine journal))))))

(defn suspend-at-limit
  [machine]
  (if (or (model/terminal? machine)
          (= :suspended (:vm/status machine)))
    machine
    (model/advance
     machine
     (model/transition
      machine
      :control
      :run/step-limit
      (assoc (:vm/state machine)
             :suspension/reason :step-limit)
      {:status :suspended}))))

(defn ^{:public true} run
  ([machine]
   (run machine {}))
  ([machine options]
   (let [options (map-value "run options" (or options {}))
         limit (positive-integer
                "run step limit"
                (or (:steps options)
                    (get-in machine [:vm/limits :steps])))]
     (loop [current machine
            remaining limit]
       (if (model/terminal? current)
         current
         (if (= remaining 0)
           (suspend-at-limit current)
           (recur (step current)
                  (dec remaining))))))))

(defn ^{:public true} from-journal
  ([input journal]
   (from-journal input journal {}))
  ([input journal options]
   (let [options (map-value "options" (or options {}))]
     (run (create input journal options)
          (or (:run options) {})))))
