;; ============================================================================
;; code.test — curated public facade over native Hara test modules.
;;
;; Implementations live in code.test.* owners. This namespace intentionally
;; contains aliases and macro forwarding wrappers only.
;; ============================================================================
(ns code.test
  (:require [code.test.artifact :as artifact]
            [code.test.base.executive :as executive]
            [code.test.base.process :as process]
            [code.test.base.runtime :as runtime]
            [code.test.checker.collection :as collection]
            [code.test.checker.common :as common]
            [code.test.checker.logic :as logic]
            [code.test.checker.schema :as schema-checker]
            [code.test.cli :as cli]
            [code.test.compile :as compile]
            [code.test.manage :as manage]
            [code.test.result :as test-result]
            [code.test.work :as test-work]))

;; Assertion vocabulary.
(def => compile/=>)
(def anything common/anything)
(def exactly common/exactly)
(def satisfies common/satisfies)
(def approx common/approx)
(def stores common/stores)
(def contains collection/contains)
(def just collection/just)
(def throws-info collection/throws-info)
(def is-not logic/is-not)
(def any logic/any)
(def all logic/all)
(def throws common/throws)
(def conforms schema-checker/conforms)
(def check process/check)
(def compare test-result/compare)
(def comparison-result test-result/result)
(def comparison-passed? test-result/passed?)
(def comparison-actual test-result/actual)
(def comparison-expected test-result/expected)
(def comparison-failures test-result/failures)
(def comparison-failure-seq test-result/failure-seq)
(def comparison-failure-count test-result/failure-count)
(def comparison-failure test-result/failure)
(def comparison-failure? test-result/failure?)

(defmacro contains-in
  [expected]
  (collection/contains-in-form expected))

(defmacro just-in
  [expected]
  (collection/just-in-form expected))

(defmacro capture
  ([] `(code.test.checker.common/capture nil $0))
  ([check] `(code.test.checker.common/capture ~check $0))
  ([check symbol] `(code.test.checker.common/capture ~check ~symbol)))

(defmacro fact
  "Registers one or more actual => expected assertions."
  [description & body]
  (compile/fact-form description
                     body
                     (assoc (or (meta &form) {})
                            :test/namespace
                            (str (:ns &env)))))

;; Fact registry lifecycle and direct single-fact execution.
(def register runtime/register)
(def remove-fact runtime/remove-fact)
(def purge-facts runtime/purge-facts)
(def purge-all runtime/purge-registry)
(def tests runtime/tests)
(def registry runtime/registry)
(def get-fact runtime/get-fact)
(def run-fact process/run-fact)

;; Canonical durable execution and artifacts.
(def run test-work/run)
(def start test-work/start)
(def run-batch test-work/run-batch)
(def start-batch test-work/start-batch)
(def batch-result test-work/batch-result)
(def run-tests test-work/run-tests)
(def +runner-work+ test-work/+runner-work+)
(def +latest+ artifact/+latest+)

;; Foundation-compatible fact entrypoints. Expansions target canonical owners
;; directly so (:use code.test) never creates a dependency back-edge.
(def fact:purge compile/fact:purge)
(def fact:list compile/fact:list)
(def fact:missing compile/fact:missing)

(defmacro fact:all [& body] `(do ~@body))
(defmacro fact:get [name] `(code.test.base.runtime/get-fact ~name))
(defmacro fact:exec [name]
  `((:function (code.test.base.runtime/get-fact ~name)) {}))
(defmacro fact:setup [& body] `(do ~@body))
(defmacro fact:setup? [& body] `(do ~@body))
(defmacro fact:teardown [& body] `(do ~@body))
(defmacro fact:remove [name]
  `(code.test.base.runtime/remove-fact ~name))
(defmacro fact:symbol [name] name)
(defmacro fact:template [description & body]
  (compile/fact-form description
                     body
                     (assoc (or (meta &form) {})
                            :test/namespace
                            (str (:ns &env)))))
(defmacro fact:global [settings]
  (manage/fact-global-form settings))
(defmacro fact:ns [& body] `(do ~@body))
(def fact:ns-load manage/fact:ns-load)

;; Foundation-compatible run/report/CLI adapters.
(def run:current executive/run:current)
(def run:test executive/run:test)
(def run:load executive/run:load)
(def run:unload executive/run:unload)
(def run-errored executive/run-errored)
(def run:interrupt executive/run:interrupt)
(def run:report executive/run:report)
(def print-options cli/print-options)
(def process-test-args cli/process-run-args)
(def -main executive/main)
