;; crypto.ext.noir — package contract for the Noir HTA extension.
;;
;; The executable provider remains an HTA worker. This namespace owns the
;; stable Hara packaging surface while preserving the existing ledger.noir
;; extension identity used by the runtime and registry.
(ns crypto.ext.noir)

^{:public true}
(def +namespace+ "crypto.ext.noir")
^{:public true}
(def +extension-namespace+ "ledger.noir")
^{:public true}
(def +identity+ "hara/ledger.noir")
^{:public true}
(def +version+ "0.1.0")
^{:public true}
(def +artifact-format+ "hara/ledger.noir/v1")
^{:public true}
(def +proof-format+ "hara.noir.proof/0-alpha")

^{:public true}
(def +exports+
  {"compile" {:args [:value] :returns :value :async true}
   "prove"   {:args [:value :map] :returns :value :async true}
   "verify"  {:args [:value :value] :returns :boolean :async true}})

^{:public true}
(def +assets+
  ["assets/noir-wasm.mjs"
   "assets/barretenberg.js"
   "assets/barretenberg-threads.js"
   "assets/main.worker.js"
   "assets/thread.worker.js"])

^{:public true}
(def +targets+
  {:node {:module "node/worker.mjs" :runtime :process}
   :browser {:module "browser/worker.mjs" :runtime :web-worker}})

^{:public true}
(def +manifest+
  {:namespace +extension-namespace+
   :identity +identity+
   :version +version+
   :provider :hta
   :abi :hta.v1
   :targets +targets+
   :assets +assets+
   :exports +exports+
   :capabilities []})

^{:public true}
(defn manifest
  "Returns the canonical extension manifest used by package builders."
  []
  +manifest+)
