;; crypto.ext.noir — package contract for the Noir HTA extension.
;;
;; The executable provider is loaded by the runtime-owned generic HTA worker.
;; This namespace owns the stable Hara packaging surface while preserving the
;; existing ledger.noir extension identity used by the runtime and registry.
(ns crypto.ext.noir)

(def ^{:public true} +namespace+ "crypto.ext.noir")
(def ^{:public true} +extension-namespace+ "ledger.noir")
(def ^{:public true} +identity+ "hara/ledger.noir")
(def ^{:public true} +version+ "0.1.0")
(def ^{:public true} +artifact-format+ "hara/ledger.noir/v1")
(def ^{:public true} +proof-format+ "hara.noir.proof/0-alpha")

(def ^{:public true} +exports+
  {"compile" {:args [:value] :returns :value :async true}
   "prove"   {:args [:value :map] :returns :value :async true}
   "verify"  {:args [:value :value] :returns :boolean :async true}})

(def ^{:public true} +assets+
  ["assets/noir-wasm.mjs"
   "assets/barretenberg.js"
   "assets/barretenberg-threads.js"
   "assets/main.worker.js"
   "assets/thread.worker.js"])

(def ^{:public true} +targets+
  {:node {:provider "node/provider.mjs" :runtime :process}
   :browser {:provider "browser/provider.mjs" :runtime :web-worker}})

(def ^{:public true} +manifest+
  {:namespace +extension-namespace+
   :identity +identity+
   :version +version+
   :provider :hta
   :abi :hta.v1
   :targets +targets+
   :assets +assets+
   :exports +exports+
   :capabilities []})

(defn ^{:public true} manifest
  "Returns the canonical extension manifest used by package builders."
  []
  +manifest+)
