;; ============================================================================
;; db.node.proxy-util — transport selection for database client requests.
;; ============================================================================
(ns db.node.proxy-util
  (:require [std.substrate :as substrate]))

(def DEFAULT-TRANSPORT-SERVICE "db.runtime/default-transport")

(defn- compatible-get
  [value lookup-key]
  (cond
    (not (map? value)) nil
    (has? value lookup-key) (get value lookup-key)
    (string? lookup-key) (get value (keyword lookup-key))
    (keyword? lookup-key) (get value (name lookup-key))
    :else nil))

(defn- option
  [value primary alternate]
  (or (compatible-get value primary)
      (compatible-get value alternate)))

(defn set-default-transport
  "Sets the default server transport ID for database proxy requests."
  [node transport-id]
  (substrate/set-service node DEFAULT-TRANSPORT-SERVICE transport-id)
  transport-id)

(defn get-default-transport
  "Returns the default server transport ID."
  [node]
  (substrate/get-service node DEFAULT-TRANSPORT-SERVICE))

(defn get-transport-id
  "Resolves a transport from options, node default or first attached transport."
  [node options]
  (or (option options :transport-id :transport_id)
      (get-default-transport node)
      (first (substrate/transport-list node))))

(defn request-options
  "Preserves Substrate timeout, cancellation and metadata while choosing transport."
  [node options]
  (let [transport-id (get-transport-id node options)
        timeout-ms (option options :timeout-ms :timeout_ms)
        signal (compatible-get options :signal)
        metadata (or (compatible-get options :meta) {})
        base {:meta metadata}
        with-transport (if transport-id
                         (assoc base :transport-id transport-id)
                         base)
        with-timeout (if timeout-ms
                       (assoc with-transport :timeout-ms timeout-ms)
                       with-transport)]
    (if signal
      (assoc with-timeout :signal signal)
      with-timeout)))

(defn request-proxy
  "Forwards the current canonical request frame across the configured transport."
  [space args request node]
  (let [options (request-options node {})
        options (assoc options :meta (or (get request "meta") {}))]
    (substrate/request node
                       nil
                       (get request "action")
                       args
                       options)))

(defn request-client
  "Invokes a local handler when present, otherwise forwards over transport."
  [node action args options]
  (let [request-options (request-options node options)]
    (if (substrate/get-handler node action)
      (substrate/request node nil action args (assoc request-options :local true))
      (if (get request-options :transport-id)
        (substrate/request node nil action args request-options)
        (throw (ex :database {:action action
                         :transports (substrate/transport-list node)} :ex/message "No database runtime transport is attached"))))))
