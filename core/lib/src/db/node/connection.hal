;; ============================================================================
;; db.node.connection — provider-neutral handles to runtime database services.
;;
;; A RuntimeConnection does not own the remote service. Closing it invalidates
;; only the local handle; runtime teardown remains an explicit lifecycle action.
;; ============================================================================
(ns db.node.connection
  (:require [db.node.client-base :as client]
            [db.protocol :as protocol]))

(defstruct RuntimeConnection
  [node service-id engine provider info options closed])

(defn- ensure-open
  [connection]
  (if (deref (:closed connection))
    (throw (ex :hara/database (assoc {:service (:service-id connection)} :ex/message "Database runtime connection is closed")))
    connection))

(extend-type RuntimeConnection protocol/IDatabase
  (db-engine [connection]
    (:engine connection))
  (db-provider [connection]
    (:provider connection))
  (db-info [connection]
    (let [info (:info connection)]
      (assoc info
             :remote true
             :service-id (:service-id connection)
             :closed (deref (:closed connection)))))
  (db-exec [connection sql parameters]
    (ensure-open connection)
    (client/exec (:node connection)
                 (:service-id connection)
                 sql
                 parameters
                 (:options connection)))
  (db-query [connection sql parameters]
    (ensure-open connection)
    (client/query (:node connection)
                  (:service-id connection)
                  sql
                  parameters
                  (:options connection)))
  (db-close [connection]
    (reset! (:closed connection) true)
    (promise/from true)))

(defn open
  "Returns a promise resolving to a provider-neutral runtime connection.

   The runtime service remains alive when this local handle is closed."
  ([node service-id]
   (open node service-id {}))
  ([node service-id options]
   (promise/then
    (client/service-info node service-id options)
    (fn [info]
      (db.node.connection/RuntimeConnection
       node
       service-id
       (get info :engine)
       (get info :provider)
       info
       options
       (atom false))))))

(defn closed?
  "Returns true when the local runtime connection handle is closed."
  [connection]
  (deref (:closed connection)))
