;; ============================================================================
;; db.postgres — managed PostgreSQL lifecycle facade.
;;
;; Concrete connection and host-provider operations live in
;; db.postgres.connection. This namespace composes those primitives with
;; Docker, temporary-database and component lifecycle management.
;; ============================================================================
(ns db.postgres
  (:require [tool.sh.docker :as docker]
            [db.postgres.connection :as connection]
            [std.lib.component :as component]))

(def SERVICE connection/SERVICE)

(def open connection/open)
(def start open)

(def close connection/close)
(def stop close)

(def exec connection/exec)
(def execute connection/execute)
(def query connection/query)
(def batch-exec connection/batch-exec)

(def listen connection/listen)
(def next-notification connection/next-notification)
(def unlisten connection/unlisten)
(def notify connection/notify)

(def describe connection/describe)
(def capabilities connection/capabilities)
(def provider-descriptor connection/provider-descriptor)
(def version connection/version)
(def wait-ready connection/wait-ready)

(def server-start connection/server-start)
(def server-stop connection/server-stop)
(def database-create connection/database-create)
(def database-drop connection/database-drop)

(def begin connection/begin)
(def commit connection/commit)
(def rollback connection/rollback)

(def numeric connection/numeric)
(def sql-array connection/sql-array)
(def tagged? connection/tagged?)
(def tag-type connection/tag-type)
(def tag-value connection/tag-value)

(defn run-lifecycle
  [runtime command]
  (if command
    (if (fn? command)
      (command runtime)
      (throw (ex :database {:command command} :ex/message "PostgreSQL lifecycle hooks must be functions in HAL")))
    runtime))

(defn connection-options
  [runtime]
  (let [options (:config (:options runtime))
        container (:container runtime)
        environment (get-in options [:container :environment])
        options (dissoc options :container :temp :startup :shutdown)
        options (if container
                  (merge options {:host (:host container) :port (:port container)})
                  options)
        options (if (or (:user options) (nil? environment))
                  options
                  (assoc options :user (get environment "POSTGRES_USER")))]
    (if (or (:password options) (nil? environment))
      options
      (assoc options :password (get environment "POSTGRES_PASSWORD")))))

(defn admin-options
  [options]
  (assoc (dissoc options :database) :dbname "postgres"))

(defn start-pg-raw
  [runtime]
  (let [options (connection-options runtime)
        admin (admin-options options)
        database (:dbname options)
        timeout (:timeout runtime)]
    (deref (connection/wait-ready admin))
    (if (get-in runtime [:options :config :temp])
      (deref (connection/database-create admin database)))
    (reset! (:connection runtime)
            (deref (connection/open options)))
    runtime))

(defn stop-pg-raw
  [runtime]
  (let [value (deref (:connection runtime))
        options (connection-options runtime)
        database (:dbname options)
        temp (get-in runtime [:options :config :temp])
        timeout (:timeout runtime)]
    (if value
      (deref (connection/close value)))
    (reset! (:connection runtime) nil)
    (if (and temp (not= temp :create))
      (deref (connection/database-drop (admin-options options) database)))
    runtime))

(def start-pg
  (component/wrap-start
   start-pg-raw
   [{:key :startup :setup run-lifecycle}
    {:key :container :setup docker/start-runtime}]))

(def stop-pg
  (component/wrap-stop
   stop-pg-raw
   [{:key :container :teardown docker/stop-runtime}
    {:key :shutdown :teardown run-lifecycle}]))
