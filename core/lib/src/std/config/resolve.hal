(ns std.config.resolve
  (:config {:override [resolve load]})
  (:require [std.config.common :as common]
            [std.config.ext.json :as json]
            [std.config.global :as global]))

(def +config+ "config.edn")

(def ^:dynamic *directives*
  (atom {}))

(def ^:dynamic *types*
  (atom {}))

(declare resolve-form load-file)

(defn register-directive
  "Registers a portable configuration directive handler. A handler receives
   [form context state]."
  [directive function]
  (if (not (keyword? directive))
    (throw
     (ex :hara/argument (assoc {:directive directive} :ex/message "Configuration directive id must be a keyword"))))
  (if (not (fn? function))
    (throw
     (ex :hara/argument (assoc {:directive directive} :ex/message "Configuration directive handler must be a function"))))
  (swap! *directives* assoc directive function)
  function)

(defn register-type
  "Registers a portable content decoder."
  [type function]
  (if (not (keyword? type))
    (throw
     (ex :hara/argument (assoc {:type type} :ex/message "Configuration type id must be a keyword"))))
  (if (not (fn? function))
    (throw
     (ex :hara/serialization (assoc {:type type} :ex/message "Configuration type decoder must be a function"))))
  (swap! *types* assoc type function)
  function)

(defn directive?
  [form]
  (and (vector? form)
       (keyword? (first form))
       (or (has? (deref *directives*) (first form))
           (has? common/deferred-directives (first form)))))

(defn decode-type
  [type content]
  (if (nil? content)
    nil
    (let [decoder (get (deref *types*) type)]
      (cond
        decoder (decoder content)
        (has? common/deferred-types type)
        (throw (common/unsupported-feature type :type))
        :else
        (throw
         (ex :hara/serialization (assoc {:error/type :std.config/unknown-type
                   :type type} :ex/message "Unknown configuration content type")))))))

(defn resolve-content
  [content options]
  (let [options (common/assert-portable-options (or options {}))
        content (if (nil? content) (:default options) content)
        type (or (:type options) :text)
        decoded (decode-type type content)]
    (if (:select options)
      (common/select-content decoded (:select options))
      decoded)))

(defn state
  [root parent path]
  {:root root
   :parent parent
   :path path})

(defn resolve-directive
  [form context current-state]
  (let [directive (first form)]
    (if (has? common/deferred-directives directive)
      (throw
       (common/unsupported-feature directive :directive))
      (let [handler (get (deref *directives*) directive)]
        (if handler
          (try
            (handler form context current-state)
            (catch Throwable error
              (let [data (ex-data error)]
                (if (:error/type data)
                  (throw error)
                  (throw
                   (ex :hara/io (assoc {:error/type :std.config/directive-failed
                     :directive directive
                     :form form
                     :path (:path current-state)
                     :cause (str error)
                     :cause/data data} :ex/message (str "Configuration directive failed: " directive))))))))
          form)))))

(defn resolve-map
  [form context root path]
  (reduce
   (fn [output entry]
     (let [key (nth entry 0)
           value (nth entry 1)]
       (assoc output
              key
              (resolve-form
               value
               context
               (state root form (conj path key))))))
   {}
   form))

(defn resolve-vector
  [form context current-state]
  (vec
   (map
    (fn [value]
      (resolve-form value context current-state))
    form)))

(defn resolve-form
  [form context current-state]
  (cond
    (directive? form)
    (resolve-directive form context current-state)

    (map? form)
    (resolve-map form
                 context
                 (:root current-state)
                 (:path current-state))

    (vector? form)
    (resolve-vector form context current-state)

    (list? form)
    (apply list
           (map
            (fn [value]
              (resolve-form value context current-state))
            form))

    (set? form)
    (set
     (map
      (fn [value]
        (resolve-form value context current-state))
      form))

    :else form))

(defn effective-context
  [context]
  (let [context (or context {})
        project (or (:project context)
                    (:config/project context)
                    (global/current-project context))
        root (or (:root context)
                 (:project/root project))]
    (assoc
     (assoc context :project project)
     :root root)))

(defn resolve
  "Resolves portable configuration directives in form."
  ([form]
   (resolve form {}))
  ([form context]
   (let [context (effective-context context)
         context (assoc context
                        :config/global
                        (global/global :all context))]
     (resolve-form form
                   context
                   (state form nil [])))))

(defn directive-options
  [form index]
  (let [value (if (< index (count form))
                (nth form index)
                nil)]
    (if (map? value) value {})))

(defn resolve-value
  [value context current-state]
  (resolve-form value context current-state))

(defn resolve-path-value
  [value context current-state]
  (let [value (resolve-value value context current-state)]
    (cond
      (string? value) value
      (vector? value) (apply str value)
      (list? value) (apply str value)
      :else
      (throw
       (ex :hara/io (assoc {:error/type :std.config/invalid-path
                 :path value} :ex/message "Configuration path must resolve to text"))))))

(defn directive-format
  [form context current-state]
  (let [arguments (resolve-value (nth form 1) context current-state)
        options (directive-options form 2)
        template (first arguments)
        values (vec (rest arguments))]
    (resolve-content
     (common/format-values template values)
     options)))

(defn directive-str
  [form context current-state]
  (let [raw-values (nth form 1)
        values (if (or (vector? raw-values) (list? raw-values))
                 raw-values
                 (vec (rest form)))
        values (resolve-value values context current-state)
        options (if (and (> (count form) 2)
                         (map? (nth form 2)))
                  (nth form 2)
                  {})]
    (resolve-content
     (apply str values)
     options)))

(defn directive-or
  [form context current-state]
  (loop [values (vec (rest form))]
    (if (empty? values)
      nil
      (let [value (resolve-value (first values)
                                 context
                                 current-state)]
        (if (nil? value)
          (recur (vec (rest values)))
          value)))))

(defn directive-case
  [form context current-state]
  (let [selected (resolve-value (nth form 1)
                                context
                                current-state)
        pairs (vec (rest (rest form)))]
    (loop [remaining pairs]
      (if (< (count remaining) 2)
        nil
        (let [key (first remaining)
              value (nth remaining 1)]
          (if (or (= :default key)
                  (= selected
                     (resolve-value key context current-state)))
            (resolve-value value context current-state)
            (recur (vec (rest (rest remaining))))))))))

(defn directive-error
  [form context current-state]
  (let [message (resolve-value (nth form 1)
                               context
                               current-state)
        data (if (> (count form) 2)
               (resolve-value (nth form 2)
                              context
                              current-state)
               {})]
    (throw
     (ex :hara/io (assoc (merge
               {:error/type :std.config/explicit-error
                :path (:path current-state)}
               (if (map? data) data {:data data})) :ex/message (str message))))))

(defn merge-modifier
  [values]
  (first
   (filter
    (fn [value]
      (or (= value :default)
          (= value :nil)
          (= value :nested)
          (= value :nested-nil)))
    values)))

(defn without-merge-modifier
  [values]
  (vec
   (filter
    (fn [value]
      (not
       (or (= value :default)
           (= value :nil)
           (= value :nested)
           (= value :nested-nil))))
    values)))

(defn directive-merge
  [form context current-state]
  (let [raw-values (vec (rest form))
        modifier (merge-modifier raw-values)
        values (resolve-value
                (without-merge-modifier raw-values)
                context
                current-state)]
    (case modifier
      :nil (apply merge (reverse values))
      :nested (reduce merge-nested {} values)
      :nested-nil
      (reduce
       (fn [output value]
         (merge-nested value output))
       {}
       values)
      (apply merge values))))

(defn scoped-value
  [source path options context current-state]
  (resolve-content
   (resolve-value
    (common/compatible-get-in source path)
    context
    current-state)
   options))

(defn directive-root
  [form context current-state]
  (scoped-value
   (:root current-state)
   (nth form 1)
   (directive-options form 2)
   context
   current-state))

(defn directive-parent
  [form context current-state]
  (scoped-value
   (:parent current-state)
   (nth form 1)
   (directive-options form 2)
   context
   current-state))

(defn directive-global
  [form context current-state]
  (scoped-value
   (or (:config/global context)
       (global/global :all context))
   (nth form 1)
   (directive-options form 2)
   context
   current-state))

(defn directive-project
  [form context current-state]
  (scoped-value
   (or (:project context)
       (global/current-project context))
   (nth form 1)
   (directive-options form 2)
   context
   current-state))

(defn environment-value
  [name context]
  (let [environment (or (:env context)
                        (:config/env context)
                        {})
        from-context (common/compatible-get environment name)]
    (if (nil? from-context)
      (os/getenv (str name))
      from-context)))

(defn directive-env
  [form context current-state]
  (let [name (resolve-value (nth form 1)
                            context
                            current-state)
        options (directive-options form 2)]
    (resolve-content
     (environment-value name context)
     options)))

(defn throw-include-cycle
  [path stack]
  (if (common/contains-value? stack path)
    (throw
     (ex :hara/io (assoc {:error/type :std.config/include-cycle
       :path path
       :include/stack (conj stack path)} :ex/message (str "Configuration include cycle: "
           (str/join " -> " (conj stack path))))))))

(defn inferred-type
  [path default-type]
  (cond
    (or (str/ends-with? path ".yaml")
        (str/ends-with? path ".yml")) :yaml
    (str/ends-with? path ".toml") :toml
    :else (common/extension-type path default-type)))

(defn load-file
  [path context options]
  (let [context (effective-context context)
        options (common/assert-portable-options (or options {}))
        found (common/resolve-file path context)
        stack (vec (or (:config/include-stack context) []))
        _ (throw-include-cycle found stack)
        type (or (:type options)
                 (inferred-type found :text))
        content (common/read-text found)
        decoded (resolve-content
                 content
                 (assoc options :type type))
        next-context
        (assoc
         (assoc
          (assoc context
                 :config/path found)
          :config/parent (File/parent found))
         :config/include-stack (conj stack found))]
    (resolve-form decoded
                  (assoc next-context
                         :config/global
                         (global/global :all next-context))
                  (state decoded nil []))))

(defn directive-file
  [form context current-state]
  (let [path (resolve-path-value (nth form 1)
                                 context
                                 current-state)
        options (directive-options form 2)]
    (load-file path context
               (merge {:type :text} options))))

(defn directive-include
  [form context current-state]
  (let [path (resolve-path-value (nth form 1)
                                 context
                                 current-state)
        options (directive-options form 2)]
    (load-file path context options)))

(def +default-types+
  {:text (fn [content] content)
   :edn (fn [content]
          (if (string? content)
            (Edn/read content)
            content))
   :json (fn [content]
           (if (string? content)
             (json/read-json content)
             content))})

(def +default-directives+
  {:format directive-format
   :str directive-str
   :or directive-or
   :case directive-case
   :error directive-error
   :merge directive-merge
   :root directive-root
   :parent directive-parent
   :global directive-global
   :env directive-env
   :project directive-project
   :include directive-include
   :file directive-file})

(reset! *types* +default-types+)
(reset! *directives* +default-directives+)

(defn load
  "Loads and resolves one configuration document. The zero-argument form keeps
   the historical config.edn default."
  ([]
   (load +config+ {}))
  ([path]
   (load path {}))
  ([path context]
   (let [options (:config/options context)
         default-type (inferred-type path :edn)]
     (load-file path
                context
                (merge {:type default-type}
                       (or options {}))))))
