;; ============================================================================
;; std.fs.path — portable logical path algebra for the mounted filesystem.
;;
;; Paths are names inside the filesystem mounted to the current session. They
;; are not host paths: "/" is the mounted root, "/" is the only separator, and
;; no current-directory, home-directory, drive, or platform expansion occurs.
;; ============================================================================
(ns std.fs.path
  (:config {:override [resolve]}))

(def +ascii-letters+
  (set "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"))
(def +windows-separator+ #{\\})
(def +path-separators+ #{\/ \\})
(def +dot-character+ #{\.})

(defn- path-error
  [code operation path message]
  (throw
   (ex code {:file/operation operation
             :file/path path
             :file/target nil}
       :ex/message message
       :ex/class (if (= code :file/outside-root)
                   :ex.class/security
                   :ex.class/argument))))

(defn- ascii-letter?
  [character]
  (has? +ascii-letters+ character))

(defn- windows-drive-path?
  [path]
  (let [segment
        (first
         (filter
          (fn [part]
            (not (= part "")))
          (str/split path "/")))]
    (and (not (nil? segment))
         (>= (str/length segment) 2)
         (= (str/char-at segment 1) \:)
         (ascii-letter? (str/char-at segment 0)))))

(defn- checked-path
  [operation path]
  (cond
    (not (string? path))
    (path-error :file/invalid-path
                operation
                path
                "Logical file path must be a string")

    (str/includes-any? path +windows-separator+)
    (path-error :file/invalid-path
                operation
                path
                "Logical file paths use '/' separators only")

    (windows-drive-path? path)
    (path-error :file/invalid-path
                operation
                path
                "Logical file paths do not accept host drive prefixes")

    :else
    path))

(defn- canonical-segments
  [operation path]
  (let [path (checked-path operation path)]
    (reduce
     (fn [output segment]
       (cond
         (or (= segment "")
             (= segment "."))
         output

         (= segment "..")
         (if (empty? output)
           (path-error :file/outside-root
                       operation
                       path
                       "Logical file path escapes above the mounted root")
           (vec (drop-last output)))

         :else
         (conj output segment)))
     []
     (str/split path "/"))))

(defn- segments-path
  [segments]
  (if (empty? segments)
    "/"
    (str "/" (str/join "/" segments))))

(defn- canonical-path
  [operation path]
  (segments-path (canonical-segments operation path)))

(defn ^{:schema [:fn [:str] :str]}
  normalise
  "Returns path as a canonical absolute logical path rooted at the mounted '/'."
  [path]
  (canonical-path :normalise path))

(defn ^{:schema [:function [:fn [:str] :str]
                            [:fn [:str :str] :str]
                            [:fn [:str :str & :str] :str]]}
  join
  "Appends path components and returns one canonical logical path.

   A leading '/' on an appended component does not replace the preceding
   component. Use resolve when an absolute component should reset the path."
  ([path]
   (canonical-path :join path))
  ([path child]
   (canonical-path
    :join
    (str (checked-path :join path)
         "/"
         (checked-path :join child))))
  ([path child & more]
   (reduce
    (fn [output part]
      (join output part))
    (join path child)
    more)))

(defn ^{:schema [:function [:fn [:str] :str]
                            [:fn [:str :str] :str]
                            [:fn [:str :str & :str] :str]]}
  resolve
  "Resolves components from left to right and returns a canonical logical path.

   A later absolute component replaces the accumulated path. Relative
   components, including '..', are resolved against it."
  ([path]
   (canonical-path :resolve path))
  ([path child]
   (let [path (canonical-path :resolve path)
         child (checked-path :resolve child)]
     (if (str/starts-with? child "/")
       (canonical-path :resolve child)
       (canonical-path :resolve (str path "/" child)))))
  ([path child & more]
   (reduce
    (fn [output part]
      (resolve output part))
    (resolve path child)
    more)))

(defn ^{:schema [:fn [:str] :str]}
  parent
  "Returns the canonical logical parent of path. The parent of '/' is '/'."
  [path]
  (let [segments (canonical-segments :parent path)]
    (if (empty? segments)
      "/"
      (segments-path (vec (drop-last segments))))))

(defn ^{:schema [:fn [:str] :str]}
  root
  "Validates path and returns the mounted logical root '/'."
  [path]
  (do
    (canonical-segments :root path)
    "/"))

(defn ^{:schema [:fn [:str] :any]}
  file-name
  "Returns the final logical path segment, or nil for '/'."
  [path]
  (last (canonical-segments :file-name path)))

(defn ^{:schema [:fn [:str] :vector]}
  segments
  "Returns the canonical logical path segments without the root separator."
  [path]
  (canonical-segments :segments path))

(defn- common-prefix-count
  [left right]
  (let [limit (min (count left) (count right))]
    (loop [index 0]
      (if (and (< index limit)
               (= (nth left index)
                  (nth right index)))
        (recur (inc index))
        index))))

(defn ^{:schema [:fn [:str :str] :str]}
  relativize
  "Returns target relative to base using '/' and '..'. Equal paths return '.'."
  [base target]
  (let [base-segments (canonical-segments :relativize base)
        target-segments (canonical-segments :relativize target)
        common (common-prefix-count base-segments target-segments)
        relative
        (vec
         (concat
          (repeat (- (count base-segments) common) "..")
          (drop common target-segments)))]
    (if (empty? relative)
      "."
      (str/join "/" relative))))

(defn- invalid-subpath
  [path start end]
  (throw
   (ex :file/invalid-path
       {:file/operation :subpath
        :file/path path
        :file/target nil
        :file/start start
        :file/end end}
       :ex/message "Logical subpath indexes are outside the path"
       :ex/class :ex.class/argument)))

(defn ^{:schema [:function [:fn [:str :int] :str]
                            [:fn [:str :int :int] :str]]}
  subpath
  "Selects logical segments from start (inclusive) to end (exclusive).

   The selected segments are re-rooted beneath '/', so observable path results
   remain canonical logical paths."
  ([path start]
   (let [path-segments (canonical-segments :subpath path)]
     (subpath path start (count path-segments))))
  ([path start end]
   (let [path-segments (canonical-segments :subpath path)
         size (count path-segments)]
     (if (and (long? start)
              (long? end)
              (<= 0 start)
              (< start end)
              (<= end size))
       (segments-path (vec (take (- end start)
                                 (drop start path-segments))))
       (invalid-subpath path start end)))))

(defn- suffix-index
  [name]
  (let [index (str/last-index-of name ".")
        size (str/length name)]
    (if (and (> index 0)
             (< index (dec size)))
      index
      -1)))

(defn ^{:schema [:fn [:str] :any]}
  suffix
  "Returns the final file-name suffix without '.', or nil when none exists.

   A leading dot alone identifies a dotfile and is not treated as a suffix."
  [path]
  (let [name (file-name (canonical-path :suffix path))]
    (if (nil? name)
      nil
      (let [index (suffix-index name)]
        (if (= index -1)
          nil
          (str/slice name (inc index)))))))

(defn- checked-suffix
  [operation path value]
  (let [value
        (cond
          (not (string? value))
          (path-error :file/invalid-path
                      operation
                      path
                      "Logical file suffix must be a string")

          (str/includes-any? value +path-separators+)
          (path-error :file/invalid-path
                      operation
                      path
                      "Logical file suffix must not contain path separators")

          (str/starts-with? value ".")
          (str/slice value 1)

          :else
          value)]
    (if (or (= value "")
            (= value ".")
            (= value "..")
            (str/includes-any? value +dot-character+))
      (path-error :file/invalid-path
                  operation
                  path
                  "Logical file suffix must be one non-empty segment")
      value)))

(defn- with-file-name
  [operation path name]
  (let [path-segments (canonical-segments operation path)]
    (if (empty? path-segments)
      (path-error :file/invalid-path
                  operation
                  path
                  "The mounted root does not have a file name")
      (segments-path
       (conj (vec (drop-last path-segments)) name)))))

(defn- remove-suffix*
  [operation canonical]
  (let [name (file-name canonical)]
    (if (nil? name)
      canonical
      (let [index (suffix-index name)]
        (if (= index -1)
          canonical
          (with-file-name operation
                          canonical
                          (str/slice name 0 index)))))))

(defn- add-suffix*
  [operation canonical value]
  (let [name (file-name canonical)]
    (if (nil? name)
      (path-error :file/invalid-path
                  operation
                  canonical
                  "The mounted root does not have a file suffix")
      (with-file-name operation
                      canonical
                      (str name "." value)))))

(defn ^{:schema [:fn [:str] :str]}
  remove-suffix
  "Removes the final suffix from path and returns a canonical logical path."
  [path]
  (remove-suffix*
   :remove-suffix
   (canonical-path :remove-suffix path)))

(defn ^{:schema [:fn [:str :str] :str]}
  add-suffix
  "Appends suffix to path's file name and returns a canonical logical path."
  [path value]
  (let [canonical (canonical-path :add-suffix path)
        value (checked-suffix :add-suffix canonical value)]
    (add-suffix* :add-suffix canonical value)))

(defn ^{:schema [:fn [:str :str] :str]}
  replace-suffix
  "Replaces path's final suffix, adding one when none exists."
  [path value]
  (let [canonical (canonical-path :replace-suffix path)
        value (checked-suffix :replace-suffix canonical value)
        without (remove-suffix* :replace-suffix canonical)]
    (add-suffix* :replace-suffix without value)))
