;; ==========================================================================
;; std.foundation.string — portable Unicode string operations.
;;
;; Native methods provide the compact substrate. Higher-level coercion,
;; identifier case conversion, indexed edits, and escaping remain portable HAL.
;; ==========================================================================
(ns std.foundation.string
  (:config {:override [repeat reverse insert-at]
            :set-global-alias str}))

;; ---------------------------------------------------------------------------
;; StringLike protocol adapters
;; ---------------------------------------------------------------------------

(defn ^{:inline true :schema [:fn [:any] :bool]}
  string-like?
  "Returns true when value satisfies IStringLike."
  [value]
  (satisfies? IStringLike value))

(defn ^{:inline true :schema [:fn [:any] :str]}
  to-string
  "Returns the reversible name text of a keyword or symbol."
  [value]
  (if (or (keyword? value) (symbol? value))
    (IStringLike/to-string value)
    (throw (ex :argument {:value value}
               :ex/message "str/to-string expects a keyword or symbol"
               :ex/class :ex.class/argument))))

(defn ^{:inline true :schema [:fn [:any :str] :any]}
  from-string
  "Reconstructs a keyword or symbol from text using sample as its type."
  [sample text]
  (if (or (keyword? sample) (symbol? sample))
    (IStringLike/from-string sample text)
    (throw (ex :argument {:sample sample :text text}
               :ex/message "str/from-string expects a keyword or symbol sample"
               :ex/class :ex.class/argument))))

;; ---------------------------------------------------------------------------
;; Native string primitives
;; ---------------------------------------------------------------------------

(defn ^{:inline true :schema [:fn [:str] :int]}
  length
  "Returns the portable character count of value."
  [value]
  (String/length value))

(def +digits+ (set "0123456789"))

(defn ^{:schema [:fn [:str :set] :bool]}
  includes-any?
  "Returns true when value contains at least one character in characters."
  [value characters]
  (let [it (iter value)]
    (loop [cursor it]
      (if (iter-next? cursor)
        (if (has? characters (iter-next cursor))
          true
          (recur cursor))
        false))))

(defn ^{:schema [:fn [:any] :bool]}
  blank?
  "Returns true when value is nil, empty, or contains only whitespace."
  [value]
  (if (nil? value)
    true
    (String/blank? value)))

(defn ^{:inline true :schema [:fn [:str :str] :bool]}
  includes?
  "Returns true when value contains part."
  [value part]
  (String/includes? value part))

(defn ^{:inline true :schema [:fn [:str :str] :bool]}
  starts-with?
  "Returns true when value begins with part."
  [value part]
  (String/starts-with? value part))

(defn ^{:inline true :schema [:fn [:str :str] :bool]}
  ends-with?
  "Returns true when value ends with part."
  [value part]
  (String/ends-with? value part))

(defn ^{:inline true :schema [:fn [:str :int] :char]}
  char-at
  "Returns the character at index as a Character."
  [value index]
  (String/char-at value index))

(defn ^{:inline true
        :schema [:function [:fn [:str :int] :str]
                            [:fn [:str :int :int] :str]]}
  slice
  "Returns the portion of value from start up to optional end."
  ([value start]
   (String/slice value start))
  ([value start end]
   (String/slice value start end)))

(defn ^{:inline true
        :schema [:function [:fn [:str :str] :int]
                            [:fn [:str :str :int] :int]]}
  index-of
  "Returns the first index of part at or after optional offset."
  ([value part]
   (String/index-of value part))
  ([value part offset]
   (String/index-of value part offset)))

(defn ^{:inline true
        :schema [:function [:fn [:str :str] :int]
                            [:fn [:str :str :int] :int]]}
  last-index-of
  "Returns the last index of part, optionally bounded by offset."
  ([value part]
   (String/last-index-of value part))
  ([value part offset]
   (String/last-index-of value part offset)))

(defn ^{:inline true :schema [:fn [:str :any] :str]}
  join
  "Joins values into one string, placing separator between adjacent items."
  [separator values]
  (String/join separator values))

(defn ^{:inline true :schema [:fn [:str [:or :str :regex]] [:maybe :vector]]}
  split
  "Splits value around a string or regular-expression separator."
  [value separator]
  (String/split value separator))

(defn ^{:inline true :schema [:fn [:str] :vector]}
  split-lines
  "Splits value at portable line boundaries."
  [value]
  (String/split-lines value))

(defn ^{:inline true :schema [:fn [:str :int] :str]}
  repeat
  "Returns value repeated count times."
  [value count]
  (String/repeat value count))

(defn ^{:inline true :schema [:fn [:str :str :str] :str]}
  replace
  "Replaces every occurrence of match in value with replacement."
  [value match replacement]
  (String/replace value match replacement))

(defn ^{:inline true :schema [:fn [:str :str :str] :str]}
  replace-first
  "Replaces the first occurrence of match in value with replacement."
  [value match replacement]
  (String/replace-first value match replacement))

(defn ^{:inline true :schema [:fn [:str] :str]}
  trim
  "Removes leading and trailing whitespace from value."
  [value]
  (String/trim value))

(defn ^{:inline true :schema [:fn [:str] :str]}
  trim-left
  "Removes leading whitespace from value."
  [value]
  (String/trim-left value))

(defn ^{:inline true :schema [:fn [:str] :str]}
  trim-right
  "Removes trailing whitespace from value."
  [value]
  (String/trim-right value))

(defn ^{:schema [:fn [:str] :str]}
  trim-newlines
  "Removes trailing newline and carriage-return characters from value."
  [value]
  (loop [end (length value)]
    (if (= end 0)
      ""
      (let [character (char-at value (dec end))]
        (if (or (= character \newline)
                (= character \return))
          (recur (dec end))
          (slice value 0 end))))))

(defn ^{:inline true :schema [:fn [:str] :str]}
  upper-case
  "Returns value converted to uppercase."
  [value]
  (String/upper value))

(defn ^{:inline true :schema [:fn [:str] :str]}
  lower-case
  "Returns value converted to lowercase."
  [value]
  (String/lower value))

(defn ^{:schema [:fn [:str] :str]}
  upper
  "Compatibility alias for upper-case."
  [value]
  (upper-case value))

(defn ^{:schema [:fn [:str] :str]}
  lower
  "Compatibility alias for lower-case."
  [value]
  (lower-case value))

(defn ^{:schema [:fn [:str] :str]}
  capital-case
  "Uppercases the first character and lowercases the remainder."
  [value]
  (let [size (length value)]
    (cond
      (= size 0) ""
      (= size 1) (upper-case value)
      :else
      (str (upper-case (slice value 0 1))
           (lower-case (slice value 1))))))

(defn ^{:inline true :schema [:fn [:str] :str]}
  capitalize
  "Uppercases value's first character according to the native contract."
  [value]
  (String/capitalize value))

(defn ^{:inline true :schema [:fn [:str] :str]}
  decapitalize
  "Lowercases value's first character according to the native contract."
  [value]
  (String/decapitalize value))

(defn ^{:inline true :schema [:fn [:str :int :str] :str]}
  pad-left
  "Prepends padding until value reaches length."
  [value length padding]
  (String/pad-left value length padding))

(defn ^{:inline true :schema [:fn [:str :int :str] :str]}
  pad-right
  "Appends padding until value reaches length."
  [value length padding]
  (String/pad-right value length padding))

(defn ^{:inline true :schema [:fn [:str] :str]}
  reverse
  "Returns value with its portable character order reversed."
  [value]
  (String/reverse value))

(defn ^{:inline true :schema [:fn [:str] :bytes]}
  encode-utf8
  "Encodes value as UTF-8 bytes."
  [value]
  (String/encode-utf8 value))

(defn ^{:inline true :schema [:fn [:bytes] :str]}
  decode-utf8
  "Decodes UTF-8 bytes into a string."
  [value]
  (String/decode-utf8 value))

;; ---------------------------------------------------------------------------
;; Portable string representations and identifier transforms
;; ---------------------------------------------------------------------------

(defn- tag-value
  [value]
  (cond
    (string? value)
    value

    (bytes? value)
    (decode-utf8 value)

    (char? value)
    (str value)

    (keyword? value)
    (let [prefix (namespace value)]
      (if (nil? prefix)
        (name value)
        (str prefix "/" (name value))))

    :else
    (pr-str value)))

(defn ^{:schema [:function [:fn [:any] :str]
                            [:fn [:any & :any] :str]]}
  tag
  "Returns portable tag text and concatenates additional values without a separator."
  ([value]
   (tag-value value))
  ([value & more]
   (reduce
    (fn [output item]
      (str output (tag-value item)))
    (tag-value value)
    more)))

(defn ^{:schema [:fn [:str :map] :str]}
  escape
  "Replaces each one-character string found in replacements."
  [value replacements]
  (loop [index 0
         output ""]
    (if (= index (length value))
      output
      (let [character (char-at value index)]
        (recur
         (inc index)
         (let [text (str character)]
           (str output
                (if (has? replacements text)
                  (get replacements text)
                  text))))))))

(defn ^{:schema [:fn [:str :str] :bool]}
  caseless=
  "Returns true when values are equal after lowercase conversion."
  [left right]
  (= (lower-case left)
     (lower-case right)))

(defn ^{:schema [:fn [:str :int :str] :str]}
  replace-at
  "Replaces the character at a portable Unicode index."
  [value index replacement]
  (str (slice value 0 index)
       replacement
       (slice value (inc index))))

(defn ^{:schema [:fn [:str :int :str] :str]}
  insert-at
  "Inserts replacement at a portable Unicode index."
  [value index replacement]
  (str (slice value 0 index)
       replacement
       (slice value index)))

(defn- identifier-separator?
  [character]
  (or (= character \space)
      (= character \_)
      (= character \-)))

(defn- digit-character?
  [character]
  (has? +digits+ character))

(defn- uppercase-character?
  [character]
  (let [text (str character)]
    (and (not= (lower-case text)
               (upper-case text))
         (= text (upper-case text)))))

(defn- lowercase-or-digit-character?
  [character]
  (or (digit-character? character)
      (let [text (str character)]
        (and (not= (lower-case text)
                   (upper-case text))
             (= text (lower-case text))))))

(defn- add-identifier-word
  [words word]
  (if (empty? word)
    words
    (conj words word)))

(defn- identifier-words
  [value]
  (loop [index 0
         words []
         word ""
         previous nil]
    (if (= index (length value))
      (add-identifier-word words word)
      (let [character (char-at value index)
            hump?
            (and (not (nil? previous))
                 (lowercase-or-digit-character? previous)
                 (uppercase-character? character))]
        (cond
          (identifier-separator? character)
          (recur (inc index)
                 (add-identifier-word words word)
                 ""
                 nil)

          hump?
          (recur (inc index)
                 (add-identifier-word words word)
                 (lower-case (str character))
                 character)

          :else
          (recur (inc index)
                 words
                 (str word (lower-case (str character)))
                 character))))))

(defn ^{:schema [:fn [:str] :str]}
  camel-case
  "Converts spaces, underscores, hyphens, and camel humps to camelCase."
  [value]
  (let [words (identifier-words value)]
    (if (empty? words)
      ""
      (reduce
       (fn [output word]
         (str output (capital-case word)))
       (first words)
       (rest words)))))

(defn ^{:schema [:fn [:str] :str]}
  pascal-case
  "Converts spaces, underscores, hyphens, and camel humps to PascalCase."
  [value]
  (reduce
   (fn [output word]
     (str output (capital-case word)))
   ""
   (identifier-words value)))

(defn ^{:schema [:fn [:str] :str]}
  snake-case
  "Converts spaces, hyphens, and camel humps to snake_case."
  [value]
  (join "_" (identifier-words value)))

(defn ^{:schema [:fn [:str] :str]}
  spear-case
  "Converts spaces, underscores, and camel humps to spear-case."
  [value]
  (join "-" (identifier-words value)))

(defn ^{:schema [:fn [:str] :str]}
  dot-case
  "Converts spaces, underscores, hyphens, and camel humps to dot.case."
  [value]
  (join "." (identifier-words value)))

(defn ^{:inline true :schema [:fn [:num :int] :str]}
  to-fixed
  "Formats numeric value with exactly precision fractional digits."
  [value precision]
  (String/to-fixed value precision))

(defn wrap
  "Wraps a string function so its first argument round-trips as a StringLike value.
   Pass true as return-value? for predicates and other non-string results."
  ([function]
   (wrap function false))
  ([function return-value?]
   (fn [input & arguments]
     (let [input-sequence? (sequential? input)
           sample (if input-sequence? (first input) input)
           string-input (if input-sequence?
                          (map (fn [value]
                                 (cond
                                   (string? value) value
                                   (or (keyword? value) (symbol? value)) (to-string value)
                                   (satisfies? IStringLike value)
                                   (IStringLike/to-string value)
                                   :else
                                   (throw
                                    (ex :argument {:value value}
                                        :ex/message "str/wrap expects string-like values"
                                        :ex/class :ex.class/argument))))
                               input)
                          (cond
                            (string? input) input
                            (or (keyword? input) (symbol? input)) (to-string input)
                            (satisfies? IStringLike input) (IStringLike/to-string input)
                            :else
                            (throw
                             (ex :argument {:value input}
                                 :ex/message "str/wrap expects a string-like value"
                                 :ex/class :ex.class/argument))))
           output (apply function string-input arguments)]
       (cond
         return-value? output
         (string? sample) output
         (sequential? output) (vec (map (fn [value]
                                      (if (or (keyword? sample) (symbol? sample))
                                        (from-string sample value)
                                        (IStringLike/from-string sample value)))
                                    output))
         (or (keyword? sample) (symbol? sample)) (from-string sample output)
         :else (IStringLike/from-string sample output))))))

(defn wrap-compare
  "Wraps a binary string predicate for StringLike operands."
  [function]
  (fn [left right & arguments]
    (apply function
           (if (or (keyword? left) (symbol? left))
             (to-string left)
             (IStringLike/to-string left))
           (if (or (keyword? right) (symbol? right))
             (to-string right)
             (IStringLike/to-string right))
           arguments)))
