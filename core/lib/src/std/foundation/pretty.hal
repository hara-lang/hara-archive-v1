;; ============================================================================
;; std.foundation.pretty — portable EDN document construction and rendering.
;;
;; Contract:
;;   * Traverse values through std.protocol.iencodable.IEncodable/std.protocol.iencodevisitor.IEncodeVisitor without host interop.
;;   * Build ordinary Document data before rendering or writing output.
;;   * Canonical mode is deterministic; pretty mode adds semantic annotations
;;     and width-sensitive line breaking.
;;   * Every public definition carries documentation and portable schema metadata.
;; ============================================================================
(ns std.foundation.pretty
  (:config {:global-alias pretty}))

(def ^{:schema :map
       :doc "Default options for canonical and pretty document visitors."}
  default-options
  {:width 80 :print-meta false :sort-keys 80 :map-delimiter ","
   :map-coll-separator " " :seq-limit nil :print-handlers {}
   :print-fallback :pretty})

(defstruct CanonicalVisitor [options])
(def ^{:schema [:fn [:map] :any]
       :doc "Constructs a visitor that produces deterministic canonical EDN documents."}
  CanonicalVisitor
  CanonicalVisitor)

(defstruct PrettyVisitor [options])
(def ^{:schema [:fn [:map] :any]
       :doc "Constructs a visitor that produces annotated, width-sensitive EDN documents."}
  PrettyVisitor
  PrettyVisitor)

(defn- ^{:inline true :schema [:fn [:keyword :any] :any]}
  annotate
  "Annotates document with its portable rendering kind."
  [kind document]
  (std.native.Document/annotate kind document))

(defn- handled [visitor kind value document]
  (let [handler (get (:print-handlers (:options visitor)) kind)]
    (if handler (handler visitor value) document)))

(defn- value-meta [value]
  (try
    (std.protocol.iobjtype.IObjType/meta value)
    (catch Throwable error nil)))

(defn- join-documents [separator documents]
  (if (empty? documents)
    []
    (vec (rest (reduce (fn [output document]
                         (conj (conj output separator) document))
                       []
                       documents)))))

(defn- limited-values [visitor values]
  (let [limit (:seq-limit (:options visitor))]
    (if (and (number? limit) (< 0 limit) (< limit (count values)))
      (conj (vec (take limit values)) ::trimmed)
      (vec values))))

(defn- ordered-values [visitor values key-function]
  (let [sort-keys (:sort-keys (:options visitor))
        entries (vec values)]
    (if (or (= true sort-keys)
            (and (number? sort-keys) (<= (count entries) sort-keys)))
      (sort-by key-function entries)
      entries)))

(defn- collection-document [visitor open close values separator]
  (let [documents (map (fn [value]
                         (if (= value ::trimmed)
                           (annotate :pretty/nil "...")
                           (format-doc visitor value)))
                       (limited-values visitor values))]
    (std.native.Document/group
      open
      (std.native.Document/align (join-documents separator documents))
      close)))

(defn- map-document [visitor value separator]
  (let [options (:options visitor)
        entries (ordered-values visitor (seq value) first)
        documents (map (fn [entry]
                         (std.native.Document/fragment
                           (format-doc visitor (key entry))
                           (if (coll? (val entry))
                             (:map-coll-separator options)
                             " ")
                           (format-doc visitor (val entry))))
                       entries)]
    (std.native.Document/group
      "{"
      (std.native.Document/align (join-documents separator documents))
      "}")))

(defn- unknown-document [visitor value]
  (let [fallback (:print-fallback (:options visitor))]
    (if (= fallback :error)
      (throw (ex :std.foundation/unknown-pretty
                 {:ex/message (str "No defined pretty representation for " (pr-str value))}))
      (if (fn? fallback)
        (fallback visitor value)
        (annotate :pretty/unknown (pr-str value))))))

(extend-type CanonicalVisitor std.protocol.iencodevisitor.IEncodeVisitor
  (visit-nil [visitor] (handled visitor :nil nil "nil"))
  (visit-boolean [visitor value] (handled visitor :boolean value (pr-str value)))
  (visit-number [visitor value] (handled visitor :number value (pr-str value)))
  (visit-character [visitor value] (handled visitor :character value (pr-str value)))
  (visit-string [visitor value] (handled visitor :string value (pr-str value)))
  (visit-keyword [visitor value] (handled visitor :keyword value (str value)))
  (visit-symbol [visitor value] (handled visitor :symbol value (str value)))
  (visit-seq [visitor value]
    (handled visitor :seq value (collection-document visitor "(" ")" value " ")))
  (visit-vector [visitor value]
    (handled visitor :vector value (collection-document visitor "[" "]" value " ")))
  (visit-map [visitor value]
    (handled visitor :map value (map-document visitor value " ")))
  (visit-set [visitor value]
    (handled visitor :set value
             (collection-document visitor "#{" "}"
                                  (ordered-values visitor value identity) " ")))
  (visit-tagged [visitor tag form]
    (handled visitor :tagged form
             (std.native.Document/fragment "#" (str tag) " " (format-doc visitor form))))
  (visit-unknown [visitor value] (unknown-document visitor value)))

(extend-type PrettyVisitor std.protocol.iencodevisitor.IEncodeVisitor
  (visit-nil [visitor] (handled visitor :nil nil (annotate :pretty/nil "nil")))
  (visit-boolean [visitor value] (handled visitor :boolean value (annotate :pretty/boolean (pr-str value))))
  (visit-number [visitor value] (handled visitor :number value (annotate :pretty/number (pr-str value))))
  (visit-character [visitor value] (handled visitor :character value (annotate :pretty/character (pr-str value))))
  (visit-string [visitor value] (handled visitor :string value (annotate :pretty/string (pr-str value))))
  (visit-keyword [visitor value] (handled visitor :keyword value (annotate :pretty/keyword (str value))))
  (visit-symbol [visitor value] (handled visitor :symbol value (annotate :pretty/symbol (str value))))
  (visit-seq [visitor value]
    (handled visitor :seq value
             (collection-document visitor "(" ")" value (std.native.Document/line))))
  (visit-vector [visitor value]
    (handled visitor :vector value
             (collection-document visitor "[" "]" value (std.native.Document/line))))
  (visit-map [visitor value]
    (handled visitor :map value
             (map-document visitor value
                           (std.native.Document/fragment
                             (:map-delimiter (:options visitor))
                             (std.native.Document/line)))))
  (visit-set [visitor value]
    (handled visitor :set value
             (collection-document visitor "#{" "}"
                                  (ordered-values visitor value identity)
                                  (std.native.Document/line))))
  (visit-tagged [visitor tag form]
    (handled visitor :tagged form
             (std.native.Document/group
               (annotate :pretty/tag (str "#" tag))
               (std.native.Document/line)
               (format-doc visitor form))))
  (visit-unknown [visitor value] (unknown-document visitor value)))

(defn ^{:schema [:function [:fn [] :any]
                            [:fn [:map] :any]]}
  canonical-printer
  "Returns a canonical EDN visitor configured with options."
  ([] (canonical-printer {}))
  ([options]
   (std.foundation.pretty/CanonicalVisitor
     (merge default-options options {:mode :canonical}))))

(defn ^{:schema [:function [:fn [] :any]
                            [:fn [:map] :any]]}
  pretty-printer
  "Returns an annotated pretty-print visitor configured with options."
  ([] (pretty-printer {}))
  ([options]
   (std.foundation.pretty/PrettyVisitor
     (merge default-options options {:mode :pretty}))))

(defn ^{:schema [:fn [:any :any] :any]}
  format-doc-edn
  "Encodes value through visitor without adding metadata decoration."
  [visitor value]
  (std.protocol.iencodable.IEncodable/encode-with value visitor))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :any] :any]]}
  format-doc
  "Formats value as a document, using the default pretty visitor when omitted."
  ([visitor value]
   (let [metadata (value-meta value)
         options (:options visitor)]
     (if (and metadata (:print-meta options))
       (std.native.Document/align
         (std.native.Document/fragment
           (annotate :pretty/delimiter "^")
           (format-doc visitor metadata))
         (std.native.Document/line)
         (format-doc-edn visitor value))
       (format-doc-edn visitor value))))
  ([value] (format-doc (pretty-printer) value)))

(defn ^{:schema [:function [:fn [:any] :str]
                            [:fn [:any :map] :str]]}
  render
  "Renders document to a string with optional Document rendering options."
  ([document] (render document {}))
  ([document options] (std.native.Document/render document options)))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :map] :any]]}
  write
  "Renders document and writes it through the portable Printer boundary."
  ([document] (write document {}))
  ([document options] (std.native.Printer/p (render document options))))

(defn ^{:schema [:function [:fn [:any] :str]
                            [:fn [:any :map] :str]]}
  pprint-str
  "Pretty-formats value to a width-sensitive string."
  ([value] (pprint-str value {}))
  ([value options]
   (let [visitor (pretty-printer options)]
     (render (format-doc visitor value)
             {:width (:width (:options visitor))}))))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :map] :any]]}
  pprint
  "Pretty-formats value and writes it through the portable Printer boundary."
  ([value] (pprint value {}))
  ([value options] (std.native.Printer/p (pprint-str value options))))
