;; ==========================================================================
;; std.foundation.bytes — portable byte-buffer operations.
;;
;;                         HAL number/value
;;                               |
;;                     +---------+---------+
;;                     |                   |
;;                     v                   v
;;                  u8 / s8          existing bytes
;;                     |                   |
;;                     +---------+---------+
;;                               |
;;                               v
;;                       std.native.Bytes
;;                               |
;;          +----------+---------+---------+----------+
;;          |          |                   |          |
;;          v          v                   v          v
;;        count       get/set             slice      copy
;;          |          |                   |          |
;;          +----------+-------------------+----------+
;;                               |
;;                               v
;;                    portable byte-buffer value
;;
;; Byte buffers are opaque across the host boundary. Operations return values
;; according to the native Bytes contract and never expose host array classes.
;; ==========================================================================
(ns std.foundation.bytes
  (:config {:blank true
            :set-global-alias bytes}))

;; ---------------------------------------------------------------------------
;; Opaque native byte-buffer boundary
;; ---------------------------------------------------------------------------

(defn ^{:inline true :schema [:fn [& :int] :bytes]}
  run
  "Creates a byte buffer from signed or unsigned byte values."
  [& values]
  (std.foundation/apply Bytes/new values))

(defn ^{:inline true :schema [:fn [:bytes] :int]}
  count
  "Returns the number of bytes in value."
  [value]
  (Bytes/count value))

(defn ^{:inline true
        :schema [:function [:fn [:bytes :int] :any]
                            [:fn [:bytes :int :any] :any]]}
  get
  "Returns a byte at index, or fallback when the indexed form supplies one."
  ([value index]
   (Bytes/get value index))
  ([value index fallback]
   (Bytes/get value index fallback)))

(defn ^{:inline true :schema [:fn [:bytes :int :any] :bytes]}
  set
  "Returns value with item written at index."
  [value index item]
  (Bytes/set value index item))

(defn ^{:inline true :schema [:fn [:bytes] :bytes]}
  copy
  "Returns an independent byte-buffer copy of value."
  [value]
  (Bytes/copy value))

(defn ^{:inline true
        :schema [:function [:fn [:bytes :int] :bytes]
                            [:fn [:bytes :int :int] :bytes]]}
  slice
  "Returns the bytes from start up to optional end."
  ([value start]
   (Bytes/slice value start))
  ([value start end]
   (Bytes/slice value start end)))

(defn ^{:inline true :schema [:fn [:any] :int]}
  u8
  "Coerces value to its unsigned eight-bit representation."
  [value]
  (Bytes/u8 value))

(defn ^{:inline true :schema [:fn [:any] :int]}
  s8
  "Coerces value to its signed eight-bit representation."
  [value]
  (Bytes/s8 value))
