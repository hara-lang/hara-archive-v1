;; ============================================================================
;; std.foundation.promise — portable promise library (foundation boundary).
;;
;; HAL functions provide discoverable docs and schemas while delegating
;; scheduling and construction to std.native.Promise and IPromise.
;;
;; Contract:
;;   * Promises are the single async boundary; new/from/then/catch/finally
;;     compose without exposing host executors.
;;   * cancel is best-effort.
;;   * delay defers evaluation into the promise scheduler.
;;
;; Native inventory: specs/01-lang/001-language/draft/conformance/native.edn
;;
;;                      function / value
;;                            |
;;          +-----------------+-----------------+
;;          |                 |                 |
;;          v                 v                 v
;;         run               from              new
;;          |                 |             executor owns
;;          +-----------------+-----------------+
;;                            |
;;                            v
;;                         Promise
;;                      /     |      \
;;                     v      v       v
;;                   then    catch  finally
;;                     \      |       /
;;                      +-----+------+
;;                            |
;;                            v
;;                     chained Promise
;;
;; `all` joins multiple promises; `delay` schedules later work; cancellation
;; is best-effort and never exposes a host executor.
;; ============================================================================
(ns std.foundation.promise
  (:config {:blank true
            :global-alias promise}))

(defn ^{:inline true :schema [:fn [:fn] :promise]}
  run
  "Runs function asynchronously and returns its promise."
  [function]
  (std.native.Promise/run function))

(defn ^{:inline true :schema [:fn [:fn] :promise]}
  new
  "Creates a promise controlled by executor."
  [executor]
  (std.native.Promise/new executor))

(defn ^{:inline true :schema [:fn [:any] :promise]}
  from
  "Returns a settled promise containing value."
  [value]
  (std.native.Promise/from value))

(defn ^{:inline true :schema [:fn [:any] :promise]}
  all
  "Returns a promise of all values after every input succeeds."
  [values]
  (std.native.Promise/all values))

(defn ^{:inline true :schema [:fn [:num :fn] :promise]}
  delay
  "Runs function after milliseconds and returns its promise."
  [milliseconds function]
  (std.native.Promise/delay milliseconds function))

(defn ^{:inline true :schema [:fn [:promise] :keyword]}
  state
  "Returns promise's scheduler state."
  [promise]
  (std.protocol.ipromise.IPromise/state promise))

(defn ^{:inline true :schema [:fn [:promise] :any]}
  value
  "Returns promise's settled value or provider-specific failure."
  [promise]
  (std.protocol.ipromise.IPromise/value promise))

(defn ^{:inline true :schema [:fn [:promise :fn] :promise]}
  then
  "Chains function after promise succeeds."
  [promise function]
  (std.protocol.ipromise.IPromise/then promise function))

(defn ^{:inline true :schema [:fn [:promise :fn] :promise]}
  catch
  "Chains function after promise fails."
  [promise function]
  (std.protocol.ipromise.IPromise/catch promise function))

(defn ^{:inline true :schema [:fn [:promise :fn] :promise]}
  finally
  "Chains cleanup function after promise settles."
  [promise function]
  (std.protocol.ipromise.IPromise/finally promise function))

(defn ^{:inline true :schema [:fn [:promise] :any]}
  cancel
  "Requests best-effort cancellation of promise."
  [promise]
  (std.protocol.ipromise.IPromise/cancel promise))
