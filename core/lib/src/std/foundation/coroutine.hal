;; ============================================================================
;; std.foundation.coroutine — portable coroutine library (foundation boundary).
;;
;; HAL functions provide discoverable docs and schemas while delegating
;; coroutine creation, yielding, and awaiting to std.native.Coroutine.
;;
;; Contract:
;;   * create builds a suspended coroutine; resume steps it past the next
;;     yield; status reports :suspended, :running, or :done.
;;   * close releases a live coroutine; await bridges a coroutine to a
;;     promise.
;;
;; Native inventory: specs/01-lang/001-language/draft/conformance/native.edn
;;
;;                       function
;;                          |
;;                          v
;;                       create
;;                          |
;;                          v
;;                     :suspended
;;                          |
;;                 resume(arguments)
;;                          |
;;                          v
;;                      :running
;;                    /          \
;;                   v            v
;;            yield(value)      return/error
;;                   |            |
;;                   v            v
;;              :suspended       :done
;;                   |
;;                   +--- await(Promise) pauses until settlement
;; ============================================================================
(ns std.foundation.coroutine
  (:config {:blank true
            :set-global-alias co})
  (:require [std.foundation]))

;; ---------------------------------------------------------------------------
;; Coroutine lifecycle and scheduler boundary
;; ---------------------------------------------------------------------------

(defn ^{:inline true :schema [:fn [:fn] :any]}
  create
  "Creates a suspended coroutine from function."
  [function]
  (Coroutine/create function))

(defn ^{:inline true :schema [:fn [:any] :bool]}
  coroutine?
  "Returns true when value is a coroutine."
  [value]
  (Base/instance? Coroutine value))

(defn ^{:inline true :schema [:fn [:any] :keyword]}
  status
  "Returns coroutine's scheduler state."
  [coroutine]
  (ICoroutine/status coroutine))

(defn ^{:schema [:fn [:any & :any] :any]}
  resume
  "Advances coroutine, supplying optional resume arguments."
  [coroutine & arguments]
  (Base/apply ICoroutine/resume coroutine arguments))

(defn ^{:inline true :schema [:fn [:any] :any]}
  close
  "Closes coroutine and releases its scheduler state."
  [coroutine]
  (IClose/close coroutine))

(def ^{:inline true :schema [:fn [:any] :any]
       :doc "Suspends the current coroutine with value."}
  yield
  Coroutine/yield)

(defn ^{:inline true :schema [:fn [:promise] :any]}
  await
  "Suspends until promise settles, then returns or throws its result."
  [promise]
  (Coroutine/await promise))
