;; Experimental portable schema core for HAL metadata and relation contracts.
(ns std.typed.schema
  (:require [std.typed.registry :as registry]))

(def ^{:dynamic true} *registry* nil)

(defn- normalize-dispatch
  [schema]
  (cond
    (schema? schema)
    :schema-value

    (and (map? schema) (has? schema :kind))
    :normalized

    (keyword? schema)
    :primitive

    (and (list? schema)
         (= 2 (count schema))
         (= 'var (first schema))
         (symbol? (second schema)))
    :reference

    (and *registry* (symbol? schema))
    :registry-reference

    (not (vector? schema))
    :unknown

    (and (= 1 (count schema))
         (keyword? (first schema)))
    :primitive-vector

    :else (first schema)))

(defmulti normalize normalize-dispatch)

(defn- append-unique [values value]
  (if (any? (fn [candidate] (= candidate value)) values)
    values
    (conj values value)))

(defn- append-union-type [values value]
  (if (= :union (:kind value))
    (loop [remaining (:types value)
           output values]
      (if (empty? remaining)
        output
        (recur (rest remaining)
               (append-unique output (first remaining)))))
    (append-unique values value)))

(defn- normalize-union [types]
  (let [members
        (loop [remaining types
               output []]
          (if (empty? remaining)
            output
            (recur (rest remaining)
                   (append-union-type output
                                      (normalize (first remaining))))))]
    (if (= 1 (count members))
      (first members)
      {:kind :union :types members})))

(defn- normalize-input-vector [inputs]
  (loop [index 0
         fixed []]
    (if (= index (count inputs))
      {:fixed fixed :rest nil}
      (if (= '& (nth inputs index))
        {:fixed fixed
         :rest (normalize (nth inputs (inc index)))}
        (recur (inc index)
               (conj fixed (normalize (nth inputs index))))))))

(defn- normalize-inputs [inputs]
  (if (map? inputs)
    (let [rest-schema (get inputs :rest nil)]
      {:fixed (vec (map normalize (get inputs :fixed [])))
       :rest (if (nil? rest-schema)
               nil
               (normalize rest-schema))})
    (normalize-input-vector inputs)))

(defn- normalize-fn-map [schema]
  {:kind :fn
   :inputs (normalize-inputs (:inputs schema))
   :output (normalize (:output schema))})

(defn- normalize-function-arities [arities]
  (let [normalized
        (vec
         (map (fn [arity]
                (normalize
                 (if (and (map? arity)
                          (not (has? arity :kind)))
                   (assoc arity :kind :fn)
                   arity)))
              arities))]
    (if (= 1 (count normalized))
      (first normalized)
      {:kind :function :arities normalized})))

(defn- normalize-properties
  [kind properties _allowed]
  (if (map? properties)
    properties
    (throw
     (ex :serialization {:kind kind :properties properties} :ex/message (str kind " schema properties must be a map")))))

(defn- assoc-properties
  [schema properties]
  (if (empty? properties)
    schema
    (assoc schema :properties properties)))

(defn- normalize-field
  [field]
  (cond
    (map? field)
    (let [properties
          (normalize-properties
           :map-entry
           (or (:properties field) {})
           #{:optional})]
      (assoc-properties
       {:name (:name field)
        :type (normalize (:type field))}
       properties))

    (and (vector? field) (= 2 (count field)))
    {:name (first field)
     :type (normalize (second field))}

    (and (vector? field)
         (= 3 (count field))
         (map? (second field)))
    (assoc-properties
     {:name (first field)
      :type (normalize (nth field 2))}
     (normalize-properties :map-entry (second field) #{:optional}))

    :else
    (throw
     (ex :serialization {:entry field} :ex/message "map schema entries must be [key schema] or [key properties schema]"))))

(defn normalize-struct-name
  "Normalizes a named struct reference to its qualified symbol."
  [value]
  (cond
    (and (list? value)
         (= 2 (count value))
         (= 'var (first value))
         (symbol? (second value)))
    (let [target (second value)]
      (if (namespace target)
        target
        (throw
         (ex :serialization {:name target}
             :ex/message "struct schema name must be qualified"))))

    (and (symbol? value) (namespace value)) value

    :else
    (throw
     (ex :serialization {:name value}
         :ex/message "struct schema name must be a qualified symbol or (var ...) reference"))))

(defn normalize-struct-fields
  "Normalizes struct fields using the map-field grammar."
  [fields]
  (vec (map normalize-field fields)))

(defn- properties-normal?
  [schema]
  (or (not (has? schema :properties))
      (map? (:properties schema))))

(defn- canonical-normal?
  [schema]
  (and
   (map? schema)
   (let [kind (:kind schema)]
     (cond
       (= kind :primitive)
       (and (has? schema :name)
            (keyword? (:name schema))
            (not= :integer (:name schema))
            (properties-normal? schema))

       (= kind :reference)
       (and (has? schema :name)
            (symbol? (:name schema)))

       (= kind :union)
       (and (vector? (:types schema))
            (every? canonical-normal? (:types schema)))

       (= kind :vector)
       (and (properties-normal? schema)
            (canonical-normal? (:item schema)))

       (= kind :set)
       (and (properties-normal? schema)
            (canonical-normal? (:item schema)))

       (= kind :tuple)
       (and (vector? (:items schema))
            (every? canonical-normal? (:items schema)))

       (= kind :map)
       (and
        (properties-normal? schema)
        (vector? (:fields schema))
        (every?
         (fn [field]
           (and (map? field)
                (has? field :name)
                (properties-normal? field)
                (canonical-normal? (:type field))))
         (:fields schema)))

       (= kind :struct)
       (and
        (symbol? (:name schema))
        (namespace (:name schema))
        (boolean? (:mutable? schema))
        (vector? (:fields schema))
        (every?
         (fn [field]
           (and (map? field)
                (has? field :name)
                (properties-normal? field)
                (canonical-normal? (:type field))))
         (:fields schema)))

       (= kind :fn)
       (let [inputs (:inputs schema)]
         (and
          (map? inputs)
          (vector? (:fixed inputs))
          (every? canonical-normal? (:fixed inputs))
          (or (nil? (:rest inputs))
              (canonical-normal? (:rest inputs)))
          (canonical-normal? (:output schema))))

       (= kind :function)
       (and (vector? (:arities schema))
            (every?
             (fn [arity]
               (and (= :fn (:kind arity))
                    (canonical-normal? arity)))
             (:arities schema)))

       (= kind :enum)
       (vector? (:values schema))

       (= kind :result)
       (and (map? (:properties schema))
            (canonical-normal? (:data schema)))

       (= kind :extension)
       (and (keyword? (:head schema))
            (vector? (:arguments schema))
            (has? schema :surface))

       (= kind :unknown)
       (has? schema :surface)

       :else false))))

(defn- normalize-normalized [schema]
  (if (canonical-normal? schema)
    schema
    (let [kind (:kind schema)
          children (get schema :children [])]
      (cond
        (= kind :primitive)
        (let [normalized
              (normalize
               (if (has? schema :name)
                 (:name schema)
                 (first children)))
              properties (or (:properties schema) {})]
          (if (= :union (:kind normalized))
            (if (empty? properties)
              normalized
              {:kind :union
               :types (vec (map (fn [member]
                                  (assoc-properties member properties))
                                (:types normalized)))})
            (assoc-properties normalized properties)))

        (= kind :reference)
        {:kind :reference
         :name (if (has? schema :name)
                 (:name schema)
                 (first children))}

        (or (= kind :union) (= kind :or))
        (normalize-union
         (if (has? schema :types)
           (:types schema)
           children))

        (= kind :vector)
        (assoc-properties
         {:kind :vector
          :item (normalize
                 (if (has? schema :item)
                   (:item schema)
                   (first children)))}
         (or (:properties schema) {}))

        (= kind :set)
        (assoc-properties
         {:kind :set
          :item (normalize
                 (if (has? schema :item)
                   (:item schema)
                   (first children)))}
         (or (:properties schema) {}))

        (= kind :tuple)
        {:kind :tuple
         :items (vec
                 (map normalize
                      (if (has? schema :items)
                        (:items schema)
                        children)))}

        (= kind :map)
        (assoc-properties
         {:kind :map
          :fields
          (vec
           (map normalize-field
                (if (has? schema :fields)
                  (:fields schema)
                  children)))}
         (or (:properties schema) {}))

        (= kind :struct)
        {:kind :struct
         :name (normalize-struct-name
                (if (has? schema :name)
                  (:name schema)
                  (first children)))
         :mutable? (= true (:mutable? schema))
         :fields
         (normalize-struct-fields
          (if (has? schema :fields)
            (:fields schema)
            (rest children)))}

        (= kind :fn)
        (normalize-fn-map schema)

        (= kind :function)
        (normalize-function-arities
         (if (has? schema :arities)
           (:arities schema)
           children))

        (= kind :enum)
        {:kind :enum
         :values (vec
                  (if (has? schema :values)
                    (:values schema)
                    children))}

        (= kind :result)
        {:kind :result
         :properties (or (:properties schema) {})
         :data (normalize (:data schema))}

        (= kind :extension)
        (let [head (if (has? schema :head)
                     (:head schema)
                     (:name schema))
              arguments (if (has? schema :arguments)
                          (:arguments schema)
                          children)]
          {:kind :extension
           :head head
           :arguments (vec arguments)
           :surface (if (has? schema :surface)
                      (:surface schema)
                      (vec (concat [head] arguments)))})

        (= kind :unknown)
        {:kind :unknown
         :surface (if (has? schema :surface)
                    (:surface schema)
                    (first children))}

        :else schema))))

(defmethod normalize :schema-value [schema]
  (normalize (Schema/ast schema)))

(defmethod normalize :normalized [schema]
  (normalize-normalized schema))

(defmethod normalize :primitive [schema]
  (if (= schema :integer)
    (normalize-union [:long :bigint])
    {:kind :primitive :name schema}))

(defn- registry-reference-name
  [target]
  (if *registry*
    (registry/qualify *registry* target)
    target))

(defmethod normalize :reference [schema]
  {:kind :reference
   :name (registry-reference-name (second schema))})

(defmethod normalize :registry-reference [schema]
  {:kind :reference
   :name (registry-reference-name schema)})

(defn ^{:schema [:fn [:any :any] :map]}
  normalize-with
  "Normalizes schema using an explicit portable schema registry."
  [schema registry-value]
  (binding [*registry* (registry/ensure registry-value)]
    (normalize schema)))

(defmethod normalize :primitive-vector [schema]
  (normalize (first schema)))

(defmethod normalize :unknown [schema]
  {:kind :unknown :surface schema})

(defmethod normalize :or [schema]
  (normalize-union (rest schema)))

(defmethod normalize :maybe [schema]
  (normalize-union [(second schema) :nil]))

(defmethod normalize :vector [schema]
  (let [arguments (vec (rest schema))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (normalize-properties
         :vector
         (if property-form? (first arguments) {})
         #{:min-count :max-count :distinct})
        item
        (if property-form?
          (if (> (count arguments) 1) (second arguments) :any)
          (if (empty? arguments) :any (first arguments)))]
    (assoc-properties
     {:kind :vector :item (normalize item)}
     properties)))

(defmethod normalize :set [schema]
  (let [arguments (vec (rest schema))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (normalize-properties
         :set
         (if property-form? (first arguments) {})
         #{:min-count :max-count :distinct})
        item
        (if property-form?
          (if (> (count arguments) 1) (second arguments) :any)
          (if (empty? arguments) :any (first arguments)))]
    (assoc-properties
     {:kind :set :item (normalize item)}
     properties)))

(defmethod normalize :tuple [schema]
  {:kind :tuple
   :items (vec (map normalize (rest schema)))})

(defn- normalize-primitive-properties
  [schema]
  (if (and (= 2 (count schema))
           (map? (second schema)))
    (assoc-properties
     {:kind :primitive :name (first schema)}
     (normalize-properties
      (first schema)
      (second schema)
      #{:min-count :max-count :pattern :qualified :distinct}))
    (throw
     (ex :dependency {:schema schema} :ex/message "primitive schema properties require one property map"))))

(defmethod normalize :str [schema] (normalize-primitive-properties schema))
(defmethod normalize :string [schema] (normalize-primitive-properties schema))
(defmethod normalize :keyword [schema] (normalize-primitive-properties schema))
(defmethod normalize :symbol [schema] (normalize-primitive-properties schema))
(defmethod normalize :list [schema] (normalize-primitive-properties schema))
(defmethod normalize :bytes [schema] (normalize-primitive-properties schema))
(defmethod normalize :int [schema] (normalize-primitive-properties schema))
(defmethod normalize :long [schema] (normalize-primitive-properties schema))
(defmethod normalize :bigint [schema] (normalize-primitive-properties schema))
(defmethod normalize :integer [schema]
  (if (= 1 (count schema))
    (normalize-union [:long :bigint])
    (if (and (= 2 (count schema)) (map? (second schema)))
      (let [properties
            (normalize-properties
             :integer
             (second schema)
             #{:min-count :max-count :pattern :qualified :distinct})]
        {:kind :union
         :types [(assoc-properties {:kind :primitive :name :long} properties)
                 (assoc-properties {:kind :primitive :name :bigint} properties)]})
      (throw
       (ex :dependency {:schema schema}
           :ex/message "integer schema properties require one property map")))))
(defmethod normalize :num [schema] (normalize-primitive-properties schema))
(defmethod normalize :number [schema] (normalize-primitive-properties schema))
(defmethod normalize :any [schema] (normalize-primitive-properties schema))

(defmethod normalize :map [schema]
  (let [arguments (vec (rest schema))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (normalize-properties
         :map
         (if property-form? (first arguments) {})
         #{:closed :min-count :max-count})
        fields (if property-form? (rest arguments) arguments)]
    (assoc-properties
     {:kind :map
      :fields (vec (map normalize-field fields))}
     properties)))

(defmethod normalize :struct [schema]
  (let [arguments (vec (rest schema))
        properties (if (and (not (empty? arguments))
                            (map? (first arguments)))
                     (first arguments)
                     {})
        arguments (if (empty? properties)
                    arguments
                    (vec (rest arguments)))
        name (if (empty? arguments) nil (first arguments))]
    (if (nil? name)
      (throw
       (ex :serialization {:schema schema}
           :ex/message ":struct schema requires a qualified name"))
      {:kind :struct
       :name (normalize-struct-name name)
       :mutable? (= true (:mutable? properties))
       :fields (normalize-struct-fields (rest arguments))})))

(defmethod normalize :fn [schema]
  (normalize-fn-map
   {:inputs (second schema)
    :output (nth schema 2)}))

(defmethod normalize :function [schema]
  (normalize-function-arities (rest schema)))

(defmethod normalize :enum [schema]
  {:kind :enum :values (vec (rest schema))})

(defn- normalize-result-properties [properties]
  (let [status (:status properties)
        error-code (:error-code properties)
        unknown (vec (filter (fn [key]
                               (not (has? #{:status :error-code} key)))
                             (keys properties)))]
    (cond
      (not (empty? unknown))
      (throw (ex :serialization {:properties unknown} :ex/message "unsupported :result schema property"))

      (and status (not (has? #{:success :error} status)))
      (throw (ex :serialization {:status status} :ex/message ":result :status must be :success or :error"))

      (and error-code (not (keyword? error-code)))
      (throw (ex :serialization {:error-code error-code} :ex/message ":result :error-code must be a keyword"))

      (and error-code (= :success status))
      (throw (ex :conflict properties :ex/message ":result :error-code conflicts with success status"))

      error-code
      (assoc (if status {:status status} {})
             :status :error
             :error-code error-code)

      status {:status status}
      :else {})))

(defmethod normalize :result [schema]
  (let [arguments (vec (rest schema))]
    (cond
      (= 1 (count arguments))
      {:kind :result
       :properties {}
       :data (normalize (first arguments))}

      (and (= 2 (count arguments)) (map? (first arguments)))
      {:kind :result
       :properties (normalize-result-properties (first arguments))
       :data (normalize (second arguments))}

      :else
      (throw (ex :serialization {:schema schema} :ex/message ":result expects a data schema and optional properties")))))

(defmethod normalize :default [schema]
  {:kind :extension
   :head (first schema)
   :arguments (vec (rest schema))
   :surface schema})

(defn- append-reference-name
  [names schema-name]
  (if (any? (fn [candidate] (= candidate schema-name)) names)
    names
    (conj names schema-name)))

(declare reference-names-normal)

(defn- collect-reference-names
  [schemas]
  (loop [remaining schemas
         output []]
    (if (empty? remaining)
      output
      (let [nested (reference-names-normal (first remaining))]
        (recur
         (rest remaining)
         (loop [nested nested
                output output]
           (if (empty? nested)
             output
             (recur (rest nested)
                    (append-reference-name output (first nested))))))))))

(defn- reference-names-normal
  [schema]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      [(:name schema)]

      (= kind :union)
      (collect-reference-names (:types schema))

      (or (= kind :vector) (= kind :set))
      (reference-names-normal (:item schema))

      (= kind :tuple)
      (collect-reference-names (:items schema))

      (= kind :map)
      (collect-reference-names
       (map (fn [field] (:type field)) (:fields schema)))

      (= kind :struct)
      (collect-reference-names
       (map (fn [field] (:type field)) (:fields schema)))

      (= kind :fn)
      (let [inputs (:inputs schema)
            rest-schema (:rest inputs)
            members
            (vec
             (concat (:fixed inputs)
                     (if rest-schema [rest-schema] [])
                     [(:output schema)]))]
        (collect-reference-names members))

      (= kind :function)
      (collect-reference-names (:arities schema))

      (= kind :result)
      (reference-names-normal (:data schema))

      :else [])))

(defn ^{:schema [:function
                 [:fn [:any] :vector]
                 [:fn [:any :any] :vector]]}
  reference-names
  "Returns named schema references in deterministic declaration order."
  ([schema]
   (reference-names-normal (normalize schema)))
  ([schema registry-value]
   (reference-names-normal
    (normalize-with schema registry-value))))

(defn ^{:schema [:fn [:any :any] :map]}
  resolve-reference
  "Resolves one named reference, leaving unresolved references unchanged."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)
        normalized (normalize-with schema registry-value)]
    (if (= :reference (:kind normalized))
      (let [found (registry/find-schema registry-value (:name normalized))]
        (if found
          (normalize-with (:schema found) (:registry found))
          normalized))
      normalized)))

(declare resolve-normal)

(defn- resolve-many
  [schemas registry-value visited]
  (vec
   (map (fn [schema]
          (resolve-normal schema registry-value visited))
        schemas)))

(defn- resolve-normal
  [schema registry-value visited]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      (let [schema-name (:name schema)]
        (if (has? visited schema-name)
          schema
          (let [found (registry/find-schema registry-value schema-name)]
            (if found
              (let [source-registry (:registry found)
                    target (normalize-with (:schema found) source-registry)]
                (resolve-normal target
                                source-registry
                                (conj visited schema-name)))
              schema))))

      (= kind :union)
      (normalize-union
       (resolve-many (:types schema) registry-value visited))

      (or (= kind :vector) (= kind :set))
      (assoc schema :item
             (resolve-normal (:item schema) registry-value visited))

      (= kind :tuple)
      (assoc schema :items
             (resolve-many (:items schema) registry-value visited))

      (= kind :map)
      (assoc schema :fields
             (vec
              (map (fn [field]
                     (assoc field :type
                            (resolve-normal (:type field)
                                            registry-value
                                            visited)))
                   (:fields schema))))

      (= kind :struct)
      (assoc schema :fields
             (vec
              (map (fn [field]
                     (assoc field :type
                            (resolve-normal (:type field)
                                            registry-value
                                            visited)))
                   (:fields schema))))

      (= kind :fn)
      (let [inputs (:inputs schema)
            rest-schema (:rest inputs)]
        (assoc schema
               :inputs
               {:fixed (resolve-many (:fixed inputs)
                                     registry-value
                                     visited)
                :rest (if rest-schema
                        (resolve-normal rest-schema
                                        registry-value
                                        visited)
                        nil)}
               :output (resolve-normal (:output schema)
                                       registry-value
                                       visited)))

      (= kind :function)
      (assoc schema :arities
             (resolve-many (:arities schema) registry-value visited))

      (= kind :result)
      (assoc schema :data
             (resolve-normal (:data schema) registry-value visited))

      :else schema)))

(defn ^{:schema [:fn [:any :any] :map]}
  resolve-recursive
  "Resolves all reachable references; recursive edges remain references."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)]
    (resolve-normal (normalize-with schema registry-value)
                    registry-value
                    #{})))

(defn ^{:schema [:fn [:any :any] :vector]}
  unresolved-references
  "Returns reachable references that are absent from registry."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)
        resolved (resolve-recursive schema registry-value)]
    (vec
     (filter (fn [schema-name]
               (not (registry/has-schema? registry-value schema-name)))
             (reference-names-normal resolved)))))

(defn- primitive-valid? [name value]
  (cond
    (= name :any) true
    (= name :nil) (nil? value)
    (= name :bool) (boolean? value)
    (= name :boolean) (boolean? value)
    (= name :num) (number? value)
    (= name :number) (number? value)
    (= name :int) (long? value)
    (= name :long) (long? value)
    (= name :bigint) (bigint? value)
    (= name :integer) (integer? value)
    (= name :str) (string? value)
    (= name :string) (string? value)
    (= name :keyword) (keyword? value)
    (= name :symbol) (symbol? value)
    (= name :list) (list? value)
    (= name :vector) (vector? value)
    (= name :map) (map? value)
    (= name :set) (set? value)
    (= name :bytes) (bytes? value)
    :else true))

(defn- finding [path expected value]
  {:finding/type :std.typed.schema/invalid-value
   :finding/path (vec path)
   :finding/expected expected
   :finding/value value})

(defn- property-finding
  [path expected value constraint expected-value]
  {:finding/type :std.typed.schema/property-violation
   :finding/path (vec path)
   :finding/expected expected
   :finding/value value
   :finding/context
   {:constraint constraint
    :expected expected-value}})

(defn- missing-key-finding
  [path field]
  (let [key (:name field)]
    {:finding/type :std.typed.schema/missing-key
     :finding/path (conj (vec path) key)
     :finding/expected (:type field)
     :finding/value nil
     :finding/context
     {:present? false
      :constraint :required
      :key key
      :parent-path (vec path)}}))

(defn- closed-key-finding
  [path expected key value]
  {:finding/type :std.typed.schema/closed-map-key
   :finding/path (conj (vec path) key)
   :finding/expected expected
   :finding/value value
   :finding/context {:constraint :closed :key key}})

(defn- qualified-keyword?
  [value]
  (and (keyword? value)
       (str/includes? (str value) "/")))

(defn- property-count
  [value]
  (cond
    (string? value) (str/length value)
    (or (vector? value) (set? value) (map? value) (list? value))
    (count value)
    :else nil))

(defn- distinct-values?
  [value]
  (if (or (vector? value) (list? value))
    (apply distinct? (vec value))
    true))

(defn- validate-properties
  [schema value path]
  (let [properties (or (:properties schema) {})
        count-value (property-count value)
        min-count (:min-count properties)
        max-count (:max-count properties)
        pattern (:pattern properties)]
    (vec
     (concat
      (if (and min-count count-value (< count-value min-count))
        [(property-finding path schema value :min-count min-count)]
        [])
      (if (and max-count count-value (> count-value max-count))
        [(property-finding path schema value :max-count max-count)]
        [])
      (if (and pattern
               (string? value)
               (not (re-matches pattern value)))
        [(property-finding path schema value :pattern pattern)]
        [])
      (if (and (= true (:qualified properties))
               (not (qualified-keyword? value)))
        [(property-finding path schema value :qualified true)]
        [])
      (if (and (= true (:distinct properties))
               (not (distinct-values? value)))
        [(property-finding path schema value :distinct true)]
        [])))))

(defn- field-optional?
  [field]
  (= true (:optional (:properties field))))

(defn- known-field?
  [schema key]
  (any? (fn [field] (= key (:name field))) (:fields schema)))

(defn- closed-map-findings
  [schema value path]
  (if (= true (:closed (:properties schema)))
    (vec
     (mapcat
      (fn [key]
        (if (known-field? schema key)
          []
          [(closed-key-finding path schema key (get value key))]))
      (sort-by str (keys value))))
    []))

(defn- validate-dispatch [schema value path]
  (:kind schema))

(defmulti validate-normal validate-dispatch)

(defmethod validate-normal :primitive [schema value path]
  (if (primitive-valid? (:name schema) value)
    (validate-properties schema value path)
    [(finding path schema value)]))

(defmethod validate-normal :enum [schema value path]
  (if (any? (fn [candidate] (= candidate value))
            (:values schema))
    []
    [(finding path schema value)]))

(defn- result-error-code [value]
  (if (Result/error? value)
    (get (ex-data (Result/error-value value)) :code)
    nil))

(defmethod validate-normal :result [schema value path]
  (if (not (result? value))
    [(finding path schema value)]
    (let [properties (:properties schema)
          expected-status (:status properties)
          expected-code (:error-code properties)
          actual-status (:status value)
          status-findings
          (if (and expected-status (not= expected-status actual-status))
            [(finding (conj path :status) expected-status actual-status)]
            [])
          actual-code (result-error-code value)
          code-findings
          (if (and expected-code (not= expected-code actual-code))
            [(finding (conj path :error :code) expected-code actual-code)]
            [])
          data-findings
          (if (Result/success? value)
            (validate-normal (:data schema) (Result/data value) (conj path :data))
            [])]
      (vec (concat status-findings code-findings data-findings)))))

(defmethod validate-normal :union [schema value path]
  (if (any? (fn [member]
              (empty? (validate-normal member value path)))
            (:types schema))
    []
    [(finding path schema value)]))

(defmethod validate-normal :vector [schema value path]
  (if (vector? value)
    (loop [index 0
           output (validate-properties schema value path)]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal (:item schema)
                                   (nth value index)
                                   (conj path index)))))))
    [(finding path schema value)]))

(defmethod validate-normal :set [schema value path]
  (if (set? value)
    (let [values (vec (sort-by str value))]
      (loop [index 0
             output (validate-properties schema value path)]
        (if (= index (count values))
          output
          (recur
           (inc index)
           (vec
            (concat output
                    (validate-normal (:item schema)
                                     (nth values index)
                                     (conj path index))))))))
    [(finding path schema value)]))

(defmethod validate-normal :tuple [schema value path]
  (if (and (vector? value)
           (= (count value) (count (:items schema))))
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal (nth (:items schema) index)
                                   (nth value index)
                                   (conj path index)))))))
    [(finding path schema value)]))

(defmethod validate-normal :map [schema value path]
  (if (map? value)
    (let [field-findings
          (loop [remaining (:fields schema)
                 output []]
            (if (empty? remaining)
              output
              (let [field (first remaining)
                    key (:name field)]
                (recur
                 (rest remaining)
                 (cond
                   (has? value key)
                   (vec
                    (concat output
                            (validate-normal (:type field)
                                             (get value key)
                                             (conj path key))))
                   (field-optional? field) output
                   :else (conj output (missing-key-finding path field)))))))]
      (vec
       (concat
        (validate-properties schema value path)
        field-findings
        (closed-map-findings schema value path))))
    [(finding path schema value)]))

(defmethod validate-normal :struct [schema value path]
  ;; Struct values expose the same associative field surface as maps. Runtime
  ;; identity is checked by the declaration registry; portable validation
  ;; validates the declared field contract without evaluating the type Var.
  (validate-normal
   (assoc schema :kind :map)
   value
   path))

(defn- reference-finding
  [finding-type path schema value]
  {:finding/type finding-type
   :finding/path (vec path)
   :finding/expected schema
   :finding/value value
   :finding/reference (:name schema)})

(defmethod validate-normal :reference [schema value path]
  [(reference-finding
    :std.typed.schema/unresolved-reference
    path schema value)])

(declare validate-normal-with)

(defn- validate-union-with
  [schema value path registry-value trail]
  (loop [remaining (:types schema)]
    (if (empty? remaining)
      [(finding path schema value)]
      (if (empty?
           (validate-normal-with (first remaining)
                                 value
                                 path
                                 registry-value
                                 trail))
        []
        (recur (rest remaining))))))

(defn- validate-vector-with
  [schema value path registry-value trail]
  (if (vector? value)
    (loop [index 0
           output (validate-properties schema value path)]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal-with (:item schema)
                                        (nth value index)
                                        (conj path index)
                                        registry-value
                                        trail))))))
    [(finding path schema value)]))

(defn- validate-set-with
  [schema value path registry-value trail]
  (if (set? value)
    (let [values (vec (sort-by str value))]
      (loop [index 0
             output (validate-properties schema value path)]
        (if (= index (count values))
          output
          (recur
           (inc index)
           (vec
            (concat output
                    (validate-normal-with (:item schema)
                                          (nth values index)
                                          (conj path index)
                                          registry-value
                                          trail)))))))
    [(finding path schema value)]))

(defn- validate-tuple-with
  [schema value path registry-value trail]
  (if (and (vector? value)
           (= (count value) (count (:items schema))))
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal-with (nth (:items schema) index)
                                        (nth value index)
                                        (conj path index)
                                        registry-value
                                        trail))))))
    [(finding path schema value)]))

(defn- validate-map-with
  [schema value path registry-value trail]
  (if (map? value)
    (let [field-findings
          (loop [remaining (:fields schema)
                 output []]
            (if (empty? remaining)
              output
              (let [field (first remaining)
                    key (:name field)]
                (recur
                 (rest remaining)
                 (cond
                   (has? value key)
                   (vec
                    (concat output
                            (validate-normal-with (:type field)
                                                  (get value key)
                                                  (conj path key)
                                                  registry-value
                                                  trail)))
                   (field-optional? field) output
                   :else (conj output (missing-key-finding path field)))))))]
      (vec
       (concat
        (validate-properties schema value path)
        field-findings
        (closed-map-findings schema value path))))
    [(finding path schema value)]))

(defn- validate-reference-with
  [schema value path registry-value trail]
  (let [schema-name (:name schema)
        found (registry/find-schema registry-value schema-name)]
    (if (nil? found)
      [(reference-finding
        :std.typed.schema/unresolved-reference
        path schema value)]
      (let [source-registry (:registry found)
            qualified-name (:name found)
            visit-key [qualified-name (vec path)]]
        (if (has? trail visit-key)
          [(reference-finding
            :std.typed.schema/cyclic-reference
            path schema value)]
          (validate-normal-with
           (normalize-with (:schema found) source-registry)
           value
           path
           source-registry
           (conj trail visit-key)))))))

(defn- validate-normal-with
  [schema value path registry-value trail]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      (validate-reference-with schema value path registry-value trail)

      (= kind :union)
      (validate-union-with schema value path registry-value trail)

      (= kind :vector)
      (validate-vector-with schema value path registry-value trail)

      (= kind :set)
      (validate-set-with schema value path registry-value trail)

      (= kind :tuple)
      (validate-tuple-with schema value path registry-value trail)

      (= kind :map)
      (validate-map-with schema value path registry-value trail)

      (= kind :struct)
      (validate-map-with (assoc schema :kind :map)
                         value
                         path
                         registry-value
                         trail)

      (= kind :result)
      (if (not (result? value))
        [(finding path schema value)]
        (let [base-findings (validate-normal schema value path)]
          (if (Result/success? value)
            (vec
             (concat
              (filter (fn [item]
                        (not= (conj path :data) (:finding/path item)))
                      base-findings)
              (validate-normal-with (:data schema)
                                    (Result/data value)
                                    (conj path :data)
                                    registry-value
                                    trail)))
            base-findings)))

      :else
      (validate-normal schema value path))))

(defmethod validate-normal :default [schema value path]
  [])

(defn ^{:schema [:function
                 [:fn [:any :any] :vector]
                 [:fn [:any :any :any] :vector]]}
  validate
  "Returns deterministic, path-aware findings for value against schema."
  ([schema value]
   (validate-normal (normalize schema) value []))
  ([schema value registry-value]
   (let [registry-value (registry/ensure registry-value)]
     (validate-normal-with
      (normalize-with schema registry-value)
      value
      []
      registry-value
      #{}))))

(defn ^{:schema [:function
                 [:fn [:any :any] :bool]
                 [:fn [:any :any :any] :bool]]}
  valid?
  "Returns true when value conforms to schema."
  ([schema value]
   (empty? (validate schema value)))
  ([schema value registry-value]
   (empty? (validate schema value registry-value))))

(defn- compatible-normal? [expected actual]
  (cond
    (= expected actual) true
    (and (= :primitive (:kind expected))
         (= :any (:name expected))) true
    (and (= :primitive (:kind actual))
         (= :any (:name actual))) true
    (and (= :primitive (:kind expected))
         (= :primitive (:kind actual))
         (= (:name expected) (:name actual))) true
    (and (= :vector (:kind expected))
         (= :vector (:kind actual)))
    (compatible-normal? (:item expected) (:item actual))
    (and (= :set (:kind expected))
         (= :set (:kind actual)))
    (compatible-normal? (:item expected) (:item actual))
    (and (= :struct (:kind expected))
         (= :struct (:kind actual))
         (= (:name expected) (:name actual))
         (= (:mutable? expected) (:mutable? actual))
         (= (count (:fields expected)) (count (:fields actual)))
         (every?
          (fn [[expected-field actual-field]]
            (and (= (:name expected-field) (:name actual-field))
                 (compatible-normal? (:type expected-field)
                                     (:type actual-field))))
          (map vector (:fields expected) (:fields actual))))
    true
    (= :unknown (:kind expected)) true
    (= :unknown (:kind actual)) true
    (= :union (:kind expected))
    (any? (fn [member] (compatible-normal? member actual))
          (:types expected))
    (= :union (:kind actual))
    (any? (fn [member] (compatible-normal? expected member))
          (:types actual))
    (and (= :result (:kind expected))
         (= :result (:kind actual)))
    (let [expected-status (get-in expected [:properties :status])
          actual-status (get-in actual [:properties :status])
          expected-code (get-in expected [:properties :error-code])
          actual-code (get-in actual [:properties :error-code])]
      (and (or (nil? expected-status)
               (nil? actual-status)
               (= expected-status actual-status))
           (or (nil? expected-code)
               (nil? actual-code)
               (= expected-code actual-code))
           (compatible-normal? (:data expected) (:data actual))))
    :else false))

(defn ^{:schema [:function
                 [:fn [:any :any] :bool]
                 [:fn [:any :any :any] :bool]]}
  compatible?
  "Returns true when two schemas have an overlapping value domain."
  ([expected actual]
   (compatible-normal? (normalize expected) (normalize actual)))
  ([expected actual registry-value]
   (compatible-normal?
    (resolve-recursive expected registry-value)
    (resolve-recursive actual registry-value))))

(defn ^{:schema [:function
                 [:fn [:any] :vector]
                 [:fn [:any :any] :vector]]}
  project-arities
  "Returns normalized function arities from :fn or :function schema."
  ([schema]
   (let [normalized (normalize schema)]
     (cond
       (= :fn (:kind normalized)) [normalized]
       (= :function (:kind normalized)) (:arities normalized)
       :else [])))
  ([schema registry-value]
   (let [normalized (resolve-recursive schema registry-value)]
     (cond
       (= :fn (:kind normalized)) [normalized]
       (= :function (:kind normalized)) (:arities normalized)
       :else []))))
