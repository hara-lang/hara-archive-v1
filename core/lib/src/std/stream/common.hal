(ns std.stream.common
  (:config {:override [map filter keep remove take drop take-while drop-while
                       concat partition partition-all partition-by interleave
                       first last count some every? find reduce]}))

(defn close-value [value]
  (try
    (IClose/close value)
    (catch Throwable error nil)))

(defn close-values [values]
  (if (> (std.foundation/count values) 0)
    (do
      (close-value (std.foundation/first values))
      (close-values (vec (rest values))))
    nil))

(defn own [inner sources]
  (Stream/create
   (fn [] (IStream/next inner))
   (fn []
     (close-value inner)
     (close-values sources))))

(defn ^{:inline true :schema [:fn [:any] :promise]}
  next
  "Pulls the next stream item as a promise; nil marks end of stream."
  [stream]
  (IStream/next stream))

(defn ^{:inline true :schema [:fn [:any] :any]}
  close
  "Idempotently closes stream and any source owned by it."
  [stream]
  (IClose/close stream))

(defn unfold
  "Creates an asynchronous stream from step and seed. Step returns nil,
   [item next-state], or a promise of either."
  [step seed]
  (stream
    (fn []
      (loop [state seed]
        (let [result (co/await (promise/from (step state)))]
          (if (nil? result)
            nil
            (let [[item next-state] result]
              (co/yield item)
              (recur next-state))))))))

(defn from-iterator
  "Wraps a synchronous iterator as an asynchronous stream and owns its lifetime."
  [value]
  (let [iterator (iter value)]
    (own
      (stream
        (fn []
          (try
            (loop []
              (if (iter-next? iterator)
                (do
                  (co/yield (iter-next iterator))
                  (recur))
                nil))
            (finally (close-value iterator)))))
      [iterator])))

(defn map
  "Lazily applies synchronous function to every asynchronous stream item."
  [function source]
  (own
    (stream
      (fn []
        (try
          (loop []
            (let [value (co/await (next source))]
              (if (nil? value)
                nil
                (do
                  (co/yield (function value))
                  (recur)))))
          (finally (close-value source)))))
    [source]))

(defn filter
  "Lazily retains asynchronous stream items satisfying predicate."
  [predicate source]
  (own
    (stream
      (fn []
        (try
          (loop []
            (let [value (co/await (next source))]
              (if (nil? value)
                nil
                (do
                  (if (predicate value) (co/yield value) nil)
                  (recur)))))
          (finally (close-value source)))))
    [source]))

(defn take
  "Lazily returns at most count items and then closes its source."
  [count source]
  (own
    (stream
      (fn []
        (try
          (if (< 0 count)
            (loop [index 0]
              (if (< index count)
                (let [value (co/await (next source))]
                  (if (nil? value)
                    nil
                    (let [next-index (inc index)]
                      (if (= next-index count) (close-value source) nil)
                      (co/yield value)
                      (if (< next-index count) (recur next-index) nil))))
                nil))
            (close-value source))
          (finally (close-value source)))))
    [source]))

(defn keep
  "Lazily emits non-nil results of applying function to source values."
  [function source]
  (own
   (stream
    (fn []
      (try
        (loop []
          (let [value (co/await (next source))]
            (if (nil? value)
              nil
              (let [output (function value)]
                (if (nil? output) nil (co/yield output))
                (recur)))))
        (finally (close-value source)))))
   [source]))

(defn remove [predicate source]
  (filter (fn [value] (not (predicate value))) source))

(defn drop
  "Skips count values, then emits the remainder."
  [count source]
  (own
   (stream
    (fn []
      (try
        (loop [remaining count]
          (let [value (co/await (next source))]
            (if (nil? value)
              nil
              (if (> remaining 0)
                (recur (dec remaining))
                (do (co/yield value) (recur 0))))))
        (finally (close-value source)))))
   [source]))

(defn take-while [predicate source]
  (own
   (stream
    (fn []
      (try
        (loop []
          (let [value (co/await (next source))]
            (if (or (nil? value) (not (predicate value)))
              nil
              (do (co/yield value) (recur)))))
        (finally (close-value source)))))
   [source]))

(defn drop-while [predicate source]
  (own
   (stream
    (fn []
      (try
        (loop [dropping true]
          (let [value (co/await (next source))]
            (if (nil? value)
              nil
              (if (and dropping (predicate value))
                (recur true)
                (do (co/yield value) (recur false))))))
        (finally (close-value source)))))
   [source]))

(defn concat-source [sources]
  (own
   (stream
    (fn []
      (try
        (loop [remaining sources]
          (if (> (std.foundation/count remaining) 0)
            (let [source (std.foundation/first remaining)
                  value (co/await (next source))]
              (if (nil? value)
                (do (close-value source) (recur (vec (rest remaining))))
                (do (co/yield value) (recur remaining))))
            nil))
        (finally (close-values sources)))))
   sources))

(defn concat [& sources]
  (concat-source (vec sources)))

(defn zip [& sources]
  (let [sources (vec sources)]
    (own
     (stream
      (fn []
        (try
          (loop []
            (let [values (loop [index 0 output []]
                           (if (= index (std.foundation/count sources))
                             output
                             (let [value (co/await (next (nth sources index)))]
                               (if (nil? value)
                                 nil
                                 (recur (inc index) (conj output value))))))]
              (if (nil? values)
                nil
                (do (co/yield values) (recur)))))
          (finally (close-values sources)))))
     sources)))

(defn yield-values [values index]
  (if (< index (std.foundation/count values))
    (do (co/yield (nth values index))
        (yield-values values (inc index)))
    nil))

(defn interleave [& sources]
  (let [sources (vec sources)]
    (own
     (stream
      (fn []
        (try
          (loop []
            (let [values (loop [index 0 output []]
                           (if (= index (std.foundation/count sources))
                             output
                             (let [value (co/await (next (nth sources index)))]
                               (if (nil? value)
                                 nil
                                 (recur (inc index) (conj output value))))))]
              (if (nil? values)
                nil
                (do (yield-values values 0) (recur)))))
          (finally (close-values sources)))))
     sources)))

(defn partition-stream [size source partial?]
  (if (< size 1)
    (throw (ex :io {:size size} :ex/message "Partition size must be positive")))
  (own
   (stream
    (fn []
      (try
        (loop []
          (let [values (loop [output []]
                         (if (= size (std.foundation/count output))
                           output
                           (let [value (co/await (next source))]
                             (if (nil? value)
                               (if (and partial? (> (std.foundation/count output) 0)) output nil)
                               (recur (conj output value))))))]
            (if (nil? values)
              nil
              (do (co/yield values) (recur)))))
        (finally (close-value source)))))
   [source]))

(defn partition [size source]
  (partition-stream size source false))

(defn partition-all [size source]
  (partition-stream size source true))

(defn partition-by [function source]
  (own
   (stream
    (fn []
      (try
        (let [first-value (co/await (next source))]
          (if (nil? first-value)
            nil
            (loop [group [first-value]
                   key (function first-value)]
              (let [value (co/await (next source))]
                (if (nil? value)
                  (co/yield group)
                  (let [next-key (function value)]
                    (if (= key next-key)
                      (recur (conj group value) key)
                      (do (co/yield group)
                          (recur [value] next-key)))))))))
        (finally (close-value source)))))
   [source]))

(defn reduce-next [function result source]
  (promise/then
    (next source)
    (fn [value]
      (if (nil? value)
        result
        (reduce-next function (function result value) source)))))

(defn reduce
  "Asynchronously folds source from initial and always closes it."
  [function initial source]
  (promise/finally
    (reduce-next function initial source)
    (fn [] (close-value source))))

(defn collect-next [source result]
  (promise/then
    (next source)
    (fn [value]
      (if (nil? value)
        result
        (collect-next source (conj result value))))))

(defn collect
  "Collects all remaining stream items into a vector and closes source."
  [source]
  (promise/finally
    (collect-next source [])
    (fn [] (close-value source))))

(defn first [source]
  (promise/finally
   (next source)
   (fn [] (close-value source))))

(defn last-next [source output]
  (promise/then
   (next source)
   (fn [value]
     (if (nil? value) output (last-next source value)))))

(defn last [source]
  (promise/finally
   (last-next source nil)
   (fn [] (close-value source))))

(defn count-next [source output]
  (promise/then
   (next source)
   (fn [value]
     (if (nil? value) output (count-next source (inc output))))))

(defn count [source]
  (promise/finally
   (count-next source 0)
   (fn [] (close-value source))))

(defn some-next [predicate source]
  (promise/then
   (next source)
   (fn [value]
     (if (nil? value)
       nil
       (let [result (predicate value)]
         (if result result (some-next predicate source)))))))

(defn some [predicate source]
  (promise/finally
   (some-next predicate source)
   (fn [] (close-value source))))

(defn every-next [predicate source]
  (promise/then
   (next source)
   (fn [value]
     (if (nil? value)
       true
       (if (predicate value) (every-next predicate source) false)))))

(defn every? [predicate source]
  (promise/finally
   (every-next predicate source)
   (fn [] (close-value source))))

(defn find-next [predicate source]
  (promise/then
   (next source)
   (fn [value]
     (if (nil? value)
       nil
       (if (predicate value) value (find-next predicate source))))))

(defn find [predicate source]
  (promise/finally
   (find-next predicate source)
   (fn [] (close-value source))))
