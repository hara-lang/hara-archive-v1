(ns std.stream.async
  (:config {:override [take]})
  (:require [std.stream.channel :as channel]
            [std.stream.common :as common]))

(defonce +alts-index+ (atom -1))

(defn chan
  ([] (channel/create))
  ([buffer] (channel/create buffer)))

(defn take [source]
  (IStream/next source))

(defn put [target value]
  (IStreamWrite/write target value))

(defn offer [target value]
  (IStreamOffer/offer target value))

(defn poll [target]
  (IStreamPoll/poll target))

(defn closed? [target]
  (IClosed/closed? target))

(defn flush [target]
  (IFlush/flush target))

(defn close [target]
  (IClose/close target))

(defn abort [target error]
  (IAbort/abort target error))

(defn go [function]
  (promise/run
   (fn []
     (let [coroutine (co/create function)]
       (co/resume coroutine)))))

(defn write-operation? [operation]
  (and (vector? operation) (= 2 (count operation))))

(defn try-operation [operation]
  (if (write-operation? operation)
    (let [target (nth operation 0)
          value (nth operation 1)]
      (if (not (and (satisfies? IStreamOffer target)
                    (satisfies? IClosed target)))
        (throw (ex :io {:error/type :stream.async/invalid-alternative
                         :operation operation} :ex/message "Write alternatives require offer and closed capabilities")))
      (if (IStreamOffer/offer target value)
        {:ready true :result [true target]}
        (if (IClosed/closed? target)
          {:ready true :result [false target]}
          nil)))
    (do
      (if (not (satisfies? IStreamPoll operation))
        (throw (ex :io {:error/type :stream.async/invalid-alternative
                         :operation operation} :ex/message "Read alternatives require a poll capability")))
      (let [result (IStreamPoll/poll operation)]
        (if result
          {:ready true :result [(:value result) operation]}
          nil)))))

(defn try-operations [operations start index]
  (if (= index (count operations))
    nil
    (let [position (mod (+ start index) (count operations))
          result (try-operation (nth operations position))]
      (if result
        result
        (try-operations operations start (inc index))))))

(defn alts-loop [operations options]
  (let [priority (:priority options)
        start (if priority
                0
                (mod (swap! +alts-index+ inc) (count operations)))
        result (try-operations operations start 0)]
    (cond
      result (:result result)
      (has? options :default) [(:default options) :default]
      :else (do
              (co/await (promise/delay 1 (fn [] nil)))
              (alts-loop operations options)))))

(defn alts
  ([operations] (alts operations {}))
  ([operations options]
   (if (= 0 (count operations))
     (throw (ex :io {:error/type :stream.async/no-alternatives} :ex/message "alts requires at least one operation")))
   (go (fn [] (alts-loop operations options)))))

(defn pump-stream [source output]
  (try
    (loop []
      (let [value (co/await (common/next source))]
        (if (nil? value)
          (channel/close output)
          (if (co/await (channel/put output value))
            (recur)
            nil))))
    (catch Throwable error
      (channel/abort output error))
    (finally
      (common/close-value source))))

(defn from-stream
  ([source] (from-stream source nil))
  ([source buffer]
   (let [output (channel/create buffer)]
     (go (fn [] (pump-stream source output)))
     output)))
