(ns std.dom.update
  (:require [std.dom.common :as dom]
            [std.dom.diff :as diff]
            [std.dom.impl :as impl]
            [std.dom.item :as item]))

(defmulti dom-apply
  (fn [node ops] (dom/dom-metaclass node)))

(defn update-set [props [_ key new old]]
  (if (dom/dom? old) (impl/dom-remove old))
  (assoc props key (impl/dom-init new)))

(defn- insert-values [values index inserted]
  (vec (concat (take index values) inserted (drop index values))))

(defn- remove-values [values index amount]
  (vec (concat (take index values) (drop (+ index amount) values))))

(defn update-list-insert [values [_ index inserted]]
  (insert-values values index (map impl/dom-init inserted)))

(defn update-list-remove [values [_ index amount]]
  (reduce (fn [_ old]
            (if (dom/dom? old) (impl/dom-remove old)))
          nil
          (take amount (drop index values)))
  (remove-values values index amount))

(defn update-list-update [values [_ index ops]]
  (assoc values index (dom-apply (get values index) ops)))

(defn update-list-append [values [_ new]]
  (conj values (impl/dom-init new)))

(defn update-list-drop [values [_ old]]
  (if (dom/dom? old) (impl/dom-remove old))
  (vec (butlast values)))

(defn update-list [node key values ops]
  (let [results (reduce (fn [values [action :as op]]
                          (case action
                            :list-set (update-set values op)
                            :list-insert (update-list-insert values op)
                            :list-remove (update-list-remove values op)
                            :list-update (update-list-update values op)
                            :list-append (update-list-append values op)
                            :list-drop (update-list-drop values op)))
                        (vec values)
                        ops)
        item-values (mapv (fn [value]
                            (if (dom/dom? value) (dom/dom-item value) value))
                          results)
        rendered (item/item-set-list (:tag node) (dom/dom-item node) key item-values)]
    (dom/dom-field-set node :item rendered)
    results))

(defn update-props-delete [props [_ key old]]
  (if (dom/dom? old) (impl/dom-remove old))
  (dissoc props key))

(defn update-props-update [node props [_ key ops :as op]]
  (let [value (get props key)
        new-value (cond (dom/dom? value) (dom-apply value ops)
                        (sequential? value) (update-list node key value ops)
                        :else (throw (ex :hara/generic (assoc {:dom node :val value :op op} :ex/message "Not Supported"))))]
    (assoc props key new-value)))

(defn update-props [node props ops]
  (reduce (fn [props [action :as op]]
            (case action
              :set (update-set props op)
              :delete (update-props-delete props op)
              :update (update-props-update node props op)
              (throw (ex :hara/generic (assoc {:props props :op op} :ex/message "Not Supported")))))
          props
          ops))

(defn dom-apply-default [node ops]
  (if (= :replace (first (first ops)))
    (impl/dom-replace node (second (first ops)))
    (let [new-props (update-props node (:props node) ops)
          rendered (item/item-update (:tag node) (dom/dom-item node) ops)]
      (dom/dom-fields-set node {:props new-props :item rendered}))))

(defmethod dom-apply :default [node ops]
  (dom-apply-default node ops))

(defn dom-update [node new-node]
  (binding [dom/*current-dom* node]
    (dom-apply node (diff/dom-diff node new-node))))

(defn dom-refresh [node]
  (dom-update node (dom/dom-new (:tag node) (:props node))))
