(ns std.dom.item
  (:require [std.dom.type :as type]
            [std.dom.common :as dom]))

(defmulti item-constructor
  (fn [tag] (:metaclass (type/metaprops tag))))

(defmethod item-constructor :default [tag]
  (or (:construct (type/metaprops tag))
      (throw (ex :hara/generic (assoc {:tag tag :metaprops (type/metaprops tag)} :ex/message "No constructor")))))

(defmulti item-setters
  (fn [tag] (:metaclass (type/metaprops tag))))

(defmethod item-setters :default [tag]
  (let [metaprops (type/metaprops tag)]
    (if (= :dom/element (:metatype metaprops))
      (:setters metaprops)
      (throw (ex :hara/generic (assoc {:tag tag :metaprops metaprops} :ex/message "No setters"))))))

(defmulti item-getters
  (fn [tag] (:metaclass (type/metaprops tag))))

(defmethod item-getters :default [tag]
  (let [metaprops (type/metaprops tag)]
    (if (= :dom/element (:metatype metaprops))
      (:getters metaprops)
      (throw (ex :hara/generic (assoc {:tag tag :metaprops metaprops} :ex/message "No getters"))))))

(defn item-access [tag item key]
  (if-let [getter (get-in (item-getters tag) [key :fn])]
    (getter item)))

(defn item-create
  ([tag] (item-create tag {}))
  ([tag props] ((item-constructor tag) props)))

(defmulti item-props-update
  (fn [tag item ops] (:metaclass (type/metaprops tag))))

(defn item-props-update-default [tag item ops]
  (let [metaprops (type/metaprops tag)
        metatype (:metatype metaprops)]
    (if (= :dom/element metatype)
      item
      (throw (ex :hara/generic (assoc {:metatype metatype :metaprops metaprops
                       :tag tag :item item :ops ops} :ex/message "Cannot update props"))))))

(defmethod item-props-update :default [tag item ops]
  (item-props-update-default tag item ops))

(defmulti item-props-set
  (fn [tag item props] (:metaclass (type/metaprops tag))))

(defn item-props-set-default [tag item props]
  (let [setters (item-setters tag)]
    (reduce-kv
     (fn [item key value]
       (if-let [setter (get setters key)]
         (do ((:fn setter) item value) item)
         (throw (ex :hara/not-found (assoc {:metaprops (type/metaprops tag)
                          :item item :key key :value value} :ex/message "Cannot find set function")))))
     item
     props)))

(defmethod item-props-set :default [tag item props]
  (item-props-set-default tag item props))

(defmulti item-props-delete
  (fn [tag item props] (:metaclass (type/metaprops tag))))

(defn item-props-delete-default [tag item props] item)

(defmethod item-props-delete :default [tag item props]
  (item-props-delete-default tag item props))

(defn- operation-props [ops action]
  (into {}
        (keep (fn [op]
                (if (= action (first op))
                  (let [[key value] (rest op)]
                    [key (if (dom/dom? value) (dom/dom-item value) value)])))
              ops)))

(defn item-update [tag item ops]
  (let [set-props (operation-props ops :set)
        update-props (operation-props ops :update)
        delete-props (operation-props ops :delete)
        item (item-props-set tag item set-props)
        item (item-props-delete tag item delete-props)]
    (item-props-update tag item update-props)))

(defmulti item-set-list
  (fn [tag item key values] (:metaclass (type/metaprops tag))))

(defn item-set-list-default [tag item key values]
  (let [setter (get (item-setters tag) key)]
    (if-let [function (:fn setter)]
      (do (function item values) item)
      (throw (ex :hara/not-found (assoc {:metaprops (type/metaprops tag)
                       :item item :key key :value values} :ex/message "Cannot find set function"))))))

(defmethod item-set-list :default [tag item key values]
  (item-set-list-default tag item key values))

(defmulti item-cleanup
  (fn [tag item] (:metaclass (type/metaprops tag))))

(defn item-cleanup-default [tag item] item)

(defmethod item-cleanup :default [tag item]
  (item-cleanup-default tag item))
