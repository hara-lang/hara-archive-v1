(ns std.dom.impl
  (:require [std.dom.common :as dom]
            [std.dom.item :as item]
            [std.dom.type :as type]))

(defmulti dom-render dom/dom-metaclass)

(defn dom-render-default [node]
  (binding [dom/*current-dom* node]
    (let [tag (:tag node)
          props (-> (merge (:props node) (get-in node [:extra :dom/init]))
                    (dom/props-apply dom-render)
                    (dom/props-apply dom/dom-item))
          construct (item/item-constructor tag)
          rendered (construct props)
          {:keys [metatype no-check execute]} (type/metaprops tag)
          rendered (if (and (= :dom/element metatype) (not no-check))
                     (reduce (fn [rendered [key value]]
                               (let [setter (or (get (item/item-setters tag) key)
                                                (throw (ex :hara/argument (assoc {:tag tag :key key} :ex/message "Invalid setter"))))]
                                 ((:fn setter) rendered value)
                                 rendered))
                             rendered
                             props)
                     rendered)
          execute (or execute (get-in node [:extra :dom/execute]))]
      (if execute (execute rendered))
      (dom/dom-field-set node :item rendered))))

(defmethod dom-render :default [node]
  (dom-render-default node))

(defn dom-init [value]
  (if (and (dom/dom? value) (not (dom/dom-item? value)))
    (dom-render value)
    value))

(defn dom-rendered [form]
  (dom/dom-item (dom-render (dom/dom-compile form))))

(defmulti dom-remove dom/dom-metaclass)

(defn dom-remove-default [node]
  (item/item-cleanup (:tag node) (dom/dom-item node))
  (dom/dom-field-set node :item nil))

(defmethod dom-remove :default [node]
  (dom-remove-default node))

(defmulti dom-replace
  (fn [old new] (dom/dom-metaclass old)))

(defn dom-replace-default [old new]
  (let [parent (:parent old)]
    (if (dom/dom-item? old)
      (do (dom-remove old)
          (dom/dom-copy old new [:tag :props])
          (dom/dom-field-set old :parent parent)
          (dom-render old))
      (dom/dom-copy old new [:tag :props]))))

(defmethod dom-replace :default [old new]
  (dom-replace-default old new))
