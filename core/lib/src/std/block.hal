(ns std.block
  (:config {:role :facade :override [empty type]})
  (:require [std.block.base :as base]
            [std.block.construct :as construct]
            [std.block.heal :as block-heal]
            [std.block.layout :as layout]
            [std.block.parse :as parse]
            [std.block.source :as source]
            [std.block.type :as type]
            [std.block.value :as block-value]))

(intern-in
 [block? base/block?]
 [expression? base/expression?]
 [type base/block-type]
 [tag base/block-tag]
 [string base/block-string]
 [length base/block-length]
 [width base/block-width]
 [height base/block-height]
 [prefixed base/block-prefixed]
 [suffixed base/block-suffixed]
 [verify base/block-verify]
 [value base/block-value]
 [value-string base/block-value-string]
 [children base/block-children]
 [replace-children base/replace-children]
 [info base/block-info]
 [block construct/block]
 [void construct/void]
 [space construct/space]
 [spaces construct/spaces]
 [newline construct/newline]
 [newlines construct/newlines]
 [tab construct/tab]
 [tabs construct/tabs]
 [comment construct/comment]
 [error construct/error]
 [token construct/token-from-string]
 [uneval construct/uneval]
 [cursor construct/cursor]
 [contents construct/contents]
 [container construct/container]
 [root construct/root]
 [max-width construct/max-width]
 [add-child construct/add-child]
 [empty construct/empty]
 [line-width construct/line-width]
 [get-lines construct/get-lines]
 [rep construct/rep]
 [indent-body construct/indent-body]
 [child-values block-value/child-values]
 [root-value block-value/root-value]
 [layout layout/layout-main]
 [parse-string parse/parse-string]
 [parse-root parse/parse-root]
 [parse-first parse/parse-first]
 [parse-source parse/parse-source]
 [heal block-heal/heal]
 [void? type/void-block?]
 [code? type/code-block?]
 [space? type/space-block?]
 [linebreak? type/linebreak-block?]
 [linespace? type/linespace-block?]
 [eof? type/eof-block?]
 [comment? type/comment-block?]
 [token? type/token-block?]
 [container? type/container-block?]
 [modifier? type/modifier-block?]
 [error? type/error-block?]
 [namespace-name source/namespace-name]
 [grep-source source/grep-source])
