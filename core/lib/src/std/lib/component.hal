;; ==========================================================================
;; std.lib.component — managed component lifecycle and properties.
;;
;;                         component
;;                             |
;;                    merge call options
;;                    with Var metadata
;;                             |
;;                             v
;;                 +-----------------------+
;;                 | ordered pre-* hooks   |
;;                 +-----------------------+
;;                             |
;;                       setup/teardown
;;                             |
;;                             v
;;                 +-----------------------+
;;                 | IComponent operation  |
;;                 | start / stop / kill   |
;;                 +-----------------------+
;;                             |
;;                             v
;;                 +-----------------------+
;;                 | ordered post-* hooks  |
;;                 +-----------------------+
;;                             |
;;                             v
;;                    resulting component
;;
;; `with-component` guarantees stop in a finally clause. Property descriptors
;; expose optional `:get` and `:set` functions without host reflection.
;; ==========================================================================
(ns std.lib.component)

(defn ^{:schema [:fn [:any] :map]}
  props
  "Returns the declared property descriptors for component."
  [component]
  (IComponent/props component))

(defn ^{:schema [:fn [:any] :any]}
  status
  "Returns component's current lifecycle status."
  [component]
  (IComponent/status component))

(defn ^{:schema [:fn [:any] :bool]}
  started?
  "Returns true when component reports that it has started."
  [component]
  (IComponent/started? component))

(defn ^{:schema [:fn [:any] :bool]}
  stopped?
  "Returns true when component reports that it has stopped."
  [component]
  (IComponent/stopped? component))

(defn ^{:schema [:fn [:any] :bool]}
  remote?
  "Returns true when component represents a remote resource."
  [component]
  (IComponent/remote? component))

(defn- ^{:schema [:fn [:any :map :any] :any]}
  run-hooks
  "Runs the named lifecycle hooks in order, threading component through each one."
  [component functions keys]
  (reduce (fn [current key]
            (let [hook (get functions key)]
              (if hook (hook current) current)))
          component
          keys))

(defn wrap-start
  "Composes ordered setup/start steps around a component start function."
  [start-function steps]
  (fn [component]
    (let [prepared
          (reduce (fn [current step]
                    (let [value (get current (:key step))
                          setup (:setup step)]
                      (if (and value setup)
                        (setup current value)
                        current)))
                  component
                  steps)
          started (start-function prepared)]
      (reduce (fn [current step]
                (let [value (get current (:key step))
                      start (:start step)]
                  (if (and value start)
                    (start current value)
                    current)))
              started
              steps))))

(defn wrap-stop
  "Composes ordered stop/teardown steps around a component stop function."
  [stop-function steps]
  (fn [component]
    (let [stopped
          (reduce (fn [current step]
                    (let [value (get current (:key step))
                          stop (:stop step)]
                      (if (and value stop)
                        (stop current value)
                        current)))
                  component
                  steps)
          stopped (stop-function stopped)]
      (reduce (fn [current step]
                (let [value (get current (:key step))
                      teardown (:teardown step)]
                  (if (and value teardown)
                    (teardown current value)
                    current)))
              stopped
              steps))))

(defn- ^{:schema [:fn [:any :map] :map]}
  merged-options
  "Merges per-component lifecycle defaults with one invocation's options."
  [component options]
  (merge (:component/options (meta component)) options))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :map] :any]]}
  start
  "Starts component after its pre-start hooks and before its post-start hooks."
  ([component]
   (start component {}))
  ([component options]
   (let [options (merged-options component options)
         hooks (:hooks options)
         functions (:functions options)
         setup (or (:setup options) identity)]
     (run-hooks (setup (IComponent/start
                        (run-hooks component functions (:pre-start hooks))))
                functions
                (:post-start hooks)))))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :map] :any]]}
  stop
  "Stops component with its configured pre-stop and post-stop hooks."
  ([component]
   (stop component {}))
  ([component options]
   (let [options (merged-options component options)
         hooks (:hooks options)
         functions (:functions options)
         teardown (or (:teardown options) identity)]
     (run-hooks (IComponent/stop
                 (teardown (run-hooks component functions (:pre-stop hooks))))
                functions
                (:post-stop hooks)))))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:any :map] :any]]}
  kill
  "Force-stops component while preserving the normal stop-hook envelope."
  ([component]
   (kill component {}))
  ([component options]
   (let [options (merged-options component options)
         hooks (:hooks options)
         functions (:functions options)
         teardown (or (:teardown options) identity)]
     (run-hooks (IComponent/kill
                 (teardown (run-hooks component functions (:pre-stop hooks))))
                functions
                (:post-stop hooks)))))

(defn ^{:schema [:fn [:any] :any]}
  all-props
  "Returns the keys of component's declared property descriptors."
  [component]
  (keys (props component)))

(defn ^{:schema [:fn [:any :any] :any]}
  get-prop
  "Reads a property through its optional descriptor getter."
  [component key]
  (let [getter (get-in (props component) [key :get])]
    (if getter (getter))))

(defn ^{:schema [:fn [:any :any :any] :any]}
  set-prop
  "Writes a property through its descriptor setter or throws when it is read-only."
  [component key value]
  (let [setter (get-in (props component) [key :set])]
    (if setter (setter value)
        (throw (ex :hara/database (assoc {:key key} :ex/message "Component property is not writable"))))))

(defmacro with-component
  "Starts the component in binding, evaluates body, and always stops it.

   Binding has the form `[name component-expression]`. The component
   expression is evaluated once and stop runs from a finally clause."
  [binding & body]
  `(let [component# (std.lib.component/start ~(second binding))]
     (try
       (let [~(first binding) component#] ~@body)
       (finally (std.lib.component/stop component#)))))
