(ns std.lib.format.diff)

(defn create-chunk
  "Creates a normalized native diff chunk."
  [chunk]
  (let [lines (vec (or (:lines chunk) []))]
    {:position (or (:position chunk) 0)
     :count (count lines)
     :lines lines}))

(defn create-delta
  "Creates a normalized native diff delta."
  [delta]
  {:type (:type delta)
   :original (create-chunk (:original delta))
   :revised (create-chunk (:revised delta))})

(defn create-patch
  "Creates a native patch from delta maps."
  [deltas]
  (vec (map create-delta deltas)))

(defn- lcs-table
  [original revised]
  (let [original-count (count original)
        revised-count (count revised)]
    (loop [i (dec original-count) table {}]
      (if (< i 0)
        table
        (recur
         (dec i)
         (loop [j (dec revised-count) row table]
           (if (< j 0)
             row
             (recur
              (dec j)
              (assoc row [i j]
                     (if (= (get original i) (get revised j))
                       (inc (get row [(inc i) (inc j)] 0))
                       (max (get row [(inc i) j] 0)
                            (get row [i (inc j)] 0))))))))))))

(defn- edit-script
  [original revised]
  (let [table (lcs-table original revised)
        original-count (count original)
        revised-count (count revised)]
    (loop [i 0 j 0 edits []]
      (cond
        (and (= i original-count) (= j revised-count)) edits
        (= i original-count)
        (recur i (inc j) (conj edits [:insert i j (get revised j)]))
        (= j revised-count)
        (recur (inc i) j (conj edits [:delete i j (get original i)]))
        (= (get original i) (get revised j))
        (recur (inc i) (inc j) (conj edits [:equal i j (get original i)]))
        (>= (get table [(inc i) j] 0)
            (get table [i (inc j)] 0))
        (recur (inc i) j (conj edits [:delete i j (get original i)]))
        :else
        (recur i (inc j) (conj edits [:insert i j (get revised j)]))))))

(defn- flush-delta
  [deltas current]
  (if (nil? current)
    deltas
    (let [original-lines (:original-lines current)
          revised-lines (:revised-lines current)
          type (cond
                 (empty? original-lines) "INSERT"
                 (empty? revised-lines) "DELETE"
                 :else "CHANGE")]
      (conj deltas
            (create-delta
             {:type type
              :original {:position (:original-position current)
                         :lines original-lines}
              :revised {:position (:revised-position current)
                        :lines revised-lines}})))))

(defn- deltas-from-edits
  [edits]
  (loop [remaining edits current nil deltas []]
    (if (empty? remaining)
      (flush-delta deltas current)
      (let [edit (first remaining)
            kind (get edit 0)
            i (get edit 1)
            j (get edit 2)
            line (get edit 3)]
        (if (= kind :equal)
          (recur (rest remaining) nil (flush-delta deltas current))
          (let [next-current (or current
                                 {:original-position i
                                  :revised-position j
                                  :original-lines []
                                  :revised-lines []})]
            (recur
             (rest remaining)
             (if (= kind :delete)
               (update next-current :original-lines conj line)
               (update next-current :revised-lines conj line))
             deltas)))))))

(defn diff
  "Returns native line deltas transforming original into revised."
  [original revised]
  (let [original-lines (str/split-lines original)
        revised-lines (str/split-lines revised)]
    (deltas-from-edits (edit-script original-lines revised-lines))))

(defn- apply-deltas
  [text deltas source-key target-key]
  (let [lines (str/split-lines text)]
    (str/join
     "\n"
     (loop [remaining (create-patch deltas) cursor 0 output []]
       (if (empty? remaining)
         (into output (subvec lines cursor))
         (let [delta (first remaining)
               source (get delta source-key)
               target (get delta target-key)
               position (:position source)
               next-cursor (+ position (:count source))]
           (recur (rest remaining)
                  next-cursor
                  (into (into output (subvec lines cursor position))
                        (:lines target)))))))))

(defn patch
  "Applies native deltas to text."
  [text deltas]
  (apply-deltas text deltas :original :revised))

(defn unpatch
  "Applies native deltas in reverse to restore text."
  [text deltas]
  (apply-deltas text deltas :revised :original))

(defn ->string
  "Returns a readable line-oriented representation of deltas."
  [deltas]
  (let [escape "\u001B["
        reset (str escape "0m")
        bold (fn [value] (str escape "1m" value reset))
        deleted (fn [value]
                  (str escape "31m-"
                       escape "31m" escape "40m" value reset reset))
        inserted (fn [value]
                   (str escape "32m+"
                        escape "32m" escape "40m" value reset reset))]
    (str/join
     "\n"
     (mapcat
      (fn [delta]
        (let [original (:original delta)
              revised (:revised delta)]
          (concat
           [(bold (str "@@ -" (:position original) "," (:count original)
                       " +" (:position revised) "," (:count revised) " "))]
           (map deleted (:lines original))
           (map inserted (:lines revised))
           [""])))
      (create-patch deltas)))))

(defn summary
  "Counts inserted and deleted lines in deltas."
  [deltas]
  (reduce (fn [result delta]
            {:deletes (+ (:deletes result) (get-in delta [:original :count]))
             :inserts (+ (:inserts result) (get-in delta [:revised :count]))})
          {:deletes 0 :inserts 0}
          (create-patch deltas)))

(defn get-lines
  "Returns compact locations for changed lines."
  [deltas]
  (map (fn [delta]
         (case (:type delta)
           "INSERT" ["+" (get-in delta [:revised :position])
                     (get-in delta [:revised :count])]
           "DELETE" ["-" (get-in delta [:original :position])
                     (get-in delta [:original :count])]
           [(get-in delta [:original :position])
            (get-in delta [:original :count])]))
       (create-patch deltas)))
