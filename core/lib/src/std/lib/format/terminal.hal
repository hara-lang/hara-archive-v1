(ns std.lib.format.terminal)

(def +ansi-reset+ "\u001b[0m")

(def +ansi-codes+
  {:default nil
   :muted "\u001b[2m"
   :index "\u001b[34m"
   :success "\u001b[32m"
   :warning "\u001b[33m"
   :error "\u001b[31m"
   :timeout "\u001b[35m"
   :bold "\u001b[1m"
   :critical "\u001b[1;31m"
   :highlight "\u001b[1;36m"})

(def +default-options+
  {:ansi false
   :emit println})

(defn render-cell
  [entry options]
  (let [text (:cell/text entry)
        role (or (:cell/role entry) :default)
        code (get +ansi-codes+ role)]
    (if (and (:ansi options)
             code
             (not (empty? text)))
      (str code text +ansi-reset+)
      text)))

(defn render-line
  [entry options]
  (if (:line/cells entry)
    (str/join ""
              (map
               (fn [cell]
                 (render-cell cell options))
               (:line/cells entry)))
    (let [text (:line/text entry)
          role (or (:line/role entry) :default)
          code (get +ansi-codes+ role)]
      (if (and (:ansi options)
               code
               (not (empty? text)))
        (str code text +ansi-reset+)
        text))))

(defn ^{:public true} render-lines
  "Renders structured lines as plain or ANSI-styled strings."
  ([entries]
   (render-lines entries {}))
  ([entries options]
   (let [options (merge +default-options+ options)]
     (vec
      (map
       (fn [entry]
         (render-line entry options))
       entries)))))

(defn ^{:public true} render
  "Joins rendered structured lines with newline separators."
  ([entries]
   (render entries {}))
  ([entries options]
   (str/join "\n" (render-lines entries options))))

(defn ^{:public true} emit-lines
  "Renders structured lines through an injected sink and returns the count."
  ([entries]
   (emit-lines entries {}))
  ([entries options]
   (let [options (merge +default-options+ options)
         emit (:emit options)]
     (reduce
      (fn [count text]
        (emit text)
        (inc count))
      0
      (render-lines entries options)))))
