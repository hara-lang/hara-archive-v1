(ns std.lib.format.table
  (:require [std.lib.format.common :as common]))

(defn- record-role
  [record]
  (case (:status record)
    :return :success
    :warn :warning
    :error :error
    :critical :critical
    :default))

(defn- column-label
  [column-key]
  (cond
    (keyword? column-key) (name column-key)
    (symbol? column-key) (name column-key)
    (string? column-key) column-key
    :else ""))

(defn- normalise-column
  [column]
  (if (map? column)
    (let [column-key (:key column)]
      (merge
       {:key column-key
        :label (column-label column-key)
        :align :left}
       column))
    {:key column
     :label (column-label column)
     :align :left}))

(defn- column-value
  [column row]
  (let [column-key (:key column)]
    (if (fn? column-key)
      (column-key row)
      (get row column-key))))

(defn- column-width
  [column rows]
  (or (:width column)
      (reduce
       (fn [width row]
         (max width
              (str/length
               (common/value-text
                (column-value column row)))))
       (str/length (common/value-text (:label column)))
       rows)))

(defn- realised-columns
  [columns rows]
  (vec
   (map
    (fn [column]
      (let [column (normalise-column column)]
        (assoc column :width (column-width column rows))))
    columns)))

(defn- table-text
  [columns row]
  (str/join
   "  "
   (map
    (fn [column]
      (common/pad
       (column-value column row)
       (:width column)
       (:align column)))
    columns)))

(defn ^{:public true} table-lines
  "Renders a table section into structured, width-aligned lines."
  [section]
  (let [rows (:section/entries section)
        supplied (:section/columns section)]
    (if (empty? supplied)
      (vec
       (map
        (fn [row]
          (common/line
           (common/value-text row)
           (record-role row)))
        rows))
      (let [columns (realised-columns supplied rows)
            header
            (common/line
             (str/join
              "  "
              (map
               (fn [column]
                 (common/pad
                  (:label column)
                  (:width column)
                  (:align column)))
               columns))
             :highlight)
            separator
            (common/line
             (str/join
              "  "
              (map
               (fn [column]
                 (str/repeat "-" (:width column)))
               columns))
             :muted)]
        (vec
         (concat
          [header separator]
          (map
           (fn [row]
             (common/line
              (table-text columns row)
              (record-role row)))
           rows)))))))
