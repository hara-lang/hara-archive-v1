(ns std.lib.context.registry)

(def +null+
  {:context :null
   :rt {:default {:key :default
                  :create (fn [config] (runtime-null-type))
                  :config {}}}})

(defstruct runtime-null-type [])

(extend-type runtime-null-type IContext
  (call [runtime & args] (vec args)))

(extend-type runtime-null-type IComponent
  (props [runtime] {})
  (status [runtime] :started)
  (started? [runtime] true)
  (stopped? [runtime] false)
  (start [runtime] runtime)
  (stop [runtime] runtime)
  (kill [runtime] runtime)
  (remote? [runtime] false))

(extend-type runtime-null-type IContextLifeCycle
  (has-module? [runtime module] false)
  (setup-module [runtime module] runtime)
  (teardown-module [runtime module] runtime)
  (has-pointer? [runtime pointer] false)
  (setup-pointer [runtime pointer] runtime)
  (teardown-pointer [runtime pointer] runtime))

(def +rt-null+ (std.lib.context.registry/runtime-null-type))

(defn rt-null? [value]
  (instance? runtime-null-type value))

(def ^{:dynamic true} *registry* (atom {}))

(defn registry-merge-runtime [base override]
  (assoc (merge base override)
         :config (merge (:config base) (:config override))))

(defn registry-merge-config [base override]
  (let [base-runtimes (:rt base)
        runtimes (reduce
                  (fn [output pair]
                    (assoc output
                           (key pair)
                           (registry-merge-runtime
                            (get base-runtimes (key pair) {})
                            (val pair))))
                  base-runtimes
                  (:rt override))]
    (assoc (merge base override) :rt runtimes)))

(defn registry-list []
  (keys (deref *registry*)))

(defn registry-install
  ([context] (registry-install context {}))
  ([context config]
   (let [entry (registry-merge-config +null+ (assoc config :context context))]
     (swap! *registry* assoc context entry)
     entry)))

(defn registry-uninstall [context]
  (let [entry (get (deref *registry*) context)]
    (swap! *registry* dissoc context)
    entry))

(defn registry-get [context]
  (or (get (deref *registry*) context)
      (throw (ex :hara/generic (assoc {:context context :options (registry-list)} :ex/message "No context available")))))

(defn registry-rt-list
  ([] (reduce
       (fn [output pair]
         (assoc output (first pair) (keys (:rt (second pair)))))
       {}
       (deref *registry*)))
  ([context] (keys (:rt (registry-get context)))))

(defn registry-rt-add [context config]
  (let [key (:key config)]
    (swap! *registry* assoc-in [context :rt key] config)
    config))

(defn registry-rt-remove [context key]
  (let [value (get-in (deref *registry*) [context :rt key])]
    (swap! *registry* update-in [context :rt] dissoc key)
    value))

(defn registry-rt
  ([context] (registry-rt context nil))
  ([context key]
   (let [key (or key :default)
         entry (registry-get context)
         runtime (get-in entry [:rt key])]
     (if runtime
       (registry-merge-runtime (dissoc entry :rt) runtime)
       (throw (ex :hara/host (assoc {:context context :rt key
                        :options (keys (:rt entry))} :ex/message "No runtime installed")))))))

(defn registry-scratch [context]
  (:scratch (registry-get context)))

(defn registry-scratch-set [context scratch]
  (swap! *registry* assoc-in [context :scratch] scratch)
  scratch)

(def +init+ (registry-install :null {:scratch +rt-null+}))
