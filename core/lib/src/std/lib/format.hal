(ns std.lib.format
  (:config {:role :facade})
  (:require [std.lib.format.common :as common]
            [std.lib.format.table :as table]
            [std.lib.format.report :as report-format]
            [std.lib.format.terminal :as terminal]))

(intern-in
 [line common/line]
 [cell common/cell]
 [line-cells common/line-cells]
 [value-text common/value-text]
 [truncate common/truncate]
 [pad common/pad]
 [table-lines table/table-lines]
 [report-lines report-format/report-lines]
 [report report-format/render-report]
 [render-lines terminal/render-lines]
 [render terminal/render]
 [emit-lines terminal/emit-lines])
