;; Kernel-native wrappers. This namespace owns the public standard-library
;; boundary directly and does not introduce a dependency on application
;; namespaces.
(ns std.lib.kernel)

(defn sandbox-open
  [spec]
  (Sandbox/open spec))

(defn sandbox-eval
  [id source]
  (Sandbox/eval id source))

(defn sandbox-call
  [id callable arguments]
  (Sandbox/call id callable arguments))

(defn sandbox-cancel
  [id]
  (Sandbox/cancel id))

(defn sandbox-status
  [id]
  (Sandbox/status id))

(defn sandbox-close
  [id]
  (Sandbox/close id))

(defn session-create
  [name]
  (Kernel/session-create name))

(defn session-close
  [name]
  (Kernel/session-close name))

(defn session-list
  []
  (Kernel/session-list))

(defn session-info
  [name]
  (Kernel/session-info name))

(defn session-eval
  [name source]
  (Kernel/session-eval name source))


(defn session-namespace
  [name]
  (Kernel/session-namespace name))

(defn session-complete
  [name prefix]
  (Kernel/session-complete name prefix))

(defn resource-register
  [name source]
  (Kernel/resource-register name source))

(defn resource-remove
  [name]
  (Kernel/resource-remove name))

(defn resource-list
  []
  (Kernel/resource-list))

(defn filesystem-create
  [& arguments]
  (apply Kernel/filesystem-create arguments))

(defn filesystem-attach
  [& arguments]
  (apply Kernel/filesystem-attach arguments))

(defn filesystem-detach
  [& arguments]
  (apply Kernel/filesystem-detach arguments))

(defn filesystem-info
  [& arguments]
  (apply Kernel/filesystem-info arguments))

(defn filesystem-close
  [& arguments]
  (apply Kernel/filesystem-close arguments))

(defn capabilities
  []
  (Kernel/capabilities))
