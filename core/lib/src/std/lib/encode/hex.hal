;; ============================================================================
;; std.lib.encode.hex — lowercase hexadecimal over portable Bytes.
;; ============================================================================
(ns std.lib.encode.hex)

(def +digits+ "0123456789abcdef")

(defn input-bytes
  [value]
  (if (bytes? value)
    value
    (throw (ex :serialization {:value value} :ex/message "Hex encode expects Bytes"))))

(defn ^{:public true} encode
  [value]
  (let [value (input-bytes value)
        length (bytes/count value)]
    (loop [index 0 output ""]
      (if (= index length)
        output
        (let [byte (bytes/get value index)]
          (recur (inc index)
                 (str output
                      (str (str/char-at +digits+ (Bits/shift-right byte 4)))
                      (str (str/char-at +digits+ (Bits/and byte 15))))))))))

(defn digit
  [value index]
  (let [number (str/index-of +digits+
                             (str/lower-case (str value)))]
    (if (neg? number)
      (throw (ex :serialization {:value value :index index} :ex/message "Invalid hexadecimal digit"))
      number)))

(defn ^{:public true} decode
  [value]
  (if (not (string? value))
    (throw (ex :serialization {:value value} :ex/message "Hex decode expects a string")))
  (let [length (str/length value)]
    (if (odd? length)
      (throw (ex :serialization {:value value :length length} :ex/message "Hex input must contain an even number of digits")))
    (loop [index 0 output []]
      (if (= index length)
        (apply std.native.Bytes/new output)
        (let [high (digit (str/char-at value index) index)
              low-index (inc index)
              low (digit (str/char-at value low-index) low-index)]
          (recur (+ index 2)
                 (conj output (+ (* high 16) low))))))))
