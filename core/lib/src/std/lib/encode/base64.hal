;; ============================================================================
;; std.lib.encode.base64 — canonical padded RFC 4648 Base64 over portable Bytes.
;; ============================================================================
(ns std.lib.encode.base64)

(def +alphabet+ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defn input-bytes
  [value]
  (if (bytes? value)
    value
    (throw (ex :serialization {:value value} :ex/message "Base64 encode expects Bytes"))))

(defn ^{:public true} encode
  [value]
  (let [value (input-bytes value)
        length (bytes/count value)]
    (loop [index 0 output ""]
      (if (>= index length)
        output
        (let [remaining (- length index)
              a (bytes/get value index)
              b (if (> remaining 1) (bytes/get value (inc index)) 0)
              c (if (> remaining 2) (bytes/get value (+ index 2)) 0)
              packed (+ (Bits/shift-left a 16)
                        (Bits/shift-left b 8)
                        c)
              first (Bits/and (Bits/shift-right packed 18) 63)
              second (Bits/and (Bits/shift-right packed 12) 63)
              third (Bits/and (Bits/shift-right packed 6) 63)
              fourth (Bits/and packed 63)]
          (recur (+ index 3)
                 (str output
                      (str (str/char-at +alphabet+ first))
                      (str (str/char-at +alphabet+ second))
                      (if (> remaining 1)
                        (str (str/char-at +alphabet+ third))
                        "=")
                      (if (> remaining 2)
                        (str (str/char-at +alphabet+ fourth))
                        "="))))))))

(defn value-of
  [character index]
  (let [value (str/index-of +alphabet+ (str character))]
    (if (neg? value)
      (throw (ex :serialization {:character character :index index} :ex/message "Invalid Base64 character"))
      value)))

(defn ^{:public true} decode
  [source]
  (if (not (string? source))
    (throw (ex :serialization {:value source} :ex/message "Base64 decode expects a string")))
  (let [length (str/length source)]
    (if (not= 0 (mod length 4))
      (throw (ex :serialization {:value source :length length} :ex/message "Base64 length must be a multiple of four")))
    (loop [index 0 output []]
      (if (= index length)
        (apply std.native.Bytes/new output)
        (let [last? (= (+ index 4) length)
              ca (str/char-at source index)
              cb (str/char-at source (inc index))
              cc (str/char-at source (+ index 2))
              cd (str/char-at source (+ index 3))]
          (if (or (= ca \=)
                  (= cb \=)
                  (and (not last?)
                       (or (= cc \=) (= cd \=))))
            (throw (ex :serialization {:value source :index index} :ex/message "Base64 padding is only valid in the final quartet")))
          (let [a (value-of ca index)
                b (value-of cb (inc index))
                c-padding (= cc \=)
                d-padding (= cd \=)]
            (if (and c-padding (not d-padding))
              (throw (ex :serialization {:value source :index index} :ex/message "Invalid Base64 padding")))
            (let [c (if c-padding 0 (value-of cc (+ index 2)))
                  d (if d-padding 0 (value-of cd (+ index 3)))]
              (if (and c-padding
                       (not= 0 (Bits/and b 15)))
                (throw (ex :serialization {:value source :index index} :ex/message "Non-canonical Base64 trailing bits")))
              (if (and d-padding
                       (not c-padding)
                       (not= 0 (Bits/and c 3)))
                (throw (ex :serialization {:value source :index index} :ex/message "Non-canonical Base64 trailing bits")))
              (let [packed (+ (Bits/shift-left a 18)
                              (Bits/shift-left b 12)
                              (Bits/shift-left c 6)
                              d)
                    output (conj output
                                 (Bits/and (Bits/shift-right packed 16) 255))
                    output (if c-padding
                             output
                             (conj output
                                   (Bits/and (Bits/shift-right packed 8) 255)))
                    output (if d-padding
                             output
                             (conj output (Bits/and packed 255)))]
                (recur (+ index 4) output)))))))))
