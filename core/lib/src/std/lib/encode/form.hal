;; ============================================================================
;; std.lib.encode.form — ordered application/x-www-form-urlencoded string pairs.
;; ============================================================================
(ns std.lib.encode.form
  (:require [std.lib.encode.url :as url]))

(defn encode-component
  [value]
  (if (not (string? value))
    (throw (ex :hara/dependency (assoc {:value value} :ex/message "Form component encode expects a string"))))
  (str/replace (url/encode value) "%20" "+"))

(defn decode-component
  [value]
  (if (not (string? value))
    (throw (ex :hara/dependency (assoc {:value value} :ex/message "Form component decode expects a string"))))
  (url/decode (str/replace value "+" "%20")))

(defn- valid-pair?
  [value]
  (and (vector? value)
       (= 2 (count value))
       (string? (nth value 0))
       (string? (nth value 1))))

(defn- checked-pairs
  [value]
  (if (not (vector? value))
    (throw (ex :hara/serialization (assoc {:value value} :ex/message "Form encoding expects an ordered vector of string pairs"))))
  (loop [index 0 output []]
    (if (= index (count value))
      output
      (let [pair (nth value index)]
        (if (not (valid-pair? pair))
          (throw (ex :hara/syntax (assoc {:value pair :index index} :ex/message "Malformed form pair"))))
        (recur (inc index) (conj output pair))))))

(defn encode
  [value]
  (str/join
   "&"
   (map (fn [pair]
          (str (encode-component (nth pair 0))
               "="
               (encode-component (nth pair 1))))
        (checked-pairs value))))

(defn- decode-pair
  [value index offset]
  (let [separator (str/index-of value "=")]
    (if (neg? separator)
      (throw (ex :hara/syntax (assoc {:value value :index index :offset offset} :ex/message "Malformed form pair"))))
    [(decode-component (str/slice value 0 separator))
     (decode-component (str/slice value (inc separator)))]))

(defn decode
  [source]
  (if (not (string? source))
    (throw (ex :hara/serialization (assoc {:value source} :ex/message "Form decode expects a string"))))
  (if (= source "")
    []
    (let [length (str/length source)]
      (loop [offset 0 index 0 output []]
        (let [separator (str/index-of source "&" offset)
              end (if (neg? separator) length separator)
              value (str/slice source offset end)
              output (conj output (decode-pair value index offset))]
          (if (neg? separator)
            output
            (recur (inc separator) (inc index) output)))))))
