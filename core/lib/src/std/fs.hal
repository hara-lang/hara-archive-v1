;; std.fs — familiar direct-style filesystem API over std.native.File effects.
(ns std.fs
  (:config {:override [list]})
  (:require [std.fs.path :as path]
            [std.fs.walk :as walk]))

(def copy-default-options
  {:replace? false
   :parents? false
   :preserve-modified? false})

(def delete-default-options
  {:recursive? false
   :missing-ok? false})

(defn stat
  "Returns no-follow metadata for a canonical logical path."
  [value]
  (deref (File/stat (path/normalise value))))

(defn exists?
  "Returns true when a logical path exists and false only for not-found."
  [value]
  (deref (File/exists? (path/normalise value))))

(defn entries
  "Returns sorted immediate no-follow entry metadata."
  [value]
  (deref (File/entries (path/normalise value))))

(defn list
  "Returns sorted immediate canonical path strings."
  [value]
  (deref (File/list (path/normalise value))))

(defn read-bytes
  "Reads a regular file and returns its bytes directly."
  [value]
  (deref (File/read (path/normalise value))))

(defn write-bytes
  "Writes bytes and returns the canonical logical path."
  ([value bytes]
   (write-bytes value bytes {}))
  ([value bytes options]
   (deref (File/write (path/normalise value) bytes options))))

(defn file?
  "Returns true when value names a regular file."
  [value]
  (= (:type (stat value)) :file))

(defn directory?
  "Returns true when value names a directory."
  [value]
  (= (:type (stat value)) :directory))

(defn symlink?
  "Returns true when value names a symbolic link."
  [value]
  (= (:type (stat value)) :symlink))

(defn select
  "Returns deterministic traversal entries accepted by predicate."
  ([value predicate]
   (select value predicate {}))
  ([value predicate options]
   (vec (filter predicate (walk/walk value options)))))

(defn create-directory
  "Creates a directory and returns its canonical logical path."
  ([value]
   (create-directory value {}))
  ([value options]
   (deref (File/mkdir (path/normalise value) options))))

(def mkdir create-directory)

(defn temp-file
  "Atomically creates a temporary file beneath parent."
  ([parent]
   (temp-file parent {}))
  ([parent options]
   (deref (File/temp-file (path/normalise parent) options))))

(defn temp-directory
  "Atomically creates a temporary directory beneath parent."
  ([parent]
   (temp-directory parent {}))
  ([parent options]
   (deref (File/temp-directory (path/normalise parent) options))))

(defn copy-single
  "Copies one regular file and returns the canonical target path."
  ([source target]
   (copy-single source target {}))
  ([source target options]
   (deref
    (File/copy (path/normalise source)
               (path/normalise target)
               options))))

(defn move
  "Moves one file or directory and returns the canonical target path."
  ([source target]
   (move source target {}))
  ([source target options]
   (deref
    (File/move (path/normalise source)
               (path/normalise target)
               options))))

(defn- map-merge
  [left right]
  (reduce (fn [output entry]
            (assoc output (nth entry 0) (nth entry 1)))
          left
          right))

(defn- copy-invalid-target?
  [source target]
  (or (= source target)
      (= source "/")
      (str/starts-with? target (str source "/"))))

(defn- delete-tree
  [value options]
  (letfn [(delete-many [children]
            (loop [index 0
                   deleted []]
              (if (= index (count children))
                deleted
                (let [child (nth children index)
                      values (delete-node (:path child))]
                  (recur (inc index)
                         (reduce conj deleted values))))))
          (delete-node [current]
            (let [entry (stat current)]
              (if (and (:recursive? options)
                       (= (:type entry) :directory))
                (let [deleted (delete-many (entries current))
                      deleted-path
                      (deref (File/delete current {:missing-ok? false}))]
                  (conj deleted deleted-path))
                [(deref (File/delete current {:missing-ok? false}))])))]
    (delete-node value)))

(defn delete
  "Deletes a file, symlink, or empty directory. A simple deletion returns the
   canonical path. With :recursive? true, directories are deleted in
   post-order and the deleted canonical paths are returned."
  ([value]
   (delete value {}))
  ([value options]
   (let [value (path/normalise value)
         options (merge delete-default-options options)]
     (if (= value "/")
       (throw
        (ex :file/permission-denied
            {:file/operation :delete
             :file/path value
             :file/target nil}
            :ex/message "The mounted filesystem root cannot be deleted"
            :ex/class :ex.class/security))
       (if (:recursive? options)
         (if (exists? value)
           (delete-tree value options)
           (if (:missing-ok? options)
             []
             [(deref (File/delete value {:missing-ok? false}))]))
         (deref
          (File/delete value {:missing-ok? (:missing-ok? options)})))))))

(defn- prepare-directory-target
  [target options]
  (if (exists? target)
    (if (:replace? options)
      (let [_ (delete target {:recursive? true :missing-ok? false})]
        (create-directory target
                          {:parents? (:parents? options)
                           :exists-ok? false}))
      (throw
       (ex :file/already-exists
           {:file/operation :copy
            :file/path target
            :file/target target}
           :ex/message "Copy target already exists"
           :ex/class :ex.class/conflict)))
    (create-directory target
                      {:parents? (:parents? options)
                       :exists-ok? false})))

(defn- copy-tree
  [source target options]
  (letfn [(copy-many [children destination-root]
            (loop [index 0
                   output {}]
              (if (= index (count children))
                output
                (let [entry (nth children index)
                      destination (path/join destination-root (:name entry))
                      values (copy-node (:path entry) destination)]
                  (recur (inc index)
                         (map-merge output values))))))
          (copy-node [current-source current-target]
            (let [entry (stat current-source)]
              (cond
                (= (:type entry) :file)
                {current-source
                 (copy-single current-source current-target options)}

                (= (:type entry) :directory)
                (let [_ (prepare-directory-target current-target options)
                      children (entries current-source)
                      values (copy-many children current-target)]
                  (assoc values current-source current-target))

                :else
                (throw
                 (ex :file/unsupported
                     {:file/operation :copy
                      :file/path current-source
                      :file/target current-target}
                     :ex/message "Only regular files and directories can be copied"
                     :ex/class :ex.class/io)))))]
    (copy-node source target)))

(defn copy
  "Copies a regular file or directory tree without following symbolic links.
   Returns a source-to-target map."
  ([source target]
   (copy source target {}))
  ([source target options]
   (let [source (path/normalise source)
         target (path/normalise target)
         options (merge copy-default-options options)]
     (if (copy-invalid-target? source target)
       (throw
        (ex :file/invalid-path
            {:file/operation :copy
             :file/path source
             :file/target target}
            :ex/message "Copy target must not be the source or one of its descendants"
            :ex/class :ex.class/argument))
       (copy-tree source target options)))))

(defn copy-into
  "Copies source beneath directory using the source filename."
  ([source directory]
   (copy-into source directory {}))
  ([source directory options]
   (let [source (path/normalise source)
         directory (path/normalise directory)
         name (path/file-name source)]
     (if (nil? name)
       (throw
        (ex :file/invalid-path
            {:file/operation :copy
             :file/path source
             :file/target directory}
            :ex/message "The mounted root has no filename for copy-into"
            :ex/class :ex.class/argument))
       (copy source (path/join directory name) options)))))
