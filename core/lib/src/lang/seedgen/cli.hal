(ns lang.seedgen.cli
  (:require [tool.cli.model :as model]
            [code.project :as project]
            [lang.seedgen :as seedgen]))

(def +operations+ #{:root :list :incomplete :benchadd})

(defn parse-arguments [arguments]
  (let [operation (keyword (or (first arguments) "list"))]
    (if (get +operations+ operation)
      {:operation operation
       :language (if (= operation :benchadd)
                   (keyword (or (second arguments) "js"))
                   nil)}
      (throw (ex :hara/syntax (assoc {:operation operation} :ex/message (str "seedgen supports root, list, incomplete, or benchadd")))))))

(defn units-for [current-project parsed]
  (let [root (:project/root current-project)
        test-root (first (:project/test-paths current-project))]
    (reduce
     (fn [output path]
       (conj output
             {:path path
              :source (project/read-text path)
              :language (:language parsed)
              :test-root (file/join root test-root)}))
     []
     (project/files-in current-project
                       (:project/test-paths current-project)
                       ".hal"))))

(defn handler [request]
  (let [parsed (parse-arguments (:request/arguments request))
        start (or (:project (:request/options request))
                  (:root (:request/options request))
                  (:request/cwd request)
                  (os/cwd))
        current-project (project/discover start)
        result (seedgen/run (:operation parsed)
                            {:units (units-for current-project parsed)})]
    (model/success result [(model/message (str (pr-str result) "\n"))])))
