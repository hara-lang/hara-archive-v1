(ns lang.core.script-fragment
  (:require [lang.core.script :as script]))

(defn current-module-id
  []
  (script/current-module-id))

(defn fragment-return
  [metadata]
  (or (:static/return metadata)
      (get metadata :-)))

(defn register-value
  "Registers one historical def$.<lang> value fragment in the portable module
   registry. Value fragments are data substitutions, not host macros."
  [id value metadata]
  (let [module-id (current-module-id)
        module (get (deref script/+modules+) module-id)
        _ (if (nil? module)
            (throw (ex :hara/dependency (assoc {:module module-id
                             :fragment id} :ex/message "Tahto module must be configured before def$"))))
        fragment-id (symbol (name id))
        qualified (symbol (str module-id) (name fragment-id))
        return-value (fragment-return metadata)
        entry
        (merge (or metadata {})
               {:id fragment-id
                :symbol qualified
                :module module-id
                :lang (:lang module)
                :section :fragment
                :op 'def$
                :op-key :def$
                :form value
                :form-input value
                :template nil}
               (if (nil? return-value)
                 {}
                 {:static/return return-value}))]
    (swap! script/+modules+
           assoc-in [module-id :fragment fragment-id] entry)
    nil))
