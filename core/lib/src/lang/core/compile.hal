;; ============================================================================
;; lang.core.compile — deterministic, side-effect-free module compilation.
;;
;; This namespace compiles the in-memory Tahto module registry. It never writes
;; artifacts; callers decide where returned output, diagnostics, and provenance
;; are persisted.
;; ============================================================================
(ns lang.core.compile
  (:require
            [lang.common.compat :as compat]
            [lang.common.compiler :as compiler]
            [lang.core.registry :as registry]
            [lang.core.script :as script]))

(def +empty-dependencies+
  {:code #{}
   :fragment #{}
   :native #{}})

(defn diagnostic
  [code message data]
  {:code code
   :severity :error
   :message message
   :data data})

(defn- stable-values
  [values]
  (vec (sort-by str (or values []))))

(defn- set-remove
  [values value]
  (set (filter (fn [item] (not= item value)) values)))

(defn- require-module-id
  [spec]
  (cond
    (symbol? spec) spec
    (vector? spec) (first spec)
    (list? spec) (first spec)
    :else nil))

(defn- module-dependency-ids
  [module]
  (stable-values
   (filter symbol?
           (map require-module-id (or (:require module) [])))))

(defn load-module-graph
  "Loads the root and every declared module dependency exactly once."
  [main]
  (loop [pending [main]
         seen {}
         modules {}
         diagnostics []]
    (if (empty? pending)
      {:modules modules
       :diagnostics diagnostics}
      (let [module-id (first pending)
            pending (vec (rest pending))]
        (if (get seen module-id)
          (recur pending seen modules diagnostics)
          (let [load-result
                (try
                  (do
                    (script/load-module module-id)
                    {:ok true})
                  (catch Throwable error
                    {:ok false}))
                seen (assoc seen module-id true)
                module (get (deref script/+modules+) module-id)]
            (cond
              (not (:ok load-result))
              (recur
               pending
               seen
               modules
               (conj diagnostics
                     (diagnostic
                      :lang/module-load-failed
                      "Tahto module could not be loaded"
                      {:module module-id})))

              (nil? module)
              (recur
               pending
               seen
               modules
               (conj diagnostics
                     (diagnostic
                      :lang/missing-module
                      "Loaded Tahto namespace did not register a module"
                      {:module module-id})))

              :else
              (recur
               (into pending (module-dependency-ids module))
               seen
               (assoc modules module-id module)
               diagnostics))))))))

(defn- module-ready?
  [modules remaining module-id]
  (reduce
   (fn [ready dependency]
     (and ready
          (or (not (has? modules dependency))
              (not (has? remaining dependency)))))
   true
   (module-dependency-ids (get modules module-id))))

(defn order-modules
  "Topologically orders registered modules. Cycles are reported and appended in
   qualified-symbol order so the result remains deterministic."
  [modules]
  (loop [remaining (set (keys modules))
         ordered []
         diagnostics []]
    (if (empty? remaining)
      {:order ordered
       :diagnostics diagnostics}
      (let [ready
            (stable-values
             (filter (fn [module-id]
                       (module-ready? modules remaining module-id))
                     remaining))]
        (if (empty? ready)
          (let [cycle (stable-values remaining)]
            {:order (into ordered cycle)
             :diagnostics
             (conj diagnostics
                   (diagnostic
                    :lang/module-cycle
                    "Tahto module dependency cycle"
                    {:modules cycle}))})
          (recur
           (reduce set-remove remaining ready)
           (into ordered ready)
           diagnostics))))))

(defn- schema-pairs
  [module]
  (let [schema (:schema module)]
    (if (map? schema)
      (vec
       (map (fn [schema-id] [schema-id (get schema schema-id)])
            (sort-by str (keys schema))))
      [])))

(defn schema-diagnostics
  "Reports incompatible definitions for one schema key across the module graph."
  [modules module-order]
  (:diagnostics
   (reduce
    (fn [state module-id]
      (reduce
       (fn [inner pair]
         (let [schema-id (first pair)
               definition (second pair)
               previous (get (:seen inner) schema-id)]
           (cond
             (nil? previous)
             (assoc-in inner
                       [:seen schema-id]
                       {:module module-id
                        :definition definition})

             (= definition (:definition previous))
             inner

             :else
             (update
              inner
              :diagnostics
              conj
              (diagnostic
               :lang/conflicting-schema
               "Tahto schema definition conflicts with an earlier module"
               {:schema schema-id
                :module module-id
                :previous-module (:module previous)})))))
       state
       (schema-pairs (get modules module-id))))
    {:seen {}
     :diagnostics []}
    module-order)))

(defn- entry-qualified-symbol
  [entry]
  (let [module (:module entry)
        supplied (:symbol entry)
        id (or (:id entry) supplied)]
    (cond
      (and (symbol? supplied) (namespace supplied)) supplied
      (and module id) (symbol (str module) (name id))
      (symbol? supplied) supplied
      :else nil)))

(defn- entry-form-symbol
  [entry]
  (let [form (or (:form-input entry) (:form entry))]
    (if (and (list? form)
             (> (count form) 1)
             (symbol? (second form)))
      (second form)
      nil)))

(defn- entry-metadata-value
  [entry lookup-key fallback]
  (let [form (or (:form-input entry) (:form entry))
        form-symbol (entry-form-symbol entry)]
    (or (get entry lookup-key)
        (get-in entry [:meta lookup-key])
        (get (meta form) lookup-key)
        (get (meta form-symbol) lookup-key)
        fallback)))

(defn- entry-priority
  [entry]
  (or (:priority entry)
      (:static/priority entry)
      (entry-metadata-value entry :priority nil)
      0))

(defn- entry-source
  [entry]
  {:line (or (:line entry)
             (:source/line entry)
             (entry-metadata-value entry :line nil)
             0)
   :column (or (:column entry)
               (:source/column entry)
               (entry-metadata-value entry :column nil)
               0)})

(defn- normalize-dependencies
  [dependencies]
  (cond
    (nil? dependencies) +empty-dependencies+
    (set? dependencies) (assoc +empty-dependencies+ :code dependencies)
    (map? dependencies) (merge +empty-dependencies+ dependencies)
    :else +empty-dependencies+))

(defn- qualify-dependency
  [module dependency]
  (if (and (symbol? dependency)
           (nil? (namespace dependency)))
    (symbol (str module) (name dependency))
    dependency))

(defn- qualified-dependencies
  [module dependencies]
  (let [dependencies (normalize-dependencies dependencies)]
    {:code
     (set
      (map (fn [dependency]
             (qualify-dependency module dependency))
           (filter symbol? (:code dependencies))))
     :fragment
     (set
      (map (fn [dependency]
             (qualify-dependency module dependency))
           (filter symbol? (:fragment dependencies))))
     :native (set (or (:native dependencies) #{}))}))

(defn default-entry-compiler
  "Compiles one registered entry with the selected portable language book."
  [options modules module entry]
  (let [lang (:lang options)
        book (or (:book options)
                 (registry/registry-book lang :default nil))]
    (if (nil? book)
      (throw (ex :generic {:lang lang} :ex/message "Tahto language book is not registered"))
      (let [selected (:selection book)
            all-modules (merge (or (:modules book) {}) modules)
            context {:book (assoc book :modules all-modules)
                     :modules all-modules
                     :module module
                     :entry entry
                     :lang lang
                     :layout (or (:layout options) :module)
                     :emit (or (:emit options) {})}]
        (compiler/compile-entry
         (or (:compiler options) (compiler/compiler))
         entry
         selected
         context)))))

(def ^:dynamic *entry-compiler* default-entry-compiler)

(defn- normalized-compiler-diagnostics
  [qualified diagnostics]
  (vec
   (map
    (fn [value]
      (if (map? value)
        (let [value (compat/canonicalize-map value)]
          (if (:entry value)
            value
            (assoc value :entry qualified)))
        (diagnostic
         :lang/compiler-diagnostic
         "Tahto compiler returned a non-map diagnostic"
         {:entry qualified
          :value (str value)})))
    (or diagnostics []))))

(defn- failed-entry
  [entry qualified error-diagnostic]
  {:symbol qualified
   :module (:module entry)
   :id (:id entry)
   :entry entry
   :priority (entry-priority entry)
   :source (entry-source entry)
   :output nil
   :dependencies +empty-dependencies+
   :diagnostics [error-diagnostic]
   :provenance {}})

(defn- compile-entry-safe
  [options modules entry]
  (let [qualified (entry-qualified-symbol entry)
        module (get modules (:module entry))]
    (try
      (let [result (*entry-compiler* options modules module entry)
            output (:output result)
            diagnostics
            (normalized-compiler-diagnostics
             qualified
             (:diagnostics result))]
        (if (string? output)
          {:item
           {:symbol qualified
            :module (:module entry)
            :id (:id entry)
            :entry entry
            :priority (entry-priority entry)
            :source (entry-source entry)
            :output output
            :dependencies
            (qualified-dependencies (:module entry)
                                    (:dependencies result))
            :diagnostics diagnostics
            :provenance (or (:provenance result) {})}
           :diagnostics diagnostics}
          (let [problem
                (diagnostic
                 :lang/unsupported-form
                 "Tahto entry compiler did not return string output"
                 {:entry qualified
                  :module (:module entry)})]
            {:item (failed-entry entry qualified problem)
             :diagnostics (conj diagnostics problem)})))
      (catch Throwable error
        (let [problem
              (diagnostic
               :lang/unsupported-form
               "Tahto entry compilation failed"
               {:entry qualified
                :module (:module entry)
                :cause-message (ex-message error)})]
          {:item (failed-entry entry qualified problem)
           :diagnostics [problem]})))))

(defn- module-code-entries
  [module-id module]
  (vec
   (map
    (fn [pair]
      (let [id (key pair)
            entry (merge {:id id
                          :module module-id}
                         (or (val pair) {}))]
        (assoc entry :symbol (entry-qualified-symbol entry))))
    (sort-by (fn [pair] (str (key pair)))
             (or (:code module) {})))))

(defn compile-entries
  "Compiles every registered code entry in module order."
  [options modules module-order]
  (let [prepared-options
        (assoc options
               :book (or (:book options)
                         (registry/registry-book (:lang options) :default nil))
               :compiler (or (:compiler options) (compiler/compiler)))]
    (reduce
     (fn [state entry]
       (let [compiled (compile-entry-safe prepared-options modules entry)]
         {:entries (conj (:entries state) (:item compiled))
          :diagnostics (into (:diagnostics state)
                             (:diagnostics compiled))}))
     {:entries []
      :diagnostics []}
     (mapcat (fn [module-id]
               (module-code-entries module-id (get modules module-id)))
             module-order))))

(defn missing-entry-diagnostics
  [entries]
  (let [known
        (reduce (fn [out entry]
                  (assoc out (:symbol entry) true))
                {}
                entries)]
    (vec
     (mapcat
      (fn [entry]
        (map
         (fn [dependency]
           (diagnostic
            :lang/missing-entry
            "Tahto code dependency is not registered"
            {:entry (:symbol entry)
             :dependency dependency}))
         (filter (fn [dependency]
                   (not (has? known dependency)))
                 (stable-values
                  (get-in entry [:dependencies :code])))))
      entries))))

(defn- module-index
  [module-order]
  (loop [index 0
         remaining module-order
         out {}]
    (if (empty? remaining)
      out
      (recur (+ index 1)
             (vec (rest remaining))
             (assoc out (first remaining) index)))))

(defn- entry-sort-key
  [module-indices entry]
  [(or (get module-indices (:module entry)) 0)
   (:priority entry)
   (get-in entry [:source :line])
   (get-in entry [:source :column])
   (str (:symbol entry))])

(defn- entry-ready?
  [entry-map remaining entry]
  (reduce
   (fn [ready dependency]
     (and ready
          (or (not (has? entry-map dependency))
              (not (has? remaining dependency)))))
   true
   (get-in entry [:dependencies :code])))

(defn order-entries
  "Orders entries by module dependency, code dependency, priority, source
   position, and qualified symbol. Cycles are reported deterministically."
  [entries module-order]
  (let [entry-map
        (reduce (fn [out entry]
                  (assoc out (:symbol entry) entry))
                {}
                entries)
        module-indices (module-index module-order)]
    (loop [remaining (set (keys entry-map))
           ordered []
           diagnostics []]
      (if (empty? remaining)
        {:entries ordered
         :diagnostics diagnostics}
        (let [ready-symbols
              (filter
               (fn [qualified]
                 (entry-ready? entry-map
                               remaining
                               (get entry-map qualified)))
               remaining)
              ready
              (vec
               (sort-by (fn [entry]
                          (entry-sort-key module-indices entry))
                        (map (fn [qualified]
                               (get entry-map qualified))
                             ready-symbols)))]
          (if (empty? ready)
            (let [cycle
                  (vec
                   (sort-by (fn [entry]
                              (entry-sort-key module-indices entry))
                            (map (fn [qualified]
                                   (get entry-map qualified))
                                 remaining)))]
              {:entries (into ordered cycle)
               :diagnostics
               (conj diagnostics
                     (diagnostic
                      :lang/entry-cycle
                      "Tahto entry dependency cycle"
                      {:entries (vec (map :symbol cycle))}))})
            (recur
             (reduce set-remove remaining (map :symbol ready))
             (into ordered ready)
             diagnostics)))))))

(defn- module-entry-symbols
  [module-id entries]
  (stable-values
   (map (fn [id]
          (symbol (str module-id) (name id)))
        (keys (or entries {})))))

(defn- stable-link-pairs
  [links]
  (vec (sort-by (fn [pair] (str (key pair))) (or links {}))))

(defn- module-descriptor
  [module-id module]
  {:id module-id
   :lang (:lang module)
   :require (vec (or (:require module) []))
   :dependencies (module-dependency-ids module)
   :link (stable-link-pairs (:link module))
   :static (:static module)
   :application (:application module)
   :schema (:schema module)
   :source (:source module)
   :code (module-entry-symbols module-id (:code module))
   :fragment (module-entry-symbols module-id (:fragment module))})

(defn- dependency-descriptor
  [dependencies]
  {:code (stable-values (:code dependencies))
   :fragment (stable-values (:fragment dependencies))
   :native (stable-values (:native dependencies))})

(defn- entry-descriptor
  [entry]
  {:symbol (:symbol entry)
   :module (:module entry)
   :id (:id entry)
   :priority (:priority entry)
   :source (:source entry)
   :dependencies (dependency-descriptor (:dependencies entry))
   :output (:output entry)
   :diagnostics (:diagnostics entry)
   :provenance (:provenance entry)})

(defn- label-prefix
  [lang]
  (cond
    (= lang :postgres) "-- "
    (= lang :sql) "-- "
    (= lang :lua) "-- "
    (= lang :python) "# "
    (= lang :js) "// "
    (= lang :ts) "// "
    (= lang :jsx) "// "
    (= lang :c) "// "
    (= lang :go) "// "
    (= lang :dart) "// "
    (= lang :solidity) "// "
    (= lang :glsl) "// "
    :else ";; "))

(defn- render-output
  [lang emit entries]
  (let [labels? (true? (get-in emit [:code :label]))
        prefix (label-prefix lang)]
    (str/join
     "\n\n"
     (map
      (fn [entry]
        (if labels?
          (str prefix (:symbol entry) "\n" (:output entry))
          (:output entry)))
      (filter (fn [entry]
                (string? (:output entry)))
              entries)))))

(defn- invalid-options-result
  [options]
  {:output ""
   :modules []
   :entries []
   :diagnostics
   [(diagnostic
     :lang/invalid-options
     "compile-module requires :lang and a symbolic :main module"
     {:lang (:lang options)
      :main (:main options)})]
   :provenance
   {:lang (:lang options)
    :main (:main options)
    :layout (or (:layout options) :module)
    :module-order []
    :entry-order []
    :entries []}})

(defn compile-module
  "Compiles a complete registered module graph without writing files.

   Stable return contract:
   {:output string
    :modules [...]
    :entries [...]
    :diagnostics [...]
    :provenance {...}}"
  [options]
  (let [lang (:lang options)
        main (:main options)
        layout (or (:layout options) :module)
        emit (or (:emit options) {})]
    (if (or (nil? lang)
            (not (symbol? main)))
      (invalid-options-result options)
      (let [options (assoc options :layout layout :emit emit)
            graph (load-module-graph main)
            modules (:modules graph)
            module-order-result (order-modules modules)
            module-order (:order module-order-result)
            schema-problems (schema-diagnostics modules module-order)
            compiled (compile-entries options modules module-order)
            missing (missing-entry-diagnostics (:entries compiled))
            entry-order-result
            (order-entries (:entries compiled) module-order)
            ordered-entries (:entries entry-order-result)
            diagnostics
            (vec
             (concat (:diagnostics graph)
                     (:diagnostics module-order-result)
                     schema-problems
                     (:diagnostics compiled)
                     missing
                     (:diagnostics entry-order-result)))
            module-descriptors
            (vec
             (map (fn [module-id]
                    (module-descriptor module-id
                                       (get modules module-id)))
                  module-order))
            entry-descriptors
            (vec (map entry-descriptor ordered-entries))]
        {:output (render-output lang emit ordered-entries)
         :modules module-descriptors
         :entries entry-descriptors
         :diagnostics diagnostics
         :provenance
         {:lang lang
          :main main
          :layout layout
          :module-order module-order
          :entry-order (vec (map :symbol ordered-entries))
          :entries
          (vec
           (map (fn [entry]
                  {:symbol (:symbol entry)
                   :provenance (:provenance entry)})
                ordered-entries))}}))))
