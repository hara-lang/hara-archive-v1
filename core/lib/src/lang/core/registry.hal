(ns lang.core.registry
  (:require [lang.common.registry :as grammar-registry]
            [lang.model.v1.spec-xtalk :as spec-xtalk]
            [lang.model.v1.spec-hara :as spec-hara]
            [lang.model.v1.spec-js :as spec-js]
            [lang.model.v1.spec-python :as spec-python]
            [lang.model.v1.spec-lua :as spec-lua]
            [lang.model.v1.spec-postgres :as spec-postgres]
            [lang.model.v1.spec-glsl :as spec-glsl]
            [lang.model.v1.spec-c :as spec-c]))

;; Foundation-compatible runtime registry. Runtime implementations are loaded
;; lazily from the exact [language runtime] coordinate.
(def +registry+
  (atom {[:js :oneshot]
         {:namespace 'lang.runtime.basic.impl.process-js}
         [:js :basic]
         {:namespace 'lang.runtime.basic.impl.process-js}
         [:python :oneshot]
         {:namespace 'lang.runtime.basic.impl.process-python}
         [:python :basic]
         {:namespace 'lang.runtime.basic.impl.process-python}
         [:lua :oneshot]
         {:namespace 'lang.runtime.basic.impl.process-lua}
         [:lua :basic]
         {:namespace 'lang.runtime.basic.impl.process-lua}
         [:xtalk :basic]
         {:namespace 'lang.runtime.basic.impl.process-xtalk}
         [:hara :basic]
         {:namespace 'lang.runtime.basic.impl.process-xtalk}
         [:postgres :db.client]
         {:namespace 'lang.runtime.postgres.db-client}}))

;; Foundation keeps the public [:language :default] coordinate stable. Each
;; coordinate owns a configurable default and any number of immutable versions.
(def +book-registry+
  (atom {[:xtalk :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-xtalk
              :load (fn [] spec-xtalk/+book+)}}}

         [:hara :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-hara
              :load (fn [] spec-hara/+book+)
              :parent :xtalk}}}

         [:js :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-js
              :load (fn [] spec-js/+book+)
              :parent :xtalk}}}

         [:python :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-python
              :load (fn [] spec-python/+book+)
              :parent :xtalk}}}

         [:lua :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-lua
              :load (fn [] spec-lua/+book+)
              :parent :xtalk}}}

         [:postgres :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-postgres
              :load (fn [] spec-postgres/+book+)
              :parent :xtalk}}}

         [:glsl :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-glsl
              :load (fn [] spec-glsl/+book+)
              :parent :xtalk}}}

         [:c :default]
         {:default-version 1
          :versions
          {1 {:ns 'lang.model.v1.spec-c
              :load (fn [] spec-c/+book+)
              :parent :xtalk}}}}))

;; Grammars and books have distinct identities and registries. A Book pins one
;; materialized grammar selection; this catalog owns the independently
;; versioned source-backed grammar definitions from which selections are
;; resolved. Direct-book targets remain available through +book-registry+.
(def +grammar-registry+
  (atom
   (spec-c/install
    (spec-glsl/install
     (spec-postgres/install
      (spec-hara/install
       (spec-xtalk/install
        (grammar-registry/registry))))))))

(defn- atom-value [reference]
  (deref (identity reference)))

(defn registry-list
  "Lists registered [language runtime] coordinates."
  []
  (vec (keys (atom-value +registry+))))

(defn registry-add
  "Registers one exact runtime coordinate by portable namespace identity."
  [language runtime namespace-symbol]
  (swap! +registry+ assoc [language runtime]
         {:namespace namespace-symbol})
  namespace-symbol)

(defn registry-runtime-ns
  "Returns the implementation namespace for a runtime coordinate."
  [language runtime]
  (get-in (atom-value +registry+) [[language runtime] :namespace]))

(defn registry-runtime
  "Loads a registered runtime implementation and returns its namespace."
  [language runtime]
  (let [entry (get (atom-value +registry+) [language runtime])]
    (if entry
      (let [namespace-symbol (:namespace entry)
            _ (eval (list 'require (list 'quote namespace-symbol)))
            init-symbol (symbol (name namespace-symbol) "+init+")
            init-var (resolve init-symbol)]
        (if (and (ns-loaded? namespace-symbol) init-var)
          namespace-symbol
          (throw
           (ex :dependency {:lang language
                     :runtime runtime
                     :namespace namespace-symbol
                     :export init-symbol} :ex/message "Registered runtime loader did not provide its exact namespace"))))
      nil)))

(defn registry-book-list
  "Lists all registered Foundation book coordinates."
  []
  (vec (keys (atom-value +book-registry+))))

(defn registry-grammar-list
  "Lists installed grammar sources, optionally filtered by source fields."
  ([]
   (registry-grammar-list {}))
  ([query]
   (grammar-registry/list (atom-value +grammar-registry+) query)))

(defn registry-grammar-versions
  "Lists all installed versions of a grammar identity."
  [grammar-id]
  (grammar-registry/versions (atom-value +grammar-registry+) grammar-id))

(defn registry-grammar
  "Resolves an exact grammar id and version without consulting Book defaults."
  ([grammar-id version]
   (registry-grammar grammar-id version []))
  ([grammar-id version facets]
   (grammar-registry/resolve
    (atom-value +grammar-registry+)
    {:grammar/id grammar-id
     :grammar/version version
     :grammar/facets (vec facets)})))

(defn- registry-book-entry
  [language key]
  (get (atom-value +book-registry+) [language key]))

(defn registry-book-versions
  "Lists every installed version for a Foundation book coordinate."
  ([language]
   (registry-book-versions language :default))
  ([language key]
   (let [entry (registry-book-entry language key)]
     (if entry
       (vec (sort (keys (get entry :versions))))
       []))))

(defn registry-book-default-version
  "Returns the version selected by a versionless book request."
  ([language]
   (registry-book-default-version language :default))
  ([language key]
   (get (registry-book-entry language key) :default-version)))

(defn registry-book-info
  "Returns version-specific metadata for a language book.

   Omitting version selects the coordinate's configured default."
  ([language]
   (registry-book-info language :default nil))
  ([language key]
   (registry-book-info language key nil))
  ([language key version]
   (let [entry (registry-book-entry language key)]
     (if (nil? entry)
       nil
       (let [selected-version (or version (get entry :default-version))
             info (get-in entry [:versions selected-version])]
         (if info
           (assoc info
                  :language language
                  :key key
                  :version selected-version
                  :default-version (get entry :default-version))
           (throw
            (ex :generic {:language language
                      :key key
                      :version selected-version
                      :available (registry-book-versions language key)} :ex/message "Book version is not registered"))))))))

(defn registry-book-add
  "Adds one immutable version beneath a stable [language key] coordinate."
  ([language version info]
   (registry-book-add language :default version info))
  ([language key version info]
   (if (or (nil? version)
           (not (number? version))
           (<= version 0)
           (nil? (get info :ns))
           (not (fn? (get info :load))))
     (throw
      (ex :argument {:language language
                :key key
                :version version
                :info info} :ex/message "Invalid versioned book registration"))
     (let [coordinate [language key]]
       (swap!
        +book-registry+
        (fn [all]
          (let [entry (or (get all coordinate)
                          {:default-version version
                           :versions {}})]
            (if (get-in entry [:versions version])
              (throw
               (ex :conflict {:language language
                         :key key
                         :version version} :ex/message "Book version is already registered"))
              (let [with-version
                    (assoc-in entry [:versions version] info)
                    complete
                    (if (get with-version :default-version)
                      with-version
                      (assoc with-version :default-version version))]
                (assoc all coordinate complete))))))
       (registry-book-info language key version)))))

(defn registry-book-set-default
  "Changes versionless selection without replacing any installed version."
  ([language version]
   (registry-book-set-default language :default version))
  ([language key version]
   (let [entry (registry-book-entry language key)]
     (cond
       (nil? entry)
       (throw
        (ex :generic {:language language :key key} :ex/message "Book coordinate is not registered"))

       (nil? (get-in entry [:versions version]))
       (throw
        (ex :generic {:language language
                  :key key
                  :version version
                  :available (registry-book-versions language key)} :ex/message "Cannot select an unregistered book version"))

       :else
       (do
         (swap! +book-registry+
                assoc-in
                [[language key] :default-version]
                version)
         version)))))

(defn registry-book-remove
  "Removes one version. Removing the default chooses the lowest remaining version."
  ([language version]
   (registry-book-remove language :default version))
  ([language key version]
   (let [coordinate [language key]
         entry (registry-book-entry language key)
         removed (get-in entry [:versions version])]
     (if (nil? removed)
       (throw
        (ex :generic {:language language
                  :key key
                  :version version
                  :available (registry-book-versions language key)} :ex/message "Cannot remove an unregistered book version"))
       (do
         (swap!
          +book-registry+
          (fn [all]
            (let [current (get all coordinate)
                  remaining (dissoc (get current :versions) version)]
              (if (empty? remaining)
                (dissoc all coordinate)
                (let [next-default
                      (if (= version (get current :default-version))
                        (first (sort (keys remaining)))
                        (get current :default-version))]
                  (assoc all coordinate
                         {:default-version next-default
                          :versions remaining}))))))
         (assoc removed
                :language language
                :key key
                :version version))))))

(defn registry-book-ns
  "Returns the namespace that owns a selected language book."
  ([language]
   (registry-book-ns language :default nil))
  ([language key]
   (registry-book-ns language key nil))
  ([language key version]
   (get (registry-book-info language key version) :ns)))

(defn registry-book
  "Loads a selected versioned language book using Foundation names.

   Versionless calls use :default-version. Explicit calls remain pinned even
   when the configured default later changes."
  ([language]
   (registry-book language :default nil))
  ([language key]
   (registry-book language key nil))
  ([language key requested-version]
   (let [{:keys [ns load version] :as info}
         (registry-book-info language key requested-version)]
     (if (nil? info)
       nil
       (let [value (load)
             actual-version (get value :version)]
         (if (not (ns-loaded? ns))
           (throw
            (ex :dependency {:language language
                      :key key
                      :version version
                      :namespace ns} :ex/message "Registered book loader did not provide its exact namespace"))
           (if (and actual-version
                    (not= actual-version version))
             (throw
              (ex :io {:language language
                        :key key
                        :requested version
                        :loaded actual-version
                        :namespace ns} :ex/message "Registered book version does not match loaded book"))
             value)))))))
