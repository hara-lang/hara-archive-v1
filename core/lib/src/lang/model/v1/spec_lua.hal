(ns lang.model.v1.spec-lua
  (:require [lang.common.book :as book]
            [lang.common.book-meta :as book-meta]
            [lang.common.grammar-api :as grammar-api]
            [lang.model.v1.spec-lua.lua-grammar :as model]))

(def +language+ :lua)
(def +tag+ :lua)
(def +version+ 1)
(def +grammar-version+ model/+grammar-version+)
(def +grammar+ model/+grammar+)

(def +coordinate+
  {:grammar/id +tag+
   :grammar/version +grammar-version+
   :grammar/release "alpha"
   :grammar/facets []})

(def +selection+
  {:coordinate +coordinate+
   :grammar +grammar+
   :rewrite {}
   :rewrite/source {}
   :extensions {}
   :provenance []
   :fingerprint (grammar-api/fingerprint +grammar+)})

(defn select [] +selection+)

(def +meta+ (book-meta/book-meta {}))

(def +book+
  (book/book {:lang +language+
              :meta +meta+
              :parent :xtalk
              :version +version+
              :coordinate +coordinate+
              :grammar +grammar+
              :selection +selection+}))
(def +init+ +book+)
