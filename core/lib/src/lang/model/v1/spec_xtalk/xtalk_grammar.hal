(ns lang.model.v1.spec-xtalk.xtalk-grammar
  (:require [lang.common.emit-helper :as helper]
            [lang.common.grammar :as common]
            [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]))

(def +language+ :xtalk)
(def +tag+ :xtalk)
(def +grammar-version+ common/+version+)

(def +template+
  (grammar/emit-template
   {:template/id +tag+
    :template/version +grammar-version+
    :template/value helper/+default+}))

(def +profile+
  (grammar/profile
   {:profile/id +tag+
    :profile/version +grammar-version+
    :profile/operators common/+features+}))

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "foundation-v1"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/emit-template
    {:template/id +tag+
     :template/version +grammar-version+}
    :grammar/profiles
    [{:profile/id +tag+
      :profile/version +grammar-version+}]}))

