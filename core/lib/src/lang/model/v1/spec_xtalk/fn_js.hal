(ns lang.model.v1.spec-xtalk.fn-js
  (:require [lang.model.v1.spec-js.js-native :as native]))

(def +js-core+
  {
    :x-print {:raw "console.log" :emit :invoke}
    :x-del {:raw "delete" :emit :prefix}
    :x-bit-not {:macro native/js-x-bit-not :emit :macro}
    :x-eval {:raw "eval" :emit :invoke}
    :x-construct {:macro native/js-x-construct :emit :macro}
    :x-len {:macro native/js-x-len :emit :macro}
    :x-cat {:macro native/js-x-cat :emit :macro}
    :x-err {:raw "throw" :emit :prefix}
    :x-ex-native? {:macro native/js-ex-native :emit :macro}
    :x-ex-new {:macro native/js-ex-new :emit :macro}
    :x-ex-message {:macro native/js-ex-message :emit :macro}
    :x-ex-data {:macro native/js-ex-data :emit :macro}
    :x-now-ms {:raw "Date.now" :emit :invoke}
    :x-unpack {:macro native/js-x-unpack :emit :macro}
    :x-random {:raw "Math.random" :emit :invoke}
    :x-apply {:macro native/js-apply :emit :macro}})

(def +js-global+
  {
})

(def +js-custom+
  {
    :x-has-key? {:macro native/js-x-has-key :emit :macro}})

(def +js-math+
  {
    :x-m-abs {:raw "Math.abs" :emit :invoke}
    :x-m-acos {:raw "Math.acos" :emit :invoke}
    :x-m-asin {:raw "Math.asin" :emit :invoke}
    :x-m-atan {:raw "Math.atan" :emit :invoke}
    :x-m-ceil {:raw "Math.ceil" :emit :invoke}
    :x-m-cos {:raw "Math.cos" :emit :invoke}
    :x-m-cosh {:raw "Math.cosh" :emit :invoke}
    :x-m-exp {:raw "Math.exp" :emit :invoke}
    :x-m-floor {:raw "Math.floor" :emit :invoke}
    :x-m-loge {:raw "Math.log" :emit :invoke}
    :x-m-log10 {:raw "Math.log10" :emit :invoke}
    :x-m-max {:raw "Math.max" :emit :invoke}
    :x-m-min {:raw "Math.min" :emit :invoke}
    :x-m-mod {:raw "%" :emit :infix}
    :x-m-pow {:raw "Math.pow" :emit :invoke}
    :x-m-quot {:macro native/js-math-quot :emit :macro}
    :x-m-sin {:raw "Math.sin" :emit :invoke}
    :x-m-sinh {:raw "Math.sinh" :emit :invoke}
    :x-m-sqrt {:raw "Math.sqrt" :emit :invoke}
    :x-m-tan {:raw "Math.tan" :emit :invoke}
    :x-m-tanh {:raw "Math.tanh" :emit :invoke}})

(def +js-type+
  {
    :x-type-native {:macro native/js-type-native :emit :macro}
    :x-to-string {:raw "String" :emit :invoke}
    :x-to-number {:raw "Number" :emit :invoke}
    :x-is-string? {:macro (fn [form] (native/js-typeof-predicate "string" form)) :emit :macro}
    :x-is-number? {:macro (fn [form] (native/js-typeof-predicate "number" form)) :emit :macro}
    :x-is-integer? {:raw "Number.isInteger" :emit :invoke}
    :x-is-boolean? {:macro (fn [form] (native/js-typeof-predicate "boolean" form)) :emit :macro}
    :x-is-function? {:macro (fn [form] (native/js-typeof-predicate "function" form)) :emit :macro}
    :x-is-object? {:macro native/js-is-object :emit :macro}
    :x-is-array? {:raw "Array.isArray" :emit :invoke}})

(def +js-lu+
  {
    :x-lu-create {:default (list (quote new) (quote Map)) :emit :unit}
    :x-lu-get {:macro native/js-x-lu-get :emit :macro}
    :x-lu-set {:macro native/js-x-lu-set :emit :macro}
    :x-lu-del {:macro native/js-x-lu-del :emit :macro}})

(def +js-obj+
  {
    :x-obj-keys {:macro native/js-x-obj-keys :emit :macro}
    :x-obj-clone {:macro native/js-x-obj-clone :emit :macro}})

(def +js-arr+
  {
    :x-arr-clone {:macro native/js-x-arr-clone :emit :macro}
    :x-arr-push {:macro (fn [form] (native/js-x-arr-method (quote push) form)) :emit :macro}
    :x-arr-pop {:macro (fn [form] (native/js-x-arr-method (quote pop) form)) :emit :macro}
    :x-arr-push-first {:macro (fn [form] (native/js-x-arr-method (quote unshift) form)) :emit :macro}
    :x-arr-pop-first {:macro (fn [form] (native/js-x-arr-method (quote shift) form)) :emit :macro}
    :x-arr-remove {:macro (fn [form] (list (quote .) (nth form 1) (list (quote splice) (nth form 2) 1))) :emit :macro}
    :x-arr-insert {:macro (fn [form] (list (quote .) (nth form 1) (list (quote splice) (nth form 2) 0 (nth form 3)))) :emit :macro}})

(def +js-arr-functional+
  {
    :x-arr-map {:macro (fn [form] (native/js-x-arr-method (quote map) form)) :emit :macro}
    :x-arr-foldl {:macro (fn [form] (native/js-x-arr-method (quote reduce) form)) :emit :macro}
    :x-arr-foldr {:macro (fn [form] (native/js-x-arr-method (quote reduceRight) form)) :emit :macro}})

(def +js-str+
  {
    :x-str-comp {:macro native/js-x-str-comp :emit :macro}
    :x-str-char {:macro native/js-x-str-char :emit :macro}
    :x-str-split {:macro native/js-x-str-split :emit :macro}
    :x-str-join {:macro native/js-x-str-join :emit :macro}
    :x-str-index-of {:macro native/js-x-str-index-of :emit :macro}
    :x-str-substring {:macro native/js-x-str-substring :emit :macro}
    :x-str-to-upper {:macro native/js-x-str-to-upper :emit :macro}
    :x-str-to-lower {:macro native/js-x-str-to-lower :emit :macro}
    :x-str-to-fixed {:macro native/js-x-str-to-fixed :emit :macro}
    :x-str-replace {:macro native/js-x-str-replace :emit :macro}
    :x-str-trim {:macro native/js-x-str-trim :emit :macro}
    :x-str-trim-left {:macro native/js-x-str-trim-left :emit :macro}
    :x-str-trim-right {:macro native/js-x-str-trim-right :emit :macro}
    :x-str-pad-left {:macro native/js-x-str-pad-left :emit :macro}
    :x-str-pad-right {:macro native/js-x-str-pad-right :emit :macro}
    :x-str-starts-with {:macro native/js-x-str-starts-with :emit :macro}
    :x-str-ends-with {:macro native/js-x-str-ends-with :emit :macro}
    :x-str-encode {:macro native/js-x-str-encode :emit :macro}
    :x-str-decode {:macro native/js-x-str-decode :emit :macro}})

(def +js-bytes+
  {
    :x-bytes-new {:macro native/js-x-bytes-new :emit :macro}
    :x-bytes-set {:macro native/js-x-bytes-set :emit :macro :op-spec {:allow-blocks true}}
    :x-bytes-copy {:macro native/js-x-bytes-copy :emit :macro}
    :x-bytes-slice {:macro native/js-x-bytes-slice :emit :macro}
    :x-bytes-u8 {:macro native/js-x-bytes-u8 :emit :macro}
    :x-bytes-s8 {:macro native/js-x-bytes-s8 :emit :macro}})

(def +js-js+
  {
    :x-json-encode {:raw "JSON.stringify" :emit :invoke}
    :x-json-decode {:raw "JSON.parse" :emit :invoke}})

(def +js-return+
  {
    :x-return-encode {:macro native/js-return-encode :emit :macro}
    :x-return-wrap {:macro native/js-return-wrap :emit :macro}
    :x-return-eval {:macro native/js-return-eval :emit :macro}})

(def +js-iter+
  {
    :x-iter-from-obj {:macro native/js-x-iter-from-obj :emit :macro}
    :x-iter-from-arr {:macro native/js-x-iter-from-arr :emit :macro}
    :x-iter-from {:macro native/js-x-iter-from :emit :macro}
    :x-iter-eq {:macro native/js-x-iter-eq :emit :macro :op-spec {:allow-blocks true}}
    :x-iter-null {:default (quote ((. [] [Symbol.iterator]))) :emit :unit}
    :x-iter-next {:macro native/js-x-iter-next :emit :macro}
    :x-iter-has? {:macro native/js-x-iter-has :emit :macro}
    :x-iter-native? {:macro native/js-x-iter-native :emit :macro}})

(def +js-promise+
  {
    :x-async-run {:macro native/js-async-run :emit :macro}
    :x-promise {:macro native/js-promise :emit :macro}
    :x-promise-new {:macro native/js-promise-new :emit :macro}
    :x-promise-all {:macro native/js-promise-all :emit :macro}
    :x-promise-then {:macro native/js-promise-then :emit :macro}
    :x-promise-catch {:macro native/js-promise-catch :emit :macro}
    :x-promise-finally {:macro native/js-promise-finally :emit :macro}
    :x-promise-native? {:macro native/js-promise-native :emit :macro}})

(def +js-shell+
  {
    :x-pwd {:macro native/js-x-pwd :emit :macro}
    :x-shell {:macro native/js-x-shell :emit :macro :op-spec {:allow-blocks true}}})

(def +js-file+
  {
    :x-file-resolve {:macro native/js-x-file-resolve :emit :macro}
    :x-file-read {:macro native/js-x-file-read :emit :macro}
    :x-file-write {:macro native/js-x-file-write :emit :macro}})

(def +js+
  (merge +js-core+
         +js-global+
         +js-custom+
         +js-math+
         +js-type+
         +js-lu+
         +js-obj+
         +js-arr+
         +js-arr-functional+
         +js-str+
         +js-bytes+
         +js-js+
         +js-return+
         +js-iter+
         +js-promise+
         +js-shell+
         +js-file+))
