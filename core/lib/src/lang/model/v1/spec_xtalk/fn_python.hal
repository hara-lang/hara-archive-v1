(ns lang.model.v1.spec-xtalk.fn-python
  (:require [lang.model.v1.spec-python.python-native :as native]))

(def +python-core+
  {
    :x-print {:raw "print" :emit :invoke}
    :x-del {:macro native/python-x-del :emit :macro}
    :x-unpack {:macro native/python-x-unpack :emit :macro}
    :x-bit-not {:macro native/python-x-bit-not :emit :macro}
    :x-eval {:macro native/python-x-eval :emit :macro}
    :x-construct {:macro native/python-x-construct :emit :macro}
    :x-len {:raw "len" :emit :invoke}
    :x-cat {:macro native/python-x-cat :emit :macro}
    :x-err {:macro (fn [form] (list (quote throw) (list (quote Exception) (nth form 1)))) :emit :macro}
    :x-ex-native? {:macro native/python-ex-native :emit :macro}
    :x-ex-new {:macro native/python-ex-new :emit :macro}
    :x-ex-message {:macro native/python-ex-message :emit :macro}
    :x-ex-data {:macro native/python-ex-data :emit :macro}
    :x-now-ms {:default (quote (round (* 1000 (. (__import__ "time") (time))))) :emit :unit}
    :x-random {:macro (fn [form] (list (quote .) (list (quote __import__) "random") (list (quote random)))) :emit :macro}})

(def +python-global+
  {
})

(def +python-custom+
  {
    :x-get-key {:macro native/python-get-key :emit :macro}
    :x-set-key {:macro native/python-x-set-key :emit :macro}
    :x-has-key? {:macro native/python-x-has-key :emit :macro}})

(def +python-math+
  {
    :x-m-abs {:raw "abs" :emit :invoke}
    :x-m-acos {:raw "math.acos" :emit :invoke}
    :x-m-asin {:raw "math.asin" :emit :invoke}
    :x-m-atan {:raw "math.atan" :emit :invoke}
    :x-m-ceil {:raw "math.ceil" :emit :invoke}
    :x-m-cos {:raw "math.cos" :emit :invoke}
    :x-m-cosh {:raw "math.cosh" :emit :invoke}
    :x-m-exp {:raw "math.exp" :emit :invoke}
    :x-m-floor {:raw "math.floor" :emit :invoke}
    :x-m-loge {:raw "math.log" :emit :invoke}
    :x-m-log10 {:raw "math.log10" :emit :invoke}
    :x-m-max {:raw "max" :emit :invoke}
    :x-m-min {:raw "min" :emit :invoke}
    :x-m-mod {:raw "%" :emit :infix}
    :x-m-pow {:raw "pow" :emit :invoke}
    :x-m-quot {:raw "//" :emit :infix}
    :x-m-sin {:raw "math.sin" :emit :invoke}
    :x-m-sinh {:raw "math.sinh" :emit :invoke}
    :x-m-sqrt {:raw "math.sqrt" :emit :invoke}
    :x-m-tan {:raw "math.tan" :emit :invoke}
    :x-m-tanh {:raw "math.tanh" :emit :invoke}})

(def +python-type+
  {
    :x-type-native {:macro native/python-type-native :emit :macro}
    :x-to-string {:raw "str" :emit :invoke}
    :x-to-number {:raw "float" :emit :invoke}
    :x-is-string? {:macro (fn [form] (native/python-type-predicate 'str form)) :emit :macro}
    :x-is-number? {:macro (fn [form] (native/python-type-predicate (list 'quote (list 'int 'float)) form)) :emit :macro}
    :x-is-integer? {:macro (fn [form] (native/python-type-predicate (list 'quote (list 'int)) form)) :emit :macro}
    :x-is-boolean? {:macro (fn [form] (native/python-type-predicate 'bool form)) :emit :macro}
    :x-is-function? {:macro (fn [form] (list 'callable (nth form 1))) :emit :macro}
    :x-is-object? {:macro (fn [form] (native/python-type-predicate 'dict form)) :emit :macro}
    :x-is-array? {:macro (fn [form] (native/python-type-predicate 'list form)) :emit :macro}})

(def +python-lu+
  {
    :x-lu-create {:default {} :emit :unit}
    :x-lu-eq {:macro native/python-x-lu-eq :emit :macro}
    :x-lu-get {:macro native/python-x-lu-get :emit :macro}
    :x-lu-set {:macro native/python-x-lu-set :emit :macro}
    :x-lu-del {:macro native/python-x-lu-del :emit :macro}})

(def +python-obj+
  {
    :x-obj-keys {:macro native/python-x-obj-keys :emit :macro}
    :x-obj-clone {:macro native/python-x-obj-clone :emit :macro}})

(def +python-arr+
  {
    :x-arr-clone {:macro native/python-x-arr-clone :emit :macro}
    :x-arr-push {:macro (fn [form] (native/python-x-arr-method (quote append) form)) :emit :macro}
    :x-arr-pop {:macro (fn [form] (native/python-x-arr-method (quote pop) form)) :emit :macro}
    :x-arr-push-first {:macro (fn [form] (list (quote .) (nth form 1) (list (quote insert) 0 (nth form 2)))) :emit :macro}
    :x-arr-pop-first {:macro (fn [form] (list (quote .) (nth form 1) (list (quote pop) 0))) :emit :macro}
    :x-arr-remove {:macro native/python-x-arr-remove :emit :macro}
    :x-arr-insert {:macro native/python-x-arr-insert :emit :macro}})

(def +python-fn+
  {
    :x-apply {:macro native/python-apply :emit :macro}})

(def +python-str+
  {
    :x-str-comp {:macro native/python-x-str-comp :emit :macro}
    :x-str-char {:macro native/python-x-str-char :emit :macro}
    :x-str-split {:macro native/python-x-str-split :emit :macro}
    :x-str-join {:macro native/python-x-str-join :emit :macro}
    :x-str-index-of {:macro native/python-x-str-index-of :emit :macro}
    :x-str-substring {:macro native/python-x-str-substring :emit :macro}
    :x-str-to-upper {:macro native/python-x-str-to-upper :emit :macro}
    :x-str-to-lower {:macro native/python-x-str-to-lower :emit :macro}
    :x-str-to-fixed {:macro native/python-x-str-to-fixed :emit :macro}
    :x-str-replace {:macro native/python-x-str-replace :emit :macro}
    :x-str-trim {:macro native/python-x-str-trim :emit :macro}
    :x-str-trim-left {:macro native/python-x-str-trim-left :emit :macro}
    :x-str-trim-right {:macro native/python-x-str-trim-right :emit :macro}
    :x-str-pad-left {:macro native/python-x-str-pad-left :emit :macro}
    :x-str-pad-right {:macro native/python-x-str-pad-right :emit :macro}
    :x-str-encode {:macro native/python-x-str-encode :emit :macro}
    :x-str-decode {:macro native/python-x-str-decode :emit :macro}})

(def +python-bytes+
  {
    :x-bytes-new {:macro native/python-x-bytes-new :emit :macro}
    :x-bytes-set {:macro native/python-x-bytes-set :emit :macro}
    :x-bytes-copy {:macro native/python-x-bytes-copy :emit :macro}
    :x-bytes-slice {:macro native/python-x-bytes-slice :emit :macro}
    :x-bytes-u8 {:macro native/python-x-bytes-u8 :emit :macro}
    :x-bytes-s8 {:macro native/python-x-bytes-s8 :emit :macro}})

(def +python-js+
  {
    :x-json-encode {:macro native/python-json-encode :emit :macro}
    :x-json-decode {:macro native/python-json-decode :emit :macro}})

(def +python-return+
  {
    :x-return-encode {:macro native/python-return-encode :emit :macro}
    :x-return-wrap {:macro native/python-return-wrap :emit :macro}
    :x-return-eval {:macro native/python-return-eval :emit :macro}})

(def +python-iter+
  {
    :x-iter-from-obj {:macro native/python-x-iter-from-obj :emit :macro}
    :x-iter-from-arr {:macro native/python-x-iter-from-arr :emit :macro}
    :x-iter-from {:macro native/python-x-iter-from :emit :macro}
    :x-iter-eq {:macro native/python-x-iter-eq :emit :macro :op-spec {:allow-blocks true}}
    :x-iter-null {:default (quote (. (__import__ "builtins") (iter []))) :emit :unit}
    :x-iter-next {:macro native/python-x-iter-next :emit :macro}
    :x-iter-has? {:macro native/python-x-iter-has :emit :macro}
    :x-iter-native? {:macro native/python-x-iter-native :emit :macro}})

(def +python-promise+
  {
    :x-async-run {:macro native/python-async-run :emit :macro}})

(def +python-shell+
  {
    :x-pwd {:macro native/python-x-pwd :emit :macro}
    :x-shell {:macro native/python-x-shell :emit :macro :op-spec {:allow-blocks true}}})

(def +python-file+
  {
    :x-file-resolve {:macro native/python-x-file-resolve :emit :macro}
    :x-file-read {:macro native/python-x-file-read :emit :macro}
    :x-file-write {:macro native/python-x-file-write :emit :macro}})

(def +python+
  (merge +python-core+
         +python-global+
         +python-custom+
         +python-math+
         +python-type+
         +python-lu+
         +python-obj+
         +python-arr+
         +python-fn+
         +python-str+
         +python-bytes+
         +python-js+
         +python-return+
         +python-iter+
         +python-promise+
         +python-shell+
         +python-file+))
