(ns lang.model.v1.spec-postgres.postgres-entity-util
  (:config {:blank true})
  (:require [lang.core :as l]
            [std.foundation :refer :all]))

(def +app+ (atom {}))
(def +addons+ (atom {}))
(def ^:dynamic *ns-str* "-")

(defn default-application
  [& args]
  (let [module (first args)]
    (first (get-in (deref l/script-modules)
                   [(or module (ns-current)) :static :application]))))

(defn default-ns-str
  [& args]
  (let [application (first args)]
    (get (deref +app+) (or application (default-application)))))

(defn init-default-ns-str
  [& args]
  (let [application (first args)
        ns-str (second args)
        ns-str (or ns-str (name (ns-current)))
        application (or application (default-application))]
    (if application
      (swap! +app+ assoc application ns-str))))

(defn type-id-v1 []
  {:type :uuid :primary "default" :priority 0
   :sql {:default '(postgres.core/uuid-generate-v1)}})

(defn type-id-v4 []
  {:type :uuid :primary "default" :priority 0
   :sql {:default '(postgres.core/uuid-generate-v4)}})

(defn type-id-text [ns-str]
  {:type :citext :primary "default" :priority 0
   :sql {:process [[(symbol ns-str "as-upper-formatted")]
                   [(symbol ns-str "as-upper-limit-length") 100]]}})

(defn type-name [ns-str & args]
  {:type :citext :required true :scope :-/info :priority (or (first args) 7)
   :sql {:process [[(symbol ns-str "as-upper-formatted")]
                   [(symbol ns-str "as-upper-limit-length") 36]]
         :unique ["name"]}})

(defn type-code [ns-str & args]
  {:type :citext :scope :-/info :priority (or (first args) 7)
   :sql {:process [[(symbol ns-str "as-upper-formatted")]
                   [(symbol ns-str "as-upper-limit-length") 36]]
         :unique ["code"]}})

(defn type-image [ns-str & args]
  {:type :image :priority (or (first args) 10)
   :sql {:process [[(symbol ns-str "as-jsonb")]] :default "{}"}
   :profiles {:web {:type "image"}}})

(defn type-color [ns-str & args]
  {:type :citext :required true :scope :-/info :priority (or (first args) 20)
   :sql {:default (list (symbol ns-str "color-rand"))
         :constraint (list (symbol ns-str "color-check") #{"color"})}
   :profile {:web {:edit #{:create :modify} :type "color"}}})

(defn type-tags [ns-str & args]
  {:type :array :scope :-/info :priority (or (first args) 25)
   :sql {:process [[(symbol ns-str "as-jsonb-array")]] :default "[]"}
   :profile {:web {:edit #{:create :modify} :type "chip"}}})

(defn type-log [ns-str & args]
  {:type :array :required true :priority (or (first args) 90) :scope :-/detail
   :sql {:process [[(symbol ns-str "as-jsonb-array")]] :default "[]"}
   :map {:status {:type :text} :message {:type :text} :error {:type :text}}})

(defn type-log-entry [ns-str & args]
  {:type :map :required true :priority (or (first args) 80) :scope :-/detail
   :sql {:process [[(symbol ns-str "as-jsonb")]] :default "{}"}
   :map {:status {:type :text} :message {:type :text} :error {:type :text}}})

(defn type-detail [ns-str & args]
  {:type :map :required true :priority (or (first args) 50) :scope :-/detail
   :sql {:process [[(symbol ns-str "as-jsonb")]] :default "{}"}})

(defn type-boolean [& args]
  {:type :boolean :required true :priority (second args)
   :sql {:default (not (not (first args)))}})

(defn type-class [ns-str & args]
  {:type :enum :scope :-/hidden :priority (or (first args) 1)
   :enum {:ns (symbol ns-str "EnumClassType")}})

(defn type-ref [ns-str table-str & args]
  {:type :ref :required true :priority (first args)
   :ref {:ns (symbol ns-str table-str)}})

(defn type-class-ref [& args]
  (merge (or (first args) {})
         {:type :uuid :required true :priority (or (second args) 5)}))

(defn normalise-ref [value]
  (cond (and (map? value) (:module value) (:id value))
        (symbol (name (:module value)) (name (:id value)))
        (symbol? value) value
        :else nil))

(defn default-fields [ns-str]
  {:name {:priority 7 :field (type-name ns-str)}
   :code {:priority 8 :field (type-code ns-str)}
   :color {:priority 9 :field (type-color ns-str)}
   :title {:priority 10 :field {:type :text :required true}}
   :description {:priority 11 :field {:type :text}}
   :icon {:priority 20 :field (type-image ns-str)}
   :picture {:priority 21 :field (type-image ns-str)}
   :background {:priority 22 :field (type-image ns-str)}
   :is-active {:priority 30 :field (type-boolean true)}
   :is-public {:priority 31 :field (type-boolean true)}
   :is-draft {:priority 32 :field (type-boolean true)}
   :detail {:priority 51 :field (type-detail ns-str)}
   :tags {:priority 52 :field (type-tags ns-str)}
   :is-official {:priority 80 :field (type-boolean false)}
   :is-onboarded {:priority 81 :field (type-boolean false)}
   :is-archived {:priority 89 :field (type-boolean false)}
   :log {:priority 90 :field (type-log ns-str)}
   :entry {:priority 95 :field (type-log-entry ns-str)}})

(defn init-addons [& args]
  (let [m (first args)
        application (or (second args) (default-application))
        ns-str (default-ns-str application)]
    (if application
      (swap! +addons+ assoc application (merge (or m {}) (default-fields ns-str))))))

(defn get-addon [key]
  (assoc (get-in (deref +addons+) [(default-application) key]) :key key))

(defn add-addon [key field priority]
  (let [application (default-application)]
    (swap! +addons+ assoc-in [application key] {:field field :priority priority})))

(defn addons-remove [key]
  (swap! +addons+ update-in [(default-application)] dissoc key))

(defn get-tracking [track]
  (cond
    (or (= track :track/record) (= track :track/data))
    {:name "data"
     :in {:create {:time-created :time :time-updated :time
                   :op-created :id :op-updated :id}
          :modify {:time-updated :time :op-updated :id}}
     :ignore #{:delete}}
    (= track :track/temp)
    {:name "temp"
     :in {:create {:time-created :time :time-updated :time}
          :modify {:time-updated :time}}
     :ignore #{:delete}}
    (= track :track/log)
    {:name "log" :in {:create {:op-created :id :time-created :time}}
     :disable #{:modify} :ignore #{:delete}}
    :else {}))

(defn get-tracking-columns [track]
  (cond
    (= track :track/record) [:op-created {:type :uuid}
                   :op-updated {:type :uuid}
                   :time-created {:type :time}
                   :time-updated {:type :time}
                   :__deleted__ {:type :boolean :scope :-/hidden
                                  :sql {:default false}}]
    (= track :track/data) [:op-created {:type :uuid}
                 :op-updated {:type :uuid}
                 :time-created {:type :time}
                 :time-updated {:type :time}]
    (= track :track/log) [:op-created {:type :uuid} :time-created {:type :time}]
    (= track :track/temp) [:time-created {:type :time} :time-updated {:type :time}]
    :else []))

(defn get-access [access]
  (if (not= access :none)
    {:sb/rls true
     :sb/access {:admin :all
                 :auth (if (= access :access/hidden) :none :select)
                 :anon (if (or (= access :access/hidden)
                               (= access :access/system))
                         :none
                         :select)}}))

(defn fill-priority [arr priority]
  (nth
   (reduce (fn [state value]
             (let [index (first state)
                   out (second state)]
               (if (map? value)
                 [(inc index)
                  (conj out (assoc value :priority priority :priority-index index))]
                 [index (conj out value)])))
           [0 []]
           arr)
   1))
