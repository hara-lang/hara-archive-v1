(ns lang.model.v1.spec-postgres.deftype.emit-index
  (:require
            [lang.model.v1.spec-postgres.deftype.common :as common]
            [lang.model.v1.spec-postgres.deftype.emit-column :as column]))

(def identifier-value common/identifier-value)
(def quote-identifier common/quote-identifier)
(def qualified-token common/qualified-token)
(def emit-expression column/emit-expression)
(def column-token column/column-token)

(defn index-statement
  [table-token columns options grammar context]
  (let [index-name (:name options)
        using (:using options)
        where (:where options)]
    (str "CREATE INDEX"
         (if index-name
           (str " " (quote-identifier index-name))
           "")
         " ON " table-token
         (if using (str " USING " (str/upper (name using))) "")
         " (" (str/join ", " columns) ")"
         (if where
           (str " WHERE " (emit-expression where grammar context))
           "")
         ";")))

(defn index-plan
  [columns]
  (reduce
   (fn [plan pair]
     (let [column (first pair)
           attributes (second pair)
           index-value (get-in attributes [:sql :index])]
       (if index-value
         (let [options (if (map? index-value) index-value {})
               descriptor {:column (column-token column attributes)
                           :options options}
               group (:group options)]
           (if group
             (update-in plan [:groups group]
                        (fn [entries]
                          (conj (vec (or entries [])) descriptor)))
             (update plan :single conj descriptor)))
         plan)))
   {:single [] :groups {}}
   columns))

(defn grouped-index-output
  [table-token group descriptors grammar context]
  (let [first-options (:options (first descriptors))
        normalized-options (dissoc first-options :group)
        _ (reduce
           (fn [_ descriptor]
             (let [candidate (dissoc (:options descriptor) :group)]
               (if (not (= normalized-options candidate))
                 (throw
                  (ex :hara/database (assoc {:group group
                    :options normalized-options
                    :candidate candidate} :ex/message "Grouped PostgreSQL index options must match")))
                 nil)))
           nil
           descriptors)]
    (index-statement table-token
                     (map :column descriptors)
                     normalized-options
                     grammar context)))

(defn index-outputs
  [table-token table columns grammar context]
  (let [plan (index-plan columns)
        single
        (map (fn [descriptor]
               (index-statement table-token
                                [(:column descriptor)]
                                (:options descriptor)
                                grammar context))
             (:single plan))
        grouped
        (map (fn [entry]
               (grouped-index-output table-token
                                     (first entry)
                                     (second entry)
                                     grammar context))
             (sort-by (fn [entry] (str (first entry)))
                      (:groups plan)))]
    (vec (concat single grouped))))

(defn table-comment-output
  [table-token doc]
  (if (and doc (not (str/blank? doc)))
    (str "COMMENT ON TABLE " table-token " IS "
         (str "'" (str/replace doc "'" "''") "'")
         ";")
    nil))

(defn column-comment-outputs
  [table-token columns]
  (vec
   (keep (fn [pair]
           (let [column (first pair)
                 attributes (second pair)
                 doc (get-in attributes [:sql :comment])]
             (if doc
               (str "COMMENT ON COLUMN " table-token "."
                    (column-token column attributes)
                    " IS '" (str/replace doc "'" "''") "';")
               nil)))
         columns)))

(defn default-partition-output
  [table-token table params]
  (let [partition (:partition-by params)
        default-partition (if (map? partition) (:default partition) nil)]
    (if default-partition
      (let [schema (:in default-partition)
            suffix (or (:name default-partition) "$DEFAULT")
            partition-name (str (identifier-value table) "__" suffix)]
        (str (if (:unlogged params) "CREATE UNLOGGED TABLE " "CREATE TABLE ")
             "IF NOT EXISTS " (qualified-token schema partition-name)
             " PARTITION OF " table-token " DEFAULT;"))
      nil)))

