(ns lang.model.v1.spec-postgres.postgres-enum
  (:require
            [lang.common.compat :as compat]
            [lang.common.grammar-spec :as grammar-spec]
            [lang.model.v1.spec-postgres.deftype.common :as table]))

(defn enum-metadata
  [symbol definition-metadata]
  (merge (or (meta symbol) {})
         definition-metadata
         {:static/dbtype :enum}))

(defn pg-enum-format
  "Formats a PostgreSQL enum declaration and preserves documentation metadata."
  [form]
  (let [formatted (grammar-spec/format-defn form)
        definition-metadata (first formatted)
        normalized (second formatted)
        op (first normalized)
        symbol (second normalized)
        body (vec (drop 2 normalized))
        _ (if (not (= 1 (count body)))
            (throw (ex :database {:form form
                             :body body} :ex/message "PostgreSQL enum requires one value expression")))
        metadata (enum-metadata symbol definition-metadata)
        next-symbol (IObjType/with-meta symbol metadata)]
    [metadata
     (list op next-symbol (first body))]))

(defn pg-enum-hydrate
  "Hydrates the schema coordinate without evaluating host expressions."
  [form grammar context]
  (let [op (first form)
        symbol (second form)
        values (nth form 2)
        static (table/module-static (:module context))
        metadata (merge (or (meta symbol) {})
                        static
                        {:static/dbtype :enum})
        next-symbol (IObjType/with-meta symbol metadata)]
    [(select-keys metadata
                  [:static/dbtype :static/schema :static/application])
     (list op next-symbol values)]))

(defn enum-literal
  [value]
  (cond (keyword? value) (name value)
        (symbol? value) (name value)
        (string? value) value
        :else (str value)))

(defn resolve-values
  "Resolves concrete enum values. Historical !:eval forms require an explicit,
   deterministic literal evaluator capability."
  [values context]
  (if (and (list? values) (= '!:eval (first values)))
    (let [evaluator (or (compat/read-key context :lang/eval-literal)
                        (:eval-literal context))]
      (if evaluator
        (let [resolved (evaluator (second values))]
          (if (sequential? resolved)
            (vec resolved)
            (throw (ex :database {:value resolved
                             :form values} :ex/message "PostgreSQL enum evaluator returned a non-sequence"))))
        (throw (ex :database {:form values} :ex/message "PostgreSQL enum !:eval requires :lang/eval-literal"))))
    (if (sequential? values)
      (vec values)
      (throw (ex :database {:values values} :ex/message "PostgreSQL enum values must be sequential")))))

(defn quote-enum-value
  [value]
  (str "'" (str/replace (enum-literal value) "'" "''") "'"))

(defn pg-enum
  "Emits a deterministic, loadable PostgreSQL enum declaration."
  [form grammar context]
  (let [symbol (second form)
        values (resolve-values (nth form 2) context)
        metadata (or (meta symbol) {})
        type-token (table/qualified-token (:static/schema metadata) symbol)
        values-output (str/join ", " (map quote-enum-value values))]
    (if (:existing metadata)
      ""
      (str "DO $$\n"
           "BEGIN\n"
           "  CREATE TYPE " type-token " AS ENUM (" values-output ");\n"
           "EXCEPTION\n"
           "  WHEN OTHERS THEN\n"
           "    NULL;\n"
           "END;\n"
           "$$ LANGUAGE plpgsql;"))))
