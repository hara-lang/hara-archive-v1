(ns lang.model.v1.spec-postgres.postgres-const
  (:require
            [lang.common.compat :as compat]
            [postgres.core.impl-base :as base]
            [postgres.core.impl-insert :as insert]
            [lang.common.emit :as emit]
            [lang.common.grammar-spec :as grammar-spec]
            [lang.model.v1.spec-postgres.postgres-emit-util :as pg-util]
            [lang.model.v1.spec-postgres.postgres-deftype :as deftype]
            [lang.model.v1.spec-postgres.deftype.common :as table]))

(defn const-metadata
  [symbol definition-metadata]
  (merge (or (meta symbol) {})
         definition-metadata
         {:static/dbtype :const}))

(defn pg-const-format
  "Formats a PostgreSQL table-backed constant declaration."
  [form]
  (let [formatted (grammar-spec/format-defn form)
        definition-metadata (first formatted)
        normalized (second formatted)
        op (first normalized)
        symbol (second normalized)
        body (vec (drop 2 normalized))
        _ (if (not (= 2 (count body)))
            (throw (ex :syntax {:form form :body body} :ex/message "PostgreSQL defconst requires one table binding and one data value")))
        binding-form (first body)
        data (second body)
        _ (if (or (not (vector? binding-form))
                  (not (= 1 (count binding-form))))
            (throw (ex :syntax {:form form :binding binding-form} :ex/message "PostgreSQL defconst requires exactly one table binding")))
        metadata (const-metadata symbol definition-metadata)
        next-symbol (IObjType/with-meta symbol metadata)]
    [metadata
     (list op next-symbol binding-form data)]))

(defn- materialized-table
  [target grammar context]
  (let [link (table/target-link target context)
        entry (if link (table/linked-entry context link) nil)
        form (if entry (table/linked-entry-form entry) nil)]
    (if (or (nil? entry) (nil? form) (not (= 'deftype (first form))))
      (throw (ex :database {:target target :link link} :ex/message "Portable PostgreSQL defconst table is unresolved"))
      (let [formatted (deftype/pg-deftype-format form)
            hydrated (deftype/pg-deftype-hydrate
                      (second formatted) grammar context)
            hydrated-form (second hydrated)
            table-symbol (second hydrated-form)
            columns (deftype/column-pairs (nth hydrated-form 2))
            table-schema
            (loop [index 0
                   remaining columns
                   output {}]
              (if (= 0 (count remaining))
                output
                (let [pair (first remaining)]
                  (recur (+ index 1)
                         (vec (rest remaining))
                         (assoc output
                                (first pair)
                                (assoc (second pair) :order index))))))
            metadata (or (meta table-symbol) {})
            prepared-entry
            (merge entry metadata
                   {:id (:id entry)
                    :module (:module entry)
                    :section :code
                    :lang :postgres
                    :table-schema table-schema})]
        {:link link
         :entry prepared-entry
         :schema table-schema
         :coordinate {:schema (:static/schema metadata)
                      :table (:id entry)}
         :metadata metadata}))))

(defn- tracker-config
  [table-metadata]
  (or (:static/tracker table-metadata)
      (:tracker table-metadata)
      (:track table-metadata)))

(defn- tracker-map
  [tracker key]
  (or (get-in tracker [:in key])
      (get tracker key)
      {}))

(defn- tracker-fields
  [tracker]
  {:create (tracker-map tracker :create)
   :modify (tracker-map tracker :modify)})

(defn- ensure-tracker-columns
  [table-schema fields]
  (reduce
   (fn [_ field]
     (if (nil? (get table-schema field))
       (throw (ex :not-found {:field field
                        :available (keys table-schema)} :ex/message "PostgreSQL tracker field is missing from the target table"))
       nil))
   nil
   (concat (keys (:create fields))
           (keys (:modify fields))))
  fields)

(defn- tracker-value
  [key]
  (list :->> 'o-track (table/snake-name key)))

(defn- resolve-data
  [data context]
  (if (and (list? data) (= '!:eval (first data)))
    (let [evaluator (or (compat/read-key context :lang/eval-literal)
                        (:eval-literal context))]
      (if evaluator
        (evaluator (second data))
        (throw (ex :database {:form data} :ex/message "PostgreSQL defconst !:eval requires :lang/eval-literal"))))
    data))

(defn- symbolic-data
  [table-schema source]
  (reduce
   (fn [output key]
     (let [attributes (get table-schema key)]
       (if (or (:ignore attributes)
               (nil? (:order attributes)))
         output
         (assoc output key (base/t-sym-fn table-schema key source)))))
   {}
   (keys table-schema)))

(defn- normalized-data
  [table-schema data]
  (cond (map? data) data
        (symbol? data) (symbolic-data table-schema data)
        :else
        (throw (ex :database {:data data} :ex/message "Portable PostgreSQL defconst requires map or symbol data"))))

(defn- tracked-data
  [data fields]
  (if (not (map? data))
    (throw (ex :database {:data data} :ex/message "Tracked PostgreSQL constants require map data"))
    (reduce
     (fn [output pair]
       (assoc output (first pair) (tracker-value (second pair))))
     data
     (concat (:create fields) (:modify fields)))))

(defn- const-entry
  [target context]
  (let [link (table/target-link target context)
        entry (if link (table/linked-entry context link) nil)
        form (if entry (table/linked-entry-form entry) nil)]
    (if (and entry form (= 'defconst (first form)))
      {:link link :entry entry :form form}
      nil)))

(defn- const-table-and-data
  [target grammar context]
  (let [resolved (const-entry target context)]
    (if (nil? resolved)
      (throw (ex :database {:target target} :ex/message "Linked PostgreSQL tracker constant is unresolved"))
      (let [form (:form resolved)
            formatted (pg-const-format form)
            normalized (second formatted)
            binding-form (nth normalized 2)
            data (resolve-data (nth normalized 3) context)
            table-result (materialized-table (first binding-form)
                                             grammar context)]
        {:link (:link resolved)
         :entry (:entry resolved)
         :table table-result
         :data data}))))

(defn- column-name
  [table-schema key]
  (table/quote-identifier (base/t-key-fn table-schema key)))

(defn- ordered-keys
  [table-schema values]
  (vec
   (sort-by
    (fn [key] (get-in table-schema [key :order]))
    (filter (fn [key]
              (let [attributes (get table-schema key)]
                (and attributes
                     (not (:ignore attributes))
                     (has? values key))))
            (keys table-schema)))))

(defn- primary-keys
  [table-schema]
  (vec
   (sort-by
    (fn [key] (get-in table-schema [key :order]))
    (filter (fn [key]
              (:primary (get table-schema key)))
            (keys table-schema)))))

(defn- type-token
  [attributes]
  (cond
    (= :enum (:type attributes))
    (let [resolved (:enum/resolved attributes)]
      (table/qualified-token (:schema resolved) (:id resolved)))

    (= :ref (:type attributes))
    (table/pg-type-output
     (or (get-in attributes [:ref/resolved :type])
         (get-in attributes [:ref :type])
         :uuid))

    :else
    (table/pg-type-output (table/pg-type-alias (:type attributes)))))

(defn- literal-form
  [attributes value]
  (cond
    (and (= :enum (:type attributes))
         (or (keyword? value) (symbol? value)))
    (pg-util/pg-string (name value))

    (and (= :enum (:type attributes)) (string? value))
    (pg-util/pg-string value)

    :else nil))

(defn- value-output
  [table-schema key value grammar context]
  (let [attributes (get table-schema key)
        literal (literal-form attributes value)
        emitted (or literal (emit/*emit-fn* value grammar context))]
    (str "(" emitted ")::" (type-token attributes))))

(defn- upsert-sql
  [coordinate table-schema data exclude-update grammar context]
  (let [insert-keys (ordered-keys table-schema data)
        primary (primary-keys table-schema)
        _ (if (= 0 (count primary))
            (throw (ex :database {:table coordinate} :ex/message "PostgreSQL defconst target requires a primary key")))
        update-keys
        (vec
         (filter
          (fn [key]
            (and (not (:primary (get table-schema key)))
                 (not (has? exclude-update key))))
          insert-keys))
        table-token (table/qualified-token (:schema coordinate)
                                           (:table coordinate))
        columns-output (str/join ", "
                                    (map (fn [key]
                                           (column-name table-schema key))
                                         insert-keys))
        values-output (str/join ", "
                                   (map (fn [key]
                                          (value-output table-schema key
                                                        (get data key)
                                                        grammar context))
                                        insert-keys))
        conflict-output (str/join ", "
                                     (map (fn [key]
                                            (column-name table-schema key))
                                          primary))
        update-output
        (str/join
         ",\n    "
         (map (fn [key]
                (let [column (column-name table-schema key)]
                  (str column " = EXCLUDED." column)))
              update-keys))]
    (str "INSERT INTO " table-token " (" columns-output ")\n"
         "VALUES (" values-output ")\n"
         "ON CONFLICT (" conflict-output ")\n"
         (if (= 0 (count update-keys))
           "DO NOTHING"
           (str "DO UPDATE SET\n    " update-output)))))

(defn- direct-track-source
  [value grammar context]
  (emit/*emit-fn* value grammar context))

(defn- linked-track-source
  [target grammar context]
  (let [resolved (const-table-and-data target grammar context)
        table-result (:table resolved)
        table-schema (:schema table-result)
        coordinate (:coordinate table-result)
        data (:data resolved)
        primary (primary-keys table-schema)
        _ (if (not (map? data))
            (throw (ex :database {:target target :data data} :ex/message "Linked tracker constants require map data")))
        _ (if (reduce (fn [missing key]
                        (or missing (not (has? data key))))
                      false primary)
            (throw (ex :database {:target target
                             :primary primary
                             :data data} :ex/message "Linked tracker constant lacks a primary value")))
        predicates
        (map (fn [key]
               (str "t." (column-name table-schema key)
                    " = "
                    (value-output table-schema key (get data key)
                                  grammar context)))
             primary)]
    (str "(SELECT to_jsonb(t) FROM "
         (table/qualified-token (:schema coordinate) (:table coordinate))
         " AS t WHERE "
         (str/join " AND " predicates)
         " LIMIT 1)")))

(defn- track-source
  [track grammar context]
  (if (symbol? track)
    (linked-track-source track grammar context)
    (direct-track-source track grammar context)))

(defn- block-output
  [sql track grammar context]
  (if (nil? track)
    (str "DO $$\n"
         "BEGIN\n"
         "  " (str/replace sql "\n" "\n  ") ";\n"
         "END;\n"
         "$$ LANGUAGE plpgsql;")
    (str "DO $$\n"
         "DECLARE\n"
         "  o_track JSONB;\n"
         "BEGIN\n"
         "  o_track := " (track-source track grammar context) ";\n"
         "  " (str/replace sql "\n" "\n  ") ";\n"
         "END;\n"
         "$$ LANGUAGE plpgsql;")))

(defn pg-const-hydrate
  "Resolves the target table, validates tracker requirements, builds the
   canonical portable DML upsert AST, and returns pure compiler metadata."
  [form grammar context]
  (let [op (first form)
        symbol (second form)
        binding-form (nth form 2)
        raw-data (nth form 3)
        resolved-data (resolve-data raw-data context)
        track (:track (meta symbol))
        table-result (materialized-table (first binding-form) grammar context)
        table-schema (:schema table-result)
        tracker (tracker-config (:metadata table-result))
        _ (if (and tracker (nil? track))
            (throw (ex :database {:symbol symbol
                             :table (:coordinate table-result)} :ex/message "PostgreSQL defconst target requires :track metadata")))
        fields (if tracker
                 (ensure-tracker-columns table-schema (tracker-fields tracker))
                 {:create {} :modify {}})
        base-data (normalized-data table-schema resolved-data)
        effective-data (if tracker (tracked-data base-data fields) base-data)
        exclude-update (set (keys (:create fields)))
        prepared [(:entry table-result) table-schema context]
        upsert-form
        (insert/t-upsert-raw prepared effective-data
                             {:as :raw
                              :exclude-update exclude-update})
        table-link (select-keys (:entry table-result)
                                [:id :module :section :lang])
        metadata
        (merge (or (meta symbol) {})
               (table/module-static (:module context))
               {:static/dbtype :const
                :static/table table-link
                :static/table-coordinate (:coordinate table-result)
                :static/table-schema table-schema
                :static/form upsert-form
                :static/data effective-data
                :static/tracker tracker
                :static/tracker-fields fields
                :static/exclude-update exclude-update})
        track-entry (if (symbol? track)
                      (const-entry track context)
                      nil)
        _ (if (and (symbol? track) (nil? track-entry))
            (throw (ex :database {:track track :symbol symbol} :ex/message "Linked PostgreSQL tracker constant is unresolved")))
        metadata (if track-entry
                   (assoc metadata :static/track
                          (assoc (select-keys (:entry track-entry)
                                              [:id :module :section])
                                 :lang :postgres))
                   metadata)
        next-symbol (IObjType/with-meta symbol metadata)
        hydration
        (select-keys metadata
                     [:static/dbtype
                      :static/schema
                      :static/application
                      :static/table
                      :static/table-coordinate
                      :static/table-schema
                      :static/form
                      :static/data
                      :static/track
                      :static/tracker
                      :static/tracker-fields
                      :static/exclude-update])]
    [hydration
     (list op next-symbol binding-form resolved-data track)]))

(defn pg-const
  "Emits a deterministic table-backed PostgreSQL upsert block."
  [form grammar context]
  (let [symbol (second form)
        metadata (or (meta symbol) {})
        coordinate (:static/table-coordinate metadata)
        table-schema (:static/table-schema metadata)
        raw-data (nth form 3)
        base-data (normalized-data table-schema raw-data)
        fields (:static/tracker-fields metadata)
        tracker (:static/tracker metadata)
        data (if tracker (tracked-data base-data fields) base-data)
        exclude-update (:static/exclude-update metadata)
        track (if (> (count form) 4) (nth form 4) nil)
        sql (upsert-sql coordinate table-schema data
                        exclude-update grammar context)]
    (if (:existing metadata)
      ""
      (block-output sql track grammar context))))

