(ns lang.core
  (:require [lang.common.book-entry :as entry]
            [lang.common.book-meta :as meta]
            [lang.common.grammar :as grammar]
            [lang.common.preprocess-input :as input]
            [lang.common.preprocess-resolve :as resolve]
            [lang.common.preprocess-staging :as staging]
            [lang.common.preprocess-value :as value]
            [lang.core.registry :as registry]
            [lang.core.script :as script]
            [lang.core.script-annex :as script-annex]
            [lang.core.script-fragment]
            [lang.core.runtime :as runtime]
            [lang.model.v1.spec-postgres]
            [lang.runtime.basic :as basic]
            [std.lib.context.definition :as definition]))

(def book-entry entry/book-entry)
(def book-entry? entry/book-entry?)
(def book-meta meta/book-meta)
(def book-meta? meta/book-meta?)
(def grammar grammar/grammar)
(def grammar-build grammar/build)
(def grammar-to-reserved grammar/to-reserved)
(def to-input input/to-input)
(def to-input-form input/to-input-form)
(def to-resolve staging/to-resolve)
(def to-staging staging/to-staging)
(def get-fragment resolve/get-fragment)
(def value-standalone value/value-standalone)
(def host-name name)

(defn rt:stop [] (script/stop))

(defn annex:start
  ([tag] (script-annex/start-tag tag))
  ([tag namespace] (script-annex/start-tag-in namespace tag)))

(defn annex:get
  ([tag] (script-annex/get-runtime tag))
  ([tag namespace] (script-annex/runtime-in namespace tag)))

(defn annex:stop
  ([tag] (script-annex/stop-tag tag))
  ([tag namespace] (script-annex/stop-tag-in namespace tag)))

(defn annex:start-all
  ([] (script-annex/start-all))
  ([namespace] (script-annex/start-all-in namespace)))

(defn annex:stop-all
  ([] (script-annex/stop-all))
  ([namespace] (script-annex/stop-all-in namespace)))

(defn annex:restart-all
  ([] (script-annex/restart-all))
  ([namespace] (script-annex/restart-all-in namespace)))

(defn annex:list
  ([] (script-annex/status))
  ([namespace] (script-annex/status-in namespace)))

(def script-modules script/+modules+)

;; Foundation-compatible runtime/bootstrap entry points.
(def bootstrap runtime/bootstrap)
(def install-lang runtime/install-lang)
(def select-lang-version runtime/select-lang-version)
(def install-type runtime/install-type)
(def rt-create runtime/rt-create)
(def rt-start runtime/rt-start)
(def rt-stop runtime/rt-stop)
(def rt-raw-eval runtime/rt-raw-eval)
(def runtime-spec runtime/runtime-spec)

;; Foundation book coordinates with explicit and configurable version selection.
(def registry-book registry/registry-book)
(def registry-book-info registry/registry-book-info)
(def registry-book-versions registry/registry-book-versions)
(def registry-book-default-version registry/registry-book-default-version)
(def registry-book-add registry/registry-book-add)
(def registry-book-remove registry/registry-book-remove)
(def registry-book-set-default registry/registry-book-set-default)

(def rt-default runtime/rt-default)
(def rt-default:create runtime/rt-default:create)
(def rt-basic basic/rt-basic)
(def rt-basic:create basic/rt-basic:create)
(def rt-oneshot basic/rt-oneshot)
(def rt-oneshot:create basic/rt-oneshot:create)

;; Loading lang.core installs each language's configured default book and the
;; first local runtimes. No target process is started during bootstrap.
(def +bootstrap+ (bootstrap))

(defn code-pointer
  "Creates the portable language pointer rooted in a script definition Var."
  [context fields]
  (std.foundation/pointer (assoc fields :context context)))

(defn code-pointer?
  "Returns true when value is a lang.core code pointer."
  [value]
  (pointer? value))

(defn code-pointer-context
  "Returns the language context carried by pointer."
  [pointer]
  (IPointer/ptr-context pointer))

(defn code-pointer-val
  "Returns one coordinate or source field carried by pointer."
  [pointer key]
  (get pointer key))

(defn code-pointer-runtime
  "Resolves pointer against the latest live runtime for its script coordinate."
  [pointer]
  (let [module (code-pointer-val pointer :module)
        lang (code-pointer-val pointer :lang)]
    (get-in (deref script/+scripts+) [[module lang] :runtime])))

(defn code-pointer-invoke-in
  "Compiles and invokes pointer through an explicit or currently live runtime."
  [pointer selected-runtime args]
  (let [module (code-pointer-val pointer :module)
        lang (code-pointer-val pointer :lang)
        id (code-pointer-val pointer :id)
        instance (or selected-runtime (code-pointer-runtime pointer))]
    (if (nil? instance)
      (throw
       (ex :dependency {:lang lang
                 :module module
                 :id id} :ex/message "Script pointer runtime is not started"))
      (let [qualified (symbol (name module) (name id))
            form (apply list qualified args)
            source (script/compile-form lang module form)
            response (runtime/rt-raw-eval instance source)]
        (if (and (map? response) (has? response :value))
          (:value response)
          response)))))

(defn script-context
  "Returns the Foundation language-context key used by script pointers."
  [lang]
  (keyword "lang" (name lang)))

(defn script-definition-symbol
  "Returns the declaration symbol accepted by Foundation top-level macros."
  [value]
  (cond (symbol? value) value
        (vector? value) (first (filter symbol? value))
        :else nil))

(defn script-module-default
  "Creates the minimal module shell retained by Foundation macro registration."
  [lang module]
  {:id module
   :lang (or lang :xtalk)
   :require []
   :link {'- module}
   :code {}
   :fragment {}})

(defn script-module-value
  [lang module]
  (or (get (deref script/+modules+) module)
      (script-module-default lang module)))

(defn register-module-entry
  [lang module section id entry]
  (swap! script/+modules+
         (fn [modules]
           (let [current
                 (or (get modules module)
                     (script-module-default lang module))]
             (assoc modules module
                    (assoc-in current [section id] entry)))))
  entry)

(defn register-language-code
  "Registers one grammar-derived top-level definition in the active module."
  [explicit-language form]
  (let [module (script/current-module-id)
        module-value (script-module-value explicit-language module)
        raw-symbol (second form)
        declaration-symbol (script-definition-symbol raw-symbol)
        _
        (if (nil? declaration-symbol)
          (throw
           (ex :dependency {:module module
                     :declaration raw-symbol
                     :form form} :ex/message "Script definition requires a declaration symbol")))
        id (symbol (name declaration-symbol))
        op (first form)
        metadata (merge (or (meta raw-symbol) {})
                        (or (meta declaration-symbol) {}))
        language (or explicit-language (:lang module-value) :xtalk)
        schema (or (:static/schema metadata)
                   (:schema metadata)
                   (:schema module-value)
                   (first (get-in module-value [:static :all :schema])))
        entry
        (merge metadata
               {:id id
                :module module
                :lang language
                :section :code
                :op op
                :op-key (keyword (name op))
                :form form
                :form-input form})
        entry (if schema
                (assoc (dissoc entry :schema)
                       :static/schema
                       (script/portable-schema-form schema))
                entry)
        entry (if (has? metadata :public)
                (assoc entry :static/public (:public metadata))
                entry)]
    (register-module-entry language module :code id entry)))

(defn register-code-pointer
  "Registers one code entry and interns its source symbol as a language pointer."
  ([form]
   (register-code-pointer nil form))
  ([explicit-language form]
   (let [entry (register-language-code explicit-language form)
         module (:module entry)
         source (symbol (str (ns-current)))
         declaration-symbol (script-definition-symbol (second form))
         id (:id entry)
         context-key (script-context (:lang entry))
         qualified (symbol (name source) (name id))
         pointer
         (code-pointer
          context-key
          (assoc entry
                 :namespace source
                 :symbol qualified
                 :context context-key))]
     pointer)))

(defn register-fragment-pointer
  "Registers one def$.<tag> fragment and interns its language pointer Var."
  [explicit-language declaration-symbol value metadata]
  (let [module (script/current-module-id)
        module-value (script-module-value explicit-language module)
        source (symbol (str (ns-current)))
        id (symbol (name declaration-symbol))
        qualified-module (symbol (name module) (name id))
        return-value
        (or (:static/return metadata)
            (get metadata :-))
        language (or explicit-language (:lang module-value) :xtalk)
        entry
        (merge (or metadata {})
               {:id id
                :symbol qualified-module
                :module module
                :lang language
                :section :fragment
                :op 'def$
                :op-key :def$
                :form value
                :form-input value
                :template nil}
               (if (nil? return-value)
                 {}
                 {:static/return return-value}))
        _ (register-module-entry
           language module :fragment id entry)
        context-key (script-context language)
        qualified-source (symbol (name source) (name id))
        pointer
        (code-pointer
         context-key
         (assoc entry
                :namespace source
                :symbol qualified-source
                :context context-key))]
    pointer))

(defn register-macro-fragment
  "Registers one Foundation defmacro.<tag> fragment for its exact language."
  [explicit-language form template]
  (let [module (script/current-module-id)
        module-value (script-module-value explicit-language module)
        raw-symbol (second form)
        declaration-symbol (script-definition-symbol raw-symbol)
        _
        (if (nil? declaration-symbol)
          (throw
           (ex :dependency {:module module
                     :declaration raw-symbol
                     :form form} :ex/message "Script macro requires a declaration symbol")))
        id (symbol (name declaration-symbol))
        metadata (merge (or (meta raw-symbol) {})
                        (or (meta declaration-symbol) {}))
        language (or explicit-language (:lang module-value) :xtalk)
        entry
        (merge metadata
               {:id id
                :module module
                :lang language
                :section :fragment
                :op 'defmacro
                :op-key :defmacro
                :form form
                :form-input form
                :template template
                :standalone (:standalone metadata)})]
    (register-module-entry language module :fragment id entry)
    nil))

(defn script-quote-macro-expansion
  [forms]
  (list 'list
        (list 'quote 'quote)
        (apply list 'do forms)))

(defn script-runtime-macro-body
  [body]
  (let [[prefix declarations]
        (loop [prefix [] declarations (vec body)]
          (if (or (string? (first declarations))
                  (map? (first declarations)))
            (recur (conj prefix (first declarations))
                   (vec (rest declarations)))
            [prefix declarations]))
        transformed
        (if (vector? (first declarations))
          [(first declarations)
           (script-quote-macro-expansion (vec (rest declarations)))]
          (map (fn [clause]
                 (list (first clause)
                       (script-quote-macro-expansion
                        (vec (rest clause)))))
               declarations))]
    (vec (concat prefix transformed))))

(defn script-defmacro-expansion
  "Defines a namespace macro and registers its target-language fragment."
  [lang declaration-symbol body namespace-symbol]
  (let [form (apply list 'defmacro declaration-symbol body)
        runtime-form
        (apply list 'defmacro declaration-symbol
               (script-runtime-macro-body body))
        qualified
        (symbol (str namespace-symbol) (name declaration-symbol))]
    `(do
       ~runtime-form
       (lang.core/register-macro-fragment
        ~lang
        '~form
        (fn [& args]
          (let [expanded (macroexpand-1
                          (apply list '~qualified args))]
            (if (and (list? expanded)
                     (= 'quote (first expanded)))
              (second expanded)
              expanded)))))))

(defn start-script
  "Creates, starts, records, and returns the runtime for one script coordinate."
  [lang module config]
  (let [coordinate [module lang]
        current (get (deref script/+scripts+) coordinate)
        previous (:runtime current)
        _ (if previous (runtime/rt-stop previous))
        runtime-type (or (:runtime config) :default)
        runtime-options (assoc config :module module)
        instance (runtime/rt-create lang runtime-type runtime-options)
        started (runtime/rt-start instance)
        started
        (if (= lang :postgres)
          (reduce
           (fn [current spec]
             (if (script/require-primary? spec)
               (IContextLifeCycle/setup-module current (first spec))
               current))
           started
           (or (:require config) []))
          started)
        record (script/register-script lang module config)
        record (assoc record :runtime started)]
    (swap! script/+scripts+ assoc coordinate record)
    started))

(defn restart-script
  "Restarts every script declared by the current source namespace."
  []
  (let [source (symbol (str (ns-current)))
        entries
        (filter (fn [entry]
                  (= source (:source (second entry))))
                (deref script/+scripts+))]
    (reduce (fn [_ entry]
              (let [record (second entry)]
                (start-script (:lang record)
                               (:module record)
                               (:config record))))
            nil
            entries)))

(defn rt:restart [] (restart-script))

(def +script-tag-aliases+
  {:xtalk :xt
   :postgres :pg})

(defn script-tags
  "Returns the selected grammar tag and any Foundation compatibility tag."
  [lang]
  (let [book (registry/registry-book lang)
        tag (or (get-in book [:grammar :tag]) lang)
        alias (or (get +script-tag-aliases+ lang) tag)]
    (if (= alias tag)
      [tag]
      [alias tag])))

(defn script-eval-macro-form
  "Builds the namespace-local !.<tag> macro for one script language."
  [lang tag]
  (let [macro-symbol (symbol (str "!." (name tag)))]
    (if (= lang :postgres)
      (list
       'defmacro
       macro-symbol
       (vector '& 'body)
       (list
        'list
        (list 'quote 'lang.core.script/eval-forms)
        lang
        (list 'list
              (list 'quote 'quote)
              'body)))
      (list
       'defmacro
       macro-symbol
       (vector '& 'body)
       (list
        'list
        (list 'quote 'lang.core.script/eval-form)
        lang
        (list
         'list
         (list 'quote 'quote)
         (list
          'if
          (list '= 1 (list 'count 'body))
          (list 'first 'body)
          (list 'apply
                'list
                (list 'quote 'do)
                'body))))))))

(defn script-definition-symbols
  "Lists every Foundation top-level definition symbol in a language grammar."
  [lang]
  (let [reserved (get-in (registry/registry-book lang)
                         [:grammar :reserved])]
    (vec
     (sort-by
      str
      (reduce
       (fn [symbols pair]
         (let [candidate (first pair)
               operation (second pair)]
           (if (and (symbol? candidate)
                    (= :def (:type operation)))
             (conj symbols candidate)
             symbols)))
       []
       reserved)))))

(defn script-highlight-symbols
  "Lists the grammar highlight macros imported by Foundation scripts."
  [lang]
  (vec
   (sort-by
    str
    (filter
     symbol?
     (or (get-in (registry/registry-book lang)
                 [:grammar :highlight])
         #{})))))

(defn language-definition-kind
  [operation]
  (let [operation (name operation)]
    (cond
      (or (= operation "defn") (= operation "defn-")) :function
      (= operation "defmacro") :macro
      (str/starts-with? operation "deftype") :type
      :else :definition)))

(defn language-definition-families
  [lang tags operations]
  (vec
   (mapcat
    (fn [tag]
      (concat
       (map
        (fn [operation]
          (let [head (str (name operation) "." (name tag))]
            {:id [:lang lang head]
             :exact #{head}
             :kind (language-definition-kind operation)
             :language lang
             :operation operation}))
        operations)
       (let [head (str "defmacro." (name tag))]
         [{:id [:lang lang head]
           :exact #{head}
           :kind :macro
           :language lang
           :operation 'defmacro}])))
    tags)))

(defn sync-language-definitions
  [lang tags operations]
  (definition/sync-origin
   [:lang lang]
   (language-definition-families lang tags operations)))

(defn script-definition-macro-form
  [lang tag operation]
  (let [macro-symbol
        (symbol (str (name operation) "." (name tag)))]
    (list
     'defmacro
     macro-symbol
     (vector 'symbol '& 'body)
     (list
      'list
      (list 'quote 'def)
      'symbol
      (list
       'list
       (list 'quote 'lang.core/register-code-pointer)
       lang
       (list
        'list
        (list 'quote 'quote)
        (list
         'apply
         'list
         (list 'quote operation)
         'symbol
         'body)))))))

(defn script-fragment-macro-form
  [lang tag]
  (let [macro-symbol (symbol (str "def$." (name tag)))]
    (list
     'defmacro
     macro-symbol
     (vector 'symbol 'value)
     (list
      'list
      (list 'quote 'def)
      'symbol
      (list
       'list
       (list 'quote 'lang.core/register-fragment-pointer)
       lang
       (list 'list (list 'quote 'quote) 'symbol)
       (list 'list (list 'quote 'quote) 'value)
       (list
        'list
        (list 'quote 'quote)
        (list 'or (list 'meta 'symbol) {})))))))

(defn script-defmacro-macro-form
  [lang tag]
  (let [macro-symbol (symbol (str "defmacro." (name tag)))]
    (list
     'defmacro
     macro-symbol
     (vector 'symbol '& 'body)
     (list 'lang.core/script-defmacro-expansion
           lang
           'symbol
           'body
           (list :ns '&env)))))

(defn script-highlight-macro-form
  [lang highlight-symbol]
  (let [operation
        (get-in (registry/registry-book lang)
                [:grammar :reserved highlight-symbol])
        macro-symbol
        (with-meta (symbol (name highlight-symbol))
          (select-keys (or operation {})
                       [:arglists :style/indent]))]
    (list 'defmacro
          macro-symbol
          (vector '& 'body)
          nil)))

(defn script-macro-forms
  "Builds the complete Foundation grammar macro import surface for a language."
  [lang]
  (let [tags (script-tags lang)
        definitions (script-definition-symbols lang)
        _ (sync-language-definitions lang tags definitions)
        highlights (script-highlight-symbols lang)
        evaluator-forms
        (map (fn [tag]
               (script-eval-macro-form lang tag))
             tags)
        special-forms
        (mapcat
         (fn [tag]
           [(script-fragment-macro-form lang tag)
            (script-defmacro-macro-form lang tag)])
         tags)
        definition-forms
        (mapcat
         (fn [tag]
           (map (fn [operation]
                  (script-definition-macro-form
                   lang tag operation))
                definitions))
         tags)
        highlight-forms
        (map (fn [symbol]
               (script-highlight-macro-form lang symbol))
             highlights)]
    (vec
     (concat evaluator-forms
             special-forms
             definition-forms
             highlight-forms))))

(defn script-import-symbols
  "Lists every namespace-local macro installed by a script declaration."
  [lang]
  (vec (map second (script-macro-forms lang))))

(defn script-install-macro-form
  "Imports one generated macro unless the caller already owns that symbol."
  [form]
  (let [macro-symbol (second form)]
    (list 'if
          (list 'resolve
                (list 'quote macro-symbol))
          nil
          form)))

(defn script-expansion
  "Builds normal or deferred script expansion with its correct final value."
  [lang options test?]
  (let [parsed (script/script-options options)
        module (first parsed)
        config (second parsed)
        setup-form
        (list 'lang.core.script/setup
              (list 'quote lang)
              (list 'quote module)
              (list 'quote config)
              test?)
        final-form
        (if test?
          nil
          (list 'lang.core/start-script
                (list 'quote lang)
                (list 'quote module)
                (list 'quote config)))]
    (apply list
           'do
           (concat [setup-form]
                   (map script-install-macro-form
                        (script-macro-forms lang))
                   [final-form]))))

(defmacro script
  [lang & options]
  (lang.core/script-expansion lang options false))

(defmacro script-
  [lang & options]
  (lang.core/script-expansion lang options true))

(defmacro script+
  [coordinate-value & options]
  (script-annex/script-ext-form
   (symbol (str (get &env :ns)))
   coordinate-value
   (if (empty? options) {} (first options))))

(defmacro !
  [tag body]
  (script-annex/script-eval-form
   (symbol (str (get &env :ns)))
   tag
   body))
