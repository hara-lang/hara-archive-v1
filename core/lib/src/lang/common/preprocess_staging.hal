(ns lang.common.preprocess-staging
  (:require [lang.common.preprocess-assign :as assign]
            [lang.common.preprocess-base :as base]
            [lang.common.preprocess-resolve :as resolve]
            [lang.common.preprocess-value :as value]
            [lang.common.provenance :as provenance]
            [lang.common.util :as util]
            ))

(defn- macro-expansion-form [expanded]
  (if (and (list? expanded) (= 'quote (first expanded)))
    (second expanded)
    expanded))

(defn- macroexpand-host-form [form options]
  (let [module-id (get-in options [:module :id])]
    (try
      (macro-expansion-form
       (if module-id
         (eval-in-ns module-id [(list 'macroexpand-1 (list 'quote form))])
         (macroexpand-1 form)))
      (catch Throwable _ form))))

(defn- record-fragment-dependency
  [fragment deps-fragment]
  (if deps-fragment
    (swap! deps-fragment conj (util/sym-full fragment)))
  fragment)

(defn- value-fragment?
  [fragment]
  (and fragment
       (not (:template fragment))
       (has? fragment :form)))

(defn- expand-fragment-call
  [fragment form deps-fragment walk-fn]
  (record-fragment-dependency fragment deps-fragment)
  (let [replacement (:form fragment)
        args (vec (rest form))]
    (cond
      (symbol? replacement)
      (walk-fn (apply list replacement args))

      (= 0 (count args))
      (walk-fn replacement)

      :else
      (throw
       (ex :host {:fragment (util/sym-full fragment)
                 :replacement replacement
                 :arguments args} :ex/message "Value fragment cannot accept call arguments")))))

(defn- expand-fragment-symbol
  [fragment deps-fragment walk-fn]
  (record-fragment-dependency fragment deps-fragment)
  (walk-fn (:form fragment)))

(defn to-staging-form [form grammar modules options deps-fragment walk-fn]
  (let [symbol (first form)
        reserved (get-in grammar [:reserved symbol])
        options (provenance/with-provenance options {:lang/form form :lang/symbol symbol})
        template-assignment (assign/process-template-assignment form grammar modules options)]
    (cond (= symbol '!:template) (walk-fn (eval (second form)))
          (has? '#{!:lang !:eval !:deref !:decorate} symbol)
          (lang.common.preprocess-assign/ProtectedHead form)
          (= :template (:type reserved))
          (binding [base/*macro-opts* options]
            (walk-fn ((:macro reserved) form)))
          (= :hard-link (:emit reserved))
          (walk-fn (apply list (:raw reserved) (rest form)))
          (and (= :def-assign (:emit reserved))
               (or (= :inline (last form)) (:inline (meta (last form)))))
          (walk-fn (assign/process-inline-assignment form modules options))
          template-assignment (walk-fn template-assignment)
          :else
          (let [value-form (value/process-value-form form grammar modules options)]
            (if value-form
              (walk-fn value-form)
              (if reserved
                (assign/protect-reserved-head form)
                (let [fragment (resolve/get-fragment (first form) modules options)
                      expanded (if (and (symbol? symbol)
                                        (str/includes? (str symbol) "/"))
                                 (macroexpand-host-form form options)
                                 form)]
                  (cond (:template fragment)
                        (do (record-fragment-dependency fragment deps-fragment)
                            (binding [base/*macro-form* form base/*macro-opts* options]
                              (walk-fn (apply (:template fragment) (rest form)))))

                        (value-fragment? fragment)
                        (expand-fragment-call fragment form deps-fragment walk-fn)

                        (not= form expanded)
                        (walk-fn expanded)

                        :else form))))))))

(declare stage-form)

(defn- stage-symbol
  [form grammar modules options deps deps-fragment deps-native]
  (if (and (str/includes? (str form) ".")
           (not (str/includes? (str form) "/")))
    (resolve/process-standard-symbol form options deps-native)
    (or (let [standalone (value/value-standalone form grammar)]
          (if standalone
            (stage-form standalone grammar modules options deps deps-fragment deps-native)))
        (if (str/includes? (str form) "/")
          (let [fragment (resolve/get-fragment form modules options)]
            (if (value-fragment? fragment)
              (expand-fragment-symbol
               fragment deps-fragment
               (fn [replacement]
                 (stage-form replacement grammar modules options
                             deps deps-fragment deps-native)))
              (resolve/process-namespaced-symbol
               form modules options deps deps-fragment
               (fn [replacement]
                 (stage-form replacement grammar modules options
                             deps deps-fragment deps-native)))))
          (resolve/process-standard-symbol form options deps-native)))))

(defn- stage-form [form grammar modules options deps deps-fragment deps-native]
  (try
    (cond (std.foundation/form? form)
          (to-staging-form form grammar modules options deps-fragment
                           (fn [replacement]
                             (stage-form replacement grammar modules options
                                         deps deps-fragment deps-native)))
          (symbol? form)
          (stage-symbol form grammar modules options deps deps-fragment deps-native)
          :else form)
    (catch Throwable error
      (if (:staging/form (ex-data error))
        (throw error)
        (let [message (str "Staging form failed: " (pr-str form) ": "
                          (or (ex-message error) (str error)))
              data {:staging/form form}]
          (if (map? (ex-data error))
            (throw (ex :host data :ex/message message :ex/cause error))
            (throw (ex :host data :ex/message message))))))))

(defn to-staging [input grammar modules options]
  (let [deps (atom #{}) deps-fragment (atom #{}) deps-native (atom {})
        result (std.foundation/prewalk (fn [form]
                               (stage-form form grammar modules options
                                           deps deps-fragment deps-native))
                             input)
        result (std.foundation/postwalk (fn [form]
                                (if (assign/protected-head? form)
                                  (assign/unwrap-protected-head form)
                                  form))
                              result)]
      [result (deref deps) (deref deps-fragment) (deref deps-native)]))

(defn- resolve-form [form grammar modules options]
  (cond (and (std.foundation/form? form) (= (first form) '!:template))
        (resolve-form (eval (second form)) grammar modules options)
        (and (std.foundation/form? form) (get-in grammar [:reserved (first form)]))
        (assign/protect-reserved-head form)
        (symbol? form)
        (if (and (str/includes? (str form) ".")
                 (not (str/includes? (str form) "/")))
          (resolve/process-standard-symbol form options nil)
          (or (value/value-standalone form grammar)
              (if (str/includes? (str form) "/")
                (let [fragment (resolve/get-fragment form modules options)]
                  (if (value-fragment? fragment)
                    (:form fragment)
                    (resolve/process-namespaced-symbol
                     form modules options nil nil identity)))
                (resolve/process-standard-symbol form options nil))))
        :else form))

(defn to-resolve [input grammar modules options]
  (std.foundation/prewalk (fn [form] (resolve-form form grammar modules options)) input))
