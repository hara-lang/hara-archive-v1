(ns lang.common.emit-top-level
  (:require
            [lang.common.emit-assign :as assign]
            [lang.common.emit-block :as block]
            [lang.common.emit-common :as common]
            [lang.common.emit-data :as data]
            [lang.common.emit-fn :as function]
            [lang.common.emit-helper :as helper]
            [lang.common.emit-special :as special]
            [lang.common.provenance :as provenance]))

(defn- member? [values target]
  (reduce (fn [found value] (or found (= value target))) false values))

(defn transform-defclass-inner
  "transforms class body functions and vars to inner forms"
  {:added "4.0"}
  [body]
  (vec
   (map (fn [form]
          (if (list? form)
            (cond (= 'fn (first form))
                  (apply list 'fn.inner
                         (with-meta (second form) (meta form))
                         (drop 2 form))
                  (= 'var (first form))
                  (apply list 'var.inner (rest form))
                  :else form)
            form))
        body)))

(defn emit-def
  "emits a top-level definition"
  {:added "3.0"}
  [key form grammar mopts]
  (let [tag (first form)
        sym (second form)
        body (nth form 2)
        options (helper/get-options grammar [:define key])
        type-output (function/emit-def-type sym (or (:raw options) (name tag))
                                                grammar mopts)
        symbol-output (if (= key :defglobal)
                        (common/emit-with-global nil [nil sym] grammar mopts)
                        (common/*emit-fn* sym grammar mopts))]
    (str type-output
         (if (= "" type-output) "" (:space options))
         symbol-output (:space options) (:assign options) (:space options)
         (common/*emit-fn* body grammar mopts)
         (:statement options))))

(defn emit-declare
  "emits a declaration list"
  {:added "4.0"}
  [key form grammar mopts]
  (let [options (helper/get-options grammar [:define key])]
    (str (or (:raw options) (first form))
         (:space options)
         (str/join (:sep options)
                      (common/emit-array (vec (rest form)) grammar mopts)))))

(defn emit-top-level
  "emits a top-level definition form"
  {:added "3.0"}
  [key form grammar mopts]
  (let [values (vec form)
        tag (first values)
        original-symbol (second values)
        module-id (or (get-in mopts [:entry :module])
                      (get-in mopts [:module :id]))
        qualify (and (not (get (or (meta original-symbol) {}) :inner))
                     (or (member? #{:full :host} (:layout mopts))
                         (= key :defglobal)))
        _ (if (and qualify (nil? module-id))
            (throw (ex :hara/not-found (assoc (select-keys mopts [:module :entry]) :ex/message "Module not found")))
            true)
        target-symbol (if qualify
                        (with-meta (symbol (name module-id)
                                           (name original-symbol))
                          (meta original-symbol))
                        original-symbol)
        target-form (apply list tag target-symbol (drop 2 values))]
    (cond (or (= key :def) (= key :defglobal))
          (emit-def key target-form grammar mopts)
          (= key :defrun) (block/emit-do (drop 2 target-form) grammar mopts)
          (or (= key :defn) (= key :defgen))
          (function/emit-fn key target-form grammar mopts)
          (= key :declare) (emit-declare key target-form grammar mopts)
          :else (throw (ex :hara/generic (assoc {:key key :form target-form} :ex/message "Unsupported top-level form"))))))

(def +emit-lookup+
  (assoc common/+emit-lookup+
         :data data/emit-data
         :block block/emit-block))

(defn emit-form
  "emits a custom, statement, function, or top-level form"
  {:added "4.0"}
  [key form grammar mopts]
  (let [sym (first form)
        entry (get-in grammar [:reserved sym])
        mode (:emit entry)
        type (:type entry)]
    (try
      (cond (and (fn? mode) (not (keyword? mode)))
            (mode form grammar mopts)
            (keyword? mode)
            (common/emit-op key form grammar mopts
                            {:def-assign assign/emit-def-assign
                             :quote data/emit-quote
                             :table data/emit-table
                             :with-module special/emit-with-module
                             :with-lang special/emit-with-lang
                             :with-eval special/emit-with-eval
                             :with-deref special/emit-with-deref})
            (= type :fn) (function/emit-fn key form grammar mopts)
            (= type :def) (emit-top-level key form grammar mopts)
            :else (throw (ex :hara/not-found (assoc {:key key :symbol sym :entry entry} :ex/message "Missing emitter"))))
      (catch Throwable error
        (provenance/throw-with-provenance
         "lang.core emit form failed"
         (provenance/provenance
          (:lang/provenance mopts)
          {:lang/phase :emit/form
           :lang/subsystem :lang.common.emit-top-level/emit-form
           :lang/form form
           :lang/symbol sym})
         error)))))
