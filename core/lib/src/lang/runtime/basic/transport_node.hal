(ns lang.runtime.basic.transport-node
  (:require [tool.sh :as sh]
            [lang.core.eval :as evaluation]
            [lang.protocol.runtime :as transport]
            [std.stream.frame :as frame]
            [std.stream.duplex :as duplex]
            [std.stream.relay :as relay]))

(defstruct ProcessTransport [lang exec process-options timeout state])

(defn- wire-get
  [value key]
  (or (get value key)
      (get value (name key))))

(defn- node-source
  [port]
  (str/join
   "\n"
   ["const net=require(\"net\"),vm=require(\"vm\"),readline=require(\"readline\");"
    (str "const socket=net.createConnection({host:\"127.0.0.1\",port:" port "});")
    "const rl=readline.createInterface({input:socket,crlfDelay:Infinity});"
    "const newContext=()=>{const context=vm.createContext({TextEncoder,TextDecoder,require,process});context.globalThis=context;return context;};"
    "let chain=Promise.resolve();"
    "const raw=(kind,value)=>({type:\"raw\",return:kind,value:String(value)});"
    "const encode=(value)=>{if(value===null||typeof value===\"string\"||typeof value===\"boolean\")return value;if(typeof value===\"number\"){if(Number.isSafeInteger(value))return value;return {\"$tahto\":\"float\",value:String(value)};}if(Array.isArray(value))return value.map(encode);if(typeof value===\"object\"){const out={};for(const [key,item] of Object.entries(value))out[key]=encode(item);return out;}return String(value);};"
    "const shape=(value)=>{const kind=value===null?\"nil\":Array.isArray(value)?\"array\":typeof value;if(value===null)return {type:\"data\",return:kind,value:null};if(kind===\"string\"||kind===\"number\"||kind===\"boolean\")return {type:\"data\",return:kind,value:encode(value)};if(kind===\"undefined\"||kind===\"function\"||kind===\"symbol\"||kind===\"bigint\")return raw(kind,value);try{JSON.stringify(value);return {type:\"data\",return:kind,value:encode(value)};}catch(_){return raw(kind,value);}};"
    "const thrown=(error)=>({name:error&&error.name||\"Error\",message:error&&error.message||String(error),stack:error&&error.stack||null,value:String(error)});"
    "rl.on(\"line\",(line)=>{chain=chain.then(async()=>{let request;try{request=JSON.parse(line);let value=vm.runInContext(request.source,newContext(),{timeout:request.timeout});value=await Promise.resolve(value);socket.write(JSON.stringify({id:request.id,ok:true,response:shape(value)})+\"\\n\");}catch(error){socket.write(JSON.stringify({id:request&&request.id,ok:false,error:thrown(error)})+\"\\n\");}});});"]))

(defn- python-source
  [port]
  (str/join
   "\n"
   ["import ast,json,math,socket,traceback"
    (str "wire=socket.create_connection(('127.0.0.1'," port "))")
    "reader=wire.makefile('r',encoding='utf-8');writer=wire.makefile('w',encoding='utf-8');scope={'math':math}"
    "def encode(value):"
    "    if isinstance(value,float) and value.is_integer() and -(2**63) <= value < 2**63: return int(value)"
    "    if isinstance(value,float): return {'$tahto':'float','value':repr(value)}"
    "    if value is None or isinstance(value,(str,int,bool)): return value"
    "    if isinstance(value,(list,tuple)): return [encode(item) for item in value]"
    "    if isinstance(value,dict): return {str(key):encode(item) for key,item in value.items()}"
    "    return str(value)"
    "def shape(value):"
    "    kind='nil' if value is None else ('array' if isinstance(value,(list,tuple)) else type(value).__name__)"
    "    if value is None or isinstance(value,(str,int,float,bool,list,tuple,dict)): return {'type':'data','return':kind,'value':encode(value)}"
    "    return {'type':'raw','return':kind,'value':str(value)}"
    "def evaluate(source):"
    "    tree=ast.parse(source,mode='exec')"
    "    if tree.body and isinstance(tree.body[-1],ast.Expr):"
    "        prefix=ast.Module(body=tree.body[:-1],type_ignores=[]);exec(compile(prefix,'<tahto>','exec'),scope,scope)"
    "        return eval(compile(ast.Expression(tree.body[-1].value),'<tahto>','eval'),scope,scope)"
    "    exec(compile(tree,'<tahto>','exec'),scope,scope);return None"
    "for line in reader:"
    "    request=None"
    "    try:"
    "        request=json.loads(line);response={'id':request.get('id'),'ok':True,'response':shape(evaluate(request['source']))}"
    "    except BaseException as error:"
    "        response={'id':request.get('id') if request else None,'ok':False,'error':{'name':type(error).__name__,'message':str(error),'stack':traceback.format_exc(),'value':str(error)}}"
    "    writer.write(json.dumps(response,separators=(',',':'))+'\\n');writer.flush()"]))

(defn- lua-source
  [port]
  (str/join
   "\n"
    ["local socket=require('socket');cjson=require('cjson');unpack=unpack or table.unpack"
    (str "local wire=assert(socket.connect('127.0.0.1'," port "))")
    "local function encode(value) local kind=type(value);if kind=='number' and value~=math.floor(value) then return {['$tahto']='float',value=tostring(value)} end;if kind=='table' then local mt=getmetatable(value);local out={};for key,item in pairs(value) do out[key]=encode(item) end;if mt==cjson.array_mt then setmetatable(out,cjson.array_mt) end;return out end;return value end"
    "local function shape(value) local kind=type(value);if value==nil then kind='nil' end;return {type='data',['return']=kind,value=encode(value)} end"
    "while true do local line=wire:receive('*l');if not line then break end;local request=nil;local ok,response=pcall(function() request=cjson.decode(line);local loader=loadstring or load;local chunk,load_error=loader(request.source);if not chunk then error(load_error) end;local value=chunk();return {id=request.id,ok=true,response=shape(value)} end);if not ok then response={id=request and request.id or nil,ok=false,error={name='Error',message=tostring(response),stack=debug.traceback(),value=tostring(response)}} end;wire:send(cjson.encode(response)..'\\n') end"]))

(defn transport-source
  [lang port]
  (cond (= lang :js) (node-source port)
        (= lang :python) (python-source port)
        (= lang :lua) (lua-source port)
        :else (throw (ex :hara/host (assoc {:error/type :lang/runtime-unavailable
                               :lang lang} :ex/message "Persistent basic transport is unavailable")))))

(defn create
  ([exec process-options timeout] (create :js exec process-options timeout))
  ([lang exec process-options timeout]
   (lang.runtime.basic.transport-node/ProcessTransport
    lang exec process-options timeout (atom {:status :created
                                              :relay nil}))))

(defn state
  [node]
  (deref (get node :state)))

(defn- process-options
  [node]
  (select-keys (or (get node :process-options) {}) [:cwd :env]))

(defn started?
  [node]
  (= :started (get (state node) :status)))

(defn- await-event
  [node]
  (evaluation/await
   (Socket/next (get (state node) :stream))
   (get node :timeout)))

(defn- await-open
  [node]
  (let [event (await-event node)
        kind (get event :type)]
    (cond
      (= kind :open) event
      (= kind :error)
      (throw
       (ex :hara/io (assoc {:error/type :lang/transport
                 :lang (get node :lang)
                 :error (get event :error)} :ex/message "Process transport socket failed")))
      :else
      (await-open node))))

(defn- fail-start
  [node error]
  (let [current (state node)
        child (get current :process)
        connection (get current :connection)
        server (get current :server)]
    (if connection (Socket/close connection))
    (if child (Process/kill child))
    (if server (Socket/close server))
    (let [stderr
          (if child
            (try
              (str/decode-utf8
               (evaluation/await (Process/stderr child) 1000))
              (catch Throwable ignored nil))
            nil)
          data {:error/type :lang/runtime-start
                :lang (get node :lang)
                :argv (get node :exec)
                :timeout (get node :timeout)
                :stderr stderr
                :cause-data (ex-data error)}]
      (reset! (get node :state)
              {:status :failed
               :error data})
      (throw
       (ex :hara/host (assoc data :ex/message (str "Failed to start "
                     (name (get node :lang))
                     " basic runtime: "
                     (or (ex-message error) (str error))) :ex/cause error))))))

(defn start
  [node]
  (if (started? node)
    node
    (try
      (let [server (Socket/listen "127.0.0.1" 0 {} (fn [event] nil))
            stream (Socket/events server {})
            endpoint (Socket/endpoint server)
            source (transport-source (get node :lang)
                                     (get endpoint :port))]
        (reset! (get node :state)
                {:status :starting
                 :server server
                 :stream stream})
        (let [argv (conj (get node :exec) source)
              child (sh/spawn argv (process-options node))]
          (swap! (get node :state) assoc :process child)
          (let [open (await-open node)
                connection (get open :connection)
                channel (relay/relay
                         (duplex/from-socket connection)
                         (frame/json-line)
                         {:mode :correlated
                          :timeout-ms (get node :timeout)
                          :prepare-request
                          (fn [id request]
                            [id (assoc request "id" id)])
                          :response-id
                          (fn [response]
                            (wire-get response :id))})]
            (swap! (get node :state)
                   assoc
                   :status :started
                   :connection connection
                   :relay channel)
            node)))
      (catch Throwable error
        (fail-start node error)))))

(defn stop
  [node]
  (let [current (state node)
        channel (get current :relay)
        connection (get current :connection)
        server (get current :server)
        child (get current :process)]
    (if channel (relay/close channel))
    (if (and connection (nil? channel)) (Socket/close connection))
    (if server (Socket/close server))
    (if child (Process/kill child))
    (swap! (get node :state) assoc :status :stopped)
    node))

(defn exchange
  [node source options]
  (if-not (started? node)
    (throw
     (ex :hara/host (assoc {:error/type :lang/transport
               :lang (get node :lang)
               :state (state node)} :ex/message "Process transport is not started")))
    (let [timeout (or (get options :timeout) (get node :timeout))
          request {"source" source
                   "timeout" timeout}
          response (evaluation/await
                    (relay/exchange (get (state node) :relay)
                                    request
                                    {:timeout-ms timeout})
                    timeout)]
      (lang.core.eval/EvalExchange
       (get node :lang) request response {:persistent true
                                          :process (get (state node) :process)}))))

(extend-type ProcessTransport transport/IEvalTransport
  (exchange [node request options]
    (promise/run (fn [] (exchange node request options)))))

(defn- wire-value
  [value]
  (cond
    (nil? value)
    nil

    (vector? value)
    (vec (map wire-value value))

    (map? value)
    (if (= "float" (get value "$tahto"))
      (read-string (get value "value"))
      (reduce (fn [out entry]
                (assoc out
                       (first entry)
                       (wire-value (second entry))))
              {}
              value))

    :else value))

(defn response-plugin
  [frame]
  (let [wire (get frame :response)]
    (if (wire-get wire :ok)
      (let [response (wire-get wire :response)]
        (assoc frame
               :result
               {:type (wire-get response :type)
                :return (wire-get response :return)
                :value (wire-value (wire-get response :value))}))
      (let [error (wire-get wire :error)]
        (throw
         (ex :hara/io (assoc {:error/type :lang/target
                   :target (get-in frame [:context :lang])
                   :target-source-tail (vec (take-last 4
                                            (str/split-lines
                                             (get-in frame [:exchange :request "source"]))))
                   :target-error error} :ex/message (or (wire-get error :message)
                      "Target evaluation failed"))))))))

(def +response-plugin+
  (evaluation/register-plugin
   :lang/node-response 1 :response response-plugin))
