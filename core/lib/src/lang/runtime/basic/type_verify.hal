(ns lang.runtime.basic.type-verify
  (:require [tool.sh :as sh]))

(defn- process-options
  [runtime source]
  (assoc
   (select-keys (or (:process runtime) {}) [:cwd :env])
   :stdin source))

(defn checker-result
  "Builds the structured result returned by a syntax checker.

   The vector form is retained for existing pure callers; process execution
   now supplies the canonical tool.sh result map directly."
  [runtime value]
  (let [result
        (if (vector? value)
          {:command (get runtime :exec)
           :exit (nth value 2)
           :stdout (str/decode-utf8 (nth value 0))
           :stderr (str/decode-utf8 (nth value 1))}
          value)]
    (merge
     {:phase :verify
      :lang (get runtime :lang)
      :runtime (get runtime :runtime)
      :program (get runtime :program)}
     result)))

(defn verify-result
  "Returns source after a successful check or throws a structured verify error."
  [runtime source result]
  (if (= 0 (get result :exit))
    source
    (throw
     (ex :host (assoc result
             :generated-fragment source
             :grammar-coordinate (get runtime :grammar-coordinate)
             :grammar-version (get runtime :grammar-version)) :ex/message "Target source verification failed"))))

(defn verify-execute
  "Checks source through the runtime's stdin-based verifier."
  [runtime source]
  (let [argv (get runtime :exec)]
    (try
      (let [result (sh/result-record
                    (sh/run argv (process-options runtime source)))]
        (checker-result runtime result))
      (catch Throwable error
        (throw
         (ex :host {:phase :verify
           :lang (get runtime :lang)
           :runtime (get runtime :runtime)
           :program (get runtime :program)
           :command argv
           :generated-fragment source
           :cause-data (ex-data error)} :ex/message "Target source verifier could not complete" :ex/cause error))))))

(defn verify-source
  "Checks emitted target source without executing it."
  [runtime source]
  (verify-result runtime source (verify-execute runtime source)))

(defn raw-eval-verify
  "Runtime raw evaluator for the Foundation :verify coordinate."
  [runtime source]
  (verify-source runtime source))
