(ns lang.runtime.basic.impl.process-xtalk
  (:require [lang.core.runtime :as runtime]
            [lang.runtime.basic.type-hara :as hara-basic]))

(def +xtalk-host+
  (runtime/install-type
   :xtalk :host
   {:type :lang/rt.hara-basic
    :config {:target :hara
             :transport :in-process}
    :instance {:create hara-basic/rt-hara-basic:create
               :start hara-basic/start-hara-basic
               :stop hara-basic/stop-hara-basic
               :raw-eval hara-basic/raw-eval-hara-basic}}))

(def +hara-host+
  (runtime/install-type
   :hara :host
   {:type :lang/rt.hara-basic
    :config {:target :hara
             :transport :in-process}
    :instance {:create hara-basic/rt-hara-basic:create
               :start hara-basic/start-hara-basic
               :stop hara-basic/stop-hara-basic
               :raw-eval hara-basic/raw-eval-hara-basic}}))

(def +init+
  {:lang :xtalk
   :target :hara
   :xtalk-host +xtalk-host+
   :hara-host +hara-host+})
