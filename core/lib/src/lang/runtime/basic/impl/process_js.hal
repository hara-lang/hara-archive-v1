(ns lang.runtime.basic.impl.process-js
  (:require [lang.core.runtime :as runtime]
            [lang.runtime.basic.type-basic :as basic]
            [lang.runtime.basic.type-common :as common]
            [lang.runtime.basic.type-oneshot :as oneshot]
            [lang.runtime.basic.type-verify :as verify]
            [lang.runtime.basic.impl.source-js :as source]))

(def +program-init+
  (common/put-program-options
   :js
   {:default {:oneshot :nodejs
              :verify :nodejs
              :basic :nodejs}
    :env {:nodejs
          {:exec "node"
           :extension "js"
           :flags {:oneshot ["-e"]
                   :verify ["--input-type=module" "--check" "-"]
                   :basic ["-e"]}}}}))

(def +js-oneshot-config+
  (common/set-context-options
   [:js :oneshot :default]
   {:main {}
    :emit {}
    :json :full}))

(def +js-verify-config+
  (common/set-context-options
   [:js :verify :default]
   {:main {}
    :emit {}
    :json false
    :transport :process-stdin}))

(def +js-basic-config+
  (common/set-context-options
   [:js :basic :default]
   {:main {}
    :emit {}
    :json :full
    :timeout 2000
    :transport :process-socket
    :bootstrap source/transport-source
    :profile {:input []
              :source []
              :response [[:lang/node-response 1]]}}))

(def +js-oneshot+
  (runtime/install-type
   :js :oneshot
   {:type :lang/rt.oneshot
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval oneshot/raw-eval-oneshot}}))

(def +js-verify+
  (runtime/install-type
   :js :verify
   {:type :lang/rt.verify
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval verify/raw-eval-verify}}))

(def +js-basic+
  (runtime/install-type
   :js :basic
   {:type :lang/rt.basic
    :config {:layout :full}
    :instance {:create basic/rt-basic:create
               :start basic/start-basic
               :stop basic/stop-basic
               :raw-eval basic/raw-eval-basic}}))

(def +init+
  {:lang :js
   :program +program-init+
   :oneshot +js-oneshot+
   :verify +js-verify+
   :basic +js-basic+})
