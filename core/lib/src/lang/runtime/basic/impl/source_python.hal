(ns lang.runtime.basic.impl.source-python
  (:config {:role :internal}))

(defn transport-source
  "Builds CPython's persistent return-eval socket bootstrap."
  [port]
  (str/join
   "\n"
   ["import ast,json,math,socket,traceback"
    (str "wire=socket.create_connection(('127.0.0.1'," port "))")
    "reader=wire.makefile('r',encoding='utf-8');writer=wire.makefile('w',encoding='utf-8');scope={'math':math}"
    "def encode(value):"
    "    if isinstance(value,float) and value.is_integer() and -(2**63) <= value < 2**63: return int(value)"
    "    if isinstance(value,float): return {'$tahto':'float','value':repr(value)}"
    "    if value is None or isinstance(value,(str,int,bool)): return value"
    "    if isinstance(value,(list,tuple)): return [encode(item) for item in value]"
    "    if isinstance(value,dict): return {str(key):encode(item) for key,item in value.items()}"
    "    return str(value)"
    "def type_of(value):"
    "    if value is None: return 'nil'"
    "    if isinstance(value,(list,tuple)): return 'array'"
    "    if isinstance(value,dict): return 'object'"
    "    if isinstance(value,bool): return 'boolean'"
    "    if isinstance(value,(int,float)): return 'number'"
    "    if isinstance(value,str): return 'string'"
    "    if callable(value): return 'function'"
    "    return type(value).__name__"
    "def json_filter(value):"
    "    if isinstance(value,dict): return {str(key):json_filter(item) for key,item in value.items() if not callable(item)}"
    "    if isinstance(value,(list,tuple)): return [json_filter(item) for item in value if not callable(item)]"
    "    if callable(value): return None"
    "    return value"
    "def return_encode(value):"
    "    kind=type_of(value)"
    "    try: return {'type':'data','return':kind,'value':encode(json_filter(value))}"
    "    except BaseException: return {'type':'raw','return':kind,'value':str(value)}"
    "def evaluate(source):"
    "    tree=ast.parse(source,mode='exec')"
    "    if tree.body and isinstance(tree.body[-1],ast.Expr):"
    "        prefix=ast.Module(body=tree.body[:-1],type_ignores=[]);exec(compile(prefix,'<tahto>','exec'),scope,scope)"
    "        return eval(compile(ast.Expression(tree.body[-1].value),'<tahto>','eval'),scope,scope)"
    "    exec(compile(tree,'<tahto>','exec'),scope,scope);return None"
    "def return_wrap(thunk):"
    "    try: return return_encode(thunk())"
    "    except BaseException as error: return {'type':'error','value':{'name':type(error).__name__,'message':str(error),'stack':traceback.format_exc(),'value':str(error)}}"
    "def return_eval(source): return return_wrap(lambda:evaluate(source))"
    "for line in reader:"
    "    request=None"
    "    try:"
    "        request=json.loads(line);response={'id':request.get('id'),'ok':True,'response':return_eval(request['source'])}"
    "    except BaseException as error:"
    "        response={'id':request.get('id') if request else None,'ok':False,'error':{'name':type(error).__name__,'message':str(error),'stack':traceback.format_exc(),'value':str(error)}}"
    "    writer.write(json.dumps(response,separators=(',',':'))+'\\n');writer.flush()"]))
