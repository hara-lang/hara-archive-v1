(ns lang.runtime.basic.impl.source-hara
  (:config {:role :internal}))

(defn transport-source
  "Builds Hara's persistent return-eval socket bootstrap."
  [port]
  (str/join
   "\n"
   ["(do"
    "(ns lang.runtime.basic.process-hara.session)"
    "(ns lang.runtime.basic.process-hara.child)"
    "(def +session-namespace+ 'lang.runtime.basic.process-hara.session)"
    "(defn +bytes-values+ [value]"
    "  (loop [index 0 output []]"
    "    (if (= index (Bytes/count value))"
    "      output"
    "      (recur (inc index) (conj output (Bytes/get value index))))))"
    "(defn +append-bytes+ [left right]"
    "  (apply Bytes/new (concat (+bytes-values+ left) (+bytes-values+ right))))"
    "(defn +line-index+ [value]"
    "  (loop [index 0]"
    "    (if (= index (Bytes/count value))"
    "      nil"
    "      (if (= 10 (Bytes/get value index))"
    "        index"
    "        (recur (inc index))))))"
    "(defn +json-value+ [value]"
    "  (cond"
    "    (nil? value) nil"
    "    (= (type value) :std.native.Array)"
    "    (loop [index 0 output []]"
    "      (if (= index (count value))"
    "        output"
    "        (recur (inc index)"
    "               (conj output (+json-value+ (Arr/get value index))))))"
    "    (= (type value) :std.native.Object)"
    "    (let [pairs (Obj/pairs value)]"
    "      (loop [index 0 output {}]"
    "        (if (= index (count pairs))"
    "          output"
    "          (let [pair (Arr/get pairs index)]"
    "            (recur (inc index)"
    "                   (assoc output"
    "                          (Arr/get pair 0)"
    "                          (+json-value+ (Arr/get pair 1))))))))"
    "    (vector? value) (vec (map +json-value+ value))"
    "    (map? value)"
    "    (reduce (fn [output key]"
    "              (assoc output"
    "                     (if (string? key) key (str key))"
    "                     (+json-value+ (get value key))))"
    "            {}"
    "            (keys value))"
    "    (double? value)"
    "    {\"$tahto\" \"float\""
    "     \"value\" (str/replace"
    "              (str/replace (str value) \"(double \" \"\") \")\" \"\")}"
    "    (or (string? value) (boolean? value) (long? value)) value"
    "    :else (str value)))"
    "(defn +shape-value+ [value]"
    "  (let [kind"
    "        (cond"
    "          (nil? value) \"nil\""
    "          (string? value) \"string\""
    "          (boolean? value) \"boolean\""
    "          (long? value) \"integer\""
    "          (double? value) \"float\""
    "          (= (type value) :std.native.Array) \"array\""
    "          (= (type value) :std.native.Object) \"object\""
    "          (vector? value) \"array\""
    "          (map? value) \"object\""
    "          :else nil)]"
    "    (if kind"
    "      {\"type\" \"data\" \"return\" kind \"value\" (+json-value+ value)}"
    "      {\"type\" \"raw\" \"return\" (str (type value)) \"value\" (str value)})))"
    "(defn +return-encode+ [value]"
    "  (+shape-value+ value))"
    "(defn +return-wrap+ [thunk]"
    "  (try"
    "    (+return-encode+ (thunk))"
    "    (catch error"
    "      {\"type\" \"error\""
    "       \"value\" {\"name\" \"HaraError\""
    "                  \"message\" (or (ex-message error) (str error))"
    "                  \"stack\" nil"
    "                  \"value\" (str error)}})))"
    "(defn +error-value+ [request error]"
    "  {\"id\" (get request \"id\")"
    "   \"ok\" false"
    "   \"error\" {\"name\" \"HaraError\""
    "             \"message\" (or (ex-message error) (str error))"
    "             \"stack\" nil"
    "             \"value\" (str error)}})"
    "(defn +return-eval+ [source]"
    "  (+return-wrap+"
    "   (fn []"
    "     (eval-in-ns +session-namespace+"
    "                 [(read-string (str \"(do\\n\" source \"\\n)\"))]))))"
    "(defn +evaluate-request+ [request]"
    "  {\"id\" (get request \"id\")"
    "   \"ok\" true"
    "   \"response\" (+return-eval+ (get request \"source\"))})"
    "(defn +line-response+ [line]"
    "  (try"
    "    (+evaluate-request+ (Json/read line))"
    "    (catch error"
    "      (+error-value+ {} error))))"
    "(defn +run-connection+ [request response-connection]"
    "  (let [stream (Socket/events request {})]"
    "    (letfn [(read-next [buffer]"
    "              (let [event (deref (Socket/next stream))]"
    "                (cond"
    "                  (nil? event)"
    "                  (do (Socket/close response-connection) (Socket/close request))"
    "                  (= :data (get event :type))"
    "                  (process-buffer (+append-bytes+ buffer (get event :bytes)))"
    "                  (= :close (get event :type))"
    "                  (do (Socket/close response-connection) nil)"
    "                  (= :error (get event :type))"
    "                  (throw (ex :io {:error (get event :error)}"
    "                             :ex/message \"Hara child socket failed\"))"
    "                  :else (read-next buffer))))"
    "            (process-buffer [buffer]"
    "              (let [index (+line-index+ buffer)]"
    "                (if (nil? index)"
    "                  (read-next buffer)"
    "                  (let [line (str/decode-utf8 (Bytes/slice buffer 0 index))"
    "                        remaining (Bytes/slice buffer (inc index))"
    "                        result (+line-response+ line)]"
    "                    (Socket/send response-connection"
    "                                (str/encode-utf8"
    "                                 (str (Json/write result) \"\\n\")))"
    "                    (process-buffer remaining)))))]"
    "      (read-next (Bytes/new)))))"
    "(let [request-server (Socket/listen \"127.0.0.1\" 0 {} (fn [_] nil))"
    "      request-stream (Socket/events request-server {})"
    "      request-port (get (Socket/endpoint request-server) :port)"
    "      response-promise"
    "      (promise/new"
    "       (fn [resolve reject]"
    (str "         (Socket/connect \"127.0.0.1\" " port " {}"
         "\n                           (fn [error connection]"
         "\n                             (if error"
         "\n                               (reject error)"
         "\n                               (resolve connection))))))")
    "      _ (println request-port)"
    "      request-open (deref (Socket/next request-stream))"
    "      request-connection (get request-open :connection)"
    "      response-connection (deref response-promise)"
    "      result (+run-connection+ request-connection response-connection)]"
    "  (Socket/close request-server)"
    "  result)"
    ")"]))
