(ns lang.runtime.basic.impl.process-python
  (:require [lang.core.runtime :as runtime]
            [lang.runtime.basic.type-basic :as basic]
            [lang.runtime.basic.type-common :as common]
            [lang.runtime.basic.type-oneshot :as oneshot]
            [lang.runtime.basic.type-verify :as verify]
            [lang.runtime.basic.impl.source-python :as source]))

(def +python-init+
  (common/put-program-options
   :python
   {:default {:oneshot :cpython
              :verify :cpython
              :basic :cpython}
    :env {:cpython
          {:exec "python3"
           :extension "py"
           :flags {:oneshot ["-c"]
                   :verify ["-c" "import sys; compile(sys.stdin.read(), '<hara>', 'exec')"]
                   :basic ["-c"]}}}}))

(def +python-oneshot-config+
  (common/set-context-options
   [:python :oneshot :default]
   {:main {}
    :emit {}
    :json :full}))

(def +python-verify-config+
  (common/set-context-options
   [:python :verify :default]
   {:main {}
    :emit {}
    :json false
    :transport :process-stdin}))

(def +python-basic-config+
  (common/set-context-options
   [:python :basic :default]
   {:main {}
    :emit {}
    :json :full
    :timeout 2000
    :transport :process-socket
    :bootstrap source/transport-source
    :profile {:input []
              :source []
              :response [[:lang/node-response 1]]}}))

(def +python-oneshot+
  (runtime/install-type
   :python :oneshot
   {:type :lang/rt.oneshot
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval oneshot/raw-eval-oneshot}}))

(def +python-verify+
  (runtime/install-type
   :python :verify
   {:type :lang/rt.verify
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval verify/raw-eval-verify}}))

(def +python-basic+
  (runtime/install-type
   :python :basic
   {:type :lang/rt.basic
    :config {:layout :full}
    :instance {:create basic/rt-basic:create
               :start basic/start-basic
               :stop basic/stop-basic
               :raw-eval basic/raw-eval-basic}}))

(def +init+
  {:lang :python
   :program +python-init+
   :oneshot +python-oneshot+
   :verify +python-verify+
   :basic +python-basic+})
