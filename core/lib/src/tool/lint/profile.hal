;; Generated analysis profile pinned to the Hara source-analysis specifications.
(ns tool.lint.profile)

(def +profile+
  {:profile/id :tool.lint/hara-v1
   :profile/version "0.2.0"
   :profile/specs
   [{:spec/id :hal/language :spec/version "alpha"}
    {:spec/id :hara/foundation :spec/version "alpha"}
    {:spec/id :tool/source-analysis :spec/version "alpha"}
    {:spec/id :std/typed :spec/version "alpha"}]
   :special-forms
   '#{ns ns+ def defn defn- defmacro declare let loop fn if do quote var
      set! recur throw try catch finally new . deftype defstruct defprotocol
      extend-type defmulti defmethod}
   :macro-models
   '{when {:lint-as if}
     if-not {:lint-as if}
     if-let {:lint-as let}
     when-let {:lint-as let}
     cond {:lint-as if}
     cond-> {:lint-as let}
     cond->> {:lint-as let}
     -> {:lint-as let}
     ->> {:lint-as let}
     doto {:lint-as let}}
   :foundation-symbols
   '#{+ - * / quot rem mod = not= < <= > >= compare
      identity inc dec constantly comp complement partial juxt
      zero? pos? neg? even? odd? nil? false? true? boolean? number? long? bigint? integer?
      string? keyword? symbol? list? vector? map? set? fn? bytes? promise?
      has? empty? distinct? some? every? any?
      atom deref reset! cas! swap! watch-add watch-remove watch-list
      meta with-meta
      first second rest next not-empty last reverse nth get find
      get-in assoc assoc-in dissoc update update-in conj
      key val keys vals min max sort sort-by drop-last butlast take-last
      split-at split-with partition-by take-nth into distinct zipmap map-keys
      map-vals merge merge-with group-by frequencies
      range repeat repeatedly iterate take-while drop-while partition-all
      partition interpose interleave map filter remove take drop mapcat keep
      cycle zip reduce apply concat vec set list hash-map count empty
      str pr-str print println name namespace symbol keyword
      schema schema? schema-of
      long double bit-and bit-or bit-xor bit-not bit-shift-left bit-shift-right
      abs acos acosh asin asinh atan atan2 atanh ceil cos cosh exp floor pow
      sin sinh sqrt tan tanh
      eval read-forms load-string macroexpand macroexpand-all
      apply-in apply-as invoke-as ns-current current-symbols ns-state
      ns-loaded? ns-alias-state ns-list ns-info ns-vars ns-find ns-create
      ns-name ns-publics ns-aliases resolve
      var-sym
      ex-info ex-data ex-message Throwable
      protocol-call field instance? identical? type? satisfies?
      and or not cond case when if-not if-let when-let doseq for
      some-> some->> as-> condp while dotimes lazy-seq}
   :collection-results
   '{take-while {2 {:source-arg 1 :items :same}}
     drop-while {2 {:source-arg 1 :items :same}}
     interpose {2 {:source-arg 1 :items :unknown}}
     interleave {:variadic {:source-arg 0 :items :unknown}}
     map {:variadic {:source-arg 1 :items :unknown}}
     filter {2 {:source-arg 1 :items :same}}
     take {2 {:source-arg 1 :items :same}}
     drop {2 {:source-arg 1 :items :same}}
     mapcat {2 {:source-arg 1 :items :unknown}}
     keep {2 {:source-arg 1 :items :unknown}}
     zip {:variadic {:source-arg 0 :items :unknown}}
     partition-pair {1 {:source-arg 0 :items :unknown}}
     sort {1 {:source-arg 0 :items :same}
           2 {:source-arg 1 :items :same}}
     sort-by {2 {:source-arg 1 :items :same}
              3 {:source-arg 2 :items :same}}
     drop-last {1 {:source-arg 0 :items :same}
                2 {:source-arg 1 :items :same}}
     butlast {1 {:source-arg 0 :items :same}}
     take-last {2 {:source-arg 1 :items :same}}
     take-nth {2 {:source-arg 1 :items :same}}
     distinct {1 {:source-arg 0 :items :same}}
     remove {2 {:source-arg 1 :items :same}}
     into {2 {:source-arg 0 :items :unknown}}}
   :signatures
   '{vec {:arities #{1} :args [:any] :return :vector
          :refinements {:vector/backend :persistent :metadata :absent}}
     inc {:arities #{1} :args [:num] :return :num}
     dec {:arities #{1} :args [:num] :return :num}
     + {:arities :variadic :args [:num] :return :num}
     - {:arities :variadic :args [:num] :return :num}
     * {:arities :variadic :args [:num] :return :num}
     / {:arities :variadic :args [:num] :return :num}
     count {:arities #{1} :args [:any] :return :long}
     first {:arities #{1} :args [:any] :return :any}
     str {:arities :variadic :args [:any] :return :str}
     name {:arities #{1} :args [:any] :return :str}
     namespace {:arities #{1} :args [:any] :return [:maybe :str]}
     keyword {:arities #{1 2} :args [:any] :return :keyword}
     symbol {:arities #{1 2} :args [:any] :return :symbol}}})
