;; ============================================================================
;; tool.vm — portable HALC/HBC artifact and provider contracts.
;;
;; This namespace describes formats and capabilities only. Binary codecs,
;; compilers, and executors remain host providers and are wired separately.
;; ============================================================================
(ns tool.vm
  (:require [tool.vm.provider :as runtime-provider]))

(def +format-order+ [:hal :halc :hbc])

(def +formats+
  {:hal
   {:format/id :hal
    :format/name "HAL"
    :format/kind :source
    :format/status :draft
    :format/extension ".hal"
    :format/portable true
    :format/execution :source-evaluation
    :format/spec-path "01-lang/001-language/draft/hal-langspec.edn"}

   :halc
   {:format/id :halc
    :format/name "HALC"
    :format/kind :canonical-module
    :format/status :draft
    :format/extension ".halc"
    :format/magic "HALC"
    :format/version 1
    :format/portable true
    :format/execution :lowering-required
    :format/spec-path "01-lang/009-halc/draft/halc-format.md"}

   :hbc
   {:format/id :hbc
    :format/name "HBC0"
    :format/kind :executable-module
    :format/status :draft
    :format/extension ".hbc"
    :format/magic "HBC0"
    :format/version 0
    :format/portable true
    :format/execution :virtual-machine
    :format/spec-id :hal/hbc0-wire
    :format/spec-path "01-lang/010-bytecode/draft/hbc0-wire.edn"}})

(def +specifications+
  {:hal/hbc0-wire
   {:spec/id :hal/hbc0-wire
    :spec/format :hbc
    :spec/kind :wire
    :spec/path "01-lang/010-bytecode/draft/hbc0-wire.edn"
    :spec/corpora [:hal/hbc0-golden :hal/hbc0-malformed]}
   :hal/hbc-machine
   {:spec/id :hal/hbc-machine
    :spec/format :hbc
    :spec/kind :machine
    :spec/path "01-lang/010-bytecode/draft/hbc-machine.edn"
    :spec/corpora [:hal/hbc-machine-conformance]}
   :hal/hbc-suspension
   {:spec/id :hal/hbc-suspension
    :spec/format :hbc
    :spec/kind :extension
    :spec/path "01-lang/010-bytecode/draft/hbc-suspension.edn"
    :spec/corpora [:hal/hbc-suspension-conformance]}
   :hal/hbc-backend-profiles
   {:spec/id :hal/hbc-backend-profiles
    :spec/format :hbc
    :spec/kind :profiles
    :spec/path "01-lang/010-bytecode/draft/hbc-backend-profiles.edn"
    :spec/corpora []}})

(def +backend-profile-order+
  [:rust-stack-vm
   :rust-tracing
   :rust-whole-wasm
   :java-reference-vm
   :truffle-bytecode-dsl])

(def +implemented-backend-profiles+
  {[:rust :stack-vm] :rust-stack-vm
   [:truffle :reference-vm] :java-reference-vm})

(def +binary-formats+ #{:halc :hbc})

(def +transformations+
  [{:transform/from :hal
    :transform/to :halc
    :transform/kind :canonicalize
    :transform/reversible false}
   {:transform/from :hal
    :transform/to :hbc
    :transform/kind :compile
    :transform/reversible false}
   {:transform/from :halc
    :transform/to :hbc
    :transform/kind :lower
    :transform/reversible false}])

(def +operation-order+
  [:encode :decode :validate :inspect :transform :execute :disassemble :conform])

(def +operations+
  #{:encode :decode :validate :inspect :transform :execute :disassemble :conform})

(def +format-operation-order+
  {:hal [:validate :inspect :execute :conform]
   :halc [:encode :decode :validate :inspect :execute :conform]
   :hbc [:encode :decode :validate :inspect :execute :disassemble :conform]})

(defn- fail [message data]
  (throw (ex :generic data :ex/message message)))

(defn- includes? [values target]
  (not
   (nil?
    (first
     (filter (fn [value] (= value target)) values)))))

(defn- unknown-keys [value allowed]
  (vec
   (sort-by str
            (filter (fn [key] (not (has? allowed key)))
                    (keys value)))))

(defn- exact-map [label type allowed value]
  (if (not (map? value))
    (fail (str label " must be a map")
          {:type type :field label :value value})
    (let [unknown (unknown-keys value allowed)]
      (if (empty? unknown)
        value
        (fail (str label " contains unsupported keys: " unknown)
              {:type type :field label :unknown unknown})))))

(defn- keyword-value [label type value]
  (if (keyword? value)
    value
    (fail (str label " must be a keyword")
          {:type type :field label :value value})))

(defn- format-id [value]
  (let [value (keyword-value "format" :tool.vm/unknown-format value)]
    (if (has? +formats+ value)
      value
      (fail (str "Unknown tool.vm format: " value)
            {:type :tool.vm/unknown-format
             :format value
             :available +format-order+}))))

(defn formats
  "Returns portable code-format descriptors in pipeline order."
  []
  (vec (map (fn [id] (get +formats+ id)) +format-order+)))

(defn format-descriptor
  "Returns the descriptor for a known portable code format."
  [format]
  (get +formats+ (format-id format)))

(defn spec
  "Returns the primary format specification path or one exact specification descriptor."
  ([format]
   (:format/spec-path (format-descriptor format)))
  ([format identity]
   (let [format (format-id format)
         identity (keyword-value
                   "specification identity"
                   :tool.vm/unknown-specification
                   identity)
         descriptor (get +specifications+ identity)]
     (if (and descriptor (= format (:spec/format descriptor)))
       descriptor
       (fail (str "Unknown tool.vm specification: " identity)
             {:type :tool.vm/unknown-specification
              :format format
              :spec identity
              :available
              (vec
               (filter
                (fn [value]
                  (= format (:spec/format (get +specifications+ value))))
                (keys +specifications+)))})))))

(defn binary-format?
  "Returns true only for serialized HALC and HBC module formats."
  [format]
  (and (keyword? format) (has? +binary-formats+ format)))

(defn- find-transformation [from to]
  (first
   (filter (fn [edge]
             (and (= from (:transform/from edge))
                  (= to (:transform/to edge))))
           +transformations+)))

(defn transformations
  "Returns the exact one-way transformation graph."
  []
  +transformations+)

(defn legal-transform?
  "Returns true when an exact source-to-target edge is declared."
  [from to]
  (and (keyword? from)
       (keyword? to)
       (not (nil? (find-transformation from to)))))

(defn transformation
  "Returns a declared transformation or throws for an unsupported edge."
  [from to]
  (let [from (format-id from)
        to (format-id to)
        edge (find-transformation from to)]
    (if edge
      edge
      (fail (str "Unsupported tool.vm transformation: " from " -> " to)
            {:type :tool.vm/unsupported-transformation
             :from from
             :to to
             :available +transformations+}))))

(defn artifact
  "Validates and normalizes a binary HALC or HBC artifact wrapper."
  [value]
  (let [value (exact-map
               "tool.vm artifact"
               :tool.vm/invalid-artifact
               #{:artifact/format
                 :artifact/version
                 :artifact/bytes
                 :artifact/provenance}
               value)
        format (format-id (:artifact/format value))
        version (:artifact/version value)
        bytes (:artifact/bytes value)
        provenance (:artifact/provenance value)]
    (if (not (binary-format? format))
      (fail "HAL source cannot be represented as a binary tool.vm artifact"
            {:type :tool.vm/invalid-artifact
             :field :artifact/format
             :format format
             :available [:halc :hbc]})
      nil)
    (if (not (and (long? version) (not (neg? version))))
      (fail ":artifact/version must be a non-negative integer"
            {:type :tool.vm/invalid-artifact
             :field :artifact/version
             :value version})
      nil)
    (if (not (bytes? bytes))
      (fail ":artifact/bytes must be Bytes"
            {:type :tool.vm/invalid-artifact
             :field :artifact/bytes
             :value bytes})
      nil)
    (if (and (not (nil? provenance)) (not (map? provenance)))
      (fail ":artifact/provenance must be a map when present"
            {:type :tool.vm/invalid-artifact
             :field :artifact/provenance
             :value provenance})
      nil)
    (let [normalized
          {:artifact/format format
           :artifact/version version
           :artifact/bytes (Bytes/copy bytes)}]
      (if (nil? provenance)
        normalized
        (assoc normalized :artifact/provenance provenance)))))

(defn artifact?
  "Returns true when value is a valid binary artifact wrapper."
  [value]
  (try
    (do (artifact value) true)
    (catch Throwable error false)))

(defn artifact-info
  "Returns stable artifact information without exposing host objects."
  [value]
  (let [artifact (artifact value)]
    {:artifact/format (:artifact/format artifact)
     :artifact/version (:artifact/version artifact)
     :artifact/bytes (Bytes/count (:artifact/bytes artifact))
     :artifact/spec-path (spec (:artifact/format artifact))
     :artifact/provenance (:artifact/provenance artifact)}))

(defn- canonical-members [label allowed value]
  (let [members
        (cond
          (set? value) value
          (vector? value) (reduce conj #{} value)
          :else
          (fail (str label " must be a set or vector")
                {:type :tool.vm/invalid-provider
                 :field label
                 :value value}))
        unknown
        (vec
         (sort-by str
                  (filter (fn [item] (not (includes? allowed item)))
                          members)))]
    (if (not (empty? unknown))
      (fail (str label " contains unsupported values: " unknown)
            {:type :tool.vm/invalid-provider
             :field label
             :unknown unknown})
      (vec (filter (fn [item] (has? members item)) allowed)))))

(defn- normalize-formats [value]
  (let [value (exact-map
               ":provider/formats"
               :tool.vm/invalid-provider
               +formats+
               value)]
    (reduce
     (fn [out format]
       (if (has? value format)
         (assoc out
                format
                (canonical-members
                 (str ":provider/formats " format)
                 (get +format-operation-order+ format)
                 (get value format)))
         out))
     {}
     +format-order+)))

(defn- normalize-transforms [value]
  (if (not (vector? value))
    (fail ":provider/transforms must be a vector of [from to] pairs"
          {:type :tool.vm/invalid-provider
           :field :provider/transforms
           :value value})
    (let [requested
          (reduce
           (fn [out pair]
             (if (not (and (vector? pair) (= 2 (count pair))))
               (fail ":provider/transforms must contain [from to] pairs"
                     {:type :tool.vm/invalid-provider
                      :field :provider/transforms
                      :value pair})
               (let [from (format-id (nth pair 0))
                     to (format-id (nth pair 1))]
                 (transformation from to)
                 (conj out [from to]))))
           #{}
           value)]
      (vec
       (map (fn [edge]
              [(:transform/from edge) (:transform/to edge)])
            (filter (fn [edge]
                      (has? requested
                            [(:transform/from edge) (:transform/to edge)]))
                    +transformations+))))))

(defn- normalize-engines [value formats]
  (let [value (exact-map
               ":provider/engines"
               :tool.vm/invalid-provider
               +formats+
               value)]
    (reduce
     (fn [out format]
       (if (has? value format)
         (if (not (has? formats format))
           (fail "Execution engine format is not declared by provider"
                 {:type :tool.vm/invalid-provider
                  :field :provider/engines
                  :format format})
           (assoc out
                  format
                  (keyword-value
                   ":provider/engines value"
                   :tool.vm/invalid-provider
                   (get value format))))
         out))
     {}
     +format-order+)))

(defn- derived-operations [formats transforms]
  (let [members
        (reduce
         (fn [out format]
           (reduce conj out (or (get formats format) [])))
         (if (empty? transforms) #{} #{:transform})
         +format-order+)]
    (vec (filter (fn [operation] (has? members operation))
                 +operation-order+))))

(defn- derived-backend-profiles [id engines]
  (vec
   (filter
    (fn [profile]
      (not
       (nil?
        (first
         (filter
          (fn [pair]
            (= profile
               (get +implemented-backend-profiles+
                    [id (nth pair 1)])))
          engines)))))
    +backend-profile-order+)))

(defn provider
  "Validates and canonicalizes one exact host-provider descriptor."
  [value]
  (let [value (exact-map
               "tool.vm provider"
               :tool.vm/invalid-provider
               #{:provider/id
                 :provider/operations
                 :provider/formats
                 :provider/transforms
                 :provider/engines
                 :provider/profiles}
               value)
        id (keyword-value
            ":provider/id"
            :tool.vm/invalid-provider
            (:provider/id value))
        formats (normalize-formats (or (:provider/formats value) {}))
        transforms (normalize-transforms (or (:provider/transforms value) []))
        engines (normalize-engines (or (:provider/engines value) {}) formats)
        operations (derived-operations formats transforms)
        profiles (derived-backend-profiles id engines)
        declared (:provider/operations value)
        declared-profiles (:provider/profiles value)]
    (if (not (nil? declared))
      (let [declared (canonical-members
                      ":provider/operations"
                      +operation-order+
                      declared)]
        (if (not= declared operations)
          (fail ":provider/operations does not match exact capabilities"
                {:type :tool.vm/invalid-provider
                 :provider id
                 :field :provider/operations
                 :declared declared
                 :derived operations})
          nil))
      nil)
    (if (not (nil? declared-profiles))
      (let [declared-profiles
            (canonical-members
             ":provider/profiles"
             +backend-profile-order+
             declared-profiles)]
        (if (not= declared-profiles profiles)
          (fail ":provider/profiles does not match implemented backend profiles"
                {:type :tool.vm/invalid-provider
                 :provider id
                 :field :provider/profiles
                 :declared declared-profiles
                 :derived profiles})
          nil))
      nil)
    (reduce
     (fn [out pair]
       (if (and (has? formats (nth pair 0))
                (has? formats (nth pair 1)))
         out
         (fail "Provider transformation formats must be declared"
               {:type :tool.vm/invalid-provider
                :provider id
                :transform pair
                :formats (vec (keys formats))})))
     nil
     transforms)
    (reduce
     (fn [out format]
       (let [operations (or (get formats format) [])
             executable (includes? operations :execute)
             engine (has? engines format)]
         (cond
           (and executable (not engine))
           (fail "Executable provider format requires an execution engine"
                 {:type :tool.vm/invalid-provider
                  :provider id
                  :field :provider/engines
                  :format format})

           (and engine (not executable))
           (fail "Execution engine requires :execute for its exact format"
                 {:type :tool.vm/invalid-provider
                  :provider id
                  :field :provider/formats
                  :format format})

           :else out)))
     nil
     +format-order+)
    {:provider/id id
     :provider/operations operations
     :provider/formats formats
     :provider/transforms transforms
     :provider/engines engines
     :provider/profiles profiles}))

(defn provider?
  "Returns true when value is a valid exact provider descriptor."
  [value]
  (try
    (do (provider value) true)
    (catch Throwable error false)))

(defn capabilities
  "Returns providers in deterministic identity order and rejects duplicates."
  [providers]
  (if (not (vector? providers))
    (fail "tool.vm capabilities must be a vector of providers"
          {:type :tool.vm/invalid-provider-set
           :value providers})
    (let [by-id
          (reduce
           (fn [out value]
             (let [provider (provider value)
                   id (:provider/id provider)]
               (if (has? out id)
                 (fail (str "Duplicate tool.vm provider: " id)
                       {:type :tool.vm/duplicate-provider
                        :provider id})
                 (assoc out id provider))))
           {}
           providers)]
      (vec (map (fn [id] (get by-id id))
                (sort-by str (keys by-id)))))))

(defn- request [value]
  (let [value (if (map? value)
                value
                (fail "tool.vm request must be a map"
                      {:type :tool.vm/invalid-request :value value}))
        operation (keyword-value
                   ":operation"
                   :tool.vm/invalid-request
                   (:operation value))
        provider-value (:provider value)
        provider (if (nil? provider-value)
                   nil
                   (keyword-value
                    ":provider"
                    :tool.vm/invalid-request
                    provider-value))
        options (or (:options value) {})]
    (if (not (has? +operations+ operation))
      (fail (str "Unknown tool.vm operation: " operation)
            {:type :tool.vm/invalid-request
             :operation operation
             :available +operation-order+})
      nil)
    (if (not (map? options))
      (fail ":options must be a map"
            {:type :tool.vm/invalid-request
             :field :options
             :value options})
      nil)
    (if (= operation :transform)
      (let [value (exact-map
                   "tool.vm transform request"
                   :tool.vm/invalid-request
                   #{:operation :provider :from :to :options}
                   value)
            from (format-id (:from value))
            to (format-id (:to value))]
        (transformation from to)
        {:operation operation
         :provider provider
         :from from
         :to to
         :options options})
      (let [value (exact-map
                   "tool.vm format request"
                   :tool.vm/invalid-request
                   #{:operation :provider :format :options}
                   value)]
        {:operation operation
         :provider provider
         :format (format-id (:format value))
         :options options}))))

(defn- supports-request? [provider request]
  (if (= :transform (:operation request))
    (includes? (:provider/transforms provider)
               [(:from request) (:to request)])
    (let [format (:format request)
          operations (get (:provider/formats provider) format)]
      (and (not (nil? operations))
           (includes? operations (:operation request))
           (if (= :execute (:operation request))
             (has? (:provider/engines provider) format)
             true)))))

(defn available-providers
  "Returns provider ids supporting request, ignoring its selected provider."
  [providers value]
  (let [providers (capabilities providers)
        request (request value)]
    (vec
     (map (fn [provider] (:provider/id provider))
          (filter (fn [provider]
                    (supports-request? provider request))
                  providers)))))

(defn select-provider
  "Selects only the explicitly requested provider; it never falls back."
  [providers value]
  (let [providers (capabilities providers)
        request (request value)
        requested (:provider request)
        selected
        (first
         (filter (fn [provider]
                   (= requested (:provider/id provider)))
                 providers))]
    (if (nil? requested)
      (fail "tool.vm provider selection requires :provider"
            {:type :tool.vm/invalid-request
             :field :provider
             :operation (:operation request)})
      nil)
    (if (and selected (supports-request? selected request))
      selected
      (fail (str "tool.vm provider cannot satisfy request: " requested)
            {:type :tool.vm/capability-unavailable
             :operation (:operation request)
             :from (:from request)
             :to (:to request)
             :format (:format request)
             :provider requested
             :available (available-providers providers request)}))))


;; ---------------------------------------------------------------------------
;; Current runtime provider
;; ---------------------------------------------------------------------------

(def +provider-option-keys+
  #{:provider})

(defn current-provider
  "Returns the exact normalized descriptor for the current runtime provider."
  []
  (provider (runtime-provider/provider)))

(defn current-provider-id
  "Returns the stable identity of the current runtime provider."
  []
  (:provider/id (current-provider)))

(defn current-capabilities
  "Returns the current runtime provider as a one-element capability set."
  []
  [(current-provider)])

(defn- provider-options
  [value]
  (let [value (or value {})]
    (if (not (map? value))
      (fail "tool.vm provider options must be a map"
            {:type :tool.vm/invalid-request
             :field :options
             :value value})
      (let [unknown (unknown-keys value +provider-option-keys+)]
        (if (empty? unknown)
          value
          (fail (str "tool.vm provider options contain unsupported keys: " unknown)
                {:type :tool.vm/invalid-request
                 :field :options
                 :unknown unknown}))))))

(defn resolve-provider
  "Resolves an operation against the current runtime only; it never falls back."
  [request]
  (let [options (provider-options (:options request))
        current (current-provider)
        requested (or (:provider options)
                      (:provider/id current))]
    (select-provider
     [current]
     (assoc request :provider requested))))

(defn- artifact-request
  [operation value options]
  (let [artifact (artifact value)
        options (provider-options options)]
    {:artifact artifact
     :provider
     (resolve-provider
      {:operation operation
       :format (:artifact/format artifact)
       :options options})}))

(defn- artifact-invalid
  [operation artifact provider error]
  (let [message (ex-message error)]
    (fail (str "Invalid " (name (:artifact/format artifact))
               " artifact: " message)
          {:type :tool.vm/artifact-invalid
           :operation operation
           :format (:artifact/format artifact)
           :provider (:provider/id provider)
           :message message})))

(defn validate
  "Authenticates and validates one HALC or HBC artifact through the current runtime."
  ([artifact]
   (validate artifact {}))
  ([artifact options]
   (let [request (artifact-request :validate artifact options)
         artifact (:artifact request)
         provider (:provider request)]
     (try
       (runtime-provider/validate
        (:artifact/format artifact)
        (:artifact/bytes artifact))
       (catch Throwable error
         (artifact-invalid :validate artifact provider error))))))

(defn inspect
  "Returns ordinary Hara data derived from a validated HALC or HBC artifact."
  ([artifact]
   (inspect artifact {}))
  ([artifact options]
   (let [request (artifact-request :inspect artifact options)
         artifact (:artifact request)
         provider (:provider request)]
     (try
       (runtime-provider/inspect
        (:artifact/format artifact)
        (:artifact/bytes artifact))
       (catch Throwable error
         (artifact-invalid :inspect artifact provider error))))))

(defn disassemble
  "Returns deterministic HBC diagnostics. This operation is not decompilation."
  ([artifact]
   (disassemble artifact {}))
  ([artifact options]
   (let [request (artifact-request :disassemble artifact options)
         artifact (:artifact request)
         provider (:provider request)]
     (try
       (runtime-provider/disassemble (:artifact/bytes artifact))
       (catch Throwable error
         (artifact-invalid :disassemble artifact provider error))))))

(defn- transform-input
  [value]
  (if (string? value)
    {:from :hal
     :payload value
     :provenance nil}
    (let [artifact (artifact value)]
      {:from (:artifact/format artifact)
       :payload (:artifact/bytes artifact)
       :provenance (:artifact/provenance artifact)})))

(defn- transform-options
  [value]
  (let [value (or value {})]
    (if (map? value)
      value
      (fail "tool.vm transform options must be a map"
            {:type :tool.vm/invalid-request
             :field :options
             :value value}))))

(defn transform
  "Transforms HAL source or a HALC artifact through the selected current-runtime provider."
  ([input to]
   (transform input to {}))
  ([input to options]
   (let [input (transform-input input)
         from (:from input)
         to (format-id to)
         options (transform-options options)
         provider-options (if (has? options :provider)
                            {:provider (:provider options)}
                            {})
         compile-options (dissoc options :provider)
         provider
         (resolve-provider
          {:operation :transform
           :from from
           :to to
           :options provider-options})]
     (try
       (let [bytes
             (runtime-provider/transform
              from to (:payload input) compile-options)
             version (:format/version (format-descriptor to))
             provenance
             {:transform/provider (:provider/id provider)
              :transform/from from
              :transform/to to
              :transform/options compile-options
              :transform/source-provenance (:provenance input)}]
         (artifact
          {:artifact/format to
           :artifact/version version
           :artifact/bytes bytes
           :artifact/provenance provenance}))
       (catch Throwable error
         (fail (str "tool.vm transformation failed: " (ex-message error))
               {:type :tool.vm/transformation-failed
                :operation :transform
                :from from
                :to to
                :provider (:provider/id provider)
                :message (ex-message error)}))))))

(defn- execution-options
  [value]
  (let [value (or value {})]
    (if (map? value)
      value
      (fail "tool.vm execution options must be a map"
            {:type :tool.vm/invalid-request
             :field :options
             :value value}))))

(defn execute
  "Authenticates, validates, and executes a HALC or HBC artifact through one provider."
  ([value]
   (execute value {}))
  ([value options]
   (let [artifact (artifact value)
         format (:artifact/format artifact)
         options (execution-options options)
         provider-options (if (has? options :provider)
                            {:provider (:provider options)}
                            {})
         runtime-options (dissoc options :provider)
         provider
         (resolve-provider
          {:operation :execute
           :format format
           :options provider-options})
         engine (get (:provider/engines provider) format)]
     (try
       (runtime-provider/execute
        format (:artifact/bytes artifact) runtime-options)
       (catch Throwable error
         (fail (str "tool.vm execution failed: " (ex-message error))
               {:type :tool.vm/execution-failed
                :operation :execute
                :format format
                :provider (:provider/id provider)
                :engine engine
                :message (ex-message error)}))))))

(defn- conformance-case
  [format options value]
  (let [value (exact-map
               "tool.vm conformance case"
               :tool.vm/invalid-conformance
               #{:case/id :case/artifact :case/expect}
               value)
        id (:case/id value)
        artifact (artifact (:case/artifact value))
        expect (exact-map
                "tool.vm conformance expectation"
                :tool.vm/invalid-conformance
                #{:value :error}
                (:case/expect value))]
    (if (not (= format (:artifact/format artifact)))
      (fail "tool.vm conformance case format does not match its corpus"
            {:type :tool.vm/invalid-conformance
             :case id
             :format (:artifact/format artifact)
             :expected format})
      nil)
    (try
      (let [actual (execute artifact options)
            pass (and (has? expect :value)
                      (= actual (:value expect)))]
        {:case/id id
         :case/pass pass
         :case/expected expect
         :case/actual actual})
      (catch Throwable error
        {:case/id id
         :case/pass (= true (:error expect))
         :case/expected expect
         :case/error (ex-data error)}))))

(defn conform
  "Runs a portable artifact corpus and returns an ordinary Hara conformance report."
  ([corpus]
   (conform corpus {}))
  ([corpus options]
   (let [corpus (exact-map
                 "tool.vm conformance corpus"
                 :tool.vm/invalid-conformance
                 #{:corpus/id :corpus/format :corpus/cases}
                 corpus)
         format (format-id (:corpus/format corpus))
         cases (:corpus/cases corpus)
         options (execution-options options)
         provider-options (if (has? options :provider)
                            {:provider (:provider options)}
                            {})
         provider
         (resolve-provider
          {:operation :conform
           :format format
           :options provider-options})]
     (if (not (vector? cases))
       (fail ":corpus/cases must be a vector"
             {:type :tool.vm/invalid-conformance
              :field :corpus/cases
              :value cases})
       nil)
     (let [results
           (vec
            (map (fn [value]
                   (conformance-case format options value))
                 cases))
           passed (count (filter :case/pass results))]
       {:corpus/id (:corpus/id corpus)
        :corpus/format format
        :conformance/provider (:provider/id provider)
        :conformance/engine (get (:provider/engines provider) format)
        :conformance/passed passed
        :conformance/failed (- (count results) passed)
        :conformance/cases results}))))
