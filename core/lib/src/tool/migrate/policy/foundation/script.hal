(def +foundation-script-compatibility-ledger+
 [
  {:surface 'defn.xt
   :authority 'lang.core/defn.xt
   :compatibility 'lang.core.script/defn.xt
   :disposition :retire-copy-after-loader-parity
   :reason :grammar-derived-lang-core-publication-is-authoritative}
  {:surface 'defmacro.xt
   :authority 'lang.core/defmacro.xt
   :compatibility 'lang.core.script/defmacro.xt
   :disposition :retire-copy-after-loader-parity
   :reason :grammar-derived-lang-core-publication-is-authoritative}
  {:surface 'script
   :authority 'lang.core/script
   :compatibility 'lang.core.script/script
   :disposition :retire-copy-after-contract-parity
   :reason :grammar-derived-lang-core-publication-is-authoritative}
  {:surface 'script-
   :authority 'lang.core/script-
   :compatibility 'lang.core.script/script-
   :disposition :retire-copy-after-contract-parity
   :reason :grammar-derived-lang-core-publication-is-authoritative}
  {:surface '!.js
   :authority 'lang.core/!.js
   :compatibility 'lang.core.script/!.js
   :disposition :retire-copy-after-runtime-parity
   :reason :grammar-derived-lang-core-publication-is-authoritative}
  {:surface '!.lua
