   :reason :grammar-derived-lang-core-publication-is-authoritative}
 ])

(defn foundation-script-inventory
  []
  {:source/references +foundation-script-source-references+
   :target/references +foundation-script-target-references+
   :validation/references +foundation-script-validation-references+})
