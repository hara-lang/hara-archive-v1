    ["test/std/lib/zip_test.clj"]
    1
    "std.lib.zip"
    [{:source/namespace "std.lib.zip"
      :target/namespaces ["std.lib.zip"]
      :status :retained}]
    "std_lib_zip/conformance.edn")
   (family-descriptor
    :code_query
    ["test/code/query_test.clj" "test/code/query"]
    9
    "code.query"
    [{:source/namespace "code.query"
      :target/namespaces ["code.query"]
      :status :retained}
     {:source/namespace "code.query.match"
      :target/namespaces ["code.query.match.impl"
                          "code.query.match.optional"
                          "code.query.match.pattern"]
      :status :split}]
    "code_query/conformance.edn")
   (family-descriptor
    :std_lib_context
    ["test/std/lib/context" "test/std/lib/resource_test.clj"]
