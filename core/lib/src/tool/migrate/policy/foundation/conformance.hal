      :status :retained}]
    "std_fs/conformance.edn")
   (family-descriptor
    :std_lib_encode
    ["test/std/lib/encode_test.clj"]
    1
    "std.lib.encode"
    [{:source/namespace "std.lib.encode"
      :target/namespaces ["std.lib.encode.base64"
                          "std.lib.encode.form"
                          "std.lib.encode.hex"
                          "std.lib.encode.url"]
