(ns tool.migrate.policy.foundation.conformance
  (:config {:role :internal})
  (:require [tool.migrate.common.corpus :as corpus]
            [tool.migrate.common.git :as migrate-git]
            [tool.migrate.policy.foundation.profile :as profile]
            [std.fs.path :as path]
            [std.fs :as fs]
            [code.project :as project]
            [tool.sh :as sh]
            [work.flow.task.command-task :as task]))

(def +mapping-statuses+
  #{:retained :renamed :split :consolidated :host-only :retired :manual-review})

(def +evidence-statuses+ #{:emitted :skipped :manual-review})

(def +active-profile+ profile/+foundation-f55f+)
(def +origin-generator+
  "tool.migrate.policy.foundation.conformance/4")

(def +foundation-revision+
  (:foundation/revision +active-profile+))

(def +foundation-tree+
  (:foundation/tree +active-profile+))

(def +hara-revision+
  (:hara/revision +active-profile+))

(def +baseline+
  {:foundation/repository (:foundation/repository +active-profile+)
   :foundation/revision +foundation-revision+
   :foundation/tree +foundation-tree+
   :foundation/source-roots (:foundation/source-roots +active-profile+)
   :foundation/test-roots (:foundation/test-roots +active-profile+)
   :external/rank (:external/rank +active-profile+)
   :hara/repository (:hara/repository +active-profile+)
   :hara/revision +hara-revision+
   :output/repository (:registry/repository +active-profile+)
   :output/root (str "../hara-specs-registry/"
                     (:registry/root +active-profile+))})

(def +workflow-contract+
  {:contract/id :code.manage-task-flow
   :contract/version 1
   :foundation/test-prefixes ["test/code/manage_test.clj"
                              "test/code/manage"]
   :foundation/test-count 17
   :operations 35
   :selector/arity [0 3]
   :selector/lookup? false
   :defaults {:direct :current-namespace
              :cli :all}
   :template :work.flow.task
   :report :work.flow.task.report
   :packaging :task-report
   :selector/owner :work.flow.task.selector/invocation-options})

(defn family-descriptor
  [family-id test-prefixes test-count target-namespace mappings output-path]
  {:family/id family-id
   :family/name (name family-id)
   :source/test-prefixes (vec test-prefixes)
   :source/test-count test-count
   :target/namespace target-namespace
   :target/metadata-path (str (name family-id) "/metadata.edn")
   :mapping mappings
   :output/path output-path
   :review/status :unreviewed})

