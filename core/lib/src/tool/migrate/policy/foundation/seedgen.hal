(defn route-namespace
  [namespace]
  (let [text (str namespace)]
    (if (or (= text "tahto.seedgen")
            (str/starts-with? text "tahto.seedgen."))
      (symbol
       (str "lang.seedgen"
            (str/slice text (count "tahto.seedgen") (count text))))
      namespace)))

(defn hal-path
  [path]
  (if (str/ends-with? path ".clj")
    (str (str/slice path 0 (- (count path) 4)) ".hal")
    path))

(defn route-path
  [path]
  (let [source-prefix (str source-root "/")
        test-prefix (str source-test-root "/")
        target-prefix (str target-root "/")
        target-test-prefix (str target-test-root "/")]
    (cond
      (str/starts-with? path source-prefix)
      (hal-path
       (str target-prefix
            (str/slice path (count source-prefix) (count path))))

      (str/starts-with? path test-prefix)
      (hal-path
       (str target-test-prefix
            (str/slice path (count test-prefix) (count path))))

      :else path)))

(defn unit-for
  [path]
  (first
   (filter
    (fn [unit]
      (= path (:source/path unit)))
    +seedgen-units+)))

(defn rewrite-common-meta
  [source]
  (let [source
        (str/replace
         source
         "(ns tahto.seedgen.common-meta)"
         (str "(ns lang.seedgen.common-meta\n"
              "  (:config {:role :internal}))"))
        names
        ["normalize-runtime-lang" "runtime-lang-config"
         "runtime-script-lang" "runtime-dispatch-symbol"
         "runtime-type" "runtime-check-mode"
         "runtime-suite-groups" "runtime-lang-suffix"]
        source
        (reduce
         (fn [output name]
           (str/replace output
                        (str "(defn " name)
                        (str "(defn ^{:public true} " name)))
         source
         names)
        old-group
        (str "(defn ^{:public true} runtime-suite-groups\n"
             "  [langs]\n"
             "  (->> langs\n"
             "       (map normalize-runtime-lang)\n"
             "       distinct\n"
             "       sort\n"
             "       (group-by runtime-check-mode)\n"
             "       (into (sorted-map)\n"
             "             (map (fn [[mode entries]]\n"
             "                    [mode (vec entries)])))))")
        new-group
        (str "(defn ^{:public true} runtime-suite-groups\n"
             "  [langs]\n"
             "  (->> langs\n"
             "       (map normalize-runtime-lang)\n"
             "       distinct\n"
             "       sort\n"
             "       (group-by runtime-check-mode)\n"
             "       (map (fn [[mode entries]]\n"
             "              [mode (vec entries)]))\n"
             "       (into {})))")]
    (str/replace source old-group new-group)))

(defn migration-input
  ([source-text target-text]
   (migration-input source-text target-text {}))
  ([source-text target-text options]
   (let [unit (unit-for "src/tahto/seedgen/common_meta.clj")]
     {:units
      [(assoc unit
              :source/text source-text
              :target/text target-text
              :source/root (or (:source/root options) ".")
              :target/root (or (:target/root options) ".")
              :source/sha256
              (str "sha256:" (Crypto/sha256
                               (str/encode-utf8 source-text)))
              :translation/recipe
              {:id :foundation/seedgen-common-meta
               :output (rewrite-common-meta source-text)})]})))

(defn ^{:public true} plan
  ([source-text target-text]
   (plan source-text target-text {}))
  ([source-text target-text options]
   (project/plan (migration-input source-text target-text options))))

(def validate-write-plan write/validate-write-plan)
(def apply-plan write/apply-plan)

(def.work migration
  [:task]
  {:task/type :tool.migrate/seedgen
   :item
   {:list
    (fn [input context]
      (vec
       (map
        (fn [unit]
          {:item/id (:id unit)
           :item/value unit})
        (sort-by
         (fn [unit]
           [(or (:dependency/rank unit) 2147483647)
            (str (:id unit))])
         (:units input)))))
    :run
    (fn [unit context]
      (if (and (= :pilot (:migration/status unit))
               (string? (:source/text unit)))
        (let [result
              (plan (:source/text unit)
                    (:target/text unit)
                    {:source/root (:source/root unit)
                     :target/root (:target/root unit)})]
          {:status (if (empty? (:errors result)) :return :error)
           :data (first (:edits result))})
        {:status :return
         :data {:source/path (:source/path unit)
                :target/path (:target/path unit)
                :migration/status (or (:migration/status unit) :pending)
                :migration/state (case (:migration/status unit)
                                   :migrated :verified
                                   :pilot :awaiting-source
                                   :pending :pending
                                   :pending)
                :changed false
                :write false
                :diagnostics []}}))}
   :execution {:order :input :parallel false :fail-fast false}
   :return {:select :all :package :map}})

(def ^{:public true} seedgen-migration migration)
