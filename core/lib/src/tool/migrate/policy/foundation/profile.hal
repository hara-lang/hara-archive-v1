(ns tool.migrate.policy.foundation.profile
  (:config {:role :internal}))

(def +candidate-states+
  #{:exact :moved :similar :reviewed-candidate :unmatched})

(def +review-dispositions+
  #{:portable-substitute
    :host-runtime-adapter
    :semantic-replacement
    :manual-boundary
    :missing
    :obsolete
    :host-only
    :renamed
    :consolidated
    :pending})

(def +terminal-dispositions+
  #{:portable-substitute
    :host-runtime-adapter
    :semantic-replacement
    :manual-boundary
    :missing
    :obsolete
    :host-only
    :renamed
    :consolidated})

(def +foundation-baa75a+
  {:profile/id :foundation-baa75a
   :profile/description
   "Historical Foundation audit profile pinned before the tool.migrate prototype."
   :foundation/repository "zcaudate-xyz/foundation-base"
   :foundation/revision "baa75aabd6a879753d7d5cb07271b1448271e7cb"
   :foundation/tree "26d494f60c4970df56eba8ac40f92affeee4e159"
   :foundation/source-roots ["src" "src-java" "src-lang"]
   :foundation/test-roots ["test" "test-java" "test-lang"]
   :foundation/rank-base 0
   :external/rank -1
   :corpus/path "core/spec/code-migrate/foundation-baa75a.edn"
   :report/path "core/spec/code-migrate/foundation-baa75a.md"
   :candidate/states +candidate-states+
   :review/dispositions +review-dispositions+
   :review/terminal +terminal-dispositions+
   :review/allow-pending true})

(def +foundation-f55f+
  {:profile/id :foundation-f55f
   :profile/description
   "Active Foundation migration profile for issue 554 evidence generation."
   :foundation/repository "zcaudate-xyz/foundation-base"
   :foundation/revision
   "f55f39855d5e9ea1b22f1d116df684c584323f80"
   :foundation/tree
   "3beb10f32e7d57139910ee9c9de1370e966ca935"
   :foundation/source-roots ["src" "src-java" "src-lang"]
   :foundation/test-roots ["test" "test-java" "test-lang"]
   :foundation/rank-base 0
   :external/rank -1
   :hara/repository "hara-lang/hara"
   :hara/revision "fd382c506348c1e96412e7398ac4cba7029b7885"
   :registry/repository "hara-lang/hara-specs-registry"
   :registry/root
   "01-lang/005-foundation-annex/draft/conformance/libraries"
   :corpus/path "core/spec/tool-migrate/foundation-f55f.edn"
   :report/path "core/spec/tool-migrate/foundation-f55f.md"
   :candidate/states +candidate-states+
   :review/dispositions +review-dispositions+
   :review/terminal +terminal-dispositions+
   :review/allow-pending true})

(def +profiles+
  {:foundation-baa75a +foundation-baa75a+
   :foundation-f55f +foundation-f55f+})

(defn profile
  [identifier]
  (get +profiles+ identifier))

(def +hex-characters+ (set "0123456789abcdef"))

(defn sha?
  [value]
  (and
   (string? value)
   (= 40 (count value))
   (every?
    (fn [character]
      (has? +hex-characters+ character))
    value)))

(defn valid-profile?
  [value]
  (and
   (map? value)
   (keyword? (:profile/id value))
   (string? (:foundation/repository value))
   (sha? (:foundation/revision value))
   (sha? (:foundation/tree value))
   (vector? (:foundation/source-roots value))
   (vector? (:foundation/test-roots value))
   (= 0 (:foundation/rank-base value))
   (= -1 (:external/rank value))
   (string? (:corpus/path value))
   (string? (:report/path value))
   (or (not (has? value :hara/revision))
       (sha? (:hara/revision value)))
   (or (not (has? value :registry/root))
       (string? (:registry/root value)))
   (set? (:candidate/states value))
   (set? (:review/dispositions value))
   (set? (:review/terminal value))))

(defn assert-profile
  [value]
  (if (not (valid-profile? value))
    (throw
     (ex :tool.migrate/invalid-profile
         {:ex/message "Invalid Foundation migration profile"
          :profile value})))
  value)

(defn allowed-disposition?
  [profile-value disposition]
  (has? (:review/dispositions profile-value) disposition))

(defn reviewed-disposition?
  [profile-value disposition]
  (has? (:review/terminal profile-value) disposition))

(defn pending-disposition?
  [disposition]
  (= :pending disposition))
