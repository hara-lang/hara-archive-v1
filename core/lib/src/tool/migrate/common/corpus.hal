(ns tool.migrate.common.corpus
  (:config {:role :internal})
  (:require [tool.migrate.common.clojure :as clj]
            [tool.migrate.policy.foundation.profile :as profile]))

(def +migration-dispositions+
  #{:portable-substitute
    :host-runtime-adapter
    :semantic-replacement
    :renamed
    :consolidated})

(defn sorted-unique
  [values]
  (vec
   (sort
    (keys
     (reduce
      (fn [output value]
        (if (nil? value)
          output
          (assoc output value true)))
      {}
      values)))))

(defn source-entry
  "Builds one exact Foundation source record from host-provided blob evidence."
  [path blob source]
  (let [summary (clj/source-summary source)]
    {:namespace (:namespace summary)
     :source/path path
     :source/blob blob
     :dependencies (:dependencies summary)
     :dependency/occurrences (clj/dependency-occurrences source)
     :dependency/symbols
     (clj/dependency-symbol-references source (:dependencies summary))
     :core/symbols (:core/symbols summary)
     :public-symbols (:public-symbols summary)
     :candidate/matches []
     :review/disposition :pending
     :review/evidence []
     :dry-run/status :not-planned}))

(defn attach-test
  [entry test-path test-blob test-source]
  (let [summary (clj/source-summary test-source)]
    (assoc
     (assoc
      (assoc
       (assoc
        (assoc
         (assoc
          (assoc
           (assoc
            (assoc entry :test/path test-path)
            :test/blob test-blob)
           :test/namespace (:namespace summary))
          :test/dependencies (:dependencies summary))
         :test/dependency-occurrences (clj/dependency-occurrences test-source))
        :test/dependency-symbols
        (clj/dependency-symbol-references test-source (:dependencies summary)))
       :test/core-symbols (:core/symbols summary))
      :test/public-symbols (:public-symbols summary)))))

(defn namespace-index
  [entries]
  (reduce
   (fn [output entry]
     (assoc output (:namespace entry) entry))
   {}
   entries))

(defn dependency-graph
  [entries]
  (let [index (namespace-index entries)]
    (reduce
     (fn [output entry]
       (assoc
        output
        (:namespace entry)
        (sorted-unique
         (filter
          (fn [dependency]
            (has? index dependency))
          (:dependencies entry)))))
     {}
     entries)))

(defn dependency-capability
  [dependency]
  (cond
    (str/starts-with? dependency "clojure.tools.reader.reader-types")
    {:kind :reader
     :status :manual-review
     :reason :reader-runtime-object}

    (str/starts-with? dependency "clojure.tools.reader")
    {:kind :reader
     :status :manual-review
     :reason :reader-runtime-boundary}

    (or (str/starts-with? dependency "clojure.java")
        (str/starts-with? dependency "clojure.lang"))
    {:kind :jvm-class
     :status :manual-review
     :reason :jvm-runtime-object}

    :else
    {:kind :portable
     :status :portable
     :reason nil}))

(defn external-route-record
  [entry source external-rank family-id prefix index occurrence]
  (let [dependency (:dependency/name occurrence)
        references
        (vec
         (filter
          (fn [reference]
            (str/starts-with?
             (:resolved/symbol reference)
             (str dependency "/")))
          (:symbols source)))
        source-path (:path source)
        kind (:kind source)
        evidence (:dependency/evidence occurrence)]
    {:external/id (str prefix "/" source-path "#" (name kind) "-" index)
     :family/id family-id
     :external/namespace dependency
     :dependency/rank external-rank
     :source/namespace (:namespace entry)
     :source/path (:source/path entry)
     :source/blob (:source/blob entry)
     :source/dependency-rank (:dependency/rank entry)
     :source/dependency-component (:dependency/component entry)
     :source/dependency-cycle (:dependency/cycle entry)
     :test/path (:test/path entry)
     :test/blob (:test/blob entry)
     :observation/kind kind
     :observation/path source-path
     :observation/index index
     :dependency/evidence evidence
     :form/location evidence
     :referenced/symbols (vec (map :resolved/symbol references))
     :referenced/source-symbols (vec (map :source/symbol references))
     :referenced/evidence (vec (map :reference/evidence references))
     :referenced/idioms (sorted-unique (map :reference/idiom references))
     :referenced/operations (sorted-unique (map :reference/operation references))
     :referenced/status (if (empty? references) :manual-review :derived)
     :referenced/reason (if (empty? references) :no-qualified-symbol-evidence nil)
     :capability (dependency-capability dependency)
     :extraction/status :emitted
     :candidate/matches []
     :review/disposition :pending
     :review/evidence []}))

(defn core-reference-sources
  [entry]
  (vec
   (keep
    (fn [source]
      (if (and (string? (:path source))
               (vector? (:references source)))
        source
        nil))
    [{:kind :source
      :path (:source/path entry)
      :references (vec (or (:core/symbols entry) []))}
     {:kind :test
      :path (:test/path entry)
      :references (vec (or (:test/core-symbols entry) []))}])))

(defn core-reference-record
  [entry source family-id prefix index reference]
  (let [reference-status (:reference/status reference)
        extraction-status
        (cond
          (= :derived reference-status) :emitted
          (= :skipped reference-status) :skipped
          :else :manual-review)]
    {:core/id (str prefix "/" (:path source) "#" (name (:kind source))
                   "-" index)
     :family/id family-id
     :core/namespace "clojure.core"
     :core/name (:reference/name reference)
     :core/local-name (:reference/local-name reference)
     :core/symbol (:resolved/symbol reference)
     :core/kind (:reference/kind reference)
     :core/operation (:reference/operation reference)
     :core/status reference-status
     :core/reason (:reference/reason reference)
     :source/namespace (:namespace entry)
     :source/path (:source/path entry)
     :source/blob (:source/blob entry)
     :test/path (:test/path entry)
     :test/blob (:test/blob entry)
     :observation/kind (:kind source)
     :observation/path (:path source)
     :observation/blob (if (= :test (:kind source))
                         (:test/blob entry)
                         (:source/blob entry))
     :observation/index index
     :reference/options (:reference/options reference)
     :reference/evidence (:reference/evidence reference)
     :extraction/status extraction-status
     :review/disposition :pending
     :review/evidence []}))

(defn core-references
  ([entries]
   (core-references entries {}))
  ([entries options]
   (let [family-id (or (:family/id options) :foundation)
         prefix (if (keyword? family-id) (name family-id) (str family-id))]
     (vec
      (sort-by
       :core/id
       (mapcat
        (fn [entry]
          (mapcat
           (fn [source]
             (map-indexed
              (fn [index reference]
                (core-reference-record
                 entry source family-id prefix index reference))
              (:references source)))
           (core-reference-sources entry)))
        entries))))))

(defn core-reference-accounting
  [references]
  (let [discovered (count references)
        emitted (count (filter (fn [reference]
                                (= :emitted (:extraction/status reference)))
                              references))
        skipped (count (filter (fn [reference]
                                (= :skipped (:extraction/status reference)))
                              references))
        manual (count (filter (fn [reference]
                                (= :manual-review (:extraction/status reference)))
                              references))]
    {:discovered discovered
     :emitted emitted
     :skipped skipped
     :manual-review manual
     :complete? (= discovered (+ emitted skipped manual))}))

(defn external-route-sources
  [entry]
  (vec
   (keep
    (fn [source]
      (if (and (string? (:path source))
               (vector? (:dependencies source)))
        source
        nil))
    [{:kind :source
      :path (:source/path entry)
     :dependencies
     (vec
      (map :dependency/name
           (or (:dependency/occurrences entry)
               (map (fn [dependency]
                      {:dependency/name dependency})
                    (:dependencies entry)))))
     :occurrences
     (vec
      (or (:dependency/occurrences entry)
          (map (fn [dependency]
                 {:dependency/name dependency})
               (:dependencies entry))))
     :symbols (vec (or (:dependency/symbols entry) []))}
    {:kind :test
     :path (:test/path entry)
     :dependencies
     (vec
      (map :dependency/name
           (or (:test/dependency-occurrences entry)
               (map (fn [dependency]
                      {:dependency/name dependency})
                    (:test/dependencies entry)))))
     :occurrences
     (vec
      (or (:test/dependency-occurrences entry)
          (map (fn [dependency]
                 {:dependency/name dependency})
               (:test/dependencies entry))))
     :symbols (vec (or (:test/dependency-symbols entry) []))}])))

(defn external-routes
  ([entries external-rank]
   (external-routes entries external-rank {}))
  ([entries external-rank options]
   (let [namespace-index-value (namespace-index entries)
         family-id (or (:family/id options) :foundation)
         prefix (if (keyword? family-id) (name family-id) (str family-id))]
     (vec
      (sort-by
       :external/id
       (reduce
        (fn [output entry]
          (into
           output
           (mapcat
            (fn [source]
              (vec
               (keep
                (fn [indexed]
                  (let [occurrence-index (first indexed)
                        occurrence (second indexed)
                        dependency (:dependency/name occurrence)]
                    (if (or (has? namespace-index-value dependency)
                            (not (str/starts-with? dependency "clojure.")))
                      nil
                      (external-route-record
                       entry
                       source
                       external-rank
                       family-id
                       prefix
                       occurrence-index
                       occurrence))))
                (map-indexed
                 (fn [index occurrence] [index occurrence])
                 (:occurrences source)))))
            (external-route-sources entry)))
         []
         entries)))))))

(defn external-route-accounting
  [routes]
  (let [discovered (count routes)
        emitted (count (filter (fn [route]
                                (= :emitted (:extraction/status route)))
                              routes))
        skipped (count (filter (fn [route]
                                (= :skipped (:extraction/status route)))
                              routes))
        manual (count (filter (fn [route]
                                (= :manual-review (:extraction/status route)))
                              routes))]
    {:discovered discovered
     :emitted emitted
     :skipped skipped
     :manual-review manual
     :complete? (= discovered (+ emitted skipped manual))}))

(defn tarjan-components
  "Returns deterministic strongly connected components for a dependency graph."
  [graph]
  (let [next-index (atom 0)
        indexes (atom {})
        lows (atom {})
        stack (atom [])
        active (atom #{})
        output (atom [])]
    (letfn
     [(visit
       [node]
       (let [index (deref next-index)]
         (swap! next-index inc)
         (swap! indexes assoc node index)
         (swap! lows assoc node index)
         (swap! stack conj node)
         (swap! active conj node))
       (doseq [dependency (get graph node [])]
         (if (not (has? (deref indexes) dependency))
           (do
             (visit dependency)
             (swap!
              lows
              assoc
              node
              (min (get (deref lows) node)
                   (get (deref lows) dependency))))
           (if (has? (deref active) dependency)
             (swap!
              lows
              assoc
              node
              (min (get (deref lows) node)
                   (get (deref indexes) dependency))))))
       (if (= (get (deref lows) node)
              (get (deref indexes) node))
         (loop [group []]
           (let [members (deref stack)
                 member (last members)
                 remaining (vec (butlast members))]
             (reset! stack remaining)
             (swap!
              active
              (fn [members]
                (set
                 (remove
                  (fn [value]
                    (= value member))
                  members))))
             (let [group (conj group member)]
               (if (= member node)
                 (swap! output conj (vec (sort group)))
                 (recur group)))))))]
     (doseq [node (sort (keys graph))]
       (if (not (has? (deref indexes) node))
         (visit node))))
    (vec (sort-by (fn [group] (str/join "|" group)) (deref output)))))

(defn component-index
  [components]
  (reduce
   (fn [output pair]
     (let [number (first pair)
           component (second pair)]
       (reduce
        (fn [index namespace]
          (assoc index namespace number))
        output
        component)))
   {}
   (map-indexed vector components)))

(defn component-requirements
  [graph components owners]
  (reduce
   (fn [output pair]
     (let [number (first pair)
           component (second pair)
           required
           (sorted-unique
            (reduce
             (fn [values namespace]
               (into
                values
                (keep
                 (fn [dependency]
                   (let [owner (get owners dependency)]
                     (if (= owner number) nil owner)))
                 (get graph namespace []))))
             []
             component))]
       (assoc output number required)))
   {}
   (map-indexed vector components)))

(defn component-ranks
  [requirements]
  (let [memo (atom {})]
    (letfn
     [(rank
       [number]
       (if (has? (deref memo) number)
         (get (deref memo) number)
         (let [dependencies (get requirements number [])
               value
               (if (empty? dependencies)
                 0
                 (inc
                  (apply max
                         (map rank dependencies))))]
           (swap! memo assoc number value)
           value)))]
     (reduce
      (fn [output number]
        (assoc output number (rank number)))
      {}
      (sort (keys requirements))))))

(defn graph-plan
  [entries]
  (let [graph (dependency-graph entries)
        components (tarjan-components graph)
        owners (component-index components)
        requirements
        (component-requirements graph components owners)
        ranks (component-ranks requirements)]
    {:graph graph
     :components components
     :owners owners
     :requirements requirements
     :ranks ranks}))

(defn compile-entry
  [entry graph-plan]
  (let [owner (get (:owners graph-plan) (:namespace entry))
        component (get (:components graph-plan) owner)
        dependencies (get (:graph graph-plan) (:namespace entry))]
    (assoc
     (assoc
      (assoc entry
             :dependency/rank (get (:ranks graph-plan) owner))
      :dependency/component component)
     :dependency/cycle
     (or
      (> (count component) 1)
      (not
       (empty?
        (filter
         (fn [dependency]
           (= dependency (:namespace entry)))
         dependencies)))))))

(defn compile-entries
  [entries]
  (let [plan (graph-plan entries)]
    (vec
     (sort-by
      (fn [entry]
        [(:dependency/rank entry)
         (:namespace entry)])
      (map
       (fn [entry]
         (compile-entry entry plan))
       entries)))))

(defn sha?
  [value]
  (profile/sha? value))

(defn candidate-valid?
  [profile-value candidate]
  (and
   (map? candidate)
   (has? (:candidate/states profile-value)
         (:candidate/state candidate))
   (or (nil? (:target/path candidate))
       (string? (:target/path candidate)))
   (or (nil? (:target/symbol candidate))
       (string? (:target/symbol candidate)))))

(defn evidence-valid?
  [evidence]
  (and
   (map? evidence)
   (string? (:foundation/path evidence))
   (sha? (:foundation/blob evidence))
   (string? (:hara/path evidence))))

(defn review-errors
  [profile-value entry]
  (let [disposition (:review/disposition entry)
        evidence (vec (or (:review/evidence entry) []))]
    (vec
     (concat
      (if (profile/allowed-disposition? profile-value disposition)
        []
        [{:type :tool.migrate/invalid-disposition
          :namespace (:namespace entry)
          :disposition disposition}])
      (if (and
           (profile/reviewed-disposition? profile-value disposition)
           (empty? evidence))
        [{:type :tool.migrate/review-evidence-required
          :namespace (:namespace entry)
          :disposition disposition}]
        [])
      (keep
       (fn [record]
         (if (evidence-valid? record)
           nil
           {:type :tool.migrate/invalid-review-evidence
            :namespace (:namespace entry)
            :evidence record}))
       evidence)))))

(defn entry-errors
  [profile-value entry]
  (vec
   (concat
    (if (string? (:namespace entry))
      []
      [{:type :tool.migrate/namespace-required
        :entry entry}])
    (if (and
         (string? (:source/path entry))
         (sha? (:source/blob entry)))
      []
      [{:type :tool.migrate/source-evidence-required
        :namespace (:namespace entry)}])
    (keep
     (fn [candidate]
       (if (candidate-valid? profile-value candidate)
         nil
         {:type :tool.migrate/invalid-candidate
          :namespace (:namespace entry)
          :candidate candidate}))
     (or (:candidate/matches entry) []))
    (review-errors profile-value entry))))

(defn duplicate-values
  [values]
  (let [counts (frequencies values)]
    (vec
     (sort
      (keep
       (fn [value]
         (if (> (get counts value) 1)
           value
           nil))
       (keys counts))))))

(defn validate-entries
  [profile-value entries]
  (vec
   (concat
    (map
     (fn [namespace]
       {:type :tool.migrate/duplicate-namespace
        :namespace namespace})
     (duplicate-values (map :namespace entries)))
    (mapcat
     (fn [entry]
       (entry-errors profile-value entry))
     entries))))

(defn reviewed?
  [profile-value entry]
  (and
   (profile/reviewed-disposition?
    profile-value
    (:review/disposition entry))
   (empty? (review-errors profile-value entry))))

(defn pending?
  [entry]
  (= :pending (:review/disposition entry)))

(defn next-review
  [entries]
  (let [pending (vec (filter pending? entries))]
    (if (empty? pending)
      []
      (let [rank (apply min (map :dependency/rank pending))]
        (sorted-unique
         (map
          :namespace
          (filter
           (fn [entry]
             (= rank (:dependency/rank entry)))
           pending)))))))

(defn migration-ready?
  [profile-value entry]
  (and
   (reviewed? profile-value entry)
   (has? +migration-dispositions+
         (:review/disposition entry))
   (= :ready (:dry-run/status entry))))

(defn next-unblocked-migration
  [profile-value entries]
  (let [ready (vec (filter (fn [entry]
                             (migration-ready? profile-value entry))
                           entries))]
    (if (empty? ready)
      []
      (let [rank (apply min (map :dependency/rank ready))]
        (sorted-unique
         (map
          :namespace
          (filter
           (fn [entry]
             (= rank (:dependency/rank entry)))
           ready)))))))

(declare render-edn)

(defn render-map-entry
  [entry]
  (str (render-edn (first entry))
       " "
       (render-edn (second entry))))

(defn render-edn
  "Renders deterministic EDN without collection iteration-order dependence."
  [value]
  (cond
    (map? value)
    (let [entries
          (sort-by
           (fn [entry]
             (render-edn (first entry)))
           (vec value))]
      (str "{" (str/join " " (map render-map-entry entries)) "}"))

    (set? value)
    (let [values (sort-by render-edn (vec value))]
      (str "#{" (str/join " " (map render-edn values)) "}"))

    (vector? value)
    (str "[" (str/join " " (map render-edn value)) "]")

    (sequential? value)
    (str "(" (str/join " " (map render-edn value)) ")")

    :else
    (pr-str value)))

(defn corpus-document
  ([profile-value entries]
   (corpus-document profile-value entries {}))
  ([profile-value entries options]
   (let [profile-value (profile/assert-profile profile-value)
         entries (compile-entries entries)
         routes (external-routes entries (:external/rank profile-value) options)
         core-observations (core-references entries options)
         errors (validate-entries profile-value entries)]
    (if (not (empty? errors))
      (throw
       (ex :tool.migrate/invalid-corpus
           {:ex/message "Foundation migration corpus is invalid"
            :errors errors})))
    {:document/type :code-migrate-corpus
     :document/version 1
     :profile/id (:profile/id profile-value)
     :foundation/repository (:foundation/repository profile-value)
     :foundation/revision (:foundation/revision profile-value)
     :foundation/tree (:foundation/tree profile-value)
     :external/rank (:external/rank profile-value)
     :foundation/rank-base (:foundation/rank-base profile-value)
     :external/routes routes
     :external/accounting (external-route-accounting routes)
     :core/references core-observations
     :core/accounting (core-reference-accounting core-observations)
     :namespaces entries
     :next/review (next-review entries)
     :next/unblocked-migration
     (next-unblocked-migration profile-value entries)})))

(defn encode-retired-evidence
  "Keeps immutable Foundation identifiers semantically exact without making
   them look like live retired Hara namespaces to repository hard-cut scans."
  [source]
  (str/replace
   (str/replace source (str "std." "fs") "std.\\u0066s")
   (str "std/" "fs")
   "std/\\u0066s"))

(defn corpus-source
  [document]
  (str (encode-retired-evidence (render-edn document)) "\n"))

(defn count-reviewed
  [profile-value entries]
  (count
   (filter
    (fn [entry]
      (reviewed? profile-value entry))
    entries)))

(defn report-source
  [profile-value document]
  (let [entries (:namespaces document)
        external (:external/routes document)]
    (str
     "# Foundation migration audit: `"
     (name (:profile/id profile-value))
     "`\n\n"
     "- Foundation repository: `"
     (:foundation/repository profile-value)
     "`\n"
     "- Pinned revision: `"
     (:foundation/revision profile-value)
     "`\n"
     "- Pinned tree: `"
     (:foundation/tree profile-value)
     "`\n"
     "- Foundation namespaces: " (count entries) "\n"
     "- External dependency routes: " (count external) "\n"
     "- Reviewed namespaces: "
     (count-reviewed profile-value entries)
     "\n"
     "- Pending namespaces: "
     (count (filter pending? entries))
     "\n\n"
     "## Next review\n\n"
     (if (empty? (:next/review document))
       "No pending namespace remains.\n"
       (str/join
        ""
        (map
         (fn [namespace]
           (str "- `" namespace "`\n"))
         (:next/review document))))
     "\n## Next unblocked migration\n\n"
     (if (empty? (:next/unblocked-migration document))
       "No reviewed dry-run is currently marked ready.\n"
       (str/join
        ""
        (map
         (fn [namespace]
           (str "- `" namespace "`\n"))
         (:next/unblocked-migration document))))))
)
