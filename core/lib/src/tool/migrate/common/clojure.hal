(ns tool.migrate.common.clojure
  (:config {:role :internal})
  (:require [code.framework :as framework]
            [std.block :as block]
            [std.foundation.string :as str]
            [tool.migrate.common.block :as nav]
            [work.base :as work]
            [work.flow.task.command-task :as task]
            [tool.migrate.common.rule :as rule]
            [tool.migrate.common.rules :as declarations]))

(def task-id :tool.migrate/clojure)
(def task-version 2)

(defn source-path
  [unit]
  (or (:source/path unit)
      (:path unit)))

(defn item-id
  [unit]
  (str (source-path unit)
       " -> "
       (or (:target/path unit) (source-path unit))))

(defn source-root
  [unit]
  (or (:source/root unit) ""))

(defn source-text
  [unit]
  (if (has? unit :source/text)
    (:source/text unit)
    (:source unit)))

(defn target-root
  [unit]
  (or (:target/root unit) ""))

(defn target-text
  [unit]
  (if (has? unit :target/text)
    (:target/text unit)
    (:target unit)))

(defn strip-leading-separator
  [value]
  (if (and (string? value)
           (not (empty? value))
           (= "/" (str/slice value 0 1)))
    (str/slice value 1 (count value))
    value))

(defn strip-trailing-separator
  [value]
  (if (and (string? value)
           (not (empty? value))
           (str/ends-with? value "/"))
    (str/slice value 0 (dec (count value)))
    value))

(defn relative-source-path
  [path root]
  (let [prefix (strip-trailing-separator root)]
    (if (and (not (empty? prefix))
             (or (= path prefix)
                 (str/starts-with? path (str prefix "/"))))
      (strip-leading-separator
       (str/slice path (count prefix) (count path)))
      path)))

(defn hal-path
  [path]
  (if (and (string? path)
           (or (str/ends-with? path ".clj")
               (str/ends-with? path ".cljc")))
    (str (str/slice path 0 (- (count path) (if (str/ends-with? path ".cljc") 5 4))) ".hal")
    (throw
     (ex :io {:source/path path} :ex/message "Clojure source path must end in .clj or .cljc"))))

(defn join-path
  [root path]
  (let [root (strip-trailing-separator root)
        path (strip-leading-separator path)]
    (if (empty? root)
      path
      (str root "/" path))))

(defn target-path
  [unit]
  (or (:target/path unit)
      (join-path
       (target-root unit)
       (hal-path
        (relative-source-path
         (source-path unit)
         (source-root unit))))))

(defn translation-options
  [unit options]
  (merge
   (or (:translation/options unit) {})
   (or options {})))

(defn assert-source-unit
  [unit]
  (if (not (map? unit))
    (throw
     (ex :argument {:unit unit} :ex/message "Clojure translation source unit must be a map")))
  (if (not (string? (source-path unit)))
    (throw
     (ex :io {:unit unit} :ex/message "Clojure translation source unit requires :source/path")))
  (if (not (string? (source-text unit)))
    (throw
     (ex :io {:source/path (source-path unit)} :ex/message "Clojure translation source unit requires :source/text")))
  unit)

(defn source-unit
  "Normalises one host-prepared Clojure source unit without reading or writing
   the filesystem. Explicit target paths win; otherwise the path is derived
   from source and target roots and receives the .hal suffix."
  ([unit]
   (source-unit unit {}))
  ([unit options]
   (let [unit (assert-source-unit unit)]
     (merge
      unit
      {:source/path (source-path unit)
       :source/root (source-root unit)
       :source/text (source-text unit)
       :target/root (target-root unit)
       :target/path (target-path unit)
       :target/text (target-text unit)
       :translation/options (translation-options unit options)}))))

(defn unique-sorted
  [values]
  (vec
   (sort
    (keys
     (reduce
      (fn [output value]
        (if value (assoc output value true) output))
      {}
      values)))))

(defn dependency-clause?
  [clause]
  (let [head (nav/form-head clause)]
    (or (= head ":require")
        (= head ":use"))))

(defn dependency-entry-name
  [entry]
  (let [name
        (cond
          (block/token? entry) (block/string entry)
          (block/container? entry) (nav/form-head entry)
          :else nil)]
    (if (and name
             (not (str/starts-with? name ":")))
      name
      nil)))

(defn clause-dependencies
  [clause]
  (vec
   (keep
    dependency-entry-name
    (rest (nav/code-children clause)))))

(defn dependency-occurrences
  "Returns dependency entries in source order, retaining parser evidence."
  [input]
  (vec
   (mapcat
    (fn [clause]
      (keep
       (fn [entry]
         (let [name (dependency-entry-name (nav/current entry))]
           (if name
             {:dependency/name name
              :dependency/evidence (nav/evidence entry)}
             nil)))
       (rest (nav/code-child-locations clause))))
    (filter dependency-clause?
            (nav/namespace-clause-locations (nav/block-input input))))))

(defn dependencies
  [input]
  (unique-sorted
   (map :dependency/name
        (dependency-occurrences input))))

(defn namespace-aliases
  [input]
  (reduce
   (fn [output clause]
     (reduce
      (fn [output entry]
        (let [values (vec (nav/code-children entry))]
          (if (and (vector? values)
                   (<= 3 (count values))
                   (= ":as" (block/string (nth values 1))))
            (assoc output
                   (block/string (nth values 2))
                   (block/string (first values)))
            output)))
      output
      (rest (nav/code-children clause))))
   {}
   (filter dependency-clause?
           (nav/namespace-clauses (nav/block-input input)))))

(defn namespace-refers
  "Returns unqualified symbols imported by dependency :refer clauses."
  [input]
  (reduce
   (fn [output clause]
     (reduce
      (fn [output entry]
        (let [values (vec (nav/code-children entry))
              namespace (if (empty? values)
                          nil
                          (block/string (first values)))]
          (if (nil? namespace)
            output
            (loop [remaining (vec (rest values))
                   output output]
              (if (or (empty? remaining)
                      (= 1 (count remaining)))
                output
                (if (has? #{":refer" ":only"}
                          (block/string (first remaining)))
                  (let [refer (block/value (second remaining))]
                    (reduce
                     (fn [output symbol]
                       (assoc output (str symbol) namespace))
                     output
                     (if (vector? refer) refer [])))
                  (recur (vec (drop 2 remaining)) output)))))))
      output
      (rest (nav/code-children clause))))
   {}
   (filter dependency-clause?
           (nav/namespace-clauses (nav/block-input input)))))

(def +clojure-core-special-forms+
  #{"." "catch" "def" "do" "finally" "fn" "fn*" "if" "let" "letfn"
    "loop" "monitor-enter" "monitor-exit" "new" "quote" "recur" "set!"
    "throw" "try" "var"})

(def +clojure-core-macros+
  #{"->" "->>" "as->" "assert" "binding" "case" "comment" "cond" "cond->"
    "cond->>" "condp" "declare" "definline" "definterface" "defmacro"
    "defmethod" "defmulti" "defn" "defn-" "defonce" "defprotocol"
    "defrecord" "defstruct" "deftype" "doto" "doseq" "dotimes"
    "extend-protocol" "extend-type" "for" "future" "if-let" "if-not"
    "if-some" "lazy-cat" "lazy-seq" "locking" "ns" "time" "when"
    "when-first" "when-let" "when-not" "when-some" "while" "with-bindings"
    "with-bindings*" "with-in-str" "with-loading-context" "with-local-vars"
    "with-meta" "with-open" "with-out-str" "with-precision"})

(def +clojure-core-intrinsics+
  #{"*" "+" "-" "/" "<" "<=" "=" ">" ">=" "==" "and" "or" "not" "recur"})

;; This observed inventory covers the public core names used by the pinned
;; Foundation source/test graph; unobserved Clojure core names are not emitted.
