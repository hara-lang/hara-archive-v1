     "macroexpand-1" "make-array" "make-hierarchy" "memoize" "methods" "munge"
     "nat-int?" "neg-int?" "newline" "num" "numerator" "object-array" "parents"
     "parse-double" "parse-long" "pmap" "pos-int?" "pos?" "prefer-method"
     "print-method" "proxy" "rand" "rand-int" "rand-nth" "random-sample"
