   (into
    (into +clojure-core-special-forms+ +clojure-core-macros+)
    +clojure-core-intrinsics+)))

(defn dependency-idiom
  "Classifies a dependency by the observable behavior it contributes."
  [namespace]
  (cond
    (str/starts-with? namespace "clojure.string") :text
    (str/starts-with? namespace "clojure.set") :collection
    (str/starts-with? namespace "clojure.edn") :serialization
    (str/starts-with? namespace "clojure.java.io") :host-io
    (str/starts-with? namespace "clojure.pprint") :formatting
    (str/starts-with? namespace "clojure.tools.reader") :reader
    (str/starts-with? namespace "clojure.lang") :runtime-type
    (str/starts-with? namespace "clojure.zip") :tree
    (= namespace "clojure.core") :core
    :else :namespace))

(defn dependency-operation
  "Classifies a dependency reference by its call-site operation."
  [namespace name]
  (cond
    (and (str/starts-with? namespace "clojure.set")
         (has? #{"difference" "intersection" "union" "select"
                 "subset?" "superset?" "index" "join" "map-invert"}
               name))
    :set-algebra

    (and (str/starts-with? namespace "clojure.string")
         (has? #{"trim" "triml" "trimr"} name))
    :string-trimming

    (and (str/starts-with? namespace "clojure.string")
         (has? #{"join" "capitalize" "lower-case" "upper-case"
                 "reverse" "escape"}
               name))
    :string-aggregation

    (and (str/starts-with? namespace "clojure.string")
         (has? #{"split" "split-lines" "replace" "replace-first"} name))
    :string-rewrite

    (and (str/starts-with? namespace "clojure.core")
         (has? #{"subs" "subvec"} name))
    :string-slice

    (and (= namespace "clojure.core")
         (= name "disj"))
    :set-removal

    (and (= namespace "clojure.core")
         (= name "dissoc"))
    :associative-removal

    (and (str/starts-with? namespace "clojure.core")
         (has? #{"map" "mapcat" "mapv" "filter" "filterv" "reduce"
                 "reduce-kv" "keep" "keep-indexed" "remove" "take"
                 "drop" "into" "conj" "assoc" "update" "get" "get-in"
                 "merge" "select-keys" "seq" "first" "rest" "next"}
               name))
    :collection-operation

    (and (str/starts-with? namespace "clojure.tools.reader.reader-types")
         (not (empty? name)))
    :reader-state

    (str/starts-with? namespace "clojure.tools.reader")
    :reader-consumption

    (str/starts-with? namespace "clojure.edn")
    :edn-reading

    (str/starts-with? namespace "clojure.java.io")
    :host-io

    (str/starts-with? namespace "clojure.pprint")
    :pretty-printing

    (str/starts-with? namespace "clojure.lang")
    :persistent-collection-type

    (str/starts-with? namespace "clojure.zip")
    :tree-navigation

    (= namespace "clojure.core")
    :core-operation

    :else :namespace-operation))

(defn namespace-clause-option
  [input clause-head option]
  (let [clause (nav/namespace-clause-location input clause-head)
        children (if clause
                   (vec (rest (nav/code-child-locations clause)))
                   [])]
    (loop [remaining children]
      (if (or (empty? remaining)
              (= 1 (count remaining)))
        nil
        (if (= option (block/string (nav/current (first remaining))))
          (block/value (nav/current (second remaining)))
          (recur (vec (drop 2 remaining))))))))

(defn core-reference-options
  "Returns the effective :refer-clojure controls for one source namespace."
  [input]
  (let [only (namespace-clause-option input ":refer-clojure" ":only")
        exclude (namespace-clause-option input ":refer-clojure" ":exclude")
        rename (namespace-clause-option input ":refer-clojure" ":rename")]
    {:only (if (vector? only) (set (map str only)) nil)
     :exclude (if (vector? exclude) (set (map str exclude)) #{})
     :rename (if (map? rename)
               (reduce-kv (fn [output source local]
                            (assoc output (str local) (str source)))
                          {}
                          rename)
               {})}))

(defn core-reference-name
  [name options]
  (if (get (:rename options) name)
    (get (:rename options) name)
    (if (some (fn [source]
                (= source name))
              (vals (:rename options)))
      nil
      name)))

(defn core-reference-enabled?
  [name options core-symbols]
  (and (has? core-symbols name)
       (not (has? (:exclude options) name))
       (or (nil? (:only options))
           (has? (:only options) name))))

(defn binding-pattern-symbols
  [value]
  (cond
    (symbol? value)
    (if (= "&" (str value)) #{} #{(str value)})

    (vector? value)
    (reduce
     (fn [output child]
       (into output (binding-pattern-symbols child)))
     #{}
     value)

    (map? value)
    (reduce
     (fn [output child]
       (into output (binding-pattern-symbols child)))
     #{}
     (vals value))

    (set? value)
    (reduce
     (fn [output child]
       (into output (binding-pattern-symbols child)))
     #{}
     value)

    :else #{}))

(defn binding-vector-symbols
  [value]
  (if (vector? value)
    (loop [remaining value
           output #{}]
      (if (empty? remaining)
        output
        (recur (vec (drop 2 remaining))
               (into output (binding-pattern-symbols (first remaining))))))
    #{}))

(defn function-binding-symbols
  [tail]
  (let [tail (if (and (not (empty? tail))
                      (symbol? (first tail)))
               (vec (rest tail))
               tail)
        parameter-vectors
        (if (vector? (first tail))
          [(first tail)]
          (keep
           (fn [arity]
             (if (and (list? arity)
                      (vector? (first arity)))
               (first arity)
               nil))
           tail))]
    (reduce
     (fn [output parameters]
       (into output (binding-pattern-symbols parameters)))
     #{}
     parameter-vectors)))

(defn lexical-bindings
  [value]
  (let [form (block/value value)
        head (if (list? form) (str (first form)) nil)
        tail (if (list? form) (vec (rest form)) [])]
    (cond
      (has? #{"let" "loop" "for" "doseq" "with-open"
              "with-local-vars" "binding"} head)
      (binding-vector-symbols (first tail))

      (has? #{"letfn"} head)
      (binding-pattern-symbols (first tail))

      (has? #{"fn" "fn*" "defn" "defn-" "defmacro"} head)
      (function-binding-symbols tail)

      :else #{})))

(defn ancestor-locations
  [location]
  (loop [parent (:parent location)
         output []]
    (if (nil? parent)
      output
      (recur (:parent parent) (conj output parent)))))

(defn namespace-defined-symbols
  [input]
  (unique-sorted
   (keep
    nav/definition-name
    (nav/definition-locations (nav/block-input input)))))

(defn core-reference-context
  [location namespace-symbols]
  (let [ancestors (ancestor-locations location)
        quoted?
        (loop [remaining ancestors]
          (if (empty? remaining)
            false
            (let [ancestor (first remaining)
                  value (nav/current ancestor)
                  tag (block/tag value)]
              (cond
                (has? #{:unquote :unquote-splice} tag) false
                (has? #{:quote :syntax} tag) true
                (has? #{"quote" "syntax-quote"}
                      (nav/form-head ancestor)) true
                :else (recur (rest remaining))))))
        binding? (some (fn [ancestor]
                         (has? (lexical-bindings (nav/current ancestor))
                               (block/string (nav/current location))))
                       ancestors)
        namespace-shadow? (has? namespace-symbols
                                 (block/string (nav/current location)))]
    (cond
      quoted? {:status :skipped :reason :quoted-data}
      binding? {:status :shadowed :reason :lexical-binding}
      namespace-shadow? {:status :shadowed :reason :namespace-binding}
      :else {:status :derived :reason nil})))

(defn core-reference-kind
  [name]
  (cond
    (has? +clojure-core-special-forms+ name) :special-form
    (has? +clojure-core-macros+ name) :macro
    (has? +clojure-core-intrinsics+ name) :intrinsic
    :else :var))

(declare dependency-symbol-references)

(defn core-reference-record
  ([location source-name core-name namespace-symbols]
   (core-reference-record
    location source-name core-name namespace-symbols {}))
  ([location source-name core-name namespace-symbols options]
   (let [context (core-reference-context location namespace-symbols)
         status (:status context)]
     {:source/symbol source-name
      :resolved/symbol (if (= :derived status)
                         (str "clojure.core/" core-name)
                         nil)
      :reference/namespace "clojure.core"
      :reference/name core-name
      :reference/local-name source-name
      :reference/idiom :core
      :reference/operation (dependency-operation "clojure.core" core-name)
      :reference/kind (core-reference-kind core-name)
      :reference/status status
      :reference/reason (:reason context)
      :reference/options options
      :reference/evidence (nav/evidence location)})))

(defn core-symbol-references
  "Collects implicit and qualified clojure.core references with resolution
   controls and lexical-shadowing evidence."
  ([input]
   (core-symbol-references input +clojure-core-symbols+))
  ([input core-symbols]
   (let [root (nav/block-input input)
         options (core-reference-options root)
         namespace-refers-value (namespace-refers root)
         namespace-symbols
         (set
          (concat
           (namespace-defined-symbols root)
           (keep
            (fn [entry]
              (if (= "clojure.core" (second entry))
                nil
                (first entry)))
            (vec namespace-refers-value))))
         qualified
         (vec
          (map
           (fn [reference]
             (let [location
                   (nav/location-at
                    root
                    (get-in reference [:reference/evidence :path]))]
               (let [record
                     (merge
                      reference
                      (core-reference-record
                       location
                       (:source/symbol reference)
                       (:reference/name reference)
                       namespace-symbols
                       options))]
                 (if (has? core-symbols (:reference/name reference))
                   record
                   (merge
                    record
                    {:resolved/symbol nil
                     :reference/status :manual-review
                     :reference/reason :unknown-core-symbol})))))
           (filter
            (fn [reference]
              (= "clojure.core" (:reference/namespace reference)))
            (dependency-symbol-references root ["clojure.core"]))))
         implicit
         (keep
          (fn [location]
            (let [value (nav/current location)
                  token (if (block/token? value) (block/string value) nil)
                  qualified? (and token
                                  (< 0 (or (str/index-of token "/") -1)))
                  core-name (if token
                              (core-reference-name token options)
                              nil)]
              (if (and token
                       (symbol? (block/value value))
                       (not qualified?)
                       core-name
                       (core-reference-enabled? core-name
                                                options
                                                core-symbols)
                       (not (some nav/namespace-form?
                                  (ancestor-locations location))))
                (core-reference-record location
                                       token
                                       core-name
                                       namespace-symbols
                                       options)
                nil)))
          (nav/walk-locations root))]
     (vec
      (sort-by
       (fn [reference]
         [(:reference/status reference)
          (:resolved/symbol reference)
          (:source/symbol reference)
          (get-in reference [:reference/evidence :path])])
     (concat qualified implicit))))))

(defn core-reference-matches
  "Returns executable references to one unshadowed Clojure core Var.

   The returned values follow the function-rule matcher contract and retain
   the parser evidence needed by diagnostics and deterministic rewrites."
  [input name]
  (vec
   (keep
    (fn [reference]
      (if (and (= "clojure.core" (:reference/namespace reference))
               (= name (:reference/name reference))
               (= :derived (:reference/status reference)))
        (merge
         (:reference/evidence reference)
         (select-keys reference
                      [:source/symbol :resolved/symbol
                       :reference/namespace :reference/name
                       :reference/status :reference/reason]))
        nil))
    (core-symbol-references input))))

(defn match-disj
  "Matches unshadowed executable Clojure core `disj` references."
  [root context]
  (core-reference-matches root "disj"))

(defn rewrite-disj
  "Rewrites one matched core `disj` reference to Hara `dissoc`."
  [root match context]
  (let [source (:source match)
        qualified? (and (string? source)
                        (< 0 (or (str/index-of source "/") -1)))
        target (if qualified? "std.foundation/dissoc" "dissoc")]
    {:root
     (nav/root-block
      (nav/replace-at root (:path match) target))
     :match match}))

(defn function-resolver
  "Resolves built-in semantic migration functions without hiding explicit
   resolver injection used by embedders and policy-specific migrations."
  [value]
  (case (str value)
    "tool.migrate.common.clojure/match-disj" match-disj
    "tool.migrate.common.clojure/rewrite-disj" rewrite-disj
    nil))

(defn dependency-symbol-references
  "Collects qualified and explicitly referred tokens with deterministic
   namespace and call-site resolution."
  [input dependencies]
  (let [aliases (namespace-aliases input)
        refers (namespace-refers input)
        dependency-index
        (reduce (fn [output dependency]
                  (assoc output dependency true))
                {"clojure.core" true}
                dependencies)]
    (vec
     (sort-by
      (fn [reference]
        [(:resolved/symbol reference) (:source/symbol reference)])
      (keep
       (fn [location]
         (let [value (nav/current location)]
           (if (block/token? value)
             (let [text (block/string value)
                   separator (or (str/index-of text "/") -1)]
               (if (< 0 separator)
                 (let [alias (str/slice text 0 separator)
                       name (str/slice text (inc separator) (count text))
                       namespace (or (get aliases alias) alias)]
                   (if (has? dependency-index namespace)
                     {:source/symbol text
                      :resolved/symbol (str namespace "/" name)
                      :reference/namespace namespace
                      :reference/name name
                      :reference/idiom (dependency-idiom namespace)
                      :reference/operation
                      (dependency-operation namespace name)
                      :reference/evidence (nav/evidence location)}
                     nil))
                 (let [namespace (get refers text)
                       enabled? (and namespace
                                     (has? dependency-index namespace)
                                     (not (some nav/namespace-form?
                                                (ancestor-locations location))))]
                   (if enabled?
                      {:source/symbol text
                       :resolved/symbol (str namespace "/" text)
                       :reference/namespace namespace
                       :reference/name text
                       :reference/idiom (dependency-idiom namespace)
                       :reference/operation
                       (dependency-operation namespace text)
                       :reference/evidence (nav/evidence location)}
                      nil))))
             nil)))
       (nav/walk-locations (nav/block-input input)))))))

(def +non-binding-definitions+
  #{"defmethod" "defimpl" "defimpl.xt"})

(defn public-definition?
  [location]
  (let [head (nav/form-head location)]
    (and (nav/definition-location? location)
         (not (str/ends-with? head "-"))
         (not (has? +non-binding-definitions+ head)))))

(defn public-symbols
  [input]
  (unique-sorted
   (keep
    nav/definition-name
    (filter public-definition?
            (nav/definition-locations input)))))

(defn source-summary
  [input]
  (let [root (nav/block-input input)]
    {:namespace (nav/namespace-name root)
     :dependencies (dependencies root)
     :public-symbols (public-symbols root)
     :core/symbols (core-symbol-references root)}))

(defn namespace-shape
  "Returns the stable namespace, dependency, and public-binding shape for
   source text, a block tree, or an existing shape map."
  [input]
  (let [summary
        (if (and (map? input)
                 (has? input :namespace)
                 (has? input :dependencies)
                 (has? input :public-symbols))
          input
          (source-summary input))]
    {:namespace (:namespace summary)
     :dependencies
     (unique-sorted (or (:dependencies summary) []))
     :public-symbols
     (unique-sorted (or (:public-symbols summary) []))}))

(defn value-index
  [values]
  (reduce
   (fn [output value]
     (assoc output value true))
   {}
   values))

(defn values-only-in
  [left right]
  (let [right-index (value-index right)]
    (vec
     (filter
      (fn [value]
        (not (has? right-index value)))
      left))))

(defn namespace-shape-check
  "Compares two namespace shapes. A namespace map can express an intentional
   ownership move; optional extra dependencies or public symbols must be
   explicitly allowed."
  ([expected actual]
   (namespace-shape-check expected actual {}))
  ([expected actual options]
   (let [expected (namespace-shape expected)
         actual (namespace-shape actual)
         namespace-map (or (:namespace-map options) {})
         expected-namespace
         (or (get namespace-map (:namespace expected))
             (:namespace expected))
         missing-dependencies
         (values-only-in (:dependencies expected)
                         (:dependencies actual))
         unexpected-dependencies
         (values-only-in (:dependencies actual)
                         (:dependencies expected))
         missing-public-symbols
         (values-only-in (:public-symbols expected)
                         (:public-symbols actual))
         unexpected-public-symbols
         (values-only-in (:public-symbols actual)
                         (:public-symbols expected))
         namespace-match?
         (= expected-namespace (:namespace actual))
         dependencies-match?
         (and
          (empty? missing-dependencies)
          (or (:allow-extra-dependencies? options)
              (empty? unexpected-dependencies)))
         public-symbols-match?
         (and
          (empty? missing-public-symbols)
          (or (:allow-extra-public-symbols? options)
              (empty? unexpected-public-symbols)))]
     {:conformant?
      (and namespace-match?
           dependencies-match?
           public-symbols-match?)
      :expected expected
      :actual actual
      :namespace
      {:expected expected-namespace
       :actual (:namespace actual)
       :match? namespace-match?}
      :dependencies
      {:missing missing-dependencies
       :unexpected unexpected-dependencies
       :match? dependencies-match?}
      :public-symbols
      {:missing missing-public-symbols
       :unexpected unexpected-public-symbols
       :match? public-symbols-match?}})))

(defn translated-namespace-shape-check
  "Translates Clojure source with tool.migrate.common.project and compares its resulting
   namespace shape to the reviewed Hara target shape."
  ([source target]
   (translated-namespace-shape-check source target {}))
  ([source target options]
   (let [translation
         (rule/translate-source
          source
          (merge {:mode :review}
                 (or (:translation/options options) {})))
         check
         (namespace-shape-check
          (:output translation)
          target
          (or (:shape/options options) {}))]
     (assoc
      check
      :translation
      {:output (:output translation)
       :changed (:changed translation)
       :rules/matched
       (vec (map :rule/id (:rules/matched translation)))
       :rules/applied
       (vec (map :rule/id (:rules/applied translation)))}))))

(defn catalog-field
  [value keyword-key string-key]
  (if (and (map? value) (has? value keyword-key))
    (get value keyword-key)
    (if (map? value) (get value string-key) nil)))

(defn catalog-symbol-routes
  [entry]
  (vec (or (catalog-field entry :symbol_routes "symbol_routes") [])))

(defn catalog-symbol-route
  [entry symbol]
  (first
   (filter
    (fn [route]
      (= symbol
         (catalog-field route :source_symbol "source_symbol")))
    (catalog-symbol-routes entry))))

(defn catalog-migration-summary
  [entry]
  (or (catalog-field entry :migration "migration") {}))

(defn catalog-target-summary
  [entry]
  (let [target (first (or (catalog-field entry :targets "targets") []))]
    {:namespace (catalog-field target :namespace "namespace")
     :dependencies []
     :public-symbols
     (unique-sorted
      (keep (fn [route]
              (catalog-field route :target_symbol "target_symbol"))
            (catalog-symbol-routes entry)))}))

(defn catalog-route-diagnostic
  [route]
  (let [state (keyword (catalog-field route :state "state"))
        safety (keyword (catalog-field route :safety "safety"))
        source-symbol (catalog-field route :source_symbol "source_symbol")
        target-namespace (catalog-field route :target_namespace "target_namespace")
        target-symbol (catalog-field route :target_symbol "target_symbol")]
    {:type (cond
             (= state :implemented) :tool.migrate/migration-implemented
             (= state :obsolete) :tool.migrate/migration-obsolete
             (= state :host-only) :tool.migrate/unsupported
             :else :tool.migrate/migration-pending)
     :level (cond
              (= state :implemented) :info
              (or (= state :obsolete) (= state :host-only)) :warning
              :else :notice)
     :safety safety
     :migration/state state
     :source/symbol source-symbol
     :target/namespace target-namespace
     :target/symbol target-symbol
     :message (catalog-field route :message "message")}))

(defn catalog-diagnostics
  [entry]
  (vec (map catalog-route-diagnostic (catalog-symbol-routes entry))))

(defn provenance
  [unit translation]
  {:source/path (:source/path unit)
   :source/root (:source/root unit)
   :source/sha256 (:source/sha256 unit)
   :target/path (:target/path unit)
   :target/root (:target/root unit)
   :translation/mode (:mode translation)
   :ruleset/catalog :hara/code-migration
   :ruleset/count (count rule/+ruleset+)})

(defn selected-rules
  [options]
  (if (:rules options)
    (:rules options)
    (if (:catalog options)
      (declarations/rules options)
      rule/+ruleset+)))

(defn migration-result
  "Translates one prepared source unit into a pure edit record. The unit owns
   source and target bytes; this function owns no discovery, filesystem, or
   write capability."
  ([unit]
   (translate-source-unit unit {}))
  ([unit options]
   (let [unit (source-unit unit options)
         translation-options-value
         (let [value (translation-options unit options)]
           (if (:function-resolver value)
             value
             (assoc value :function-resolver function-resolver)))
         source (:source/text unit)
         before (:target/text unit)
         recipe (:translation/recipe unit)
         recipe-output (:output recipe)
         recipe-normalized
         (if (string? recipe-output)
           (if (:translation/trusted? options)
             {:output recipe-output
              :changed false
              :mode :recipe
              :rules/matched []
              :rules/applied []
              :diagnostics []}
             (rule/translate-source
              recipe-output
             {:mode :review
               :file (:target/path unit)
               :rules (selected-rules translation-options-value)
               :function-resolver (:function-resolver translation-options-value)}))
           nil)
         result
         (if (string? recipe-output)
           {:output (:output recipe-normalized)
            :changed (not= source (:output recipe-normalized))
            :mode :recipe
            :rules/matched (:rules/matched recipe-normalized)
            :rules/applied (:rules/applied recipe-normalized)
            :diagnostics (:diagnostics recipe-normalized)}
           (rule/translate-source
            source
            (assoc translation-options-value
                   :file (:source/path unit)
                   :rules (selected-rules translation-options-value))))
         after (:output result)
         entry (:corpus/entry unit)
         summary (if (string? recipe-output)
                   (catalog-target-summary entry)
                   (source-summary after))
         migration-routes (catalog-symbol-routes entry)
         diagnostics
         (if (string? recipe-output)
           (vec
            (concat
             [{:type :tool.migrate/recipe-applied
               :level :info
               :safety :safe
               :recipe/id (:id recipe)
               :message "Applied reviewed semantic migration recipe."}]
             (:diagnostics result)))
           (vec (concat (:diagnostics result)
                        (catalog-diagnostics entry))))]
     {:path (:target/path unit)
      :source/path (:source/path unit)
      :source/root (:source/root unit)
      :source/text source
      :source/sha256 (:source/sha256 unit)
      :target/path (:target/path unit)
      :target/root (:target/root unit)
      :before before
      :after after
      :changed (not= before after)
      :source/changed (:changed result)
      :create (nil? before)
      :write false
      :mode (:mode result)
      :namespace (:namespace summary)
      :dependencies (:dependencies summary)
      :public-symbols (:public-symbols summary)
      :rules/matched (:rules/matched result)
      :rules/applied (:rules/applied result)
      :diagnostics diagnostics
      :migration/routes migration-routes
      :migration/summary (catalog-migration-summary entry)
      :translation/recipe (if recipe (:id recipe) nil)
      :provenance (provenance unit result)})))

(defn translate-source-unit
  "Normalises one migration through the shared code.framework substrate."
  ([unit]
   (translate-source-unit unit {}))
  ([unit options]
   (let [prepared (source-unit unit options)
         result (migration-result prepared options)]
     (framework/transform-code
      {:source/path (:source/path prepared)
       :source/text (:source/text prepared)
       :target/path (:target/path prepared)
       :target/text (:target/text prepared)}
      (fn [_] result)))))


(def analyze-source-unit translate-source-unit)

(defn lint-source-unit
  ([unit]
   (lint-source-unit unit {}))
  ([unit options]
   (translate-source-unit
    unit
    (assoc (or options {}) :mode :lint))))

(def migrate-source-unit
  (task/tasklet
   {:id task-id
    :version task-version
    :item-key item-id
    :run
    (fn [unit context]
      {:status :return
       :data (translate-source-unit unit)})
    :display
    (fn [result]
      (if (map? result)
        (select-keys result
                     [:path :namespace :changed :mode])
        result))}))

(defn run-unit
  ([unit]
   (work/run work/default-host migrate-source-unit unit))
  ([runtime unit]
   (work/run runtime migrate-source-unit unit)))
