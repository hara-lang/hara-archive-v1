  (into
   #{"*1" "*2" "*3" "*assert*" "*in*" "*out*" "abs" "aget" "alength"
     "all-ns" "alter-meta!" "alter-var-root" "ancestors" "any?" "apply"
     "array-map" "assoc" "assoc-in" "associative?" "atom" "await" "boolean"
     "boolean?" "butlast" "bytes?" "char" "char?" "class" "coll?" "comp"
