     "count" "counted?" "create-ns" "cycle" "dec" "deref" "derive"
     "descendants" "dissoc" "distinct" "doall" "dorun" "drop" "drop-last"
     "drop-while" "empty" "empty?" "ensure" "even?" "every?" "ex-data"
     "ex-info" "ex-message" "false?" "ffirst" "filter" "filterv" "find"
     "find-ns" "find-var" "first" "flatten" "float" "float?" "flush" "fn?"
     "fnext" "fnil" "frequencies" "future-call" "get" "get-in" "get-method"
     "get-validator" "group-by" "hash-map" "hash-set" "identical?" "identity"
     "ifn?" "inc" "indexed?" "instance?" "int" "integer?" "interleave"
     "interpose" "into" "iterate" "juxt" "keep" "keep-indexed" "key"
     "keys" "keyword" "keyword?" "last" "lazy-seq" "list" "list*" "list?"
     "load" "load-file" "load-reader" "load-string" "map" "map-entry?"
     "map-indexed" "map?" "mapcat" "mapv" "max" "max-key" "merge"
     "merge-with" "meta" "min" "min-key" "mod" "name" "namespace" "neg?"
     "next" "nfirst" "nil?" "nnext" "not-any?" "not-empty" "not-every?"
     "not=" "ns" "ns-aliases" "ns-imports" "ns-interns" "ns-map" "ns-name"
     "ns-publics" "ns-refers" "ns-resolve" "ns-unalias" "ns-unmap" "nth"
     "nthnext" "nthrest" "number?" "odd?" "partial" "partition"
     "partition-all" "partition-by" "peek" "persistent!" "pop" "pr" "pr-str"
     "print" "print-str" "printf" "println" "println-str" "prn" "prn-str"
