     "take-last" "take-nth" "take-while" "throw" "to-array" "transduce"
     "transient" "tree-seq" "true?" "type" "update" "update-in" "val" "vals"
     "var-get" "var-set" "var?" "vec" "vector" "vector?" "when" "with-meta"
     "with-redefs" "zero?"
     "*'" "*clojure-version*" "*e" "*err*" "*file*" "*ns*" "*print-length*"
     "*print-level*" "*print-meta*" "*warn-on-reflection*" "+'" "-reset-methods"
     ".." "Throwable->map" "accessor" "add-watch" "agent" "agent-error"
     "alias" "alter" "aset" "aset-byte" "aset-double" "aset-float" "aset-int"
     "aset-long" "aset-short" "assoc!" "bases" "bigdec" "bigint"
     "biginteger" "bit-and" "bit-not" "bit-or" "bit-set" "bit-shift-left"
     "bit-shift-right" "bit-test" "bit-xor" "boolean-array" "bound-fn"
     "bound?" "byte" "byte-array" "bytes" "cast" "cat" "char-array" "chars"
     "chunk" "class?" "clojure-version" "compile" "conj!" "declare" "dedupe"
     "definterface" "defstruct" "delay" "deliver" "denominator" "destructure"
     "disj" "dosync" "double" "double-array" "double?" "eduction"
     "enumeration-seq" "eval" "every-pred" "extend" "extend-protocol"
