(ns tool.migrate.common.block
  (:config {:role :internal})
  (:require [std.foundation :refer :all :exclude [form?]]
            [std.block :as block]
            [std.block.navigate :as navigate]
            [std.lib.zip :as zip]))

(defn location?
  [input]
  (zip/zipper? input))

(defn block-input
  "Normalizes source, block, value, or an existing location to one block."
  [input]
  (cond
    (location? input) (zip/right-element input)
    (block/block? input) input
    (and (map? input) (block/block? (:block input))) (:block input)
    (string? input) (navigate/block (navigate/parse-root input))
    :else (block/block input)))

(defn location
  "Normalizes source, block, value, or an existing location to a block zipper."
  [input]
  (if (location? input)
    input
    (navigate/navigator (block-input input))))

(defn current
  [input]
  (if (location? input)
    (navigate/block input)
    (block-input input)))

(defn root-block
  [input]
  (if (location? input)
    (zip/root-element input)
    (block-input input)))

(defn render
  [input]
  (block/string (root-block input)))

(defn path
  "Returns the stable child-index path of a location, including void blocks."
  [input]
  (loop [loc (location input)
         output []]
    (let [parent (:parent loc)]
      (if (nil? parent)
        (vec (reverse output))
        (recur parent (conj output (count (:left loc))))))))

(defn step-right-n
  [loc amount]
  (loop [current loc
         remaining amount]
    (if (= remaining 0)
      current
      (recur (navigate/right* current) (dec remaining)))))

(defn location-at
  "Resolves a child-index path against a source or block."
  [input indexes]
  (loop [loc (location input)
         remaining (vec indexes)]
    (if (empty? remaining)
      loc
      (if (not (block/container? (current loc)))
        (throw (ex :security {:path indexes
                         :resolved (path loc)} :ex/message "Block location path descends through a token"))
        (let [inside (navigate/down loc)
              selected (step-right-n inside (first remaining))]
          (if (nil? (zip/right-element selected))
            (throw (ex :io {:path indexes
                             :resolved (path selected)} :ex/message "Block location path is outside the source")))
          (recur selected (vec (rest remaining))))))))

(defn location-range
  [input]
  (let [value (current input)
        info (merge (block/info value) (or (:props value) {}))]
    (select-keys info
                 [:file :start-offset :end-offset
                  :row :col :end-row :end-col])))

(defn evidence
  [input]
  (let [value (current input)]
    (merge
     {:path (path input)
      :type (block/type value)
      :tag (block/tag value)
      :source (block/string value)}
     (location-range input))))

(defn code-children
  [input]
  (vec (filter block/code? (navigate/children (location input)))))

(defn anchor-children
  [input]
  (code-children input))

(defn form-head-block
  [input]
  (first (code-children input)))

(defn form-head
  [input]
  (let [head (form-head-block input)]
    (if head (block/string head) nil)))

(defn form-nth-block
  [input index]
  (let [values (code-children input)]
    (if (< index (count values))
      (nth values index)
      nil)))

(defn form-nth
  [input index]
  (let [value (form-nth-block input index)]
    (if value (block/string value) nil)))

(defn form-second
  [input]
  (form-nth input 1))

(defn form?
  [input]
  (let [value (current input)]
    (and value
         (block/container? value)
         (= :list (block/tag value)))))

(defn metadata-block?
  [input]
  (let [value (current input)]
    (and value
         (block/container? value)
         (= :meta (block/tag value)))))

(defn top-level-locations
  "Returns code locations directly below a root block."
  [input]
  (let [root (location input)
        value (current root)]
    (if (not (= :root (block/tag value)))
      [root]
      (loop [loc (navigate/down root)
             output []]
        (if (nil? (zip/right-element loc))
          output
          (recur (navigate/right* loc)
                 (if (block/code? (zip/right-element loc))
                   (conj output loc)
                   output)))))))

(defn namespace-form?
  [input]
  (let [head (form-head input)]
    (or (= head "ns") (= head "ns+"))))

(defn namespace-location
  [input]
  (first (filter namespace-form? (top-level-locations input))))

(defn namespace-form
  [input]
  (let [loc (namespace-location input)]
    (if loc (current loc) nil)))

(defn namespace-name
  [input]
  (let [form (namespace-form input)]
    (if form (form-second form) nil)))

(defn code-child-locations
  [input]
  (loop [cursor (navigate/down (location input))
         output []]
    (if (nil? (zip/right-element cursor))
      output
      (recur (navigate/right* cursor)
             (if (block/code? (zip/right-element cursor))
               (conj output cursor)
               output)))))

(defn namespace-clause-locations
  [input]
  (let [loc (namespace-location input)]
    (if (nil? loc)
      []
      (vec
       (filter
        (fn [candidate]
          (and (form? candidate)
               (let [head (form-head candidate)]
                 (and head (= ":" (str/slice head 0 1))))))
        (code-child-locations loc))))))

(defn namespace-clauses
  [input]
  (vec (map current (namespace-clause-locations input))))

(defn namespace-clause-location
  [input head]
  (first
   (filter
    (fn [loc] (= head (form-head loc)))
    (namespace-clause-locations input))))

(defn definition-location?
  [input]
  (let [head (form-head input)]
    (and head
         (str/starts-with? head "def"))))

(defn definition-locations
  [input]
  (vec (filter definition-location? (top-level-locations input))))

(defn definition-name
  [input]
  (if (definition-location? input)
    (first
     (keep
      (fn [loc]
        (if (metadata-block? loc)
          (let [children (code-child-locations loc)]
            (if (empty? children)
              nil
              (block/string (current (last children)))))
          (block/string (current loc))))
      (vec (drop 1 (code-child-locations input)))))
    nil))

(defn direct-child-locations
  [input]
  (let [loc (location input)
        value (current loc)]
    (if (or (nil? value)
            (not (block/container? value)))
      []
      (loop [cursor (navigate/down loc)
             output []]
        (if (nil? (zip/right-element cursor))
          output
          (recur (navigate/right* cursor)
                 (conj output cursor)))))))

(declare walk-location)

(defn walk-location
  [loc]
  (loop [pending [loc]
         output []]
    (if (empty? pending)
      output
      (let [pending-count (count pending)
            current-index (dec pending-count)
            current (nth pending current-index)
            remaining (subvec pending 0 current-index)
            children (direct-child-locations current)
            next-pending
            (loop [child-index (dec (count children))
                   result remaining]
              (if (< child-index 0)
                result
                (recur (dec child-index)
                       (conj result (nth children child-index)))))]
        (recur next-pending (conj output current))))))

(defn walk-locations
  "Returns a deterministic pre-order walk including void and comment blocks."
  [input]
  (walk-location (location input)))

(defn coerce-block
  [input]
  (cond
    (location? input) (current input)
    (block/block? input) input
    (string? input)
    (let [values (anchor-children input)]
      (if (= 1 (count values))
        (first values)
        (throw (ex :dependency {:source input
                         :forms (count values)} :ex/message "Structural replacement requires exactly one source block"))))
    :else (block/block input)))

(defn replace-current
  [loc replacement]
  (zip/replace-right (location loc) (coerce-block replacement)))

(defn delete-current
  [loc]
  (zip/delete-right (location loc)))

(defn replace-at
  [input indexes replacement]
  (replace-current (location-at input indexes) replacement))

(defn delete-at
  [input indexes]
  (delete-current (location-at input indexes)))
