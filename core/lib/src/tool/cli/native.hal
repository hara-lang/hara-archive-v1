(ns tool.cli.native
  (:config {:role :internal})
  (:require [code.project :as project]))

(defn package-check [path]
  (let [manifest? (str/ends-with? path "project.edn")
        manifest (if manifest? path (File/join path "project.edn"))
        document (project/validate
                  (Edn/read (str/decode-utf8 (deref (File/read manifest)))))]
    {:identity (str (:project/id document))
     :version (str (:project/version document))}))

(defn package-build [path output package profile]
  (Kernel/package-build path output package profile))

(defn package-inspect [path]
  (Kernel/package-inspect path))

(defn package-install [path]
  (Kernel/package-install path))

(defn package-publish [path tap dry-run]
  (Kernel/package-publish path tap dry-run))

(defn package-registry-verify [request identity]
  (Kernel/package-registry-verify request identity))

(defn tap-config-root []
  (Kernel/tap-config-root))

(defn tap-add [root name registry identity identity-key]
  (Kernel/tap-add root name registry identity identity-key))

(defn tap-bootstrap [root profile]
  (Kernel/tap-bootstrap root profile))

(defn tap-remove [root name]
  (Kernel/tap-remove root name))

(defn tap-list [root]
  (Kernel/tap-list root))

(defn tap-mirror-add [root name registry identity]
  (Kernel/tap-mirror-add root name registry identity))

(defn tap-initialize [root name registry identity identity-root-key]
  (Kernel/tap-initialize
   root name registry identity identity-root-key))

(defn tap-verify [root name]
  (Kernel/tap-verify root name))

(defn snapshot-build [source output]
  (Kernel/snapshot-build source output))

(defn snapshot-verify [path base]
  (Kernel/snapshot-verify path base))

(defn snapshot-inspect [path]
  (Kernel/snapshot-inspect path))

(defn snapshot-diff [left right]
  (Kernel/snapshot-diff left right))
