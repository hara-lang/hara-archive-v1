(ns tool.cli.snapshot
  (:require [tool.cli.model :as model]
            [tool.cli.native :as native]
            [work.base :as work]))

(defn parse-arguments [arguments]
  (loop [remaining (vec arguments) positionals [] options {}]
    (if (empty? remaining)
      {:positionals positionals :options options}
      (let [argument (first remaining)]
        (if (str/starts-with? argument "--")
          (if (< (count remaining) 2)
            (throw (ex :hara/syntax (assoc {} :ex/message (str argument " requires a value"))))
            (recur (vec (drop 2 remaining))
                   positionals
                   (assoc options
                          (keyword (str/slice argument 2))
                          (second remaining))))
          (recur (vec (rest remaining)) (conj positionals argument) options))))))

(defn required-option [parsed key]
  (or (get (:options parsed) key)
      (throw (ex :hara/dependency (assoc {:option key} :ex/message (str "snapshot requires --" (name key)))))))

(defn report [operation text data]
  (model/success data
                 [(model/message
                   (if (str/ends-with? text "\n") text (str text "\n")))]))

(defn execute [request]
  (let [arguments (:request/arguments request)]
    (if (empty? arguments)
      (throw (ex :hara/dependency (assoc {} :ex/message "snapshot requires build, verify, inspect, or diff")))
      (let [operation (keyword (first arguments))
            parsed (parse-arguments (rest arguments))
            values (:positionals parsed)]
        (cond
          (= operation :build)
          (if (= 1 (count values))
            (let [output (required-option parsed :output)
                  text (native/snapshot-build (first values) output)]
              (report operation text {:snapshot/output output}))
            (throw (ex :hara/io (assoc {} :ex/message "snapshot build requires SNAPSHOT.edn --output FILE.hss"))))

          (= operation :verify)
          (if (= 1 (count values))
            (let [text (native/snapshot-verify
                        (first values) (get (:options parsed) :base))]
              (report operation text {:snapshot/path (first values)}))
            (throw (ex :hara/io (assoc {} :ex/message "snapshot verify requires FILE.hss [--base BASE.hss]"))))

          (= operation :inspect)
          (if (= 1 (count values))
            (let [text (native/snapshot-inspect (first values))]
              (report operation text {:snapshot/path (first values)}))
            (throw (ex :hara/io (assoc {} :ex/message "snapshot inspect requires FILE.hss"))))

          (= operation :diff)
          (if (= 2 (count values))
            (let [text (native/snapshot-diff (first values) (second values))]
              (report operation text {:snapshot/left (first values)
                                      :snapshot/right (second values)}))
            (throw (ex :hara/dependency (assoc {} :ex/message "snapshot diff requires LEFT.hss RIGHT.hss"))))

          :else
          (throw (ex :hara/host (assoc {:operation operation} :ex/message (str "unknown snapshot command: " (name operation))))))))))

(def +command-work+
  (work/step {:id 'tool.cli/snapshot :version 1}
             (fn [request context] (execute request))))

(defn handler [request]
  (work/run work/default-host +command-work+ request))
