(ns tool.cli.project-command
  (:require [tool.cli.model :as model]
            [code.project :as project]
            [code.project.production :as production]
            [work.base :as work]))

(def +namespace-separator+ #{\:})

(def +name-characters+
  (set "abcdefghijklmnopqrstuvwxyz0123456789-"))

(def +coordinate-characters+ (conj (conj +name-characters+ \_) \.))

(defn valid-name? [value]
  (and
   (not (str/blank? value))
   (loop [index 0]
       (if (= index (str/length value))
       true
       (if (has? +name-characters+ (str/char-at value index))
         (recur (inc index))
         false)))))

(defn valid-coordinate-component? [value]
  (and
   (not (str/blank? value))
   (loop [index 0]
       (if (= index (str/length value))
       true
       (if (has? +coordinate-characters+ (str/char-at value index))
         (recur (inc index))
         false)))))

(defn normalize-coordinate [value]
  (let [qualified (cond
                    (str/starts-with? value "official:")
                    (str "hara:" (str/slice value 9))
                    (str/includes-any? value +namespace-separator+) value
                    :else (str "hara:" value))
        coordinate-parts (str/split qualified ":")]
    (if (not= 2 (count coordinate-parts))
      (throw (ex :dependency {} :ex/message (str "invalid package coordinate: " value)))
      (let [tap (nth coordinate-parts 0)
            package-parts (str/split (nth coordinate-parts 1) "/")]
        (if (and (= 2 (count package-parts))
                 (valid-coordinate-component? tap)
                 (valid-coordinate-component? (nth package-parts 0))
                 (valid-coordinate-component? (nth package-parts 1)))
          qualified
          (throw (ex :dependency {} :ex/message (str "invalid package coordinate: " value))))))))

(defn start [request]
  (or (:project (:request/options request))
      (:root (:request/options request))
      (:request/cwd request)
      (os/cwd)))

(defn one-argument [arguments label]
  (if (= 1 (count arguments))
    (first arguments)
    (throw (ex :host {:arguments arguments} :ex/message (str label " accepts exactly one argument")))))

(defn write-text [path source]
  (deref (file/write path (str/encode-utf8 source)))
  path)

(defn scaffold [request]
  (let [name (one-argument (:request/arguments request) "new")
        cwd (or (:request/cwd request) (os/cwd))
        destination (if (str/starts-with? name "/") name (file/join cwd name))]
    (if (not (valid-name? name))
      (throw (ex :host {:name name} :ex/message "project name must contain only lowercase letters, numbers, and hyphens"))
      nil)
    (if (deref (file/exists? destination))
      (throw (ex :conflict {:path destination} :ex/message (str "destination already exists: " destination)))
      nil)
    (let [namespace (str/replace name "-" "_")
          source-root (file/join (file/join destination "src") namespace)
          test-root (file/join (file/join destination "test") namespace)]
      (deref (file/mkdir source-root))
      (deref (file/mkdir test-root))
      (deref (file/mkdir (file/join destination "extensions")))
      (write-text
       (file/join destination "project.edn")
       (str "{:hara/type :project\n :hara/version \"1.0.0\"\n"
            " :project/id " name "\n :project/version \"0.1.0\"\n"
            " :project/source-paths [\"src\"]\n :project/test-paths [\"test\"]\n"
            " :project/extension-paths [\"extensions\"]\n"
            " :project/main " namespace ".main\n :project/capabilities #{}\n"
            " :project/dependencies {}}\n"))
      (write-text (file/join destination "workspace.edn")
                   "{:hara/type :workspace :hara/version \"1.0.0\"}\n")
      (write-text
       (file/join source-root "main.hal")
       (str "(ns " namespace ".main)\n\n(defn main []\n  \"Hello from "
            name "\")\n\n(main)\n"))
      (write-text
       (file/join test-root "main_test.hal")
       (str "(ns " namespace ".main-test)\n\n"
            "[(test-check \"starter project runs\" true true)]\n"))
      (model/success
       {:project/path destination :project/id (symbol name)}
       [(model/message (str "created " destination "\n"))]))))

(defn check [request]
  (let [arguments (:request/arguments request)]
    (if (> (count arguments) 1)
      (throw (ex :io {} :ex/message "check accepts at most one path"))
      (let [current-project (project/discover
                             (if (empty? arguments) (start request) (first arguments)))]
        (model/success
         current-project
         [(model/message
           (str "project check: " (:project/id current-project) " "
                (:project/version current-project) "\n"))])))))

(defn split-coordinate [value]
  (let [index (str/last-index-of value "@")]
    (if (< index 0)
      nil
      [(str/slice value 0 index) (str/slice value (inc index))])))

(defn dependency-document [current-project coordinate version]
  (let [dependencies (or (:project/dependencies current-project) {})]
    (assoc
     (dissoc current-project :project/root :project/manifest-path)
     :project/dependencies
     (if version
       (assoc dependencies coordinate {:version version})
       (dissoc dependencies coordinate)))))

(defn edit-dependency [request add]
  (let [label (if add "add" "remove")
        argument (one-argument (:request/arguments request) label)
        pair (if add (split-coordinate argument) [argument nil])]
    (if (and add (or (nil? pair) (str/blank? (second pair))))
      (throw (ex :dependency {:coordinate argument} :ex/message "add requires COORDINATE@RANGE"))
      (let [coordinate (normalize-coordinate (first pair))
            version (second pair)
            current-project (project/discover (start request))
            document (dependency-document current-project coordinate version)]
        (write-text (:project/manifest-path current-project)
                     (str (pr-str document) "\n"))
        (model/success
         {:project/id (:project/id current-project)
          :dependency/coordinate coordinate
          :dependency/version version
          :dependency/action (if add :add :remove)}
         [(model/message (str (if add "added " "removed ") coordinate "\n"))])))))

(defn sync-mode [request]
  (let [arguments (:request/arguments request)]
    (cond
      (empty? arguments) (if (:offline (:request/options request)) :offline :default)
      (= arguments ["--offline"]) :offline
      (= arguments ["--locked"]) :locked
      (= arguments ["--frozen"]) :frozen
      :else
      (throw (ex :host {} :ex/message "sync accepts at most one of --offline, --locked, or --frozen")))))

(defn valid-empty-lock? [path]
  (let [document (Edn/read (project/read-text path))]
    (and (= "0.0.0-alpha" (:lock/format document))
         (= {} (:packages document)))))

(defn sync [request]
  (let [current-project (project/discover (start request))
        dependencies (or (:project/dependencies current-project) {})
        mode (sync-mode request)
        lock (file/join (:project/root current-project) "project.lock.edn")]
    (if (not (empty? dependencies))
      (throw (ex :dependency {:dependencies dependencies} :ex/message (str "project sync requires the reviewed registry client to resolve "
                   (count dependencies) " declared dependencies")))
      nil)
    (if (or (= mode :locked) (= mode :frozen))
      (if (not (deref (file/exists? lock)))
        (throw (ex :dependency {} :ex/message (str "--" (name mode)
                             " requires an existing project.lock.edn")))
        (if (not (valid-empty-lock? lock))
          (throw (ex :io {} :ex/message (str lock " is not a lockfile written by this CLI")))
          nil))
      (write-text lock "{:lock/format \"0.0.0-alpha\" :packages {}}\n"))
    (model/success {:project/lock lock :project/mode mode}
                   [(model/message (str "project sync: " lock "\n"))])))

(defn build-analysis-result [plan]
  (model/success
   {:host/action :production-analyze
    :host/arguments [(pr-str plan)]}))

(defn build [request]
  (let [arguments (:request/arguments request)]
    (if (not (empty? arguments))
      (throw (ex :host {:arguments arguments} :ex/message "project build accepts no positional arguments"))
      (let [current-project (project/discover (start request))
            profile (:profile (:request/options request))
            plan (production/build-plan current-project profile)]
        (build-analysis-result plan)))))

(defn update [request]
  (throw (ex :dependency {} :ex/message "project update requires the reviewed registry client")))

(defn execute [request]
  (let [route (:request/route request)]
    (cond
      (= route :tool.cli.route/project-new) (scaffold request)
      (= route :tool.cli.route/project-check) (check request)
      (= route :tool.cli.route/project-build) (build request)
      (= route :tool.cli.route/project-add) (edit-dependency request true)
      (= route :tool.cli.route/project-remove) (edit-dependency request false)
      (= route :tool.cli.route/project-sync) (sync request)
      (= route :tool.cli.route/project-update) (update request)
      :else (throw (ex :host {} :ex/message (str "unsupported project route " route))))))

(def +command-work+
  (work/step {:id 'tool.cli/project :version 3}
             (fn [request context] (execute request))))

(defn handler [request]
  (work/run work/default-host +command-work+ request))
