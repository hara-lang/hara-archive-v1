(ns tool.cli.language
  (:require [tool.cli.model :as model]
            [code.project :as project]
            [work.base :as work]))

(defn one-argument [arguments label]
  (if (= 1 (count arguments))
    (first arguments)
    (throw (ex :hara/dependency (assoc {:arguments arguments} :ex/message (str label " requires exactly one argument"))))))

(defn project-start [request]
  (or (:project (:request/options request))
      (:root (:request/options request))
      (:request/cwd request)
      (os/cwd)))

(defn register-request-project [request required]
  (let [configured (or (:project (:request/options request)) required)]
    (if configured
      (let [current-project (project/discover (project-start request))]
        {:project current-project
         :registered (project/register-resources current-project)})
      {:project nil :registered []})))

(defn evaluation-result [value metadata]
  (model/success
   (merge {:evaluation/value value} metadata)
   [(model/message (str (pr-str value) "\n"))]))

(defn application-protocol? [value]
  (and (map? value)
       (or (not (nil? (:hara.app/stdout value)))
           (not (nil? (:hara.app/stderr value)))
           (not (nil? (:hara.app/exit value))))))

(defn application-result [value metadata]
  (let [stdout (or (:hara.app/stdout value) "")
        stderr (or (:hara.app/stderr value) "")
        exit (or (:hara.app/exit value) 0)]
    (if (not (string? stdout))
      (throw (ex :hara/argument (assoc {} :ex/message ":hara.app/stdout must be a string or nil")))
      nil)
    (if (not (string? stderr))
      (throw (ex :hara/argument (assoc {} :ex/message ":hara.app/stderr must be a string or nil")))
      nil)
    (if (or (< exit 0) (> exit 255))
      (throw (ex :hara/argument (assoc {} :ex/message ":hara.app/exit must be between 0 and 255")))
      nil)
    (assoc (model/success
            (merge {:application/result value} metadata)
            [(model/message :stdout stdout)
             (model/message :stderr stderr)])
           :result/exit exit)))

(defn application-request-source [request current-project]
  (let [application-request
        {:tool.cli/route :tool.cli.route/project-run
         :tool.cli/arguments (:request/arguments request)
         :tool.cli/runtime (:request/runtime request)
         :tool.cli/cwd (:project/root current-project)
         :tool.cli/project (str (:project/id current-project))
         :tool.cli/capabilities (:request/capabilities request)}]
    (str "(ns tool.cli.application)\n"
         "(def request " (pr-str application-request) ")\n"
         "(def arguments (get request :tool.cli/arguments))\n")))

(defn evaluate-source [request source project-required]
  (let [registration (register-request-project request project-required)
        value (Kernel/session-eval "ROOT" source)]
    (evaluation-result
     value
     {:evaluation/project
      (if (:project registration)
        (:project/id (:project registration))
        nil)
      :evaluation/registered (:registered registration)})))

(defn eval-command [request]
  (evaluate-source request
                   (one-argument (:request/arguments request) "eval")
                   false))

(defn run-file-command [request]
  (let [path (one-argument (:request/arguments request) "run")]
    (evaluate-source request (project/read-text path) false)))

(defn project-run-command [request]
  (let [current-project (project/discover (project-start request))
        registered (project/register-resources current-project)
        path (project/main-file current-project)
        request-source (application-request-source request current-project)
        request-resource (Kernel/resource-register
                          "tool.cli.application"
                          request-source)
        value (Kernel/session-eval "ROOT" (project/read-text path))]
    (let [metadata {:evaluation/project (:project/id current-project)
                    :evaluation/file path
                    :evaluation/registered registered
                    :application/resource request-resource}]
      (if (application-protocol? value)
        (application-result value metadata)
        (evaluation-result value metadata)))))

(def +eval-work+
  (work/step {:id 'tool.cli/eval :version 1}
             (fn [request context] (eval-command request))))

(def +run-file-work+
  (work/step {:id 'tool.cli/run-file :version 1}
             (fn [request context] (run-file-command request))))

(def +project-run-work+
  (work/step {:id 'tool.cli/project-run :version 1}
             (fn [request context] (project-run-command request))))

(defn eval-handler [request]
  (work/run work/default-host +eval-work+ request))

(defn run-file-handler [request]
  (work/run work/default-host +run-file-work+ request))

(defn project-run-handler [request]
  (work/run work/default-host +project-run-work+ request))
