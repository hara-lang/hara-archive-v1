(ns tool.cli.spec
  (:require [tool.cli.model :as model]
            [tool.metaspec.core :as metaspec]
            [code.project :as project]
            [work.base :as work]))

(def +template+
  {:document/id :example/metaspec
   :document/type :tool/metaspec
   :document/version "0.1.0"
   :document/status :draft
   :document/title "Example Meta-Specification"
   :document/summary "Describe the generated artifact contract."
   :spec/conforms-to {:spec/id :tool/metaspec-metaspec
                      :spec/version "0.1.0"}
   :spec/artifact-kind :example/artifact
   :meta/document-schema {:schema/id :example/document :schema/type :map}
   :meta/schemas []
   :meta/cross-references []
   :meta/requirements []
   :metaspec/generation {:generation/input {}
                         :generation/output {}
                         :generation/process []
                         :generation/acceptance {}}})

(def +route-operations+
  {:tool.cli.route/spec-lint :lint
   :tool.cli.route/spec-verify :verify
   :tool.cli.route/spec-validate :validate
   :tool.cli.route/spec-template :template
   :tool.cli.route/spec-check-contribution :check-contribution
   :tool.cli.route/spec-check :check
   :tool.cli.route/spec-to-edn :to-edn
   :tool.cli.route/spec-from-edn :from-edn
   :tool.cli.route/spec-normalize :normalize
   :tool.cli.route/spec-graph :graph
   :tool.cli.route/spec-obligations :obligations
   :tool.cli.route/spec-explain :explain})

(defn parse-format [arguments]
  (let [size (count arguments)]
    (if (and (>= size 2) (= "--format" (nth arguments (- size 2))))
      (let [format (keyword (nth arguments (dec size)))]
        (if (or (= format :text) (= format :edn))
          {:format format :arguments (vec (take (- size 2) arguments))}
          (throw (ex :syntax {} :ex/message "spec format must be --format text or --format edn"))))
      {:format :text :arguments (vec arguments)})))

(defn operation-request [request]
  (if (= :tool.cli.route/spec (:request/route request))
    (let [arguments (:request/arguments request)]
      (if (empty? arguments)
        (throw (ex :io {} :ex/message "spec requires lint, verify, validate, template, check-contribution, check, to-edn, from-edn, normalize, graph, obligations, or explain"))
        {:operation (keyword (first arguments))
         :arguments (vec (rest arguments))}))
    {:operation (get +route-operations+ (:request/route request))
     :arguments (:request/arguments request)}))

(defn read-document [path]
  (let [document (Edn/read (project/read-text path))]
    (if (map? document)
      document
      (throw (ex :io {:path path} :ex/message "meta-spec root must be an EDN map")))))

(defn text-report [document report]
  (let [findings (:findings report)
        id (or (:document/id document) "<missing :document/id>")]
    (if (empty? findings)
      (str "meta-spec " id ": pass\n")
      (str
       "meta-spec " id ": " (count findings) " finding(s)\n"
       (apply str
              (map (fn [finding]
                     (str "error " (:rule/id finding) " at "
                          (pr-str (:finding/path finding)) " — "
                          (:finding/message finding) "\n"))
                   findings))))))

(defn report-result [document report format]
  (let [text (if (= format :edn)
               (str (pr-str report) "\n")
               (text-report document report))
        messages [(model/message text)]]
    (if (= :pass (:report/status report))
      (model/success report messages)
      (model/result :tool.cli.outcome/failed report messages))))

(defn lint-or-verify [operation arguments]
  (let [parsed (parse-format arguments)
        values (:arguments parsed)]
    (if (not= 1 (count values))
      (throw (ex :io {} :ex/message (str "spec " (name operation) " requires FILE")))
      (let [document (read-document (first values))
            report (if (= operation :lint)
                     (metaspec/lint-report document)
                     (metaspec/verify-report document))]
        (report-result document report (:format parsed))))))

(defn validate [arguments]
  (let [parsed (parse-format arguments)
        values (:arguments parsed)]
    (if (or (not= 3 (count values)) (not= "--against" (second values)))
      (throw (ex :io {} :ex/message "spec validate requires FILE --against METASPEC"))
      (let [path (first values)
            document (read-document path)
            against (read-document (nth values 2))
            structural (metaspec/lint against)]
        (if (not (empty? structural))
          (throw (ex :generic {:findings structural} :ex/message "the --against meta-spec does not pass structural lint"))
          (report-result
           document
           (metaspec/conforms document {:metaspec against :document-path path})
           (:format parsed)))))))

(defn template [arguments]
  (if (not (empty? arguments))
    (throw (ex :io {} :ex/message "spec template accepts no file"))
    (model/success +template+ [(model/message (str (pr-str +template+) "\n"))])))

(defn unavailable [operation]
  (throw (ex :state {:operation operation} :ex/message (str "spec " (name operation) " is not implemented in Hara yet"))))

(defn execute [request]
  (let [resolved (operation-request request)
        operation (:operation resolved)
        arguments (:arguments resolved)]
    (case operation
      :lint (lint-or-verify operation arguments)
      :verify (lint-or-verify operation arguments)
      :validate (validate arguments)
      :template (template arguments)
      (unavailable operation))))

(def +command-work+
  (work/step {:id 'tool.cli/spec :version 1}
             (fn [request context] (execute request))))

(defn handler [request]
  (work/run work/default-host +command-work+ request))
