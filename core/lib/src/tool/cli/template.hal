(ns tool.cli.template
  (:config {:override [work]})
  (:require [work.base :as std-work]
            [tool.cli.model :as model]))

(def schema-id "tool.cli.template/0-alpha")

(def ^:dynamic *template-defaults*
  (atom {:default {}}))

(defn template-defaults
  [template-type]
  (let [registry (deref *template-defaults*)
        base (or (get registry :default) {})
        selected (if (= :default template-type)
                   {}
                   (or (get registry template-type) {}))]
    (merge-nested base selected)))

(defn install-defaults
  "Installs or extends defaults for one template type."
  [template-type options]
  (if (not (keyword? template-type))
    (throw
     (ex :hara/argument (assoc {:template template-type} :ex/message "CLI template type must be a keyword"))))
  (if (not (map? options))
    (throw
     (ex :hara/argument (assoc {:template template-type
               :defaults options} :ex/message "CLI template defaults must be a map"))))
  (swap! *template-defaults*
         (fn [registry]
           (assoc registry
                  template-type
                  (merge-nested
                   (or (get registry template-type) {})
                   options))))
  (template-defaults template-type))

(defn uninstall-defaults
  "Removes defaults for one template type. The default profile remains
   installed so every definition has a stable base."
  [template-type]
  (if (= :default template-type)
    (throw
     (ex :hara/io (assoc {:template template-type} :ex/message "The default CLI template profile cannot be removed")))
    (swap! *template-defaults* dissoc template-type)))

(defn assert-main
  [definition]
  (let [main (:main definition)
        function (:fn main)
        argcount (:argcount main)]
    (if (not (map? main))
      (throw
       (ex :hara/dependency (assoc {:definition definition} :ex/message "CLI template requires :main to be a map"))))
    (if (not (fn? function))
      (throw
       (ex :hara/dependency (assoc {:id (:id definition)} :ex/message "CLI template requires :main :fn"))))
    (if (not (or (= 1 argcount) (= 2 argcount)))
      (throw
       (ex :hara/argument (assoc {:id (:id definition)
                 :argcount argcount} :ex/message "CLI template :main :argcount must be 1 or 2")))))
  definition)

(defn normalise-definition
  "Applies recursive defaults and validates one declarative CLI definition."
  [raw-definition]
  (if (not (map? raw-definition))
    (throw
     (ex :hara/argument (assoc {:definition raw-definition} :ex/message "CLI template definition must be a map"))))
  (let [template-type (or (:template raw-definition) :default)
        defaults (merge-nested
                  (template-defaults template-type)
                  (or (:defaults raw-definition) {}))
        definition (merge-nested defaults raw-definition)
        id (:id definition)
        version (or (:version definition) 1)
        runtime-fn (or (:runtime-fn definition)
                       (fn [] std-work/default-host))]
    (if (nil? id)
      (throw (ex :hara/dependency (assoc {} :ex/message "CLI template requires :id"))))
    (if (not (number? version))
      (throw
       (ex :hara/argument (assoc {:id id :version version} :ex/message "CLI template :version must be numeric"))))
    (if (and (:prepare definition)
             (not (fn? (:prepare definition))))
      (throw
       (ex :hara/argument (assoc {:id id} :ex/message "CLI template :prepare must be a function"))))
    (if (and (:finish definition)
             (not (fn? (:finish definition))))
      (throw
       (ex :hara/argument (assoc {:id id} :ex/message "CLI template :finish must be a function"))))
    (if (not (fn? runtime-fn))
      (throw
       (ex :hara/argument (assoc {:id id} :ex/message "CLI template :runtime-fn must be a function"))))
    (assert-main
     (assoc definition
            :schema schema-id
            :template template-type
            :version version
            :runtime-fn runtime-fn))))

(defn invoke-main
  [definition input context]
  (let [main (:main definition)
        function (:fn main)]
    (case (:argcount main)
      1 (function input)
      2 (function input context))))

(defn valid-message?
  [message]
  (and (map? message)
       (keyword? (:message/stream message))
       (string? (:message/text message))))

(defn validate-result
  "Validates the final closed-registry result envelope and returns it."
  [result]
  (if (not (map? result))
    (throw
     (ex :hara/generic (assoc {:result result} :ex/message "CLI handler returned a non-map result"))))
  (let [outcome (:result/outcome result)
        exit (:result/exit result)
        messages (:result/messages result)]
    (if (not (has? model/+outcome-exits+ outcome))
      (throw
       (ex :hara/generic (assoc {:outcome outcome
                 :result result} :ex/message "CLI handler returned an unknown outcome"))))
    (if (not= exit (model/outcome-exit outcome))
      (throw
       (ex :hara/argument (assoc {:outcome outcome
                 :exit exit
                 :expected (model/outcome-exit outcome)} :ex/message "CLI handler result exit does not match its outcome"))))
    (if (not (vector? messages))
      (throw
       (ex :hara/argument (assoc {:messages messages} :ex/message "CLI handler :result/messages must be a vector"))))
    (if (not (every? valid-message? messages))
      (throw
       (ex :hara/argument (assoc {:messages messages} :ex/message "CLI handler returned an invalid message envelope")))))
  result)

(defn stage-id
  [definition stage]
  (pointer
   {:context :tool.cli.template
    :id (str (:id definition))
    :stage stage
    :version (:version definition)}))

(defn prepare-work
  [definition]
  (if-let [prepare (:prepare definition)]
    [(std-work/step
      {:id (stage-id definition :prepare)
       :version (:version definition)}
      (fn [input context]
        (prepare input context)))]
    []))

(defn main-work
  [definition]
  (std-work/step
   {:id (stage-id definition :main)
    :version (:version definition)}
   (fn [input context]
     (invoke-main definition input context))))

(defn finish-work
  [definition]
  (if-let [finish (:finish definition)]
    [(std-work/step
      {:id (stage-id definition :finish)
       :version (:version definition)}
      (fn [input context]
        (finish input context)))]
    []))

(defn result-work
  [definition]
  (std-work/pure
   {:id (stage-id definition :result)
    :version (:version definition)}
   (fn [result context]
     (validate-result result))))

(defn work
  "Compiles a declarative CLI definition into one native work graph."
  [raw-definition]
  (let [definition (normalise-definition raw-definition)]
    (std-work/chain
     {:id (:id definition)
      :version (:version definition)
      :tool.cli.template/schema schema-id
      :tool.cli.template/type (:template definition)}
     (vec
      (concat
       (prepare-work definition)
       [(main-work definition)]
       (finish-work definition)
       [(result-work definition)])))))

(defn handler
  "Returns the closed-registry function [request] -> tool.cli.model/result."
  [raw-definition]
  (let [definition (normalise-definition raw-definition)
        command-work (work definition)
        runtime-fn (:runtime-fn definition)]
    (with-meta
      (fn [request]
        (std-work/run (runtime-fn) command-work request))
      {:tool.cli.template/schema schema-id
       :tool.cli.template/id (:id definition)
       :tool.cli.template/version (:version definition)
       :tool.cli.template/type (:template definition)})))

(defn handler?
  [value]
  (= schema-id
     (:tool.cli.template/schema (meta value))))
