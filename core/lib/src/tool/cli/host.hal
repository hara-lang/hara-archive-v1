(ns tool.cli.host
  (:require [tool.cli.model :as model]
            [work.base :as work]))

(def +route-actions+
  {:tool.cli.route/stdin :stdin
   :tool.cli.route/repl :repl
   :tool.cli.route/server :server
   :tool.cli.route/remote :remote
   :tool.cli.route/compile-halc :compile-halc})

(defn execute [request]
  (let [action (get +route-actions+ (:request/route request))
        arguments (:request/arguments request)]
    (if (nil? action)
      (throw (ex :hara/io (assoc {} :ex/message (str "unsupported host route: " (:request/route request)))))
      nil)
    (if (and (= action :remote) (not= 1 (count arguments)))
      (throw (ex :hara/dependency (assoc {:arguments arguments} :ex/message "remote requires HOST:PORT")))
      nil)
    (if (and (not= action :remote)
             (not= action :compile-halc)
             (not (empty? arguments)))
      (throw (ex :hara/generic (assoc {:arguments arguments} :ex/message (str (name action) " accepts no arguments"))))
      nil)
    (model/success {:host/action action
                    :host/arguments (vec arguments)})))

(def +command-work+
  (work/step {:id 'tool.cli/host :version 1}
             (fn [request context] (execute request))))

(defn handler [request]
  (work/run work/default-host +command-work+ request))
