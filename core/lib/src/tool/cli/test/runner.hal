(ns tool.cli.test.runner
  (:config {:role :internal})
  (:require [code.project :as project]
            [code.test.result :as test-result]
            [std.lib.format.report :as report]
            [std.lib.format.terminal :as terminal]
            [tool.cli.model :as model]))

(defn vector-tail
  [values start]
  (vec (drop start values)))

(defn native-result-counts
  [results]
  (reduce
   (fn [counts result]
     (if (not (result? result))
       (throw
        (ex :state {}
            :ex/message "native test result is not a Result"))
       (if (test-result/passed? result)
         (update counts :passed inc)
         (update counts :failed inc))))
   {:passed 0 :failed 0}
   results))

(defn code-test-result-counts
  [summary]
  (let [status (:status summary)
        counts (:counts summary)]
    (if (not (keyword? status))
      (throw
       (ex :state {}
           :ex/message "code.test/run result is missing :status")))
    (if (not (map? counts))
      (throw
       (ex :state {}
           :ex/message "code.test/run result is missing :counts")))
    (let [passed (or (:passed counts) 0)
          failed (+ (or (:failed counts) 0)
                    (or (:error counts) 0)
                    (or (:timeout counts) 0))]
      {:passed passed
       :failed (if (and (not= status :passed) (= failed 0)) 1 failed)})))

(defn result-counts
  [value]
  (let [result (if (string? value) (Edn/read value) value)]
    (cond
      (or (vector? result) (list? result))
      (native-result-counts result)

      (map? result)
      (code-test-result-counts result)

      :else
      (throw
       (ex :state {}
           :ex/message
           "test file must return a code.test/run summary or native test result vector")))))

(defn run-file
  [record index]
  (let [path (:path record)
        namespace (:namespace record)
        session (str "tool.cli.test." index)
        started (time-ms)]
    (try
      (Kernel/session-create session)
      (let [value (Kernel/session-eval session (project/read-text path))
            value (if (nil? value)
                    (Kernel/session-eval
                     session
                     (str "(pr-str (code.test/run {:namespace "
                          (pr-str namespace)
                          "}))"))
                    value)
            counts (result-counts value)]
        (assoc counts
               :path path
               :namespace namespace
               :value value
               :elapsed (- (time-ms) started)))
      (catch Throwable error
        {:path path
         :namespace namespace
         :passed 0
         :failed 1
         :error (str error)
         :elapsed (- (time-ms) started)})
      (finally
        (try
          (Kernel/session-close session)
          (catch Throwable error nil))))))

(defn run-files
  [records]
  (loop [remaining (vec records)
         index 0
         results []]
    (if (empty? remaining)
      results
      (recur (vector-tail remaining 1)
             (inc index)
             (conj results (run-file (first remaining) index))))))

(defn summary
  [results]
  (reduce
   (fn [output result]
     (update (update output :passed + (:passed result))
             :failed + (:failed result)))
   {:passed 0 :failed 0}
   results))

(defn result-messages
  ([results counts]
   (result-messages results counts {}))
  ([results counts options]
   (let [options (or options {})
         ansi (not (:no-color options))
         total (count results)
         index-width (+ 2 (* 2 (str/length (str total))))
         id-width
         (reduce
          (fn [width result]
            (max width (+ 2 (str/length (str (:namespace result))))))
          0
          results)]
     (conj
      (reduce
       (fn [messages [index result]]
         (let [status (if (:error result)
                        :error
                        (if (= 0 (:failed result)) :passed :failed))
               line (report/progress-line
                     {:item/id (:namespace result)
                      :item/index index
                      :item/total total
                      :item/index-width index-width
                      :item/id-width id-width
                      :item/result-width 60
                      :item/time-width 10
                      :item/count (:passed result)
                      :status status
                      :error (:error result)
                      :elapsed (if (has? result :elapsed)
                                 (let [centiseconds
                                       (quot (+ (:elapsed result) 5) 10)
                                       seconds (quot centiseconds 100)
                                       fraction (rem centiseconds 100)]
                                   (str seconds "."
                                        (if (< fraction 10) "0" "")
                                        fraction
                                        "s"))
                                 nil)})
               stream (if (or (= :error status) (= :failed status))
                        :stderr
                        :stdout)]
           (conj messages
                 (model/message
                  stream
                  (str (terminal/render-line line {:ansi ansi}) "\n")))))
       []
       (map-indexed (fn [index result] [index result]) results))
      (model/message (str "test result: " (:passed counts) " passed, "
                         (:failed counts) " failed\n"))))))
