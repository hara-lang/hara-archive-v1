(ns tool.inrepl
  (:require [lang.core.eval :as evaluation]
            [std.foundation.bytes :as bytes]
            [code.project :as project]))

(def +agent-session+ "AGENT")
(def +max-frame-bytes+ 67108864)
(def +max-frame-depth+ 64)
(def +loopback-hosts+ #{"127.0.0.1" "localhost"})

(defn endpoint
  "Parses the deliberately narrow host:port syntax accepted by the prototype."
  [value]
  (if (not (string? value))
    (throw (ex :hara/argument (assoc {:endpoint value} :ex/message "Hara in-REPL endpoint must be HOST:PORT"))))
  (let [index (str/last-index-of value ":")]
    (if (<= index 0)
      (throw (ex :hara/argument (assoc {:endpoint value} :ex/message "Hara in-REPL endpoint must be HOST:PORT"))))
    (let [host (str/slice value 0 index)
          port (try (Edn/read (str/slice value (inc index)))
                    (catch Throwable error nil))]
      (if (or (not (has? +loopback-hosts+ host))
              (not (long? port))
              (< port 1)
              (> port 65535))
        (throw (ex :hara/dependency (assoc {:endpoint value :host host :port port} :ex/message "Hara in-REPL requires a loopback HOST:PORT endpoint"))))
      {:host host :port port :endpoint value})))

(defn- append-bytes [left right]
  (apply bytes (concat (vec left) (vec right))))

(defn- byte-at [value index]
  (bytes/u8 (bytes/get value index)))

(defn- line-at
  [value offset]
  (loop [index offset]
    (cond
      (>= (+ index 1) (bytes/count value)) nil
      (and (= 13 (byte-at value index))
           (= 10 (byte-at value (inc index))))
      {:text (str/decode-utf8 (bytes/slice value offset index))
       :next (+ index 2)}
      :else (recur (inc index)))))

(defn- frame-number [text offset]
  (let [value (try (Edn/read text) (catch Throwable error nil))]
    (if (long? value)
      value
      (throw (ex :hara/argument (assoc {:text text :offset offset} :ex/message "Invalid RESP frame length"))))))

(declare parse-at)

(defn- parse-array
  [value offset count depth]
  (loop [items []
         index offset]
    (if (= (count items) count)
      {:value {:resp/type :array :resp/value items} :next index}
      (let [part (parse-at value index (inc depth))]
        (if (nil? part)
          nil
          (recur (conj items (:value part)) (:next part)))))))

(defn parse-at
  "Returns one decoded RESP frame and the next byte offset, or nil when incomplete."
  [value offset depth]
  (if (> depth +max-frame-depth+)
    (throw (ex :hara/limit (assoc {:depth depth} :ex/message "RESP nesting limit exceeded"))))
  (if (>= offset (bytes/count value))
    nil
    (let [prefix (byte-at value offset)
          line (line-at value (inc offset))]
      (if (nil? line)
        nil
        (cond
          (= prefix 43) {:value {:resp/type :simple :resp/value (:text line)}
                          :next (:next line)}
          (= prefix 45) {:value {:resp/type :error :resp/value (:text line)}
                          :next (:next line)}
          (= prefix 58) {:value {:resp/type :integer
                                  :resp/value (frame-number (:text line) offset)}
                          :next (:next line)}
          (= prefix 36)
          (let [size (frame-number (:text line) offset)]
            (cond
              (= size -1) {:value {:resp/type :bulk :resp/value nil}
                           :next (:next line)}
              (or (< size 0) (> size +max-frame-bytes+))
              (throw (ex :hara/syntax (assoc {:length size} :ex/message "Invalid RESP bulk length")))
              (> (+ (:next line) size 2) (bytes/count value)) nil
              (or (not (= 13 (byte-at value (+ (:next line) size))))
                  (not (= 10 (byte-at value (+ (:next line) size 1)))))
              (throw (ex :hara/syntax (assoc {:offset offset} :ex/message "Invalid RESP bulk ending")))
              :else
              {:value {:resp/type :bulk
                       :resp/value (str/decode-utf8
                                    (bytes/slice value (:next line) (+ (:next line) size)))}
               :next (+ (:next line) size 2)}))
          (= prefix 42)
          (let [count (frame-number (:text line) offset)]
            (cond
              (= count -1) {:value {:resp/type :array :resp/value nil}
                            :next (:next line)}
              (or (< count 0) (> count +max-frame-bytes+))
              (throw (ex :hara/syntax (assoc {:length count} :ex/message "Invalid RESP array length")))
              :else (parse-array value (:next line) count depth)))
          :else (throw (ex :hara/syntax (assoc {:prefix prefix} :ex/message "Unknown RESP frame prefix"))))))))

(defn decode
  "Decodes a single complete RESP value."
  [value]
  (let [parsed (parse-at value 0 0)]
    (if (nil? parsed)
      (throw (ex :hara/serialization (assoc {} :ex/message "Incomplete RESP frame"))))
    (if (not= (:next parsed) (bytes/count value))
      (throw (ex :hara/syntax (assoc {:next (:next parsed)} :ex/message "RESP input contains trailing bytes"))))
    (:value parsed)))

(defn encode-array [values]
  (let [parts (map (fn [item]
                     (let [payload (str/encode-utf8 item)]
                       (str "$" (bytes/count payload) "\r\n" item "\r\n")))
                   values)]
    (str/encode-utf8 (str "*" (count values) "\r\n" (apply str parts)))))

(defn- frame-text [frame]
  (:resp/value frame))

(defn- await-event [stream]
  (evaluation/await (Socket/next stream) 5000))

(defn- connect [{:keys [host port] :as value}]
  (let [result (atom nil)]
    (Socket/connect host port {}
                    (fn [error connection]
                      (reset! result {:error error :connection connection})))
    (let [{:keys [error connection]} (deref result)]
      (if error
        (throw (ex :hara/io (assoc {:endpoint value :error error} :ex/message "Hara in-REPL connection failed"))))
      connection)))

(defn- receive [state stream]
  (loop []
    (let [buffer (:buffer (deref state))
          parsed (parse-at buffer 0 0)]
      (if parsed
        (do (swap! state assoc :buffer (bytes/slice buffer (:next parsed)))
            (:value parsed))
        (let [event (await-event stream)]
          (cond
            (= :data (:type event))
            (do (swap! state update :buffer append-bytes (:bytes event))
                (recur))
            (= :close (:type event))
            (throw (ex :hara/state (assoc {} :ex/message "Hara in-REPL closed before responding")))
            (= :error (:type event))
            (throw (ex :hara/io (assoc {:error (:error event)} :ex/message "Hara in-REPL socket failed")))
            :else (recur)))))))

(defn- send [connection values]
  (Socket/send connection (encode-array values)))

(defn- expect [frame type]
  (if (= type (:resp/type frame))
    frame
    (throw (ex :hara/io (assoc {:expected type :actual frame} :ex/message "Unexpected Hara RESP response")))))

(defn- hello [connection stream state]
  (send connection ["HELLO" "4" "CLIENT" "HARA-INREPL"])
  (let [frame (expect (receive state stream) :array)
        values (map frame-text (:resp/value frame))]
    (if (and (= "SERVER" (first values)) (= "HARA" (second values)))
      values
      (throw (ex :hara/io (assoc {:response values} :ex/message "Endpoint is not a Hara RESP server"))))))

(defn- request [connection stream state id operation arguments]
  (send connection (vec (concat [operation id] arguments)))
  (let [result (expect (receive state stream) :array)
        done (expect (receive state stream) :array)
        result-values (:resp/value result)
        done-values (map frame-text (:resp/value done))]
    (if (not= ["DONE" id] (vec (take 2 done-values)))
      (throw (ex :hara/io (assoc {:id id :done done-values} :ex/message "Hara RESP completion id mismatch"))))
    (if (= "ERROR" (frame-text (first result-values)))
      (throw (ex :hara/io (assoc {:id id
                       :code (frame-text (nth result-values 2))
                       :message (frame-text (nth result-values 3))} :ex/message "Hara in-REPL evaluation failed"))))
    (if (not= "RESULT" (frame-text (first result-values)))
      (throw (ex :hara/io (assoc {:response result-values} :ex/message "Unexpected Hara RESP result"))))
    (nth result-values 2)))

(defn- with-client [endpoint-value f]
  (let [connection (connect (endpoint endpoint-value))
        stream (Socket/events connection {})
        state (atom {:buffer (bytes) :request 0})]
    (try
      (hello connection stream state)
      (f connection stream state)
      (finally (Socket/close connection)))))

(defn- request-next [connection stream state operation arguments]
  (let [id (str "INREPL-" (get (swap! state update :request inc) :request))]
    (request connection stream state id operation arguments)))

(defn- session-names [frame]
  (map frame-text (:resp/value (expect frame :array))))

(defn- ensure-session [connection stream state session]
  (let [sessions (session-names (request-next connection stream state "SESSION" ["LIST"]))]
    (if (not (some (fn [name] (= name session)) sessions))
      (request-next connection stream state "SESSION" ["NEW" session])))
  (request-next connection stream state "SESSION" ["ATTACH" session]))

(defn- require-loopback-project [start]
  (let [current (project/discover start)]
    (if (not (project/inrepl-loopback? current))
      (throw (ex :hara/dependency (assoc {:project (:project/id current)} :ex/message "project.edn must opt in with :project/inrepl-capabilities #{:inrepl/loopback}"))))
    current))

(defn eval-source
  ([endpoint source] (eval-source endpoint +agent-session+ source))
  ([endpoint session source]
   (with-client endpoint
     (fn [connection stream state]
       (ensure-session connection stream state session)
       (frame-text (request-next connection stream state "EVAL" [source]))))))

(defn eval-project
  ([start endpoint source]
   (eval-project start endpoint +agent-session+ source))
  ([start endpoint session source]
   (require-loopback-project start)
   (eval-source endpoint session source)))

(defn status
  ([endpoint] (status endpoint +agent-session+))
  ([endpoint session]
   (with-client endpoint
     (fn [connection stream state]
       (ensure-session connection stream state session)
       {:endpoint endpoint
        :session session
        :info (frame-text (request-next connection stream state "SESSION" ["INFO"]))}))))

(defn reset
  ([endpoint] (reset endpoint +agent-session+))
  ([endpoint session]
   (if (= session "ROOT")
     (throw (ex :hara/generic (assoc {:session session} :ex/message "Hara in-REPL never resets ROOT"))))
   (with-client endpoint
     (fn [connection stream state]
       (let [sessions (session-names (request-next connection stream state "SESSION" ["LIST"]))]
         (if (some (fn [name] (= name session)) sessions)
           (request-next connection stream state "SESSION" ["CLOSE" session])))
       (request-next connection stream state "SESSION" ["NEW" session])
       (request-next connection stream state "SESSION" ["ATTACH" session])
       {:endpoint endpoint :session session :reset true}))))
