(ns tool.cli.host-test
  (:require [tool.cli.host :as host]
            ))

[(test-check "interactive routes return closed host actions"
              (:result/data
               (host/execute
                {:request/route :tool.cli.route/remote
                 :request/arguments ["127.0.0.1:1311"]}))
              {:host/action :remote
               :host/arguments ["127.0.0.1:1311"]})
  (test-check "interactive handlers execute through the default host value"
              (:result/data
               (host/handler
                {:request/route :tool.cli.route/remote
                 :request/arguments ["127.0.0.1:1311"]}))
              {:host/action :remote
               :host/arguments ["127.0.0.1:1311"]})]
