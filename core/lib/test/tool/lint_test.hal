(ns tool.lint-test
  (:use code.test)
  (:require [tool.lint :as lint]))

(defn report-data
  [outcome]
  (Result/data outcome))

^{:refer 'tool.lint/lint-source
  :id 'resolution-arity-and-literal-types}
(fact "reports deterministic semantic findings without evaluating source"
  (map :type
       (:findings
        (report-data
         (lint/lint-source
          "(ns demo.core)\n(defn add [x] (inc x))\n(add 1 2)\n(inc \"x\")\nmissing"))))
  => [:tool.lint/invalid-arity
      :tool.lint/type-mismatch
      :tool.lint/unresolved-symbol])

^{:refer 'tool.lint/lint-source
  :id 'hara-owned-bang-definition-policy}
(fact "flags Hara-owned bang definitions without restricting external parsing"
  (let [source
        (str "(ns demo.core)\n"
             "(defn run! [] nil)\n"
             "(defn.xt ^{:public true} effect! [] nil)\n"
             "(defmacro- wrap! [] nil)\n"
             "'(defn quoted! [] nil)\n"
             "(run!)")
        ordinary (report-data (lint/lint-source source))
        governed
        (report-data
         (lint/lint-source
          source
          {:rules #{:tool.lint/bang-suffixed-definition}}))]
    [(mapv :type (:findings ordinary))
     (mapv (fn [finding]
             (select-keys finding
                          [:type :definition/var :definition/form
                           :rename/candidate :rename/collision]))
           (filter (fn [finding]
                     (= :tool.lint/bang-suffixed-definition (:type finding)))
                   (:findings governed)))])
  => [[]
      [{:type :tool.lint/bang-suffixed-definition
        :definition/var 'effect!
        :definition/form 'defn.xt
        :rename/candidate 'demo.core/effect
        :rename/collision false}
       {:type :tool.lint/bang-suffixed-definition
        :definition/var 'run!
        :definition/form 'defn
        :rename/candidate 'demo.core/run
        :rename/collision false}
       {:type :tool.lint/bang-suffixed-definition
        :definition/var 'wrap!
        :definition/form 'defmacro-
        :rename/candidate 'demo.core/wrap
        :rename/collision false}]])

^{:refer 'tool.lint/lint-source
  :id 'public-metadata-placement}
(fact "requires public metadata on declaration symbols while preserving fact metadata"
  (let [legacy
        (report-data
         (lint/lint-source
          "(ns demo.core)\n^{:public true} (defn old [] 1)\n"))
        fact-report
        (report-data
         (lint/lint-source
          "(ns demo.core)\n^{:refer demo.core/value}\n(fact true)\n"))]
    [(map :type (:findings legacy))
     (has? (set (map :type (:findings fact-report)))
           :tool.lint/public-metadata-placement)])
  => [[:tool.lint/public-metadata-placement] false])

^{:refer 'tool.lint/lint-source
  :id 'recovering-reader}
(fact "continues after malformed top-level forms and reports in canonical position order"
  (map :type
       (:findings
        (report-data (lint/lint-source "(def x 1)\n)\nmissing"))))
  => [:tool.lint/unresolved-symbol :tool.lint/reader-error])

^{:refer 'tool.lint/lint-source
  :id 'redundant-vector-materialization}
(fact "reports vec only for a proven materialized-vector chain"
  [(map :type
        (:findings
         (report-data
          (lint/lint-source
           "(ns demo.core)\n(let [covered (vec [])] (vec (filter identity covered)))"))))
   (map :type
        (:findings
         (report-data
          (lint/lint-source
           "(ns demo.core)\n(let [covered []] (vec (filter identity covered)))"))))
   (map :type
        (:findings
         (report-data
          (lint/lint-source
           "(ns demo.core)\n(let [references #{}] (vec (sort-by str (filter identity references))))"))))]
  => [[:tool.lint/redundant-vec] [] []])

^{:refer 'tool.lint/lint-source
  :id 'result-report-boundary}
(fact "returns Result success even when the completed report contains findings"
  (let [outcome (lint/lint-source "missing")
        report (Result/data outcome)]
    [(Result/success? outcome)
     (map :type (:findings report))
     (:summary report)
     (:tool.lint/operation (Result/context outcome))])
  => [true
      [:tool.lint/unresolved-symbol]
      {:total 1 :error 1 :warning 0}
      :source])

^{:refer 'tool.lint/lint-file
  :id 'result-error-boundary}
(fact "returns Result error when the linter boundary itself fails"
  (let [outcome (lint/lint-file "__tool_lint_missing_result_boundary__.hal")]
    [(Result/error? outcome)
     (:tool.lint/operation (Result/context outcome))])
  => [true :file])

^{:refer 'tool.lint/analyze-source
  :id 'public-inference-results}
(fact "publishes deterministic normalized inference records"
  (select-keys
   (first (:inferences
           (lint/analyze-source
            "(let [covered (vec [])] (filter identity covered))")))
   [:analysis/schema :analysis/refinements])
  => {:analysis/schema {:kind :primitive :name :vector}
      :analysis/refinements {:vector/backend :persistent
                             :metadata :absent}})

^{:refer 'tool.lint/lint-source
  :id 'src-lang-policy-guard}
(fact "enforces source-language policy through the public lint boundary"
  (let [report
        (report-data
         (lint/lint-source
          (str "(ns xt.lang.spec-demo\n"
               "  (:config {:override [do]})\n"
               "  (:require [std.foundation :refer :all]))\n"
               "(defn.xt value [] nil)\n"
               "(def ^{:schema [:fn [] :xt/str]} x nil)\n")
          {:file "src-lang/xt/lang/demo.hal"}))]
    (set
     (map :type
          (filter
           (fn [finding]
             (has? #{:tool.lint/src-lang-invalid-override
                     :tool.lint/src-lang-foundation-refer-all
                     :tool.lint/spec-schema-placement}
                   (:type finding)))
           (:findings report)))))
  => #{:tool.lint/src-lang-invalid-override
       :tool.lint/src-lang-foundation-refer-all
       :tool.lint/spec-schema-placement})

^{:refer 'tool.lint/lint-source
  :id 'set-removal-symbol-policy}
(fact "accepts dissoc and reports disj as an unresolved Hara symbol"
  (let [report
        (report-data
         (lint/lint-source
          (str "(ns demo.core)\n"
               "(dissoc #{:a} :a)\n"
               "(" "disj" " #{:a} :a)\n")))]
    (mapv :type (:findings report)))
  => [:tool.lint/unresolved-symbol])

(pr-str (run '[tool.lint-test]))
