(ns tool.migrate.common.rule-test
  (:use code.test)
  (:require [tool.migrate.common.rule :as rule]
            [std.block :as block]
            [tool.migrate.common.block :as nav]))

(def foundation-source
  "(ns demo.core
     (:require [std.foundation :as h]
               [std.foundation :as walk]))
   (defn apply-value [value]
     (h/apply-with value (walk/prewalk identity)))")

(def duplicate-source
  "(ns demo.core
     (:require [demo.local :as local]
               [demo.local :as alias]))
   (defn value [input]
     (alias/value input))")

(def foundation-root
  (nav/block-input foundation-source))

(def foundation-clause
  (first (nav/namespace-clause-locations foundation-root)))

(def foundation-entry
  (first (nav/code-child-locations foundation-clause)))

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic parse"
  (try
    (block/tag (nav/block-input foundation-source))
    (catch Throwable error
      (pr-str error)))
  => :root)

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic namespace clauses"
  (try
    (count (nav/namespace-clause-locations (nav/block-input foundation-source)))
    (catch Throwable error
      (pr-str error)))
  => 1)

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic dependency children"
  (try
    (count
     (nav/code-child-locations
      (first (nav/namespace-clause-locations (nav/block-input foundation-source)))))
    (catch Throwable error
      (pr-str error)))
  => 3)

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic dependency path"
  (try
    (nav/path
     (first
      (nav/code-child-locations
       (first (nav/namespace-clause-locations (nav/block-input foundation-source))))))
    (catch Throwable error
      (pr-str error)))
  => [0 4 1])

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic dependency token"
  (try
    (block/string
     (first
      (nav/code-children foundation-entry)))
    (catch Throwable error
      (pr-str error)))
  => "std.foundation")

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic dependency token operations"
  (try
    (let [children (vec (nav/code-children foundation-entry))
          namespace (block/string (nth children 0))
          alias (block/string (nth children 2))]
      [(count children)
       namespace
       alias
       (str/starts-with? namespace ":")
       (str/length alias)
       (str/slice "h/apply-with" (str/length alias) 12)])
    (catch Throwable error
      (pr-str error)))
  => [3 "std.foundation" "h" false 1 "/apply-with"])

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "diagnostic dependency walk"
  (try
    (> (count (nav/walk-locations foundation-root)) 0)
    (catch Throwable error
      (pr-str error)))
  => true)

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "Hara Foundation aliases become qualified root references"
  (try
    (:output
     (rule/analyze-source
      foundation-source
      {:source/language :hara
       :target/language :hara
       :rules []}))
    (catch Throwable error
      (pr-str error)))
  => "NO_ERROR")

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "duplicate dependency aliases keep the first alias and rewrite uses"
  (let [output
        (:output
         (rule/analyze-source
          duplicate-source
          {:source/language :hara
           :target/language :hara
           :rules []}))]
    [(str/includes? output "[demo.local :as local]")
     (not (str/includes? output "[demo.local :as alias]"))
     (str/includes? output "local/value")
     (not (str/includes? output "alias/value"))]
    => [true true true true]))

(pr-str (run {:namespace "tool.migrate.common.rule-test"}))
