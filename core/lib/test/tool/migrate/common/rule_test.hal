(ns tool.migrate.common.rule-test
  (:use code.test)
  (:require [tool.migrate.common.rule :as rule]))

(def foundation-source
  "(ns demo.core
     (:require [std.foundation :as h]
               [std.foundation :as walk]))
   (defn apply-value [value]
     (h/apply-with value (walk/prewalk identity)))")

(def duplicate-source
  "(ns demo.core
     (:require [demo.local :as local]
               [demo.local :as alias]))
   (defn value [input]
     (alias/value input))")

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "Foundation aliases in Clojure input become qualified root references"
  (let [output
        (:output
         (rule/analyze-source
          foundation-source
          {:source/language :clojure
           :target/language :hara
           :rules []}))]
    [(str/includes? output "std.foundation/apply-with")
     (str/includes? output "std.foundation/prewalk")
     (not (str/includes? output "[std.foundation :as h]"))
     (not (str/includes? output "[std.foundation :as walk]"))
     (not (str/includes? output ":require"))])
  => [true true true true true])

^{:refer tool.migrate.common.rule/normalize-dependency-aliases}
(fact "duplicate dependency aliases keep the first alias and rewrite uses"
  (let [output
        (:output
         (rule/analyze-source
          duplicate-source
          {:source/language :hara
           :target/language :hara
           :rules []}))]
    [(str/includes? output "[demo.local :as local]")
     (not (str/includes? output "[demo.local :as alias]"))
     (str/includes? output "local/value")
     (not (str/includes? output "alias/value"))])
  => [true true true true])

(pr-str (run {:namespace "tool.migrate.common.rule-test"}))
