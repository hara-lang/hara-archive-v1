(ns lang.seedgen-test
  (:use code.test)
  (:require [lang.seedgen :as seedgen]))

[
 ^{:refer lang.seedgen/run}
 (test-check "seed generation runs through the default host value"
             (let [result
                   (seedgen/run
                    :root
                    {:units []
                     :language :js
                     :test-root "/tmp/test"})]
               [(get-in result [:summary :operation])
                (get-in result [:summary :count])])
             [:root 0])]
