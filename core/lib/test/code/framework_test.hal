(ns code.framework-test
  (:use code.test)
  (:require [code.framework :as framework]))

(def sample-source
  "(ns sample.core)\n\n(defn ^{:public true} answer \"Returns the answer.\" [] 42)\n(defn- hidden [] nil)\n(defmacro ^{:public true} wrap [form] form)\n(def value 1)\n(defn ^{:schema [:fn [] :int]}\n  schema-answer\n  \"Returns the schema answer.\"\n  []\n  43)\n")

^{:refer code.framework/definition-info}
(fact "definition metadata distinguishes reachable helpers from documented Vars"
  (map
   (fn [entry]
     [(:name entry) (:reachable entry) (:public entry)])
   (:definitions (framework/analyse-source sample-source)))
  => [["answer" true true]
      ["hidden" false false]
      ["wrap" true true]
      ["value" true false]
      ["schema-answer" true false]])

^{:refer code.framework/definition-info}
(fact "form metadata does not publish a declaration"
  (map
   (fn [entry] [(:name entry) (:public entry)])
   (:definitions
    (framework/analyse-source
     (str "(ns demo.core)\n"
          "^{:public true} (defn legacy [] 1)\n"
          "(defn ^{:public true} current [] 2)\n"))))
  => [["legacy" false] ["current" true]])

(fact "source analysis exposes stable definition metadata"
  (let [analysis (framework/analyse-source sample-source)]
    [(:namespace analysis)
     (map (fn [entry] [(:kind entry) (:name entry) (:line entry)])
          (:definitions analysis))
     (map (fn [entry] (:docstring entry)) (:docstrings analysis))])
  => ["sample.core"
      [[:function "answer" 3]
       [:private-function "hidden" 4]
       [:macro "wrap" 5]
       [:value "value" 6]
       [:function "schema-answer" 8]]
      ["Returns the answer."
       "Returns the schema answer."]])

(fact "registered definition families and defstruct constructors are indexed"
  (map (fn [entry] [(:kind entry) (:name entry)])
       (:definitions
        (framework/analyse-source
         "(ns demo.core)\n(defn.pg fetch [] nil)\n(defstruct Task [value])\n")))
  => [[:function "fetch"]
      [:struct "Task"]
      [:constructor "map->Task"]
      [:constructor "->Task"]])

(fact "defmutable shares the struct declaration family and constructor products"
  (map (fn [entry] [(:kind entry) (:name entry)])
       (:definitions
        (framework/analyse-source
         "(ns demo.core)\n(defmutable Cursor [[position :int]])\n")))
  => [[:struct "Cursor"]
      [:constructor "map->Cursor"]
      [:constructor "->Cursor"]])

(fact "defimpl is not part of the native framework surface"
  (:definitions
   (framework/analyse-source
    "(ns demo.core)\n(impl/defimpl Legacy [value])\n"))
  => [])

(fact "Test/run analysis recognises checker, lifecycle, and do wrappers"
  [(select-keys
    (first
     (framework/analyse-test-runs
      "(Test/run [] check {:setup before :teardown after})"))
    [:checker :lifecycle :setup :teardown])
   (count
    (framework/analyse-test-runs
     "(do (prepare) (Test/run [] {:setup before}))"))]
  => [{:checker true :lifecycle true :setup true :teardown true}
      1])

(fact "literal grep reports every exact match column"
  (framework/grep-source "alpha alpha\nbeta" "alpha")
  => [{:line 1 :column 1 :text "alpha alpha"}
      {:line 1 :column 7 :text "alpha alpha"}])

(fact "metadata-wrapped forms retain their metadata and body"
  (let [source
        "(ns demo.core-test)\n^{:refer demo.core/value :added \"1.0\"}\n(fact \"Value\")\n"
        analysis (framework/analyse-structure source)
        form (second (:form-records analysis))]
    [(framework/form-head source form)
     (framework/merged-metadata (framework/form-metadata source form))
     (:full-text form)
     (:line form)
     (:column form)])
  => ["fact"
      {:refer 'demo.core/value :added "1.0"}
      "^{:refer demo.core/value :added \"1.0\"}\n(fact \"Value\")"
      3
      1])

^{:refer code.framework/binding-metadata}
(fact "binding metadata reads only the declaration name"
  (let [source "(ns demo.core)\n(defn ^{:public true :schema :int} answer [] 42)\n"
        definition (first (:definitions (framework/analyse-structure source)))]
    (framework/binding-metadata source
                                (:form definition)
                                (:name-record definition)))
  => {:public true :schema :int})

(pr-str (run {:namespace "code.framework-test"}))
