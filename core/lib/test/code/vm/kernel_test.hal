(ns code.vm.kernel-test
  (:use code.test)
  (:require [code.vm.kernel :as kernel]))

(def results
  [(test-check
    "kernel is a publication-only facade over its internal owner"
    [(get (Runtime/namespace 'code.vm.kernel) :namespace/role)
     (get (Runtime/namespace 'code.vm.kernel.impl) :namespace/role)
     (fn? kernel/session-create)
     (fn? kernel/instrument-event)]
    [:facade :internal true true])

   (test-check
    "kernel instrumentation composes the existing registration and event model"
    (let [registration
          (kernel/instrument-registration
           {:instrument/id :hara/kernel
            :session-id "session-1"
            :instrument/capabilities #{:event/call}
            :instrument/events #{:call/enter}})
          target
          (kernel/instrument-target
           {:target-id "execution-1"
            :target-kind :interpreter
            :runtime :rust
            :session-id "session-1"
            :capabilities #{:event/call}})
          event
          (kernel/instrument-event
           registration
           target
           1
           :call/enter
           {:data {:arguments/count 0}})]
      [(:instrument/id registration)
       (:target-id target)
       (:event event)
       (kernel/instrument-event? event)])
    [:hara/kernel "execution-1" :call/enter true])

   (test-check
    "kernel trace aliases preserve the live trace contract"
    (let [target
          (kernel/instrument-target
           {:target-id "execution-2"
            :target-kind :interpreter
            :runtime :rust
            :session-id "session-1"
            :capabilities #{:event/semantic-boundary}})
          machine (kernel/trace-create target)]
      [(kernel/trace-live-machine? machine)
       (:vm/kind machine)
       (:vm/status machine)
       (kernel/trace-provenance machine)])
    [true :interpreter :ready
     {:vm/mode :live
      :vm/backend :interpreter
      :vm/provider :rust
      :vm/target-id "execution-2"}])

   (test-check
    "kernel exposes all lifecycle and filesystem management methods"
    [(fn? kernel/session-create)
     (fn? kernel/session-eval)
     (fn? kernel/resource-register)
     (fn? kernel/filesystem-create)
     (fn? kernel/filesystem-attach)
     (fn? kernel/filesystem-detach)
     (fn? kernel/filesystem-info)
     (fn? kernel/filesystem-close)
     (fn? kernel/sandbox-open)
     (fn? kernel/sandbox-close)]
    [true true true true true true true true true true])])

(pr-str results)
