(ns code.vm.kernel.impl-test
  (:use code.test)
  (:require [code.vm.kernel.impl :as impl]))

^{:refer code.vm.kernel.impl/sandbox-open}
(fact "keeps the sandbox-open native boundary callable"
  (fn? impl/sandbox-open)
  => true)

^{:refer code.vm.kernel.impl/sandbox-eval}
(fact "keeps the sandbox-eval native boundary callable"
  (fn? impl/sandbox-eval)
  => true)

^{:refer code.vm.kernel.impl/sandbox-call}
(fact "keeps the sandbox-call native boundary callable"
  (fn? impl/sandbox-call)
  => true)

^{:refer code.vm.kernel.impl/sandbox-cancel}
(fact "keeps the sandbox-cancel native boundary callable"
  (fn? impl/sandbox-cancel)
  => true)

^{:refer code.vm.kernel.impl/sandbox-status}
(fact "keeps the sandbox-status native boundary callable"
  (fn? impl/sandbox-status)
  => true)

^{:refer code.vm.kernel.impl/sandbox-close}
(fact "keeps the sandbox-close native boundary callable"
  (fn? impl/sandbox-close)
  => true)

^{:refer code.vm.kernel.impl/session-create}
(fact "keeps session creation callable"
  (fn? impl/session-create)
  => true)

^{:refer code.vm.kernel.impl/session-close}
(fact "keeps session closing callable"
  (fn? impl/session-close)
  => true)

^{:refer code.vm.kernel.impl/session-list}
(fact "keeps session listing callable"
  (fn? impl/session-list)
  => true)

^{:refer code.vm.kernel.impl/session-info}
(fact "keeps session inspection callable"
  (fn? impl/session-info)
  => true)

^{:refer code.vm.kernel.impl/session-eval}
(fact "keeps session evaluation callable"
  (fn? impl/session-eval)
  => true)

^{:refer code.vm.kernel.impl/session-namespace}
(fact "keeps session namespace lookup callable"
  (fn? impl/session-namespace)
  => true)

^{:refer code.vm.kernel.impl/session-complete}
(fact "keeps session completion callable"
  (fn? impl/session-complete)
  => true)

^{:refer code.vm.kernel.impl/resource-register}
(fact "keeps resource registration callable"
  (fn? impl/resource-register)
  => true)

^{:refer code.vm.kernel.impl/resource-remove}
(fact "keeps resource removal callable"
  (fn? impl/resource-remove)
  => true)

^{:refer code.vm.kernel.impl/resource-list}
(fact "keeps resource listing callable"
  (fn? impl/resource-list)
  => true)

^{:refer code.vm.kernel.impl/filesystem-create}
(fact "keeps filesystem creation callable"
  (fn? impl/filesystem-create)
  => true)

^{:refer code.vm.kernel.impl/filesystem-attach}
(fact "keeps filesystem attachment callable"
  (fn? impl/filesystem-attach)
  => true)

^{:refer code.vm.kernel.impl/filesystem-detach}
(fact "keeps filesystem detachment callable"
  (fn? impl/filesystem-detach)
  => true)

^{:refer code.vm.kernel.impl/filesystem-info}
(fact "keeps filesystem inspection callable"
  (fn? impl/filesystem-info)
  => true)

^{:refer code.vm.kernel.impl/filesystem-close}
(fact "keeps filesystem closing callable"
  (fn? impl/filesystem-close)
  => true)

^{:refer code.vm.kernel.impl/capabilities}
(fact "keeps kernel capability discovery callable"
  (fn? impl/capabilities)
  => true)

^{:refer code.vm.kernel.impl/instrument-event-supported?}
(fact "delegates event support checks to the instrumentation model"
  (impl/instrument-event-supported? :interpreter :call/enter)
  => true)

^{:refer code.vm.kernel.impl/instrument-normalize-projection}
(fact "delegates projection normalization to the instrumentation model"
  (map? (impl/instrument-normalize-projection {}))
  => true)

^{:refer code.vm.kernel.impl/instrument-normalize-filter}
(fact "delegates filter normalization to the instrumentation model"
  (map? (impl/instrument-normalize-filter {}))
  => true)

^{:refer code.vm.kernel.impl/instrument-registration}
(fact "delegates instrumentation registration"
  (fn? impl/instrument-registration)
  => true)

^{:refer code.vm.kernel.impl/instrument-registration?}
(fact "delegates registration validation"
  (fn? impl/instrument-registration?)
  => true)

^{:refer code.vm.kernel.impl/instrument-target}
(fact "delegates instrumentation target construction"
  (fn? impl/instrument-target)
  => true)

^{:refer code.vm.kernel.impl/instrument-target?}
(fact "delegates target validation"
  (fn? impl/instrument-target?)
  => true)

^{:refer code.vm.kernel.impl/instrument-event}
(fact "delegates instrumentation event construction"
  (fn? impl/instrument-event)
  => true)

^{:refer code.vm.kernel.impl/instrument-event?}
(fact "delegates event validation"
  (fn? impl/instrument-event?)
  => true)

^{:refer code.vm.kernel.impl/instrument-trace-provenance}
(fact "delegates instrumentation provenance"
  (fn? impl/instrument-trace-provenance)
  => true)

^{:refer code.vm.kernel.impl/trace-live-machine?}
(fact "delegates live trace machine validation"
  (fn? impl/trace-live-machine?)
  => true)

^{:refer code.vm.kernel.impl/trace-target}
(fact "delegates live trace target lookup"
  (fn? impl/trace-target)
  => true)

^{:refer code.vm.kernel.impl/trace-provenance}
(fact "delegates live trace provenance lookup"
  (fn? impl/trace-provenance)
  => true)

^{:refer code.vm.kernel.impl/trace-create}
(fact "delegates live trace creation"
  (fn? impl/trace-create)
  => true)

^{:refer code.vm.kernel.impl/trace-consume}
(fact "delegates one-event trace consumption"
  (fn? impl/trace-consume)
  => true)

^{:refer code.vm.kernel.impl/trace-consume-all}
(fact "delegates trace stream consumption"
  (fn? impl/trace-consume-all)
  => true)

^{:refer code.vm.kernel.impl/trace-from-events}
(fact "delegates live event stream construction"
  (fn? impl/trace-from-events)
  => true)

(pr-str (run {:namespace "code.vm.kernel.impl-test"}))
