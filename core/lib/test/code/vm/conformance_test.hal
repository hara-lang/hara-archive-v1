(ns code.vm.conformance-test
  (:use code.test)
  (:require [code.vm :as vm]
            [code.vm.conformance :as conformance]
            [code.vm.interpreter :as interpreter]
            [code.vm.bytecode :as bytecode]))

(def +source+
  "(+ 1 (* 2 3))")

(defn value-preview
  [type display]
  {:value/type type
   :value/display display
   :value/truncated false})

(defn machine-state
  [ip stack status]
  {:function 0
   :ip ip
   :instruction nil
   :stack stack
   :locals []
   :calls []
   :handlers []
   :status status})

(def +interpreter-journal+
  {:journal/schema "hal.evaluation-journal/0-alpha"
   :journal/id "conformance-interpreter"
   :journal/status :ok
   :journal/events
   [{:event/id 1
     :event/sequence 1
     :event/kind :evaluation/start
     :event/source {:form/path [0]}}
    {:event/id 2
     :event/sequence 2
     :event/kind :operation/enter
     :event/source {:form/path [0 2]}
     :operation/id 1
     :operation/name "std.foundation/*"}
    {:event/id 3
     :event/sequence 3
     :event/kind :operation/return
     :operation/id 1
     :operation/result (value-preview "integer" "6")}
    {:event/id 4
     :event/sequence 4
     :event/kind :operation/enter
     :event/source {:form/path [0]}
     :operation/id 2
     :operation/name "std.foundation/+"}
    {:event/id 5
     :event/sequence 5
     :event/kind :operation/return
     :operation/id 2
     :operation/result (value-preview "integer" "7")}]
   :journal/result (value-preview "integer" "7")})

(def +halc-trace+
  {:trace/schema "hal.halc-trace/0-alpha"
   :trace/id "conformance-halc"
   :trace/status :ok
   :trace/events
   [{:event/id 1
     :event/sequence 1
     :event/stage :source/read
     :event/status :ok
     :event/source {:form/path [0]}
     :event/evidence {:form/count 1}}
    {:event/id 2
     :event/sequence 2
     :event/stage :module/identity
     :event/status :ok
     :event/evidence
     {:module/namespace "lesson.main"
      :module/resource "lesson/main.hal"}}
    {:event/id 3
     :event/sequence 3
     :event/stage :artifact/validate
     :event/status :ok
     :event/evidence {:artifact/valid true}}
    {:event/id 4
     :event/sequence 4
     :event/stage :artifact/decode
     :event/status :ok
     :event/evidence {:decode/parity true}}]
   :trace/result
   {:module/namespace "lesson.main"
    :module/resource "lesson/main.hal"
    :decode/parity true}})

(def +bytecode-program+
  {:program/entry 0
   :program/constants []
   :program/functions []})

(def +bytecode-trace+
  {:trace/schema "hal.bytecode-trace/0-alpha"
   :trace/id "conformance-bytecode"
   :trace/status :ok
   :trace/program +bytecode-program+
   :trace/events
   [{:event/id 1
     :event/sequence 1
     :event/kind :program/validated
     :event/status :ok
     :machine/before (machine-state 0 [] :ready)
     :machine/after (machine-state 0 [] :ready)}
    {:event/id 2
     :event/sequence 2
     :event/kind :instruction/execute
     :event/status :ok
     :event/source {:form/path [0 2]}
     :event/instruction {:opcode :primitive :operands ["*" 2]}
     :machine/before (machine-state 0 [] :ready)
     :machine/after
     (machine-state 1 [(value-preview "integer" "6")] :ready)}
    {:event/id 3
     :event/sequence 3
     :event/kind :instruction/execute
     :event/status :ok
     :event/source {:form/path [0]}
     :event/instruction {:opcode :primitive :operands ["+" 2]}
     :machine/before
     (machine-state 1 [(value-preview "integer" "6")] :ready)
     :machine/after
     (machine-state 2 [(value-preview "integer" "7")] :ready)}
    {:event/id 4
     :event/sequence 4
     :event/kind :machine/return
     :event/status :ok
     :event/source {:form/path [0]}
     :event/instruction {:opcode :return :operands []}
     :machine/before
     (machine-state 2 [(value-preview "integer" "7")] :ready)
     :machine/after (machine-state 3 [] :returned)
     :event/result (value-preview "integer" "7")}]
   :trace/result (value-preview "integer" "7")})

(def +fixture+
  {:fixture/id "nested-arithmetic"
   :fixture/source-id "lesson/main"
   :fixture/source-version 4
   :fixture/source +source+
   :fixture/interpreter +interpreter-journal+
   :fixture/halc +halc-trace+
   :fixture/bytecode +bytecode-trace+})

(def +interpreter-error+
  {:journal/schema "hal.evaluation-journal/0-alpha"
   :journal/id "conformance-interpreter-error"
   :journal/status :error
   :journal/events
   [{:event/id 1
     :event/sequence 1
     :event/kind :evaluation/start
     :event/source {:form/path [0]}}
    {:event/id 2
     :event/sequence 2
     :event/kind :evaluation/error
     :event/source {:form/path [0]}
     :error/category :arithmetic/division-by-zero
     :error/message "division by zero"}]
   :journal/error "division by zero"})

(def +bytecode-error+
  {:trace/schema "hal.bytecode-trace/0-alpha"
   :trace/id "conformance-bytecode-error"
   :trace/status :error
   :trace/program +bytecode-program+
   :trace/events
   [{:event/id 1
     :event/sequence 1
     :event/kind :machine/fail
     :event/status :error
     :event/source {:form/path [0]}
     :event/instruction {:opcode :primitive :operands ["/" 2]}
     :machine/before (machine-state 0 [] :ready)
     :machine/after (machine-state 0 [] :failed)
     :error/category :arithmetic/division-by-zero
     :event/error "division by zero"}]
   :trace/error "division by zero"})

(defn check-by-id
  [report id]
  (first
   (filter
    (fn [check]
      (= id (:check/id check)))
    (:conformance/checks report))))

(defn fails?
  [f]
  (try
    (do (f) false)
    (catch Throwable error
      true)))

(def +report+
  (conformance/run +fixture+))

^{:refer code.vm.conformance/+report-schema+}
(fact "declares the conformance report schema"
  conformance/+report-schema+
  => "hal.code-vm-conformance/0-alpha")

^{:refer code.vm.conformance/+report-statuses+}
(fact "declares pass and fail report statuses"
  conformance/+report-statuses+
  => #{:pass :fail})

^{:refer code.vm.conformance/+stage-kinds+}
(fact "orders all conformance stages"
  conformance/+stage-kinds+
  => [:interpreter :halc :bytecode])

^{:refer code.vm.conformance/+runtime-kinds+}
(fact "identifies runtime stages"
  conformance/+runtime-kinds+
  => [:interpreter :bytecode])

^{:refer code.vm.conformance/invalid}
(fact "raises a structured conformance argument error"
  (fails? (fn [] (conformance/invalid "bad fixture" {:value nil})))
  => true)

^{:refer code.vm.conformance/map-value}
(fact "accepts maps and rejects non-maps"
  [(conformance/map-value "fixture" {:id "fixture"})
   (fails? (fn [] (conformance/map-value "fixture" [])))]
  => [{:id "fixture"} true])

^{:refer code.vm.conformance/vector-value}
(fact "accepts vectors and rejects non-vectors"
  [(conformance/vector-value "required" [:interpreter])
   (fails? (fn [] (conformance/vector-value "required" {})))]
  => [[:interpreter] true])

^{:refer code.vm.conformance/non-empty-string}
(fact "requires a non-empty fixture id"
  [(conformance/non-empty-string "id" "fixture")
   (fails? (fn [] (conformance/non-empty-string "id" "")))]
  => ["fixture" true])

^{:refer code.vm.conformance/supported-stage?}
(fact "checks the supported stage vocabulary"
  [(conformance/supported-stage? :interpreter)
   (conformance/supported-stage? :halc)
   (conformance/supported-stage? :bytecode)
   (conformance/supported-stage? :unknown)]
  => [true true true false])

^{:refer code.vm.conformance/normalize-required}
(fact "normalizes required stages and rejects unknown stages"
  [(conformance/normalize-required nil)
   (conformance/normalize-required [:bytecode :interpreter])
   (fails? (fn [] (conformance/normalize-required [:unknown])))]
  => [[:interpreter :halc :bytecode]
      [:bytecode :interpreter]
      true])

^{:refer code.vm.conformance/machine-source-id}
(fact "extracts the source identity from a machine"
  (conformance/machine-source-id
   (interpreter/from-journal
    +source+
    +interpreter-journal+
    {:source {:id "lesson/interpreter"}}))
  => "lesson/interpreter")

^{:refer code.vm.conformance/result-display}
(fact "extracts display text from value previews"
  [(conformance/result-display (value-preview "integer" "7"))
   (conformance/result-display 7)]
  => ["7" 7])

^{:refer code.vm.conformance/result-type}
(fact "extracts preview types and leaves scalars untyped"
  [(conformance/result-type (value-preview "integer" "7"))
   (conformance/result-type 7)]
  => ["integer" nil])

^{:refer code.vm.conformance/terminal-event}
(fact "returns the event on the most recent transition"
  (let [machine (interpreter/step
                 (interpreter/create +source+ +interpreter-journal+))]
    (:event/kind (conformance/terminal-event machine)))
  => :evaluation/start)

^{:refer code.vm.conformance/machine-error-category}
(fact "falls back to a stable runtime error category"
  (conformance/machine-error-category
   (interpreter/from-journal +source+ +interpreter-error+))
  => :arithmetic/division-by-zero)

^{:refer code.vm.conformance/contiguous-indices?}
(fact "checks transition index continuity"
  [(conformance/contiguous-indices?
    [{:step/index 1} {:step/index 2} {:step/index 3}])
   (conformance/contiguous-indices?
    [{:step/index 1} {:step/index 3}])]
  => [true false])

^{:refer code.vm.conformance/trace-bounded?}
(fact "checks the configured trace history bound"
  [(conformance/trace-bounded?
    (interpreter/from-journal +source+ +interpreter-journal+))
   (conformance/trace-bounded?
    (assoc (interpreter/from-journal +source+ +interpreter-journal+)
           :vm/limits {:history 0}))]
  => [true false])

^{:refer code.vm.conformance/stage-summary}
(fact "summarizes unsupported and supported stages"
  [(select-keys (conformance/stage-summary :halc nil)
                [:stage/kind :stage/supported :stage/status :stage/steps])
   (select-keys
    (conformance/stage-summary
     :interpreter
     (interpreter/from-journal +source+ +interpreter-journal+))
    [:stage/kind :stage/supported :stage/status :stage/terminal])]
  => [{:stage/kind :halc
       :stage/supported false
       :stage/status :unsupported
       :stage/steps 0}
      {:stage/kind :interpreter
       :stage/supported true
       :stage/status :returned
       :stage/terminal true}])

^{:refer code.vm.conformance/summaries}
(fact "creates summaries for every configured stage"
  (set (keys (conformance/summaries {:interpreter nil})))
  => #{:interpreter :halc :bytecode})

^{:refer code.vm.conformance/supported-summaries}
(fact "filters summaries to supported stages"
  (count
   (conformance/supported-summaries
    (conformance/summaries {:interpreter nil})))
  => 0)

^{:refer code.vm.conformance/all-equal?}
(fact "checks equality across zero, one, and many values"
  [(conformance/all-equal? [])
   (conformance/all-equal? [1])
   (conformance/all-equal? [1 1 1])
   (conformance/all-equal? [1 2])]
  => [true true true false])

^{:refer code.vm.conformance/check}
(fact "builds a normalized conformance check record"
  (conformance/check :runtime/parity true :expected :actual)
  => {:check/id :runtime/parity
      :check/pass true
      :check/expected :expected
      :check/actual :actual})

^{:refer code.vm.conformance/missing-required}
(fact "lists required stages that are unsupported"
  (conformance/missing-required
   {:interpreter {:stage/supported true}
    :bytecode {:stage/supported false}}
   [:interpreter :bytecode])
  => [:bytecode])

^{:refer code.vm.conformance/non-terminal-required}
(fact "lists supported stages that have not reached terminal state"
  (conformance/non-terminal-required
   {:interpreter {:stage/supported true :stage/terminal false}
    :bytecode {:stage/supported true :stage/terminal true}}
   [:interpreter :bytecode])
  => [:interpreter])

^{:refer code.vm.conformance/runtime-check}
(fact "compares interpreter and bytecode result parity"
  (:check/pass
   (conformance/runtime-check
    (:conformance/stages +report+)))
  => true)

^{:refer code.vm.conformance/halc-check}
(fact "accepts HALC decode parity and unsupported HALC stages"
  [(:check/pass
    (conformance/halc-check (:conformance/stages +report+)))
   (:check/actual
    (conformance/halc-check
     {:halc {:stage/supported false}}))]
  => [true :unsupported])

^{:refer code.vm.conformance/source-check}
(fact "checks shared source identity across supported stages"
  (select-keys
   (conformance/source-check
    (:conformance/stages +report+)
    "lesson/main")
   [:check/id :check/pass :check/expected])
  => {:check/id :source/identity
      :check/pass true
      :check/expected "lesson/main"})

^{:refer code.vm.conformance/trace-check}
(fact "checks deterministic bounded traces"
  (:check/pass
   (conformance/trace-check (:conformance/stages +report+)))
  => true)

^{:refer code.vm.conformance/transition-concept}
(fact "maps transitions to teaching concepts"
  [(conformance/transition-concept
    :interpreter
    {:step/rule :anything})
   (conformance/transition-concept
    :bytecode
    {:step/rule :instruction/execute})
   (conformance/transition-concept
    :bytecode
    {:step/rule :control})]
  => [:evaluation/order :execution/instruction :execution/control])

^{:refer code.vm.conformance/teaching-annotation}
(fact "turns a transition into a stable teaching annotation"
  (select-keys
   (conformance/teaching-annotation
    :interpreter
    {:step/source {:form/path [0]}
     :step/index 1
     :step/stage :evaluate
     :step/rule :evaluation/start
     :step/events []})
   [:teaching/concept :teaching/focus :teaching/evidence])
  => {:teaching/concept :evaluation/order
      :teaching/focus {:form/path [0]}
      :teaching/evidence {:stage/kind :interpreter
                          :step/index 1
                          :step/stage :evaluate
                          :step/rule :evaluation/start
                          :step/events []}})

^{:refer code.vm.conformance/teaching-annotations}
(fact "collects annotations from supplied machine traces"
  (count
   (conformance/teaching-annotations
    {:interpreter
     (interpreter/from-journal +source+ +interpreter-journal+)}))
  => 6)

^{:refer code.vm.conformance/report?}
(fact "recognizes conformance reports"
  [(conformance/report? +report+)
   (conformance/report? {})]
  => [true false])

^{:refer code.vm.conformance/report}
(fact "builds a report with required stage checks"
  (select-keys
   (conformance/report "empty" {} {:required [:interpreter]})
   [:conformance/schema :fixture/id :conformance/status])
  => {:conformance/schema "hal.code-vm-conformance/0-alpha"
      :fixture/id "empty"
      :conformance/status :fail})

^{:refer code.vm.conformance/source-options}
(fact "derives source and run options from a fixture"
  (conformance/source-options
   {:fixture/id "fixture"
    :fixture/source-id "lesson/main"
    :fixture/source-version 4
    :fixture/limits {:history 2}
    :fixture/run {:steps 3}})
  => {:source {:id "lesson/main" :version 4}
      :limits {:history 2}
      :run {:steps 3}})

^{:refer code.vm.conformance/run}
(fact "runs all supplied fixture stages and returns a passing report"
  [(:conformance/status +report+)
   (:check/pass (check-by-id +report+ :runtime/parity))]
  => [:pass true])

(def results
  [(test-check
    "cross-stage conformance reports runtime, artifact, source, and trace parity"
    (let [report (conformance/run +fixture+)]
      [(conformance/report? report)
       (:conformance/status report)
       (get-in report
               [:conformance/stages :interpreter :stage/status])
       (get-in report
               [:conformance/stages :halc :stage/status])
       (get-in report
               [:conformance/stages :bytecode :stage/status])
       (:check/pass (check-by-id report :runtime/parity))
       (:check/pass (check-by-id report :halc/decode-parity))
       (:check/pass (check-by-id report :source/identity))
       (:check/pass
        (check-by-id report :trace/deterministic-and-bounded))])
    [true :pass :returned :returned :returned
     true true true true])

   (test-check
    "teaching annotations are deterministic data derived from recorded transitions"
    (let [report (conformance/run +fixture+)
          annotations (:conformance/teaching report)
          first-annotation (first annotations)
          instruction
          (first
           (filter
            (fn [annotation]
              (= :execution/instruction
                 (:teaching/concept annotation)))
            annotations))]
      [(count annotations)
       (:teaching/concept first-annotation)
       (get-in first-annotation
               [:teaching/evidence :stage/kind])
       (get-in first-annotation
               [:teaching/evidence :step/index])
       (:teaching/concept instruction)
       (get-in instruction
               [:teaching/evidence :step/rule])
       (get-in instruction [:teaching/focus :form/path])])
    [15
     :evaluation/order
     :interpreter
     1
     :execution/instruction
     :instruction/execute
     [0 2]])

   (test-check
    "runtime result divergence fails the shared conformance report"
    (let [trace
          (assoc-in
           (assoc +bytecode-trace+
                  :trace/result (value-preview "integer" "8"))
           [:trace/events 3 :event/result]
           (value-preview "integer" "8"))
          report
          (conformance/run
           (assoc +fixture+ :fixture/bytecode trace))
          parity (check-by-id report :runtime/parity)]
      [(:conformance/status report)
       (:check/pass parity)
       (get-in parity [:check/expected :value])
       (get-in parity [:check/actual :value])])
    [:fail false "7" "8"])

   (test-check
    "optional stages stay explicitly unsupported without silent fallback"
    (let [report
          (conformance/run
           (dissoc
            (assoc +fixture+
                   :fixture/required [:interpreter :halc])
            :fixture/bytecode))]
      [(:conformance/status report)
       (get-in report
               [:conformance/stages :bytecode :stage/supported])
       (get-in report
               [:conformance/stages :bytecode :stage/status])
       (:check/pass (check-by-id report :stages/required))
       (:check/actual (check-by-id report :runtime/parity))])
    [:pass false :unsupported true :unsupported])

   (test-check
    "missing required stages fail before a corpus fixture is accepted"
    (let [report
          (conformance/run
           (dissoc +fixture+ :fixture/bytecode))]
      [(:conformance/status report)
       (:check/pass (check-by-id report :stages/required))
       (:check/actual (check-by-id report :stages/required))])
    [:fail false [:bytecode]])

   (test-check
    "failed runtimes compare normalized error categories rather than host text"
    (let [report
          (conformance/run
           {:fixture/id "division-error"
            :fixture/source-id "lesson/error"
            :fixture/source "(/ 1 0)"
            :fixture/required [:interpreter :bytecode]
            :fixture/interpreter +interpreter-error+
            :fixture/bytecode +bytecode-error+})
          parity (check-by-id report :runtime/parity)]
      [(:conformance/status report)
       (:check/pass parity)
       (get-in parity [:check/expected :status])
       (get-in parity [:check/actual :status])
       (get-in parity [:check/expected :error-category])
       (get-in parity [:check/actual :error-category])])
    [:pass true :failed :failed
     :arithmetic/division-by-zero
     :arithmetic/division-by-zero])

   (test-check
    "source identity mismatches are surfaced as a dedicated check"
    (let [interpreter-machine
          (interpreter/from-journal
           +source+
           +interpreter-journal+
           {:source {:id "lesson/interpreter"}})
          bytecode-machine
          (bytecode/from-trace
           +source+
           +bytecode-trace+
           {:source {:id "lesson/bytecode"}})
          report
          (conformance/report
           "source-mismatch"
           {:interpreter interpreter-machine
            :bytecode bytecode-machine}
           {:required [:interpreter :bytecode]})
          source-check (check-by-id report :source/identity)]
      [(:conformance/status report)
       (:check/pass source-check)
       (:check/actual source-check)])
    [:fail false ["lesson/interpreter" "lesson/bytecode"]])])

results
