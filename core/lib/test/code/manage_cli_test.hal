(ns code.manage-cli-test
  (:require [code.manage.cli :as cli]))

[(test-check "manage owns operation and write argument parsing"
              (cli/parse-arguments
               ["ns-rename" "code.manage" "--from" "code.manage"
                "--to" "code.manage.next" "--write"])
              {:operation :ns-rename
               :write true
               :namespaces ["code.manage"]
               :format :edn
               :options {:from "code.manage" :to "code.manage.next"}})
  (test-check "editor JSON and project-derived added overrides are parsed"
              (cli/parse-arguments
               ["scaffold" "code.manage" "--added" "5.8"
                "--format" "editor-json"])
              {:operation :scaffold
               :write false
               :namespaces ["code.manage"]
               :format :editor-json
               :options {:added "5.8"}})
  (test-check "contract-check accepts one path and the completion override"
              (cli/parse-arguments
               ["contract-check" "issue-contract.md" "--complete"])
              {:operation :contract-check
               :write false
               :namespaces ["issue-contract.md"]
               :format :edn
               :options {:complete? true}})
  (test-check "obsolete import and purge options are rejected explicitly"
              [(try
                 (cli/parse-arguments ["import" "code.manage" "--form" "(def x 1)"])
                 :not-thrown
                 (catch Throwable error (ex-message error)))
               (try
                 (cli/parse-arguments ["purge" "code.manage" "--pattern" "TODO"])
                 :not-thrown
                 (catch Throwable error (ex-message error)))]
              ["import --form is obsolete; import reads matching fact titles"
               "purge --pattern is obsolete; purge removes docstrings and :added metadata"])
  (test-check "source units carry test pairing and both project version fields"
              (cli/paired-source-unit
               {:path "/project/src/demo/core.hal"
                :source "(ns demo.core)\n"
                :type :source}
               "5.8.3"
               "/project/test/demo/core_test.hal"
               "(ns demo.core-test)\n")
              {:path "/project/src/demo/core.hal"
               :source "(ns demo.core)\n"
               :type :source
               :version "5.8.3"
               :project-version "5.8.3"
               :test-path "/project/test/demo/core_test.hal"
               :test-source "(ns demo.core-test)\n"})
  (test-check "project source roots map to corresponding custom test roots"
              (cli/project-test-path
               {:project/root "/project"
                :project/source-paths ["core/lib/src" "core/lib/src-lang"]
                :project/test-paths ["core/lib/test" "core/lib/test-lang"]}
               "/project/core/lib/src-lang/xt/demo.hal")
              "/project/core/lib/test-lang/xt/demo_test.hal")
  (test-check "edit containment distinguishes the project root from siblings"
              [(cli/path-under-root? "/project" "/project")
               (cli/path-under-root? "/project" "/project/test/core_test.hal")
               (cli/path-under-root? "/project" "/project-next/test.hal")
               (cli/path-under-root? "/project" "/outside/test.hal")]
              [true true false false])
  (test-check "editor-json rendering emits the stable wire schema"
              (let [payload
                    (Json/read
                     (cli/render-plan
                      {:operation :pedantic
                       :summary {:changed 0 :findings 1}
                       :findings [{:path "src/demo/core.hal"
                                   :line 3 :column 1
                                   :classification "M"
                                   :kind :missing
                                   :refer "demo.core/value"
                                   :message "missing fact"}]
                       :edits []}
                      {:format :editor-json :write false}))]
                [(get payload "schema")
                 (get payload "operation")
                 (get payload "write")
                 (get-in payload ["findings" 0 "classification"])])
              ["code.manage.editor/0-alpha" "pedantic" false "M"])
  ^{:refer code.manage.cli/selected?}
  (test-check "namespace selectors use source path spelling"
              (cli/selected? "/project/src/code/manage.hal" ["code.manage"])
              true)
  ^{:refer code.manage.cli/parsed-selector}
  (test-check "CLI selectors use the shared scalar and disjunction forms"
              [(cli/parsed-selector [])
               (cli/parsed-selector ["code.manage"])
               (cli/parsed-selector ["code" "std"])]
              [:all "code.manage" ["code" "std"]])
  ^{:refer code.manage.cli/path-selector-candidates}
  (test-check "path selectors expose namespace suffix candidates"
              (cli/path-selector-candidates "/project/src/code/manage.hal")
              ["project.src.code.manage"
               "src.code.manage"
               "code.manage"
               "manage"])
  (test-check "manage handler reaches its parser through the default host"
              (let [message
                    (try
                      (cli/handler
                       {:request/arguments ["unsupported"]
                        :request/cwd "/home/runner/work/hara/hara"})
                      :not-thrown
                      (catch Throwable error
                        (ex-message error)))]
                [(not= :not-thrown message)
                 (str/includes? message "unsupported manage operation :unsupported")])
              [true true])


  ]
