(ns code.test-work-test
  (:require [code.test :as fact]
            [code.test.base.runtime :as runtime]
            [code.test.work :as test-work]
            [work.base :as work]))

(def execution-count (atom 0))

(def ordering-fixtures
  [{:namespace "alpha.test" :name "late" :meta {:line 30}}
   {:namespace "beta.test" :name "late" :meta {:line 10}}
   {:namespace "alpha.test" :name "early" :meta {:line 20}}
   {:namespace "beta.test" :name "early" :meta {:line 5}}])

(fact/fact "work-driven passing fact"
  (swap! execution-count inc)
  1 => 1)

(fact/fact "work-driven failing fact"
  1 => 2)

(def registered-passing
  (runtime/get-fact
   "code.test-work-test"
   "work-driven passing fact"))
(def registered-failing
  (runtime/get-fact
   "code.test-work-test"
   "work-driven failing fact"))

(def suite-runtime (work/durable-runtime))
(def suite-reference
  (test-work/start
   suite-runtime
   {:namespace 'code.test-work-test
    :test/revision 7}
   {:id "test-suite-1"}))
(def suite-result
  (work/result suite-runtime suite-reference))
(def same-suite-reference
  (test-work/start
   suite-runtime
   {:namespace 'code.test-work-test
    :test/revision 7}
   {:id "test-suite-1"}))

(def fact-runtime (work/durable-runtime))
(def fact-reference
  (work/start
   fact-runtime
   (test-work/fact-work
    'code.test-work-test
    "work-driven failing fact"
    7)
   {}
   {:id "test-fact-1"}))
(def fact-result
  (work/result fact-runtime fact-reference))

(def observer (work/recording-observer))
(def reported-runtime (work/local-runtime {:observer observer}))
(def reported-result
  (work/run
   reported-runtime
   (test-work/fact-work
    'code.test-work-test
    "work-driven failing fact"
    7)
   {}))
(def reported-events
  (vec
   (filter
    (fn [event]
      (or (= :test/fact-started (:event event))
          (= :test/fact-completed (:event event))))
    (work/observer-events observer))))

(def public-runtime (work/durable-runtime))
(def public-result
  (fact/run
   public-runtime
   {:namespace 'code.test-work-test
    :name "work-driven failing fact"
    :test/revision 8}
   {:id "test-public-run"}))
(def public-replayed-result
  (fact/run
   public-runtime
   {:namespace 'code.test-work-test
    :name "work-driven failing fact"
    :test/revision 8}
   {:id "test-public-run"}))
(def public-runs (work/list-runs public-runtime))

(defn check-result-view
  [result]
  [(Result/status result)
   (if (Result/success? result)
     (Result/data result)
     (ex-message (Result/error-value result)))
   (Result/context result)])

(defn fact-result-view
  [result]
  (assoc result
         :checks
         (vec (map check-result-view (:checks result)))))

(defn summary-result-view
  [summary]
  (assoc (dissoc summary :report :artifacts)
         :results
         (vec (map fact-result-view (:results summary)))))

(def results
  [^{:refer code.test.work/fact-source-line}
   (test-check
    "fact ordering prefers source lines when available"
    [(vec (map test-work/fact-source-line ordering-fixtures))
     (test-work/fact-source-line registered-passing)
     (number? (test-work/fact-order-position registered-passing))
     (< (test-work/fact-order-position registered-passing)
        (test-work/fact-order-position registered-failing))]
    [[30 10 20 5] nil true true])

   ^{:refer code.test.work/fact-source-line?}
   (test-check
    "line ordering ignores missing source locations"
    [(test-work/fact-source-line? {:meta {:line 17}})
     (test-work/fact-source-line? {:meta {}})]
    [true false])

   ^{:refer code.test.work/fact-order-position}
   (test-check
    "registration order fills in absent source lines"
    [(test-work/fact-order-position {:meta {:line 17}})
     (test-work/fact-order-position {:meta {:test/order 7}})
     (test-work/fact-order-position? {:meta {:test/order 7}})]
    [17 7 true])

   ^{:refer code.test.work/fact-order-position?}
   (test-check
    "order positions must be numeric"
    [(test-work/fact-order-position? {:meta {:test/order 7}})
     (test-work/fact-order-position? {:meta {:test/order "7"}})]
    [true false])

   ^{:refer code.test.work/fact-before?}
   (test-check
    "fact ordering compares only facts in the same namespace"
    [(test-work/fact-before?
      (nth ordering-fixtures 2)
      (nth ordering-fixtures 0))
     (test-work/fact-before?
      (nth ordering-fixtures 2)
      (nth ordering-fixtures 1))]
    [true false])

   ^{:refer code.test.work/insert-fact}
   (test-check
    "fact insertion uses numeric source lines"
    (vec
     (map :name
          (reduce test-work/insert-fact
                  []
                  [(nth ordering-fixtures 0)
                   (nth ordering-fixtures 2)])))
    ["early" "late"])

   ^{:refer code.test.work/order-namespace-facts}
   (test-check
    "namespace ordering sorts only that namespace"
    (vec
     (map :name
          (test-work/order-namespace-facts
           ordering-fixtures
           "alpha.test")))
    ["early" "late"])

   ^{:refer code.test.work/replace-namespace-slots}
   (test-check
    "namespace replacement preserves other namespace slots"
    (vec
     (map (fn [entry] [(:namespace entry) (:name entry)])
          (test-work/replace-namespace-slots
           ordering-fixtures
           "alpha.test"
           (test-work/order-namespace-facts
            ordering-fixtures
            "alpha.test"))))
    [["alpha.test" "early"]
     ["beta.test" "late"]
     ["alpha.test" "late"]
     ["beta.test" "early"]])

   ^{:refer code.test.work/order-facts}
   (test-check
    "facts are ordered by source line within each namespace"
    (vec
     (map (fn [entry] [(:namespace entry) (:name entry)])
          (test-work/order-facts ordering-fixtures)))
    [["alpha.test" "early"]
     ["beta.test" "early"]
     ["alpha.test" "late"]
     ["beta.test" "late"]])

   (test-check
    "suite execution uses managed Work while retaining test-domain status"
    [(work/status suite-runtime suite-reference)
     (:status suite-result)
     (get-in suite-result [:counts :passed])
     (get-in suite-result [:counts :failed])
     (deref execution-count)]
    [:completed :failed 1 1 1])

   (test-check
    "idempotent suite starts replay the completed suite boundary"
    [(work/status suite-runtime same-suite-reference)
     (= (:run/id (work/run-record suite-runtime suite-reference))
        (:run/id (work/run-record suite-runtime same-suite-reference)))
     (deref execution-count)
     (count (work/checkpoints suite-runtime suite-reference))]
    [:completed true 1 4])

   (test-check
    "a failed assertion is a completed fact work result"
    [(work/status fact-runtime fact-reference)
     (:status fact-result)
     (count (:checks fact-result))
     (count (work/checkpoints fact-runtime fact-reference))]
    [:completed :failed 1 1])

   (test-check
    "test events reach Runtime hooks after durable append"
    [(:status reported-result)
     (vec (map (fn [event] (:event event)) reported-events))]
    [:failed [:test/fact-started :test/fact-completed]])

   (test-check
    "public code.test/run uses the canonical fact-batch work graph"
     [(:op (work/work-spec fact/+runner-work+))
     (:status public-result)
     (= (summary-result-view public-result)
        (summary-result-view public-replayed-result))
     (count public-runs)
     (:run/status (first public-runs))]
    [:chain :failed true 1 :completed])])

results
