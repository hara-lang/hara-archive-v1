(ns code.test-work-cleanup-test
  (:require [code.test :as fact]
            [code.test.work :as test-work]
            [work.base :as work]))

(defn event-count
  [events event]
  (reduce
   (fn [total record]
     (if (= event (:event record))
       (inc total)
       total))
   0
   events))

(defn event-kinds
  [events]
  (vec (map (fn [event] (:event event)) events)))

(defn test-event?
  [event]
  (or (= :test/run-started (:event event))
      (= :test/fact-started (:event event))
      (= :test/fact-completed (:event event))
      (= :test/run-completed (:event event))))

(def lifecycle (atom []))
(def observer (work/recording-observer))

(fact/register
 "scoped passing fact"
 (fn [options]
   [(fact/check
     (fn []
       (swap! lifecycle conj :body)
       1)
     1
     options)])
 {:test/namespace "code.test-work-cleanup-test"
  :test/definition "definition:scoped-passing-v1"
  :before (fn [] (swap! lifecycle conj :fact-before))
  :after (fn [] (swap! lifecycle conj :fact-after))})

(def scoped-options
  {:namespace 'code.test-work-cleanup-test
   :name "scoped passing fact"
   :test/revision 21
   :before-all (fn [] (swap! lifecycle conj :before-all))
   :after-all (fn [] (swap! lifecycle conj :after-all))
   :before-each (fn [] (swap! lifecycle conj :before-each))
   :after-each (fn [] (swap! lifecycle conj :after-each))})

(def scoped-runtime (work/durable-runtime {:observer observer}))
(def scoped-reference
  (test-work/start-batch
   scoped-runtime
   scoped-options
   {:id "cleanup-scoped-fact"}))
(def scoped-summary
  (test-work/batch-result scoped-runtime scoped-reference))
(def scoped-history
  (work/history scoped-runtime scoped-reference))
(def scoped-checkpoints
  (work/checkpoints scoped-runtime scoped-reference))
(def scoped-order (deref lifecycle))
(def scoped-events
  (vec (filter test-event? (work/observer-events observer))))
(def same-scoped-reference
  (test-work/start-batch
   scoped-runtime
   scoped-options
   {:id "cleanup-scoped-fact"}))
(def replay-order (deref lifecycle))
(def replay-events
  (vec (filter test-event? (work/observer-events observer))))

(def after-error-count (atom 0))
(fact/register
 "after hook error"
 (fn [options]
   [(fact/check (fn [] 1) 1 options)])
 {:test/namespace "code.test-work-cleanup-test"
  :test/definition "definition:after-hook-error-v1"
  :after (fn []
           (swap! after-error-count inc)
           (throw (ex-info "after hook failed" {})))})

(def after-error-runtime (work/durable-runtime))
(def after-error-reference
  (test-work/start-batch
   after-error-runtime
   {:namespace 'code.test-work-cleanup-test
    :name "after hook error"
    :test/revision 22}
   {:id "cleanup-after-error"}))
(def after-error-summary
  (test-work/batch-result after-error-runtime after-error-reference))

(def cancellation-order (atom []))
(def cancellation-runtime (work/durable-runtime))
(fact/register
 "runtime cancellation"
 (fn [options]
   (swap! cancellation-order conj :body)
   (work/cancel cancellation-runtime
                "runtime-cancellation"
                {:reason :test})
   [(fact/check (fn [] 1) 1 options)])
 {:test/namespace "code.test-work-cleanup-test"
  :test/definition "definition:runtime-cancellation-v1"
  :before (fn [] (swap! cancellation-order conj :fact-before))
  :after (fn [] (swap! cancellation-order conj :fact-after))})

(def cancellation-reference
  (test-work/start-batch
   cancellation-runtime
   {:namespace 'code.test-work-cleanup-test
    :name "runtime cancellation"
    :test/revision 24
    :before-all (fn [] (swap! cancellation-order conj :before-all))
    :after-all (fn [] (swap! cancellation-order conj :after-all))
    :before-each (fn [] (swap! cancellation-order conj :before-each))
    :after-each (fn [] (swap! cancellation-order conj :after-each))}
   {:id "runtime-cancellation"}))

(def cleanup-fail-fast-summary
  (test-work/run-batch
   (work/local-runtime)
   (assoc scoped-options
          :fail-fast true
          :test/revision 26)))

(def setup-cleanup-count (atom 0))
(def setup-failure-runtime (work/durable-runtime))
(def setup-failure-reference
  (test-work/start-batch
   setup-failure-runtime
   {:namespace 'code.test-work-cleanup-test
    :name "scoped passing fact"
    :test/revision 25
    :before-all (fn []
                  (throw (ex-info "suite setup failed" {})))
    :after-all (fn [] (swap! setup-cleanup-count inc))}
   {:id "suite-setup-failure"}))

(def results
  [(test-check
    "fact and suite hooks use cleanup-safe durable scopes"
    [(:status scoped-summary)
     scoped-order
     (count scoped-checkpoints)
     (event-kinds scoped-events)
     (event-count scoped-history :test/run-started)
     (event-count scoped-history :test/fact-started)
     (event-count scoped-history :test/fact-completed)
     (event-count scoped-history :test/run-completed)]
    [:passed
     [:before-all
      :before-each
      :fact-before
      :body
      :fact-after
      :after-each
      :after-all]
     2
     [:test/run-started
      :test/fact-started
      :test/fact-completed
      :test/run-completed]
     1 1 1 1])

   (test-check
    "idempotent starts do not rerun hooks or duplicate observer events"
    [(= (:run/id (work/run-record scoped-runtime scoped-reference))
        (:run/id (work/run-record scoped-runtime same-scoped-reference)))
     replay-order
     (event-kinds replay-events)]
    [true
     [:before-all
      :before-each
      :fact-before
      :body
      :fact-after
      :after-each
      :after-all]
     [:test/run-started
      :test/fact-started
      :test/fact-completed
      :test/run-completed]])

   (test-check
    "after-hook failures remain completed test-domain errors"
    [(work/status after-error-runtime after-error-reference)
     (:status after-error-summary)
     (get-in after-error-summary [:counts :error])
     (deref after-error-count)]
    [:completed :failed 1 1])

   (test-check
    "runtime cancellation still executes fact and suite cleanup"
    [(work/status cancellation-runtime cancellation-reference)
     (deref cancellation-order)
     (event-count (work/history cancellation-runtime cancellation-reference)
                  :work/run-cancelled)]
    [:cancelled
     [:before-all
      :before-each
      :fact-before
      :body
      :fact-after
      :after-each
      :after-all]
     1])

   (test-check
    "suite cleanup runs when suite setup fails"
    [(work/status setup-failure-runtime setup-failure-reference)
     (deref setup-cleanup-count)]
    [:completed 1])

   (test-check
    "runtime-owned fail-fast remains cleanup-safe for passing suites"
    [(:status cleanup-fail-fast-summary)
     (get-in cleanup-fail-fast-summary [:counts :passed])
     (get-in cleanup-fail-fast-summary [:counts :cancelled])]
    [:passed 1 0])])

results
