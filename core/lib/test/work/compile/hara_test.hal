(ns work.compile.hara-test
  (:use code.test)
  (:require [work.base :as work]
            [work.eval :as evaluator]
            [work.compile.hara :as lowering]))

(def captured-continuation
  (let [offset 7]
    (fn [value context]
      (work/pure
       :produced
       (fn [input child-context]
         (+ input offset))))))

^{:refer work.compile.hara/work-value? :added "0.1"}
(fact "Work lowering accepts only IWork values"
  [(lowering/work-value? (work/pure :value (fn [input context] input)))
   (lowering/work-value? {:op :pure})]
  => [true false])

^{:refer work.compile.hara/closure-value? :added "0.1"}
(fact "Work lowering identifies executable closures without treating Work as one"
  [(lowering/closure-value? captured-continuation)
   (lowering/closure-value? (work/pure :value (fn [input context] input)))
   (lowering/closure-value? {:value 1})]
  => [true false false])

^{:refer work.compile.hara/reset-closures :added "0.1"}
(fact "closure references have an explicit reset boundary"
  [(lowering/reset-closures)
   (try
     (do
       (lowering/resolve-closure 1)
       :available)
     (catch Throwable error
       (:closure/token (ex-data error))))]
  => [nil 1])

^{:refer work.compile.hara/register-closure :added "0.1"}
(fact "register-closure assigns fresh process-local tokens"
  (lowering/reset-closures)
  (let [first-token (lowering/register-closure captured-continuation)
        second-token (lowering/register-closure captured-continuation)]
    [first-token
     second-token
     (= (lowering/resolve-closure first-token)
        captured-continuation)
     (= (lowering/resolve-closure second-token)
        captured-continuation)])
  => [1 2 true true])

^{:refer work.compile.hara/resolve-closure :added "0.1"}
(fact "resolve-closure returns the registered executable value"
  (lowering/reset-closures)
  (let [token (lowering/register-closure captured-continuation)]
    (= (lowering/resolve-closure token)
       captured-continuation))
  => true)

^{:refer work.compile.hara/ir-value :added "0.1"}
(fact "Work IR makes nested Work and captured closures explicit"
  (let [definition
        (work/bind
         {:id :ir-bind}
         (work/pure :source (fn [input context] input))
         (work/pure :continuation captured-continuation))
         representation (lowering/ir-value definition)
         continuation
         (get-in representation [:ir/value :continuation :ir/value :fn :ir/value])
         produced (continuation 3 {})]
    [(get-in representation [:ir/kind])
     (get-in representation [:ir/value :source :ir/kind])
     (get-in representation [:ir/value :continuation :ir/value :fn :ir/kind])
     ((:fn (work/work-spec produced)) 0 {})])
  => [:work :work :closure 7])

^{:refer work.compile.hara/ir-value :added "0.1"}
(fact "Work IR makes graph inputs, nodes, and dependencies explicit"
  (let [graph
        (work/graph
         {:value (work/input :value)
          :node (work/node [:value] (fn [value] value))})
        representation (lowering/ir-value graph)]
    (sort
     [(get-in representation [:ir/value :dependencies :ir/kind])
      (get-in representation [:ir/value :dependencies :ir/entries :value :ir/kind])
      (get-in representation [:ir/value :dependencies :ir/entries :node :ir/kind])
      (get-in representation [:ir/value :dependencies :ir/entries :node :ir/dependencies 0])]))
  => [:graph-deps :graph-input :graph-node :value])

^{:refer work.compile.hara/ir :added "0.1"}
(fact "Work IR carries a version and preserves bind structure"
  (let [definition
        (work/bind
         {:id :ir-contract}
         (work/pure :source (fn [input context] input))
         (work/pure :continuation captured-continuation))
        representation (lowering/ir definition)]
    [(get-in representation [:ir/version])
     (get-in representation [:ir/work :ir/value :op])
    (get-in representation [:ir/work :ir/value :source :ir/value :op])
    (get-in representation [:ir/work :ir/value :continuation :ir/value :fn :ir/kind])])
  => [1 :bind :pure :closure])

^{:refer work.compile.hara/form-value :added "0.1"}
(fact "form-value recursively retains closure leaves and lowers Work children"
  (lowering/reset-closures)
  (let [definition
        (work/bind
         {:id :form-value-bind}
         (work/pure :source (fn [input context] input))
         (work/pure :continuation captured-continuation))
        lowered (lowering/form-value {:work definition
                                      :closure captured-continuation})]
    [(first (get-in lowered [:work]))
     (first (get-in lowered [:closure]))
     (long? (second (get-in lowered [:closure])))
     (= (lowering/resolve-closure (second (get-in lowered [:closure])))
        captured-continuation)])
  => ['work.base/definition 'work.compile.hara/resolve-closure true true])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms execute bind with captured closures"
  (let [definition
        (work/bind
         {:id :compiled-bind}
         (work/pure :source (fn [input context] (inc input)))
         (work/pure :continuation captured-continuation))
        generated (lowering/form definition)
        rebuilt (eval generated)]
    [(form? generated)
     (first generated)
     (get-in (second generated) [:op])
     (work/run definition 3)
     (work/run rebuilt 3)])
  => [true 'work.base/definition :bind 11 11])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms reconstruct graph definitions"
  (let [graph
        (work/graph
         {:value (work/input :value)
          :node (work/node [:value] (fn [value] value))})
        generated (lowering/form graph)
        rebuilt (eval generated)]
    [(form? generated)
     (first generated)
     (= (work/run graph {:value 3})
        (work/run rebuilt {:value 3}))])
  => [true 'work.base/definition true])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve canonical structural operations"
  (lowering/reset-closures)
  (try
    (let [step (work/step :double (fn [input context] (* input 2)))
          chain (work/chain
                 [(work/pure :increment (fn [input context] (+ input 1)))
                  (work/pure :double (fn [input context] (* input 2)))])
          all (work/all
               [(work/pure :increment (fn [input context] (+ input 1)))
                (work/pure :double (fn [input context] (* input 2)))])
          each (work/each (work/pure :increment (fn [input context] (+ input 1))))
          choose (work/choose
                  (work/pure :select (fn [input context] :double))
                  {:double (work/pure :double (fn [input context] (* input 2)))})
          ensure (work/ensure
                  (work/pure :body (fn [input context] (+ input 1)))
                  (work/pure :cleanup (fn [outcome context] :clean)))
          rebuilt-step (eval (lowering/form step))
          rebuilt-chain (eval (lowering/form chain))
          rebuilt-all (eval (lowering/form all))
          rebuilt-each (eval (lowering/form each))
          rebuilt-choose (eval (lowering/form choose))
          rebuilt-ensure (eval (lowering/form ensure))]
      [(work/run step 6) (work/run rebuilt-step 6)
       (work/run chain 3) (work/run rebuilt-chain 3)
       (work/run all 3) (work/run rebuilt-all 3)
       (work/run each [1 2 3]) (work/run rebuilt-each [1 2 3])
       (work/run choose 4) (work/run rebuilt-choose 4)
       (work/run ensure 4) (work/run rebuilt-ensure 4)])
    (finally
      (lowering/reset-closures)))
  => [12 12
      8 8
      [4 6] [4 6]
      [{:item/id 0 :item/value 2}
       {:item/id 1 :item/value 3}
       {:item/id 2 :item/value 4}]
      [{:item/id 0 :item/value 2}
       {:item/id 1 :item/value 3}
       {:item/id 2 :item/value 4}]
      8 8
      5 5])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve collection and batch operations"
  (lowering/reset-closures)
  (try
    (let [filter-work
          (work/filter
           (work/pure :even? (fn [input context] (= 0 (mod input 2)))) )
          fold-work
          (work/fold
           0
           (work/pure :sum
             (fn [input context]
               (+ (:acc input) (:item/value input)))))
          batch-work
          (work/batch
           {:list (work/pure :list (fn [input context] [1 2]))
            :process (work/pure :process (fn [input context] (* input 2)))
            :summarise
            (work/pure :summary
              (fn [input context] (count (:results input))))})
          rebuilt-filter (eval (lowering/form filter-work))
          rebuilt-fold (eval (lowering/form fold-work))
          rebuilt-batch (eval (lowering/form batch-work))]
      [(work/run filter-work [1 2 3 4])
       (work/run rebuilt-filter [1 2 3 4])
       (work/run fold-work [1 2 3 4])
       (work/run rebuilt-fold [1 2 3 4])
       (work/run batch-work :input)
       (work/run rebuilt-batch :input)])
    (finally
      (lowering/reset-closures)))
  => [[{:item/id 1 :item/value 2}
       {:item/id 3 :item/value 4}]
      [{:item/id 1 :item/value 2}
       {:item/id 3 :item/value 4}]
      10 10
      {:items [{:item/id 0 :item/value 1}
               {:item/id 1 :item/value 2}]
       :results [{:item/id 0 :item/value 2}
                 {:item/id 1 :item/value 4}]
       :summary 2}
      {:items [{:item/id 0 :item/value 1}
               {:item/id 1 :item/value 2}]
       :results [{:item/id 0 :item/value 2}
                 {:item/id 1 :item/value 4}]
       :summary 2}])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve qualified and pinned target profiles"
  (let [registry
        {:double (fn [input context] (* input 2))
         [:triple 1 "digest"] (fn [input context] (* input 3))}
        qualified
        (work/step
         {:id :qualified-target
          :target {:target/type :qualified
                   :target/name :double}}
         (fn [input context] input))
        pinned
        (work/step
         {:id :pinned-target
          :target {:target/type :pinned
                   :target/name :triple
                   :target/version 1
                   :target/digest "digest"}}
         (fn [input context] input))
        options {:work/registry registry}
        rebuilt-qualified (eval (lowering/form qualified))
        rebuilt-pinned (eval (lowering/form pinned))]
    [(evaluator/run nil qualified 4 options)
     (evaluator/run nil rebuilt-qualified 4 options)
     (evaluator/run nil pinned 4 options)
     (evaluator/run nil rebuilt-pinned 4 options)])
  => [8 8 12 12])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve managed bind lineage"
  (lowering/reset-closures)
  (try
    (let [definition
          (work/bind
           {:id :managed-bind-equivalence :version 1}
           (work/step :source
             (fn [input context] (+ input 1)))
           (work/pure :continuation
             (fn [value context]
               (work/step :produced
                 (fn [produced-input produced-context]
                   (+ produced-input 10))))))
          rebuilt (eval (lowering/form definition))
          direct-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          generated-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          direct-reference
          (work/start direct-runtime definition 1 {:id "managed-bind-equivalence"})
          generated-reference
          (work/start generated-runtime rebuilt 1 {:id "managed-bind-equivalence"})
          direct-history (work/history direct-runtime direct-reference)
          generated-history (work/history generated-runtime generated-reference)
          direct-checkpoints (work/checkpoints direct-runtime direct-reference)
          generated-checkpoints (work/checkpoints generated-runtime generated-reference)]
      [(work/status direct-runtime direct-reference)
       (work/status generated-runtime generated-reference)
       (work/result direct-runtime direct-reference)
       (work/result generated-runtime generated-reference)
       (= direct-history generated-history)
       (= direct-checkpoints generated-checkpoints)
       (vec (map (fn [checkpoint]
                   (:checkpoint/node-path checkpoint))
                 generated-checkpoints))])
    (finally
      (lowering/reset-closures)))
  => [:completed :completed 12 12 true true
      [[:bind :source :source]
       [:bind :produced :produced]]])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve bind boundary failures"
  (lowering/reset-closures)
  (try
    (let [invalid
          (work/bind
           {:id :compiled-invalid-produced}
           (work/pure :source
             (fn [input context] input))
           (work/pure :continuation
             (fn [value context] {:not :work})))
          effectful
          (work/bind
           {:id :compiled-effectful-continuation}
           (work/pure :source
             (fn [input context] input))
           (work/step :continuation
             (fn [value context]
               (work/pure :produced
                 (fn [produced-input produced-context]
                   produced-input)))))
          rebuilt-invalid (eval (lowering/form invalid))
          rebuilt-effectful (eval (lowering/form effectful))
          error-code
          (fn [definition]
            (try
              (evaluator/run nil definition :input)
              :passed
              (catch Throwable error
                (:work/error (ex-data error)))))]
      [(error-code invalid)
       (error-code rebuilt-invalid)
       (error-code effectful)
       (error-code rebuilt-effectful)])
    (finally
      (lowering/reset-closures)))
  => [:work/bind-not-work
      :work/bind-not-work
      :work/bind-continuation-not-pure
      :work/bind-continuation-not-pure])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve managed bind replay"
  (lowering/reset-closures)
  (try
    (let [direct-source-count (atom 0)
          direct-first-count (atom 0)
          direct-second-count (atom 0)
          direct-definition
          (work/bind
           {:id :managed-bind-replay :version 1}
           (work/step :source
             (fn [input context]
               (swap! direct-source-count inc)
               (inc input)))
           (work/pure :continuation
             (fn [value context]
               (work/chain
                {:id :managed-produced}
                [(work/step :first
                   (fn [produced-input produced-context]
                     (swap! direct-first-count inc)
                     (+ produced-input 10)))
                 (work/step :second
                   (fn [produced-input produced-context]
                     (let [attempt (swap! direct-second-count inc)]
                       (if (= attempt 1)
                         (throw (ex-info "interrupt produced child" {}))
                         (+ produced-input 100)))))]))))
          generated-source-count (atom 0)
          generated-first-count (atom 0)
          generated-second-count (atom 0)
          generated-definition
          (work/bind
           {:id :managed-bind-replay :version 1}
           (work/step :source
             (fn [input context]
               (swap! generated-source-count inc)
               (inc input)))
           (work/pure :continuation
             (fn [value context]
               (work/chain
                {:id :managed-produced}
                [(work/step :first
                   (fn [produced-input produced-context]
                     (swap! generated-first-count inc)
                     (+ produced-input 10)))
                 (work/step :second
                   (fn [produced-input produced-context]
                     (let [attempt (swap! generated-second-count inc)]
                       (if (= attempt 1)
                         (throw (ex-info "interrupt produced child" {}))
                         (+ produced-input 100)))))]))))
          rebuilt (eval (lowering/form generated-definition))
          direct-backend (work/memory-backend)
          generated-backend (work/memory-backend)
          direct-before (work/durable-runtime {:backend direct-backend})
          generated-before (work/durable-runtime {:backend generated-backend})
          direct-reference
          (work/start direct-before direct-definition 1 {:id "managed-bind-replay"})
          generated-reference
          (work/start generated-before rebuilt 1 {:id "managed-bind-replay"})
          direct-status-before (work/status direct-before direct-reference)
          generated-status-before (work/status generated-before generated-reference)
          direct-after (work/durable-runtime {:backend direct-backend})
          generated-after (work/durable-runtime {:backend generated-backend})
          direct-registration (work/register direct-after direct-definition)
          generated-registration (work/register generated-after rebuilt)
          direct-resumed (work/resume direct-after direct-reference)
          generated-resumed (work/resume generated-after generated-reference)
          direct-history (work/history direct-after direct-resumed)
          generated-history (work/history generated-after generated-resumed)
          direct-checkpoints (work/checkpoints direct-after direct-resumed)
          generated-checkpoints (work/checkpoints generated-after generated-resumed)]
      [(work/status direct-after direct-resumed)
       (work/status generated-after generated-resumed)
       (work/result direct-after direct-resumed)
       (work/result generated-after generated-resumed)
       [(deref direct-source-count)
        (deref direct-first-count)
        (deref direct-second-count)]
       [(deref generated-source-count)
        (deref generated-first-count)
        (deref generated-second-count)]
       (= direct-history generated-history)
       (= direct-checkpoints generated-checkpoints)
       (count (filter (fn [event]
                        (= :work/step-replayed (:event event)))
                      generated-history))])
    (finally
      (lowering/reset-closures)))
  => [:completed :completed 112 112
      [1 1 2] [1 1 2] true true 2])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve managed checkpoints and events"
  (lowering/reset-closures)
  (try
    (let [definition
          (work/ensure
           {:id :managed-equivalence :version 1 :return :outcome}
           (work/step :body
             (fn [input context]
               (work/emit context :work/compile-body {:value input})
               (+ input 2)))
           (work/step :cleanup
             (fn [outcome context]
               {:body/status (:work/body-status outcome)
                :body/result (:work/body-result outcome)})))
          rebuilt (eval (lowering/form definition))
          direct-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          generated-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          direct-reference
          (work/start direct-runtime definition 3 {:id "managed-equivalence"})
          generated-reference
          (work/start generated-runtime rebuilt 3 {:id "managed-equivalence"})
          direct-history (work/history direct-runtime direct-reference)
          generated-history (work/history generated-runtime generated-reference)
          direct-checkpoints (work/checkpoints direct-runtime direct-reference)
          generated-checkpoints (work/checkpoints generated-runtime generated-reference)]
      [(work/status direct-runtime direct-reference)
       (work/status generated-runtime generated-reference)
       (= (work/result direct-runtime direct-reference)
          (work/result generated-runtime generated-reference))
       (= direct-history generated-history)
       (= direct-checkpoints generated-checkpoints)
       (count direct-checkpoints)])
    (finally
      (lowering/reset-closures)))
  => [:completed :completed true true true 2])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve managed failure and cleanup"
  (lowering/reset-closures)
  (try
    (let [definition
          (work/ensure
           {:id :managed-failure :version 1}
           (work/step :body
             (fn [input context]
               (throw (ex-info "body failed" {:input input}))))
           (work/step :cleanup
             (fn [outcome context]
               {:cleanup? true
                :body/status (:work/body-status outcome)})))
          rebuilt (eval (lowering/form definition))
          direct-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          generated-runtime
          (work/durable-runtime {:backend (work/memory-backend)})
          direct-reference
          (work/start direct-runtime definition :input {:id "managed-failure"})
          generated-reference
          (work/start generated-runtime rebuilt :input {:id "managed-failure"})
          direct-history (work/history direct-runtime direct-reference)
          generated-history (work/history generated-runtime generated-reference)
          direct-checkpoints (work/checkpoints direct-runtime direct-reference)
          generated-checkpoints (work/checkpoints generated-runtime generated-reference)]
      [(work/status direct-runtime direct-reference)
       (work/status generated-runtime generated-reference)
       (= (work/error direct-runtime direct-reference)
          (work/error generated-runtime generated-reference))
       (= direct-history generated-history)
       (= direct-checkpoints generated-checkpoints)
       (count (filter (fn [event]
                        (= :work/cleanup-completed (:event event)))
                      direct-history))])
    (finally
      (lowering/reset-closures)))
  => [:failed :failed true true true 1])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve Promise and retry behavior"
  (lowering/reset-closures)
  (try
    (let [direct-retries (atom 0)
          generated-retries (atom 0)
          direct-retry
          (work/step
           {:id :direct-retry :retry {:maximum 2}}
           (fn [input context]
             (if (= 1 (swap! direct-retries inc))
               (throw (ex-info "retry" {:work/error :temporary}))
               (+ input 1))))
          generated-retry
          (work/step
           {:id :generated-retry :retry {:maximum 2}}
           (fn [input context]
             (if (= 1 (swap! generated-retries inc))
               (throw (ex-info "retry" {:work/error :temporary}))
               (+ input 1))))
          promise-work
          (work/step
           :promise
           (fn [input context]
             (Promise/run (fn [] (+ input 1)))))
          rebuilt-retry (eval (lowering/form generated-retry))
          rebuilt-promise (eval (lowering/form promise-work))]
      [(evaluator/run direct-retry 8)
       (evaluator/run rebuilt-retry 8)
       (deref direct-retries)
       (deref generated-retries)
       (deref (evaluator/run promise-work 8))
       (deref (evaluator/run rebuilt-promise 8))])
    (finally
      (lowering/reset-closures)))
  => [9 9 2 2 9 9])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve bind depth validation"
  (lowering/reset-closures)
  (try
    (let [source-count (atom 0)
          definition
          (work/bind
           {:id :compiled-invalid-depth
            :maximum-depth 0}
           (work/pure :source
             (fn [input context]
               (swap! source-count inc)
               input))
           (work/pure :continuation
             (fn [value context]
               (work/pure :produced
                 (fn [produced-input produced-context]
                   produced-input)))))
          rebuilt (eval (lowering/form definition))
          error-code
          (fn [candidate]
            (try
              (evaluator/run nil candidate :input)
              :passed
              (catch Throwable error
                (:work/error (ex-data error)))))]
      [(error-code definition)
       (error-code rebuilt)
       (deref source-count)])
    (finally
      (lowering/reset-closures)))
  => [:work/bind-invalid-depth :work/bind-invalid-depth 0])

^{:refer work.compile.hara/form :added "0.1"}
(fact "generated ordinary forms preserve nested bind depth limits"
  (lowering/reset-closures)
  (try
    (let [inner
          (work/bind
           {:id :compiled-inner}
           (work/pure :inner-source
             (fn [input context] input))
           (work/pure :inner-continuation
             (fn [value context]
               (work/pure :inner-produced
                 (fn [produced-input produced-context]
                   produced-input)))))
          definition
          (work/bind
           {:id :compiled-outer
            :maximum-depth 1}
           (work/pure :outer-source
             (fn [input context] input))
           (work/pure :outer-continuation
             (fn [value context] inner)))
          rebuilt (eval (lowering/form definition))
          error-code
          (fn [candidate]
            (try
              (evaluator/run nil candidate :input)
              :passed
              (catch Throwable error
                (:work/error (ex-data error)))))]
      [(error-code definition)
       (error-code rebuilt)])
    (finally
      (lowering/reset-closures)))
  => [:work/bind-depth-exceeded :work/bind-depth-exceeded])

(pr-str (run '[work.compile.hara-test]))
