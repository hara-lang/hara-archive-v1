(ns work.base-test
  (:use code.test)
  (:require 
            [work.base :as work]
            [work.flow.task.command :as command]))

^{:refer work.base/suspend}
(fact "creates a serializable signal or timer await node"
  (let [signal (work/work-spec
                (work/suspend
                 {:id :signal-node}
                 {:wait/id "signal-1" :wait/kind :signal}))
        timer (work/work-spec
               (work/suspend
                {:id :timer-node}
                {:wait/id "timer-1"
                 :wait/kind :timer
                 :wait/deadline 1000}))
        invalid
        (try
          (work/suspend {:wait/id "missing-kind"})
          :not-rejected
          (catch error (:ex/code (ex-data error))))]
    [(:op signal)
     (:wait signal)
     (:op timer)
     (:wait timer)
     invalid]
    => [:await
        {:wait/id "signal-1" :wait/kind :signal}
        :await
        {:wait/id "timer-1"
         :wait/kind :timer
         :wait/deadline 1000}
        :hara/dependency]))

(defn event-count
  [events event]
  (reduce
   (fn [total record]
     (if (= event (:event record))
       (inc total)
       total))
   0
   events))

(def double-command
  (command/single
   {:id 'double-command :version 1}
   {:process (work/step :double-command/process
                        (fn [value context] (* 2 value)))}))

(def local-observer (work/recording-observer))
(def local-runtime
  (work/local-runtime {:observer local-observer}))

(def local-pipeline
  (work/chain
   {:id :local-pipeline}
   [(work/pure :increment
      (fn [value context] (inc value)))
    (work/step :double
      (fn [value context] (* 2 value)))
    (work/pure :shape
      (fn [value context]
        {:value value
         :path (:node/path context)}))]))

(def custom-runtime
  (work/with-handler
   (work/local-runtime)
   :echo
   (fn [execute runtime frame spec input]
     {:echo input
      :node (:id spec)})))

(def prepare-count (atom 0))
(def replay-count (atom 0))
(def finish-count (atom 0))
(def durable-observer (work/recording-observer))
(def durable-backend (work/memory-backend))
(def recovery-runtime-before
  (work/durable-runtime
   {:backend durable-backend
    :observer durable-observer
    :runtime-version 1
    :schema-version 1}))

(def recovery-work
  (work/chain
   {:id :recovery-work
    :version 1}
   [(work/step :prepare
      (fn [value context]
        (swap! prepare-count inc)
        (inc value)))
    (work/pure :replay-shape
      (fn [value context]
        (swap! replay-count inc)
        (* 2 value)))
    (work/step
      {:id :finish
       :retry {:maximum 1}}
      (fn [value context]
        (let [attempt (swap! finish-count inc)]
          (if (= attempt 1)
            (throw (ex-info "interrupted before checkpoint" {}))
            (+ value 3)))))]))

(def recovery-reference
  (work/start recovery-runtime-before
              recovery-work
              2
              {:id "recovery-1"}))

(def recovery-status-before
  (work/status recovery-runtime-before recovery-reference))

;; A replacement runtime can recover from the shared backend after the pinned
;; work definition is made available again.
(def recovery-runtime-after
  (work/durable-runtime
   {:backend durable-backend
    :observer durable-observer
    :runtime-version 1
    :schema-version 1}))

(def recovery-registration
  (work/register recovery-runtime-after recovery-work))

(def recovery-reference-after
  (work/resume recovery-runtime-after recovery-reference))

(def recovery-history
  (work/history recovery-runtime-after recovery-reference))

(def recovery-checkpoints
  (work/checkpoints recovery-runtime-after recovery-reference))

(def recovery-record
  (work/run-record recovery-runtime-after recovery-reference))

(def recovery-counts
  [(deref prepare-count) (deref replay-count) (deref finish-count)])

(def fork-reference
  (work/fork recovery-runtime-after
             recovery-reference
             :finish
             {:id "recovery-fork"}))

(def list-count (atom 0))
(def filter-count (atom 0))
(def manage-count (atom 0))
(def framework-count (atom 0))
(def summary-count (atom 0))
(def batch-runtime (work/durable-runtime))

(def maintenance-work
  (work/batch
   {:id :code-maintenance-v1
    :version 1}
   {:list
    (work/step :list-code-units
      (fn [project context]
        (swap! list-count inc)
        [{:item/id 'code.manage
          :item/value {:name 'code.manage}}
         {:item/id 'code.framework
          :item/value {:name 'code.framework}}]))

    :filter
    (work/pure :selected-code-unit?
      (fn [subject context]
        (swap! filter-count inc)
        true))

    :process
    (work/step
      {:id :inspect-code-unit
       :retry {:maximum 1}}
      (fn [subject context]
        (if (= 'code.manage (:name subject))
          (do
            (swap! manage-count inc)
            {:name (:name subject)
             :status :ok})
          (let [attempt (swap! framework-count inc)]
            (if (= attempt 1)
              (throw (ex-info "inspection worker interrupted" {}))
              {:name (:name subject)
               :status :ok})))))

    :summarise
    (work/pure :summarise-findings
      (fn [batch context]
        (swap! summary-count inc)
        {:processed (count (:results batch))
         :ids (vec (map (fn [item] (:item/id item))
                        (:results batch)))}))}))

(def batch-reference
  (work/start batch-runtime
              maintenance-work
              {:project "hara"}
              {:id "batch-1"}))

(def batch-status-before
  (work/status batch-runtime batch-reference))

(def batch-reference-after
  (work/resume batch-runtime batch-reference))

(def batch-result
  (work/result batch-runtime batch-reference))

(def batch-history
  (work/history batch-runtime batch-reference))

(def batch-checkpoints
  (work/checkpoints batch-runtime batch-reference))

(def same-batch-reference
  (work/start batch-runtime
              maintenance-work
              {:project "hara"}
              {:id "batch-1"}))

(def stop-process-count (atom 0))
(def stop-cancel-count (atom 0))
(def stop-runtime (work/durable-runtime))
(def stop-work
  (work/batch
   {:id :stop-aware-batch
    :version 1}
   {:list
    (work/step :stop-list
      (fn [input context]
        [{:item/id :a :item/value :a}
         {:item/id :b :item/value :b}
         {:item/id :c :item/value :c}]))

    :process
    (work/step :stop-process
      (fn [value context]
        (swap! stop-process-count inc)
        {:value value
         :status (if (= value :b) :failed :passed)}))

    :stop
    (work/pure :stop-after-failure
      (fn [batch context]
        (= :failed
           (get-in batch [:result :item/value :status]))))

    :cancel
    (work/step :cancel-unclaimed
      (fn [batch context]
        (swap! stop-cancel-count inc)
        {:value (get-in batch [:item :item/value])
         :status :cancelled}))

    :summarise
    (work/pure :stop-summary
      (fn [batch context]
        (work/manifest-values (:results batch))))}))
(def stop-reference
  (work/start stop-runtime stop-work nil {:id "stop-aware-1"}))
(def stop-result (work/result stop-runtime stop-reference))
(def same-stop-reference
  (work/start stop-runtime stop-work nil {:id "stop-aware-1"}))

(def invalid-runtime (work/durable-runtime))
(def invalid-work
  (work/batch
   {:id :invalid-batch}
   {:list
    (work/step :list
      (fn [input context] [1 2]))
    :process
    (work/step :process
      (fn [input context] input))}))

(def invalid-reference
  (work/start invalid-runtime
              invalid-work
              nil
              {:id "invalid-1"}))

(def results
  [(test-check
    "local work composes pure and checkpoint-capable leaves"
    [(work/run local-runtime local-pipeline 3)
     (event-count (work/observer-events local-observer)
                  :work/step-completed)]
    [{:value 8
      :path [:chain 2 :shape]}
     1])

   (test-check
    "node handlers extend runtimes without another protocol"
    (work/run custom-runtime
              (work/definition {:op :echo :id :custom})
              7)
    {:echo 7 :node :custom})

   (test-check
    "command templates compile to native work graphs"
    (let [spec (work/work-spec double-command)]
      [(get spec :op)
       (get spec :id)
       (get (work/work-spec (nth (:children spec) 2)) :op)
       (work/run (work/local-runtime) double-command 4)])
    [:chain 'double-command :step 8])

   (test-check
    "command batches forward runtime stop and cancel stages"
    (let [processed (atom 0)
          cancelled (atom 0)
          result
          (work/run
           (work/local-runtime)
           (command/batch
            {:id :command-stop-policy}
            {:list
             (work/pure
              :command-stop-list
              (fn [input context]
                [{:item/id :one :item/value 1}
                 {:item/id :two :item/value 2}
                 {:item/id :three :item/value 3}]))
             :process
             (work/step
              :command-stop-process
              (fn [value context]
                (swap! processed inc)
                value))
             :stop
             (work/pure
              :command-stop-check
              (fn [batch context]
                (= 2 (get-in batch [:result :item/value]))))
             :cancel
             (work/step
              :command-stop-cancel
              (fn [batch context]
                (swap! cancelled inc)
                (- 0 (get-in batch [:item :item/value]))))})
           nil)]
      [(work/manifest-values (:results result))
       [(deref processed) (deref cancelled)]])
    [[1 2 -3] [2 1]])

   (test-check
    "durable recovery replays checkpoints and reruns pure work"
    [recovery-status-before
     (work/status recovery-runtime-after recovery-reference-after)
     (work/result recovery-runtime-after recovery-reference-after)
     recovery-counts
     (count recovery-checkpoints)
     (event-count recovery-history :work/step-replayed)
     [(:run/work-root recovery-record)
      (:run/work-version recovery-record)
      (:run/runtime-version recovery-record)
      (:run/schema-version recovery-record)]]
    [:failed
     :completed
     9
     [1 2 2]
     2
     1
     [:recovery-work 1 1 1]])

   (test-check
    "fork copies checkpoints before the selected boundary"
    [(work/status recovery-runtime-after fork-reference)
     (work/result recovery-runtime-after fork-reference)
     [(deref prepare-count)
      (deref replay-count)
      (deref finish-count)]
     (event-count (work/history recovery-runtime-after fork-reference)
                  :work/step-replayed)]
    [:completed
     9
     [1 3 3]
     1])

   (test-check
    "batch recovery uses stable item identities"
    [batch-status-before
     (work/status batch-runtime batch-reference-after)
     (:summary batch-result)
     [(deref list-count)
      (deref filter-count)
      (deref manage-count)
      (deref framework-count)
      (deref summary-count)]
     (count batch-checkpoints)
     (event-count batch-history :work/step-replayed)]
    [:failed
     :completed
     {:processed 2
      :ids ['code.manage 'code.framework]}
     [1 4 1 2 1]
     3
     2])

   (test-check
    "batch stop policy cancels unclaimed items and replays their checkpoints"
    [(:summary stop-result)
     [(deref stop-process-count) (deref stop-cancel-count)]
     (= (:run/id (work/run-record stop-runtime stop-reference))
        (:run/id (work/run-record stop-runtime same-stop-reference)))]
    [[{:value :a :status :passed}
      {:value :b :status :failed}
      {:value :c :status :cancelled}]
     [2 1]
     true])

   (test-check
    "idempotent starts return the existing run"
    [(work/status batch-runtime same-batch-reference)
     [(deref list-count)
      (deref manage-count)
      (deref framework-count)]]
    [:completed [1 1 2]])

   (test-check "run identities reject incompatible input"
    (try (do (work/start batch-runtime
                maintenance-work
                {:project "other"}
                {:id "batch-1"}) false)
         (catch Throwable error true))
    true)

   (test-check
    "durable collection work rejects positional item identity"
    [(work/status invalid-runtime invalid-reference)
     (count (work/checkpoints invalid-runtime invalid-reference))]
    [:failed 1])

   (test-check
    "work values use the native IWork protocol"
    (not (nil? IWork))
    true)])

results
