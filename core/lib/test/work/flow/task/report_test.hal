(ns work.flow.task.report-test
  (:require [work.flow.task.report :as report]
            [std.lib.format.common :as common]
            [std.lib.format.table :as table]
            [std.lib.format.report :as format-report]
            [std.lib.format.terminal :as terminal]
            [std.lib.format :as format]))

(def item-a
  {:item/id :alpha
   :item/index 0
   :item/total 2
   :item/index-width 4
   :item/id-width 8
   :item/result-width 60
   :item/time-width 10
   :status :return
   :item/display "changed"
   :elapsed 3})

(def item-b
  {:item/id :beta
   :item/index 1
   :item/total 2
   :item/index-width 4
   :item/id-width 8
   :item/result-width 60
   :item/time-width 10
   :status :warn
   :data "review"
   :elapsed 4})

(def columns
  [{:key :path :label "PATH" :width 8}
   {:key :functions :label "FUN" :width 3 :align :right}
   {:key :inserts :label "INS" :width 3 :align :right}])

(def rows
  [{:path "a.clj" :functions 2 :inserts 3 :status :return}
   {:path "b.clj" :functions 1 :inserts 0 :status :return}])

(def summary
  {:items 2
   :results 2
   :warnings 1
   :errors 0
   :cumulative 7
   :elapsed 8})

(def document
  (report/complete
   (report/add-section
    (report/add-section
     (report/add-section
      (report/add-section
       (report/document
        :example/transform
        {:title "TRANSFORM CODE"
         :status :warning
         :annotations ["Done"]
         :profile
         {:sections [:items :warnings :results :summary]}})
       (report/section
        :items
        :progress
        [item-a item-b]
        {:section/title "ITEMS"}))
      (report/section
       :warnings
       :diagnostics
       [item-b]
       {:section/title "WARNINGS"}))
     (report/section
      :results
      :table
      rows
      {:section/title "RESULTS"
       :section/columns columns}))
    (report/section
     :summary
     :summary
     [summary]
     {:section/title "SUMMARY"
      :section/fields
      [:items :results :warnings :errors :cumulative :elapsed]}))
   :warning))

(def expected
  (str/join
   "\n"
   ["TRANSFORM CODE"
    ""
    "ITEMS"
    (str " 1/2  :alpha    ok  changed"
         (str/repeat " " 51)
         "3ms"
         (str/repeat " " 7))
    (str " 2/2  :beta     warn  review"
         (str/repeat " " 50)
         "4ms"
         (str/repeat " " 7))
    ""
    "WARNINGS"
    ":beta  warn  review"
    ""
    "RESULTS"
    "PATH      FUN  INS"
    "--------  ---  ---"
    "a.clj       2    3"
    "b.clj       1    0"
    ""
    "SUMMARY"
    "Items: 2"
    "Results: 2"
    "Warnings: 1"
    "Errors: 0"
    "Cumulative: 7ms"
    "Elapsed: 8ms"
    ""
    "Done"]))

(def events
  [{:event :task/run-started
    :report/title "TRANSFORM CODE"
    :report/profile (:report/profile document)}
   {:event :task/item-completed :record item-a}
   {:event :task/item-completed :record item-b}
   {:event :task/run-completed :report document}])

(def live-output (atom []))
(def live-observer
  (report/observer
   {:ansi false
    :emit
    (fn [text]
      (swap! live-output conj text))}))

(def _live-events
  (reduce
   (fn [count event]
     ((:function live-observer) event)
     (inc count))
   0
   events))

(def replay-output (atom []))
(def replay-count
  (report/replay
   events
   {:ansi false
    :emit
    (fn [text]
      (swap! replay-output conj text))}))

(def ansi-title
  (first
   (terminal/render-lines
    (format-report/report-lines document)
    {:ansi true})))

(def emitted-output (atom []))
(def emitted-count
  (terminal/emit-lines
   [(common/line "first" :success)
    (common/line "second" :warning)]
   {:emit
    (fn [text]
      (swap! emitted-output conj text))}))

(def table-output
  (vec
   (map
    (fn [entry]
      (:line/text entry))
    (table/table-lines
     (report/section
      :results
      :table
      rows
      {:section/columns columns})))))

(def results
  [(test-check
    "common padding and truncation are Unicode aware"
    [(common/truncate "λambda" 4)
     (common/truncate "abcdef" 3)
     (common/pad "λ" 3 :right)
     (common/pad "x" 4 :center)]
    ["λ..." "abc" "  λ" " x  "])

   (test-check
    "table formatting normalises columns, calculates widths, and aligns cells"
    table-output
    ["PATH      FUN  INS"
     "--------  ---  ---"
     "a.clj       2    3"
     "b.clj       1    0"])

   (test-check
    "report formatting preserves complete plain report output"
    [(format-report/report document)
     (format/report document)]
    [expected expected])

   (test-check
    "report section filters and empty-section policy remain portable"
    [(format-report/report
      document
      {:include-sections [:summary]
       :include-title false
       :include-annotations false})
     (format-report/report
      (report/add-section
       (report/document
        :empty/report
        {:title "EMPTY"
         :profile {:sections [:errors]}})
       (report/section :errors :diagnostics [])))
     (format-report/report
      (report/add-section
       (report/document
        :empty/report
        {:title "EMPTY"
         :profile {:sections [:errors]}})
       (report/section :errors :diagnostics []))
      {:include-empty true})]
    [(str/join
      "\n"
      ["SUMMARY"
       "Items: 2"
       "Results: 2"
       "Warnings: 1"
       "Errors: 0"
       "Cumulative: 7ms"
       "Elapsed: 8ms"])
     "EMPTY"
     "EMPTY\n\nerrors"])

   (test-check
    "terminal rendering is plain by default and ANSI is opt-in"
    [(terminal/render
      [(common/line "ok" :success)])
     (str/starts-with? ansi-title "\u001b[1;36m")
     (str/ends-with? ansi-title "\u001b[0m")
     (format/report document {:ansi false})]
    ["ok" true true expected])

   (test-check
    "terminal emission returns counts and uses an injected sink"
    [emitted-count
     (deref emitted-output)]
    [2 ["first" "second"]])

   (test-check
    "work event rendering preserves exact completed-report output"
    (report/render-events events)
    expected)

   (test-check
    "live observers and stored-history replay share one event projection"
    [(str/join "\n" (deref live-output))
     (str/join "\n" (deref replay-output))
     replay-count
     (count (deref live-output))]
    [expected expected
     (count (deref replay-output))
     (count (deref replay-output))])

   (test-check
    "facade exposes only the curated layered entry points"
    [(fn? format/line)
     (fn? format/value-text)
     (fn? format/truncate)
     (fn? format/pad)
     (fn? format/table-lines)
     (fn? format/report-lines)
     (fn? format/report)
     (fn? format/render-lines)
     (fn? format/render)
     (fn? format/emit-lines)
     (nil? (resolve 'std.format/report))
     (nil? (resolve 'work.flow.task.report/terminal-observer))]
    [true true true true true true true true true true true true])])

results
