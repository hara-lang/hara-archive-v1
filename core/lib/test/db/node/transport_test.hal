(ns db.node.transport-test
  (:use code.test)
  (:require [db.node.client-base :as client]
            [db.node.runtime :as runtime]
            [db.node.transport :as transport]
            [db.protocol :as db-protocol]
            [std.foundation.promise :as promise]
            [std.substrate :as substrate]))

(defstruct MessageConnection
  [id closed])

(extend-type MessageConnection db-protocol/IDatabase
  (db-engine [connection]
    :message-sql)
  (db-provider [connection]
    :message)
  (db-info [connection]
    {:id (:id connection)
     :engine :message-sql
     :provider :message})
  (db-exec [connection sql parameters]
    (promise/from {:affected 1
                   :sql sql
                   :parameters parameters}))
  (db-query [connection sql parameters]
    (promise/from {:columns ["value"]
                   :rows [[(first parameters)]]
                   :affected 0}))
  (db-close [connection]
    (reset! (:closed connection) true)
    (promise/from true)))

(defn message-driver
  []
  {:id :message
   :engine :message-sql
   :open (fn [options]
           (promise/from
            (db.node.transport-test/MessageConnection
             (get options :id "message-1")
             (atom false))))})

(defn endpoint-pair
  []
  (let [left-listener (atom nil)
        right-listener (atom nil)
        left-closed (atom false)
        right-closed (atom false)]
    [{:send (fn [message]
              (let [listener @right-listener]
                (when listener (listener message))))
      :listen (fn [listener]
                (reset! left-listener listener))
      :close (fn [] (reset! left-closed true))
      :closed left-closed}
     {:send (fn [message]
              (let [listener @left-listener]
                (when listener (listener message))))
      :listen (fn [listener]
                (reset! right-listener listener))
      :close (fn [] (reset! right-closed true))
      :closed right-closed}]))

(def results
  [(fact "portable nested values round-trip through tagged wire data"
     (let [value {:kind :db/runtime
                  :symbol 'db/value
                  :flags #{:read :write}
                  [:composite 1] {:nested :ok}
                  :rows [[1 "wombat"]]}]
       (transport/wire->value (transport/value->wire value)))
     => {:kind :db/runtime
         :symbol 'db/value
         :flags #{:read :write}
         [:composite 1] {:nested :ok}
         :rows [[1 "wombat"]]})

   (fact "thrown values become clone-safe structured errors"
     (let [encoded (transport/error->wire
                    (ex-info "database failed" {:tag :db/failure}))]
       [(get encoded "$hara")
        (get encoded "message")])
     => ["error" "database failed"])

   (fact "canonical map frames round-trip through the message representation"
     (let [frame (substrate/node-frame :request
                                       "req-1"
                                       "main"
                                       {:trace :trace/one}
                                       "@xt.db/query"
                                       ["db/primary" "select 1" [{:mode :fast}]]
                                       nil nil nil nil nil nil)
           decoded (transport/wire->frame (transport/frame->wire frame))]
       [(map? decoded)
        (substrate/frame-id decoded)
        (substrate/frame-kind decoded)
        (substrate/frame-space decoded)
        (substrate/frame-meta decoded)
        (get decoded "action")
        (get decoded "args")])
     => [true
         "req-1"
         "request"
         "main"
         {:trace :trace/one}
         "@xt.db/query"
         ["db/primary" "select 1" [{:mode :fast}]]])

   (fact "ready messages are separated from substrate frames"
     [(transport/ready-message?
       {"signal" "ready"
        "transport" "transport"
        "worker" "worker"})
      (transport/ready-message? {"kind" "response"})]
     => [true false])

   (fact "node worker adapters initialize and query across paired endpoints"
     (let [endpoints (endpoint-pair)
           client-endpoint (first endpoints)
           server-endpoint (second endpoints)
           client-node (substrate/node-create "message-client")
           server-node (substrate/node-create "message-server")
           client-adapter (transport/nodeworker-adapter client-endpoint)
           server-adapter (transport/nodeworker-adapter server-endpoint)
           config {:primary {:type :message
                             :options {:id "runtime-message"}}}
           connected-promise (runtime/nodeworker-connect
                              client-node config {} {} client-adapter {})
           booted (IDerefTimeout/deref-timeout
                   (runtime/nodeworker-init-kernel
                    server-node
                    server-adapter
                    {:drivers {:message (message-driver)}})
                   2000 :timeout)
           connected (IDerefTimeout/deref-timeout connected-promise 2000 :timeout)
           output (IDerefTimeout/deref-timeout
                   (client/query client-node
                                 "db/primary"
                                 "select value"
                                 [42]
                                 {})
                   2000 :timeout)]
       [(instance? substrate/SubstrateNode client-node)
        (instance? substrate/SubstrateNode server-node)
        (get booted :transport-attached)
        (get connected :transport-attached)
        (get (get connected :init) :status)
        (get output :rows)])
     => [true true true true :setup [[42]]])])

(pr-str (run '[db.node.transport-test]))
