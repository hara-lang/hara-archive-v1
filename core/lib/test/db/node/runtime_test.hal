(ns db.node.runtime-test
  (:use code.test)
  (:require [db.node.client-base :as client]
            [db.node.connection :as remote]
            [db.node.kernel-base :as kernel]
            [db.node.runtime :as runtime]
            [db.protocol :as db-protocol]
            [std.foundation.promise :as promise]
            [std.substrate :as substrate]))

(defstruct MockConnection
  [id state])

(extend-type MockConnection db-protocol/IDatabase
  (db-engine [connection]
    :mock-sql)
  (db-provider [connection]
    :mock)
  (db-info [connection]
    {:id (:id connection)
     :engine :mock-sql
     :provider :mock})
  (db-exec [connection sql parameters]
    (swap! (:state connection)
           (fn [state]
             (assoc state :last-exec {:sql sql :parameters parameters})))
    (promise/from {:affected 1 :sql sql :parameters parameters}))
  (db-query [connection sql parameters]
    (swap! (:state connection)
           (fn [state]
             (assoc state :last-query {:sql sql :parameters parameters})))
    (promise/from {:columns ["id" "name"]
                   :rows [[1 "wombat"]]
                   :affected 0}))
  (db-close [connection]
    (reset! (:state connection) {:closed true})
    (promise/from true)))

(defn mock-driver
  []
  {:id :mock
   :engine :mock-sql
   :open (fn [options]
           (promise/from
            (db.node.runtime-test/MockConnection
             (get options :id "mock-1")
             (atom {:opened true :options options}))))})

(defn failing-open
  [options]
  (promise/new
   (fn [resolve reject]
     (reject (ex-info "driver failed" {:options options})))))

(defn failing-driver
  []
  {:id :failing
   :engine :failing-sql
   :open failing-open})

(def config
  {:primary {:type :mock
             :options {:id "primary-1"}}
   :caching {:type :mock
             :options {:id "cache-1"}}})

(def results
  [(fact "database runtimes use canonical substrate nodes and map frames"
     (let [node (substrate/node-create "canonical")
           frame (substrate/request-frame nil "@probe" [1] {})]
       [(instance? substrate/SubstrateNode node)
        (substrate/node? node)
        (map? frame)
        (substrate/frame-kind frame)
        (get frame "action")])
     => [true true true "request" "@probe"])

   (fact "kernel config assigns stable service IDs"
     (kernel/kernel-create-config
      {"primary" {"type" "mock"}
       "caching" {"type" "mock"}})
     => {:common {:id "db/common"}
         :primary {:type "mock" :id "db/primary"}
         :caching {:type "mock" :id "db/caching"}})

   (fact "server initialization installs database handlers"
     (let [node (substrate/node-create "server")]
       (runtime/init-server node)
       (substrate/list-handlers node))
     => (contains ["@xt.db/kernel-init"
                   "@xt.db/kernel-setup"
                   "@xt.db/kernel-teardown"
                   "@xt.db/service-info"
                   "@xt.db/exec"
                   "@xt.db/query"]))

   (fact "drivers can be registered and enumerated without loading providers"
     (let [node (substrate/node-create "drivers")]
       (kernel/register-driver node :mock (mock-driver))
       [(kernel/list-drivers node)
        (get (kernel/get-driver node "mock") :engine)])
     => [[:mock] :mock-sql])

   (fact "local runtime initializes primary and caching services through proxies"
     (let [server (substrate/node-create "server")
           client-node (substrate/node-create "client")]
       (kernel/register-driver server :mock (mock-driver))
       (let [connected (deref (runtime/local-connect client-node server config {} {}))]
         [(get connected :transport-attached)
          (get (get connected :init) :status)
          (get (deref (client/service-info client-node "db/primary" {})) :provider)
          (get (deref (client/service-info client-node "db/caching" {})) :provider)]))
     => [true :setup :mock :mock])

   (fact "exec and query cross the linked runtime transport"
     (let [server (substrate/node-create "server-exec")
           client-node (substrate/node-create "client-exec")]
       (kernel/register-driver server :mock (mock-driver))
       (deref (runtime/local-connect client-node server config {} {}))
       [(deref (client/exec client-node
                            "db/primary"
                            "insert into items values (?)"
                            ["wombat"]
                            {}))
        (deref (client/query client-node
                             "db/primary"
                             "select id, name from items"
                             []
                             {}))])
     => [{:affected 1
          :sql "insert into items values (?)"
          :parameters ["wombat"]}
         {:columns ["id" "name"]
          :rows [[1 "wombat"]]
          :affected 0}])

   (fact "runtime services can be used as ordinary IDatabase connections"
     (let [server (substrate/node-create "server-connection")
           client-node (substrate/node-create "client-connection")]
       (kernel/register-driver server :mock (mock-driver))
       (let [connected (deref (runtime/local-connect client-node server config {} {}))
             connection (deref (runtime/open-service (get connected :runtime)
                                                     "db/primary"))
             output (deref (db-protocol/db-query
                            connection
                            "select id, name from items"
                            []))]
         [(db-protocol/db-engine connection)
          (db-protocol/db-provider connection)
          (get (db-protocol/db-info connection) :remote)
          (get output :rows)
          (deref (db-protocol/db-close connection))
          (remote/closed? connection)]))
     => [:mock-sql :mock true [[1 "wombat"]] true true])

   (fact "closed runtime connection handles reject further operations"
     (let [server (substrate/node-create "server-closed-handle")
           client-node (substrate/node-create "client-closed-handle")]
       (kernel/register-driver server :mock (mock-driver))
       (deref (runtime/local-connect client-node server config {} {}))
       (let [connection (deref (remote/open client-node "db/primary"))]
         (deref (db-protocol/db-close connection))
         (db-protocol/db-query connection "select 1" [])))
     => (throws))

   (fact "reinitialization reports no change and preserves services"
     (let [server (substrate/node-create "server-repeat")
           client-node (substrate/node-create "client-repeat")]
       (kernel/register-driver server :mock (mock-driver))
       (deref (runtime/local-connect client-node server config {} {}))
       (get (deref (client/kernel-init client-node config {} {} {})) :status))
     => :no-change)

   (fact "failed multi-service setup rolls back opened services"
     (let [server (substrate/node-create "server-failed")
           failed-config {:primary {:type :mock}
                          :caching {:type :failing}}]
       (kernel/register-driver server :mock (mock-driver))
       (kernel/register-driver server :failing (failing-driver))
       (let [status (deref
                     (promise/catch
                      (kernel/kernel-setup-main server failed-config {} {})
                      (fn [error] :failed)))]
         [status
          (substrate/get-service server "db/common")
          (substrate/get-service server "db/primary")
          (substrate/get-service server "db/caching")]))
     => [:failed nil nil nil])

   (fact "failed local initialization detaches the linked transport"
     (let [server (substrate/node-create "server-init-failed")
           client-node (substrate/node-create "client-init-failed")
           failed-config {:primary {:type :failing}}]
       (kernel/register-driver server :failing (failing-driver))
       (let [status (deref
                     (promise/catch
                      (runtime/local-connect client-node server failed-config {} {})
                      (fn [error] :failed)))]
         [status
          (substrate/transport-get client-node runtime/DEFAULT-TRANSPORT)
          (substrate/transport-get server runtime/DEFAULT-TRANSPORT)]))
     => [:failed nil nil])

   (fact "teardown closes services and removes the runtime transport"
     (let [server (substrate/node-create "server-close")
           client-node (substrate/node-create "client-close")]
       (kernel/register-driver server :mock (mock-driver))
       (let [connected (deref (runtime/local-connect client-node server config {} {}))
             runtime-value (get connected :runtime)]
         (deref (runtime/close-runtime runtime-value config))
         [(substrate/get-service server "db/primary")
          (substrate/get-service server "db/caching")
          (substrate/transport-get client-node runtime/DEFAULT-TRANSPORT)]))
     => [nil nil nil])

   (fact "worker adapter entry points share the same initialization contract"
     (let [server (substrate/node-create "worker-server")
           client-node (substrate/node-create "worker-client")]
       (runtime/init-server server)
       (kernel/register-driver server :mock (mock-driver))
       (let [adapter {:connect (fn [current transport-id]
                                 (runtime/connect-nodes current server transport-id))}
             connected (deref (runtime/nodeworker-connect
                               client-node config {} {} adapter {}))]
         [(:kind (get connected :runtime))
          (get connected :transport-attached)
          (get (get connected :init) :status)]))
     => [:node-worker true :setup])])

(pr-str (run '[db.node.runtime-test]))
