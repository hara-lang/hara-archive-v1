(ns db.node.proxy-util-test
  (:use code.test)
  (:require [db.node.proxy-util :as proxy-util]
            [std.substrate :as substrate]))

(fact "database proxy options keep snake_case at the transport boundary"
  (let [node (substrate/node-create "proxy-options")]
    [(proxy-util/get-transport-id node {:transport-id "peer-kebab"})
     (proxy-util/get-transport-id node {:transport_id "legacy-keyword"})
     (proxy-util/get-transport-id node {"transport_id" "legacy-wire"})
     (get (proxy-util/request-options node {:timeout-ms 25}) :timeout-ms)
     (get (proxy-util/request-options node {:timeout_ms 25}) :timeout-ms)])
  => ["peer-kebab" nil nil 25 nil])

(pr-str (run '[db.node.proxy-util-test]))
