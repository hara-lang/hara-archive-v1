(ns tmp.zip-probe-test
  (:require [std.foundation :as h] [std.foundation :as walk]
            [tmp.zip-probe])
  (:use code.test)
  (:config {:override [get find prewalk postwalk]}))

(declare display-zipper)

(def ^:dynamic *handler* nil)

(defonce +types+ (atom {}))

(def +nil-handler+
  {:at-left-most        nil
   :at-outside-most     nil
   :at-inside-most-left nil
   :at-inside-most      nil
   :at-right-most       nil})

(defstruct Zipper
  [context prefix display parent left right depth changed? tag position])

(defn is
  "checks zip given a predicate"
  {:added "3.0"}
  ([zip pred] (is zip pred :right))
  ([zip pred step] (let [elem (first (std.foundation/get zip step))]
                     (try (or (= elem pred)
                            (if (and (fn? pred) (not (coll? pred))) (pred elem))
                            (zero? (compare elem pred)))
                       (catch Throwable t false)))))

(defn get
  "gets the value of the zipper"
  {:added "3.0"}
  ([zip] (get zip identity :right))
  ([zip arg] (if (or (= arg :left) (= arg :right))
               (get zip identity arg)
               (get zip arg :right)))
  ([zip func step] (let [elem (first (std.foundation/get zip step))] (func elem))))

(defn is-empty-container?
  "check if current container is empty"
  {:added "3.0"}
  ([zip]
   (is-empty-container? zip :right))
  ([{:keys [context] :as zip} step]
   (is zip (-> context :is-empty-container?) step)))

(defn at-left-most?
  "check if at left-most point of a container"
  {:added "3.0"}
  [zip]
  (empty? (:left zip)))

(defn at-inside-most?
  "check if at inside-most point of a container"
  {:added "3.0"}
  [zip]
  (or (empty? (:right zip)) (not (is-container? zip :right))))

(defn is-container?
  "checks if node on either side is a container"
  {:added "3.0"}
  [zip side]
  (= side :right))

(defonce +base+
  {:at-left-most? at-left-most?
   :at-inside-most? at-inside-most?})

(defonce +base2+
  {:at-left-most? at-left-most?
   :at-inside-most? at-inside-most?})

(Runtime/eval
 '(defonce +base3+
    {:at-left-most? at-left-most?
     :at-inside-most? at-inside-most?}))
