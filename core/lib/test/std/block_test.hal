(ns std.block-test
  (:require [std.block :as block]
            [std.block.check :as check]
            [std.block.grid :as grid]
            [std.block.protocol :as protocol]
            [std.block.reader :as reader]))

(def results
  [(test-check "parse preserves source and value"
               (let [parsed (block/parse-string "[1 2 3]")
                     first-block (block/parse-first "[1 2 3]")]
                 [(block/string parsed)
                  (block/value parsed)
                  (block/type first-block)
                  (block/tag first-block)
                  (vec (map block/value
                            (filter block/code?
                                    (block/children first-block))))])
               ["[1 2 3]" [1 2 3] :container :vector [1 2 3]])
   (test-check "portable blocks satisfy the consolidated IBlock protocol"
               (let [value (block/block {:answer 42})]
                 [(satisfies? protocol/IBlock value)
                  (protocol/block-type value)
                  (protocol/block-tag value)
                  (protocol/block-value value)])
               [true :container :map {:answer 42}])
   (test-check "constructs portable whitespace blocks"
               (let [spaces (block/spaces 3)
                     newline (block/newline)]
                 [(apply str (map block/string spaces))
                  (block/space? (first spaces))
                  (block/string newline)
                  (block/linebreak? newline)
                  (block/verify newline)])
               ["   " true "\n" true true])
   (test-check "parser preserves nested whitespace, comments, and delimiters"
               (let [parsed (block/parse-string
                             "(alpha  ; note\n [1 {:k \"v\"}])")
                     form (block/parse-first
                           "(alpha  ; note\n [1 {:k \"v\"}])")]
                 [(block/string parsed)
                  (block/string form)
                  (vec (map block/tag (block/children form)))
                  (block/height form)])
               ["(alpha  ; note\n [1 {:k \"v\"}])"
                "(alpha  ; note\n [1 {:k \"v\"}])"
                [:symbol :linespace :linespace :comment :linebreak :linespace :vector]
                1])
   (test-check "container values apply hash-uneval modifiers"
               (let [form (block/parse-first "[1 #_2 3]")]
                 [(block/value form)
                  (block/child-values form)
                  (block/string form)])
               [[1 3] [1 3] "[1 #_2 3]"])
   (test-check "reader conditionals and cursor dispatch preserve structure"
               (let [selected (block/parse-first "#?(:clj alpha :cljs beta)")
                     spliced (block/parse-first "#?@(:clj [alpha])")
                     cursor (block/parse-first "#|")]
                 [(block/string selected)
                  (block/value selected)
                  (block/string spliced)
                  (block/value spliced)
                  (block/tag cursor)
                  (block/string cursor)])
               ["#?(:clj alpha :cljs beta)"
                '(? {:clj alpha :cljs beta})
                "#?@(:clj [alpha])"
                '(?-splicing {:clj [alpha]})
                :hash-cursor
                "|"])
   (test-check "symbol suffix syntax remains part of its token"
               (let [gensym (block/parse-first "x#")
                     xtalk (block/parse-first "x:arr-push")]
                 [(block/string gensym)
                  (block/value gensym)
                  (block/string xtalk)
                  (block/value xtalk)])
               ["x#" 'x# "x:arr-push" 'x:arr-push])
   (test-check "portable check and reader APIs retain source position"
               (let [input (reader/create "ab\ncd")
                     first-two (reader/read-times input reader/read-char 2)
                     newline (reader/read-char input)]
                 [first-two
                  (check/linebreak? newline)
                  (reader/reader-position input)
                  (reader/read-to-boundary input)])
               [[\a \b] true [2 1] "cd"])
   (test-check "layout and line metrics retain the archived public surface"
               (let [laid-out (block/layout '(if ready [1 2] [3 4]))
                     wrapped (block/layout '(if ready [1 2] [3 4])
                                           {:width 10})
                     multiline (block/parse-root "alpha\nlonger")]
                 [(block/string laid-out)
                  (block/string wrapped)
                  (block/max-width multiline)
                  (block/line-width multiline)
                  (block/string (block/empty))])
               ["(if ready [1 2] [3 4])"
                "(if ready\n  [1 2]\n  [3 4])"
                6 6 "()"])
   (test-check "grid applies portable indentation rules"
               (let [form (block/parse-first "(if\nready\ndone)")
                     formatted (grid/grid form 0
                                          {:rules {'if {:indent 1}}})]
                 [(block/string form)
                  (block/string formatted)])
               ["(if\nready\ndone)"
                "(if\n  ready\n  done)"])
   (test-check "recovering parser preserves ranges and malformed source"
               (let [source "(def x 1)\n)\n[:ok"
                     result (block/parse-source source {:file "demo.hal"})
                     root (:block result)
                     forms (filter block/code? (block/children root))
                     first-form (first forms)
                     errors (filter block/error? (block/children root))]
                 [(block/string root)
                  (select-keys (:props first-form)
                               [:file :start-offset :end-offset
                                :row :col :end-row :end-col])
                  (count errors)
                  (vec (map :type (:diagnostics result)))])
               ["(def x 1)\n)\n[:ok"
                {:file "demo.hal" :start-offset 0 :end-offset 9
                 :row 1 :col 1 :end-row 1 :end-col 10}
                2
                [:tool.lint/reader-error :tool.lint/reader-error]])
   (test-check "root facade exports portable healing"
               (block/heal "(+ 1 2")
               "(+ 1 2)")
   (test-check "root block namespace publishes facade role"
               (get (Runtime/namespace 'std.block) :namespace/role)
               :facade)
   (test-check "parser indexes CRLF source positions in one pass"
               (let [source "a\r\n[b\nc]"
                     parsed (block/parse-root source)
                     vector-block
                     (first
                      (filter
                       (fn [child]
                         (= :vector (block/tag child)))
                       (block/children parsed)))]
                 (select-keys
                  (:props vector-block)
                  [:start-offset :end-offset
                   :row :col :end-row :end-col]))
               {:start-offset 3 :end-offset 8
                :row 2 :col 1 :end-row 3 :end-col 3})])

results
