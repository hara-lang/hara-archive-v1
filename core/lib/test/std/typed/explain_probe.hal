(ns std.typed.explain-probe
  (:require [std.typed.catalog :as catalog]
            [std.typed.explain :as explain]
            [std.typed.registry :as registry]))

(def nodes
  (registry/local
   'demo
   {'Node '[:map [:value :int] [:next [:maybe Node]]]}))

(def recursive-catalog
  (catalog/catalog
   [{:schema/id :probe/node
     :schema/form
     '[:map
       [:value :int]
       [:next [:maybe (var Node)]]]}]))

(def recursive-coordinate
  (catalog/coordinate recursive-catalog :probe/node))

(let [union (explain/explain [:or :int :str] :wrong)
      recursive (explain/explain 'Node
                                 {:value 1
                                  :next {:value "two" :next nil}}
                                 nodes)
      result (explain/check :int 42)
      components
      (catalog/dependency-components
       recursive-catalog
       [recursive-coordinate])
      component (first components)
      checks
      [(nil? (explain/explain :int 42))
       (keyword? (:failure/code (first (:failures union))))
       (= 2 (count (:failure/children (first (:failures union)))))
       (every? explain/failure?
               (:failure/children (first (:failures union))))
       (vector? (:failure/path (first (:failures recursive))))
       (Result/success? result)
       (= true (Result/data result))
       (= [recursive-coordinate] (:component/members component))
       (= true (:component/recursive? component))
       (= [] (:component/dependencies component))
       (= [recursive-coordinate]
          (catalog/dependency-order
           recursive-catalog
           [recursive-coordinate]))]]
  (if (every? true? checks)
    (pr-str checks)
    (throw
     (ex :state
         {:checks checks
          :components components}
         :ex/message "std.typed Truffle probe failed"))))
