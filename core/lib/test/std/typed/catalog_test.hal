(ns std.typed.catalog-test
  (:use code.test)
  (:require [std.typed.catalog :as catalog]
            [std.typed.registry :as registry]))

(def +entries+
  [{:schema/id :model/id
    :schema/version 1
    :schema/form :int
    :source/file "model_v1.hal"}
   {:schema/id :model/profile
    :schema/version 1
    :schema/form
    '[:map
      {:title "Profile documentation"}
      [:id (var Id)]]}
   {:schema/id :model/profile
    :schema/version 2
    :schema/form
    '[:map
      {:title "Profile documentation v2"}
      [:id (var Id)]
      [:nickname {:optional true :description "Display name"} :str]]}
   {:schema/id :model/account
    :schema/version 1
    :schema/form
    '[:map
      [:profile (var Profile)]]}])

(def +catalog+ (catalog/catalog +entries+))
(def +id-coordinate+ (catalog/coordinate +catalog+ :model/id 1))
(def +profile-v1-coordinate+ (catalog/coordinate +catalog+ :model/profile 1))
(def +profile-v2-coordinate+ (catalog/coordinate +catalog+ :model/profile 2))
(def +account-coordinate+ (catalog/coordinate +catalog+ :model/account 1))

^{:refer std.typed.catalog/catalog
  :id 'stable-schema-identity}
(fact "catalog entries have canonical ids, versions, and reproducible hashes"
  (let [profile-v1 (catalog/lookup +catalog+ :model/profile 1)
        profile-latest (catalog/lookup +catalog+ 'model/profile)
        reordered
        (catalog/catalog
         [{:schema/form
           '[:map
             {:owner :docs :title "Ignored documentation"}
             [:id (var Id)]]
           :schema/version 1
           :schema/id :model/profile}
          {:schema/form :int
           :schema/id :model/id
           :schema/version 1}])
        semantic-change
        (catalog/catalog
         [{:schema/id :model/id :schema/version 1 :schema/form :int}
          {:schema/id :model/profile
           :schema/version 1
           :schema/form
           '[:map [:id (var Id)] [:name :str]]}])]
    [(:schema/id profile-v1)
     (:schema/version profile-v1)
     (str/starts-with? (:schema/hash profile-v1) "sha256:")
     (count (:schema/hash profile-v1))
     (:schema/version profile-latest)
     (= (:schema/hash profile-v1)
        (:schema/hash (catalog/lookup reordered :model/profile 1)))
     (not= (:schema/hash profile-v1)
           (:schema/hash (catalog/lookup semantic-change :model/profile 1)))])
  => [:model/profile 1 true 71 2 true true])

^{:refer std.typed.catalog/catalog
  :id 'map-entry-order-does-not-change-hash}
(fact "canonical map hashing ignores map insertion order"
  (let [left
        (catalog/catalog
         [{:schema/id :fixture/value
           :schema/version 1
           :schema/form
           '[:map {:optional true :description "x"}
             [:id :int]]}])
        right
        (catalog/catalog
         [{:schema/id :fixture/value
           :schema/version 1
           :schema/form
           '[:map {:description "x" :optional true}
             [:id :int]]}])
        left-hash (:schema/hash (catalog/lookup left :fixture/value 1))
        right-hash (:schema/hash (catalog/lookup right :fixture/value 1))]
    [left-hash right-hash (= left-hash right-hash)])
  => ["sha256:ce5a64c050ea73b6f76e6f3083bcb1327c9f753114bc5effd7337fbfbb5ba3d7"
      "sha256:ce5a64c050ea73b6f76e6f3083bcb1327c9f753114bc5effd7337fbfbb5ba3d7"
      true])

^{:refer std.typed.catalog/catalog
  :id 'schema-version-participates-in-hash}
(fact "the same semantic form at a different version has a different hash"
  (let [value
        (catalog/catalog
         [{:schema/id :demo/value :schema/version 1 :schema/form :str}
          {:schema/id :demo/value :schema/version 2 :schema/form :str}])]
    (not=
     (:schema/hash (catalog/lookup value :demo/value 1))
     (:schema/hash (catalog/lookup value :demo/value 2))))
  => true)

^{:refer std.typed.catalog/dependencies
  :id 'direct-dependencies-have-portable-order}
(fact "direct dependencies are ordered independently of set iteration"
  (let [value
        (catalog/catalog
         [{:schema/id :order/id :schema/version 1 :schema/form :int}
          {:schema/id :order/node
           :schema/version 1
           :schema/form '[:map [:id (var Id)]]}
          {:schema/id :order/root
           :schema/version 1
           :schema/form '[:map
                          [:node (var Node)]
                          [:id (var Id)]]}])
        root (catalog/coordinate value :order/root 1)]
    (catalog/dependencies value root))
  => [[:schema :order/id 1
       "sha256:60e8e3905ca0b3b9c0ea43caabc8ac328682f920726046edaf0428c8e921e31b"]
      [:schema :order/node 1
       "sha256:0dee5d74fbd3c812e4b405f96e6bce59de2935cb48381796bfa48d77cbe0fa28"]])

^{:refer std.typed.catalog/catalog
  :id 'reject-mismatched-schema-hash}
(fact "a supplied hash is an assertion, not mutable metadata"
  (try
    (catalog/catalog
     [{:schema/id :demo/value
       :schema/version 1
       :schema/hash "sha256:deadbeef"
       :schema/form :int}])
    false
    (catch Throwable error
      (= :std.typed.catalog/invalid-catalog
         (:type (ex-data error)))))
  => true)

^{:refer IDeps
  :id 'schema-catalog-dependency-contract}
(fact "catalogs expose exact pinned schema dependencies through IDeps"
  [(= :model/account (:schema/id (dep-get +catalog+ +account-coordinate+)))
   (dep-entries +catalog+ +account-coordinate+)
   (dep-entries +catalog+ +profile-v2-coordinate+)
   (set (dep-keys +catalog+))
   (deps-ordered +catalog+ [+account-coordinate+])]
  => [true
      #{+profile-v2-coordinate+}
      #{+id-coordinate+}
      #{+id-coordinate+
        +profile-v1-coordinate+
        +profile-v2-coordinate+
        +account-coordinate+}
      [+id-coordinate+ +profile-v2-coordinate+ +account-coordinate+]])

^{:refer std.typed.catalog/schema-registry
  :id 'ordinary-symbol-registry-view}
(fact "identified catalogs retain the ordinary symbol lookup surface"
  [(registry/lookup (catalog/schema-registry +catalog+) 'model/Id)
   (registry/lookup (catalog/schema-registry +catalog+) 'model/Profile)]
  => [:int
      '[:map
        {:title "Profile documentation v2"}
        [:id (var Id)]
        [:nickname {:optional true :description "Display name"} :str]]])

^{:refer std.typed.catalog/catalog
  :id 'schema-id-symbol-case-bridge}
(fact "kebab-case schema ids map reversibly to PascalCase references"
  (let [value
        (catalog/catalog
         [{:schema/id :demo/identifier
           :schema/version 1
           :schema/form :int}
          {:schema/id :demo/user-profile
           :schema/version 1
           :schema/form '[:map [:id (var Identifier)]]}])
        identifier (catalog/coordinate value :demo/identifier 1)
        profile (catalog/coordinate value :demo/user-profile 1)]
    [(= [identifier] (catalog/dependencies value profile))
     (registry/lookup (catalog/schema-registry value) 'demo/UserProfile)])
  => [true '[:map [:id (var Identifier)]]])

(def +recursive-catalog+
  (catalog/catalog
   [{:schema/id :tree/id
     :schema/version 1
     :schema/form :int}
    {:schema/id :tree/node
     :schema/version 1
     :schema/form
     '[:map
       [:id (var Id)]
       [:next [:maybe (var Node)]]
       [:children [:vector (var Node)]]
       [:peers [:set (var Node)]]
       [:pair [:tuple :int (var Node)]]
       [:outcome [:result (var Node)]]]}]))

(def +recursive-id-coordinate+
  (catalog/coordinate +recursive-catalog+ :tree/id 1))

(def +recursive-coordinate+
  (catalog/coordinate +recursive-catalog+ :tree/node 1))

(def +mutual-entries+
  [{:schema/id :graph/a
    :schema/version 1
    :schema/form
    '[:map [:next [:maybe (var B)]]]}
   {:schema/id :graph/b
    :schema/version 1
    :schema/form
    '[:map [:previous [:maybe (var A)]]]}])

(def +mutual-catalog+ (catalog/catalog +mutual-entries+))
(def +mutual-a-coordinate+
  (catalog/coordinate +mutual-catalog+ :graph/a 1))
(def +mutual-b-coordinate+
  (catalog/coordinate +mutual-catalog+ :graph/b 1))

^{:refer std.typed.catalog/dependency-closure
  :id 'exact-transitive-dependency-closure}
(fact "dependency closure and order remain exact and dependency-first"
  [(catalog/dependency-closure +catalog+ +account-coordinate+)
   (catalog/dependency-order +catalog+ [+account-coordinate+])]
  => [[+id-coordinate+ +profile-v2-coordinate+]
      [+id-coordinate+ +profile-v2-coordinate+ +account-coordinate+]])

^{:refer std.typed.catalog/dependency-components
  :id 'self-recursive-schema-component}
(fact "self recursion is represented as an explicit dependency-first component"
  (let [components
        (catalog/dependency-components
         +recursive-catalog+
         [+recursive-coordinate+])
        id-component (first components)
        node-component (second components)]
    [(:component/members id-component)
     (:component/recursive? id-component)
     (:component/members node-component)
     (:component/recursive? node-component)
     (= [(:component/id id-component)]
        (:component/dependencies node-component))
     (catalog/dependency-order
      +recursive-catalog+
      [+recursive-coordinate+])])
  => [[+recursive-id-coordinate+]
      false
      [+recursive-coordinate+]
      true
      true
      [+recursive-id-coordinate+ +recursive-coordinate+]])

^{:refer std.typed.catalog/dependency-components
  :id 'mutually-recursive-schema-component}
(fact "mutual structural recursion is deterministic under entry reordering"
  (let [reordered (catalog/catalog (vec (reverse +mutual-entries+)))
        reordered-a (catalog/coordinate reordered :graph/a 1)
        reordered-b (catalog/coordinate reordered :graph/b 1)
        components
        (catalog/dependency-components
         +mutual-catalog+
         [+mutual-a-coordinate+])
        reordered-components
        (catalog/dependency-components reordered [reordered-a])]
    [[(:component/members (first components))
      (:component/recursive? (first components))
      (:component/dependencies (first components))]
     (= components reordered-components)
     (catalog/dependency-closure
      +mutual-catalog+
      +mutual-a-coordinate+)
     (catalog/dependency-order
      reordered
      [reordered-a])])
  => [[[+mutual-a-coordinate+ +mutual-b-coordinate+]
       true
       []]
      true
      [+mutual-b-coordinate+]
      [+mutual-a-coordinate+ +mutual-b-coordinate+]])

^{:refer std.typed.catalog/catalog
  :id 'reject-reference-only-cycle}
(fact "reference-only cycles retain a structured cyclic-reference diagnostic"
  (try
    (catalog/catalog
     [{:schema/id :alias/a
       :schema/version 1
       :schema/form 'B}
      {:schema/id :alias/b
       :schema/version 1
       :schema/form 'A}])
    nil
    (catch Throwable error
      (let [data (ex-data error)]
        [(:type data)
         (:cycle/type data)
         (:finding/type data)
         (count (:schema/coordinates data))])))
  => [:std.typed.catalog/invalid-catalog
      :std.typed.catalog/reference-only-cycle
      :std.typed.schema/cyclic-reference
      2])

^{:refer std.typed.catalog/dependency-components
  :id 'exact-version-pinning-in-components}
(fact "component analysis retains the exact version selected at construction"
  (let [value
        (catalog/catalog
         [{:schema/id :version/item
           :schema/version 1
           :schema/form :int}
          {:schema/id :version/item
           :schema/version 2
           :schema/form :str}
          {:schema/id :version/container
           :schema/version 1
           :schema/form
           '[:map [:item (var Item)]]}])
        item-v1 (catalog/coordinate value :version/item 1)
        item-v2 (catalog/coordinate value :version/item 2)
        container (catalog/coordinate value :version/container 1)]
    [(= (catalog/dependency-closure value container) [item-v2])
     (has? (set (catalog/dependency-order value)) item-v1)
     (has? (set (catalog/dependency-order value)) item-v2)])
  => [true true true])

(let [result (run '[std.typed.catalog-test])]
  (if (= :passed (:status result))
    (pr-str result)
    (throw
     (ex :hara/state (assoc {:result result} :ex/message "std.typed catalog facts failed")))))
