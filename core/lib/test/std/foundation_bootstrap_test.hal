(ns std.foundation.bootstrap-test
  (:require [std.foundation.bootstrap :as bootstrap]))

(def +unordered+
  (str "(ns sample-test)\n\n"
       "^{:refer std.foundation.bootstrap/scaffold}\n"
       "(Test/run [])\n\n"
       "^{:refer std.foundation.bootstrap/public-symbols}\n"
       "(Test/run\n"
       " [{:name \"kept\"\n"
       "   :test (fn [] 1)\n"
       "   :expected 1}])\n"))

^{:refer std.foundation.bootstrap/public-symbols}
(Test/run
 [{:name "finds only owned public functions and macros"
   :test (fn [] (bootstrap/public-symbols 'std.foundation.bootstrap))
   :expected ['std.foundation.bootstrap/arrange-blocks
              'std.foundation.bootstrap/coverage
              'std.foundation.bootstrap/public-symbols
              'std.foundation.bootstrap/scaffold
              'std.foundation.bootstrap/source-symbols
              'std.foundation.bootstrap/test-references]}])

^{:refer std.foundation.bootstrap/source-symbols}
(Test/run
 [{:name "orders symbols by their declaration lines"
   :test (fn []
           (take 2
                 (bootstrap/source-symbols
                  'std.foundation.bootstrap
                  "(defn scaffold [] nil)\n(defn public-symbols [] nil)\n")))
   :expected ['std.foundation.bootstrap/scaffold
              'std.foundation.bootstrap/public-symbols]}])

^{:refer std.foundation.bootstrap/arrange-blocks}
(Test/run
 [{:name "orders newline blocks and preserves their bodies"
   :test (fn []
           (let [arranged (bootstrap/arrange-blocks +unordered+)]
             [(< (str/index-of arranged "bootstrap/public-symbols}")
                 (str/index-of arranged "bootstrap/scaffold}"))
              (str/includes? arranged ":name \"kept\"\n   :test")
              (not (str/includes? arranged "\n\n\n"))]))
   :expected [true true true]}])

^{:refer std.foundation.bootstrap/scaffold}
(Test/run
 [{:name "creates a stable pure scaffold"
   :test (fn []
           (let [first-pass (bootstrap/scaffold
                             'std.foundation.bootstrap
                             ""
                             {:test-namespace 'fixture-bootstrap-test
                              :alias 'bootstrap})
                 second-pass (bootstrap/scaffold
                              'std.foundation.bootstrap
                              (:after first-pass)
                              {:test-namespace 'fixture-bootstrap-test
                               :alias 'bootstrap})]
             [(:write first-pass)
              (= (:after first-pass) (:after second-pass))
              (bootstrap/test-references (:after first-pass))]))
   :expected [false true
              ['std.foundation.bootstrap/arrange-blocks
               'std.foundation.bootstrap/coverage
               'std.foundation.bootstrap/public-symbols
               'std.foundation.bootstrap/scaffold
               'std.foundation.bootstrap/source-symbols
               'std.foundation.bootstrap/test-references]]}
  {:name "creates native and protocol testing seams"
   :test (fn []
           [(bootstrap/test-references
             (:after (bootstrap/scaffold 'std.native.Test "")))
            (bootstrap/test-references
             (:after (bootstrap/scaffold 'std.protocol.icount "")))])
   :expected [['Test/actual
               'Test/catalog
               'Test/compare
               'Test/config
               'Test/context
               'Test/events
               'Test/expected
               'Test/failure
               'Test/failure-count
               'Test/failure-seq
               'Test/failure?
               'Test/failures
               'Test/passed?
               'Test/result
               'Test/run]
              [(symbol "std.protocol.icount.ICount" "ICount")
               'std.protocol.icount.ICount/count]]}])

^{:refer std.foundation.bootstrap/coverage}
(Test/run
 [{:name "reports covered pending missing and orphaned"
   :test (fn []
           (bootstrap/coverage
            'std.foundation.bootstrap
            (str +unordered+
                 "\n^{:refer ghost/missing}\n(Test/run [])\n")))
   :expected {:covered ['std.foundation.bootstrap/public-symbols]
              :pending ['std.foundation.bootstrap/scaffold]
              :missing ['std.foundation.bootstrap/arrange-blocks
                        'std.foundation.bootstrap/coverage
                        'std.foundation.bootstrap/source-symbols
                        'std.foundation.bootstrap/test-references]
              :orphaned ['ghost/missing]}}])
