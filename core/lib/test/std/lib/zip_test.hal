^{:refer std.lib.zip/find-left :added "3.0" :class [:zip/move]}
(Test/run
 [{:name "steps status left to search predicate #1"
   :test (fn [] (-> (from-status (quote [0 1 [2 3] [4 5] 6 |])) (find-left odd?) status))
   :expected (quote ([0 | 1 [2 3] [4 5] 6]))}
  {:name "steps status left to search predicate #2"
   :test (fn [] (-> (from-status (quote [0 1 [2 3] [4 5] 6 |])) (find-left keyword?)))
   :expected nil}]
 migration-test-check)

^{:refer std.lib.zip/find-right :added "3.0" :class [:zip/move]}
(Test/run
 [{:name "steps status right to search for predicate"
   :test (fn []
