(ns std.lib.zip-test
  (:require [std.lib.zip :refer :all :as zip]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic])
  (:config {:override [get find prewalk postwalk]}))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer std.lib.zip/register-type :added "4.0"}
(Test/run
 [{:name "registers a zip type"
   :test (fn [] (resolve (quote register-type)))
   :expected (checker/satisfies (fn [actual] (= :std.native.Var (type actual))))}]
 migration-test-check)

^{:refer std.lib.zip/unregister-type :added "4.0"}
(Test/run
 [{:name "unregisters a zip type"
   :test (fn [] (resolve (quote unregister-type)))
   :expected (checker/satisfies (fn [actual] (= :std.native.Var (type actual))))}]
 migration-test-check)

