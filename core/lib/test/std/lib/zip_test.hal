^{:refer std.lib.zip/find-next :added "3.0" :class [:zip/move]}
(do
 (-> (vector-zip [1 [2 [6 7] 3] [4 5]]) (find-next #{3}) status)
 (Test/run
  [{:name "step status through the tree in depth first order to the first matching element #1"
    :test (fn [] (-> (vector-zip [1 [2 [6 7] 3] [4 5]]) (find-next #{7}) status))
    :expected (quote ([1 [2 [6 | 7] 3] [4 5]]))}
   {:name "step status through the tree in depth first order to the first matching element #2"
    :test (fn [] (-> (vector-zip [1 [2 [6 7] 3] [4 5]]) (find-next keyword)))
    :expected nil}]
  migration-test-check))

^{:refer std.lib.zip/find-prev :added "3.0" :class [:zip/move]}
(Test/run
 [{:name "step status through the tree in reverse order to the last matching element #1"
   :test (fn []
             (-> (from-status (quote [1 [2 [6 | 7] 3] [4 5]])) (find-prev even?) status))
   :expected (quote ([1 [2 [| 6 7] 3] [4 5]]))}
  {:name "step status through the tree in reverse order to the last matching element #2"
   :test (fn []
             (-> (from-status (quote [1 [2 [[[6 7]]] [3]] | [4 5]]))
                 (find-prev even?) status))
   :expected (quote ([1 [2 [[[| 6 7]]] [3]] [4 5]]))}]
 migration-test-check)

