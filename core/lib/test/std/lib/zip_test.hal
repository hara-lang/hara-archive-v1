(Test/run [] migration-test-check)

^{:refer std.lib.zip/step-next :added "3.0" :class [:zip/move]}
(Test/run
 [{:name "step status through the tree in depth first order"
   :test (fn []
             (->> (from-status (quote [| 1 [2 [6 7] 3] [4 5]]))
                  (iterate step-next) (take-while identity)
                  (map right-element)))
   :expected (quote (1 [2 [6 7] 3] 2 [6 7] 6 7 3 [4 5] 4 5))}]
 migration-test-check)

^{:refer std.lib.zip/step-prev :added "3.0" :class [:zip/move]}
(Test/run
 [{:name "step status in reverse through the tree in depth first order"
   :test (fn []
             (->> (from-status (quote [1 [2 [6 7] 3] [4 | 5]]))
                  (iterate step-prev) (take 10)
                  (map right-element)))
   :expected (quote (5 4 [4 5] 3 7 6 [6 7] 2 [2 [6 7] 3] 1))}]
 migration-test-check)

