^{:refer std.lib.zip/left-element :added "3.0" :class [:zip/element]}
(Test/run
 [{:name "element directly left of current position #1"
   :test (fn [] (-> (from-status (quote [1 2 3 | 4])) left-element))
   :expected 3}
  {:name "element directly left of current position #2"
   :test (fn [] (-> (from-status (quote [1 [2 [| 3]]])) left-element))
   :expected nil}
  {:name "element directly left of current position #3"
   :test (fn [] (-> (from-status (quote [1 [2 [nil | 3]]])) left-element))
   :expected nil}]
 migration-test-check)

