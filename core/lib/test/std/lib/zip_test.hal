(Test/run
 [{:name "returns a zipper given a data structure with | as the status"
   :test (fn [] (from-status (quote [1 2 3 | 4])))
   :expected (collection/contains {:left (quote (3 2 1)) :right (quote (4))})}]
 migration-test-check)

^{:refer std.lib.zip/form-zip-wrap :added "4.0"}
(Test/run [] migration-test-check)

^{:refer std.lib.zip/form-zip-unwrap :added "4.0"}
(Test/run [] migration-test-check)

^{:refer std.lib.zip/form-zip :added "4.0"}
(do
 (form-zip :hello)
 (-> (form-zip (quote ([nil] 1))) step-next step-next step-next status)
 (Test/run
  [{:name "creates a form zip #1"
    :test (fn [] (-> (form-zip (quote ([x] 1))) step-next status))
    :expected (quote ((| [x] 1)))}
   {:name "creates a form zip #2"
    :test (fn [] (-> (form-zip (quote ([x] 1))) step-next step-next step-next status))
    :expected (quote (([x] | 1)))}
   {:name "creates a form zip #3"
    :test (fn [] (-> (form-zip (quote ([nil] 1))) step-next step-next step-next status))
    :expected (quote (([nil] | 1)))}
   {:name "creates a form zip #4"
    :test (fn [] (-> (form-zip (quote (1 nil 2 3))) step-next step-next step-next status))
    :expected (quote ((1 nil | 2 3)))}
   {:name "creates a form zip #5"
    :test (fn []
              (-> (form-zip (quote (defn hello [x] (+ 1 2 3)))) (find-next #{3}) status))
    :expected (quote ((defn hello [x] (+ 1 2 | 3))))}
   {:name "creates a form zip #6"
    :test (fn []
              (-> (form-zip {:a 1 :b 2})
                  step-inside (insert-left [:c 4])
                  step-outside status))
    :expected (quote (| {:a 1 :b 2 :c 4}))}
   {:name "creates a form zip #7"
    :test (fn []
              (-> (form-zip #{:c :b :a}) step-inside (insert-left :e) step-outside status))
    :expected (quote (| #{:e :c :b :a}))}]
  migration-test-check))

^{:refer std.lib.zip/prewalk :added "3.0" :class [:zip/edit]}
(Test/run
 [{:name "emulates std.foundation/prewalk behavior with zipper"
   :test (fn []
             (-> (vector-zip [[1 2] [3 4]])
                 (zip/prewalk (fn [v] (if (vector? v) (conj v 100) (+ v 100)))) root-element))
   :expected [[101 102 200] [103 104 200] 200]}]
 migration-test-check)

^{:refer std.lib.zip/postwalk :added "3.0" :class [:zip/edit]}
(Test/run
 [{:name "emulates std.foundation/postwalk behavior with zipper"
   :test (fn []
             (-> (vector-zip [[1 2] [3 4]])
                 (zip/postwalk (fn [v] (if (vector? v) (conj v 100) (+ v 100)))) root-element))
   :expected [[101 102 100] [103 104 100] 100]}]
 migration-test-check)

^{:refer std.lib.zip/matchwalk :added "3.0" :class [:zip/edit]}
(Test/run
 [{:name "performs a match at each level"
   :test (fn []
             (-> (matchwalk (vector-zip [1 [2 [3 [4]]]])
                            [(fn [zip] (= 2 (first (right-element zip)))) (fn [zip] (= 4 (first (right-element zip))))] delete-left)
                 root-element))
   :expected [1 [2 [[4]]]]}]
 migration-test-check)

^{:refer std.lib.zip/levelwalk :added "3.0" :class [:zip/edit]}
(Test/run
 [{:name "performs a match at the same level"
   :test (fn []
             (-> (vector-zip [1 2 3 4])
                 step-inside (levelwalk [(fn [zip] (odd? (right-element zip)))] delete-right)
                 root-element))
   :expected [2 4]}]
 migration-test-check)
