(ns std.lib.encode.url-test
  (:require [std.lib.encode.url :as url]))

(def +nul+ (str/decode-utf8 (std.native.Bytes/new 0)))

(def results
  [(test-check "URL encoding uses one RFC 3986 UTF-8 component"
               [(url/encode "Hara + λ")
                (url/encode +nul+)]
               ["Hara%20%2B%20%CE%BB" "%00"])

   (test-check "URL decoding preserves literal plus and valid Unicode"
               [(url/decode "Hara%20%2B%20%CE%BB")
                (url/decode "a+b")
                (= (url/decode "%00") +nul+)]
               ["Hara + λ" "a+b" true])

   (test-check "URL components reject wrong types, malformed escapes, and invalid UTF-8"
               [(try (url/encode (std.native.Bytes/new 1)) false
                     (catch Throwable error true))
                (try (url/decode (std.native.Bytes/new 1)) false
                     (catch Throwable error true))
                (try (url/decode "%") false
                     (catch Throwable error true))
                (try (url/decode "%0") false
                     (catch Throwable error true))
                (try (url/decode "%GG") false
                     (catch Throwable error true))
                (try (url/decode "%FF") false
                     (catch Throwable error true))]
               [true true true true true true])])

results
