(ns std.lib.context.resource-test
  (:require [std.lib.context.resource :as resource]))

(def results
  (binding [resource/*resource-aliases* (atom {})
            resource/*resource-registry* (atom {})
            resource/*resource-active*
            (atom {:global {} :namespace {} :shared {}})]
    (resource/spec-add
     {:type :migration/resource
      :variant {:default {:config {}}
                :print {:id :print :config {}}}})
    (Test/run
     [{:name "lists all available specs"
       :test (fn [] (coll? (resource/spec-list)))
       :expected true}
      {:name "resolves the migrated spec function"
       :test (fn [] (fn? resource/spec-add))
       :expected true}
      {:name "resolves the migrated remove function"
       :test (fn [] (fn? resource/spec-remove))
       :expected true}
      {:name "retrieves a resource spec"
       :test (fn [] (map? (resource/spec-get :migration/resource)))
       :expected true}
      {:name "lists resource variants"
       :test (fn []
               (coll? (resource/variant-list :migration/resource)))
       :expected true}
      {:name "gets the default resource mode"
       :test (fn [] (resource/resource-mode :migration/resource))
       :expected :global}
      {:name "gets a variant resource mode"
       :test (fn [] (resource/resource-mode :migration/resource :print))
       :expected :global}
      {:name "derives a shared resource key"
       :test (fn []
               (resource/resource-key :shared :migration/resource
                                      :default {:id :hello}))
       :expected :hello}
      {:name "derives an active resource path"
       :test (fn []
               (resource/resource-active-path
                :shared :migration/resource :default {:id :hello}))
       :expected [:shared [:migration/resource :default] :hello]}
      {:name "resource-call-fn dispatches callback arity without multi-arity fn"
       :test (fn []
               (let [call (resource/resource-call-fn
                           (fn [& arguments] (vec arguments)))]
                 (call :mode :migration/resource :default :hello [:arguments])))
       :expected [:mode :migration/resource :default :hello :arguments]}])))

(pr-str results)
