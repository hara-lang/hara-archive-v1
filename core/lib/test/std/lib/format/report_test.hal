(ns std.lib.format.report-test
  (:use code.test)
  (:require [std.lib.format.common :as common]
            [std.lib.format.report :as report]))

(def +summary+
  {:items 2
   :results 2
   :warnings 1
   :errors 0
   :cumulative 7
   :elapsed 8})

(def +progress+
  {:section/id :items
   :section/title "ITEMS"
   :section/kind :progress
   :section/entries
   [{:item/id :alpha
     :item/index 0
     :item/total 2
     :status :return
     :item/display "changed"
     :elapsed 3}]})

^{:refer std.lib.format.report/contains-value?}
(fact "checks membership without requiring a collection"
  [(report/contains-value? [:a :b] :a)
   (report/contains-value? nil :a)]
  => [true false])

^{:refer std.lib.format.report/distinct-values}
(fact "preserves first-seen order while removing duplicates"
  (report/distinct-values [:a :b :a :c :b])
  => [:a :b :c])

^{:refer std.lib.format.report/record-role}
(fact "maps task statuses to line roles"
  [(report/record-role {:status :return})
   (report/record-role {:status :passed})
   (report/record-role {:status :warn})
   (report/record-role {:status :error})
   (report/record-role {:status :failed})
   (report/record-role {:status :timeout})
   (report/record-role {:status :skipped})
   (report/record-role {:data {:test/status :passed}})
   (report/record-role {:status :critical})
   (report/record-role {:status :other})]
  => [:success :success :warning :error :error :timeout :warning
      :success :critical :default])

^{:refer std.lib.format.report/record-status}
(fact "reads domain status from records or their data"
  [(report/record-status {:status :return})
   (report/record-status {:data {:test/status :timeout}})
   (report/record-status {})]
  => [:return :timeout nil])

^{:refer std.lib.format.report/status-text}
(fact "maps task statuses to stable display text"
  [(report/status-text :return)
   (report/status-text :passed)
   (report/status-text :warn)
   (report/status-text :error)
   (report/status-text :failed)
   (report/status-text :timeout)
   (report/status-text :skipped)
   (report/status-text :critical)
   (report/status-text :other)]
  => ["ok" "passed" "warn" "error" "failed" "timeout" "skipped"
      "critical" "other"])

^{:refer std.lib.format.report/time-text}
(fact "renders optional elapsed values with units"
  [(report/time-text nil)
   (report/time-text 8)
   (report/time-text "0.18s")]
  => ["" "8ms" "0.18s"])

^{:refer std.lib.format.report/progress-line}
(fact "renders progress entries with role and elapsed details"
  (select-keys
   (report/progress-line
    {:item/id :alpha
     :item/index 0
     :item/total 2
     :status :passed
     :item/count 15
     :elapsed "0.18s"})
   [:line/text :line/role])
  => {:line/text "1/2  :alpha  passed (15)  0.18s"
      :line/role :success})

(fact "progress lines retain index, result, and elapsed cell roles"
  (vec
   (map
    (fn [cell] (:cell/role cell))
    (:line/cells
     (report/progress-line
      {:item/id :alpha
       :item/index 0
       :item/total 2
       :status :timeout
       :elapsed 4}))))
  => [:index :default :default :default :timeout :bold])

^{:refer std.lib.format.report/diagnostic-line}
(fact "renders diagnostic entries using data or error values"
  (select-keys
   (report/diagnostic-line {:item/id :beta :status :warn :data "review"})
   [:line/text :line/role])
  => {:line/text ":beta  warn  review"
      :line/role :warning})

^{:refer std.lib.format.report/summary-field-label}
(fact "labels standard and extension summary fields"
  [(report/summary-field-label :items)
   (report/summary-field-label :custom)]
  => ["Items" "custom"])

^{:refer std.lib.format.report/summary-value-text}
(fact "formats summary values and elapsed fields"
  [(report/summary-value-text :items 2)
   (report/summary-value-text :elapsed 8)]
  => ["2" "8ms"])

^{:refer std.lib.format.report/summary-field-role}
(fact "maps summary fields to semantic presentation roles"
  [(report/summary-field-role :passed)
   (report/summary-field-role :failed)
   (report/summary-field-role :warnings)
   (report/summary-field-role :timeout)
   (report/summary-field-role :elapsed)
   (report/summary-field-role :facts)]
  => [:success :error :warning :timeout :bold :default])

^{:refer std.lib.format.report/summary-fields}
(fact "uses configured fields and sorted summary extensions"
  [(report/summary-fields {:section/fields []} +summary+)
   (report/summary-fields {:section/fields [:errors]} +summary+)
   (report/summary-fields {:section/fields [:files]
                           :section/strict-fields true}
                          (assoc +summary+ :files 2))]
  => [[:items :results :warnings :errors :cumulative :elapsed]
      [:errors :cumulative :elapsed :items :results :warnings]
      [:files]])

^{:refer std.lib.format.report/field-order-key}
(fact "creates deterministic character keys for extension fields"
  [(report/field-order-key :files)
   (report/field-order-key :timeout)]
  => [[42 45 48 41 55]
      [56 45 49 41 51 57 56]])

^{:refer std.lib.format.report/field-order-before?}
(fact "compares extension fields without relying on host sorting"
  [(report/field-order-before? :files :timeout)
   (report/field-order-before? :timeout :files)]
  => [true false])

^{:refer std.lib.format.report/insert-field}
(fact "inserts a field in the canonical extension order"
  (report/insert-field :files [:items :timeout])
  => [:files :items :timeout])

^{:refer std.lib.format.report/sort-fields}
(fact "sorts extension fields deterministically"
  (report/sort-fields [:timeout :files :facts])
  => [:facts :files :timeout])

^{:refer std.lib.format.report/summary-lines}
(fact "renders summary entries as structured lines"
  (map :line/text (report/summary-lines {:section/entries [+summary+]}))
  => ["Items: 2" "Results: 2" "Warnings: 1" "Errors: 0"
      "Cumulative: 7ms" "Elapsed: 8ms"])

(fact "summary timing cells carry the bold presentation role"
  (vec
   (map
    (fn [line]
      (vec (map (fn [cell] (:cell/role cell)) (:line/cells line))))
    (report/summary-lines {:section/entries [+summary+]})))
  => [[:default :default] [:default :default] [:default :warning]
      [:default :error] [:default :bold] [:default :bold]])

^{:refer std.lib.format.report/section-role}
(fact "assigns semantic roles to section ids"
  [(report/section-role {:section/id :warnings})
   (report/section-role {:section/id :summary})
   (report/section-role {:section/id :other})]
  => [:warning :highlight :highlight])

^{:refer std.lib.format.report/section-content-lines}
(fact "dispatches section content by kind"
  [(map :line/text (report/section-content-lines +progress+))
   (map :line/text
        (report/section-content-lines
         {:section/kind :text :section/entries ["hello"]}))]
  => [["1/2  :alpha  ok  changed  3ms"] ["hello"]])

^{:refer std.lib.format.report/section-selected?}
(fact "applies include and exclude section filters"
  [(report/section-selected? {:section/id :items} {})
   (report/section-selected? {:section/id :items} {:include-sections [:items]})
   (report/section-selected? {:section/id :items} {:exclude-sections [:items]})]
  => [true true false])

^{:refer std.lib.format.report/section-lines}
(fact "adds optional section titles and omits empty sections"
  [(map :line/text (report/section-lines +progress+ {:include-section-titles true}))
   (report/section-lines
    {:section/id :empty :section/entries []}
    {:include-section-titles true})]
  => [["ITEMS" "1/2  :alpha  ok  changed  3ms"] []])

^{:refer std.lib.format.report/add-group}
(fact "joins non-empty line groups with one separator"
  (map :line/text
       (report/add-group
        [(common/line "one")]
        [(common/line "two")]))
  => ["one" "" "two"])

^{:refer std.lib.format.report/report-lines}
(fact "renders report documents into grouped structured lines"
  (map :line/text
       (report/report-lines
        {:report/title "REPORT"
         :report/sections [+progress+]
         :report/annotations ["Done"]}))
  => ["REPORT" "" "ITEMS" "1/2  :alpha  ok  changed  3ms" "" "Done"])

^{:refer std.lib.format.report/report}
(fact "renders report lines as plain text"
  (report/report
   {:report/title "REPORT"
    :report/sections [+progress+]})
  => "REPORT\n\nITEMS\n1/2  :alpha  ok  changed  3ms")

^{:refer std.lib.format.report/render-report}
(fact "renders report lines through the terminal boundary"
  (report/render-report
   {:report/title "REPORT"
    :report/sections [+progress+]})
  => "REPORT\n\nITEMS\n1/2  :alpha  ok  changed  3ms")

(fact "marks the supported report operations public"
  [(:public (meta (get (ns-publics 'std.lib.format.report) 'report-lines)))
   (:public (meta (get (ns-publics 'std.lib.format.report) 'render-report)))
   (:public (meta (get (ns-publics 'std.lib.format.report) 'report)))]
  => [true true nil])

(pr-str (run {:namespace "std.lib.format.report-test"}))
