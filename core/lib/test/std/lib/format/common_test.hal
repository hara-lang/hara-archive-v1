(ns std.lib.format.common-test
  (:use code.test)
  (:require [std.lib.format.common :as common]))

^{:refer std.lib.format.common/line}
(fact "creates structured lines with default and explicit roles"
  [(common/line "hello")
   (common/line "warning" :warning)]
  => [{:line/text "hello" :line/role :default}
      {:line/text "warning" :line/role :warning}])

^{:refer std.lib.format.common/value-text}
(fact "renders nil, strings, and data values for display"
  [(common/value-text nil)
   (common/value-text "hello")
   (common/value-text [:alpha 2])]
  => ["" "hello" "[:alpha 2]"])

^{:refer std.lib.format.common/character-width}
(fact "classifies ordinary, wide, combining, and emoji characters"
  [(common/character-width \a)
   (common/character-width \界)
   (common/character-width \u0301)
   (common/character-width \😀)]
  => [1 2 0 2])

^{:refer std.lib.format.common/display-width}
(fact "measures terminal cells rather than Unicode code points"
  [(common/display-width "abc")
   (common/display-width "界")
   (common/display-width "é")
   (common/display-width "😀")]
  => [3 2 1 2])

^{:refer std.lib.format.common/cell}
(fact "creates portable cells with presentation roles"
  [(common/cell "hello")
   (common/cell 42 :success)]
  => [{:cell/text "hello" :cell/role :default}
      {:cell/text "42" :cell/role :success}])

^{:refer std.lib.format.common/line-cells}
(fact "keeps line text and per-cell roles together"
  (common/line-cells
   [(common/cell "1/2" :index)
    (common/cell "  ")
    (common/cell "passed" :success)])
  => {:line/text "1/2  passed"
      :line/role :default
      :line/cells [{:cell/text "1/2" :cell/role :index}
                   {:cell/text "  " :cell/role :default}
                   {:cell/text "passed" :cell/role :success}]})

^{:refer std.lib.format.common/truncate}
(fact "keeps short text and applies width-aware ellipses"
  [(common/truncate "abc" 5)
   (common/truncate "abcdef" 5)
   (common/truncate "abcdef" 3)]
  => ["abc" "ab..." "abc"])

^{:refer std.lib.format.common/pad}
(fact "pads text on each supported alignment"
  [(common/pad "x" 3 :left)
   (common/pad "x" 3 :right)
   (common/pad "x" 3 :center)]
  => ["x  " "  x" " x "])

(fact "truncate and pad preserve terminal-cell boundaries"
  [(common/truncate "界界x!" 5)
   (common/truncate "éabc" 3)
   (common/pad "界" 4 :left)
   (common/pad "界" 4 :right)
   (common/pad "界" 4 :center)]
  => ["界..." "éab" "界  " "  界" " 界 "])

(pr-str (run {:namespace "std.lib.format.common-test"}))
