(ns std.lib.format.table-test
  (:use code.test)
  (:require [std.lib.format.table :as table]))

^{:refer std.lib.format.table/cells-with-separators}
(fact "places unstyled spacing cells between table cells"
  (table/cells-with-separators
   [{:cell/text "a" :cell/role :index}
    {:cell/text "b" :cell/role :error}])
  => [{:cell/text "a" :cell/role :index}
      {:cell/text "  " :cell/role :default}
      {:cell/text "b" :cell/role :error}])

^{:refer std.lib.format.table/table-cells}
(fact "applies row or column roles to table data cells"
  (let [cells
        (table/table-cells
         [{:key :name :width 4}
          {:key :timeout :width 7 :role :timeout}]
         {:name "case" :timeout 4
          :status :return
          :data {:test/status :failed}})]
    [(vec (map (fn [cell] (:cell/text cell)) cells))
     (vec (map (fn [cell] (:cell/role cell)) cells))])
  => [["case" "  " "4      "]
      [:error :default :timeout]])

^{:refer std.lib.format.table/table-lines}
(fact "renders aligned headers, separators, and rows"
  (map
   #(select-keys % [:line/text :line/role])
   (table/table-lines
    {:section/columns [{:key :path}
                       {:key :fun :align :right}
                       {:key :ins :align :right}]
     :section/entries [{:path "a.clj" :fun 2 :ins 3}
                       {:path "b.clj" :fun 1 :ins 0}]}))
  => [{:line/text "path   fun  ins" :line/role :highlight}
      {:line/text "-----  ---  ---" :line/role :muted}
      {:line/text "a.clj    2    3" :line/role :default}
      {:line/text "b.clj    1    0" :line/role :default}])

(pr-str (run {:namespace "std.lib.format.table-test"}))
