(ns std.lib.kernel-test
  (:use code.test)
  (:require [std.lib.kernel :as kernel]))

(defn native-error
  [f]
  (try
    (do
      (f)
      {:status :returned})
    (catch error
      (let [data (ex-data error)]
        {:status :error
         :code (:ex/code data)
         :method (:native/method data)}))))

(fact "std.lib.kernel owns its native wrappers"
  [(get (Runtime/namespace 'std.lib.kernel) :namespace/role)
   (nil? (get (ns-publics 'std.lib.kernel) 'sandbox-open))]
  => [:internal false])

^{:refer std.lib.kernel/sandbox-open}
(fact "sandbox-open calls the native sandbox boundary"
  (native-error (fn [] (kernel/sandbox-open {})))
  => {:status :error
      :code :native/capability-denied
      :method "open"})

^{:refer std.lib.kernel/sandbox-eval}
(fact "sandbox-eval calls the native sandbox boundary"
  (native-error (fn [] (kernel/sandbox-eval 1 "(+ 1 2)")))
  => {:status :error
      :code :native/capability-denied
      :method "eval"})

^{:refer std.lib.kernel/sandbox-call}
(fact "sandbox-call calls the native sandbox boundary"
  (native-error (fn [] (kernel/sandbox-call 1 "demo/run" [])))
  => {:status :error
      :code :native/capability-denied
      :method "call"})

^{:refer std.lib.kernel/sandbox-cancel}
(fact "sandbox-cancel calls the native sandbox boundary"
  (native-error (fn [] (kernel/sandbox-cancel 1)))
  => {:status :error
      :code :native/capability-denied
      :method "cancel"})

