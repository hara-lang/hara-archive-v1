;; The public filesystem surface lives under std.fs.
(ns std.fs.facade-test
  (:use code.test)
  (:require [std.fs :as fs]
            [std.fs.path :as path]
            [std.fs.walk :as walk]))

(defn with-test-root
  [function]
  (let [root (fs/temp-directory "/" {:prefix "std-fs-sync-"})]
    (try
      (function root)
      (finally
        (fs/delete root {:recursive? true :missing-ok? true})))))

(defn caught-data
  [function]
  (try
    (do
      (function)
      nil)
    (catch Throwable error
      (ex-data error))))

(def results
  [(fact "with-test-root-restores-the-filesystem-baseline"
     (let [observed
           (with-test-root
             (fn [test-root]
               [(fs/exists? test-root) test-root]))]
       [(first observed)
        (fs/exists? (second observed))])
     => [true false])

   (fact "low-level-file-effects-remain-promise-based"
     (with-test-root
       (fn [test-root]
         [(promise? (File/stat test-root))
          (promise? (File/exists? test-root))
          (promise? (File/entries test-root))
          (promise? (File/read (path/join test-root "missing")))
          (promise? (File/copy (path/join test-root "missing-source")
                               (path/join test-root "missing-target")))
          (promise? (File/move (path/join test-root "missing-source")
                               (path/join test-root "missing-target")))]))
     => [true true true true true true])

   (fact "std-fs-returns-direct-metadata-predicate-byte-and-mutation-values"
     (with-test-root
       (fn [test-root]
         (let [source-root (path/join test-root "source")
               nested-root (path/join source-root "nested")
               alpha-path (path/join source-root "alpha.txt")
               beta-path (path/join source-root "beta.txt")
               gamma-path (path/join nested-root "gamma.txt")
               directory (fs/create-directory nested-root {:parents? true})
               alpha (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))
               beta (fs/write-bytes beta-path (str/encode-utf8 "beta"))
               gamma (fs/write-bytes gamma-path (str/encode-utf8 "gamma"))
               bytes-value (fs/read-bytes alpha-path)
               entry (fs/stat alpha-path)]
           [(promise? directory)
            (promise? alpha)
            (promise? beta)
            (promise? gamma)
            (promise? bytes-value)
            (= directory nested-root)
            (= alpha alpha-path)
            (= beta beta-path)
            (= gamma gamma-path)
            (= (str/decode-utf8 bytes-value) "alpha")
            (= (:path entry) alpha-path)
            (= (:name entry) "alpha.txt")
            (= (:type entry) :file)
            (= (:size entry) 5)
            (map? (:extensions entry))
            (fs/exists? alpha-path)
            (fs/file? alpha-path)
            (fs/directory? nested-root)
            (fs/symlink? alpha-path)])))
     => [false false false false false
         true true true true true
         true true true true true
         true true true false])

   (fact "std-fs-provider-and-validation-failures-throw-synchronously"
     (with-test-root
       (fn [test-root]
         (let [source-root (path/join test-root "source")
               alpha-path (path/join source-root "alpha.txt")
               _ (fs/create-directory source-root)
               _ (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))]
           [(get
             (caught-data
              (fn []
                (fs/write-bytes alpha-path (str/encode-utf8 "replacement"))))
             :ex/code)
            (get
             (caught-data
              (fn []
                (fs/read-bytes (path/join test-root "missing"))))
             :ex/code)
            (get
             (caught-data
              (fn []
                (fs/copy source-root source-root)))
             :ex/code)
            (get
             (caught-data
              (fn []
                (fs/copy-into "/" test-root)))
             :ex/code)])))
     => [:file/already-exists
         :file/not-found
         :file/invalid-path
         :file/invalid-path])

   (fact "list-walk-and-select-return-deterministic-vectors"
     (with-test-root
       (fn [test-root]
         (let [source-root (path/join test-root "source")
               nested-root (path/join source-root "nested")
               alpha-path (path/join source-root "alpha.txt")
               beta-path (path/join source-root "beta.txt")
               gamma-path (path/join nested-root "gamma.txt")
               _ (fs/create-directory nested-root {:parents? true})
               _ (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))
               _ (fs/write-bytes beta-path (str/encode-utf8 "beta"))
               _ (fs/write-bytes gamma-path (str/encode-utf8 "gamma"))
               listed (fs/list source-root)
               walked (vec (map :path (walk/walk source-root)))
               selected (vec (map :path
                                  (fs/select source-root
                                             (fn [entry]
                                               (= (:type entry) :file)))))
               shallow (vec (map :path
                                 (walk/walk source-root {:max-depth 1})))
               pruned (vec (map :path
                                (walk/walk
                                 source-root
                                 {:exclude
                                  (fn [entry]
                                    (= (:name entry) "nested"))})))
               relative (fn [values]
                          (vec (map
                                (fn [value]
                                  (path/relativize test-root value))
                                values)))]
           [(promise? listed)
            (promise? walked)
            (relative listed)
            (relative walked)
            (relative selected)
            (relative shallow)
            (relative pruned)])))
     => [false
         false
         ["source/alpha.txt" "source/beta.txt" "source/nested"]
         ["source/alpha.txt" "source/beta.txt" "source/nested"
          "source/nested/gamma.txt"]
         ["source/alpha.txt" "source/beta.txt" "source/nested/gamma.txt"]
         ["source/alpha.txt" "source/beta.txt" "source/nested"]
         ["source/alpha.txt" "source/beta.txt"]])

   (fact "copy-copy-into-and-move-return-direct-results"
     (with-test-root
       (fn [test-root]
         (let [source-root (path/join test-root "source")
               nested-root (path/join source-root "nested")
               alpha-path (path/join source-root "alpha.txt")
               beta-path (path/join source-root "beta.txt")
               gamma-path (path/join nested-root "gamma.txt")
               copy-root (path/join test-root "copy")
               single-path (path/join test-root "single.txt")
               moved-path (path/join test-root "moved.txt")
               into-root (path/join test-root "into")
               into-beta (path/join into-root "beta.txt")
               _ (fs/create-directory nested-root {:parents? true})
               _ (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))
               _ (fs/write-bytes beta-path (str/encode-utf8 "beta"))
               _ (fs/write-bytes gamma-path (str/encode-utf8 "gamma"))
               mapping (fs/copy source-root copy-root)
               into-directory (fs/create-directory into-root)
               into-mapping (fs/copy-into beta-path into-root)
               copied-single (fs/copy-single alpha-path single-path)
               moved (fs/move single-path moved-path)]
           [(promise? mapping)
            (promise? into-mapping)
            (= (get mapping source-root) copy-root)
            (= (get mapping alpha-path) (path/join copy-root "alpha.txt"))
            (= (get mapping gamma-path) (path/join copy-root "nested/gamma.txt"))
            (= into-directory into-root)
            (= (get into-mapping beta-path) into-beta)
            (= copied-single single-path)
            (= moved moved-path)
            (= (str/decode-utf8
                (fs/read-bytes (path/join copy-root "nested/gamma.txt")))
               "gamma")
            (= (str/decode-utf8 (fs/read-bytes into-beta)) "beta")
            (not (fs/exists? single-path))
            (fs/file? moved-path)])))
     => [false false
         true true true true true true true
         true true true true])

   (fact "recursive-delete-is-post-order-and-simple-delete-is-a-path"
     (with-test-root
       (fn [test-root]
         (let [source-root (path/join test-root "source")
               nested-root (path/join source-root "nested")
               alpha-path (path/join source-root "alpha.txt")
               beta-path (path/join source-root "beta.txt")
               gamma-path (path/join nested-root "gamma.txt")
               moved-path (path/join test-root "moved.txt")
               _ (fs/create-directory nested-root {:parents? true})
               _ (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))
               _ (fs/write-bytes beta-path (str/encode-utf8 "beta"))
               _ (fs/write-bytes gamma-path (str/encode-utf8 "gamma"))
               _ (fs/write-bytes moved-path (str/encode-utf8 "moved"))
               deleted (fs/delete source-root {:recursive? true})
               simple (fs/delete moved-path)
               relative (fn [value]
                          (path/relativize test-root value))]
           [(vec (map relative deleted))
            (relative simple)
            (fs/exists? source-root)
            (fs/exists? moved-path)])))
     => [["source/alpha.txt" "source/beta.txt" "source/nested/gamma.txt"
          "source/nested" "source"]
         "moved.txt"
         false
         false])

   (fact "filesystem-defaults-and-public-contract-remain-stable"
     [[fs/copy-default-options fs/delete-default-options]
      walk/default-options
      (every? (fn [symbol]
                (not (nil? (resolve symbol))))
              '[std.fs/copy
                std.fs/copy-default-options
                std.fs/copy-into
                std.fs/copy-single
                std.fs/create-directory
                std.fs/delete
                std.fs/delete-default-options
                std.fs/directory?
                std.fs/entries
                std.fs/exists?
                std.fs/file?
                std.fs/list
                std.fs/mkdir
                std.fs/move
                std.fs/read-bytes
                std.fs/select
                std.fs/stat
                std.fs/symlink?
                std.fs/temp-directory
                std.fs/temp-file
                std.fs/write-bytes
                std.fs.walk/default-options
                std.fs.walk/walk])]
     => [[{:replace? false
           :parents? false
           :preserve-modified? false}
          {:recursive? false
           :missing-ok? false}]
         {:include-root? false
          :max-depth nil
          :include nil
          :exclude nil}
         true])])

(pr-str (run '[std.fs.facade-test]))
