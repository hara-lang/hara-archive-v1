(ns std.substrate.util-test
  (:use code.test)
  (:require [std.substrate :as substrate]
            [std.substrate.frame :as frame]
            [std.substrate.util :as util]))

(fact "gets lists and sends through transports"
  (let [node (substrate/node-create "node/transports")
        sent (atom [])]
    (substrate/section-put
     node :transports "peer-b"
     {"id" "peer-b"
      "send_fn" (fn [outgoing]
                  (reset! sent (conj @sent ["peer-b" (get outgoing "id")]))
                  outgoing)})
    (substrate/section-put
     node :transports "peer-a"
     {"id" "peer-a"
      "send_fn" (fn [outgoing]
                  (reset! sent (conj @sent ["peer-a" (get outgoing "id")]))
                  outgoing)})
    (promise/value
     (util/transport-send
      node "peer-a"
      (frame/stream-frame "room/a" "event/a" 1 {"id" "evt-a"} nil)))
    [(get (util/transport-get node "peer-a") "id")
     (util/transport-list node)
     @sent])
  => ["peer-a" ["peer-a" "peer-b"] [["peer-a" "evt-a"]]])

(fact "selects explicit default and local request targets"
  (let [node (substrate/node-create "node/target")]
    (substrate/section-put node :transports "peer-a"
                      {"id" "peer-a" "send_fn" identity})
    [(util/transport-request-target node {"transport_id" "peer-b"})
     (util/transport-request-target node {})
     (util/transport-request-target node {"local" true})
     (util/transport-request-target
      (substrate/node-create "node/empty") {})])
  => ["peer-b" "peer-a" nil nil])

(fact "broadcasts while respecting exclusions"
  (let [node (substrate/node-create "node/route")
        sent (atom [])
        outgoing (frame/stream-frame
                  "room/a" "event/a" 1 {"id" "evt-route"} nil)]
    (substrate/section-put node :transports "peer-a"
                      {"id" "peer-a"
                       "send_fn" (fn [value]
                                   (reset! sent (conj @sent "peer-a"))
                                   value)})
    (substrate/section-put node :transports "peer-b"
                      {"id" "peer-b"
                       "send_fn" (fn [value]
                                   (reset! sent (conj @sent "peer-b"))
                                   value)})
    (promise/value
     (util/transport-broadcast-loop
      node ["peer-a" "peer-b"] outgoing "peer-a" 0))
    (promise/value
     (util/stream-route-loop
      node ["peer-a" "peer-b"] outgoing "peer-b" 0))
    @sent)
  => ["peer-b" "peer-a"])

(fact "merges transport context into request metadata"
  [(util/request-context-merge
    {"kind" "request" "meta" {"trace" "a"}}
    {"transport_id" "peer-a"})
   (util/request-context-merge
    {"kind" "request"}
    {"transport_id" "peer-b"})]
  => [{"kind" "request"
       "meta" {"trace" "a" "transport_id" "peer-a"}}
      {"kind" "request"
       "meta" {"transport_id" "peer-b"}}])

(fact "constructs and forwards response frames"
  (let [node (substrate/node-create "node/response")
        captured (atom nil)
        incoming (frame/request-frame
                  "room/a" "echo" [] {"id" "req-1"})]
    (substrate/section-put
     node :transports "peer-a"
     {"id" "peer-a"
      "send_fn" (fn [outgoing]
                  (reset! captured outgoing)
                  outgoing)})
    (promise/value
     (util/response-ok
      node incoming {"ok" true} nil {"transport_id" "peer-a"}))
    [(get @captured "kind")
     (get @captured "reply_to")
     (get @captured "status")
     (get-in @captured ["data" "ok"])])
  => ["response" "req-1" "ok" true])

(fact "normalises declarative configuration"
  (let [handler (fn [space args incoming node] args)
        trigger (fn [space stream node] stream)
        mismatched-space
        (try
          (do (util/config-normalize-space
               "room/a" {"id" "room/b"}) false)
          (catch Throwable error true))
        mismatched-handler
        (try
          (do (util/config-normalize-handler
               "ping" {"id" "pong" "fn" handler}) false)
          (catch Throwable error true))]
    [(util/config-normalize-space "room/a" nil)
     (util/config-normalize-space
      "room/a"
      {"id" "room/a"
       "state" {"count" 1}
       "meta" {"role" "alpha"}})
     (fn? (get (util/config-normalize-handler "ping" handler) "fn"))
     (get (util/config-normalize-trigger
           "event/ping"
           {"fn" trigger "meta" {"kind" "stream"}})
          "meta")
     mismatched-space
     mismatched-handler])
  => [nil
      {"state" {"count" 1} "meta" {"role" "alpha"}}
      true
      {"kind" "stream"}
      true
      true])

(fact "strips declarative node keys"
  (util/node-base-opts
   {"id" "node-a"
    "meta" {"cluster" "local"}
    "spaces" {"room/a" {}}
    "handlers" {"ping" true}
    "triggers" {"event/ping" true}
    "custom" 42})
  => {"id" "node-a"
      "meta" {"cluster" "local"}
      "custom" 42})

(fact "registers lists and unregisters handlers and triggers"
  (let [node (substrate/node-create "node/registry")]
    (util/register-handler node "sum" identity {"role" "request"})
    (util/register-handler node "echo" identity nil)
    (util/register-trigger node "event/b" identity nil)
    (util/register-trigger node "event/a" identity {"role" "stream"})
    (let [before
          [(util/list-handlers node)
           (util/list-triggers node)
           (get-in (util/get-handler node "sum") ["meta" "role"])
           (get-in (util/get-trigger node "event/a") ["meta" "role"])] ]
      (util/unregister-handler node "echo")
      (util/unregister-trigger node "event/b")
      [before
       (util/list-handlers node)
       (util/list-triggers node)]))
  => [[ ["@/echo" "@/get-service" "@/list-handlers" "@/list-spaces"
         "@/list-transports" "@/list-triggers" "@/node-info" "@/ping"
         "echo" "sum"]
        ["event/a" "event/b"]
        "request"
        "stream"]
      ["@/echo" "@/get-service" "@/list-handlers" "@/list-spaces"
       "@/list-transports" "@/list-triggers" "@/node-info" "@/ping"
       "sum"]
      ["event/a"]])

(pr-str (run '[std.substrate.util-test]))
