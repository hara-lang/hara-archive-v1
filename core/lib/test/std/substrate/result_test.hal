(ns std.substrate.result-test
  (:use code.test)
  (:require [std.foundation.promise :as promise]
            [std.substrate :as substrate]
            [std.substrate.json :as substrate-json]
            [std.substrate.transport-memory :as memory]))

(fact "keeps request portable while offering an opt-in native Result"
  (let [node
        (substrate/node-create
         {:id "node/local"
          :handlers
          {"sum" (fn [space args request current-node]
                   (+ (nth args 0) (nth args 1)))}})
        raw
        (promise/value
         (substrate/request node "room/a" "sum" [19 23] {:local true}))
        result
        (promise/value
         (substrate/request-result
          node "room/a" "sum" [19 23] {:local true}))]
    [raw
     (Result/success? result)
     (Result/data result)
     (get-in (Result/context result) ["substrate" "space"])
     (get-in (Result/context result) ["substrate" "action"])])
  => [42 true 42 "room/a" "sum"])

(fact "classifies local handler failures as delivered application errors"
  (let [node
        (substrate/node-create
         {:id "node/local-error"
          :handlers
          {"deny" (fn [space args request current-node]
                    (throw (ex-info "denied" {:code :app/denied})))}})
        output (substrate/request-result
                node "room/a" "deny" [] {:local true})
        result (promise/value output)]
    [(promise/state output)
     (Result/error? result)
     (ex-message (Result/error-value result))
     (get-in (Result/context result) ["substrate" "failure"])])
  => [:fulfilled true "denied" "application"])

(fact "classifies remote response frames without changing the JSON wire"
  (let [client (substrate/node-create {:id "node/client"})
        server
        (substrate/node-create
         {:id "node/server"
          :handlers
          {"sum" (fn [space args request current-node]
                   (+ (nth args 0) (nth args 1)))
           "deny" (fn [space args request current-node]
                    (throw (ex-info "denied" {:code :app/denied})))}})]
    (promise/value (memory/link-pair server client))
    (let [success
          (promise/value
           (substrate/request-result client "room/a" "sum" [19 23] {}))
          failure
          (promise/value
           (substrate/request-result client "room/a" "deny" [] {}))]
      [(Result/success? success)
       (Result/data success)
       (Result/error? failure)
       (ex-message (Result/error-value failure))
       (get-in (Result/context failure) ["substrate" "failure"])
       (string?
        (get-in (Result/context failure) ["substrate" "reply_to"]))]))
  => [true 42 true "denied" "application" true])

(fact "classifies failures before a response frame as transport errors"
  (let [node (substrate/node-create {:id "node/transport-error"})
        output
        (substrate/request-result
         node "room/a" "sum" [] {:transport-id "missing"})
        result (promise/value output)]
    [(promise/state output)
     (Result/error? result)
     (get-in (Result/context result) ["substrate" "failure"])
     (get-in (Result/context result) ["substrate" "transport_id"])])
  => [:fulfilled true "transport" "missing"])

(fact "preserves response NodeFrames as the top-level JSON protocol"
  (let [response
        (substrate/response-error-frame
         "req-1" "room/a" {"message" "denied"} {"trace" "abc"})
        encoded (substrate-json/encode-frame response)
        decoded (substrate-json/decode-frame encoded)]
    [(get decoded "kind")
     (get decoded "reply_to")
     (get decoded "status")
     (get-in decoded ["error" "message"])
     (nil? (get decoded "$hara"))])
  => ["response" "req-1" "error" "denied" true])

(pr-str (run '[std.substrate.result-test]))
