(ns std.foundation.alias-test
  (:use code.test))

(def results
  [(fact "str/trim source-declared alias works"
     (str/trim "  hara  ")
     => "hara")
   (fact "bytes/get source-declared alias works"
     (bytes/get (std.native.Bytes/new -1) 0)
     => 255)
   (fact "promise? source-declared alias works"
     (promise? (promise/new (fn [resolve reject] (resolve 1))))
     => true)
   (fact ":config {:rename :all} preserves loaded source aliases"
     (do (ns app (:config {:rename :all}))
                   (let [result (bytes/count (str/encode-utf8 "x"))]
                     (ns std.foundation.alias-test
                       (:use code.test))
                     result))
     => 1)])

(pr-str (run '[std.foundation.alias-test]))
