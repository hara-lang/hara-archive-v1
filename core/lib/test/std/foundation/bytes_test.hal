(ns std.foundation.bytes-test
  (:use code.test))

(def results
  [(fact "run creates a byte buffer"
     (bytes/count (bytes/run 1 2 3))
     => 3)
   (fact "get returns signed byte value as unsigned"
     (bytes/get (std.native.Bytes/new -1) 0)
     => 255)])

(pr-str (run '[std.foundation.bytes-test]))
