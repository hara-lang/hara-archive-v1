(ns std.block.layout-test
  (:require [std.block.construct :as construct]
    [std.block.layout :as bind]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [expected (cond
                  (checker/checker? expected) expected
                  (fn? expected) (checker/satisfies expected)
                  :else          expected)
        result   (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

(defn migration-meta-tree
  [value]
  (let [metadata   (select-keys (or (meta value) {}) [:readable-len :tag :spec])
        normalized (cond
                    (vector? value) (mapv migration-meta-tree value)
                    (map? value)    (reduce-kv
                                     (fn
                                      [output key item] (assoc output (migration-meta-tree key) (migration-meta-tree item))) {}
                                     value)
                    (set? value)    (set (map migration-meta-tree value))
                    (seq? value)    (apply list (map migration-meta-tree value))
                    :else           value)]
    {:meta metadata :value normalized}))

^{:refer std.block.layout/layout-hiccup-like :added "4.0"}
(Test/run
 [{:name "checks if form is hiccup structure #1"
   :test (fn [] (bind/layout-hiccup-like [:a :b :c]))
   :expected false}
  {:name "checks if form is hiccup structure #2"
   :test (fn [] (bind/layout-hiccup-like [:a [:b [:c]]]))
   :expected true}
  {:name "checks if form is hiccup structure #3"
   :test (fn [] (bind/layout-hiccup-like [:a {:x 1 :y 2} [:b [:c]]]))
   :expected true}
  {:name "checks if form is hiccup structure #4"
   :test (fn []
             (bind/layout-hiccup-like (vector :% (quote hello) (vector :b (vector :c)))))
   :expected true}
  {:name "checks if form is hiccup structure #5"
   :test (fn []
             (bind/layout-hiccup-like (vector :<> (vector :b (vector :c)) (vector :b (vector :c)))))
   :expected true}]
 migration-test-check)

^{:refer std.block.layout/layout-spec-fn :added "4.0"}
(Test/run
 [{:name "gets the layout spec"
   :test (fn [] (bind/layout-spec-fn (list (quote assoc) (quote m) :a 1 :b 2) true))
   :expected {:col-call true :col-from 1 :columns 2}}]
 migration-test-check)

^{:refer std.block.layout/layout-annotate-arglist :added "4.0"}
(Test/run
 [{:name "adds layout metadat to arglists"
   :test (fn []
             (migration-meta-tree (bind/layout-annotate-arglist (vector (Algo/ordered-map :keys
                                                                                          (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as
                                                                                          (quote other))))))
   :expected (migration-meta-tree (read-string "[^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other}]"))}]
 migration-test-check)

^{:refer std.block.layout/layout-annotate-bindings :added "4.0"}
(Test/run
 [{:name "adds layout metadata to bindings"
   :test (fn []
             (migration-meta-tree (bind/layout-annotate-bindings (vector (Algo/ordered-map :keys
                                                                                           (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as
                                                                                           (quote other))
                                                                         (Algo/ordered-map :a 1 :b 2)))))
   :expected (migration-meta-tree (read-string "^{:spec {:columns 2, :col-align true}} [^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other} {:a 1, :b 2}]"))}]
 migration-test-check)

^{:refer std.block.layout/layout-annotate-fn-named :added "4.0"}
(Test/run [{:name "adds layout metadata to named functions #1", :test (fn [] (migration-meta-tree (bind/layout-annotate-fn-named (list (quote defn) (quote hello) (list (vector (Algo/ordered-map :keys (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as (quote other)))))))), :expected (migration-meta-tree (read-string "(defn hello ([^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other}]))"))} {:name "adds layout metadata to named functions #2", :test (fn [] (migration-meta-tree (bind/layout-annotate-fn-named (list (quote defn) (quote hello) "docstring" (Algo/ordered-map :a 1) (vector (Algo/ordered-map :keys (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as (quote other))))))), :expected (migration-meta-tree (read-string "(defn hello \"docstring\" {:a 1} [^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other}])"))}] migration-test-check)

^{:refer std.block.layout/layout-annotate-fn-anon :added "4.0"}
(Test/run
 [{:name "adds layout metadata to `fn` calls"
   :test (fn []
             (migration-meta-tree (bind/layout-annotate-fn-anon (list (quote fn)
                                                                      (vector (Algo/ordered-map :keys
                                                                                                (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as
                                                                                                (quote other)))))))
   :expected (migration-meta-tree (read-string "(fn [^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other}])"))}]
 migration-test-check)

^{:refer std.block.layout/layout-annotate-svg-path :added "4.0"}
(Test/run [{:name "parses the d string in svg path for better formatting", :test (fn [] (bind/layout-annotate-svg-path [:path {:d "M 10 10 L 20 20"}])), :expected (collection/contains [:path (collection/contains {:d ["M" "10" "10" "L" "20" "20"]})])}] migration-test-check)

^{:refer std.block.layout/layout-annotate :added "4.0"}
(Test/run
 [{:name "adds metadata annotation to form"
   :test (fn []
             (migration-meta-tree (bind/layout-annotate (list (quote let)
                                                              (vector (Algo/ordered-map :keys
                                                                                        (vector (quote a) (quote b) (quote c) (quote d) (quote e)) :as
                                                                                        (quote other))
                                                                      (quote b) 2)))))
   :expected (migration-meta-tree (read-string "(let ^{:spec {:columns 2, :col-align true}} [^{:readable-len 30} {:keys ^{:tag :vector, :readable-len 10, :spec {:columns 1}} [a b c d e], :as other} b])"))}]
 migration-test-check)

^{:refer std.block.layout/layout-annotate :added "4.1" :id defprotocol-layout}
(Test/run
 [{:name "does not treat protocol declarations as function definitions"
   :test (fn []
             (-> (list (quote defprotocol)
                       (quote IBlock) (list (quote block-type) (vector (quote block)))
                       (list (quote block-tag) (vector (quote block))))
                 bind/layout-main std.block.base/block-representation))
   :expected "(defprotocol IBlock
  (block-type [block])
  (block-tag [block]))"}]
 migration-test-check)

^{:refer std.block.layout/layout-default-fn :added "4.0"}
(Test/run
 [{:name "the default function for level 1 transformation"
   :test (fn [] (pr-str (construct/rep (bind/layout-default-fn [1 2 3] {}))))
   :expected (pr-str [1 2 3])}]
 migration-test-check)

^{:refer std.block.layout/layout-main :added "4.0"}
(do (construct/get-lines (bind/layout-main (list (quote defn) (quote layout-with-bindings) "layout with bindings" (Algo/ordered-map :added "4.0") (list (vector (quote form) (Algo/ordered-map :keys (vector (quote indents)) :or (Algo/ordered-map (quote indents) 0) :as (quote opts))) (list (quote let) (vector (vector (quote start-sym) (quote nindents)) (list (quote layout-multiline-form-setup) (quote form) (quote opts)) (quote start-blocks) (list (quote list) (quote start-sym) (list (quote construct/space))) (quote bopts) (list (quote assoc) (quote opts) :spec (Algo/ordered-map :col-align true :columns 2) :indents (quote nindents)) (quote bindings) (list (quote *layout-fn*) (list (quote second) (quote form)) (quote bopts)) (quote aopts) (list (quote assoc) (quote opts) :indents (list (quote +) 1 (quote indents))) (quote arg-spacing) (list (quote concat) (vector (list (quote construct/newline))) (list (quote repeat) (list (quote +) 1 (quote indents)) (list (quote construct/space)))) (quote arg-blocks) (list (quote ->>) (list (quote drop) 2 (quote form)) (list (quote map) (list (quote fn) (vector (quote arg)) (list (quote *layout-fn*) (quote arg) (quote aopts)))) (list (quote join-blocks) (quote arg-spacing)))) (list (quote construct/container) :list (list (quote vec) (list (quote concat) (quote start-blocks) (vector (quote bindings)) (quote arg-spacing) (quote arg-blocks))))))))) ["(defn layout-with-bindings" "  \"layout with bindings\"" "  {:added \"4.0\"}" "  ([form" "    {:keys" "     [indents]" "     :or" "     {indents" "      0}" "     :as" "     opts}]     (let [[start-sym" "                      nindents]   (layout-multiline-form-setup form" "                                                               opts)" "                     start-blocks (list start-sym" "                                        (construct/space))" "                     bopts        (assoc opts" "                                         :spec    {:col-align true :columns 2}" "                                         :indents nindents)" "                     bindings     (*layout-fn* (second form)" "                                               bopts)" "                     aopts        (assoc opts" "                                         :indents (+ 1 indents))" "                     arg-spacing  (concat [(construct/newline)]" "                                          (repeat (+ 1 indents)" "                                                  (construct/space)))" "                     arg-blocks   (->> (drop 2 form)" "                                       (map (fn [arg]" "                                                (*layout-fn* arg aopts))) (join-blocks arg-spacing))]" "                 (construct/container :list" "                   (vec (concat start-blocks" "                          [bindings]" "                          arg-spacing" "                          arg-blocks))))))"] (Test/run [{:name "performs the main layout #1", :test (fn [] (construct/get-lines (bind/layout-main (list (quote +) 1 2 3)))), :expected ["(+ 1 2 3)"]} {:name "performs the main layout #2", :test (fn [] (construct/get-lines (bind/layout-main (list (quote let) (vector (quote a) (Algo/ordered-map :a 1 :b 2) (quote b) (Algo/ordered-map :a 1 :b 2)) (list (quote +) (quote a) 2))))), :expected ["(let [a {:a 1 :b 2}" "      b {:a 1 :b 2}]" "  (+ a 2))"]} {:name "performs the main layout #3", :test (fn [] (construct/get-lines (bind/layout-main (list (quote let) (vector (quote allowable) (Algo/ordered-map :allowable 1 :b 2) (quote b) (Algo/ordered-map :a 1 :botherable 2)) (list (quote +) (quote a) 2))))), :expected ["(let [allowable {:allowable 1 :b 2}" "      b         {:a 1 :botherable 2}]" "  (+ a 2))"]} {:name "performs the main layout #4", :test (fn [] (construct/get-lines (bind/layout-main (list (quote assoc) (quote m) :key1 (quote val1) :key2 (quote val2) :key3 (list (quote +) (quote a) 2))))), :expected ["(assoc m" "       :key1 val1" "       :key2 val2" "       :key3 (+ a 2))"]} {:name "performs the main layout #5", :test (fn [] (construct/get-lines (bind/layout-main (list (quote hash-map) :key1 (quote val1) :key2 (quote val2) :key3 (list (quote +) (quote a) 2))))), :expected ["(hash-map :key1 val1" "          :key2 val2" "          :key3 (+ a 2))"]} {:name "performs the main layout #6", :test (fn [] (construct/get-lines (bind/layout-main (Algo/ordered-map :a1 (Algo/ordered-map :b1-data-long0 1 :b1-data-long1 2) :a2 (Algo/ordered-map :b2-data-long0 3 :b2-data-long1 4))))), :expected ["{:a1 {:b1-data-long0 1" "      :b1-data-long1 2}" " :a2 {:b2-data-long0 3" "      :b2-data-long1 4}}"]} {:name "performs the main layout #7", :test (fn [] (construct/get-lines (bind/layout-main (vector (vector (Algo/ordered-map :a1 (Algo/ordered-map :b1-data-long0 1 :b1-data-long1 2) :a2-long (Algo/ordered-map :b2-data-long0 (Algo/ordered-map :c2-data-long0 6 :c2-data 5) :b2-data-long1 4))))))), :expected vector?} {:name "performs the main layout #8", :test (fn [] (construct/get-lines (bind/layout-main (list (quote let) (vector (quote foo-bind) (vector 1 2 3) (Algo/ordered-map :keys (vector (quote a) (quote ab) (quote abc)) :as (quote data)) (list (quote merge) (Algo/ordered-map :a1 (Algo/ordered-map :b1-data 1 :b1-data-long1 2) :a2 (Algo/ordered-map :b2 3 :b2-long1 4)) (quote spec)) (quote foo-bind) (vector 1 2 3)) (list (quote +) 1 2 3))))), :expected vector?}] migration-test-check))
