   :expected [{:char "(" :col 1 :line 1 :style :paren :type :open} {:char "(" :col 5 :line 1 :style :paren :type :open}
              {:char "(" :col 5 :line 2 :style :paren :type :open} {:char "n" :col 5 :last-idx 10 :line 3 :type :code}
              {:char "{" :col 9 :line 3 :style :curly :type :open}]}]
 migration-test-check)

^{:refer std.block.heal.core/group-blocks-prep :added "4.0"}
