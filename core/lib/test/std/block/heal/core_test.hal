^{:refer std.block.heal.core/group-blocks-single :added "4.0"}
(Test/run
 [{:name "creates a single block #1"
   :test (fn []
             (level/group-blocks-single (:entries (level/group-blocks-prep (apply str (interpose "
" ["(:? ()" "    ())" "    nil {})"]))))
                                        1))
   :expected {:children [{:level 0
                          :line [1 1]
                          :col 5
                          :lead {:char "(" :col 5 :line 1 :style :paren :type :open}} {:level 0
                                                                                       :line [2 2]
                                                                                       :col 5
                                                                                       :lead {:char "(" :col 5 :line 2 :style :paren :type :open}}
                         {:level 0
                          :line [3 3]
                          :col 9
                          :lead {:char "{" :col 9 :line 3 :style :curly :type :open}
                          :last true}]
              :level 1
              :line [1 3]
              :col 1
              :lead {:char "(" :col 1 :line 1 :style :paren :type :open}}}
  {:name "creates a single block #2"
   :test (fn []
             (level/group-blocks-single (:entries (level/group-blocks-prep (apply str (interpose "
" ["(:? ()" "    ())" "    nil)"]))))
                                        1))
   :expected {:children [{:level 0
                          :line [1 1]
                          :col 5
                          :lead {:char "(" :col 5 :line 1 :style :paren :type :open}} {:level 0
                                                                                       :line [2 2]
                                                                                       :col 5
                                                                                       :lead {:char "(" :col 5 :line 2 :style :paren :type :open}}]
              :level 1
              :line [1 3]
              :col 1
              :lead {:char "(" :col 1 :line 1 :style :paren :type :open}}}]
 migration-test-check)

