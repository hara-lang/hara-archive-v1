" ["" "    {(stateName) (Object.assign {} (. component.states [stateName])" "       {:description description})}"]))))}] migration-test-check)

^{:refer std.block.heal.core/get-block-lines :added "4.0"}
(Test/run
 [{:name "gets the block lines #1"
   :test (fn []
             (level/get-block-lines (std.foundation.string/split-lines (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/005_example.block"))))
                                    [2 5] 3))
   :expected ["  (:require [tahto.core :as l]))" ""
              "(l/script :js" "  {:require [[js.react :as r]"]}
  {:name "gets the block lines #2"
   :test (fn []
             (level/get-block-lines (std.foundation.string/split-lines (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/005_example.block"))))
                                    [2 5] 4))
   :expected ["   :require [tahto.core :as l]))" ""
              "(l/script :js" "  {:require [[js.react :as r]"]}]
 migration-test-check)

^{:refer std.block.heal.core/create-block-scan :added "4.1"}
(Test/run [{:expected (collection/contains {:col 2 :end-col nil :last true :line [1 2] :offset 0 :snippet " ab\n cd)"}) :name "creates a scan window from the block bounds" :test (fn [] (let [lines ["(ab" " cd)"]] (level/create-block-scan {:col 2 :last true :line [1 2]} lines)))}] migration-test-check)

^{:refer std.block.heal.core/tighter-scan? :added "4.1"}
(Test/run
 [{:name "checks if a candidate scan window is narrower than the current one #1"
   :test (fn []
             (let [content "(foo (+ 1 2) 3)"
                   lines   (std.foundation.string/split-lines content)
                   block   (first (level/group-blocks content))
                   scan    (level/create-block-scan block lines)]
                  (level/tighter-scan? scan [1 1] 5 12)))
   :expected true}
  {:name "checks if a candidate scan window is narrower than the current one #2"
   :test (fn []
             (let [content "(foo (+ 1 2) 3)"
                   lines   (std.foundation.string/split-lines content)
                   block   (first (level/group-blocks content))
                   scan    (level/create-block-scan block lines)]
                  (level/tighter-scan? scan [1 1] 1 2147483647)))
   :expected false}]
 migration-test-check)

^{:refer std.block.heal.core/create-close-hint-scan :added "4.1"}
(Test/run
 [{:name "builds a tighter scan from a later correct close delimiter"
   :test (fn []
             (let [content "(foo (+ 1 2] 3))"
                   lines   (std.foundation.string/split-lines content)
                   block   (first (level/group-blocks content))
                   scan    (level/create-block-scan block lines)
                   interim (std.block.heal.parse/parse (:snippet scan))
                   errors  (vec (filter (comp not :correct?) interim))]
                  (level/create-close-hint-scan block lines scan interim errors)))
   :expected (collection/contains {:col 6 :end-col 15 :line [1 1]})}]
 migration-test-check)

^{:refer std.block.heal.core/localize-close-hint-scan :added "4.1"}
(Test/run
 [{:name "keeps the full scan when indentation already isolates a child block #1"
   :test (fn []
             (let [content (apply str (interpose "
" ["(foo" "  (bar baz qux]" "  zot))"]))
                   lines   (std.foundation.string/split-lines content)
                   block   (-> (level/group-blocks content) first :children last)]
                  (level/localize-close-hint-scan block lines)))
   :expected (collection/contains {:errors vector?
                                   :scan   (collection/contains {:col 3 :end-col nil :line [2 2]})})}
  {:name "keeps the full scan when indentation already isolates a child block #2"
   :test (fn []
             (let [content (apply str
                                  (interpose "
" ["(outer" "  (a 1)" "  ((b 2" "     [3 4])" "  (c 5))"]))
                   lines   (std.foundation.string/split-lines content)
                   block   (first (level/group-blocks content))]
                  (level/localize-close-hint-scan block lines)))
   :expected (collection/contains {:scan (collection/contains {:col 1 :end-col nil :line [1 5]})})}]
 migration-test-check)

^{:refer std.block.heal.core/check-errored-suspect :added "4.0"}
(Test/run
 [{:name "checks if a block is suspect based on leftover errors"
   :test (fn []
             (let [content "(foo) (bar))" lines (std.foundation.string/split-lines content)]
                  (level/check-errored-suspect (level/create-block-scan {:col 1 :last true :line [1 1]} lines)
                                               lines [{:col 12 :line 1 :type :close}])))
   :expected true}]
 migration-test-check)

^{:refer std.block.heal.core/get-errored-loop :added "4.0"}
(Test/run [{:expected {:at {:col 8 :last true :lead {:char "{" :col 8 :line 12 :style :curly :type :open} :level 9 :line [12 46]} :errors [{:char "{" :col 8 :correct? false :depth 0 :index 0 :line 12 :style :curly :type :open}] :lines ["       {:id \"ui.sections/hero-gradient\"" "        :namespace \"ui.sections\"" "        :name \"HeroGradient\"" "        :description \"Hero section with gradient background\"" "        :stars 245" "        :component" "        (do {:id \"hero-section\"" "             :type \"Container\"" "             :label \"Hero Section\"" "             :libraryRef \"ui.sections/HeroGradient\"" "             :properties {:className \"bg-gradient-to-r from-purple-600 to-blue-600 text-white py-20 px-6\"}" "             :children" "             [(do {:id \"hero-content\"" "                   :type \"Container\"" "                   :label \"Hero Content\"" "                   :properties {:className \"max-w-4xl mx-auto text-center\"}" "                   :children" "                   [(do {:id \"hero-title\"" "                         :type \"Heading\"" "                         :label \"Title\"" "                         :properties {:children \"Build Amazing UIs\"" "                                      :className \"text-5xl font-bold mb-4\"}" "                         :children []})" "                    (do {:id \"hero-subtitle\"" "                         :type \"Text\"" "                         :label \"Subtitle\"" "                         :properties {:children \"Create beautiful interfaces with our component builder\"" "                                      :className \"text-xl mb-8 opacity-90\"}" "                         :children []})" "                    (do {:id \"hero-cta\"" "                         :type \"Button\"" "                         :label \"CTA Button\"" "                         :properties {:children \"Get Started\"" "                                      :className \"bg-white text-purple-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100\"}" "                         :children []})]})]})"]} :name "runs the check block loop" :test (fn [] (level/get-errored-loop (nth (level/group-blocks (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/005_example.block")))) 2) (std.foundation.string/split-lines (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/005_example.block"))))))}] migration-test-check)

^{:refer std.block.heal.core/get-errored-raw :added "4.0"}
(Test/run [{:expected [{:at {:col 9 :lead {:char "[" :col 9 :line 5 :style :square :type :open} :level 0 :line [5 5]} :errors [{:char "]" :col 14 :correct? false :depth -1 :index 2 :line 5 :style :square :type :close}] :lines ["        [:a ]]"]}] :name "helper function for get-errored #1" :test (fn [] (level/get-errored (apply str (interpose "
" ["  (map" "    (fn " "      (return" "       [:% Card" "        [:a ]]" "        [:b]" "        [:c]])))"]))))} {:expected [{:at {:col 23 :lead {:char "(" :col 23 :line 2 :style :paren :type :open} :level 1 :line [2 2]} :errors [{:char "]" :col 31 :correct? false :depth -1 :index 4 :line 2 :style :square :type :close}] :lines ["                      (fn [e])]"]}] :name "helper function for get-errored #2" :test (fn [] (level/get-errored (apply str (interpose "
