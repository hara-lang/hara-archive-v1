" ["(:? ()" "    ())" "    nil {})"]))))
   :expected map?}
  {:name "prepares the block entries for a file #2"
   :test (fn []
             (level/group-blocks-prep (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/005_example.block")))))
   :expected (fn [value]
               (and (vector? (:entries value))
                    (vector? (:lines value))))}]
 migration-test-check)

^{:refer std.block.heal.core/group-blocks :added "4.0"}
(Test/run [{:expected [{:children [{:col 4 :lead {:char "(" :col 4 :line 1 :style :paren :type :open} :level 0 :line [1 1]} {:col 3 :last true :lead {:char "{" :col 3 :line 2 :style :curly :type :open} :level 0 :line [2 2]}] :col 1 :last true :lead {:char "(" :col 1 :line 1 :style :paren :type :open} :level 1 :line [1 2]}] :name "groups the lines by colation sections #1" :test (fn [] (level/group-blocks (apply str (interpose "
" ["(  (+ a b" "  {} b))"]))))} {:expected [{:children [{:col 5 :lead {:char "(" :col 5 :line 1 :style :paren :type :open} :level 0 :line [1 1]} {:col 5 :lead {:char "(" :col 5 :line 2 :style :paren :type :open} :level 0 :line [2 2]}] :col 1 :last true :lead {:char "(" :col 1 :line 1 :style :paren :type :open} :level 1 :line [1 3]}] :name "groups the lines by colation sections #2" :test (fn [] (level/group-blocks (apply str (interpose "
" ["(:? ()" "    ())" "    nil)"]))))} {:expected [{:children [{:col 5 :lead {:char "(" :col 5 :line 2 :style :paren :type :open} :level 0 :line [2 2]} {:children [{:col 11 :lead {:char "{" :col 11 :line 3 :style :curly :type :open} :level 0 :line [3 3]} {:col 6 :last true :lead {:char "[" :col 6 :line 4 :style :square :type :open} :level 0 :line [4 4]}] :col 5 :lead {:char "[" :col 5 :line 3 :style :square :type :open} :level 1 :line [3 4]}] :col 1 :last true :lead {:char "(" :col 1 :line 2 :style :paren :type :open} :level 2 :line [2 5]}] :name "groups the lines by colation sections #3" :test (fn [] (level/group-blocks "
(:? (or )
    [:div {:className \"mb-2\"}
     [:a]]
    nil)"))} {:expected vector? :name "groups the lines by colation sections #4" :test (fn [] (level/group-blocks (apply str (interpose "
