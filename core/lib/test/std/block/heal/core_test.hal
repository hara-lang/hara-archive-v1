^{:refer std.block.heal.core/get-errored :added "4.0"}
(Test/run [{:expected [{:at {:col 23 :last true :lead {:char "(" :col 23 :line 6 :style :paren :type :open} :level 5 :line [6 6]} :errors [{:char "}" :col 97 :correct? false :depth -1 :index 12 :line 6 :style :curly :type :close}] :lines ["                      (fn [e] (return (handleChange \"symbol\" (. e.target.value (toUpperCase)))))}"]}] :name "checks content for irregular blocks #1" :test (fn [] (level/get-errored (apply str (interpose "
" ["         [:div" "          [:% fg/Label {:className \"text-[#b4b4b4] mb-2\"} \"Token Symbol *\"]" "          [:% fg/Input" "           {:placeholder \"e.g., TBP\"" "            :value tokenData.symbol" "            :onChange (fn [e] (return (handleChange \"symbol\" (. e.target.value (toUpperCase)))))}" "            :className \"bg-[#0a0a0a] border-[#2d2d2d] text-white\"" "            :maxLength 10}]" "          [:p {:className \"text-xs text-[#6d6d6d] mt-1\"} \"Short symbol (3-10 characters)\"]]"]))))} {:expected [{:at {:col 9 :lead {:char "(" :col 9 :line 1 :style :paren :type :open} :level 2 :line [1 1]} :errors [{:char "}" :col 23 :correct? false :depth -1 :index 6 :line 1 :style :curly :type :close}] :lines ["        (fn [] (+ ou))}"]}] :name "checks content for irregular blocks #2" :test (fn [] (level/get-errored (apply str (interpose "
" ["{:hello (fn [] (+ ou))}" " :part 1}"]))))} {:expected [] :name "checks content for irregular blocks #3" :test (fn [] (level/get-errored (apply str (interpose "
