(ns std.block.heal.core-test
  (:require [std.foundation.string]
    [std.block :as b]
    [std.block.heal.core :as level]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [expected (cond
                   (checker/checker? expected) expected
                   (fn? expected) (checker/satisfies expected)
                   :else          expected)
        result   (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer std.block.heal.core/get-errored.more :added "4.0"}
(Test/run
 [{:expected
   (fn [value]
     (let [first-error  (nth value 0)
           second-error (nth value 1)
           third-error  (nth value 2)]
       (and (= 3 (count value))
            (= [12 391 491]
               [(first (:line (:at first-error)))
                (first (:line (:at second-error)))
                (first (:line (:at third-error)))])
            (= [:curly :paren :paren]
               [(:style (:lead (:at first-error)))
                (:style (:lead (:at second-error)))
                (:style (:lead (:at third-error)))])
            (= [1 1 1]
               [(count (:errors first-error))
                (count (:errors second-error))
                (count (:errors third-error))]))))
   :name "get errored more cases"
   :test (fn []
           (level/get-errored
            (std.foundation.string/decode-utf8
             (deref (File/read "test-data/std.block.heal/cases/005_example.block")))))}]
 migration-test-check)

^{:refer std.block.heal.core/group-min-col :added "4.0"}
(Test/run
 [{:name "gets the minimum column"
   :test (fn []
             (level/group-min-col [{:col 6} {} {} {:col 21} {} {:col 6} {:col 6} {:col 8}] 0))
   :expected 6}]
 migration-test-check)

