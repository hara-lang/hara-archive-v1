(ns std.block.heal.print-test
  (:require [std.block.heal.parse :as parse]
    [std.block.heal.print :as print]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer std.block.heal.print/print-rainbow :added "4.0"}
(Test/run
 [{:name "prints out the "
   :test (fn []
             (with-out-string (print/print-rainbow (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/002_complex.block")))
                                                   (parse/pair-delimiters (parse/parse-delimiters (std.foundation.string/decode-utf8 (deref (File/read "test-data/std.block.heal/cases/002_complex.block"))))))))
   :expected string?}]
 migration-test-check)
