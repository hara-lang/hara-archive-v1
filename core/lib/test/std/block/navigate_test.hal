(ns std.block.navigate-test
  (:require [std.block.base :as base]
    [std.block.construct :as construct]
    [std.block.navigate :refer :all :as navigate]
    [std.block.parse :as parse]
    [std.block.type :as type]
    [std.lib.zip :as zip]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic])
  (:config {:override [next replace type]}))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer std.block.navigate/nav-template :added "3.0"}
(Test/run
 [{:name "generates a navigation function definition from a given symbol and a block tag function"
   :test (fn [] (nav-template (quote -tag-) (var std.block.base/block-tag)))
   :expected (quote (std.foundation/defn -tag-
                                         ([zip] (-tag- zip (std.foundation/keyword "right"))) ([zip step] (std.foundation/if-let [elem (zip/get zip)] (std.block.base/block-tag elem)))))}]
 migration-test-check)

^{:refer std.block.navigate/left-anchor :added "3.0" :class [:nav/primitive]}
(Test/run
 [{:name "calculates the length to the last newline"
   :test (fn [] (left-anchor (-> (navigator nil) (zip/step-right))))
   :expected 3}]
 migration-test-check)

^{:refer std.block.navigate/update-step-left
  :added "3.0"
  :class [:nav/primitive]}
(Test/run
 [{:name "updates the step position to the left"
   :test (fn [] (-> {:position [0 7]} (update-step-left (construct/block [1 2 3]))))
   :expected {:position [0 0]}}]
 migration-test-check)

^{:refer std.block.navigate/update-step-right
  :added "3.0"
  :class [:nav/primitive]}
(Test/run
 [{:name "updates the step position to the right"
   :test (fn [] (-> {:position [0 0]} (update-step-right (construct/block [1 2 3]))))
   :expected {:position [0 7]}}]
 migration-test-check)

^{:refer std.block.navigate/update-step-inside
  :added "3.0"
  :class [:nav/primitive]}
(Test/run
 [{:name "updates the step position to within a block"
   :test (fn [] (-> {:position [0 0]} (update-step-inside (construct/block #{}))))
   :expected {:position [0 2]}}]
 migration-test-check)

^{:refer std.block.navigate/update-step-inside-left
  :added "3.0"
  :class [:nav/primitive]}
(Test/run
 [{:name "updates the step position to within a block"
   :test (fn [] (-> {:position [0 3]} (update-step-inside-left (construct/block #{}))))
   :expected {:position [0 2]}}]
 migration-test-check)

^{:refer std.block.navigate/update-step-outside
  :added "3.0"
  :class [:nav/primitive]}
(Test/run
 [{:name "updates the step position to be outside a block"
   :test (fn []
             (let [left-elems [(construct/block [1 2 3]) (construct/newline)]]
                  (-> {:left left-elems :position [1 0]}
                      (update-step-outside left-elems) :position)))
   :expected [0 7]}
  {:name "updates the step position with no left elements"
   :test (fn []
             (-> {:left [] :right [(construct/block 1)] :position [0 2]}
                 (update-step-outside []) :position))
   :expected [0 2]}]
 migration-test-check)

