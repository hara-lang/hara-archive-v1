   :test (fn []
             (-> (parse-string "(1 2      #|3       4)")
                 (delete-spaces-left) display-navigator))
   :expected "<0,4> (1 2|3       4)"}]
 migration-test-check)

^{:refer std.block.navigate/delete-spaces-right :added "4.0"}
(Test/run
 [{:name "deletes spaces to the left"
   :test (fn []
             (-> (parse-string "(1 2      3 #|       4)")
                 (delete-spaces-right) display-navigator))
   :expected "<0,12> (1 2      3 |4)"}]
 migration-test-check)

^{:refer std.block.navigate/delete-left :added "3.0" :class [:nav/edit]}
(do
 (-> (parse-string "(#|1   )") (delete-left) display-navigator)
 (-> (parse-string "( 1 #|  )") (delete-left) display-navigator)
 (Test/run
  [{:name "deletes left of the current expression #1"
    :test (fn [] (-> (parse-string "(1 2   #|3)") (delete-left) display-navigator))
    :expected "<0,3> (1 |3)"}
   {:name "deletes left of the current expression #2"
    :test (fn [] (-> (parse-string "(  #|1 2 3)") (delete-left) display-navigator))
    :expected "<0,1> (|1 2 3)"}
   {:name "deletes left of the current expression #3"
    :test (fn [] (-> (parse-string "( #| )") (delete-left) display-navigator))
    :expected "<0,1> (|)"}]
  migration-test-check))

^{:refer std.block.navigate/delete-right :added "3.0" :class [:nav/edit]}
(Test/run
 [{:name "deletes right of the current expression #1"
   :test (fn [] (-> (parse-string "(  #|1 2 3)") (delete-right) display-navigator))
   :expected "<0,3> (  |1 3)"}
  {:name "deletes right of the current expression #2"
   :test (fn [] (-> (parse-string "(1 2   #|3)") (delete-right) display-navigator))
   :expected "<0,7> (1 2   |3)"}
  {:name "deletes right of the current expression #3"
   :test (fn [] (-> (parse-string "(  #|   1  )") (delete-right) display-navigator))
   :expected "<0,1> (|  )"}
  {:name "deletes right of the current expression #4"
   :test (fn [] (-> (parse-string "( #| )") (delete-right) display-navigator))
   :expected "<0,1> (|)"}]
 migration-test-check)

^{:refer std.block.navigate/delete :added "3.0" :class [:nav/edit]}
(Test/run
 [{:name "deletes the current element #1"
   :test (fn [] (-> (parse-string "(  #|1   2 3)") (delete) display-navigator))
   :expected "<0,3> (  |2 3)"}
  {:name "deletes the current element #2"
   :test (fn [] (-> (parse-string "(1 2   #|3)") (delete) display-navigator))
   :expected "<0,7> (1 2   |)"}
  {:name "deletes the current element #3"
   :test (fn [] (-> (parse-string "(  #|    )") (delete) display-navigator))
   :expected "<0,1> (|)"}]
 migration-test-check)

