(ns tool.migrate-script-test
  (:use code.test)
  (:require [tool.migrate :as migrate]
            [tool.migrate.script :as script]))

(defn disposition-counts
  [records]
  (reduce (fn [counts record]
            (update counts
                    (get record :disposition)
                    (fn [current]
                      (inc (or current 0)))))
          {}
          records))

(def results
  [(fact "the script migration source authority is pinned and complete"
     [(get script/+foundation-script-source+ :repository)
      (get script/+foundation-script-source+ :revision)
      (mapv (fn [unit] (get unit :path))
            script/+foundation-script-source-units+)
      (count script/+foundation-script-source-references+)
      (= (count script/+foundation-script-source-references+)
         (count (set script/+foundation-script-source-references+)))]
     => ["zcaudate-xyz/foundation-base"
         "fe54cc866473a888bfbd4ce2d3de6d8011f09f72"
         ["src/tahto/core/script.clj" "src/tahto/core/script_annex.clj" "src/tahto/core/script_control.clj" "src/tahto/core/script_def.clj" "src/tahto/core/script_lint.clj" "src/tahto/core/script_macro.clj"]
         86
         true])

   (fact "tool.migrate publishes the child ledger through intern-all"
     [(= migrate/+foundation-script-source-units+
         script/+foundation-script-source-units+)
      (= migrate/+foundation-script-ledger+
         script/+foundation-script-ledger+)
      (= (migrate/foundation-script-inventory)
         (script/foundation-script-inventory))]
     => [true true true])

   (fact "every portable script source has one valid disposition"
     [(migrate/migration-ledger-valid? migrate/+foundation-script-ledger+)
      (disposition-counts migrate/+foundation-script-ledger+)]
     => [true {:adapted 70 :obsolete 13 :test-vector 3}])

   (fact "the script ledger audit has no gaps, duplicates, or stale references"
     (let [audit
           (migrate/migration-ledger-audit
            migrate/+foundation-script-ledger+
            (migrate/foundation-script-inventory))]
       [(get audit :valid)
        (get audit :records)
        (get audit :source/references)
        (get audit :diagnostics)])
     => [true 86 86 []])

   (fact "the migration plan is deterministic and non-writing"
     (let [plan
           (migrate/migration-ledger-plan
            migrate/+foundation-script-ledger+
            (migrate/foundation-script-inventory))]
       [(get plan :write)
        (get plan :valid)
        (count (get plan :queue))
        (every? (fn [item]
                  (= :ready (get item :status)))
                (get plan :queue))])
     => [false true 86 true])

   (fact "all current script compatibility copies have explicit retirement gates"
     [(mapv (fn [record] (get record :surface))
            migrate/+foundation-script-compatibility-ledger+)
      (= 9
         (count
          (set
           (map (fn [record] (get record :surface))
                migrate/+foundation-script-compatibility-ledger+))))]
     => [['defspec.xt 'defn.xt 'defmacro.xt 'script 'script- '!.js '!.lua '!.py '!.pg] true])])

(pr-str (run '[tool.migrate-script-test]))
