(ns tool.migrate-audit-test
  (:use code.test)
  (:require [tool.migrate.audit :as audit]
            [tool.migrate.profile :as profile]
            [std.fs :as fs]))

(def source-text
  "(ns demo.core)\n\n(defn answer [] 42)\n")

(def test-text
  "(ns demo.core-test)\n")

(def source-runner
  (fn [argv input]
    (cond
      (= argv ["rev-parse" "r:src/demo/core.clj"])
      {:exit 0 :out "blob-source\n"}

      (= argv ["rev-parse" "r:test/demo/core_test.clj"])
      {:exit 0 :out "blob-test\n"}

      (= argv ["cat-file" "blob" "blob-source"])
      {:exit 0 :out source-text}

      (= argv ["cat-file" "blob" "blob-test"])
      {:exit 0 :out test-text}

      :else
      {:exit 0 :out ""})))

(def inventory-runner
  (fn [argv input]
    (cond
      (= argv ["ls-tree" "-r" "--name-only" "r"])
      {:exit 0 :out "src/demo/core.clj\ntest/demo/core_test.clj\n"}

      (= argv ["rev-parse" "r:src/demo/core.clj"])
      {:exit 0 :out "blob-source\n"}

      (= argv ["rev-parse" "r:test/demo/core_test.clj"])
      {:exit 0 :out "blob-test\n"}

      (= argv ["cat-file" "blob" "blob-source"])
      {:exit 0 :out source-text}

      (= argv ["cat-file" "blob" "blob-test"])
      {:exit 0 :out test-text}

      :else
      {:exit 0 :out ""})))

(def source-profile
  (assoc
   profile/+foundation-baa75a+
   :foundation/revision "r"
   :foundation/source-roots ["src"]
   :foundation/test-roots ["test"]))

^{:refer tool.migrate.audit/git-runner}
(fact "git adapters reject stdin before crossing the process boundary"
  (let [runner (audit/git-runner "/missing/git")]
    (try
      (runner ["ls-tree"] "unexpected-input")
      nil
      (catch Throwable error
        (:ex/code (ex-data error)))))
  => :tool.migrate/git-stdin-unsupported)

^{:refer tool.migrate.audit/under-root?}
(fact "root checks accept the root and descendants but not sibling prefixes"
  [(audit/under-root? "src" "src")
   (audit/under-root? "src/demo/core.clj" "src")
   (audit/under-root? "src-other/demo.clj" "src")]
  => [true true false])

^{:refer tool.migrate.audit/source-path?}
(fact "source selection requires a Clojure file beneath a configured source root"
  [(audit/source-path? source-profile "src/demo/core.clj")
   (audit/source-path? source-profile "test/demo/core_test.clj")
   (audit/source-path? source-profile "src/demo/core.hal")]
  => [true false false])

^{:refer tool.migrate.audit/test-path?}
(fact "test selection requires a Clojure file beneath a configured test root"
  [(audit/test-path? source-profile "test/demo/core_test.clj")
   (audit/test-path? source-profile "src/demo/core.clj")
   (audit/test-path? source-profile "test/demo/core_test.hal")]
  => [true false false])

^{:refer tool.migrate.audit/source-test-path}
(fact "source paths map to matching test roots for every supported source family"
  [(audit/source-test-path "src/demo/core.clj")
   (audit/source-test-path "src-java/demo/core.clj")
   (audit/source-test-path "src-lang/demo/core.clj")
   (audit/source-test-path "other/demo/core.clj")]
  => ["test/demo/core_test.clj"
      "test-java/demo/core_test.clj"
      "test-lang/demo/core_test.clj"
      nil])

^{:refer tool.migrate.audit/tree-index}
(fact "tree indexes preserve each discovered path as an exact membership key"
  (audit/tree-index ["src/a.clj" "test/a_test.clj"])
  => {"src/a.clj" true "test/a_test.clj" true})

^{:refer tool.migrate.audit/read-source-entry}
(fact "source entries retain the Git blob and parsed namespace evidence"
  (select-keys
   (audit/read-source-entry source-runner "r" "src/demo/core.clj")
   [:source/path :source/blob :namespace :public-symbols])
  => {:source/path "src/demo/core.clj"
      :source/blob "blob-source"
      :namespace "demo.core"
      :public-symbols ["answer"]})

^{:refer tool.migrate.audit/attach-paired-test}
(fact "paired tests are attached only when the derived test path is present"
  (select-keys
   (audit/attach-paired-test
    source-runner
    "r"
    {"test/demo/core_test.clj" true}
    {:source/path "src/demo/core.clj" :namespace "demo.core"})
   [:test/path :test/blob :test/namespace])
  => {:test/path "test/demo/core_test.clj"
      :test/blob "blob-test"
      :test/namespace "demo.core-test"})

^{:refer tool.migrate.audit/foundation-entries}
(fact "Foundation inventory reads source blobs and attaches their matching tests"
  (let [entries (audit/foundation-entries inventory-runner source-profile)]
    [(count entries)
     (:namespace (first entries))
     (:test/path (first entries))])
  => [1 "demo.core" "test/demo/core_test.clj"])

^{:refer tool.migrate.audit/read-text}
(fact "text reads decode the moved audit source through the filesystem adapter"
  (str/starts-with?
   (audit/read-text "lib/src/tool/migrate/audit.hal")
   "(ns tool.migrate.audit")
  => true)

^{:refer tool.migrate.audit/relative-path}
(fact "relative paths strip only an exact root prefix"
  [(audit/relative-path "core" "core/lib/src/a.hal")
   (audit/relative-path "core" "other/a.hal")]
  => ["lib/src/a.hal" "other/a.hal"])

^{:refer tool.migrate.audit/hara-target-unit}
(fact "Hara target units carry relative paths, namespaces, and public symbols"
  (select-keys
   (audit/hara-target-unit "lib" "lib/src/tool/migrate/audit.hal")
   [:target/path :target/namespace])
  => {:target/path "src/tool/migrate/audit.hal"
      :target/namespace "tool.migrate.audit"})

^{:refer tool.migrate.audit/hara-target-units}
(fact "target discovery fails closed when the supplied workspace root is invalid"
  (try
    (audit/hara-target-units ".")
    nil
    (catch Throwable error
      (:ex/code (ex-data error))))
  => :file/not-found)

^{:refer tool.migrate.audit/namespace-leaf}
(fact "namespace leaves are stable for nested and flat namespaces"
  [(audit/namespace-leaf "demo.core")
   (audit/namespace-leaf "demo")]
  => ["core" "demo"])

^{:refer tool.migrate.audit/matching-symbols}
(fact "matching symbols retain source order while intersecting target exports"
  (audit/matching-symbols
   {:public-symbols ["a" "b" "c"]}
   {:target/public-symbols ["c" "a"]})
  => ["a" "c"])

^{:refer tool.migrate.audit/candidate-state}
(fact "candidate states distinguish exact, moved, similar, and unmatched targets"
  [(audit/candidate-state
    {:namespace "demo.core" :public-symbols ["a"]}
    {:target/namespace "demo.core" :target/public-symbols ["a"]})
   (audit/candidate-state
    {:namespace "legacy.core" :public-symbols []}
    {:target/namespace "demo.core" :target/public-symbols []})
   (audit/candidate-state
    {:namespace "legacy.value" :public-symbols ["a"]}
    {:target/namespace "demo.other" :target/public-symbols ["a"]})
   (audit/candidate-state
    {:namespace "legacy.value" :public-symbols []}
    {:target/namespace "demo.other" :target/public-symbols []})]
  => [:exact :moved :similar nil])

^{:refer tool.migrate.audit/candidate-matches}
(fact "candidate matches are deterministic and sorted by target path"
  (audit/candidate-matches
   {:namespace "legacy.core" :public-symbols ["a"]}
   [{:target/path "z.hal" :target/namespace "demo.core" :target/public-symbols []}
    {:target/path "a.hal" :target/namespace "demo.core" :target/public-symbols ["a"]}])
  => [{:candidate/state :moved
       :target/path "a.hal"
       :target/namespace "demo.core"
       :matching/public-symbols ["a"]}
      {:candidate/state :moved
       :target/path "z.hal"
       :target/namespace "demo.core"
       :matching/public-symbols []}])

^{:refer tool.migrate.audit/symbol-route}
(fact "symbol routes retain pending review until a target is explicitly reviewed"
  (audit/symbol-route
   "answer"
   [{:target/path "src/demo/core.hal"
     :target/namespace "demo.core"
     :matching/public-symbols ["answer"]}])
  => {:source/symbol "answer"
      :candidate/targets [{:target/path "src/demo/core.hal"
                           :target/namespace "demo.core"
                           :target/symbol "answer"}]
      :review/disposition :pending
      :review/evidence []})

^{:refer tool.migrate.audit/attach-candidates}
(fact "candidate attachment adds both namespace candidates and per-symbol routes"
  (select-keys
   (audit/attach-candidates
    {:namespace "demo.core" :public-symbols ["answer"]}
    [{:target/path "src/demo/core.hal"
      :target/namespace "demo.core"
      :target/public-symbols ["answer"]}])
   [:candidate/matches :symbol/routes])
  => {:candidate/matches [{:candidate/state :exact
                           :target/path "src/demo/core.hal"
                           :target/namespace "demo.core"
                           :matching/public-symbols ["answer"]}]
      :symbol/routes [{:source/symbol "answer"
                       :candidate/targets [{:target/path "src/demo/core.hal"
                                            :target/namespace "demo.core"
                                            :target/symbol "answer"}]
                       :review/disposition :pending
                       :review/evidence []}]})

^{:refer tool.migrate.audit/audit}
(fact "audit rejects invalid profiles before attempting Git discovery"
  (try
    (audit/audit inventory-runner {} [])
    nil
    (catch Throwable error
      (:ex/code (ex-data error))))
  => :tool.migrate/invalid-profile)

^{:refer tool.migrate.audit/write-text}
(fact "audit text writes create parent directories and can be cleaned up"
  (let [root (deref (File/temp-directory "/"))
        path (str root "/nested/report.edn")
        _ (audit/write-text path "{:ok true}")
        output (audit/read-text path)
        _ (fs/delete root {:recursive? true :missing-ok? true})]
    [output (fs/exists? path)])
  => ["{:ok true}" false])

^{:refer tool.migrate.audit/write-audit}
(fact "write-audit fails before mutation when its Git root is missing"
  (try
    (audit/write-audit "/missing/git" "/missing/root")
    nil
    (catch Throwable error
      (:ex/code (ex-data error))))
  => :file/not-found)

(pr-str (run {:namespace "tool.migrate-audit-test"}))
