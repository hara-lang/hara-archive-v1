(ns tool.migrate-clojure-test
  (:require [tool.migrate.project :as translate]
            [tool.migrate.clojure :as clj]
            
            [work.base :as work]
            [work.flow.task.command :as command]
            [work.flow.task.command-task :as task]))

(def source
  "(ns demo.core\n  (:require [std.protocol.block :as protocol]\n            [std.block.navigate :as nav]\n            [std.lib.foundation :as foundation]\n            [clojure.tools.reader :as reader]))\n\n(definterface IThing (run []))\n(defn run-it [value] value)\n")

(def unit
  {:source/path "src/demo/core.clj"
   :source/root "src"
   :source/text source
   :source/sha256 "sha256:fixture"
   :target/root "core/lib/src"
   :target/text source
   :translation/options {:mode :review}})

(def translated
  (clj/translate-source-unit unit))

(def direct-observer
  (work/recording-observer))

(def direct-result
  (work/run
   (work/local-runtime {:observer direct-observer})
   clj/migrate-source-unit
   unit))

(def chain-observer
  (work/recording-observer))

(def chain-work
  (work/chain
   {:id :tool.migrate/clojure-fixture-chain
    :version 1}
   [(work/pure
     :tool.migrate/identity-source-unit
     (fn [value context] value))
    clj/migrate-source-unit]))

(def chain-result
  (work/run
   (work/local-runtime {:observer chain-observer})
   chain-work
   unit))

(def batch-observer
  (work/recording-observer))

(def batch-work
  (command/batch
   {:id :tool.migrate/clojure-fixture-batch
    :version 1}
   {:list
    (work/pure
     :tool.migrate/list-fixtures
     (fn [units context] units))
    :process clj/migrate-source-unit
    :batch-options {:item-key clj/source-path}}))

(def batch-result
  (work/run
   (work/local-runtime {:observer batch-observer})
   batch-work
   [unit]))

(def batch-item-result
  (:item/value (first (:results batch-result))))

(defn event-count
  [observer event]
  (count
   (filter
    (fn [record]
      (= event (:event record)))
    (work/observer-events observer))))

(def results
  [(test-check
    "source units derive deterministic HAL target paths without I/O"
    [(clj/target-path unit)
     (:target/path (clj/source-unit unit))
     (:source/path (clj/source-unit unit))
     (:translation/options (clj/source-unit unit))]
    ["core/lib/src/demo/core.hal"
     "core/lib/src/demo/core.hal"
     "src/demo/core.clj"
     {:mode :review}])

   (test-check
    "one source unit produces a pure evidence-backed edit record"
    [(select-keys translated
                  [:path :before :changed :source/changed :create :write
                   :mode :namespace :dependencies :public-symbols])
     (vec (map :rule/id (:rules/applied translated)))
     (vec (map :rule/id (:rules/matched translated)))
     (select-keys (:provenance translated)
                  [:source/path :source/sha256 :target/path
                   :translation/mode :ruleset/foundation-revision
                   :ruleset/count])]
    [{:path "core/lib/src/demo/core.hal"
      :before source
      :changed true
      :source/changed true
      :create false
      :write false
      :mode :review
      :namespace "demo.core"
      :dependencies ["clojure.tools.reader"
                     "std.block.navigate"
                     "std.block.protocol"
                     "std.foundation"]
      :public-symbols ["IThing" "run-it"]}
     [:namespace/std-protocol-block
      :namespace/std-lib-foundation]
     [:namespace/std-protocol-block
      :namespace/std-lib-foundation
      :host/clojure-tools-reader
      :form/definterface]
     {:source/path "src/demo/core.clj"
      :source/sha256 "sha256:fixture"
      :target/path "core/lib/src/demo/core.hal"
      :translation/mode :review
      :ruleset/foundation-revision
      "f909a44ad504cc6c9f44248d59ec3148261a48d7"
      :ruleset/count 117}])

   (test-check
    "lint source units report matches while preserving source bytes"
    (let [result (clj/lint-source-unit unit)]
      [(:after result)
       (:changed result)
       (:source/changed result)
       (count (:rules/applied result))
       (vec (map :type (:diagnostics result)))])
    [source
     false
     false
     0
     [:tool.migrate/match
      :tool.migrate/match
      :tool.migrate/manual
      :tool.migrate/manual]])

   (test-check
    "translated source units are idempotent"
    (let [second-unit
          (assoc
           (assoc unit :source/text (:after translated))
           :target/text (:after translated))
          second-result
          (clj/translate-source-unit second-unit)]
      [(:after translated)
       (:after second-result)
       (:changed second-result)
       (:source/changed second-result)
       (count (:rules/applied second-result))])
    [(:after translated)
     (:after translated)
     false
     false
     0])

   (test-check
    "the migration tasklet is an inspectable ordinary IWork value"
    [(task/task-work? clj/migrate-source-unit)
     (:op (work/work-spec clj/migrate-source-unit))
     (:id (work/work-spec clj/migrate-source-unit))
     (:command/schema (work/work-spec clj/migrate-source-unit))
     (:id (work/work-spec translate/migrate-source-unit))]
    [true
     :step
     :tool.migrate/clojure
     "work.flow.task.command-task/0-alpha"
     :tool.migrate/clojure])

   (test-check
    "direct, chained, and batch execution use the exact tasklet result"
    [(:item/id direct-result)
     (:status direct-result)
     (:data direct-result)
     chain-result
     batch-item-result]
    ["src/demo/core.clj -> src/demo/core.clj"
     :return
     translated
     direct-result
     direct-result])

   (test-check
    "each composition emits the task lifecycle exactly once"
    [(event-count direct-observer :task/item-started)
     (event-count direct-observer :task/item-completed)
     (event-count chain-observer :task/item-started)
     (event-count chain-observer :task/item-completed)
     (event-count batch-observer :task/item-started)
     (event-count batch-observer :task/item-completed)]
    [1 1 1 1 1 1])

   (test-check
    "invalid source suffixes remain command errors instead of writes"
    (let [result
          (work/run
           (work/local-runtime)
           clj/migrate-source-unit
           (assoc unit :source/path "src/demo/core.cljs"))]
      [(:status result)
       (string? (:error result))])
    [:error true])])

results
