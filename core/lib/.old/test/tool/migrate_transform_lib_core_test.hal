(ns tool.migrate-transform-lib-core-test
  (:use code.test)
  (:require [tool.migrate.transform.lib-core :as transform]))

(fact "ex-info migration accepts constant and per-definition codes"
  (let [source "(defn demo [value]\n  (throw (ex-info \"bad\" {:value value})))\n"]
    [(transform/migrate-ex-info source :demo/invalid-value)
     (transform/migrate-ex-info source {"demo" :demo/mapped})])
  => ["(defn demo [value]\n  (throw (ex :demo/invalid-value {:value value} :ex/message \"bad\")))\n"
      "(defn demo [value]\n  (throw (ex :demo/mapped {:value value} :ex/message \"bad\")))\n"])

(fact "ex-info migration accepts reviewed code and class contracts"
  (transform/migrate-ex-info
   "(defn demo [value]\n  (throw (ex-info \"bad\" {:value value})))\n"
   (fn [_]
     {:ex/code :greenways.ex/argument
      :ex/class :greenways.class/argument}))
  => "(defn demo [value]\n  (throw (ex :greenways.ex/argument {:value value} :ex/message \"bad\" :ex/class :greenways.class/argument)))\n")

(fact "registered Hara codes emit their standard shorthand without a redundant class"
  (transform/migrate-ex-info
   "(defn demo [] (ex-info \"missing\" {}))"
   (fn [_] {:ex/code :hara/not-found :ex/class :ex.class/not-found}))
  => "(defn demo [] (ex :not-found {} :ex/message \"missing\"))")

(fact "ex-info migration rewrites nested causes from the leaves upward"
  (transform/migrate-ex-info
   "(defn demo [value]\n  (ex-info \"outer\" {:value value} (ex-info \"inner\" {})))\n"
   (fn [context]
     (if (= "\"inner\"" (:message context))
       :demo/inner
       :demo/outer)))
  => "(defn demo [value]\n  (ex :demo/outer {:value value} :ex/message \"outer\" :ex/cause (ex :demo/inner {} :ex/message \"inner\")))\n")

(fact "the lib-core defaults cover every canonical Foundation migration"
  (set (keys transform/+lib-core-ex-info-codes+))
  => #{"comprehension-error" "dotimes" "if-let-form" "macroexpand"
       "subvec" "take-nth" "topological-sort"})

(fact "the catalog records exact location, full definition source, and review state"
  (let [source (str "(ns demo.core)\n\n"
                    "(defn demo [value]\n"
                    "  (throw (ex-info \"bad\" {:error/code :demo/bad :value value})))\n")
        record (first (transform/catalog-ex-info-source
                       source
                       "core/lib/src/demo/core.hal"
                       {:repository "demo/repo" :revision "abc"}))]
    [(select-keys record [:site/id :site/status :source/repository
                          :source/path :source/namespace :source/role
                          :legacy/error-code :review/status :ex/code :ex/class])
     (get-in record [:source/range :line])
     (get-in record [:context/definition :name])
     (str/includes? (get-in record [:context/definition :source])
                    "(defn demo")])
  => [{:site/id ["demo/repo" "core/lib/src/demo/core.hal" "demo.core/demo" 0]
       :site/status :current
       :source/repository "demo/repo"
       :source/path "core/lib/src/demo/core.hal"
       :source/namespace 'demo.core
       :source/role :production
       :legacy/error-code :demo/bad
       :review/status :pending
       :ex/code nil
       :ex/class nil}
      4
      'demo.core/demo
      true])

(fact "vendored public runtime sources are generated output"
  (transform/source-role "public/hara-runtime/std/substrate/json.hal")
  => :generated)

(fact "Foundation catalog records are pre-approved with semantic classes"
  (let [record (first
                (transform/catalog-ex-info-source
                 "(ns std.foundation) (defn subvec [] (ex-info \"bad\" {}))"
                 "core/lib/src/std/foundation.hal"
                 {:repository "hara-lang/hara" :revision "abc"}))]
    (select-keys record [:review/status :migration/batch :ex/code :ex/class
                         :expected/matches :expected/changes]))
  => {:review/status :approved
      :migration/batch :foundation
      :ex/code :foundation/invalid-subvec-bounds
      :ex/class :ex.class/argument
      :expected/matches 1
      :expected/changes 1})

(fact "Foundation rewrites add the reviewed semantic class"
  (transform/migrate-ex-info
   "(defn subvec [] (ex-info \"bad\" {}))")
  => "(defn subvec [] (ex :foundation/invalid-subvec-bounds {} :ex/message \"bad\" :ex/class :ex.class/argument))")

(fact "large sources are transformed one top-level form at a time"
  (let [source (str/join
                ""
                (repeat 25
                        "(defn demo [] (ex-info \"bad\" {}))\n"))
        migrated (transform/migrate-ex-info source :demo/bad)]
    [(str/index-of migrated "ex-info")
     (< (str/length source) (str/length migrated))])
  => [-1 true])

(pr-str (run {:namespace "tool.migrate-transform-lib-core-test"}))
