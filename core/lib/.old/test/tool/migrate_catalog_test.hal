(ns tool.migrate-catalog-test
  (:require [tool.migrate.project :as translate]
            [tool.migrate.clojure :as clj]
            ))

(def keyword-entry
  {:migration {:implemented 1 :missing 1 :total 2 :completion_percent 50}
   :symbol_routes
   [{:source_symbol "map-keys"
     :state "implemented"
     :safety "safe"
     :target_namespace "std.foundation"
     :target_symbol "map-keys"
     :message "Use Foundation."}
    {:source_symbol "tree-flatten"
     :state "missing"
     :safety "review"
     :target_namespace "std.lib.collection"
     :target_symbol "tree-flatten"
     :message "Port advanced collection helper."}]})

(def string-entry
  {"migration" {"obsolete" 1 "total" 1 "completion_percent" 100}
   "symbol_routes"
   [{"source_symbol" "enum-values"
     "state" "host-only"
     "safety" "manual"
     "message" "Java enum reflection is host-only."}]})

(def results
  [(test-check
    "catalog lookup accepts generated string keys and Hara keyword fixtures"
    [(select-keys (translate/catalog-symbol-route keyword-entry "map-keys")
                  [:state :target_namespace :target_symbol])
     (translate/catalog-migration-summary keyword-entry)
     (translate/catalog-migration-summary string-entry)]
    [{:state "implemented"
      :target_namespace "std.foundation"
      :target_symbol "map-keys"}
     {:implemented 1 :missing 1 :total 2 :completion_percent 50}
     {"obsolete" 1 "total" 1 "completion_percent" 100}])

   (test-check
    "catalog diagnostics distinguish implemented, pending, and host-only routes"
    [(vec (map :type (translate/catalog-diagnostics keyword-entry)))
     (vec (map :level (translate/catalog-diagnostics keyword-entry)))
     (select-keys (first (translate/catalog-diagnostics string-entry))
                  [:type :level :safety :migration/state])]
    [[:tool.migrate/migration-implemented
      :tool.migrate/migration-pending]
     [:info :notice]
     {:type :tool.migrate/unsupported
      :level :warning
      :safety :manual
      :migration/state :host-only}])

   (test-check
    "source-unit lint records carry migration routes and progress"
    (let [result
          (clj/lint-source-unit
           {:source/path "src/std/lib/collection.clj"
            :source/text "(ns std.lib.collection)\n(defn map-keys [f m] m)\n"
            :target/text nil
            :corpus/entry keyword-entry})]
      [(count (:migration/routes result))
       (:migration/summary result)
       (vec (map :migration/state (:diagnostics result)))])
   [2
     {:implemented 1 :missing 1 :total 2 :completion_percent 50}
     [:implemented :missing]])

   (test-check
    "reviewed semantic recipes replace mechanical output and clear blockers"
    (let [result
          (clj/translate-source-unit
           {:source/path "src/std/lib/component.clj"
            :source/text "#?(:clj (ns std.lib.component))\n(defn legacy [] nil)\n"
            :target/text nil
            :corpus/entry keyword-entry
            :translation/recipe
            {:id "std.lib.component/v1"
             :output "(ns std.lib.component)\n(defn start [component] component)\n"}})]
      [(:translation/recipe result)
       (:after result)
       (select-keys (first (:diagnostics result))
                    [:type :safety :recipe/id])])
   ["std.lib.component/v1"
     "(ns std.lib.component)\n(defn start [component] component)\n"
     {:type :tool.migrate/recipe-applied
      :safety :safe
      :recipe/id "std.lib.component/v1"}])

   (test-check
    "semantic recipes pass through native Hara dependency normalization"
    (let [result
          (clj/translate-source-unit
           {:source/path "src/demo.clj"
            :source/text "(ns demo)\n"
            :target/text nil
            :corpus/entry keyword-entry
            :translation/recipe
            {:id "demo/v1"
             :output "(ns demo (:require [std.foundation :refer :all]))\n"}})]
      [(:after result)
       (vec (map :rule/id (:rules/applied result)))])
    ["(ns demo\n  (:config {}) )\n"
     [:dependency/std-foundation-refer-all]])])

results
