(ns tool.migrate-project-test
  (:require [tool.migrate.clojure :as clj]
            [tool.migrate.project :as project]
            
            [work.base :as work]))

(def source-a
  "(ns demo.a\n  (:require [std.protocol.block :as protocol]))\n\n(defn a [] :a)\n")

(def source-b
  "(ns demo.b\n  (:require [std.lib.foundation :as foundation]))\n\n(defn b [] :b)\n")

(def source-c
  "(ns demo.c)\n\n(defn c [] :c)\n")

(def source-d
  "(ns demo.d)\n\n(defn d [] :d)\n")

(def source-manual
  (str "(ns demo.manual\n  (:require [std.protocol.block :as protocol]\n            ["
       "clojure" ".tools.reader"
       " :as reader]))\n\n(defn manual [] :manual)\n"))

(def unit-a
  {:source/path "src/demo/a.clj"
   :source/root "src"
   :source/text source-a
   :source/sha256 (str "sha:" source-a)
   :source/namespace "demo.a"
   :target/root "out"
   :target/text source-a
   :corpus/status :missing
   :dependency/rank 0
   :dependency/component ["demo.a"]
   :dependency/cycle false})

(def unit-b
  {:source/path "src/demo/b.clj"
   :source/root "src"
   :source/text source-b
   :source/sha256 (str "sha:" source-b)
   :source/namespace "demo.b"
   :target/root "out"
   :target/text source-b
   :corpus/status :missing
   :dependency/rank 1
   :dependency/component ["demo.b"]
   :dependency/cycle false})

(def unit-c
  {:source/path "src/demo/c.clj"
   :source/root "src"
   :source/text source-c
   :source/sha256 (str "sha:" source-c)
   :source/namespace "demo.c"
   :target/root "out"
   :target/text source-c
   :corpus/status :manual
   :dependency/rank 2
   :dependency/component ["demo.c" "demo.d"]
   :dependency/cycle true})

(def unit-d
  {:source/path "src/demo/d.clj"
   :source/root "src"
   :source/text source-d
   :source/sha256 (str "sha:" source-d)
   :source/namespace "demo.d"
   :target/root "out"
   :target/text source-d
   :corpus/status :manual
   :dependency/rank 2
   :dependency/component ["demo.c" "demo.d"]
   :dependency/cycle true})

(def unit-manual
  {:source/path "src/demo/manual.clj"
   :source/root "src"
   :source/text source-manual
   :source/sha256 (str "sha:" source-manual)
   :source/namespace "demo.manual"
   :target/root "out"
   :target/text source-manual
   :corpus/status :manual
   :dependency/rank 3
   :dependency/component ["demo.manual"]
   :dependency/cycle false})

(def unordered-units
  [unit-d unit-b unit-c unit-a])

(def prepared-safe
  (project/prepare-units
   {:units unordered-units
    :translation/options {:mode :safe}}))

(def safe-plan
  (project/plan
   {:units [unit-b unit-a]
    :translation/options {:mode :safe}}))

(def prepared-a
  (first
   (project/prepare-units
    {:units [unit-a]
     :translation/options {:mode :safe}})))

(def direct-a
  (clj/run-unit prepared-a))

(def bulk-a
  (first (:records
          (project/plan
           {:units [unit-a]
            :translation/options {:mode :safe}}))))

(def current-files
  {"src/demo/a.clj" source-a
   "out/demo/a.hal" source-a})

(def writes
  (atom []))

(def capabilities
  {:authorized-roots ["out"]
   :read-text
   (fn [path]
     (get current-files path))
   :sha256
   (fn [text]
     (str "sha:" text))
   :canonical-path identity
   :write-atomic
   (fn [path text]
     (do
       (swap! writes conj [path text])
       :written))})

(def write-plan
  (project/plan
   {:units [unit-a]
    :translation/options {:mode :safe}}))

(def manual-plan
  (project/plan
   {:units [unit-manual]
    :translation/options {:mode :safe}}))

(def manual-files
  {"src/demo/manual.clj" source-manual
   "out/demo/manual.hal" source-manual})

(def manual-capabilities
  (assoc
   capabilities
   :read-text
   (fn [path]
     (get manual-files path))))

(def duplicate-left
  (assoc unit-a
         :target/path "out/shared.hal"))

(def duplicate-right
  (assoc
   (assoc
    (assoc unit-a
           :source/path "src/demo/other.clj")
    :source/namespace "demo.other")
   :target/path "out/shared.hal"))

(def duplicate-plan
  (project/plan
   {:units [duplicate-left duplicate-right]
    :translation/options {:mode :safe}}))

(def duplicate-files
  {"src/demo/a.clj" source-a
   "src/demo/other.clj" source-a
   "out/shared.hal" source-a})

(def duplicate-capabilities
  (assoc
   capabilities
   :read-text
   (fn [path]
     (get duplicate-files path))))

(def mirror-plan
  (project/plan
   {:units [unit-a (assoc unit-a :target/path "out/mirror/a.hal")]
    :translation/options {:mode :safe}}))

(def results
  [(test-check
    "project preparation retains Foundation rank and SCC ordering"
    [(vec (map :source/namespace prepared-safe))
     (vec (map :dependency/rank prepared-safe))
     (:dependency/component (nth prepared-safe 2))
     (:dependency/component (nth prepared-safe 3))]
    [["demo.a" "demo.b" "demo.c" "demo.d"]
     [0 1 2 2]
     ["demo.c" "demo.d"]
     ["demo.c" "demo.d"]])

   (test-check
    "partial selectors preserve the remaining Foundation order"
    [(vec
      (map
       :source/namespace
       (project/prepare-units
        {:units unordered-units
         :selection
         {:namespaces #{"demo.b" "demo.d"}}})))
     (vec
      (map
       :source/namespace
       (project/prepare-units
        {:units unordered-units
         :selection
         {:statuses #{:missing}
          :ranks #{0 1}}})))
     (vec
      (map
       :source/namespace
       (project/prepare-units
        {:units unordered-units
         :selection
         {:rule-ids
          #{:namespace/std-protocol-block}}})))]
    [["demo.b" "demo.d"]
     ["demo.a" "demo.b"]
     ["demo.a"]])

   (test-check
    "the bulk task is declared around the exact atomic tasklet"
    [(:task/tasklet
      (work/work-spec project/migration-work))
     (= project/task-work
        project/migration-work)
     (:data direct-a)
     (:data bulk-a)]
    ['tool.migrate.clojure/migrate-source-unit
     true
     (:data direct-a)
     (:data direct-a)])

   (test-check
    "plans are dry-run edit packages with rule and rank reports"
    [(select-keys
      safe-plan
      [:operation :write])
     (select-keys
      (:summary safe-plan)
      [:selected :processed :changed :unchanged
       :matched/safe :matched/review :matched/manual
       :applied :warnings :errors])
     (get-in safe-plan
             [:report :by/dependency-rank])
     (get-in safe-plan
             [:report :rules/matched])
     (get-in safe-plan
             [:report :rules/applied])
     (get-in safe-plan
             [:report :next-unblocked])]
    [{:operation :tool.migrate/project
      :write false}
     {:selected 2
      :processed 2
      :changed 1
      :unchanged 1
      :matched/safe 1
      :matched/review 1
      :matched/manual 0
      :applied 1
      :warnings 0
      :errors 0}
     {0 ["demo.a"]
      1 ["demo.b"]}
     {:namespace/std-protocol-block 1
      :namespace/std-lib-foundation 1}
     {:namespace/std-protocol-block 1}
     ["demo.a"]])

   (test-check
    "cycles remain visible as grouped report entries"
    (get-in
     (project/plan
      {:units unordered-units})
     [:report :cycles])
    {"demo.c|demo.d"
     ["demo.c" "demo.d"]})

   (test-check
    "one bad source unit is recorded without cancelling the batch"
    (let [bad
          (assoc
           (assoc unit-a
                  :source/path "src/demo/bad.cljs")
           :source/namespace "demo.bad")
          plan
          (project/plan
           {:units [unit-b bad]
            :translation/options {:mode :safe}})]
      [(count (:records plan))
       (count
        (filter
         (fn [record]
           (= :error (:status record)))
         (:records plan)))
       (count
        (filter
         (fn [record]
           (= :return (:status record)))
         (:records plan)))
       (select-keys
        (:summary plan)
        [:selected :processed :errors])])
    [2
     1
     1
     {:selected 2
      :processed 2
      :errors 1}])

   (test-check
    "valid write plans check staleness and use the atomic host writer"
    (let [validation
          (project/validate-write-plan
           write-plan capabilities)
          output
          (project/apply-plan
           write-plan capabilities)]
      [(:valid? validation)
       (:write validation)
       (:count output)
       (deref writes)])
    [true
     false
     1
     [["out/demo/a.hal"
       (:after (first (:edits write-plan)))]]])

   (test-check
    "stale sources fail validation before any write"
    (let [stale-capabilities
          (assoc
           capabilities
           :read-text
           (fn [path]
             (if (= path "src/demo/a.clj")
               "changed"
               (get current-files path))))
          validation
          (project/validate-write-plan
           write-plan stale-capabilities)]
      [(:valid? validation)
       (vec (map :type (:errors validation)))])
    [false
     [:tool.migrate/stale-source]])

   (test-check
    "manual diagnostics block changed edits unless explicitly allowed"
    [(vec
      (map
       :type
       (:errors
        (project/validate-write-plan
         manual-plan manual-capabilities))))
     (:valid?
      (project/validate-write-plan
       manual-plan
       manual-capabilities
       {:allow-manual? true}))]
    [[:tool.migrate/blocked-diagnostic]
     true])

   (test-check
    "one source can own distinct canonical and mirror work items"
    [(count (:records mirror-plan))
     (count (set (map :item/id (:records mirror-plan))))
     (set (map :target/path (:edits mirror-plan)))]
    [2 2 #{"out/demo/a.hal" "out/mirror/a.hal"}])

   (test-check
    "duplicate target ownership is rejected before writes"
    (let [validation
          (project/validate-write-plan
           duplicate-plan
           duplicate-capabilities)]
      [(:valid? validation)
       (vec (map :type (:errors validation)))])
    [false
     [:tool.migrate/duplicate-target]])])

results
