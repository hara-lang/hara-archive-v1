(ns tool.migrate-git-test
  (:use code.test)
  (:require [tool.migrate.git :as git]
            [tool.migrate.profile :as profile]))

(defn fixture-runner
  [calls]
  (fn [argv input]
    (swap! calls conj [argv input])
    (cond
      (= argv ["rev-parse" "baa75aabd6a879753d7d5cb07271b1448271e7cb^{commit}"])
      {:exit 0 :stdout "baa75aabd6a879753d7d5cb07271b1448271e7cb\n"}

      (= argv ["rev-parse" "baa75aabd6a879753d7d5cb07271b1448271e7cb^{tree}"])
      {:exit 0 :stdout "26d494f60c4970df56eba8ac40f92affeee4e159\n"}

      (= argv ["ls-tree" "-r" "--name-only"
               "baa75aabd6a879753d7d5cb07271b1448271e7cb"])
      {:exit 0 :stdout "src/a.clj\nsrc/b.clj\n"}

      (= argv ["rev-parse"
               "baa75aabd6a879753d7d5cb07271b1448271e7cb:src/a.clj"])
      {:exit 0 :stdout "1111111111111111111111111111111111111111\n"}

      (= argv ["cat-file" "blob"
               "1111111111111111111111111111111111111111"])
      {:exit 0 :stdout "(ns a)\n"}

      (= argv ["hash-object" "--stdin"])
      {:exit 0 :stdout "2222222222222222222222222222222222222222\n"}

      :else
      {:exit 1 :stderr (str "unexpected argv " argv)})))

(fact "Foundation Git access records exact object-only argv operations"
  (let [calls (atom [])
        runner (fixture-runner calls)]
    [(git/snapshot runner profile/+foundation-baa75a+)
     (git/list-tree runner (:foundation/revision profile/+foundation-baa75a+))
     (git/read-blob runner
                    (:foundation/revision profile/+foundation-baa75a+)
                    "src/a.clj")
     (git/hash-source runner "(ns a)\n")
     (deref calls)])
  => [{:repository "zcaudate-xyz/foundation-base"
       :revision "baa75aabd6a879753d7d5cb07271b1448271e7cb"
       :tree "26d494f60c4970df56eba8ac40f92affeee4e159"}
      ["src/a.clj" "src/b.clj"]
      "(ns a)\n"
      "2222222222222222222222222222222222222222"
      [[["rev-parse" "baa75aabd6a879753d7d5cb07271b1448271e7cb^{commit}"] nil]
       [["rev-parse" "baa75aabd6a879753d7d5cb07271b1448271e7cb^{tree}"] nil]
       [["ls-tree" "-r" "--name-only"
         "baa75aabd6a879753d7d5cb07271b1448271e7cb"] nil]
       [["rev-parse"
         "baa75aabd6a879753d7d5cb07271b1448271e7cb:src/a.clj"] nil]
       [["cat-file" "blob"
         "1111111111111111111111111111111111111111"] nil]
       [["hash-object" "--stdin"] "(ns a)\n"]]])

(fact "checkout, reset, fetch, and writing hash operations are rejected"
  (map
   (fn [argv]
     (try
       (git/assert-read-only argv)
       :not-thrown
       (catch Throwable error
         (:ex/code (ex-data error)))))
   [["checkout" "main"]
    ["reset" "--hard"]
    ["fetch" "origin"]
    ["hash-object" "-w" "file"]])
  => [:tool.migrate/git-command-rejected
      :tool.migrate/git-command-rejected
      :tool.migrate/git-command-rejected
      :tool.migrate/git-command-rejected])

(pr-str (run {:namespace "tool.migrate-git-test"}))
