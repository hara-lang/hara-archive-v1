(ns tool.migrate-namespace-shape-test
  (:require [tool.migrate.project :as translate]))

(defn read-text
  [path]
  (str/decode-utf8 (deref (File/read path))))

(def expected-navigation-shape
  (Edn/read
   (read-text
    "spec/code-migrate/std-block-navigation-shape.edn")))

(def actual-navigation-source
  (read-text "lib/src/code/framework/navigation.hal"))

(def ownership-check
  (translate/namespace-shape-check
   expected-navigation-shape
   actual-navigation-source
   {:namespace-map
    {(:namespace expected-navigation-shape)
     (:target/namespace expected-navigation-shape)}
    :allow-extra-public-symbols? true}))

(def foundation-source
  "(ns demo.block
  (:require [std.protocol.block :as protocol]
            [std.block.navigate :as nav]))

(defn move [navigator] (nav/right navigator))
")

(def hara-target
  "(ns demo.block
  (:require [std.block.protocol :as protocol]
            [std.block.navigate :as nav]))

(defn move [navigator] (nav/right navigator))
")

(def translation-check
  (translate/translated-namespace-shape-check
   foundation-source
   hara-target
   {:translation/options {:mode :review}}))

(def legacy-source-exists?
  (deref
   (File/exists?
    "lib/src/std/block/navigation.hal")))

(def translated-output
  (get-in translation-check [:translation :output]))

(def consumer-shapes
  [(translate/namespace-shape
    (read-text "lib/src/tool/migrate/clojure.hal"))
   (translate/namespace-shape
    (read-text "lib/src/tool/migrate/rule.hal"))])

(defn includes-value?
  [values expected]
  (not
   (empty?
    (filter
     (fn [value]
       (= expected value))
     values))))

(def results
  [(test-check
    "tool.migrate.project confirms the real translator-owned namespace shape"
    [(:conformant? ownership-check)
     (:namespace ownership-check)
     (:dependencies ownership-check)
     (get-in ownership-check [:public-symbols :missing])
     (get-in ownership-check [:public-symbols :match?])]
    [true
     {:expected "code.framework.navigation"
      :actual "code.framework.navigation"
      :match? true}
     {:missing [] :unexpected [] :match? true}
     []
     true])

   (test-check
    "tool.migrate.project preserves the Foundation navigator namespace"
    [(:conformant? translation-check)
     (get-in translation-check [:translation :rules/applied])
     (str/includes? translated-output
                    "[std.block.navigate :as nav]")
     (str/includes? translated-output
                    "[std.block.protocol :as protocol]")
     (str/includes? translated-output "std.block.navigation")]
    [true
     [:namespace/std-protocol-block]
     true
     true
     false])

   (test-check
    "translator consumers depend on code.framework.navigation"
    [(vec (map :namespace consumer-shapes))
     (vec
      (map
       (fn [shape]
         (includes-value? (:dependencies shape)
                          "code.framework.navigation"))
       consumer-shapes))
     (vec
      (map
       (fn [shape]
         (includes-value? (:dependencies shape)
                          "std.block.navigation"))
       consumer-shapes))]
    [["tool.migrate.clojure" "tool.migrate.rule"]
     [true true]
     [false false]])

   (test-check
    "the retired std.block.navigation source is absent"
    legacy-source-exists?
    false)

   (test-check
    "namespace shapes exclude private definition forms"
    (:public-symbols
     (translate/namespace-shape
      "(ns demo.private)\n(defn- hidden [] true)\n(defn visible [] true)\n"))
    ["visible"])

   (test-check
    "shape comparison reports missing public bindings"
    (let [check
          (translate/namespace-shape-check
           {:namespace "demo.shape"
            :dependencies []
            :public-symbols ["required"]}
           "(ns demo.shape)\n")]
      [(:conformant? check)
       (get-in check [:public-symbols :missing])])
    [false ["required"]])])

results
