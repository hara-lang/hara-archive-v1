(ns tool.migrate-conformance-test
  (:use code.test)
  (:require [tool.migrate.conformance :as conformance]
            [std.fs :as fs]
            [work.base :as work]
            [work.flow.task.command-task :as task]))

(def descriptor (first conformance/+initial-families+))

(def baseline conformance/+baseline+)

(def test-paths
  (str
   "test/std/lib/zip_test.clj\n"
   "test/std/lib/zip_test.clj.bak\n"
   "src/std/lib/zip.clj\n"))

(defn runner
  [argv input]
  {:exit 0
   :out test-paths
   :err ""})

(def context-descriptor
  (first (filter #(= :std_lib_context (:family/id %))
                 conformance/+initial-families+)))

(def format-descriptor
  (first (filter #(= :std_lib_format (:family/id %))
                 conformance/+initial-families+)))

^{:refer tool.migrate.conformance/family-descriptor}
(fact "family descriptors retain the extraction boundary and registry output"
  (select-keys descriptor
               [:family/id :source/test-count :target/namespace :output/path
                :target/metadata-path :review/status])
  => {:family/id :std_lib_zip
      :source/test-count 1
      :target/namespace "std.lib.zip"
      :output/path "std_lib_zip/conformance.edn"
      :target/metadata-path "std_lib_zip/metadata.edn"
      :review/status :unreviewed})

^{:refer tool.migrate.conformance/+initial-families+}
(fact "std.lib.context mappings preserve the current split ownership"
  [(:source/test-count context-descriptor)
   (:source/test-prefixes context-descriptor)
   (mapv (fn [mapping]
           [(:source/namespace mapping)
            (:target/namespaces mapping)
            (:status mapping)])
         (:mapping context-descriptor))]
  => [4
      ["test/std/lib/context" "test/std/lib/resource_test.clj"]
      [["std.lib.context"
        ["std.foundation" "std.lib.context.definition"
         "std.lib.context.registry" "std.lib.context.space"]
        :split]
       ["std.lib.resource" ["std.lib.context.resource"] :renamed]]])

^{:refer tool.migrate.conformance/+initial-families+}
(fact "std.lib.format maps each Foundation namespace to its new owner"
  [(:source/test-count format-descriptor)
   (:target/namespace format-descriptor)
   (:output/path format-descriptor)
   (mapv (fn [mapping]
           [(:source/namespace mapping)
            (:target/namespaces mapping)
            (:status mapping)])
         (:mapping format-descriptor))]
  => [7
      "std.lib.format"
      "std_lib_format/conformance.edn"
      [["std.print.ansi" ["std.lib.format.ansi"] :renamed]
       ["std.string.prose" ["std.lib.format.prose"] :renamed]
       ["std.string.plural" ["std.lib.format.plural"] :renamed]
       ["std.print.format.chart" ["std.lib.format.chart"] :renamed]
       ["std.print.progress" ["std.lib.format.progress"] :renamed]
       ["std.lib.version" ["std.lib.format.version"] :renamed]
       ["std.text.diff" ["std.lib.format.diff"] :renamed]]])

^{:refer tool.migrate.conformance/path-selected?}
(fact "test selection is deterministic at an exact path or prefix"
  [(conformance/path-selected? descriptor "test/std/lib/zip_test.clj")
   (conformance/path-selected? descriptor "test/std/lib/zip_test.clj.bak")]
  => [true false])

^{:refer tool.migrate.conformance/mapping-valid?}
(fact "namespace mappings require an explicit supported disposition"
  [(conformance/mapping-valid?
    {:source/namespace "std.lib.zip"
     :target/namespaces ["std.lib.zip"]
     :status :retained})
   (conformance/mapping-valid?
    {:source/namespace "std.lib.zip"
     :target/namespaces ["std.lib.zip"]
     :status :contract})]
  => [true false])

^{:refer tool.migrate.conformance/descriptor-errors}
(fact "invalid descriptors report their mapping errors"
  (map :type
       (conformance/descriptor-errors
        {:family/id :broken
         :family/name "broken"
         :source/test-prefixes []
         :source/test-count 0
         :target/namespace "broken"
         :mapping [{:source/namespace "broken"
                    :target/namespaces []
                    :status :contract}]
         :output/path "conformance/broken.edn"
         :review/status :unreviewed}))
  => [:conformance/invalid-namespace-mapping])

^{:refer tool.migrate.conformance/plan-errors}
(fact "plan validation rejects duplicate families and output paths"
  (set
   (map :type
        (conformance/plan-errors
         conformance/+baseline+
         [(assoc descriptor :output/path "same.edn")
          (assoc descriptor :family/id :other :output/path "same.edn")])))
  => #{:conformance/duplicate-output-path})

^{:refer tool.migrate.conformance/generation-plan}
(fact "generation plans sort families and expose validity"
  (let [plan (conformance/generation-plan
              conformance/+baseline+
              [(assoc descriptor
                      :family/id :z
                      :family/name "z"
                      :output/path "z.edn")
               (assoc descriptor
                      :family/id :a
                      :family/name "a"
                      :output/path "a.edn")])]
    [(:valid? plan) (mapv :family/name (:families plan))])
  => [true ["a" "z"]])

^{:refer tool.migrate.conformance/initial-plan}
(fact "the initial plan contains the dependency-ordered family waves"
  [(:valid? (conformance/initial-plan))
   (mapv :family/id (:families (conformance/initial-plan)))]
  => [true [:code_query :code_test :lang_common :std_block :std_fs
            :std_lib_context :std_lib_encode :std_lib_format :std_lib_zip]])

^{:refer tool.migrate.conformance/output-path}
(fact "corpora resolve beneath the hara-specs-registry output root"
  (conformance/output-path conformance/+baseline+ descriptor)
  => "../hara-specs-registry/01-lang/005-foundation-annex/draft/conformance/libraries/std_lib_zip/conformance.edn")

^{:refer tool.migrate.conformance/metadata-path}
(fact "family metadata uses the same full-path registry family"
  (conformance/metadata-path descriptor)
  => "std_lib_zip/metadata.edn")

^{:refer tool.migrate.conformance/metadata-document}
(fact "metadata documents are read from the registry family root"
  (let [root (deref (File/temp-directory "/"))
        path (File/resolve root "std_lib_zip/metadata.edn")
        _ (deref (File/write path
                             (str/encode-utf8
                              "{:family/id :std_lib_zip :target/test-paths [\"lib/test/std/lib/zip_test.hal\"]}")
                             {:mode :create :parents? true}))
        document (conformance/metadata-document root descriptor)
        _ (fs/delete root {:recursive? true :missing-ok? false})]
    document)
  => {:family/id :std_lib_zip
      :target/test-paths ["lib/test/std/lib/zip_test.hal"]})

^{:refer tool.migrate.conformance/target-test-paths}
(fact "target test paths come only from family metadata"
  (let [root (deref (File/temp-directory "/"))
        path (File/resolve root "std_lib_zip/metadata.edn")
        _ (deref (File/write path
                             (str/encode-utf8
                              "{:target/test-paths [\"one_test.hal\" \"two_test.hal\"]}")
                             {:mode :create :parents? true}))
        paths (conformance/target-test-paths root descriptor)
        _ (fs/delete root {:recursive? true :missing-ok? false})]
    paths)
  => ["one_test.hal" "two_test.hal"])

^{:refer tool.migrate.conformance/portable-value?}
(fact "portable evidence accepts EDN values but rejects opaque callables"
  [(conformance/portable-value? {:a [1 :b "c"]})
   (conformance/portable-value? (fn [] 1))]
  => [true false])

^{:refer tool.migrate.conformance/normalize-value}
(fact "normalization marks missing and opaque expectations for manual review"
  [(conformance/normalize-value {})
   (conformance/normalize-value {:foundation/expected (fn [] 1)})]
  => [{:status :manual-review :expected nil :reason :missing-expectation}
      {:status :manual-review :expected nil :reason :non-portable-value}])

^{:refer tool.migrate.conformance/classify-form}
(fact "form classification separates portable, runner, and host-only evidence"
  [(conformance/classify-form
    {:form/type :fact :foundation/expected false})
   (conformance/classify-form {:form/type :test-run})
   (conformance/classify-form {:form/type :host-only})]
  => [:portable :manual-review :skipped])

^{:refer tool.migrate.conformance/extraction-observation}
(fact "extraction observations retain explicit runner and host-only outcomes"
  [(select-keys
    (conformance/extraction-observation
     {:form/type :fact
      :source/path "test/synthetic/foundation_test.clj"
      :foundation/expected false})
    [:status :foundation/expected])
   (select-keys
    (conformance/extraction-observation
     {:form/type :test-run
      :source/path "test/synthetic/foundation_test.clj"})
    [:status :reason])
   (select-keys
    (conformance/extraction-observation
     {:form/type :host-only
      :source/path "test/synthetic/foundation_test.clj"})
    [:status :reason])]
  => [{:status :emitted :foundation/expected false}
      {:status :manual-review :reason :runner-boundary}
      {:status :skipped :reason :host-only}])

^{:refer tool.migrate.conformance/stable-id}
(fact "fixture identities include family, source path, and form index"
  (conformance/stable-id descriptor
                         {:source/path "test/std/lib/zip_test.clj"
                          :source/form-index 4})
  => "std_lib_zip/test/std/lib/zip_test.clj#4")

^{:refer tool.migrate.conformance/fixture}
(fact "fixtures preserve foundation provenance separately from review state"
  (select-keys
   (conformance/fixture
    conformance/+baseline+
    descriptor
    {:source/path "test/std/lib/zip_test.clj"
     :source/namespace "std.lib.zip-test"
     :source/form-index 0
     :target/expression "(zipper? 1)"
     :foundation/expected false})
   [:id :source :target :foundation :review])
  => {:id "std_lib_zip/test/std/lib/zip_test.clj#0"
      :source {:repository "zcaudate-xyz/foundation-base"
               :revision conformance/+foundation-revision+
               :tree conformance/+foundation-tree+
               :path "test/std/lib/zip_test.clj"
               :namespace "std.lib.zip-test"
               :location {:form-index 0}}
      :target {:namespace "std.lib.zip"
               :expression "(zipper? 1)"}
      :foundation {:expected false
                   :expected/present true
                   :status :emitted
                   :reason nil
                   :source-expression nil}
      :review {:status :unreviewed}})

^{:refer tool.migrate.conformance/observation-result}
(fact "skipped observations are accounted for without emitting a fixture"
  [(conformance/observation-result
    conformance/+baseline+
    descriptor
    {:status :skipped
     :source/path "test/std/lib/zip_test.clj"
     :reason :host-only})
   (get-in
    (conformance/observation-result
     conformance/+baseline+
     descriptor
     {:status :manual-review
      :source/path "test/std/lib/zip_test.clj"
      :source/namespace "std.lib.zip-test"
      :target/expression "(zipper? 1)"
      :foundation/expected false
      :reason :host-only})
    [:fixture :foundation :status])]
  => [{:status :skipped
       :source/path "test/std/lib/zip_test.clj"
       :reason :host-only}
      :manual-review])

^{:refer tool.migrate.conformance/accounting}
(fact "accounting proves every observation has one disposition"
  (conformance/accounting
   [{:status :emitted} {:status :skipped} {:status :manual-review}])
  => {:discovered 3 :emitted 1 :skipped 1 :manual-review 1 :complete? true})

^{:refer tool.migrate.conformance/validate-fixture}
(fact "fixture validation accepts a complete portable source-evidence case"
  (empty?
   (conformance/validate-fixture
    (conformance/fixture
     conformance/+baseline+
     descriptor
     {:source/path "test/std/lib/zip_test.clj"
      :source/namespace "std.lib.zip-test"
      :target/expression "(zipper? 1)"
      :foundation/expected false})))
  => true)

^{:refer tool.migrate.conformance/validate-document}
(fact "document validation rejects the old normative contract terminology"
  (first
   (map :type
        (conformance/validate-document
         {:document/type :hara-foundation-conformance
          :document/version 1
          :corpus/status :unreviewed-source-evidence
          :foundation/revision conformance/+foundation-revision+
          :foundation/tree conformance/+foundation-tree+
          :hara/revision conformance/+hara-revision+
          :contract true
          :cases []
          :accounting {:discovered 0 :emitted 0 :skipped 0
                       :manual-review 0 :complete? true}})))
  => :conformance/invalid-document-header)

^{:refer tool.migrate.conformance/corpus-document}
(fact "corpus documents keep foundation evidence and explicit unreviewed status"
  (let [document
        (conformance/corpus-document
         conformance/+baseline+
         descriptor
         [{:source/path "test/std/lib/zip_test.clj"
           :source/namespace "std.lib.zip-test"
           :target/expression "(zipper? 1)"
           :foundation/expected false}])]
    [(:corpus/status document)
     (:validation/errors document)
     (count (:cases document))])
  => [:unreviewed-source-evidence [] 1])

^{:refer tool.migrate.conformance/corpus-source}
(fact "corpus rendering is deterministic and excludes validation bookkeeping"
  (let [document
        (conformance/corpus-document
         conformance/+baseline+
         descriptor
         [{:source/path "test/std/lib/zip_test.clj"
           :source/namespace "std.lib.zip-test"
           :target/expression "(zipper? 1)"
           :foundation/expected false}])
        source (conformance/corpus-source document)]
    [(str/includes? source ":unreviewed-source-evidence")
     (str/includes? source ":validation/errors")
     (= source (conformance/corpus-source document))])
  => [true false true])

^{:refer tool.migrate.conformance/generation-report}
(fact "generation reports carry accounting, provenance, and destination"
  (let [result
        (conformance/generate
         conformance/+baseline+
         descriptor
         [{:source/path "test/std/lib/zip_test.clj"
           :source/namespace "std.lib.zip-test"
           :target/expression "(zipper? 1)"
           :foundation/expected false}])]
    (select-keys (:report result) [:source/revision :hara/revision :output/path :observation-count]))
  => {:source/revision conformance/+foundation-revision+
      :hara/revision conformance/+hara-revision+
      :output/path "../hara-specs-registry/01-lang/005-foundation-annex/draft/conformance/libraries/std_lib_zip/conformance.edn"
      :observation-count 1})

^{:refer tool.migrate.conformance/generate}
(fact "generation returns a valid source-evidence artifact without a conformance claim"
  (let [result
        (conformance/generate
         conformance/+baseline+
         descriptor
         [{:source/path "test/std/lib/zip_test.clj"
           :source/namespace "std.lib.zip-test"
           :target/expression "(zipper? 1)"
           :foundation/expected false}])]
    [(:valid? result)
     (str/includes? (:source result) ":unreviewed-source-evidence")
     (str/includes? (:source result) ":contract")])
  => [true true false])

^{:refer tool.migrate.conformance/origin-path}
(fact "origin documents sit beside contracts under the full-path family"
  (conformance/origin-path conformance/+baseline+ descriptor)
  => "../hara-specs-registry/01-lang/005-foundation-annex/draft/conformance/libraries/std_lib_zip/origin.edn")

^{:refer tool.migrate.conformance/origin-document}
(fact "origin documents preserve Foundation namespace provenance"
  (select-keys
   (conformance/origin-document conformance/+baseline+ descriptor)
   [:document/type :origin/family :origin/source])
  => {:document/type :foundation-library-origin
      :origin/family :std_lib_zip
      :origin/source {:repository "zcaudate-xyz/foundation-base"
                      :revision conformance/+foundation-revision+
                      :tree conformance/+foundation-tree+}})

^{:refer tool.migrate.conformance/contract-document}
(fact "contracts declare the reviewed surface and all three runtime adapters"
  (let [document (conformance/contract-document
                  conformance/+baseline+
                  descriptor
                  [])]
    [(:conformance/family document)
     (:contract/status document)
     (:target/metadata-path document)
     (:conformance/cases document)
     (set (keys (:runtime/status document)))])
  => [:std_lib_zip :reviewed
      "std_lib_zip/metadata.edn"
      []
      #{:rust :jvm :wasm}])

^{:refer tool.migrate.conformance/validate-contract-document}
(fact "contract validation fails closed when a runtime adapter is missing"
  (first
   (conformance/validate-contract-document
    (assoc
     (conformance/contract-document
      conformance/+baseline+
      descriptor
      [])
     :runtime/status
     {:rust :pending :jvm :pending})))
  => {:type :conformance/missing-runtime-contracts})

^{:refer tool.migrate.conformance/registry-entry}
(fact "registry entries expose only full-path origin and contract locators"
  (conformance/registry-entry descriptor)
  => {:family/id :std_lib_zip
      :family/path "std_lib_zip"
      :family/origin "std_lib_zip/origin.edn"
      :family/metadata "std_lib_zip/metadata.edn"
      :family/contract "std_lib_zip/conformance.edn"})

^{:refer tool.migrate.conformance/registry-document}
(fact "the registry document contains one shared command per runtime"
  (let [document (conformance/registry-document
                  conformance/+baseline+
                  [descriptor])]
    [(get-in document [:conformance/runtimes :rust :runtime/adapter])
     (get-in document [:conformance/runtimes :rust :runtime/report-path])
     (get-in document [:conformance/runtimes :jvm :runtime/adapter])
     (get-in document [:conformance/runtimes :jvm :runtime/report-path])
     (get-in document [:conformance/runtimes :wasm :runtime/adapter])
     (get-in document [:conformance/runtimes :wasm :runtime/report-path])
     (get-in document [:conformance/families 0 :family/path])])
  => [:registry-hara-test "core/target/conformance/libraries/rust.edn"
      :registry-jvm-hara-test "core/target/conformance/libraries/jvm.edn"
      :registry-wasm-hara-test "core/target/conformance/libraries/wasm.edn"
      "std_lib_zip"])

^{:refer tool.migrate.conformance/foundation-test-paths}
(fact "foundation discovery selects only the pinned family test paths"
  (conformance/foundation-test-paths runner
                                      (:foundation/revision baseline)
                                      descriptor)
  => ["test/std/lib/zip_test.clj"])

^{:refer tool.migrate.conformance/inventory-family}
(fact "family inventory records exact paths and the expected count"
  (select-keys
   (conformance/inventory-family runner
                                 (:foundation/revision baseline)
                                 descriptor)
   [:source/test-count :source/discovered-count
    :source/discovered-tests :source/inventory-complete?])
  => {:source/test-count 1
      :source/discovered-count 1
      :source/discovered-tests ["test/std/lib/zip_test.clj"]
      :source/inventory-complete? true})

^{:refer tool.migrate.conformance/baseline-inventory}
(fact "baseline inventory preserves the pinned revision and complete family set"
  (let [inventory (conformance/baseline-inventory runner baseline)]
    [(:inventory/complete? inventory)
     (:foundation/revision (:baseline inventory))
     (count (:families inventory))])
  => [false conformance/+foundation-revision+ 9])

^{:refer tool.migrate.conformance/inventory-errors}
(fact "inventory drift identifies every family whose discovered count changed"
  (let [errors
        (conformance/inventory-errors
         (conformance/baseline-inventory runner baseline))]
    [(count errors)
     (set (map :type errors))
     (set (map :family/id errors))])
  => [8
      #{:conformance/source-inventory-drift}
      #{:code_query :code_test :lang_common :std_block :std_fs
        :std_lib_context :std_lib_encode :std_lib_format}])

^{:refer tool.migrate.conformance/inventory-report}
(fact "inventory reports expose discovered and expected counts without contract claims"
  (let [report
        (conformance/inventory-report
         (conformance/baseline-inventory runner baseline))]
    [(= :hara-foundation-inventory (:document/type report))
     (str/includes? (pr-str report) ":contract")
     (select-keys (first (:families report))
                  [:source/test-count :source/discovered-count])
     (count (:errors report))])
  => [true false {:source/test-count 9 :source/discovered-count 0} 8])

^{:refer tool.migrate.conformance/inventory-source}
(fact "inventory output is deterministic EDN"
  (let [report
        (conformance/inventory-report
         (conformance/baseline-inventory runner baseline))
        source (conformance/inventory-source report)]
    [(str/starts-with? source "{")
     (= source (conformance/inventory-source report))])
  => [true true])

^{:refer tool.migrate.conformance/inventory-family-task}
(fact "inventory family is exposed as a work.flow.task tasklet"
  [(task/task-work? conformance/inventory-family-task)
   (:command/schema (work/work-spec conformance/inventory-family-task))
   (:status (work/run conformance/inventory-family-task
                       (assoc descriptor
                              :conformance/runner runner
                              :foundation/revision (:foundation/revision baseline))))]
  => [true "work.flow.task.command-task/0-alpha" :return])

(pr-str (run {:namespace "tool.migrate-conformance-test"}))
