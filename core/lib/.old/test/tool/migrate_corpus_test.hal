(ns tool.migrate-corpus-test
  (:use code.test)
  (:require [tool.migrate.corpus :as corpus]
            [tool.migrate.profile :as profile]))

(def blob-a "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(def blob-b "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
(def blob-c "cccccccccccccccccccccccccccccccccccccccc")
(def blob-d "dddddddddddddddddddddddddddddddddddddddd")

(def entries
  [{:namespace "a"
    :source/path "src/a.clj"
    :source/blob blob-a
    :dependencies ["clojure.string"]
    :public-symbols ["a"]
    :candidate/matches []
    :review/disposition :pending
    :review/evidence []
    :dry-run/status :not-planned}
   {:namespace "b"
    :source/path "src/b.clj"
    :source/blob blob-b
    :dependencies ["a"]
    :public-symbols ["b"]
    :candidate/matches []
    :review/disposition :pending
    :review/evidence []
    :dry-run/status :not-planned}
   {:namespace "c"
    :source/path "src/c.clj"
    :source/blob blob-c
    :dependencies ["d"]
    :public-symbols ["c"]
    :candidate/matches []
    :review/disposition :pending
    :review/evidence []
    :dry-run/status :not-planned}
   {:namespace "d"
    :source/path "src/d.clj"
    :source/blob blob-d
    :dependencies ["c"]
    :public-symbols ["d"]
    :candidate/matches []
    :review/disposition :pending
    :review/evidence []
    :dry-run/status :not-planned}])

(fact "Foundation source parsing uses structural namespace and public-symbol analysis"
  (select-keys
   (corpus/source-entry
    "src/demo.clj"
    blob-a
    "(ns demo.core (:require [clojure.string :as str] [demo.dep :refer [x]]))\n(defn public [] x)\n(defn- private [] nil)\n")
   [:namespace :dependencies :public-symbols
    :review/disposition :candidate/matches])
  => {:namespace "demo.core"
      :dependencies ["clojure.string" "demo.dep"]
      :public-symbols ["public"]
      :review/disposition :pending
      :candidate/matches []})

^{:refer tool.migrate.corpus/duplicate-values}
(fact "duplicate values are returned in stable sorted order"
  [(corpus/duplicate-values [:b :a :b :c :a])
   (corpus/duplicate-values [:c :b :a])]
  => [[:a :b] []])

(fact "external dependencies precede zero-based Foundation SCC ranks"
  (let [document
        (corpus/corpus-document
         profile/+foundation-baa75a+
         entries)]
    [(map
      (fn [route]
        [(:external/namespace route)
         (:dependency/rank route)])
      (:external/routes document))
     (map
      (fn [entry]
        [(:namespace entry)
         (:dependency/rank entry)
         (:dependency/component entry)
         (:dependency/cycle entry)])
      (:namespaces document))
     (:next/review document)
     (:next/unblocked-migration document)])
  => [[["clojure.string" -1]]
      [["a" 0 ["a"] false]
       ["c" 0 ["c" "d"] true]
       ["d" 0 ["c" "d"] true]
       ["b" 1 ["b"] false]]
      ["a" "c" "d"]
      []])

(fact "pending candidates never count as reviewed"
  [(corpus/reviewed?
    profile/+foundation-baa75a+
    (first entries))
   (corpus/reviewed?
    profile/+foundation-baa75a+
    (assoc
     (first entries)
     :review/disposition :portable-substitute
     :review/evidence
     [{:foundation/path "src/a.clj"
       :foundation/blob blob-a
       :hara/path "core/lib/src/a.hal"}]))]
  => [false true])

(fact "reviewed dispositions require exact source and Hara evidence"
  (map :type
       (corpus/validate-entries
        profile/+foundation-baa75a+
        [(assoc
          (first entries)
          :review/disposition :portable-substitute)]))
  => [:tool.migrate/review-evidence-required])

(fact "deterministic corpus rendering is byte stable"
  (let [document
        (corpus/corpus-document
         profile/+foundation-baa75a+
         entries)]
    (= (corpus/corpus-source document)
       (corpus/corpus-source document)))
  => true)

(fact "retired Foundation identifiers remain semantic evidence, not live literals"
  (let [source
        (corpus/corpus-source
         {:source/namespace (str "std." "fs")
          :source/path (str "src/std/" "fs.clj")})]
    [(str/includes? source (str "std." "fs"))
     (str/includes? source (str "std/" "fs"))
     (Edn/read source)])
  => [false
      false
      {:source/namespace (str "std." "fs")
       :source/path (str "src/std/" "fs.clj")}])

(fact "Markdown reporting renders both deterministic next slices"
  (let [document
        (corpus/corpus-document
         profile/+foundation-baa75a+
         entries)
        report
        (corpus/report-source
         profile/+foundation-baa75a+
         document)]
    [(str/includes? report "## Next review")
     (str/includes? report "- `a`")
     (str/includes? report "## Next unblocked migration")])
  => [true true true])

(pr-str (run {:namespace "tool.migrate-corpus-test"}))
