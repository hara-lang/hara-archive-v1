(ns tool.migrate.transform.lib-core
  (:require [std.foundation :refer :all]
            [std.block :as block]
            [std.block.parse :as parse]
            [std.block.navigate :as navigate]))

(def +lib-core-ex-info-codes+
  {"subvec" :foundation/invalid-subvec-bounds
   "take-nth" :foundation/invalid-take-nth
   "topological-sort" :foundation/circular-dependency
   "macroexpand" :foundation/macro-expansion-limit
   "if-let-form" :foundation/invalid-if-let-bindings
   "comprehension-error" :foundation/invalid-comprehension-bindings
   "dotimes" :foundation/invalid-dotimes-binding})

(def +lib-core-ex-info-classes+
  {"subvec" :ex.class/argument
   "take-nth" :ex.class/argument
   "topological-sort" :ex.class/state
   "macroexpand" :ex.class/limit
   "if-let-form" :ex.class/syntax
   "comprehension-error" :ex.class/syntax
   "dotimes" :ex.class/syntax})

(defn code-children
  [value]
  (vec
   (filter block/code?
           (or (navigate/children (navigate/navigator value)) []))))

(defn form-head
  [value]
  (let [head (first (code-children value))]
    (if head (block/string head) nil)))

(defn definition-name
  [value]
  (let [head (form-head value)]
    (if (and head (str/starts-with? head "def"))
      (first
       (keep
        (fn [child]
          (if (= :meta (block/tag child))
            (let [children (code-children child)]
              (if (empty? children)
                nil
                (block/string (last children))))
            (block/string child)))
        (vec (drop 1 (code-children value)))))
      nil)))

(defn ex-info-block?
  [value]
  (let [head (form-head value)]
    (and (= :list (block/tag value))
         (or (= "ex-info" head)
             (= "std.foundation/ex-info" head)))))

(defn block-range
  [value]
  (select-keys (:props value) [:start-offset :end-offset]))

(defn migration-context
  [value definition]
  (let [children (code-children value)
        arguments (vec (rest children))]
    {:range (block-range value)
     :source (block/string value)
     :definition definition
     :message (if (< 0 (count arguments))
                (block/string (first arguments))
                nil)
     :data (if (< 1 (count arguments))
             (block/string (second arguments))
             nil)
     :cause (if (< 2 (count arguments))
              (block/string (nth arguments 2))
              nil)}))

(defn source-range
  [source value]
  (let [range (block-range value)
        start (get range :start-offset)
        end (get range :end-offset)
        start-position (parse/source-position source start)
        end-position (parse/source-position source end)]
    (assoc range
           :line (:row start-position)
           :column (:col start-position)
           :end-line (:row end-position)
           :end-column (:col end-position))))

(defn legacy-error-code
  [value]
  (let [arguments (vec (rest (code-children value)))
        data (if (< 1 (count arguments)) (nth arguments 1) nil)]
    (if data
      (try
        (let [form (block/value data)]
          (if (map? form) (get form :error/code) nil))
        (catch Throwable _ nil))
      nil)))

(defn definition-context
  [source value namespace]
  (let [name (definition-name value)]
    (if name
      {:kind (form-head value)
       :name (if namespace
               (symbol (str namespace "/" name))
               (symbol name))
       :range (source-range source value)
       :source (block/string value)}
      nil)))

(declare catalog-block)

(defn catalog-children
  [source value namespace definition modifiers]
  (vec
   (mapcat
    (fn [child]
      (catalog-block source child namespace definition modifiers))
    (block/children value))))

(defn catalog-block
  [source value namespace definition modifiers]
  (let [tag (block/tag value)
        modifiers (if (or (= tag :quote) (= tag :syntax) (= tag :uneval))
                    (conj modifiers tag)
                    modifiers)
        local-definition definition]
    (if (ex-info-block? value)
      (let [context (migration-context value
                                       (if local-definition
                                         (str (name (:name local-definition)))
                                         nil))]
        [(merge
          {:source/range (source-range source value)
           :source/form (:source context)
           :source/modifiers modifiers
           :context/definition local-definition
           :legacy/message (:message context)
           :legacy/data (:data context)
           :legacy/cause (:cause context)
           :legacy/error-code (legacy-error-code value)}
          {})])
      (if (block/container? value)
        (catalog-children source value namespace local-definition modifiers)
        []))))

(defn source-role
  [path]
  (cond
    (or (str/includes? path "/target/")
        (str/includes? path "/rust/hal-src/")
        (str/starts-with? path "public/hara-runtime/")) :generated
    (or (str/includes? path "/fixture")
        (str/includes? path "/test-fixtures/")
        (str/includes? path "/spec/code-migrate/recipes/")) :fixture
    (or (str/includes? path "/test/")
        (str/includes? path "/test-lang/")
        (str/ends-with? path "_test.hal")) :test
    (str/includes? path "/docs/") :documentation
    :else :production))

(defn reviewed-foundation-site
  [record]
  (let [definition (get-in record [:context/definition :name])
        name (if definition (name definition) nil)
        code (get +lib-core-ex-info-codes+ name)
        class (get +lib-core-ex-info-classes+ name)]
    (if (and code class)
      (assoc record
             :review/status :approved
             :migration/batch :foundation
             :ex/code code
             :ex/class class
             :expected/matches 1
             :expected/changes 1)
      (assoc record
             :review/status :pending
             :migration/batch nil
             :ex/code nil
             :ex/class nil
             :expected/matches nil
             :expected/changes nil))))

(defn source-namespace-name
  [source]
  (let [regular (str/index-of source "(ns ")
        extended (str/index-of source "(ns+ ")
        start (cond
                (not (= -1 regular)) (+ regular 4)
                (not (= -1 extended)) (+ extended 5)
                :else nil)]
    (if (nil? start)
      nil
      (loop [index start]
        (let [character (str/char-at source index)]
          (if (or (= character " ") (= character "\n")
                  (= character "\t") (= character ")"))
            (str/slice source start index)
            (recur (inc index))))))))

(defn catalog-ex-info-source
  "Catalogues structural ex-info forms with exact ranges and enclosing source."
  ([source path]
   (catalog-ex-info-source source path {}))
  ([source path options]
   (let [namespace (source-namespace-name source)
         records
         (loop [index 0 output []]
           (if (= index (str/length source))
             output
             (let [[value end] (parse/parse-at source index)
                   segment (str/slice source index end)
                   found (if (= -1 (str/index-of segment "ex-info"))
                           []
                           (catalog-block source value namespace
                                          (definition-context source value namespace)
                                          []))]
               (recur end (into output found)))))
         repository (get options :repository)
         revision (get options :revision)]
     (:records
      (reduce
       (fn [state record]
         (let [definition (get-in record [:context/definition :name])
               key (or definition :top-level)
               ordinal (get (:ordinals state) key 0)
               site-id [repository path (str key) ordinal]
               hydrated
               (reviewed-foundation-site
                (assoc record
                       :site/id site-id
                       :site/status :current
                       :source/repository repository
                       :source/revision revision
                       :source/path path
                       :source/namespace (if namespace (symbol namespace) nil)
                       :source/role (source-role path)))]
           {:ordinals (assoc (:ordinals state) key (inc ordinal))
            :records (conj (:records state) hydrated)}))
       {:ordinals {} :records []}
       records)))))

(defn resolve-contract
  [value definition contract-or-resolver]
  (let [context (migration-context value definition)
        contract
        (cond
          (function? contract-or-resolver)
          (contract-or-resolver context)

          (map? contract-or-resolver)
          (get contract-or-resolver (:definition context))

          :else
          contract-or-resolver)
        normalized (if (keyword? contract) {:ex/code contract} contract)
        code (:ex/code normalized)
        class (:ex/class normalized)]
    (if (and (map? normalized)
             (keyword? code) (namespace code)
             (or (nil? class) (and (keyword? class) (namespace class))))
      normalized
      (throw
       (ex :tool.migrate/invalid-ex-info-code
           {:ex/message "ex-info migration requires a qualified code and optional qualified class"
            :contract contract
            :context context})))))

(declare rewrite-block)

(defn rewrite-children
  [source value definition code-or-resolver]
  (let [start (:start-offset (:props value))
        children (vec (block/children value))]
    (reduce
     (fn [current child]
       (let [before (block/string child)
             after (rewrite-block child definition code-or-resolver)]
         (if (= before after)
           current
           (let [child-start (- (:start-offset (:props child)) start)
                 child-end (- (:end-offset (:props child)) start)]
             (str (str/slice current 0 child-start)
                  after
                  (str/slice current child-end))))))
     source
     (reverse children))))

(defn replacement-source
  [value definition code-or-resolver]
  (let [children (code-children value)
        arguments (vec (rest children))
        amount (count arguments)
        contract (resolve-contract value definition code-or-resolver)
        code (:ex/code contract)
        output-code (if (= "hara" (namespace code))
                      (keyword (name code))
                      code)
        class (or (:ex/class contract)
                  (if (map? code-or-resolver)
                    (get +lib-core-ex-info-classes+ definition)
                    nil))]
    (if (or (< amount 2) (< 3 amount))
      (throw
       (ex :tool.migrate/invalid-ex-info-form
           {:ex/message "ex-info migration expects message, data, and optional cause"
            :context (migration-context value definition)}))
      (let [rewritten
            (vec
             (map
              (fn [argument]
                (rewrite-block argument definition code-or-resolver))
              arguments))]
        (str "(ex " output-code " "
             (second rewritten)
             " :ex/message "
             (first rewritten)
             (if (and class (not= "hara" (namespace code)))
               (str " :ex/class " class)
               "")
             (if (= amount 3)
               (str " :ex/cause " (nth rewritten 2))
               "")
             ")")))))

(defn rewrite-block
  [value definition code-or-resolver]
  (if (ex-info-block? value)
    (replacement-source value definition code-or-resolver)
    (if (block/container? value)
      (rewrite-children
       (block/string value)
       value
       (or (definition-name value) definition)
       code-or-resolver)
      (block/string value))))

(defn migrate-ex-info-block
  [source code-or-resolver]
  (let [value (parse/parse-first source)]
    (rewrite-block value
                   (definition-name value)
                   code-or-resolver)))

(defn migrate-ex-info
  "Structurally rewrites ex-info calls to canonical ex calls. Each top-level
   form is parsed and transformed independently so large source files do not
   require one eagerly materialized navigation tree. The code source may be a
   qualified keyword, a map from enclosing definition name to code, or a
   resolver function accepting migration-context."
  ([source]
   (migrate-ex-info source +lib-core-ex-info-codes+))
  ([source code-or-resolver]
   (loop [index 0 output []]
     (if (= index (str/length source))
       (str/join "" output)
       (let [[value end] (parse/parse-at source index)
             segment (str/slice source index end)
             replacement
             (if (= -1 (str/index-of segment "ex-info"))
               segment
               (rewrite-block value
                              (definition-name value)
                              code-or-resolver))]
         (recur end (conj output replacement)))))))
