(ns tool.migrate.audit
  (:require [tool.migrate.clojure :as clj]
            [tool.migrate.corpus :as corpus]
            [tool.migrate.git :as migrate-git]
            [tool.migrate.profile :as profile]
            [std.foundation.string :as string]
            [std.fs :as fs]
            [std.fs.path :as path]
            [tool.sh :as sh]))

(defn git-runner
  "Creates the task-layer adapter for one bare Foundation repository."
  [git-dir]
  (fn [argv input]
    (if (not (nil? input))
      (throw
       (ex :tool.migrate/git-stdin-unsupported
           {:ex/message "The command adapter does not write Foundation objects"
            :argv argv})))
    (let [result
          (sh/run
           (vec
            (concat
             ["git" "--git-dir" git-dir]
             argv))
           {:trim false})]
      {:exit (:exit result)
       :out (:stdout result)
       :err (:stderr result)})))

(defn under-root?
  [file-path root]
  (or
   (= file-path root)
   (str/starts-with? file-path (str root "/"))))

(defn source-path?
  [profile-value file-path]
  (and
   (str/ends-with? file-path ".clj")
   (not
    (empty?
     (filter
      (fn [root]
        (under-root? file-path root))
      (:foundation/source-roots profile-value))))))

(defn test-path?
  [profile-value file-path]
  (and
   (str/ends-with? file-path ".clj")
   (not
    (empty?
     (filter
      (fn [root]
        (under-root? file-path root))
      (:foundation/test-roots profile-value))))))

(defn source-test-path
  [source-path]
  (let [parts (str/split source-path "/")
        root (first parts)
        suffix (str/join "/" (rest parts))
        test-root
        (case root
          "src" "test"
          "src-java" "test-java"
          "src-lang" "test-lang"
          nil)]
    (if test-root
      (str test-root
           "/"
           (str/slice suffix 0 (- (count suffix) 4))
           "_test.clj")
      nil)))

(defn tree-index
  [paths]
  (reduce
   (fn [output file-path]
     (assoc output file-path true))
   {}
   paths))

(defn read-source-entry
  [runner revision file-path]
  (let [blob (migrate-git/blob-id runner revision file-path)
        source (migrate-git/read-object runner blob)]
    (corpus/source-entry file-path blob source)))

(defn attach-paired-test
  [runner revision paths entry]
  (let [test-path (source-test-path (:source/path entry))]
    (if (and test-path (has? paths test-path))
      (let [blob (migrate-git/blob-id runner revision test-path)
            source (migrate-git/read-object runner blob)]
        (corpus/attach-test entry test-path blob source))
      entry)))

(defn foundation-entries
  [runner profile-value]
  (let [revision (:foundation/revision profile-value)
        paths (migrate-git/list-tree runner revision)
        index (tree-index paths)]
    (vec
     (map
      (fn [file-path]
        (attach-paired-test
         runner
         revision
         index
         (read-source-entry runner revision file-path)))
      (filter
       (fn [file-path]
         (source-path? profile-value file-path))
       paths)))))

(defn read-text
  [file-path]
  (string/decode-utf8 (fs/read-bytes file-path)))

(defn relative-path
  [root file-path]
  (let [prefix
        (if (str/ends-with? root "/")
          root
          (str root "/"))]
    (if (str/starts-with? file-path prefix)
      (str/slice file-path (count prefix) (count file-path))
      file-path)))

(defn hara-target-unit
  [root file-path]
  (let [source (read-text file-path)
        summary (clj/source-summary source)]
    {:target/path (relative-path root file-path)
     :target/namespace (:namespace summary)
     :target/public-symbols (:public-symbols summary)}))

(defn hara-target-units
  [root]
  (let [roots
        [(path/join root "core/lib/src")
         (path/join root "core/lib/test")]]
    (vec
     (mapcat
      (fn [source-root]
        (map
         (fn [entry]
           (hara-target-unit root (:path entry)))
         (fs/select
          source-root
          (fn [entry]
            (and
             (= :file (:type entry))
             (str/ends-with? (:path entry) ".hal"))))))
      roots))))

(defn namespace-leaf
  [namespace]
  (last (str/split namespace ".")))

(defn matching-symbols
  [source target]
  (let [target-index
        (reduce
         (fn [output symbol]
           (assoc output symbol true))
         {}
         (:target/public-symbols target))]
    (vec
     (filter
      (fn [symbol]
        (has? target-index symbol))
      (:public-symbols source)))))

(defn candidate-state
  [source target]
  (cond
    (= (:namespace source)
       (:target/namespace target))
    :exact

    (= (namespace-leaf (:namespace source))
       (namespace-leaf (:target/namespace target)))
    :moved

    (not (empty? (matching-symbols source target)))
    :similar

    :else nil))

(defn candidate-matches
  [source targets]
  (vec
   (sort-by
    :target/path
    (keep
     (fn [target]
       (let [state (candidate-state source target)]
         (if state
           {:candidate/state state
            :target/path (:target/path target)
            :target/namespace (:target/namespace target)
            :matching/public-symbols
            (matching-symbols source target)}
           nil)))
     targets))))

(defn symbol-route
  [source-symbol candidates]
  {:source/symbol source-symbol
   :candidate/targets
   (vec
    (keep
     (fn [candidate]
       (if
        (not
         (empty?
          (filter
           (fn [symbol]
             (= source-symbol symbol))
           (:matching/public-symbols candidate))))
        {:target/path (:target/path candidate)
         :target/namespace (:target/namespace candidate)
         :target/symbol source-symbol}
        nil))
     candidates))
   :review/disposition :pending
   :review/evidence []})

(defn attach-candidates
  [entry targets]
  (let [candidates (candidate-matches entry targets)]
    (assoc
     entry
     :candidate/matches candidates
     :symbol/routes
     (vec
      (map
       (fn [source-symbol]
         (symbol-route source-symbol candidates))
       (:public-symbols entry))))))

(defn audit
  ([git-dir hara-root]
   (audit
    (git-runner git-dir)
    profile/+foundation-baa75a+
    (hara-target-units hara-root)))
  ([runner profile-value targets]
   (profile/assert-profile profile-value)
   (migrate-git/snapshot runner profile-value)
   (corpus/corpus-document
    profile-value
    (map
     (fn [entry]
       (attach-candidates entry targets))
     (foundation-entries runner profile-value)))))

(defn write-text
  [file-path source]
  (fs/write-bytes
   file-path
   (string/encode-utf8 source)
   {:mode (if (fs/exists? file-path) :replace :create)
    :parents? true}))

(defn write-audit
  [git-dir hara-root]
  (let [profile-value profile/+foundation-baa75a+
        document (audit git-dir hara-root)
        corpus-path (path/join hara-root (:corpus/path profile-value))
        report-path (path/join hara-root (:report/path profile-value))]
    (write-text corpus-path (corpus/corpus-source document))
    (write-text report-path (corpus/report-source profile-value document))
    {:corpus/path corpus-path
     :report/path report-path
     :namespaces (count (:namespaces document))
     :external/routes (count (:external/routes document))
     :next/review (:next/review document)
     :next/unblocked-migration
     (:next/unblocked-migration document)}))
