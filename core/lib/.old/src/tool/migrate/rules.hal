(ns tool.migrate.rules)

(def +foundation-revision+
  "f909a44ad504cc6c9f44248d59ec3148261a48d7")

(defn evidence
  [foundation-path hara-path note]
  [{:foundation/repository "zcaudate-xyz/foundation-base"
    :foundation/revision +foundation-revision+
    :foundation/path foundation-path
    :hara/path hara-path
    :note note}])

(def +native-static-types+
  ["Maths" "Num" "Bits" "Kernel" "Sandbox" "Package" "String" "Bytes" "Crypto"
   "OS" "Process" "File" "Socket" "Promise" "Coroutine" "Stream" "Arr"
   "Obj" "Runtime" "Printer" "Document" "Edn" "Json" "Host" "Test" "RegExp"
   "UUID" "Result" "Schema" "Error" "Base" "Algo" "Iter"])

(defn native-static-dependency-rule
  [type]
  {:id (keyword (str "dependency/std-native-" type "-static"))
   :kind :dependency-entry
   :match {:text (str "std.native." type)}
   :rewrite {:op :delete-parent}
   :safety :safe
   :priority 118
   :message (str "Remove the invalid native dependency; " type
                 " is a built-in static object.")
   :evidence
   (evidence "src/std/lib/foundation.clj"
             "core/lib/src/std/foundation.hal"
             "Built-in native static objects must not be required or namespace-aliased.")})

(defn native-static-call-rule
  [type]
  {:id (keyword (str "native/std-native-" type))
   :kind :token-prefix
   :match {:text (str "std.native." type)}
   :match/when {:not-parent-contains ":as"}
   :rewrite {:op :replace-token-prefix :text type}
   :safety :safe
   :priority 119
   :message (str "Use the built-in " type " static object directly.")
   :evidence
   (evidence "src/std/lib/foundation.clj"
             "core/lib/src/std/foundation.hal"
             "Native static objects are built into Hara rather than loaded as namespaces.")})

(defn native-static-dependency-rules
  []
  (vec (map native-static-dependency-rule +native-static-types+)))

(defn native-static-call-rules
  []
  (vec (map native-static-call-rule +native-static-types+)))

(def +rules+
  (vec
   (concat
  [{:id :namespace/std-protocol-block
    :kind :token
    :match {:text "std.protocol.block"}
    :rewrite {:op :replace-token
              :text "std.block.protocol"}
    :safety :safe
    :priority 100
    :message "Use the portable block protocol namespace."
    :evidence
    (evidence "src/std/protocol/block.clj"
              "core/lib/src/std/block/protocol.hal"
              "Foundation's JVM interfaces are represented by std.block.protocol in Hara.")}


   {:id :namespace/std-db
    :kind :token-prefix
    :match {:text "std.db"}
    :rewrite {:op :replace-token-prefix :text "db"}
    :safety :safe
    :priority 115
    :message "Move the database family to the root db ownership boundary."
    :evidence
    (evidence "src/std/db"
              "core/lib/src/db"
              "Hara database namespaces no longer live below std.")}

   {:id :namespace/std-lib-schema
    :kind :token-prefix
    :match {:text "std.lib.schema"}
    :rewrite {:op :replace-token-prefix :text "db.schema"}
    :safety :review
    :priority 116
    :message "Move schema utilities under db.schema."
    :evidence
    (evidence "src/std/lib/schema"
              "core/lib/src/db/schema"
              "Schema utilities are owned by the database domain in Hara.")}

   {:id :namespace/std-lib-transform
    :kind :token-prefix
    :match {:text "std.lib.transform"}
    :rewrite {:op :replace-token-prefix :text "db.transform"}
    :safety :review
    :priority 117
    :message "Move transform utilities under db.transform."
    :evidence
    (evidence "src/std/lib/transform"
              "core/lib/src/db/transform"
              "Transform utilities are owned by the database domain in Hara.")}

   {:id :predicate/collection-to-coll
    :kind :token
    :match {:text "collection?"}
    :rewrite {:op :replace-token :text "coll?"}
    :safety :safe
    :priority 118
    :message "Use the canonical protocol-aware coll? predicate."
    :evidence
   (evidence "src/std/lib/collection.clj"
              "core/lib/src/std/foundation.hal"
              "Hara names the IColl capability predicate coll?.")}

   {:id :dependency/foundation-json-native-static
    :kind :dependency-entry
    :match {:text "std.foundation.json"}
    :rewrite {:op :delete-parent}
    :safety :safe
    :priority 118
    :message "Remove the obsolete JSON namespace dependency; Json is a native static object."
    :evidence (evidence "src/std/json.clj" "core/lib/src/std/foundation.hal"
                        "Native static objects are available without namespace dependencies.")}

   {:id :dependency/std-json-native-static
    :kind :dependency-entry
    :match {:text "std.json"}
    :rewrite {:op :delete-parent}
    :safety :safe
    :priority 118
    :message "Remove the obsolete JSON namespace dependency; Json is a native static object."
    :evidence (evidence "src/std/json.clj" "core/lib/src/std/foundation.hal"
                        "Native static objects are available without namespace dependencies.")}

   ]

  (native-static-dependency-rules)

  [

   {:id :collection/map-keys
