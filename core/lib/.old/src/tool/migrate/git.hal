(ns tool.migrate.git)

(def +read-only-commands+
  #{"rev-parse" "ls-tree" "cat-file" "hash-object"})

(def +write-options+
  #{"-w" "--write" "--stdin-paths"})

(defn argv-command
  [argv]
  (first argv))

(defn allowed-argv?
  [argv]
  (and
   (vector? argv)
   (not (empty? argv))
   (has? +read-only-commands+ (argv-command argv))
   (empty?
    (filter
     (fn [argument]
       (has? +write-options+ argument))
     argv))))

(defn assert-read-only
  [argv]
  (if (not (allowed-argv? argv))
    (throw
     (ex :tool.migrate/git-command-rejected
         {:ex/message "Foundation Git access is restricted to read-only object operations"
          :argv argv
          :allowed +read-only-commands+})))
  argv)

(defn result-exit
  [result]
  (if (map? result)
    (or (:exit result) (:status result) 0)
    0))

(defn result-out
  [result]
  (cond
    (string? result) result
    (map? result) (or (:out result) (:stdout result) "")
    (nil? result) ""
    :else (str result)))

(defn result-err
  [result]
  (if (map? result)
    (or (:err result) (:stderr result) "")
    ""))

(defn run
  ([runner argv]
   (run runner argv nil))
  ([runner argv input]
   (let [argv (assert-read-only argv)
         result (runner argv input)
         exit (result-exit result)]
     (if (not= 0 exit)
       (throw
        (ex :tool.migrate/git-command-failed
            {:ex/message "Read-only Foundation Git operation failed"
             :argv argv
             :exit exit
             :stderr (result-err result)})))
     (result-out result))))

(defn trim-output
  [value]
  (str/trim (or value "")))

(defn resolve-commit
  [runner revision]
  (trim-output
   (run runner ["rev-parse" (str revision "^{commit}")])))

(defn resolve-tree
  [runner revision]
  (trim-output
   (run runner ["rev-parse" (str revision "^{tree}")])))

(defn blob-id
  [runner revision path]
  (trim-output
   (run runner ["rev-parse" (str revision ":" path)])))

(defn list-tree
  ([runner revision]
   (list-tree runner revision nil))
  ([runner revision path]
   (let [argv
         (vec
          (concat
           ["ls-tree" "-r" "--name-only" revision]
           (if path ["--" path] [])))
         output (run runner argv)]
     (vec
      (filter
       (fn [line] (not (empty? line)))
       (str/split-lines output))))))

(defn read-object
  [runner object]
  (run runner ["cat-file" "blob" object]))

(defn read-blob
  [runner revision path]
  (read-object runner (blob-id runner revision path)))

(defn object-type
  [runner object]
  (trim-output
   (run runner ["cat-file" "-t" object])))

(defn hash-source
  [runner source]
  (trim-output
   (run runner ["hash-object" "--stdin"] source)))

(defn snapshot
  [runner profile]
  (let [revision (:foundation/revision profile)
        commit (resolve-commit runner revision)
        tree (resolve-tree runner revision)]
    (if (not= revision commit)
      (throw
       (ex :tool.migrate/foundation-revision-drift
           {:ex/message "Foundation revision did not resolve exactly"
            :expected revision
            :actual commit})))
    (if (not= (:foundation/tree profile) tree)
      (throw
       (ex :tool.migrate/foundation-tree-drift
           {:ex/message "Foundation tree did not resolve exactly"
            :expected (:foundation/tree profile)
            :actual tree})))
    {:repository (:foundation/repository profile)
     :revision commit
     :tree tree}))
