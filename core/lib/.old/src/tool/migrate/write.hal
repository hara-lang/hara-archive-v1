(ns tool.migrate.write)

(def +blocking-diagnostic-types+
  #{:tool.migrate/ambiguous
    :tool.migrate/conflict
    :tool.migrate/unsupported})

(defn sorted-unique
  [values]
  (vec
   (sort
    (keys
     (reduce
      (fn [output value]
        (if (nil? value)
          output
          (assoc output value true)))
      {}
      values)))))

(defn corpus-field
  [value keys]
  (loop [remaining keys]
    (if (empty? remaining)
      nil
      (let [key (first remaining)]
        (if (and (map? value)
                 (has? value key))
          (get value key)
          (recur (vec (rest remaining))))))))

(defn record-error?
  [record]
  (or
   (= :error (:status record))
   (= :critical (:status record))))

(defn blocking-diagnostic?
  [diagnostic options]
  (or
   (and
    (not (:allow-manual? options))
    (= :manual (:safety diagnostic)))
   (and
    (not (:allow-errors? options))
    (or
     (= :error (:level diagnostic))
     (= :critical (:level diagnostic))
     (has? +blocking-diagnostic-types+
           (:type diagnostic))))))

(defn strip-trailing-separator
  [value]
  (if (and
       (string? value)
       (not (empty? value))
       (str/ends-with? value "/"))
    (str/slice value 0 (dec (count value)))
    value))

(defn canonical-under-root?
  [path root]
  (let [root
        (if (string? root)
          (strip-trailing-separator root)
          nil)]
    (and
     (string? path)
     (string? root)
     (not (empty? root))
     (or
      (= path root)
      (str/starts-with?
       path
       (str root "/"))))))

(defn required-capability
  [capabilities key]
  (or
   (get capabilities key)
   (throw
    (ex :tool.migrate/missing-capability
        {:ex/message "Missing migration host capability"
         :capability key}))))

(defn duplicate-targets
  [intents]
  (sorted-unique
   (keep
    (fn [entry]
      (let [path (first entry)
            owners (second entry)]
        (if (> (count owners) 1)
          path
          nil)))
    (seq (group-by :path intents)))))

(defn intent-errors
  [intent capabilities options]
  (let [read-text
        (required-capability capabilities :read-text)
        sha256
        (required-capability capabilities :sha256)
        canonical-path
        (required-capability capabilities :canonical-path)
        roots
        (vec
         (or
          (:authorized-roots options)
          (:authorized-roots capabilities)
          []))
        canonical-roots
        (vec (map canonical-path roots))
        canonical-target
        (canonical-path (:path intent))
        declared-root (:target/root intent)
        canonical-declared-root
        (if (string? declared-root)
          (canonical-path declared-root)
          nil)
        source-text
        (read-text (:source/path intent))
        target-text
        (read-text (:path intent))
        source-sha
        (if (nil? source-text)
          nil
          (sha256 source-text))
        target-sha
        (if (nil? target-text)
          nil
          (sha256 target-text))]
    (vec
     (concat
      (if (empty? roots)
        [{:type :tool.migrate/write-root-required
          :path (:path intent)}]
        [])
      (if (not (string? declared-root))
        [{:type :tool.migrate/target-root-required
          :path (:path intent)}]
        [])
      (if
       (and
        (string? canonical-declared-root)
        (not (empty? canonical-roots))
        (empty?
         (filter
          (fn [root]
            (canonical-under-root?
             canonical-declared-root root))
          canonical-roots)))
        [{:type :tool.migrate/unauthorized-root
          :path (:path intent)
          :target/root (:target/root intent)}]
        [])
      (if
       (not
        (canonical-under-root?
         canonical-target
         canonical-declared-root))
        [{:type :tool.migrate/path-escape
          :path (:path intent)
          :target/root (:target/root intent)}]
        [])
      (if (nil? (:source/sha256 intent))
        [{:type :tool.migrate/source-checksum-required
          :source/path (:source/path intent)}]
        [])
      (if
       (and
        (:source/sha256 intent)
        (not= (:source/sha256 intent)
              source-sha))
        [{:type :tool.migrate/stale-source
          :source/path (:source/path intent)
          :expected (:source/sha256 intent)
          :actual source-sha}]
        [])
      (if
       (not= (:before intent)
             target-text)
        [{:type :tool.migrate/stale-target
          :path (:path intent)
          :expected (:before intent)
          :actual target-text}]
        [])
      (if
       (and
        (:target/sha256 intent)
        (not= (:target/sha256 intent)
              target-sha))
        [{:type :tool.migrate/stale-target-checksum
          :path (:path intent)
          :expected (:target/sha256 intent)
          :actual target-sha}]
        [])))))

(defn write-intent
  [item]
  (let [unit (:unit item)
        result (:result item)]
    {:path (:target/path result)
     :source/path (:source/path result)
     :source/text (:source/text result)
     :source/sha256 (:source/sha256 result)
     :target/root (:target/root result)
     :target/sha256
     (corpus-field
      unit
      [:target/sha256 :target_sha256
       "target/sha256" "target_sha256"])
     :before (:before result)
     :after (:after result)
     :changed (:changed result)
     :create (:create result)
     :namespace (:namespace result)
     :diagnostics (:diagnostics result)
     :provenance (:provenance result)}))

(defn result-edit?
  [result]
  (and
   (map? result)
   (has? result :after)))

(defn write-intents
  [items]
  (vec
   (keep
    (fn [item]
      (let [result (:result item)]
        (if (result-edit? result)
          (write-intent item)
          nil)))
    items)))

(defn validate-write-plan
  ([plan capabilities]
   (validate-write-plan plan capabilities {}))
  ([plan capabilities options]
   (let [all-intents
         (vec (:write-intents plan))
         intents
         (vec
          (filter
           (fn [intent]
             (:changed intent))
           all-intents))
         duplicate-errors
         (vec
          (map
           (fn [path]
             {:type :tool.migrate/duplicate-target
              :path path})
           (duplicate-targets all-intents)))
         diagnostic-errors
         (vec
          (map
           (fn [diagnostic]
             {:type :tool.migrate/blocked-diagnostic
              :diagnostic diagnostic})
           (filter
            (fn [diagnostic]
              (blocking-diagnostic?
               diagnostic options))
            (:diagnostics plan))))
         record-errors
         (if (:allow-errors? options)
           []
           (vec
            (map
             (fn [record]
               {:type :tool.migrate/blocked-record
                :item/id (:item/id record)
                :status (:status record)
                :error (:error record)})
             (filter
              record-error?
              (:records plan)))))
         errors
         (reduce
          (fn [output intent]
            (into
             output
             (intent-errors
              intent capabilities options)))
          (vec
           (concat
            duplicate-errors
            diagnostic-errors
            record-errors))
          intents)]
     {:valid? (empty? errors)
      :write false
      :intents intents
      :errors (vec errors)})))

(defn apply-plan
  ([plan capabilities]
   (apply-plan plan capabilities {}))
  ([plan capabilities options]
   (let [validation
         (validate-write-plan
          plan capabilities options)]
     (if (not (:valid? validation))
       (throw
        (ex :tool.migrate/write-plan-invalid
            {:ex/message "Migration write plan validation failed"
             :validation validation})))
     (let [write-atomic
           (required-capability
            capabilities :write-atomic)
           results
           (vec
            (map
             (fn [intent]
               {:path (:path intent)
                :result
                (write-atomic
                 (:path intent)
                 (:after intent))})
             (:intents validation)))]
       {:write true
        :count (count results)
        :results results
        :validation validation}))))
