(ns tool.migrate.conformance
  (:require [tool.migrate.corpus :as corpus]
            [tool.migrate.git :as migrate-git]
            [tool.migrate.profile :as profile]
            [std.fs.path :as path]
            [code.project :as project]
            [tool.sh :as sh]
            [work.flow.task.command-task :as task]))

(def +mapping-statuses+
  #{:retained :renamed :split :consolidated :host-only :retired :manual-review})

(def +evidence-statuses+ #{:emitted :skipped :manual-review})

(def +foundation-revision+
  "f55f39855d5e9ea1b22f1d116df684c584323f80")

(def +foundation-tree+
  "3beb10f32e7d57139910ee9c9de1370e966ca935")

(def +hara-revision+
  "fd382c506348c1e96412e7398ac4cba7029b7885")

(def +baseline+
  {:foundation/repository "zcaudate-xyz/foundation-base"
   :foundation/revision +foundation-revision+
   :foundation/tree +foundation-tree+
   :hara/repository "hara-lang/hara"
   :hara/revision +hara-revision+
   :output/repository "hara-lang/hara-specs-registry"
   :output/root "../hara-specs-registry/01-lang/005-foundation-annex/draft/conformance/libraries"})

(defn family-descriptor
  [family-id test-prefixes test-count target-namespace mappings output-path]
  {:family/id family-id
   :family/name (name family-id)
   :source/test-prefixes (vec test-prefixes)
   :source/test-count test-count
   :target/namespace target-namespace
   :target/metadata-path (str (name family-id) "/metadata.edn")
   :mapping mappings
   :output/path output-path
   :review/status :unreviewed})

