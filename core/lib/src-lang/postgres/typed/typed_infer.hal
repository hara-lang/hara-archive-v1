(ns postgres.typed.typed-infer
  (:require [std.foundation :refer [drop nth second]]
            [postgres.typed.typed-common :as types]
            [postgres.typed.typed-jsonb :as typed-jsonb]
            [postgres.typed.typed-resolve :as typed-resolve]
            [postgres.typed.typed-shape :as shape]))

(defn- member?
  [values value]
  (reduce (fn [found item] (or found (= item value))) false values))

(defn- nth-or
  [values index fallback]
  (if (< index (count values)) (nth values index) fallback))

(defn- collection-form?
  [value]
  (or (list? value) (vector? value) (map? value) (set? value)))

(defn select-shape-columns
  "Restricts a JsonbShape to selected columns."
  [base-shape columns]
  (if (and (types/jsonb-shape? base-shape) columns (> (count columns) 0))
    (let [wanted
          (map (fn [column]
                 (if (keyword? column) column (keyword (name column))))
               columns)
          selected
          (reduce (fn [out key]
                    (let [missing ::missing
                          value (get (:fields base-shape) key missing)]
                      (if (= missing value) out (assoc out key value))))
                  {}
                  wanted)]
      (assoc base-shape :fields selected))
    base-shape))

(defn resolve-table-def
  "Resolves a table name from the typed registry."
  [table-sym]
  (if table-sym
    (let [table-name (name table-sym)]
      (or (types/get-type table-sym)
          (types/get-type (symbol table-name))
          (types/get-type (keyword table-name))
          (reduce (fn [found candidate]
                    (or found
                        (if (and (types/table-def? candidate)
                                 (= table-name (:name candidate)))
                          candidate
                          nil)))
                  nil
                  (vals @types/*type-registry*))))
    nil))

(defn form-uses-tracked?
  [form tracked]
  (boolean
   (cond (symbol? form) (member? tracked form)
         (collection-form? form)
         (reduce (fn [found item]
                   (or found (form-uses-tracked? item tracked)))
                 false
                 form)
         :else false)))

(defn form-uses-track-param?
  [form tracked]
  (boolean
   (cond (map? form)
         (or (and (not= ::missing (get form :track ::missing))
                  (form-uses-tracked? (:track form) tracked))
             (reduce (fn [found entry]
                       (or found (form-uses-track-param? (second entry) tracked)))
                     false
                     form))
         (or (list? form) (vector? form) (set? form))
         (reduce (fn [found item]
                   (or found (form-uses-track-param? item tracked)))
                 false
                 form)
         :else false)))

(def +insert-update-ops+
  ['pg/t:insert 'pg/g:insert 'pg/t:update 'pg/g:update])
(def +update-ops+ ['pg/t:update 'pg/g:update])
(def +track-ops+
  ['pg/t:insert 'pg/g:insert 'pg/t:update 'pg/g:update
   'pg/t:upsert 'pg/g:upsert])

(defn- resolve-called-definition
  [op]
  (let [op-name (name op)]
    (or (types/get-type op)
        (types/get-type (symbol op-name))
        (reduce (fn [found candidate]
                  (or found
                      (if (and (types/fn-def? candidate)
                               (= op-name (:name candidate)))
                        candidate
                        nil)))
                nil
                (vals @types/*type-registry*)))))

(defn- tracked-arg-position
  [args tracked]
  (loop [index 0]
    (if (= index (count args))
      nil
      (if (member? tracked (nth args index))
        index
        (recur (inc index))))))

(declare find-table-spec-form find-table-spec-forms)

(defn- direct-table-spec
  [mode form tracked]
  (let [op (first form)
        params (nth-or form 2 nil)
        table (second form)]
    (cond (and (= :op mode)
               (member? +insert-update-ops+ op)
               (member? tracked params))
          table
          (and (= :op mode)
               (member? +update-ops+ op)
               (map? params)
               (form-uses-tracked? (:set params) tracked))
          table
          (and (= :update mode)
               (member? +update-ops+ op)
               (map? params)
               (form-uses-tracked? (:set params) tracked))
          {:table table :columns (:columns params) :set (:set params) :op op}
          (and (= :track mode)
               (member? +track-ops+ op)
               (map? params)
               (form-uses-track-param? params tracked))
          {:table table :track (:track params) :op op}
          :else nil)))

(defn- find-table-spec-let
  [mode form tracked]
  (let [pairs (vec (partition 2 (second form)))]
    (loop [index 0 current tracked]
      (if (= index (count pairs))
        (find-table-spec-forms mode (drop 2 form) current)
        (let [pair (nth pairs index)
              binding (first pair)
              expr (second pair)
              found (find-table-spec-form mode expr current)
              next-tracked (if (and (symbol? binding)
                                    (form-uses-tracked? expr current))
                             (conj current binding)
                             current)]
          (if found
            found
            (recur (inc index) next-tracked)))))))

(defn- find-table-spec-called
  [mode form tracked]
  (let [op (first form)
        args (vec (rest form))
        arg-position (if (symbol? op) (tracked-arg-position args tracked) nil)
        called (if (and (symbol? op) (not (nil? arg-position)))
                 (resolve-called-definition op)
                 nil)
        target-arg (if called (nth-or (:inputs called) arg-position nil) nil)]
    (or (if (and target-arg (= :jsonb (:type target-arg)))
          (find-table-spec-form mode
                                (get-in called [:body-meta :raw-body])
                                #{(:name target-arg)})
          nil)
        (find-table-spec-forms mode form tracked))))

(defn find-table-spec-form
  [mode form tracked]
  (cond (list? form)
        (or (direct-table-spec mode form tracked)
            (if (and (= 'let (first form)) (vector? (second form)))
              (find-table-spec-let mode form tracked)
              (find-table-spec-called mode form tracked)))
        (or (vector? form) (map? form) (set? form))
        (find-table-spec-forms mode form tracked)
        :else nil))

(defn find-table-spec-forms
  [mode forms tracked]
  (reduce (fn [found form]
            (or found (find-table-spec-form mode form tracked)))
          nil
          forms))

(defn find-table-op-in-body
  [body arg-name]
  (find-table-spec-form :op body #{arg-name}))

(defn find-table-update-spec-in-body
  [body arg-name]
  (find-table-spec-form :update body #{arg-name}))

(defn find-table-track-spec-in-body
  [body arg-name]
  (find-table-spec-form :track body #{arg-name}))

(defn infer-jsonb-arg-access-shape
  ([arg-name fn-def]
   (infer-jsonb-arg-access-shape arg-name fn-def nil nil))
  ([arg-name fn-def seed-shape]
   (infer-jsonb-arg-access-shape arg-name fn-def seed-shape nil))
  ([arg-name fn-def seed-shape role]
   (typed-jsonb/infer-jsonb-arg-access-shape arg-name fn-def seed-shape role)))

(declare infer-jsonb-arg-shape* infer-jsonb-arg-table-shape*)

(defn- function-arg-role
  [fn-def arg-name]
  (reduce (fn [found arg]
            (or found (if (= arg-name (:name arg)) (:role arg) nil)))
          nil
          (:inputs fn-def)))

(defn- infer-shape-from-calls
  [form arg-name fn-def aliases visited fn-key]
  (cond (list? form)
        (let [op (first form)
              args (vec (rest form))
              position
              (loop [index 0]
                (if (= index (count args))
                  nil
                  (if (= arg-name (nth args index))
                    index
                    (recur (inc index)))))
              resolved (if (and (symbol? op) (not (nil? position)))
                         (typed-resolve/resolve-called-fn op aliases)
                         nil)
              called (if resolved (second resolved) nil)
              target (if called (nth-or (:inputs called) position nil) nil)
              direct
              (if (and target (= :jsonb (:type target)))
                (infer-jsonb-arg-table-shape*
                 (:name target) called (conj visited fn-key))
                nil)]
          (or direct
              (reduce (fn [found item]
                        (or found
                            (infer-shape-from-calls
                             item arg-name fn-def aliases visited fn-key)))
                      nil
                      form)))
        (or (vector? form) (map? form) (set? form))
        (reduce (fn [found item]
                  (or found
                      (infer-shape-from-calls
                       item arg-name fn-def aliases visited fn-key)))
                nil
                form)
        :else nil))

(defn infer-jsonb-arg-table-shape*
  [arg-name fn-def visited]
  (let [fn-key (symbol (or (:ns fn-def) "") (:name fn-def))
        arg-role (function-arg-role fn-def arg-name)
        meta-table (get-in fn-def [:body-meta :api/meta :table])
        meta-columns (get-in fn-def [:body-meta :api/meta :columns])
        aliases (or (get-in fn-def [:body-meta :aliases]) {})
        body (get-in fn-def [:body-meta :raw-body])
        metadata-table-def (resolve-table-def meta-table)
        update-spec (if body (find-table-update-spec-in-body body arg-name) nil)
        update-table-def (if update-spec (resolve-table-def (:table update-spec)) nil)
        operation-table (if body
                          (if (= :track arg-role)
                            (let [track-spec (find-table-track-spec-in-body body arg-name)]
                              (or (:table track-spec)
                                  (find-table-op-in-body body arg-name)))
                            (find-table-op-in-body body arg-name))
                          nil)
        operation-table-def (resolve-table-def operation-table)]
    (or (if (types/table-def? metadata-table-def)
          (select-shape-columns (shape/table->shape metadata-table-def)
                                meta-columns)
          nil)
        (if (types/table-def? update-table-def)
          (select-shape-columns (shape/table->shape update-table-def)
                                (:columns update-spec))
          nil)
        (if (types/table-def? operation-table-def)
          (shape/table->shape operation-table-def)
          nil)
        (if (and body (not (member? visited fn-key)))
          (infer-shape-from-calls body arg-name fn-def aliases visited fn-key)
          nil))))

(defn infer-jsonb-arg-shape
  [arg-name fn-def & role-values]
  (infer-jsonb-arg-shape* arg-name fn-def #{} (first role-values)))

(defn infer-jsonb-arg-shape*
  [arg-name fn-def visited & role-values]
  (let [role (first role-values)]
    (if (= :track role)
      nil
      (let [table-shape (infer-jsonb-arg-table-shape* arg-name fn-def visited)
            access-shape (typed-jsonb/infer-jsonb-arg-access-shape
                          arg-name fn-def table-shape role)]
        (or access-shape table-shape)))))

(def __tahto_load__ true)
