(ns postgres.typed.typed-jsonb
  (:require
            [std.foundation :refer [drop nth second]]
            [postgres.typed.typed-common :as types]))

(defn symbol->field-key
  [sym]
  (if (symbol? sym)
    (let [value (name sym)
          stripped (if (and (> (str/length value) 1)
                            (= \- (str/char-at value 1)))
                     (str/slice value 2)
                     value)]
      (keyword stripped))
    nil))

(defn field-info
  ([field-type] (field-info field-type {}))
  ([field-type opts]
   (merge {:type (or field-type :jsonb) :nullable? true} opts)))

(defn typed-binding-form?
  [binding]
  (and (list? binding)
       (keyword? (first binding))
       (symbol? (second binding))))

(defn accessor-expr?
  [expr]
  (boolean
   (and (list? expr)
        (or (= :-> (first expr))
            (= :->> (first expr))
            (= 'pg/field-id (first expr))))))

(defn append-path
  [path segment]
  (if (and (types/jsonb-path? path) segment)
    (types/make-jsonb-path
     (conj (vec (:segments path)) segment)
     (:root-var path))
    nil))

(declare expr-jsonb-path)

(defn- nth-or
  [values index fallback]
  (if (< index (count values)) (nth values index) fallback))

(defn access-descriptors
  [ctx expr]
  (if (accessor-expr? expr)
    (let [op (first expr)
          source-path (expr-jsonb-path ctx (second expr))
          field-name (nth-or expr 2 nil)
          field-key (if (string? field-name) (keyword field-name) nil)]
      (cond (and (= 'pg/field-id op) source-path field-key)
            (let [id-path (append-path source-path
                                       (keyword (str field-name "_id")))
                  field-path (append-path source-path field-key)
                  nested-path (if field-path (append-path field-path :id) nil)]
              (reduce (fn [out descriptor]
                        (if descriptor (conj out descriptor) out))
                      []
                      [{:path id-path :field-info (field-info :uuid)}
                       (if nested-path
                         {:path nested-path :field-info (field-info :uuid)}
                         nil)]))
            (and source-path field-key)
            [{:path (append-path source-path field-key)
              :field-info
              (field-info (if (= :-> op) :jsonb :text))}]
            :else nil))
    nil))

(defn access-descriptor [ctx expr]
  (first (access-descriptors ctx expr)))

(defn source-root-shape
  [ctx source-path]
  (if (types/jsonb-path? source-path)
    (types/get-var-shape ctx (:root-var source-path))
    nil))

(defn source-field-info
  [ctx source-path field-key accessor-type]
  (let [root-shape (source-root-shape ctx source-path)
        known (if (and root-shape field-key)
                (get-in root-shape [:fields field-key])
                nil)]
    (or known (field-info (if (= :-> accessor-type) :jsonb :text)))))

(declare js-keys-form->keywords)

(defn js-select-form?
  [form]
  (and (list? form)
       (symbol? (first form))
       (= "js-select" (name (first form)))))

(defn js-select-shape
  [ctx form]
  (if (js-select-form? form)
    (let [source-expr (second form)
          keys-expr (nth-or form 2 nil)
          source-path (expr-jsonb-path ctx source-expr)
          source-shape (source-root-shape ctx source-path)
          field-keys (js-keys-form->keywords keys-expr)]
      (if (and (types/jsonb-shape? source-shape)
               (> (count field-keys) 0))
        (types/make-jsonb-shape
         (reduce (fn [out key]
                   (assoc out key (source-field-info ctx source-path key :->)))
                 {}
                 field-keys)
         (:source-table source-shape)
         (:confidence source-shape)
         (:nullable? source-shape))
        nil))
    nil))

(defn expr-jsonb-path
  [ctx expr]
  (cond (types/jsonb-path? expr) expr
        (symbol? expr) (types/get-var-path ctx expr)
        :else (let [descriptor (access-descriptor ctx expr)]
                (if descriptor (:path descriptor) nil))))

(defn set-binding-descriptors
  [source-path binding]
  (reduce (fn [out entry]
            (cond (typed-binding-form? entry)
                  (let [field-key (symbol->field-key (second entry))]
                    (if field-key
                      (conj out
                            {:var (second entry)
                             :path (append-path source-path field-key)
                             :binding-type {:kind :cast :type (first entry)}
                             :field-info (field-info (first entry))})
                      out))
                  (symbol? entry)
                  (let [field-key (symbol->field-key entry)]
                    (if field-key
                      (conj out
                            {:var entry
                             :path (append-path source-path field-key)
                             :binding-type :jsonb
                             :field-info (field-info :jsonb)})
                      out))
                  :else out))
          []
          binding))

(defn binding-descriptors
  [ctx binding expr]
  (let [source-path (expr-jsonb-path ctx expr)
        access (access-descriptor ctx expr)]
    (cond (and (set? binding) source-path)
          (set-binding-descriptors source-path binding)
          (symbol? binding)
          (if source-path
            [{:var binding
              :path source-path
              :binding-type :jsonb
              :field-info (if (> (count (:segments source-path)) 0)
                            (field-info :jsonb)
                            nil)}]
            [])
          (typed-binding-form? binding)
          (let [path (or (:path access) source-path)]
            (if path
              [{:var (second binding)
                :path path
                :binding-type {:kind :cast :type (first binding)}
                :field-info (field-info (first binding))}]
              []))
          :else [])))

(defn- descriptor-shape-build
  [field-value remaining]
  (let [segment (first remaining)
        tail (vec (rest remaining))]
    (types/make-jsonb-shape
     {segment (if (> (count tail) 0)
                (field-info :jsonb
                            {:shape (descriptor-shape-build field-value tail)})
                field-value)})))

(defn descriptor-shape
  [descriptor]
  (let [path (:path descriptor)
        field-value (:field-info descriptor)
        segments (if path (vec (:segments path)) [])]
    (if (> (count segments) 0)
      (descriptor-shape-build field-value segments)
      nil)))

(defn update-root-shape
  [ctx descriptor]
  (let [shape-add (if descriptor (descriptor-shape descriptor) nil)]
    (if shape-add
      (let [root-var (get-in descriptor [:path :root-var])
            current (get-in ctx [:jsonb-shapes root-var])]
        (update ctx
                :jsonb-shapes
                assoc
                root-var
                (types/merge-shapes (or current (types/empty-jsonb-shape))
                                    shape-add)))
      ctx)))

(defn apply-descriptor
  [ctx descriptor]
  (let [updated (update-root-shape ctx descriptor)]
    (if (:var descriptor)
      (types/add-binding updated
                         (:var descriptor)
                         (:binding-type descriptor)
                         :path (:path descriptor)
                         :shape (types/get-var-shape updated (:var descriptor)))
      updated)))

(defn apply-descriptors
  [ctx descriptors]
  (reduce apply-descriptor ctx descriptors))

(declare scan-form)

(defn js-keys-form->keywords
  [form]
  (let [values
        (cond (vector? form) form
              (and (list? form)
                   (symbol? (first form))
                   (= "js" (name (first form)))
                   (vector? (second form)))
              (second form)
              :else nil)]
    (if (vector? values)
      (reduce (fn [out value]
                (cond (string? value)
                      (conj out (keyword (str/replace value "_" "-")))
                      (keyword? value)
                      (conj out (keyword (str/replace (name value) "_" "-")))
                      :else out))
              []
              values)
      nil)))

(defn js-select-descriptors
  [ctx form]
  (if (js-select-form? form)
    (let [source-path (expr-jsonb-path ctx (second form))
          field-keys (js-keys-form->keywords (nth-or form 2 nil))]
      (if (and source-path (> (count field-keys) 0))
        (map (fn [key]
               {:path (append-path source-path key)
                :field-info (source-field-info ctx source-path key :->)})
             field-keys)
        nil))
    nil))

(defn analyze-binding
  [ctx pair]
  (let [binding (first pair)
        expr (second pair)
        scanned (scan-form ctx expr)
        projected-shape (js-select-shape scanned expr)
        source-name (if (and projected-shape
                             (js-select-form? expr)
                             (symbol? (second expr)))
                      (second expr)
                      nil)
        with-binding (if (and projected-shape (symbol? binding))
                       (types/add-binding scanned binding :jsonb :shape projected-shape)
                       scanned)
        with-source (if source-name
                      (types/add-binding with-binding
                                         source-name
                                         :jsonb
                                         :shape projected-shape)
                      with-binding)]
    (apply-descriptors with-source
                       (binding-descriptors with-source binding expr))))

(defn- collection-form?
  [form]
  (or (vector? form) (map? form) (set? form)))

(defn scan-form
  [ctx form]
  (cond (list? form)
        (let [accesses (if (accessor-expr? form)
                         (access-descriptors ctx form)
                         [])
              selections (or (js-select-descriptors ctx form) [])
              scanned (apply-descriptors ctx (concat accesses selections))]
          (if (and (= 'let (first form))
                   (vector? (second form)))
            (let [bound (reduce analyze-binding scanned (partition 2 (second form)))]
              (reduce scan-form bound (drop 2 form)))
            (reduce scan-form scanned form)))
        (collection-form? form) (reduce scan-form ctx form)
        :else ctx))

(defn infer-jsonb-arg-access-shape
  ([arg-name fn-def]
   (infer-jsonb-arg-access-shape arg-name fn-def nil nil))
  ([arg-name fn-def seed-shape]
   (infer-jsonb-arg-access-shape arg-name fn-def seed-shape nil))
  ([arg-name fn-def seed-shape role]
   (if (= :track role)
     nil
     (let [body (or (get-in fn-def [:body-meta :raw-body]) [])
           shapes (if seed-shape {arg-name seed-shape} {})
           ctx (types/make-context
                {arg-name :jsonb}
                shapes
                {arg-name (types/make-jsonb-path [] arg-name)})
           out (reduce scan-form ctx body)
           inferred (types/get-var-shape out arg-name)]
       (if (and inferred (> (count (:fields inferred)) 0))
         (assoc inferred :confidence :medium :nullable? true)
         nil)))))

(def __tahto_load__ true)
