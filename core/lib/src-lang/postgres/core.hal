(ns postgres.core
  (:require [postgres.core.addon]
            [postgres.core.builtin]
            [postgres.core.graph :as graph]
            [postgres.core.graph-view :as graph-view]
            [postgres.core.impl :as impl]
            [postgres.gen.bind-macro :as bind]
            [postgres.application :as app]
            [std.foundation
             :exclude [abs assert case concat count format max min mod name
                       replace repeat reverse bit-and bit-or]]))

(std.foundation/intern-all postgres.core.builtin
              postgres.core.addon)

(std.foundation/intern-in impl/t:select
             impl/t:get-field
             impl/t:get
             impl/t:id
             impl/t:count
             impl/t:exists
             impl/t:delete
             impl/t:insert
             impl/t:insert-untracked
             impl/t:upsert
             impl/t:update
             impl/t:update-untracked
             impl/t:modify
             impl/t:fields
             graph/g:where
             graph/g:id
             graph/g:count
             graph/g:exists
             graph/g:select
             graph/g:get
             graph/g:update
             graph/g:modify
             graph/g:delete
             graph/g:insert
             graph/q
             graph/q:get
             graph/view
             graph-view/defsel.pg
             graph-view/defret.pg
             bind/bind-app
             bind/bind-schema
             app/app-create
             app/app-list
             app/app
             app/app-rebuild
             app/app-clear
             app/app-schema
             app/app-typed
             app/app-reset)

(def __tahto_load__ true)
