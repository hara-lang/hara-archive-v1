(ns postgres.core.impl-insert
  (:config {:blank true})
  (:require [std.foundation :refer [= apply assoc concat conj count deref ex filter first get has? into keys list map map? merge nil? not nth reduce second sort-by symbol? vec vector? with-meta]]
            [postgres.core.impl-base :as base]
            [lang.common.util :as util]))

(defn- schema-attrs [table-schema key]
  (let [entry (get table-schema key)]
    (if (vector? entry) (first entry) entry)))

(defn- ordered-keys [table-schema keys]
  (sort-by (fn [key] (or (:order (schema-attrs table-schema key)) 1000000)) keys))

(defn- usable-key? [table-schema key]
  (let [attrs (schema-attrs table-schema key)]
    (and attrs (not (:ignore attrs)) (not (nil? (:order attrs))))))

(defn t-insert-form [table-schema keys values]
  [(list '>-< (vec (map (fn [key] #{(base/t-key-fn table-schema key)}) keys)))
   :values
   (list '>-< (vec values))])

(defn t-insert-symbol [table-schema sym columns params options]
  (let [keys (ordered-keys table-schema
                           (filter (fn [key] (usable-key? table-schema key))
                                   (or columns (keys table-schema))))
        values (map (fn [key]
                      (base/t-val-fn table-schema key
                                     (base/t-sym-fn table-schema key sym)
                                     params options))
                    keys)]
    (t-insert-form table-schema keys values)))

(defn t-insert-map [table-schema input params options]
  (base/t-input-check table-schema input (merge {:missing false} params))
  (let [keys (ordered-keys table-schema
                           (filter (fn [key] (usable-key? table-schema key))
                                   (keys input)))
        values (map (fn [key]
                      (base/t-val-fn table-schema key (get input key) params options))
                    keys)]
    (t-insert-form table-schema keys values)))

(defn t-insert-record [table-sym data params]
  [:select '* :from (list 'jsonb-populate-record (list '++ nil table-sym) data)])

(defn t-insert-raw [prepared data params]
  (let [entry (first prepared)
        table-schema (second prepared)
        options (nth prepared 2)
        table-sym (base/table-symbol entry)
        as (get params :as :json)
        requested (:returning params)
        defaults (reduce (fn [out key]
                           (let [attrs (schema-attrs table-schema key)]
                             (if (and (:order attrs) (not (:ignore attrs)))
                               (conj out key) out)))
                         #{} (keys table-schema))
        returning (base/t-returning table-schema
                                    (or requested
                                        (when (or (not (has? #{:record :raw} as))
                                                  (:into params))
                                          defaults)))
        pair (cond (map? data) ['to-jsonb (t-insert-map table-schema data params options)]
                   (symbol? data)
                   (if (= :record as)
                     ['to-jsonb (t-insert-record table-sym data params)]
                     ['to-jsonb (t-insert-symbol table-schema data (:columns params)
                                                 params options)])
                   :else (throw (ex :database {:input data} :ex/message "Invalid data type")))
        form (into [:insert-into table-sym] (second pair))
        extended (base/t-wrap-args form (:args params) {})
        returned (base/t-wrap-returning extended returning {})
        json (base/t-wrap-json returned as (first pair) (:into params) nil)]
    (with-meta (base/t-wrap-into json (:into params) {}) {:op/type :insert})))

(defn t-insert
  ([spec data params]
   (t-insert spec data params nil))
  ([spec data params caller-ns]
   (t-insert-raw (base/prep-table spec false {:caller-ns caller-ns})
                 data (or params {}))))

(defn t-upsert-raw [prepared data params]
  (let [table-schema (second prepared)
        primary (vec
                 (filter (fn [key]
                           (:primary (schema-attrs table-schema key)))
                         (ordered-keys table-schema (keys table-schema))))
        data-keys (reduce (fn [out key] (conj out key)) #{}
                          (if (map? data) (keys data) (keys table-schema)))
        excluded-update (set (or (:exclude-update params) #{}))
        update-keys (reduce (fn [out key]
                              (let [attrs (schema-attrs table-schema key)]
                                (if (and (has? data-keys key)
                                         (usable-key? table-schema key)
                                         (not (:primary attrs))
                                         (not (has? excluded-update key)))
                                  (conj out key) out)))
                            [] (ordered-keys table-schema (keys table-schema)))
        columns (base/t-returning-cols table-schema
                                       update-keys
                                       base/t-key-attrs-fn)
        row (map (fn [column key]
                   (or (get (:on-update params) key)
                       (list 'pg:raw
                             (str "EXCLUDED.\"" (first column) "\""))))
                 columns update-keys)
        requested-conflict (or (:on-conflict params) primary)
        conflict-keys (if (set? requested-conflict)
                        (ordered-keys table-schema requested-conflict)
                        requested-conflict)
        conflict-columns (base/t-returning-cols table-schema
                                                conflict-keys
                                                base/t-key-attrs-fn)
        conflict (list '>-< conflict-columns)
        args (if (= 0 (count update-keys))
               [:on-conflict conflict :do-nothing]
               (vec (concat [:on-conflict conflict :do-update :set
                             (list '>-< columns) :=]
                            [(apply list 'row row)])))]
    (with-meta (t-insert-raw prepared data (assoc params :args args))
               {:op/type :upsert})))

(defn t-upsert
  ([spec data params]
   (t-upsert spec data params nil))
  ([spec data params caller-ns]
   (t-upsert-raw (base/prep-table spec false {:caller-ns caller-ns})
                 data (or params {}))))

(def __tahto_load__ true)
