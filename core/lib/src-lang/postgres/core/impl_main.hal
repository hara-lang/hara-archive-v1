(ns postgres.core.impl-main
  (:require [std.foundation :refer [= conj count deref filter first get has? keys list list? map? merge nil? not not= nth reduce second set? vec vector?]]
            [postgres.core.impl-base :as base]
            [lang.common.util :as util]))

(defn- collection-value? [value]
  (or (list? value) (vector? value) (set? value) (map? value)))

(defn- default-returning [table-schema]
  (reduce (fn [out key] (conj out key)) #{} (keys table-schema)))

(defn t-select-raw
  [prepared params]
  (let [entry (first prepared)
        table-schema (second prepared)
        options (nth prepared 2)
        table-sym (base/table-symbol entry)
        as (get params :as :json)
        requested (:returning params)
        returning (if base/*skip-checks*
                    (if (collection-value? requested)
                      (base/t-returning-cols-default requested (:key-fn params))
                      requested)
                    (base/t-returning
                     table-schema
                     (or requested (if (= :raw as) '* (default-returning table-schema)))
                     (:key-fn params)))
        single (:single params)
        json-output (if single 'to-jsonb 'jsonb-agg)
        limit (if single 1 (:limit params))
        selected [:select returning :from table-sym]
        joined (base/t-wrap-join
                selected
                (base/t-join-transform table-schema (or (:join params) []) table-sym options)
                {:newline true})
        filtered (base/t-wrap-where joined (:where params) table-schema
                                    {:newline true :where-args (:where-args params)} options)
        grouped (base/t-wrap-group-by filtered (:group-by params) {:newline true})
        having (base/t-wrap-having grouped (:having params) table-schema
                                   {:newline true} options)
        ordered (base/t-wrap-order-by having (:order-by params) table-schema {:newline true})
        sorted (base/t-wrap-order-sort ordered (:order-sort params) table-schema {})
        limited (base/t-wrap-limit sorted limit {:newline true})
        offset (base/t-wrap-offset limited (:offset params) {})
        locked (base/t-wrap-lock offset (:for params) {:newline true})
        extended (base/t-wrap-args locked (:args params) {})
        json (base/t-wrap-json extended as json-output (:into params) (:field params))]
    (with-meta (base/t-wrap-into json (:into params) {}) {:op/type :select})))

(defn t-select
  ([spec params]
   (t-select spec params nil))
  ([spec params caller-ns]
   (t-select-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-id-raw [prepared params]
  (with-meta
    (list 'pg:scalar
          (t-select-raw prepared
                        (merge {:single true :as :raw :returning #{:id}} params)))
    {:op/type :id}))

(defn t-id
  ([spec params]
   (t-id spec params nil))
  ([spec params caller-ns]
   (t-id-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-count-raw [prepared params]
  (with-meta
    (list 'pg:scalar
          (t-select-raw prepared (merge {:as :raw :returning '(count *)} params)))
    {:op/type :count}))

(defn t-count
  ([spec params]
   (t-count spec params nil))
  ([spec params caller-ns]
   (t-count-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-exists-raw [prepared params]
  (with-meta (list 'pg:scalar
                   [:select (list 'exists
                                  (t-select-raw prepared
                                                (merge {:as :raw :returning 1}
                                                       params)))])
             {:op/type :exists}))

(defn t-exists
  ([spec params]
   (t-exists spec params nil))
  ([spec params caller-ns]
   (t-exists-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-delete-raw [prepared params]
  (let [entry (first prepared)
        table-schema (second prepared)
        options (nth prepared 2)
        table-sym (base/table-symbol entry)
        as (get params :as :json)
        returning (base/t-returning
                   table-schema
                   (or (:returning params)
                       (when (not= :raw as) (default-returning table-schema))))
        base-form [:delete :from table-sym]
        filtered (base/t-wrap-where base-form (:where params) table-schema {} options)
        extended (base/t-wrap-args filtered (:args params) {})
        returned (base/t-wrap-returning extended returning {:newline true})
        json-output (if (:single params) 'to-jsonb 'jsonb-agg)
        json (base/t-wrap-json returned as json-output (:into params) nil)]
    (with-meta (base/t-wrap-into json (:into params) {}) {:op/type :delete})))

(defn t-delete
  ([spec params]
   (t-delete spec params nil))
  ([spec params caller-ns]
   (t-delete-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-fields-raw [prepared params]
  (let [table-schema (second prepared)
        scope (:scope params)]
    (if scope
      (vec (filter (fn [key]
                     (let [attrs (first (get table-schema key))]
                       (has? (or (:scope attrs) #{}) scope)))
                   (keys table-schema)))
      (reduce (fn [out key]
                (let [attrs (first (get table-schema key))]
                  (if (and (not (:primary attrs)) (:order attrs))
                    (conj out (symbol (util/sym-default-str key)))
                    out)))
              []
              (keys table-schema)))))

(defn t-fields
  ([spec params]
   (t-fields spec params nil))
  ([spec params caller-ns]
   (t-fields-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(def __tahto_load__ true)
