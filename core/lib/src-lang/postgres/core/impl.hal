(ns postgres.core.impl
  (:config {:blank true})
  (:require [lang.core :as l]
            [std.foundation :refer :all]
            [postgres.core.impl-main :as main]
            [postgres.core.impl-insert :as insert]
            [postgres.core.impl-update :as update]))

(l/script :postgres
  postgres.core
  {:macro-only true})

(defmacro.xt t:select [spec params] (main/t-select spec (or params {})))

(defn- require-where [params]
  (when (nil? (:where params))
    (throw (ex :hara/database (assoc params :ex/message "No WHERE clause"))))
  params)

(defmacro.xt t:get-field [spec params]
  (with-meta (list 'pg:scalar
                   (main/t-select spec (merge {:single true :as :raw}
                                              (require-where (or params {})))))
             {:op/type :get}))

(defmacro.xt t:get [spec params]
  (with-meta (list 'pg:scalar
                   (main/t-select spec (merge {:single true}
                                              (require-where (or params {})))))
             {:op/type :get}))

(defmacro.xt t:id [spec params]
  (main/t-id spec (require-where (or params {}))))

(defmacro.xt t:count [spec params] (main/t-count spec (or params {})))
(defmacro.xt t:exists [spec params] (main/t-exists spec (or params {})))
(defmacro.xt t:delete [spec params] (main/t-delete spec (or params {})))
(defmacro.xt t:insert
  ([spec data] (insert/t-insert spec data {}))
  ([spec data params] (insert/t-insert spec data (or params {}))))
(defmacro.xt t:insert-untracked
  ([spec data] (insert/t-insert spec data {:track :ignore}))
  ([spec data params]
   (insert/t-insert spec data (merge {:track :ignore} (or params {})))))
(defmacro.xt t:upsert
  ([spec data] (insert/t-upsert spec data {}))
  ([spec data params] (insert/t-upsert spec data (or params {}))))
(defmacro.xt t:update [spec params] (update/t-update spec (or params {})))
(defmacro.xt t:update-untracked [spec params]
  (update/t-update spec (merge {:track :ignore :as :raw} (or params {}))))
(defmacro.xt t:modify [spec params] (update/t-modify spec (or params {})))
(defmacro.xt t:fields [spec params] (main/t-fields spec (or params {})))

(def __tahto_load__ true)
