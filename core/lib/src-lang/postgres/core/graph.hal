(ns postgres.core.graph
  (:config {:blank true})
  (:require [lang.core :as l]
            [std.foundation :refer :all]
            [postgres.core.graph-base :as base]
            [postgres.core.graph-insert :as insert]
            [postgres.core.graph-query :as query]
            [postgres.core.graph-view :as view]))

(l/script :postgres
  postgres.core
  {:macro-only true})

(defmacro.xt g:where [spec where]
  (when (or (nil? where) (empty? where))
    (throw (ex :hara/database (assoc {:where where} :ex/message "No WHERE clause"))))
  (base/id-where-fn spec {:where where}))

(defmacro.xt g:id [spec params]
  (when (nil? (:where params))
    (throw (ex :hara/database (assoc params :ex/message "No WHERE clause"))))
  (base/id-fn spec (or params {})))

(defmacro.xt g:count [spec params] (base/count-fn spec (or params {})))
(defmacro.xt g:exists [spec params] (base/exists-fn spec (or params {})))
(defmacro.xt g:select [spec params] (base/select-fn spec (or params {})))

(defmacro.xt g:get [spec params]
  (when (nil? (:where params))
    (throw (ex :hara/database (assoc params :ex/message "No WHERE clause"))))
  (with-meta (base/select-fn spec (merge {:single true} params))
             {:op/type :get}))

(defmacro.xt g:update [spec params] (base/update-fn spec (or params {})))
(defmacro.xt g:modify [spec params] (base/modify-fn spec (or params {})))
(defmacro.xt g:delete [spec params] (base/delete-fn spec (or params {})))
(defmacro.xt g:insert [spec data params] (insert/insert-fn spec data (or params {})))
(defmacro.xt q [spec params] (query/query-fn spec (or params {})))

(defmacro.xt q:get [spec params]
  (with-meta (query/query-fn spec (merge (or params {}) {:single true}))
             {:op/type :get}))

(defmacro.xt view [return-view select-view options]
  (view/view-form return-view select-view options))

(def __tahto_load__ true)
