(ns postgres.core.addon
  (:require [lang.core :as l]
            [std.foundation :as foundation :exclude [case name assert]]
            [std.lib.collection :as collection]))

(l/script :postgres
  postgres.core
  {:macro-only true})

(defn- resolved-entry
  [table]
  (let [resolved (if (symbol? table) (foundation/resolve table) nil)
        value (if resolved (deref resolved) table)]
    (if (map? value)
      value
      (throw (ex :database {:table table :value value} :ex/message "PostgreSQL entity metadata is unavailable")))))

(defn- entry-id
  [entry]
  (let [value (:id entry)]
    (if (and (list? value) (= 'quote (first value)))
      (second value)
      value)))

(defmacro.pg exec
  "Emits an SQL statement unchanged."
  [args]
  args)

(defmacro.pg ARRAY
  "Creates a PostgreSQL ARRAY literal."
  [& args]
  (apply list 'pg:array args))

(defmacro.pg id
  "Gets the id field from a JSON object."
  [value & [type]]
  (list (or type :uuid) (list :->> value "id")))

(defmacro.pg name
  "Returns an entity's database identifier."
  [table]
  (str (entry-id (resolved-entry table))))

(defmacro.pg full
  "Returns an entity's [schema name] coordinate."
  [table]
  (let [entry (resolved-entry table)]
    [(:static/schema entry) (str (entry-id entry))]))

(defn full-str
  "Returns an entity coordinate as compact JSON."
  [table]
  (let [entry (resolved-entry table)]
    (str "[\"" (:static/schema entry) "\",\"" (entry-id entry) "\"]")))

(defmacro.pg coord
  "Returns an entity row coordinate."
  [table row-id]
  (let [entry (resolved-entry table)]
    (list 'jsonb-build-array
          (:static/schema entry)
          (str (entry-id entry))
          row-id)))

(defmacro.pg rand-hex
  [n]
  (list 'encode (list 'gen-random-bytes (list '/ n 2)) "hex"))

(defmacro.pg sha1
  [text]
  (list 'encode (list 'digest (list :bytea text) "sha1") "hex"))

(defmacro.pg client-list
  []
  [:select '* :from 'pg_stat_activity])

(defmacro.pg time-ms
  []
  (list :bigint (list '* 1000 (list 'extract ['epoch :from (list 'now)]))))

(defmacro.pg time-us
  []
  (list :bigint (list '* 1000000 (list 'extract ['epoch :from (list 'now)]))))

(defmacro.pg throw
  [value]
  (list 'pg:throw value nil))

(defmacro.pg error
  [value]
  (list 'pg:throw
        (if (map? value)
          (apply collection/ordered-map
                 (concat [:status "error"] (mapcat identity (seq value))))
          (collection/ordered-map :status "error" :value value))
        nil))

(defmacro.pg assert
  [check [tag data]]
  (list 'pg:assert check tag data))

(defmacro.pg case
  [& args]
  (let [pairs (partition 2 args)
        block (mapcat (fn [pair]
                        (let [check (first pair)
                              body (second pair)]
                          (if (= :else check)
                            [:else (list :% body) \\]
                            [:when (list :% check) :then (list :% body) \\])))
                      pairs)]
    (list '% (vec (concat [:case] block [:end])))))

(defmacro.pg get-stack-diagnostics
  []
  (list 'pg:stack-diagnostics))

(defmacro.pg field-id
  [value field]
  (list 'coalesce
        (list :->> value (str field "_id"))
        (list :->> (list :-> value field) "id")))

(defmacro.pg map:rel
  [f rel & args]
  [(list 'jsonb-agg (apply list f 'o-ret args))
   :from rel :as 'o-ret])

(defmacro.pg map:js-text
  [f arr & args]
  [(list 'coalesce
         (list 'jsonb-agg (apply list f 'o-ret args))
         (list 'jsonb-build-array))
   \\ :from (list 'jsonb-array-elements-text arr) :as 'o-ret])

(defmacro.pg map:js
  [f arr & args]
  [(list 'coalesce
         (list 'jsonb-agg (apply list f 'o-ret args))
         (list 'jsonb-build-array))
   \\ :from (list 'jsonb-array-elements arr) :as 'o-ret])

(defmacro.pg do:reduce
  [out f type arr]
  (list 'pg:reduce out f type arr))

(defmacro.pg b:select [& args] (vec (concat [:select] args)))
(defmacro.pg ret [& args] (vec (concat [:select] args)))
(defmacro.pg b:update [& args] (vec (concat [:update] args)))
(defmacro.pg b:insert [& args] (vec (concat [:insert] args)))
(defmacro.pg b:delete [& args] (vec (concat [:delete] args)))
(defmacro.pg perform [& args] (vec (concat [:perform] args)))

(defmacro.pg random-enum
  [enum]
  [:select 'p :from (list 'unnest (list 'enum-range (list '++ nil enum)))
   :as 'p :order-by (list 'random) :limit 1])

(defmacro.pg do:plpgsql
  [& forms]
  (apply list 'pg:do-plpgsql forms))

(def __tahto_load__ true)
