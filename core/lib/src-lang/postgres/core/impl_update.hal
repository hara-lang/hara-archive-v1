(ns postgres.core.impl-update
  (:config {:blank true})
  (:require [std.foundation :refer [= apply assoc concat conj count deref ex filter first get has? into keys list map map? merge nil? not not= nth reduce second seq sort-by symbol? vec vector? with-meta]]
            [postgres.core.impl-base :as base]
            [lang.common.util :as util]))

(defn- attrs [schema key]
  (let [entry (get schema key)] (if (vector? entry) (first entry) entry)))

(defn- ordered-keys [schema keys]
  (sort-by (fn [key] (or (:order (attrs schema key)) 1000000)) keys))

(defn- assert-valid-keys [schema keys]
  (let [invalid (filter (fn [key] (nil? (get schema key))) keys)]
    (when (seq invalid) (throw (ex :database {:keys (vec invalid)} :ex/message "Invalid columns")))))

(defn t-update-symbol [schema sym params options]
  (let [columns (or (:columns params)
                    (reduce (fn [out key]
                              (let [a (attrs schema key)]
                                (if (and (:order a) (not (:primary a)) (not (:ignore a)))
                                  (conj out key) out))) [] (keys schema)))]
    (assert-valid-keys schema columns)
    (let [keys (ordered-keys schema columns)
          values (map (fn [key]
                        (let [value (base/t-sym-fn schema key sym)]
                          (if (false? (:coalesce params))
                            value
                            (list 'coalesce value #{(base/t-key-fn schema key)}))))
                      keys)]
      (list '==
            (list '>-< (vec (map (fn [key]
                                   #{(base/t-key-fn schema key)})
                                 keys)))
            (apply list 'row values)))))

(defn t-update-map [schema input params options]
  (assert-valid-keys schema (keys input))
  (let [keys (ordered-keys schema
                           (filter (fn [key] (not (:ignore (attrs schema key))))
                                   (keys input)))]
    (list '==
          (list '>-< (vec (map (fn [key]
                                 #{(base/t-key-fn schema key)})
                               keys)))
          (apply list 'row
                 (map (fn [key]
                        (base/t-val-fn schema key (get input key) params options))
                      keys)))))

(defn t-update-raw [prepared params]
  (let [entry (first prepared)
        schema (second prepared)
        options (nth prepared 2)
        table-sym (base/table-symbol entry)
        as (get params :as :json)
        defaults (reduce (fn [out key]
                           (let [a (attrs schema key)]
                             (if (and (:order a) (not (:ignore a))) (conj out key) out)))
                         #{} (keys schema))
        returning (base/t-returning schema
                                    (or (:returning params)
                                        (when (not= :raw as) defaults)))
        update-form (if (map? (:set params))
                      (t-update-map schema (:set params) params options)
                      (t-update-symbol schema (:set params) params options))
        form [:update table-sym :set update-form]
        filtered (base/t-wrap-where form (:where params) schema {} options)
        extended (base/t-wrap-args filtered (:args params) {})
        returned (base/t-wrap-returning extended returning {:newline true})
        json-output (if (:single params) 'to-jsonb 'jsonb-agg)
        json (base/t-wrap-json returned as json-output (:into params) nil)]
    (with-meta (base/t-wrap-into json (:into params) {}) {:op/type :update})))

(defn t-update
  ([spec params]
   (t-update spec params nil))
  ([spec params caller-ns]
   (t-update-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(defn t-modify-assign [prepared params target]
  (let [entry (first prepared)
        schema (second prepared)
        table-sym (base/table-symbol entry)
        as (get params :as :json)
        single (get params :single true)
        returning (base/t-returning schema (or (:returning params) '*))
        form (t-update-raw prepared
                           (merge params {:returning returning :as :raw :into 'u-ret}))
        assertion '(if [:not (exists [:select u-ret])]
                     [:raise-exception (% "Record Not Found")])
        json-output (if single 'to-jsonb 'jsonb-agg)
        body (when target
               [:select (if (has? #{:json :jsonb} as)
                          (list json-output 'u-ret) 'u-ret)
                :into target])]
    (list 'let [(list '++ 'u-ret table-sym) form '_ assertion] body)))

(defn t-modify-raw [prepared params]
  (with-meta (t-modify-assign prepared params (:into params))
             {:assign/fn 'postgres.core.impl-update/t-modify-assign}))

(defn t-modify
  ([spec params]
   (t-modify spec params nil))
  ([spec params caller-ns]
   (t-modify-raw (base/prep-table spec false {:caller-ns caller-ns}) params)))

(def __tahto_load__ true)
