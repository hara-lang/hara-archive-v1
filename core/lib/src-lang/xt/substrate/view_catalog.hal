(ns xt.substrate.view-catalog "Portable view component catalog for xt.substrate.view maps.\n\n   The catalog is the shared grammar consumed by view validation and by the\n   React (@xtalk/figma-ui) and Wind platform backends. Styling is expressed\n   exclusively through Tailwind class strings in the \"class\" prop; palette,\n   spacing and layout do not appear as grammar props. `variant` exists only\n   where the target kit API is variant-based (button/badge/alert) and maps to\n   the shared class bundles in each entry's \"variants\" table.\n\n   Bands: \"core\" components are implemented on both platforms, \"extended\"\n   components are admitted once a Wind equivalent exists, and \"platform\"\n   components (`fg/` prefixed ids) lower directly to @xtalk/figma-ui on web\n   and are rejected by portable validation and the Wind backend." (:require [lang.core :as l]))

(l/script :xtalk {:require [[xt.lang.spec-base :as xt] [xt.lang.common-string :as xts]]})

(def$.xt PLATFORM_PREFIX "fg/")

(def$.xt COMMON_PROPS {"hidden" {"type" "boolean"} "class" {"type" "string"} "id" {"type" "string"} "aria_label" {"type" "string"}})

(def$.xt COMPONENTS {"ui/table-header" {"kind" "container" "band" "core"} "ui/separator" {"kind" "layout" "band" "core"} "ui/button" {"variants" {"default" "bg-slate-900 text-white" "ghost" "text-slate-900" "secondary" "bg-slate-100 text-slate-900" "link" "text-blue-600 underline underline-offset-4" "outline" "border border-slate-300 bg-white text-slate-900" "destructive" "bg-red-600 text-white"} "props" {"size" {"type" "string"} "variant" {"type" "string"} "value" {"type" "string"} "pending" {"type" "boolean"} "disabled" {"type" "boolean"}} "kind" "action" "band" "core" "events" {"on_press" {"path" nil}}} "ui/column" {"kind" "layout" "band" "core"} "ui/table" {"kind" "container" "band" "core"} "ui/icon" {"props" {"value" {"type" "string"}} "kind" "display" "band" "core"} "ui/textarea" {"props" {"value" {"type" "string"} "placeholder" {"type" "string"} "read_only" {"type" "boolean"} "rows" {"type" "number"} "disabled" {"type" "boolean"}} "kind" "input" "band" "core" "events" {"on_change" {"path" ["value"]}}} "ui/card-title" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/card-content" {"kind" "container" "band" "core"} "ui/label" {"props" {"for" {"type" "string"} "value" {"type" "string"}} "kind" "text" "band" "core"} "ui/spinner" {"props" {"value" {"type" "string"}} "kind" "display" "band" "core"} "ui/row" {"kind" "layout" "band" "core"} "ui/title" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/card-footer" {"kind" "container" "band" "core"} "ui/table-cell" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/table-body" {"kind" "container" "band" "core"} "ui/table-head" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/card-description" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/input" {"props" {"value" {"type" "string"} "placeholder" {"type" "string"} "read_only" {"type" "boolean"} "type" {"type" "string"} "disabled" {"type" "boolean"}} "kind" "input" "band" "core" "events" {"on_change" {"path" ["value"]}}} "ui/card-header" {"kind" "container" "band" "core"} "ui/card" {"kind" "container" "band" "core"} "ui/fragment" {"kind" "layout" "band" "core"} "ui/badge" {"variants" {"default" "bg-slate-900 text-white" "secondary" "bg-slate-100 text-slate-900" "outline" "border border-slate-300 text-slate-900" "destructive" "bg-red-600 text-white"} "props" {"variant" {"type" "string"} "value" {"type" "string"}} "kind" "display" "band" "core"} "ui/scroll" {"kind" "layout" "band" "core"} "ui/text" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/description" {"props" {"value" {"type" "string"}} "kind" "text" "band" "core"} "ui/alert" {"variants" {"default" "border-slate-200 bg-white text-slate-900" "destructive" "border-red-200 bg-red-50 text-red-700"} "props" {"variant" {"type" "string"}} "kind" "display" "band" "core"} "ui/table-row" {"kind" "container" "band" "core"} "ui/image" {"props" {"src" {"type" "string" "required" true} "alt" {"type" "string"}} "kind" "display" "band" "core"}})

(defn.xt platform-id? "checks whether a component id is a platform (figma) escape id" [component-id] (return (xts/starts-with? component-id -/PLATFORM_PREFIX)))

(defn.xt entry "returns the catalog entry for a portable component id" [component-id] (return (xt/x:get-key -/COMPONENTS component-id)))

(defn.xt has-component? "checks whether a component id is in the portable catalog" [component-id] (return (xt/x:not-nil? (xt/x:get-key -/COMPONENTS component-id))))

(defn.xt band "returns the band of a component id: core, extended or platform" [component-id] (when (-/platform-id? component-id) (return "platform")) (var e (-/entry component-id)) (when (xt/x:nil? e) (return nil)) (return (. e ["band"])))

(defn.xt portable? "checks whether a component id is portable across platforms" [component-id] (if (-/platform-id? component-id) (return false) (return (xt/x:not-nil? (-/entry component-id)))))

(defn.xt variant-classes "returns the shared Tailwind class bundle for a component variant" [component-id variant] (var e (-/entry component-id)) (when (xt/x:nil? e) (return nil)) (var #{variants} e) (when (xt/x:nil? variants) (return nil)) (return (xt/x:get-key variants variant)))

(defn.xt validate-action "validates an event action descriptor against the grammar" [component-id prop value] (when (not (xt/x:is-object? value)) (xt/x:err (xt/x:cat "view event requires an action descriptor - " component-id " - " prop))) (when (not (xt/x:is-string? (. value ["action"]))) (xt/x:err (xt/x:cat "view event requires an action id - " component-id " - " prop))) (var #{payload} value) (when (and (xt/x:is-object? payload) (xt/x:has-key? payload "$")) (when (not= "event" (. payload ["$"])) (xt/x:err (xt/x:cat "invalid view event projection - " component-id " - " prop))) (when (not (xt/x:is-array? (. payload ["path"]))) (xt/x:err (xt/x:cat "view event projection requires a path - " component-id " - " prop)))) (return true))

(defn.xt validate-prop-type [component-id prop spec value] (var #{type} spec) (var ok true) (cond (== type "string") (:= ok (xt/x:is-string? value)) (== type "number") (:= ok (xt/x:is-number? value)) (== type "boolean") (:= ok (xt/x:is-boolean? value)) :else (:= ok true)) (when (not ok) (xt/x:err (xt/x:cat "invalid view prop type - " component-id " - " prop " - " type))) (return true))

(defn.xt validate-props "validates the props of a portable component node against the catalog" [component-id props] (var e (-/entry component-id)) (var eprops (. e ["props"])) (var #{events} e) (xt/for:object [[prop value] (or props {})] (cond (xt/x:has-key? (or events {}) prop) (-/validate-action component-id prop value) (xt/x:has-key? -/COMMON_PROPS prop) (-/validate-prop-type component-id prop (xt/x:get-key -/COMMON_PROPS prop) value) (xt/x:has-key? (or eprops {}) prop) (do (-/validate-prop-type component-id prop (xt/x:get-key eprops prop) value) (when (== prop "variant") (var #{variants} e) (when (and (xt/x:not-nil? variants) (not (xt/x:has-key? variants value))) (xt/x:err (xt/x:cat "unknown view variant - " component-id " - " value))))) :else (xt/x:err (xt/x:cat "unknown view prop - " component-id " - " prop)))) (xt/for:object [[prop spec] (or eprops {})] (when (and (== true (. spec ["required"])) (not (xt/x:has-key? (or props {}) prop))) (xt/x:err (xt/x:cat "missing required view prop - " component-id " - " prop)))) (return true))
