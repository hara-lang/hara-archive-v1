(ns xt.substrate.base-frame
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.lang.common-string :as str]]})

(def ^{:schema [:xt/record
   ["kind" :xt/str]
   ["id" :xt/str]
   ["space" :xt/str]
   ["meta" [:xt/maybe [:xt/dict :xt/str :xt/any]]]
   ["action" [:xt/maybe :xt/str]]
   ["args" [:xt/maybe [:xt/array :xt/any]]]
   ["reply_to" [:xt/maybe :xt/str]]
   ["status" [:xt/maybe :xt/str]]
   ["data" [:xt/maybe :xt/any]]
   ["error" [:xt/maybe :xt/any]]
   ["signal" [:xt/maybe :xt/str]]
   ["cause" [:xt/maybe :xt/any]]]} NodeFrame nil)

(def$.xt KIND_REQUEST  "request")
(def$.xt KIND_RESPONSE "response")
(def$.xt KIND_STREAM   "stream")

(def$.xt STATUS_OK    "ok")
(def$.xt STATUS_ERROR "error")

(def$.xt SPACE_NODE "__NODE__")

(defn.xt ^{:schema [:fn [[:xt/maybe :xt/str] :xt/int] :xt/str]} rand-id
  "creates a simple random id"
  {:added "4.1"}
  [prefix n]
  (return (xt/x:cat (or prefix "")
                    (str/str-rand n))))

(defn.xt ^{:schema [:fn [:xt/str
        :xt/str
        [:xt/maybe :xt/str]
        [:xt/maybe [:xt/dict :xt/str :xt/any]]
        [:xt/maybe [:xt/dict :xt/str :xt/any]]]
       NodeFrame]} frame
  "constructs a base node frame"
  {:added "4.1"}
  [kind id space meta extra]
  (return
   (xt/x:obj-assign
    {:kind kind
     :id id
     :space (or space -/SPACE_NODE)
     :meta (or meta {})}
    (or extra {}))))

(defn.xt ^{:schema [:fn [[:xt/maybe :xt/str]
        :xt/str
        [:xt/maybe [:xt/array :xt/any]]
        [:xt/maybe [:xt/dict :xt/str :xt/any]]]
       NodeFrame]} request-frame
  "constructs a request frame"
  {:added "4.1"}
  [space action args meta]
  (:= meta (or meta {}))
  (return
    (-/frame -/KIND_REQUEST
             (or (xt/x:get-key meta "id")
                 (-/rand-id "req-" 6))
            space
            meta
            {:action action
             :args (or args [])})))

(defn.xt ^{:schema [:fn [:xt/str
        [:xt/maybe :xt/str]
        :xt/str
        :xt/any
        [:xt/maybe :xt/any]
        [:xt/maybe [:xt/dict :xt/str :xt/any]]]
       NodeFrame]} response-frame
  "constructs a response frame"
  {:added "4.1"}
  [reply-to space status data error meta]
  (:= meta (or meta {}))
  (return
    (-/frame -/KIND_RESPONSE
             (or (xt/x:get-key meta "id")
                 (-/rand-id "res-" 6))
            space
            meta
            {:reply_to reply-to
             :status status
             :data data
             :error error})))

(defn.xt ^{:schema [:fn [:xt/str
        [:xt/maybe :xt/str]
        :xt/any
        [:xt/maybe [:xt/dict :xt/str :xt/any]]]
       NodeFrame]} response-ok-frame
  "constructs a successful response frame"
  {:added "4.1"}
  [reply-to space data meta]
  (return (-/response-frame reply-to space -/STATUS_OK data nil meta)))

(defn.xt ^{:schema [:fn [:xt/str
        [:xt/maybe :xt/str]
        :xt/any
        [:xt/maybe [:xt/dict :xt/str :xt/any]]]
       NodeFrame]} response-error-frame
  "constructs an errored response frame"
  {:added "4.1"}
  [reply-to space error meta]
  (return (-/response-frame reply-to space -/STATUS_ERROR nil error meta)))

(defn.xt ^{:schema [:fn [[:xt/maybe :xt/str]
        :xt/str
        :xt/any
        [:xt/maybe [:xt/dict :xt/str :xt/any]]
        [:xt/maybe :xt/any]]
       NodeFrame]} stream-frame
  "constructs a publish frame"
  {:added "4.1"}
  [space signal data meta cause]
  (:= meta (or meta {}))
  (return
    (-/frame -/KIND_STREAM
             (or (xt/x:get-key meta "id")
                 (-/rand-id "evt-" 6))
            space
            meta
            {:signal signal
             :data data
             :cause cause})))

(defn.xt ^{:schema [:fn [NodeFrame] :xt/bool]} request-frame?
  "checks if a frame is a request"
  {:added "4.1"}
  [frame]
  (return (== -/KIND_REQUEST
              (. frame ["kind"]))))

(defn.xt ^{:schema [:fn [NodeFrame] :xt/bool]} response-frame?
  "checks if a frame is a response"
  {:added "4.1"}
  [frame]
  (return (== -/KIND_RESPONSE
              (. frame ["kind"]))))

(defn.xt ^{:schema [:fn [NodeFrame] :xt/bool]} stream-frame?
  "checks if a frame is a stream"
  {:added "4.1"}
  [frame]
  (return (== -/KIND_STREAM
              (. frame ["kind"]))))
