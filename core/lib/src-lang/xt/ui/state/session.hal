(ns xt.ui.state.session "Platform-neutral authentication and access projection without routing." (:require [lang.core :as l]))

(l/script :xtalk {:require [[xt.lang.spec-base :as xt]]})

(defn.xt project [session profile capabilities] (return {"profile" (or profile {}) "capabilities" (or capabilities {}) "authenticated" (== true (. (or session {}) ["authenticated"])) "user_id" (. (or session {}) ["user_id"])}))

(defn.xt capable? [state capability-id] (return (== true (xt/x:get-path state ["capabilities" capability-id]))))
