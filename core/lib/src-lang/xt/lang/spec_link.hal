(ns xt.lang.spec-link
  (:require [lang.core :as l]))

(l/script :xtalk)

(defmacro.xt ^{:standalone true
                 :schema [:fn [:xt/str :xt/int :xt/any :xt/any] :xt/any]}
  x:socket-connect
  {:added "4.1"}
  ([host port opts cb] (list (quote x:socket-connect) host port opts cb)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [:xt/any :xt/any] :xt/int]}
  x:socket-send
  {:added "4.1"}
  ([conn bytes] (list (quote x:socket-send) conn bytes)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [:xt/any] :xt/any]}
  x:socket-close
  {:added "4.1"}
  ([conn] (list (quote x:socket-close) conn)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [:xt/str :xt/num :xt/any :xt/str :xt/str :xt/any] :xt/any]}
  x:notify-http
  "posts encoded values through fetch"
  {:added "4.1"}
  ([host port value id key opts] (list (quote x:notify-http) host port value id key opts)))
