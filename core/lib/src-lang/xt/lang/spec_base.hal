                 :schema [:fn [:xt/any] :xt/string]}
  x:type-native
  "expands and emits the lua type helper"
  {:added "4.1"}
  ([value] (list (quote x:type-native) value)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [:xt/int] :xt/int]}
  x:offset
  "uses the grammar base offset"
  {:added "4.1"}
  ([] (list (quote x:offset)))
