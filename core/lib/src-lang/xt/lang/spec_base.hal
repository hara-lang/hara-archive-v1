(ns xt.lang.spec-base
  (:require [lang.core :as l]))

(l/script :xtalk)

(defmacro.xt ^{:standalone true} x:bytes-new {:added "4.1"}
  ([values] (list 'x:bytes-new values)))

(defmacro.xt ^{:standalone true} x:bytes-count {:added "4.1"}
  ([value] (list 'x:bytes-count value)))

(defmacro.xt ^{:standalone true} x:bytes-get {:added "4.1"}
  ([value idx] (list 'x:bytes-get value idx)))

(defmacro.xt ^{:standalone true} x:bytes-set {:added "4.1"}
  ([value idx byte] (list 'x:bytes-set value idx byte)))

(defmacro.xt ^{:standalone true} x:bytes-copy {:added "4.1"}
  ([value] (list 'x:bytes-copy value)))

(defmacro.xt ^{:standalone true} x:bytes-slice {:added "4.1"}
  ([value start] (list 'x:bytes-slice value start))
  ([value start end] (list 'x:bytes-slice value start end)))

(defmacro.xt ^{:standalone true} x:bytes-u8 {:added "4.1"}
  ([value] (list 'x:bytes-u8 value)))

(defmacro.xt ^{:standalone true} x:bytes-s8 {:added "4.1"}
  ([value] (list 'x:bytes-s8 value)))

(defmacro.xt ^{:standalone true} x:str-encode {:added "4.1"}
  ([value] (list 'x:str-encode value)))

(defmacro.xt ^{:standalone true} x:str-decode {:added "4.1"}
  ([value] (list 'x:str-decode value)))

(defmacro.xt ^{:standalone true} x:bit-not {:added "4.1"}
  ([value] (list 'x:bit-not value)))

(defmacro.xt ^{:style/indent 1}
  for:array
  "iterates arrays in order"
  {:added "4.1"}
  ([[e arr] & body]
   (apply list 'for:array [e arr] body)))

(defmacro.xt ^{:style/indent 1}
  for:object
  "iterates object key value pairs"
  {:added "4.1"}
  ([[[k v] obj] & body]
   (apply list 'for:object [[k v] obj] body)))

(defmacro.xt ^{:style/indent 1}
  for:index
  "iterates a numeric range"
  {:added "4.1"}
  ([[i range] & body]
   (apply list 'for:index [i range] body)))

(defmacro.xt ^{:style/indent 1}
  for:iter
  "expands to the canonical iterator form"
  {:added "4.1"}
  ([[e it] & body]
   (apply list 'for:iter [e it] body)))

(defmacro.xt ^{:standalone true}
  proto:get
  "retrieves object prototypes"
  {:added "4.1"}
  ([obj] (list (quote proto:get) obj)))

(defmacro.xt ^{:standalone true}
  proto:set
  "assigns object prototypes"
  {:added "4.1"}
  ([obj proto] (list (quote proto:set) obj proto)))

(defmacro.xt ^{:standalone true}
  proto:create
  "creates prototypes with this-bound methods"
  {:added "4.1"}
  ([m] (list (quote proto:create) m)))

(defmacro.xt ^{:standalone true}
  proto:method
  "looks up a key on an object, falling back to its attached protocol"
  {:added "4.1"}
  ([obj key] (list (quote proto:method) obj key)))

(defmacro.xt ^{:standalone true}
  proto:tostring
  "expands and emits the lua tostring metamethod key"
  {:added "4.1"}
  ([] (list (quote proto:tostring))))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/fn]] :xt/any]}
  x:async-run
  "executes a thunk in the host async model and adopts its result"
  {:added "4.1"}
  ([thunk] (list (quote x:async-run) thunk)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any] :xt/int :xt/any] :xt/any]}
  x:get-idx
  "reads the first indexed value"
  {:added "4.1"}
  ([arr idx] (list (quote x:get-idx) arr idx))
  ([arr idx default] (list (quote x:get-idx) arr idx default)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any] :xt/int] :xt/self]}
  x:set-idx
  "writes an indexed value"
  {:added "4.1"}
  ([arr idx value] (list (quote x:set-idx) arr idx value)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any]] :xt/any]}
  x:first
  "gets the first array element"
  {:added "4.1"}
  ([arr] (list (quote x:first) arr)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any]] :xt/any]}
  x:second
  "gets the second array element"
  {:added "4.1"}
  ([arr] (list (quote x:second) arr)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any]] :xt/any]}
  x:last
  "gets the last array element"
  {:added "4.1"}
  ([arr] (list (quote x:last) arr)))

(defmacro.xt ^{:standalone true
                 :schema [:fn [[:xt/array :xt/any]] :xt/any]}
  x:second-last
  "gets the element before the last"
  {:added "4.1"}
  ([arr] (list (quote x:second-last) arr)))

