;;
;; FN.BASIC
;;

(defn.xt ^{:schema [:fn [] :xt/nil]} noop
  "always a no op"
  {:added "4.1"}
  [] (return nil))

(defn.xt ^{:schema [:fn [:xt/any] :xt/any]} identity
  "identity function"
  {:added "4.0"}
  ([x] (return x)))

(defn.xt ^{:schema [:fn [:xt/any] :xt/bool]} T
  "always true"
  {:added "4.1"}
  [x] (return true))

(defn.xt ^{:schema [:fn [:xt/any] :xt/bool]} F
  "always false"
  {:added "4.1"}
  [x] (return false))

