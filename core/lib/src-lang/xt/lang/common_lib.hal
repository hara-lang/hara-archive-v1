;;
;; CALLBACK
;;

(defn.xt ^{:schema [:fn [[:xt/dict :xt/str :xt/any] :xt/str]
        [:fn [:xt/any] :xt/any]]} wrap-callback
  "returns a wrapped callback given map"
  {:added "4.0"}
  [callbacks key]
  (when (xt/x:nil? callbacks)
    (:= callbacks {}))
  (var result-fn
       (fn [result]
         (var f (xt/x:get-key callbacks key))
         (if (xt/x:not-nil? f)
           (return (xt/x:apply f [result]))
           (return result))))
  (return result-fn))

;;
;; RETURN
;;

(defn.xt return-encode
  "returns the encoded"
  {:added "4.0"}
  [out id key]
  (return
   (xt/x:return-encode out id key)))

(defn.xt return-wrap
  "returns a wrapped call"
  {:added "4.0"}
  [f]
  (return
   (xt/x:return-wrap f -/return-encode)))

(defn.xt return-eval
  "evaluates a returns a string"
  {:added "4.0"}
  [s]
  (return
   (xt/x:return-eval s -/return-wrap)))
