(ns xt.lang.common-lib
  (:config {:override [identity nil? inc dec zero? pos? neg? even? odd?]})
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]]})

;;
;; TYPE
;;

(defn.xt ^{:schema [:fn [:xt/any] :xt/str]} type-native
  "gets the native type"
  {:added "4.0"}
  ([obj]
   (return (xt/x:type-native obj))))

(defn.xt ^{:schema [:fn [:xt/any] :xt/str]} type-class
  "gets the type of an object"
  {:added "4.1"}
  ([x]
   (var ntype (-/type-native x))
   (if (xt/x:is-object? x)
     (return (xt/x:get-key x "::" "object"))
     (return ntype))))

(defn.xt ^{:schema [:fn [:xt/num] :xt/str]} to-string
  "converts an object into a string"
  {:added "4.0"}
  ([x] (return (xt/x:to-string x))))

(defn.xt ^{:schema [:fn [:xt/str] :xt/num]} to-number
  "converts a string to a number"
  {:added "4.0"}
  ([x] (return (xt/x:to-number x))))

