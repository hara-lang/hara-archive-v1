(ns xt.lang.common-resource
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as common-data]
             [xt.lang.common-string :as xts]]})

(def ^{:schema [:fn [:xt/any :xt/str] :xt/any]} XTWatchFn nil)

(def ^{:schema [:xt/dict :xt/str XTWatchFn]} XTWatchMap nil)

(def ^{:schema [:xt/record
   ["value" :xt/any]
   ["watch" XTWatchMap]]} XTItem nil)

(def ^{:schema [:xt/dict :xt/str XTItem]} XTSpace nil)

(def ^{:schema [:xt/dict :xt/str :xt/any]} XTConfigMap nil)

(def ^{:schema [:xt/dict :xt/str XTSpace]} XTSpacesMap nil)

(def ^{:schema :xt/any} XTLookup nil)

(def ^{:schema [:xt/record
   ["lookup" XTLookup]
   ["counter" :xt/num]]} XTHash nil)

(def ^{:schema [:xt/record
   ["::" :xt/str]
   ["config" XTConfigMap]
   ["spaces" XTSpacesMap]
   ["hash" XTHash]]} XTState nil)

(def ^{:schema [:fn [] XTState]} xt nil)

(defn.xt ^{:schema [:fn [] :xt/bool]} xt-exists?
  "checks that the xt map exists"
  {:added "4.0"}
  []
  (return (xt/x:global-has? XT)))

(defn.xt ^{:schema [:fn [] XTState]} xt-create
  "creates an empty xt structure"
  {:added "4.0"}
  []
  (return {"::" "xt"
           :config   {}
           :spaces   {}
           :hash     {:lookup   (xt/x:lu-create)
                      :counter  18652613}}))

(defn.xt
  xt-ensure
  "gets the current xt or creates a new one"
  {:added "4.0"}
  []
  (if (xt/x:global-has? XT)
    (return (!:G XT))
    (do (xt/x:global-set XT (-/xt-create))
        (return (!:G XT)))))

(defn.xt
  ^{:schema [:fn [] [:xt/maybe XTState]]} xt-current
  "gets the current xt"
  {:added "4.0"}
  []
  (if (xt/x:global-has? XT)
    (return (!:G XT))
    (return nil)))

(defn.xt ^{:schema [:fn [] [:xt/maybe XTState]]} xt-purge
  "empties the current xt"
  {:added "4.0"}
  []
  (if (xt/x:global-has? XT)
    (do (var out (!:G XT))
        (xt/x:global-del XT)
        (return out))
    (return nil)))

(defn.xt ^{:schema [:fn [] [:xt/tuple :xt/bool XTConfigMap]]} xt-purge-config
  "clears all `:config` entries"
  {:added "4.0"}
  []
  (var g (-/xt-ensure))
  (var prev (xt/x:get-key g "config"))
  (xt/x:set-key g "config" {})
  (return [true prev]))

(defn.xt ^{:schema [:fn [] [:xt/tuple :xt/bool XTSpacesMap]]} xt-purge-spaces
  "clears all `:spaces` entries"
  {:added "4.0"}
  []
  (var g (-/xt-ensure))
  (var prev (xt/x:get-key g "spaces"))
  (xt/x:set-key g "spaces" {})
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/any] [:xt/maybe :xt/num]]} xt-lookup-id
  "gets the runtime id for pointer-like objects"
  {:added "4.0"}
  [obj]
  (when (or (xt/x:is-function? obj)
            (xt/x:is-object? obj)
            (xt/x:is-array? obj))
    (var current (-/xt-ensure))
    (var hash (xt/x:get-key current "hash"))
    (var lookup (xt/x:get-key hash "lookup"))
    (var counter (xt/x:get-key hash "counter"))
    (var hash-id (xt/x:lu-get lookup obj))
    (when (xt/x:nil? hash-id)
      (xt/x:set-key hash "counter" (+ 1 counter))
      (xt/x:lu-set lookup obj counter)
      (return counter))
    (return hash-id)))

;;
;; CONFIG
;;

(defn.xt ^{:schema [:fn [] [:xt/array :xt/str]]} xt-config-list
  "lists all config entries in the xt"
  {:added "4.0"}
  []
  (var g (-/xt-ensure))
  (var config (xt/x:get-key g "config"))
  (return (common-data/obj-keys config)))

(defn.xt ^{:schema [:fn [:xt/str :xt/any]
   [:xt/tuple :xt/bool [:xt/maybe :xt/any]]]} xt-config-set
  "sets the config for a module"
  {:added "4.0"}
  [module m]
  (var g (-/xt-ensure))
  (var config (xt/x:get-key g "config"))
  (var prev (xt/x:get-key config module))
  (xt/x:set-key config module m)
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/tuple :xt/bool [:xt/maybe :xt/any]]]} xt-config-del
  "deletes a single xt config entry"
  {:added "4.0"}
  [module]
  (var g (-/xt-ensure))
  (var config (xt/x:get-key g "config"))
  (var prev (xt/x:get-key config module))
  (xt/x:del-key config module)
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/str] [:xt/maybe :xt/any]]} xt-config
  "gets a config entry"
  {:added "4.0"}
  [module]
  (var g (-/xt-ensure))
  (var config (xt/x:get-key g "config"))
  (return (xt/x:get-key config module)))

;;
;; SPACE
;;

(defn.xt ^{:schema [:fn [] [:xt/array :xt/str]]} xt-space-list
  "lists all spaces in the xt"
  {:added "4.0"}
  []
  (var g (-/xt-ensure))
  (var spaces (xt/x:get-key g "spaces"))
  (return (common-data/obj-keys spaces)))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/tuple :xt/bool [:xt/maybe XTSpace]]]} xt-space-del
  "deletes a space"
  {:added "4.0"}
  [module]
  (var g (-/xt-ensure))
  (var spaces (xt/x:get-key g "spaces"))
  (var prev  (xt/x:get-key spaces module))
  (when (xt/x:not-nil? prev)
    (xt/x:del-key spaces module))
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/str] XTSpace]} xt-space
  "gets a space"
  {:added "4.0"}
  [module]
  (var g (-/xt-ensure))
  (var spaces (xt/x:get-key g "spaces"))
  (var curr  (xt/x:get-key spaces module))
  (when (xt/x:nil? curr)
    (:= curr {})
    (xt/x:set-key spaces module curr))
  (return curr))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/tuple :xt/bool [:xt/maybe XTSpace]]]} xt-space-clear
  "clears all items in the space"
  {:added "4.0"}
  [module]
  (var g (-/xt-ensure))
  (var spaces (xt/x:get-key g "spaces"))
  (var prev  (xt/x:get-key spaces module))
  (xt/x:set-key spaces module {})
  (return [true prev]))

;;
;; ITEM
;;

(defn.xt ^{:schema [:fn [:xt/str :xt/str]
   [:xt/tuple :xt/bool [:xt/maybe XTItem]]]} xt-item-del
  "deletes a single item in the space"
  {:added "4.0"}
  [module key]
  (var space (-/xt-space module))
  (var prev (xt/x:get-key space key))
  (when (xt/x:not-nil? prev)
    (xt/x:del-key space key))
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/str :xt/str]
   [:xt/maybe [:xt/array :xt/str]]]} xt-item-trigger
  "triggers as item"
  {:added "4.0"}
  [module key]
  (var space (-/xt-space module))
  (var prev  (xt/x:get-key space key))
  (when (xt/x:not-nil? prev)
    (var value (xt/x:get-key prev "value"))
    (var watch (xt/x:get-key prev "watch"))
    (for:object [[watch-key watch-fn] watch]
      (watch-fn value (xt/x:cat module "/" key)))
    (return (common-data/obj-keys watch))))

(defn.xt ^{:schema [:fn [:xt/str :xt/str :xt/any]
   [:xt/tuple :xt/bool XTItem]]} xt-item-set
  "sets a single item in the space"
  {:added "4.0"}
  [module key value]
  (var space (-/xt-space module))
  (var prev  (xt/x:get-key space key))
  (when (xt/x:nil? prev)
    (:= prev {:watch {}})
    (xt/x:set-key space key prev))
  (xt/x:set-key prev "value" value)
  (var watch (xt/x:get-key prev "watch"))
  (for:object
   [[watch-key watch-fn] watch]
   (watch-fn value (xt/x:cat module "/" key)))
  (return [true prev]))

(defn.xt ^{:schema [:fn [:xt/str :xt/str]
   [:xt/maybe :xt/any]]} xt-item
  "gets an xt item by module and key"
  {:added "4.0"}
  [module key]
  (var space (-/xt-space module))
  (var curr  (xt/x:get-key space key))
  (when curr
    (return (xt/x:get-key curr "value")))
  (return nil))

(defn.xt ^{:schema [:fn [:xt/str :xt/str [:fn [] :xt/any]]
   :xt/any]} xt-item-get
  "gets an xt item or sets a default if not exist"
  {:added "4.0"}
  [module key init-fn]
  (var space (-/xt-space module))
  (var curr (xt/x:get-key space key))
  (cond curr
        (return (xt/x:get-key curr "value"))

        :else
        (do (var value (init-fn))
            (xt/x:set-key space key {:value value
                                  :watch {}})
            (return value))))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/maybe XTItem]]} xt-var-entry
  "gets the var entry"
  {:added "4.0"}
  [sym]
  (var pair (xts/sym-pair sym))
  (var [module key] pair)
  (var space (-/xt-space module))
  (return (xt/x:get-key space key)))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/maybe :xt/any]]} xt-var
  "gets an xt item

   (!.lua
    (rt/xt-var \"-/hello\"))"
  {:added "4.0"}
  [sym]
  (var pair (xts/sym-pair sym))
  (var [module key] pair)
  (return (-/xt-item module key)))

(defn.xt ^{:schema [:fn [:xt/str :xt/any]
   [:xt/tuple :xt/bool [:xt/maybe XTItem]]]} xt-var-set
  "sets the var"
  {:added "4.0"}
  [sym value]
  (var pair (xts/sym-pair sym))
  (var [module key] pair)
  (if (xt/x:nil? value)
    (return (-/xt-item-del module key))
    (return (-/xt-item-set module key value))))

(defn.xt ^{:schema [:fn [:xt/str]
   [:xt/maybe [:xt/array :xt/str]]]} xt-var-trigger
  "triggers the var"
  {:added "4.0"}
  [sym]
  (var pair (xts/sym-pair sym))
  (var [module key] pair)
  (return (-/xt-item-trigger module key)))

(defn.xt ^{:schema [:fn [:xt/str :xt/str XTWatchFn]
   :xt/bool]} xt-add-watch
  "adds a watch"
  {:added "4.0"}
  [sym watch-key watch-fn]
  (var entry (-/xt-var-entry sym))
  (when entry
    (var watch (xt/x:get-key entry "watch"))
    (xt/x:set-key watch watch-key watch-fn)
    (return true))
  (return false))

(defn.xt ^{:schema [:fn [:xt/str :xt/str]
   :xt/bool]} xt-remove-watch
  "removes a watch"
  {:added "4.0"}
  [sym watch-key]
  (var entry (-/xt-var-entry sym))
  (when entry
    (var watch (xt/x:get-key entry "watch"))
    (xt/x:del-key watch watch-key)
    (return true))
  (return false))

(defn defsingleton-fn
  "helper function for defsingleton macros"
  {:added "4.0"}
  [&form tag sym-id doc? attrs? more]
  (let [sym-ns (or (get (meta sym-id) :ns)
                   (str (ns-current)))
        sym-id (if (vector? sym-id)
                 (first sym-id)
                 sym-id)
        sym-key (str sym-id)
        supplied (concat (if (nil? doc?) [] [doc?])
                         (if (nil? attrs?) [] [attrs?])
                         more)
        supplied (if (string? (first supplied)) (rest supplied) supplied)
        supplied (if (map? (first supplied)) (rest supplied) supplied)
        body (if (vector? (first supplied)) supplied (first supplied))
        def-sym (symbol (str "defn." tag))
        symbol-meta (merge (meta &form) (meta sym-id))
        getter (with-meta sym-id symbol-meta)
        resetter (with-meta (symbol (str sym-id "-reset")) symbol-meta)]
    [(list def-sym
           getter
           []
           (list (quote return)
                 (list (quote xt.lang.common-resource/xt-item-get)
                       sym-ns
                       sym-key
                       (apply list (quote fn) body))))
     (list def-sym
           resetter
           (vec [(quote val)])
           (list (quote return)
                 (list (quote xt.lang.common-resource/xt-var-set)
                       (str sym-ns "/" sym-key)
                       (quote val))))]))

(defmacro defsingleton.xt
  "shortcut for a xt getter and a reset var"
  {:added "4.0"}
  [sym-id & [doc? attrs? & more]]
  (defsingleton-fn &form "xt" sym-id doc? attrs? more))

(defmacro defsingleton.js
  "shortcut for a js getter and a reset var"
  {:added "4.0"}
  [sym-id & [doc? attrs? & more]]
  (defsingleton-fn &form "js" sym-id doc? attrs? more))

(defmacro defsingleton.lua
  "shortcut for a lua getter and a reset var"
  {:added "4.0"}
  [sym-id & [doc? attrs? & more]]
  (defsingleton-fn &form "lua" sym-id doc? attrs? more))

(defmacro defsingleton.py
  "TODO"
  {:added "4.0"}
  [sym-id & [doc? attrs? & more]]
  (defsingleton-fn &form "python" sym-id doc? attrs? more))
