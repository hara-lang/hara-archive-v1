  ([value] (list (quote x:m-loge) value)))

(def ^{:schema [:fn [:xt/num] :xt/num]} log10 nil)

(defmacro.xt ^{:standalone true} 
  log10
  ([value] (list (quote x:m-log10) value)))

(def ^{:schema [:fn [:xt/num :xt/num] :xt/num]} max nil)

(defmacro.xt ^{:standalone true} 
  max
  ([x y & more] (apply list (quote x:m-max) x y more)))

(def ^{:schema [:fn [:xt/num :xt/num] :xt/num]} mod nil)

(defmacro.xt ^{:standalone true} 
  mod
  ([x y] (list (quote x:m-mod) x y)))

(def ^{:schema [:fn [:xt/num :xt/num] :xt/num]} min nil)

(defmacro.xt ^{:standalone true} 
  min
  ([x y & more] (apply list (quote x:m-min) x y more)))

