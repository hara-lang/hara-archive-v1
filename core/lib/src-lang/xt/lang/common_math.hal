(defmacro.xt ^{:standalone true} 
  pow
  ([x y] (list (quote x:m-pow) x y)))

(def ^{:schema [:fn [:xt/num :xt/num] :xt/num]} quot nil)

(defmacro.xt ^{:standalone true} 
  quot
  ([x y] (list (quote x:m-quot) x y)))

(def ^{:schema [:fn [:xt/num] :xt/num]} sin nil)

(defmacro.xt ^{:standalone true} 
  sin
  ([value] (list (quote x:m-sin) value)))

