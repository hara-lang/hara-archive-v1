(defmacro.xt ^{:standalone true} 
  tan
  ([value] (list (quote x:m-tan) value)))

(def ^{:schema [:fn [:xt/num] :xt/num]} tanh nil)

(defmacro.xt ^{:standalone true} 
  tanh
  ([value] (list (quote x:m-tanh) value)))

(defn.xt ^{:schema [:fn [:xt/num :xt/num] :xt/num]} mod-pos
  "gets the positive mod"
  {:added "4.1"}
  [val modulo]
  (var out (x:m-mod val modulo))
  (return
   (:? (< out 0)
       (+ out modulo)
       out)))

(defn.xt ^{:schema [:fn [:xt/num :xt/num :xt/num] :xt/num]} mod-offset
  "calculates the closest offset"
  {:added "4.1"}
  [pval nval modulo]
  (var offset (x:m-mod (- nval pval) modulo))
  (cond (> (x:m-abs offset)
           (/ modulo 2))
        (cond (> offset 0)
              (return (- offset modulo))
              :else
              (return (+ offset modulo)))
        :else
        (return offset)))

(defn.xt ^{:schema [:fn [:xt/num :xt/num] :xt/num]} gcd
  "greatest common denominator"
  {:added "4.1"}
  [a b]
  (return (:? (== 0 b)
              a
              (-/gcd b (mod a b)))))

(defn.xt ^{:schema [:fn [:xt/num :xt/num] :xt/num]} lcm
  "lowest common multiple"
  {:added "4.1"}
  [a b]
  (return (/ (* a b)
             (-/gcd a b))))

(defn.xt ^{:schema [:fn [:xt/num :xt/num :xt/num] :xt/num]} mix
  "mixes two values with a fraction"
  {:added "4.1"}
  [x0 x1 v]
  (return (+ x0 (* (- x1 x0)
                   v))))

(defn.xt ^{:schema [:fn [:xt/num] :xt/num]} sign
  "gets the sign"
  {:added "4.1"}
  [x]
  (cond (== x 0) (return 0)
        (< x 0)  (return -1)
        :else    (return 1)))

(defn.xt ^{:schema [:fn [:xt/num] :xt/num]} round
  "rounds to the nearest integer"
  {:added "4.1"}
  [x]
  (return (xt/x:m-floor (+ x 0.5))))

(defn.xt ^{:schema [:fn [:xt/num :xt/num :xt/num] :xt/num]} clamp
  "clamps a value between min and max"
  {:added "4.1"}
  [min max v]
  (cond (< v min)
        (return min)
        (< max v)
        (return max)
        :else
        (return v)))
