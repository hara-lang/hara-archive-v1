(ns xt.lang.common-math
  (:config {:override [round]})
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]]})

(def ^{:schema [:fn [:xt/num] :xt/num]} abs nil)

(defmacro.xt ^{:standalone true} 
  abs
  ([value] (list (quote x:m-abs) value)))

(def ^{:schema [:fn [:xt/num] :xt/num]} acos nil)

(defmacro.xt ^{:standalone true} 
  acos
  ([value] (list (quote x:m-acos) value)))

(def ^{:schema [:fn [:xt/num] :xt/num]} asin nil)

(defmacro.xt ^{:standalone true} 
  asin
  ([value] (list (quote x:m-asin) value)))

