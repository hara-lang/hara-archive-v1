(ns postgres.application.internal-test
  (:require [postgres.application.internal :as subject]
            [lang.core.script :as script])
  (:use code.test))

^{:refer postgres.application.internal/*applications*}
(fact "owns a mutable application registry"
  (let [original (deref subject/*applications*)
        result
        (try
          [(atom? subject/*applications*)
           (subject/app-reset)
           (deref subject/*applications*)]
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [true {} {}])

^{:refer postgres.application.internal/application-string}
(fact "formats application table names deterministically"
  (subject/application-string
   {:tables {'users/User {} 'posts/Post {}}})
  => "#pg.app [2]\nposts/Post users/User\n"

  (subject/application-string {:tables {}})
  => "#pg.app [0]\n\n")

^{:refer postgres.application.internal/app-list-entries}
(fact "lists application table entries or returns nil for an empty application"
  [(subject/app-list-entries {:tables {'demo/User {}}})
   (subject/app-list-entries {:tables {}})]
  => [['demo/User] nil])

^{:refer postgres.application.internal/app-get-entry}
(fact "gets a table from the application schema tree"
  (subject/app-get-entry
   {:schema {:tree {"User" {:id :user}}}}
   'User)
  => {:id :user})

^{:refer postgres.application.internal/app-get-deps}
(fact "collects referenced module names from a table definition"
  (subject/app-get-deps
   {:tables
    {'users/User
     [{:ref {:ns 'ignored.module}}
      {:ref {:ns 'required.module}}]}}
   'users/User)
  => '#{required.module})

^{:refer postgres.application.internal/application-member?}
(fact "matches scalar and collection application membership"
  [(subject/application-member? ["public" "admin"] "admin")
   (subject/application-member? '("public" "admin") "public")
   (subject/application-member? #{"public"} "missing")
   (subject/application-member? "public" "public")
   (subject/application-member? "public" "admin")]
  => [true true false true false])

^{:refer postgres.application.internal/app-modules}
(fact "selects registered modules for an application without global-state leakage"
  (let [original (deref script/+modules+)
        module-name 'postgres.application.internal-test/module
        module {:id module-name :static {:application ["internal-app"]}}
        result
        (try
          (reset! script/+modules+ {module-name module})
          (subject/app-modules "internal-app")
          (finally
            (reset! script/+modules+ original)))]
    result)
  => [{:id 'postgres.application.internal-test/module
       :static {:application ["internal-app"]}}])

^{:refer postgres.application.internal/link-attributes}
(fact "adds a resolved link descriptor to reference attributes"
  [(subject/link-attributes
    {:type :ref :ref {:key 'demo/Account}}
    {'demo {:id 'Account :module 'demo :lang :postgres :section :code}})
   (subject/link-attributes
    {:type :ref :ref {:key 'demo/Missing}}
    {})]
  => [{:type :ref
       :ref {:key 'demo/Account
             :link {:id 'Account :module 'demo :lang :postgres :section :code}}}
      {:type :ref :ref {:key 'demo/Missing}}])

^{:refer postgres.application.internal/table-schema}
(fact "assigns column order while preserving link information"
  (subject/table-schema
   [:id {:type :uuid :primary true}
    :account-id {:type :ref :ref {:key 'demo/Account}}]
   {'demo {:id 'Account :module 'demo}})
  => {:id [{:type :uuid :primary true} 0]
      :account-id [{:type :ref
                    :ref {:key 'demo/Account
                          :link {:id 'Account :module 'demo}}}
                   1]})

^{:refer postgres.application.internal/schema-from-tables}
(fact "builds the named schema tree for application tables"
  (subject/schema-from-tables
   {'demo/User [:id {:type :uuid :primary true}]}
   {})
  => {:tree {"User" {:id [{:type :uuid :primary true} 0]}}})

^{:refer postgres.application.internal/app-create-raw}
(fact "creates linked schema, pointers, ordering, and typed application data"
  (let [links {'Account {:id 'Account
                         :module 'demo
                         :lang :postgres
                         :section :code}}
        application
        (subject/app-create-raw
         {'demo/User
          [:id {:type :uuid :primary true}
           :account-id {:type :ref :ref {:key :Account/id}}]}
         links
         {:tables {} :enums {} :functions {}})]
    [(get-in application [:schema :tree "User" :account-id 0 :ref :link])
     (get-in application [:schema :tree "User" :account-id 1])
     (:lu application)
     (:typed application)])
  => [{:id 'Account :module 'demo :lang :postgres :section :code}
      1
      {:demo/User 0}
      {:tables {} :enums {} :functions {}}])

^{:refer postgres.application.internal/definition-name}
(fact "extracts definition names from forms"
  [(subject/definition-name '(deftype User []))
   (subject/definition-name '(defn.pg save []))
   (subject/definition-name {})]
  => ["deftype" "defn.pg" nil])

^{:refer postgres.application.internal/module-analysis}
(fact "indexes typed table, enum, and function definitions in a module"
  (let [analysis
        (subject/module-analysis
         {:id 'demo.application
          :code
          {'ping
           {:form-input
            '(defn.pg ^{:- [:text]} ping [] "pong")}}})]
    [(count (:tables analysis))
     (count (:enums analysis))
     (count (:functions analysis))
     (get-in analysis [:functions 0 :name])])
  => [0 0 1 "ping"])

^{:refer postgres.application.internal/module-typed}
(fact "creates typed indexes from analyzed modules"
  (let [module-typed
        (subject/module-typed
         [{:id 'demo.application
           :code
           {'ping
            {:form-input
             '(defn.pg ^{:- [:text]} ping [] "pong")}}}])]
    [(count (:tables module-typed))
     (count (:enums module-typed))
     (count (:functions module-typed))])
  => [0 0 1])

^{:refer postgres.application.internal/app-create-typed}
(fact "merges typed table and module analysis"
  (let [module {:id 'demo.application
                :code
                {'ping
                 {:form-input
                  '(defn.pg ^{:- [:text]} ping [] "pong")}}}
        typed-info
        (subject/app-create-typed
         {'demo.application/User [:id {:type :uuid :primary true}]}
         [module])]
    [(count (:tables typed-info))
     (count (:enums typed-info))
     (count (:functions typed-info))])
  => [1 0 1])

^{:refer postgres.application.internal/entry-table-pairs}
(fact "reads table pairs from vector, tree, map, and raw definition seeds"
  (let [columns [:id {:type :uuid :primary true}]]
    [(subject/entry-table-pairs
      {:static/schema-seed {:vec [:User columns]}})
     (subject/entry-table-pairs
      {:static/schema-seed {:tree {:User columns}}})
     (subject/entry-table-pairs
      {:static/schema-seed {:User columns}})
     (subject/entry-table-pairs
      {:id 'User
       :op 'deftype
       :form-input '(deftype User [:id {:type :uuid}])})])
  => [[[:User [:id {:type :uuid :primary true}]]]
      [[:User [:id {:type :uuid :primary true}]]]
      [[:User [:id {:type :uuid :primary true}]]]
      [['User [:id {:type :uuid}]]]])

^{:refer postgres.application.internal/app-create}
(fact "creates an application from registered PostgreSQL table modules"
  (let [original (deref script/+modules+)
        module-name 'postgres.application.internal-test/application-module
        module {:id module-name
                :static {:application ["internal-app"]}
                :code
                {'User
                 {:id 'User
                  :module module-name
                  :op 'deftype
                  :lang :postgres
                  :section :code
                  :static/public true
                  :static/schema-seed
                  {:User {:id {:type :uuid :primary true}}}}}}
        result
        (try
          (reset! script/+modules+ {module-name module})
          (let [application (subject/app-create "internal-app")]
            [(count (subject/app-modules "internal-app"))
             (get-in application [:schema :tree "User" :id 0 :type])
             (get-in application [:pointers 'User :module])])
          (finally
            (reset! script/+modules+ original)))]
    result)
  => [1 :uuid 'postgres.application.internal-test/application-module])

^{:refer postgres.application.internal/app-list}
(fact "lists only currently registered applications"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app "internal-app" {:tables {}})
          (vec (subject/app-list))
          (finally
            (reset! subject/*applications* original)))]
    result)
  => ["internal-app"])

^{:refer postgres.application.internal/app}
(fact "gets one application or the complete registry"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app "internal-app" {:tables {}})
          [(subject/app "internal-app")
           (keys (subject/app))]
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [{:tables {}} ["internal-app"]])

^{:refer postgres.application.internal/app-clear}
(fact "clears one application without disturbing the registry boundary"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app "internal-app" {:tables {}})
          [(subject/app-clear "internal-app")
           (subject/app "internal-app")]
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [nil nil])

^{:refer postgres.application.internal/app-rebuild}
(fact "rebuilds typed data while preserving registered tables"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app
           "internal-app"
           {:tables {'User [:id {:type :uuid :primary true}]}
            :pointers {}})
          (let [rebuilt (subject/app-rebuild "internal-app")]
            [(get-in rebuilt [:tables 'User])
             (count (get-in rebuilt [:typed :tables]))])
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [[:id {:type :uuid :primary true}] 1])

^{:refer postgres.application.internal/app-rebuild-tables}
(fact "rebuilds an application from its registered table modules"
  (let [original-applications (subject/app)
        original-modules (deref script/+modules+)
        module-name 'postgres.application.internal-test/rebuild-module
        module {:id module-name
                :static {:application ["internal-app"]}
                :code
                {'User
                 {:id 'User
                  :module module-name
                  :op 'deftype
                  :lang :postgres
                  :section :code
                  :static/public true
                  :static/schema-seed
                  {:User {:id {:type :uuid :primary true}}}}}}
        result
        (try
          (reset! script/+modules+ {module-name module})
          (subject/app-reset)
          (let [rebuilt (subject/app-rebuild-tables "internal-app")]
            [(get-in rebuilt [:schema :tree "User" :id 0 :type])
             (subject/app "internal-app")])
          (finally
            (reset! script/+modules+ original-modules)
            (reset! subject/*applications* original-applications)))]
    [(first result) (get-in (second result) [:schema :tree "User" :id 0 :type])])
  => [:uuid :uuid])

^{:refer postgres.application.internal/app-schema}
(fact "returns the schema for a registered application"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app "internal-app" {:schema {:tree {"User" {}}}})
          (subject/app-schema "internal-app")
          (finally
            (reset! subject/*applications* original)))]
    result)
  => {:tree {"User" {}}})

^{:refer postgres.application.internal/app-typed}
(fact "lazily creates and caches typed application data"
  (let [original (subject/app)
        result
        (try
          (subject/app-reset)
          (subject/register-app
           "internal-app"
           {:tables {'User [:id {:type :uuid :primary true}]}
            :pointers {}})
          (let [first-value (subject/app-typed "internal-app")
                second-value (subject/app-typed "internal-app")]
            [(count (:tables first-value))
             (= first-value second-value)
             (count (:tables (:typed (subject/app "internal-app"))))])
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [1 true 1])

^{:refer postgres.application.internal/register-app}
(fact "registers and returns an application payload"
  (let [original (subject/app)
        application {:schema {:tree {"User" {}}}}
        result
        (try
          (subject/app-reset)
          [(subject/register-app "internal-app" application)
           (subject/app "internal-app")]
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [{:schema {:tree {"User" {}}}}
      {:schema {:tree {"User" {}}}}])

^{:refer postgres.application.internal/app-reset}
(fact "resets the registry idempotently and returns the empty baseline"
  (let [original (subject/app)
        result
        (try
          (subject/register-app "internal-app" {:tables {}})
          [(subject/app-reset)
           (subject/app-reset)
           (subject/app-list)
           (subject/app "internal-app")]
          (finally
            (reset! subject/*applications* original)))]
    result)
  => [{} {} [] nil])

^{:refer postgres.application.internal/__tahto_load__}
(fact "retains the Hara load marker"
  subject/__tahto_load__ => true)

(pr-str (run '[postgres.application.internal-test]))
