(ns lang.seedgen-test
  (:use code.test)
  (:require [lang.seedgen :as seedgen]))

(def sample-unit
  {:path "test-lang/xt/example_test.hal"
   :source "(ns xt.example-test)\n^{:seedgen/root {:all true}}\n(fact \"works\" true => true)"})

^{:refer lang.seedgen/run}
(fact "seed generation runs through the default host value"
  (let [result
        (seedgen/run
         :root
         {:units []
          :language :js
          :test-root "/tmp/test"})]
    [(get-in result [:summary :operation])
     (get-in result [:summary :count])])
  => [:root 0])

(fact "seedgen root discovery runs as a std.work batch"
  (let [result (seedgen/run :list {:units [sample-unit]})]
    [(:count (:summary result))
     (:root (:item/value (first (:results result))))])
  => [1 true])

(fact "bench plans preserve Foundation xtbench layout"
  (seedgen/bench-path "test-lang" :js "xt.example-test")
  => "test-lang/xtbench/js/xt/example_test_test.hal")

(fact "runtime language metadata retains Foundation aliases and execution modes"
  [(seedgen/normalize-runtime-language :ruby)
   (seedgen/runtime-check-mode "dart")
   (:script (seedgen/runtime-language-config :rb))]
  => [:rb :batched :ruby])

(pr-str (run {:namespace "lang.seedgen-test"}))
