(ns lang.model.v1.spec-postgres-trigger-test
  (:use code.test)
  (:require [lang.core :as l]
            [lang.core.compile :as compile]
            [lang.core.script :as script]
            [lang.model.v1.spec-postgres :as postgres]
            [lang.model.v1.spec-postgres.postgres-trigger :as trigger]))

(l/script :postgres
  {:static {:application ["fixture"]
            :all {:schema ["fixture"]}}})

(deftype.pg ^{:final true}
  LedgerEntry
  [:id {:type :uuid :primary true :required true}
   :body-root {:type :bytea :required true}]
  {})

(defn.pg ^{:- [:trigger]}
  touch-ledger-entry
  []
  (return new))

(deftrigger.pg ^{:- [:before :insert :or :update]
                 :priority 100}
  ledger-entry-touch
  "Refreshes derived ledger fields."
  [-/LedgerEntry]
  [:for :each :row
   :execute-function (-/touch-ledger-entry)])

(defn current-module
  []
  (symbol (str (ns-current))))

(defn module-context
  []
  (let [module-id (current-module)
        modules (deref script/+modules+)]
    {:module (get modules module-id)
     :modules modules}))

(defn trigger-form
  []
  (get-in (deref script/+modules+)
          [(current-module) :code 'ledger-entry-touch :form-input]))

(defn formatted
  []
  (trigger/pg-trigger-format (trigger-form)))

(defn hydrated
  []
  (trigger/pg-trigger-hydrate
   (second (formatted))
   (:grammar postgres/+selection+)
   (module-context)))

(defn direct-output
  []
  (trigger/pg-trigger
   (second (hydrated))
   (:grammar postgres/+selection+)
   (module-context)))

(def +trigger-output+
  (str "DROP TRIGGER IF EXISTS ledger_entry_touch ON \"fixture\".\"LedgerEntry\";\n"
       "CREATE TRIGGER ledger_entry_touch BEFORE INSERT OR UPDATE ON \"fixture\".\"LedgerEntry\"\n"
       "FOR EACH ROW EXECUTE FUNCTION \"fixture\".touch_ledger_entry();"))

(def results
  [(fact "selects the alpha PostgreSQL trigger grammar"
     [(:version postgres/+book+)
      (:version (l/registry-book :postgres :default nil))]
     => ["alpha" "alpha"])

   (fact "deftrigger.pg registers a normalized trigger entry"
     (let [entry (get-in (deref script/+modules+)
                         [(current-module) :code 'ledger-entry-touch])]
       [(:id entry)
        (:op entry)
        (first (:form-input entry))
        (second (:form-input entry))])
     => ['ledger-entry-touch 'deftrigger 'deftrigger 'ledger-entry-touch])

   (fact "the trigger formatter retains documentation, prefix clauses, and db type"
     (let [metadata (first (formatted))]
       [(:doc metadata)
        (:static/return metadata)
        (:static/dbtype metadata)
        (:priority metadata)])
     => ["Refreshes derived ledger fields."
         [:before :insert :or :update]
         :trigger
         100])

   (fact "hydration resolves the linked table and trigger function"
     (let [metadata (first (hydrated))]
       [(:static/schema metadata)
        (:static/trigger-table metadata)
        (:static/trigger-function metadata)])
     => ["fixture"
         {:schema "fixture" :table 'LedgerEntry}
         {:schema "fixture"
          :function 'touch-ledger-entry
          :args []}])

   (fact "emits the historical drop/create trigger sequence directly"
     (direct-output)
     => +trigger-output+)

   (fact "supports a normalized map body with WHEN and EXECUTE FUNCTION"
     (let [form (second (hydrated))
           symbol (second form)
           mapped (list 'deftrigger symbol
                        (nth form 2)
                        {:for-each :row
                         :when '(not= new.body-root old.body-root)
                         :execute-function '(-/touch-ledger-entry)})]
       (trigger/pg-trigger mapped
                           (:grammar postgres/+selection+)
                           (module-context)))
     => (str "DROP TRIGGER IF EXISTS ledger_entry_touch ON \"fixture\".\"LedgerEntry\";\n"
             "CREATE TRIGGER ledger_entry_touch BEFORE INSERT OR UPDATE ON \"fixture\".\"LedgerEntry\"\n"
             "FOR EACH ROW\n"
             "WHEN (new.body_root != old.body_root)\n"
             "EXECUTE FUNCTION \"fixture\".touch_ledger_entry();"))

   (fact "compile-module emits the exact trigger after its table and function"
     (let [module (current-module)
           result (compile/compile-module
                   {:lang :postgres
                    :main module
                    :layout :module
                    :emit {:code {:label true}}})
           trigger-symbol (symbol (str module) "ledger-entry-touch")
           entry (first (filter (fn [candidate]
                                  (= trigger-symbol (:symbol candidate)))
                                (:entries result)))]
       [(:output entry)
        (:diagnostics result)
        (last (get-in result [:provenance :entry-order]))])
     => [+trigger-output+
         []
         (symbol (str (current-module)) "ledger-entry-touch")])

   (fact "repeated trigger compilation is byte-identical"
     (let [module (current-module)
           options {:lang :postgres
                    :main module
                    :layout :module
                    :emit {:code {:label true}}}]
       (= (:output (compile/compile-module options))
          (:output (compile/compile-module options))))
     => true)

   (fact "an unresolved trigger table fails before SQL emission"
     (trigger/pg-trigger-hydrate
      (second
       (trigger/pg-trigger-format
        '(deftrigger broken-table [-/Missing] [])))
      (:grammar postgres/+selection+)
      (module-context))
     => (throws))

   (fact "an unresolved trigger function fails before SQL emission"
     (trigger/pg-trigger-hydrate
      (second
       (trigger/pg-trigger-format
        '(deftrigger ^{:- [:after :insert]}
           broken-function
           [-/LedgerEntry]
           [:for :each :row
            :execute-function (-/missing-function)])))
      (:grammar postgres/+selection+)
      (module-context))
     => (throws))])

(pr-str (run '[lang.model.v1.spec-postgres-trigger-test]))
