(ns lang.model.v1.spec-postgres-fragment-test
  (:use code.test)
  (:require [postgres.core.builtin :as builtin]
            [lang.core :as l]
            [lang.core.compile :as compile]
            [lang.core.script :as script]
            [lang.model.v1.spec-postgres :as postgres]))

(l/script :postgres)

(def$.pg ^{:- [:numeric]} plus +)
(def$.pg now-call now)
(def$.pg null-value nil)

(defn.pg ^{:- [:numeric]}
  add-pair
  [:numeric left :numeric right]
  (return (-/plus left right)))

(defn current-module
  []
  (symbol (str (ns-current))))

(defn compile-form
  [form]
  (script/compile-form :postgres (current-module) form))

(def results
  [(fact "selects the alpha PostgreSQL value-fragment book"
     [(:version postgres/+book+)
      (:version (l/registry-book :postgres :default nil))]
     => ["alpha" "alpha"])

   (fact "def$.pg registers a historical value fragment"
     (let [entry (get-in (deref script/+modules+)
                         [(current-module) :fragment 'plus])]
       [(:id entry)
        (:op entry)
        (:section entry)
        (:form entry)
        (:static/return entry)])
     => ['plus 'def$ :fragment '+ [:numeric]])

   (fact "value fragments expand in call-head position"
     (compile-form '(-/plus 1 2 3))
     => "1 + 2 + 3")

   (fact "function aliases expand with zero arguments"
     (compile-form '(-/now-call))
     => "now()")

   (fact "nil value fragments expand in standalone position"
     (compile-form '(return -/null-value))
     => "RETURN NULL")

   (fact "fragment dependencies are retained on compiled code entries"
     (let [result (compile/compile-module
                   {:lang :postgres
                    :main (current-module)
                    :layout :module})
           target (symbol (str (current-module)) "add-pair")
           entry (first (filter (fn [candidate]
                                  (= target (:symbol candidate)))
                                (:entries result)))
           fragments (get-in entry [:dependencies :fragment])]
       (reduce (fn [found value]
                 (or found (= value
                              (symbol (str (current-module)) "plus"))))
               false
               fragments))
     => true)

   (fact "compile-module reports fragments in the deterministic module descriptor"
     (let [result (compile/compile-module
                   {:lang :postgres
                    :main (current-module)
                    :layout :module})
           descriptor (first (:modules result))]
       [(:fragment descriptor)
        (:diagnostics result)])
     => [[(symbol (str (current-module)) "now-call")
          (symbol (str (current-module)) "null-value")
          (symbol (str (current-module)) "plus")]
         []])

   (fact "the historical builtin template still produces def$.pg declarations"
     (builtin/pg-tmpl 'digest)
     => '(def$.pg digest digest))

   (fact "repeated value-fragment compilation is byte-identical"
     (= (compile-form '(-/plus 4 5))
        (compile-form '(-/plus 4 5)))
     => true)

   (fact "an unresolved value fragment fails with staging provenance"
     (compile-form '(-/missing-fragment 1))
     => (throws))])

(pr-str (run '[lang.model.v1.spec-postgres-fragment-test]))
