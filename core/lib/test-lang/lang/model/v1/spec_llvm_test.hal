(ns lang.model.v1.spec-llvm-test
  (:use code.test)
  (:require [lang.common.book :as book]
            [lang.common.book-meta :as book-meta]
            [lang.model.v1.spec-llvm :refer :all]))

^{:refer lang.model.v1.spec-llvm/tf-define :added "4.1"}
(fact "transforms define forms"
  (tf-define (list 'define 'i32 (symbol "@add") ['i32 '%a 'i32 '%b]
                   '(ret i32 %a)))
  => '(:- "define" i32 "@add(i32 %a, i32 %b)"
          (:- "{"
              (\\ \\ (\| (do (ret i32 %a))))
              (:- "\n}"))))

^{:refer lang.model.v1.spec-llvm/tf-declare :added "4.1"}
(fact "transforms declare forms"
  (tf-declare (list 'declare 'i32 (symbol "@puts") ['i8*]))
  => '(:- "declare" i32 "@puts(i8*)"))

^{:refer lang.model.v1.spec-llvm/tf-label :added "4.1"}
(fact "transforms labels"
  (tf-label '(label %entry))
  => '(:- "%entry:"))

^{:refer lang.model.v1.spec-llvm/tf-ret :added "4.1"}
(fact "transforms ret instructions"
  [(tf-ret '(ret void))
   (tf-ret '(ret i32 %value))]
  => ['(:- "ret" void)
      '(:- "ret" i32 %value)])

^{:refer lang.model.v1.spec-llvm/tf-assign :added "4.1"}
(fact "transforms assignments"
  (tf-assign '(:= %out (call i32 @next [])))
  => '(:- %out "=" (call i32 @next [])))

^{:refer lang.model.v1.spec-llvm/tf-inst-bin :added "4.1"}
(fact "transforms binary instructions"
  ((tf-inst-bin "add") '(add i32 %a %b))
  => '(:- "add" i32 "%a," %b))

^{:refer lang.model.v1.spec-llvm/tf-icmp :added "4.1"}
(fact "transforms icmp instructions"
  (tf-icmp '(icmp eq i32 %a %b))
  => '(:- "icmp" eq i32 "%a," %b))

^{:refer lang.model.v1.spec-llvm/tf-br :added "4.1"}
(fact "transforms branch instructions"
  [(tf-br '(br %exit))
   (tf-br '(br %cond %then %else))]
  => ['(:- "br" "label" %exit)
      '(:- "br" "i1" "%cond," "label %then," "label %else")])

^{:refer lang.model.v1.spec-llvm/tf-call :added "4.1"}
(fact "transforms call instructions"
  (tf-call (list 'call 'i32 (symbol "@puts") [['i8* '%msg] ['i32 '%len]]))
  => '(:- "call" i32 "@puts(i8* %msg, i32 %len)"))

^{:refer lang.model.v1.spec-llvm/tf-alloca :added "4.1"}
(fact "transforms alloca instructions"
  [(tf-alloca '(alloca i32))
   (tf-alloca '(alloca i32 [i32 4]))]
  => ['(:- "alloca" i32)
      '(:- "alloca" i32 "," i32 4)])

^{:refer lang.model.v1.spec-llvm/tf-store :added "4.1"}
(fact "transforms store instructions"
  (tf-store '(store i32 %value i32* %ptr))
  => '(:- "store" i32 "%value," i32* %ptr))

^{:refer lang.model.v1.spec-llvm/tf-load :added "4.1"}
(fact "transforms load instructions"
  (tf-load '(load i32 i32* %ptr))
  => '(:- "load" "i32," i32* %ptr))

^{:refer lang.model.v1.spec-llvm/+features+ :added "4.1"}
(fact "LLVM features include declaration and instruction operators"
  [(boolean (get-in +features+ [:define]))
   (boolean (get-in +features+ [:load]))
   (boolean (get-in +features+ [:ret]))]
  => [true true true])

^{:refer lang.model.v1.spec-llvm/+template+ :added "4.1"}
(fact "LLVM template preserves line-oriented blocks"
  [(get-in +template+ [:default :common :statement])
   (get-in +template+ [:default :common :sep])
   (get-in +template+ [:token :symbol :replace \-])]
  => ["" "\n" "_"])

^{:refer lang.model.v1.spec-llvm/+grammar+ :added "4.1"}
(fact "LLVM grammar reserves its instructions"
  [(get +grammar+ :tag)
   (boolean (get-in +grammar+ [:reserved (quote define)]))
   (boolean (get-in +grammar+ [:reserved (quote call)]))]
  => [:llvm true true])

^{:refer lang.model.v1.spec-llvm/+meta+ :added "4.1"}
(fact "LLVM metadata is a native BookMeta value"
  (book-meta/book-meta? +meta+) => true)

^{:refer lang.model.v1.spec-llvm/+book+ :added "4.1"}
(fact "LLVM book carries its grammar and metadata"
  [(book/book? +book+)
   (:lang +book+)
   (= (:grammar +book+) +grammar+)
   (book-meta/book-meta? (:meta +book+))]
  => [true :llvm true true])

^{:refer lang.model.v1.spec-llvm/+init+ :added "4.1"}
(fact "LLVM initialization is the immutable book value"
  +init+ => +book+)
