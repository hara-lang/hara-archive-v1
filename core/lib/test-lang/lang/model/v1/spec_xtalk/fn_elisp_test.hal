(ns lang.model.v1.spec-xtalk.fn-elisp-test
  (:require [std.foundation.string :as string]
            [lang.model.v1.spec-xtalk.fn-elisp :refer :all])
  (:use code.test))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-begin :added "4.1"}
(fact "wraps one or many expressions"
  [(elisp-begin '(x))
   (elisp-begin '(x y))]
  => ['x '(progn x y)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-vector-subseq :added "4.1"}
(fact "builds vector subsequence calls"
  [(elisp-vector-subseq 'arr 1)
   (elisp-vector-subseq 'arr 1 3)]
  => ['(seq-subseq arr 1) '(seq-subseq arr 1 3)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-vector->list :added "4.1"}
(fact "converts vectors to lists"
  (elisp-vector->list 'arr) => '(append arr nil))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-del :added "4.1"}
(fact "deletes symbols and property forms"
  [(elisp-tf-x-del '[_ obj])
   (elisp-tf-x-del '[_ (. obj [key])])]
  => ['(setq obj nil) '(x:del-key obj key)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-print :added "4.1"}
(fact "prints values and preserves the final nil"
  (elisp-tf-x-print '(x:print "hello"))
  => '(progn (princ "hello") nil))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-len :added "4.1"}
(fact "selects vector hash-table and sequence length"
  (elisp-tf-x-len '(x:len arr))
  => '(if (vectorp arr)
        (length arr)
        (if (hash-table-p arr)
          (hash-table-count arr)
          (length arr))))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-cat :added "4.1"}
(fact "concatenates strings"
  (elisp-tf-x-cat '(x:cat "a" "b"))
  => '(concat "a" "b"))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-apply :added "4.1"}
(fact "applies arguments converted from a vector"
  (elisp-tf-x-apply '(x:apply f args))
  => '(apply f (append args nil)))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-div :added "4.1"}
(fact "divides with floating-point promotion"
  (elisp-tf-x-div '(x:div a b c))
  => '(/ (/ (float a) b) c))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-err :added "4.1"}
(fact "builds error and signal forms"
  [(elisp-tf-x-err '(x:err message))
   (elisp-tf-x-err '(x:err message data))]
  => ['(error "%s" message)
      '(signal (intern "error") (list message data))])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-eval :added "4.1"}
(fact "evaluates and converts numeric results"
  (let [out (pr-str (elisp-tf-x-eval '(x:eval source)))]
    [(string/includes? out "calc-eval")
     (string/includes? out "string-to-number")
     (string/includes? out "string-match-p")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-random :added "4.1"}
(fact "builds a normalized random expression"
  (elisp-tf-x-random '[_]) => '(/ (float (random 1000000)) 1000000.0))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-now-ms :added "4.1"}
(fact "builds a millisecond clock expression"
  (elisp-tf-x-now-ms '[_]) => '(floor (* 1000 (float-time))))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-ex-native? :added "4.1"}
(fact "checks vector and condition-list exception shapes"
  (let [out (pr-str (elisp-tf-x-ex-native? '(x:ex-native? err)))]
    [(string/includes? out "vectorp")
     (string/includes? out "consp")
     (string/includes? out "__xt_error__")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-ex-new :added "4.1"}
(fact "creates the portable exception vector"
  (elisp-tf-x-ex-new '(x:ex-new message data))
  => '(vector "__xt_error__" message data))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-ex-message :added "4.1"}
(fact "extracts exception messages"
  (let [out (pr-str (elisp-tf-x-ex-message '(x:ex-message err)))]
    [(string/includes? out "aref")
     (string/includes? out "x:ex-native?")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-ex-data :added "4.1"}
(fact "extracts exception data"
  (let [out (pr-str (elisp-tf-x-ex-data '(x:ex-data err)))]
    [(string/includes? out "aref")
     (string/includes? out "x:ex-native?")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-type-native :added "4.1"}
(fact "builds the native type branch chain"
  (let [out (elisp-tf-x-type-native '(x:type-native obj))]
    [(first out) (count out) (string/includes? (pr-str out) "hash-table-p")])
  => ['br* 11 true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-core+ :added "4.1"}
(fact "registers Elisp core operators"
  [(get-in +elisp-core+ [:x-print :emit])
   (get-in +elisp-core+ [:x-print :value])
   (boolean (get-in +elisp-core+ [:x-print :macro]))]
  => [:macro true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-global-set :added "4.1"}
(fact "sets a global value"
  (elisp-tf-x-global-set '(x:global-set answer value))
  => '(progn (puthash "answer" value __xt_globals__) value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-global-del :added "4.1"}
(fact "deletes a global value"
  (elisp-tf-x-global-del '(x:global-del answer))
  => '(progn (remhash "answer" __xt_globals__) nil))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-global-has? :added "4.1"}
(fact "checks a global value through a sentinel"
  (let [out (pr-str (elisp-tf-x-global-has? '(x:global-has? answer)))]
    [(string/includes? out "gethash")
     (string/includes? out "__xt_globals__")
     (string/includes? out "__xt_missing")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-global+ :added "4.1"}
(fact "registers Elisp global operators"
  [(get-in +elisp-global+ [:x-global-set :emit])
   (get-in +elisp-global+ [:x-global-has? :value])]
  => [:macro true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-to-string :added "4.1"}
(fact "converts a value to a formatted string"
  (elisp-tf-x-to-string '(x:to-string value))
  => '(format "%s" value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-to-number :added "4.1"}
(fact "keeps numbers and parses strings"
  (elisp-tf-x-to-number '(x:to-number value))
  => '(if (numberp value) value (string-to-number value)))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-string? :added "4.1"}
(fact "checks strings"
  (elisp-tf-x-is-string? '(x:is-string? value)) => '(stringp value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-number? :added "4.1"}
(fact "checks numbers"
  (elisp-tf-x-is-number? '(x:is-number? value)) => '(numberp value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-integer? :added "4.1"}
(fact "checks integers"
  (elisp-tf-x-is-integer? '(x:is-integer? value)) => '(integerp value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-boolean? :added "4.1"}
(fact "checks true and nil"
  (elisp-tf-x-is-boolean? '(x:is-boolean? value))
  => '(or (eq value t) (null value)))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-function? :added "4.1"}
(fact "checks functions"
  (elisp-tf-x-is-function? '(x:is-function? value)) => '(functionp value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-object? :added "4.1"}
(fact "checks hash tables"
  (elisp-tf-x-is-object? '(x:is-object? value)) => '(hash-table-p value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-is-array? :added "4.1"}
(fact "checks arrays"
  (elisp-tf-x-is-array? '(x:is-array? value)) => '(vectorp value))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-type+ :added "4.1"}
(fact "registers Elisp type operators"
  [(get-in +elisp-type+ [:x-to-string :emit])
   (get-in +elisp-type+ [:x-is-array? :value])]
  => [:macro true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-lu-create :added "4.1"}
(fact "creates an equality hash table"
  (elisp-tf-x-lu-create '[_])
  => '(make-hash-table :test (intern "equal")))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-lu-eq :added "4.1"}
(fact "compares lookup keys"
  (elisp-tf-x-lu-eq '(x:lu-eq a b)) => '(eq a b))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-lu-get :added "4.1"}
(fact "gets a lookup value"
  (elisp-tf-x-lu-get '(x:lu-get lu key)) => '(gethash key lu))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-lu-set :added "4.1"}
(fact "sets a lookup value and returns the table"
  (elisp-tf-x-lu-set '(x:lu-set lu key value))
  => '(progn (puthash key value lu) lu))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-lu-del :added "4.1"}
(fact "deletes a lookup value and returns the table"
  (elisp-tf-x-lu-del '(x:lu-del lu key))
  => '(progn (remhash key lu) lu))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-lu+ :added "4.1"}
(fact "registers Elisp lookup operators"
  [(get-in +elisp-lu+ [:x-lu-create :value])
   (get-in +elisp-lu+ [:x-lu-del :emit])]
  => [true :macro])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-get-key :added "4.1"}
(fact "gets object keys with optional defaults"
  [(elisp-tf-x-get-key '(x:get-key obj key))
   (elisp-tf-x-get-key '(x:get-key obj key fallback))]
  => ['(gethash key obj) '(gethash key obj fallback)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-get-path :added "4.1"}
(fact "walks object paths"
  (let [out (pr-str (elisp-tf-x-get-path '(x:get-path obj [a b] fallback)))]
    [(string/includes? out "x:get-key")
     (string/includes? out "a")
     (string/includes? out "b")
     (string/includes? out "fallback")])
  => [true true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-has-key? :added "4.1"}
(fact "checks object keys with and without expected values"
  (let [checked (pr-str (elisp-tf-x-has-key? '(x:has-key? obj key expected)))
        present (pr-str (elisp-tf-x-has-key? '(x:has-key? obj key)))]
    [(string/includes? checked "equal")
     (string/includes? checked "__xt_missing")
     (not (string/includes? present "equal"))])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-del-key :added "4.1"}
(fact "deletes an object key"
  (elisp-tf-x-del-key '(x:del-key obj key))
  => '(progn (remhash key obj) obj))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-set-key :added "4.1"}
(fact "sets an object key"
  (elisp-tf-x-set-key '(x:set-key obj key value))
  => '(progn (puthash key value obj) obj))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-copy-key :added "4.1"}
(fact "copies scalar and indexed object keys"
  [(elisp-tf-x-copy-key '(x:copy-key dst src key))
   (string/includes? (pr-str (elisp-tf-x-copy-key '(x:copy-key dst src [key idx]))) "x:get-idx")]
  => ['(x:set-key dst key (x:get-key src key nil)) true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-obj-keys :added "4.1"}
(fact "lists object keys"
  (elisp-tf-x-obj-keys '(x:obj-keys obj))
  => '(vconcat (hash-table-keys obj)))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-obj-vals :added "4.1"}
(fact "lists object values"
  (let [out (pr-str (elisp-tf-x-obj-vals '(x:obj-vals obj)))]
    [(string/includes? out "mapcar")
     (string/includes? out "gethash")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-obj-pairs :added "4.1"}
(fact "lists object pairs"
  (let [out (pr-str (elisp-tf-x-obj-pairs '(x:obj-pairs obj)))]
    [(string/includes? out "mapcar")
     (string/includes? out "vector")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-obj-clone :added "4.1"}
(fact "clones objects into a new hash table"
  (let [out (pr-str (elisp-tf-x-obj-clone '(x:obj-clone obj)))]
    [(string/includes? out "make-hash-table")
     (string/includes? out "maphash")
     (string/includes? out "out")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-obj-assign :added "4.1"}
(fact "assigns object entries into symbol and expression targets"
  (let [symbol-out (pr-str (elisp-tf-x-obj-assign '(x:obj-assign obj other)))
        expression-out (pr-str (elisp-tf-x-obj-assign '(x:obj-assign (make-object) other)))]
    [(string/includes? symbol-out "progn")
     (string/includes? expression-out "let")
     (string/includes? expression-out "maphash")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-object+ :added "4.1"}
(fact "registers Elisp object operators"
  [(get-in +elisp-object+ [:x-get-key :value])
   (get-in +elisp-object+ [:x-obj-clone :value])
   (get-in +elisp-object+ [:x-del-key :emit])]
  => [true true :macro])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-get-idx :added "4.1"}
(fact "gets indexed values with optional bounds"
  [(elisp-tf-x-get-idx '(x:get-idx arr idx))
   (string/includes? (pr-str (elisp-tf-x-get-idx '(x:get-idx arr idx fallback))) "aref")]
  => ['(aref arr idx) true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-set-idx :added "4.1"}
(fact "sets an indexed value"
  (elisp-tf-x-set-idx '(x:set-idx arr idx value))
  => '(progn (aset arr idx value) arr))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-clone :added "4.1"}
(fact "clones arrays"
  (elisp-tf-x-arr-clone '(x:arr-clone arr))
  => '(seq-subseq arr 0))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-slice :added "4.1"}
(fact "slices arrays"
  (elisp-tf-x-arr-slice '(x:arr-slice arr start end))
  => '(seq-subseq arr start end))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-reverse :added "4.1"}
(fact "reverses arrays"
  (let [out (pr-str (elisp-tf-x-arr-reverse '(x:arr-reverse arr)))]
    [(string/includes? out "reverse")
     (string/includes? out "vconcat")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-concat :added "4.1"}
(fact "concatenates arrays"
  (elisp-tf-x-arr-concat '(x:arr-concat arr other))
  => '(vconcat arr other))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-push :added "4.1"}
(fact "pushes values into symbols and expressions"
  [(elisp-tf-x-arr-push '(x:arr-push arr value))
   (elisp-tf-x-arr-push '(x:arr-push [1 2] value))]
  => ['(progn (setq arr (vconcat arr (vector value))) arr)
      '(vconcat [1 2] (vector value))])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-pop :added "4.1"}
(fact "pops from symbol arrays"
  (let [out (pr-str (elisp-tf-x-arr-pop '(x:arr-pop arr)))]
    [(string/includes? out "aref")
     (string/includes? out "seq-subseq")
     (string/includes? out "idx")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-push-first :added "4.1"}
(fact "prepends array values"
  [(elisp-tf-x-arr-push-first '(x:arr-push-first arr value))
   (elisp-tf-x-arr-push-first '(x:arr-push-first [1 2] value))]
  => ['(progn (setq arr (vconcat (vector value) arr)) arr)
      '(vconcat (vector value) [1 2])])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-pop-first :added "4.1"}
(fact "removes the first array value"
  [(elisp-tf-x-arr-pop-first '(x:arr-pop-first arr))
   (elisp-tf-x-arr-pop-first '(x:arr-pop-first [1 2]))]
  => ['(do (var value (aref arr 0)) (:= arr (seq-subseq arr 1)) value)
      '(aref [1 2] 0)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-insert :added "4.1"}
(fact "inserts array values"
  (let [out (pr-str (elisp-tf-x-arr-insert '(x:arr-insert arr idx value)))]
    [(string/includes? out "vconcat")
     (string/includes? out "setq")
     (string/includes? out "seq-subseq")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-remove :added "4.1"}
(fact "removes array values"
  (let [out (pr-str (elisp-tf-x-arr-remove '(x:arr-remove arr idx)))]
    [(string/includes? out "vconcat")
     (string/includes? out "setq")
     (string/includes? out "idx")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-assign :added "4.1"}
(fact "assigns arrays"
  [(elisp-tf-x-arr-assign '(x:arr-assign arr other))
   (elisp-tf-x-arr-assign '(x:arr-assign [1] other))]
  => ['(progn (setq arr (vconcat arr other)) arr)
      '(vconcat [1] other)])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-some :added "4.1"}
(fact "tests whether an array has a matching value"
  (let [out (pr-str (elisp-tf-x-arr-some '(x:arr-some arr pred)))]
    [(string/includes? out "seq-some")
     (string/includes? out "append")
     (string/includes? out "t")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-each :added "4.1"}
(fact "iterates over array values"
  (let [out (pr-str (elisp-tf-x-arr-each '(x:arr-each arr f)))]
    [(string/includes? out "mapc")
     (string/includes? out "funcall")
     (string/includes? out "append")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-every :added "4.1"}
(fact "tests every array value"
  (let [out (pr-str (elisp-tf-x-arr-every '(x:arr-every arr pred)))]
    [(string/includes? out "seq-every-p")
     (string/includes? out "funcall")
     (string/includes? out "t")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-map :added "4.1"}
(fact "maps array values"
  (let [out (pr-str (elisp-tf-x-arr-map '(x:arr-map arr f)))]
    [(string/includes? out "mapcar")
     (string/includes? out "vconcat")
     (string/includes? out "funcall")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-filter :added "4.1"}
(fact "filters array values"
  (let [out (pr-str (elisp-tf-x-arr-filter '(x:arr-filter arr pred)))]
    [(string/includes? out "seq-filter")
     (string/includes? out "vconcat")
     (string/includes? out "funcall")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-foldl :added "4.1"}
(fact "folds arrays from the left"
  (let [out (pr-str (elisp-tf-x-arr-foldl '(x:arr-foldl arr f init)))]
    [(string/includes? out "seq-reduce")
     (string/includes? out "init")
     (string/includes? out "funcall")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-foldr :added "4.1"}
(fact "folds arrays from the right"
  (let [out (pr-str (elisp-tf-x-arr-foldr '(x:arr-foldr arr f init)))]
    [(string/includes? out "reverse")
     (string/includes? out "seq-reduce")
     (string/includes? out "init")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-arr-sort :added "4.1"}
(fact "sorts arrays by key and comparator"
  (let [out (pr-str (elisp-tf-x-arr-sort '(x:arr-sort arr key-fn comp-fn)))]
    [(string/includes? out "sort")
     (string/includes? out "key-fn")
     (string/includes? out "comp-fn")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-array+ :added "4.1"}
(fact "registers Elisp array operators"
  [(get-in +elisp-array+ [:x-arr-map :value])
   (get-in +elisp-array+ [:x-arr-sort :emit])
