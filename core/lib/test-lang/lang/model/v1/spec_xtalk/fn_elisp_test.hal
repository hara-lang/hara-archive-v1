   (get-in +elisp-socket+ [:x-socket-connect :emit])]
  => [true :macro])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-notify-http :added "4.1"}
(fact "builds HTTP notification control flow"
  (let [out (pr-str (elisp-tf-x-notify-http '(x:notify-http host port value id key opts)))]
    [(string/includes? out "call-process")
     (string/includes? out "Content-Type")
     (string/includes? out "unable to connect")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-http+ :added "4.1"}
(fact "registers Elisp HTTP operators"
  [(get-in +elisp-http+ [:x-notify-http :value/standalone])
   (get-in +elisp-http+ [:x-notify-http :op-spec :allow-blocks])]
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-pwd :added "4.1"}
(fact "gets the current working directory"
  (elisp-tf-x-pwd '[_]) => '(directory-file-name default-directory))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-shell :added "4.1"}
(fact "builds shell success and error handling"
  (let [out (pr-str (elisp-tf-x-shell '(x:shell command root cb)))]
    [(string/includes? out "call-process-shell-command")
     (string/includes? out "default-directory")
     (string/includes? out "condition-case")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-shell+ :added "4.1"}
(fact "registers Elisp shell operators"
  [(get-in +elisp-shell+ [:x-shell :op-spec :allow-blocks])
   (get-in +elisp-shell+ [:x-pwd :emit])]
  => [true :macro])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-file-resolve :added "4.1"}
(fact "resolves file paths"
  (elisp-tf-x-file-resolve '(x:file-resolve root path))
  => '(expand-file-name path root))

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-file-slurp :added "4.1"}
(fact "reads file contents through a callback"
  (let [out (pr-str (elisp-tf-x-file-slurp '(x:file-slurp path cb)))]
    [(string/includes? out "insert-file-contents")
     (string/includes? out "buffer-string")
     (string/includes? out "condition-case")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/elisp-tf-x-file-spit :added "4.1"}
(fact "writes file contents through a callback"
  (let [out (pr-str (elisp-tf-x-file-spit '(x:file-spit path content cb)))]
    [(string/includes? out "with-temp-file")
     (string/includes? out "make-directory")
     (string/includes? out "funcall")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp-file+ :added "4.1"}
(fact "registers Elisp file operators"
  (get-in +elisp-file+ [:x-file-resolve :emit]) => :macro)

^{:refer lang.model.v1.spec-xtalk.fn-elisp/+elisp+ :added "4.1"}
(fact "combines all Elisp operator groups"
  [(boolean (get +elisp+ :x-print))
   (boolean (get +elisp+ :x-json-encode))
   (boolean (get +elisp+ :x-file-resolve))]
  => [true true true])
