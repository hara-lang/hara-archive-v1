(ns lang.model.v1.spec-xtalk.fn-go-test
  (:require [lang.model.v1.spec-xtalk.fn-go :refer :all])
  (:use code.test))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-len :added "4.1"}
(fact "go-tf-x-len"
  (go-tf-x-len '(x:len arr))
  => '(len arr))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-cat :added "4.1"}
(fact "go-tf-x-cat"
  (go-tf-x-cat '(x:cat "a" "b"))
  => '(+ "a" "b"))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-print :added "4.1"}
(fact "go-tf-x-print"
  (go-tf-x-print '(x:print "hello"))
  => '(fmt.Println "hello"))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-abs :added "4.1"}
(fact "go-tf-x-m-abs"
  (go-tf-x-m-abs '(x:m-abs n))
  => '(math.Abs n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-max :added "4.1"}
(fact "go-tf-x-m-max"
  (go-tf-x-m-max '(x:m-max a b))
  => '(math.Max a b))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-min :added "4.1"}
(fact "go-tf-x-m-min"
  (go-tf-x-m-min '(x:m-min a b))
  => '(math.Min a b))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-ceil :added "4.1"}
(fact "go-tf-x-m-ceil"
  (go-tf-x-m-ceil '(x:m-ceil n))
  => '(math.Ceil n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-floor :added "4.1"}
(fact "go-tf-x-m-floor"
  (go-tf-x-m-floor '(x:m-floor n))
  => '(math.Floor n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-sqrt :added "4.1"}
(fact "go-tf-x-m-sqrt"
  (go-tf-x-m-sqrt '(x:m-sqrt n))
  => '(math.Sqrt n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-pow :added "4.1"}
(fact "go-tf-x-m-pow"
  (go-tf-x-m-pow '(x:m-pow b e))
  => '(math.Pow b e))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-split :added "4.1"}
(fact "go-tf-x-str-split"
  (go-tf-x-str-split '(x:str-split s sep))
  => '(strings.Split s sep))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-join :added "4.1"}
(fact "go-tf-x-str-join"
  (go-tf-x-str-join '(x:str-join sep arr))
  => '(strings.Join arr sep))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-index-of :added "4.1"}
(fact "go-tf-x-str-index-of"
  (go-tf-x-str-index-of '(x:str-index-of s sub))
  => '(strings.Index s sub))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-upper :added "4.1"}
(fact "go-tf-x-str-to-upper"
  (go-tf-x-str-to-upper '(x:str-to-upper s))
  => '(strings.ToUpper s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-lower :added "4.1"}
(fact "go-tf-x-str-to-lower"
  (go-tf-x-str-to-lower '(x:str-to-lower s))
  => '(strings.ToLower s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-trim :added "4.1"}
(fact "go-tf-x-str-trim"
  (go-tf-x-str-trim '(x:str-trim s))
  => '(strings.TrimSpace s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-arr-push :added "4.1"}
(fact "go-tf-x-arr-push"
  (go-tf-x-arr-push '(x:arr-push arr item))
  => '(:= arr (append arr item)))

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-core+ :added "4.1"}
(fact "Go core feature table retains macro hooks"
  [(count +go-core+) (set (keys +go-core+))]
  => [3 #{:x-cat :x-len :x-print}])

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-math+ :added "4.1"}
(fact "Go math feature table retains math hooks"
  [(count +go-math+) (set (keys +go-math+))]
  => [7 #{:x-m-abs :x-m-max :x-m-min :x-m-ceil :x-m-floor :x-m-sqrt :x-m-pow}])

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-str+ :added "4.1"}
(fact "Go string feature table retains string hooks"
  [(count +go-str+) (set (keys +go-str+))]
  => [6 #{:x-str-split :x-str-join :x-str-index-of :x-str-to-upper
          :x-str-to-lower :x-str-trim}])

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-arr+ :added "4.1"}
(fact "Go array feature table retains array hooks"
  [(count +go-arr+) (set (keys +go-arr+))]
  => [1 #{:x-arr-push}])

^{:refer lang.model.v1.spec-xtalk.fn-go/+go+ :added "4.1"}
(fact "Go feature table combines all target groups"
  [(count +go+)
   (has? +go+ :x-len)
   (has? +go+ :x-m-pow)
   (has? +go+ :x-str-trim)
   (has? +go+ :x-arr-push)]
  => [17 true true true true])
