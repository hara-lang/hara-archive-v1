(ns lang.model.v1.spec-xtalk.fn-dart-test
  (:require [std.foundation.string :as string]
            [lang.model.v1.spec-xtalk.fn-dart :refer :all])
  (:use code.test))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-method0 :added "4.1"}
(fact "builds a zero-argument Dart method form"
  (dart-method0 'obj 'ceil)
  => '(:% (:- "(") obj (:- ").") ceil (:- "()")))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-call :added "4.1"}
(fact "builds a Dart Function.apply call"
  (dart-call 'f 1 2)
  => '(Function.apply f [1 2]))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-runtime-type-string :added "4.1"}
(fact "gets the Dart runtime type string"
  (let [out (pr-str (dart-runtime-type-string 'obj))]
    [(string/includes? out "runtimeType")
     (string/includes? out "toString")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-string-compare-expr :added "4.1"}
(fact "builds a Dart string comparison expression"
  (let [out (pr-str (dart-string-compare-expr 'a 'b))]
    [(string/includes? out "compareTo")
     (string/includes? out "a")
     (string/includes? out "b")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-comparison-form :added "4.1"}
(fact "selects string or numeric comparison semantics"
  (let [out (pr-str (dart-comparison-form 'a 'b '< '<))]
    [(string/includes? out "String")
     (string/includes? out "compareTo")
     (string/includes? out "<")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-is-map :added "4.1"}
(fact "checks Dart map type"
  (string/includes? (pr-str (dart-is-map 'obj)) "is Map")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-map-get :added "4.1"}
(fact "gets a Dart map value by key"
  (let [out (pr-str (dart-map-get 'obj "key"))]
    [(string/includes? out "as Map")
     (string/includes? out "key")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-xt-exception? :added "4.1"}
(fact "recognizes the portable exception marker"
  (let [out (pr-str (dart-xt-exception? 'obj))]
    [(string/includes? out "is Map")
     (string/includes? out "xt.exception")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-len :added "4.1"}
(fact "gets collection length"
  (dart-tf-x-len '[_ arr])
  => '(. arr length))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-cat :added "4.1"}
(fact "concatenates values"
  (dart-tf-x-cat '[_ "a" "b"])
  => '(+ "a" "b"))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-print :added "4.1"}
(fact "prints a single value through a Dart closure"
  (let [out (pr-str (dart-tf-x-print '[_ "hello"]))]
    [(string/includes? out "print")
     (string/includes? out "hello")
     (string/includes? out "return")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-arr-push :added "4.1"}
(fact "pushes an item to a Dart array"
  (dart-tf-x-arr-push '[_ arr item])
  => '(. arr (add item)))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-apply :added "4.1"}
(fact "applies a function to a Dart argument list"
  (dart-tf-x-apply '[_ f args])
  => '(Function.apply f args))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-construct :added "4.1"}
(fact "constructs through Function.apply"
  (dart-tf-x-construct '[_ Widget args])
  => '(Function.apply Widget args))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-now-ms :added "4.1"}
(fact "builds a current-time expression"
  (let [out (pr-str (dart-tf-x-now-ms '[_]))]
    [(string/includes? out "DateTime.now")
     (string/includes? out "millisecondsSinceEpoch")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-random :added "4.1"}
(fact "builds a Dart random-number expression"
  (let [out (pr-str (dart-tf-x-random '[_]))]
    [(string/includes? out "math.Random")
     (string/includes? out "nextDouble")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-type-native :added "4.1"}
(fact "classifies runtime values using Dart type strings"
  (let [out (pr-str (dart-tf-x-type-native '[_ obj]))]
    [(string/includes? out "runtimeType")
     (string/includes? out "String")
     (string/includes? out "List")
     (string/includes? out "Map")])
  => [true true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-del :added "4.1"}
(fact "deletes a property or a map value"
  [(dart-tf-x-del '[_ (. obj [key])])
   (dart-tf-x-del '[_ obj])]
  => ['(. obj (remove key)) '(. obj (remove nil))])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-eval :added "4.1"}
(fact "reports that Dart evaluation is unsupported"
  (dart-tf-x-eval '[_ s])
  => '(throw "eval not supported in Dart"))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-ex-native? :added "4.1"}
(fact "delegates native exception recognition"
  (let [out (pr-str (dart-tf-x-ex-native? '[_ value]))]
    [(string/includes? out "xt.exception")
     (string/includes? out "__type__")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-ex-new :added "4.1"}
(fact "creates the portable exception map"
  (let [message 'message
        data 'data]
    (dart-tf-x-ex-new '[_ message data]))
  => {"__type__" "xt.exception" "message" 'message "data" 'data})

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-ex-message :added "4.1"}
(fact "extracts an exception message"
  (string/includes? (pr-str (dart-tf-x-ex-message '[_ value])) "message")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-ex-data :added "4.1"}
(fact "extracts exception data"
  (string/includes? (pr-str (dart-tf-x-ex-data '[_ value])) "data")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-has-key? :added "4.1"}
(fact "checks keys with and without a value guard"
  (let [checked (pr-str (dart-tf-x-has-key? '[_ obj key value]))
        present (pr-str (dart-tf-x-has-key? '[_ obj key nil]))]
    [(string/includes? checked "containsKey")
     (string/includes? checked "value")
     (string/includes? present "containsKey")
     (string/includes? present "==")])
  => [true true true false])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-del-key :added "4.1"}
(fact "deletes a map key"
  (dart-tf-x-del-key '[_ obj key])
  => '(. obj (remove key)))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lt :added "4.1"}
(fact "lowers less-than comparison"
  (string/includes? (pr-str (dart-tf-x-lt '[_ a b])) "<")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lte :added "4.1"}
(fact "lowers less-than-or-equal comparison"
  (string/includes? (pr-str (dart-tf-x-lte '[_ a b])) "<=")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-gt :added "4.1"}
(fact "lowers greater-than comparison"
  (string/includes? (pr-str (dart-tf-x-gt '[_ a b])) ">")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-gte :added "4.1"}
(fact "lowers greater-than-or-equal comparison"
  (string/includes? (pr-str (dart-tf-x-gte '[_ a b])) ">=")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-abs :added "4.1"}
(fact "wraps receivers for absolute value"
  (string/includes? (pr-str (dart-tf-x-m-abs '[_ x])) "abs")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-ceil :added "4.1"}
(fact "emits ceiling"
  (string/includes? (pr-str (dart-tf-x-m-ceil '[_ x])) "ceil")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-floor :added "4.1"}
(fact "emits floor"
  (string/includes? (pr-str (dart-tf-x-m-floor '[_ x])) "floor")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-sin :added "4.1"}
(fact "emits sine"
  (string/includes? (pr-str (dart-tf-x-m-sin '[_ x])) "math.sin")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-cos :added "4.1"}
(fact "emits cosine"
  (string/includes? (pr-str (dart-tf-x-m-cos '[_ x])) "math.cos")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-tan :added "4.1"}
(fact "emits tangent"
  (string/includes? (pr-str (dart-tf-x-m-tan '[_ x])) "math.tan")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-asin :added "4.1"}
(fact "emits arc sine"
  (string/includes? (pr-str (dart-tf-x-m-asin '[_ x])) "math.asin")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-acos :added "4.1"}
(fact "emits arc cosine"
  (string/includes? (pr-str (dart-tf-x-m-acos '[_ x])) "math.acos")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-atan :added "4.1"}
(fact "emits arc tangent"
  (string/includes? (pr-str (dart-tf-x-m-atan '[_ x])) "math.atan")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-sqrt :added "4.1"}
(fact "emits square root"
  (string/includes? (pr-str (dart-tf-x-m-sqrt '[_ x])) "math.sqrt")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-exp :added "4.1"}
(fact "emits exponential"
  (string/includes? (pr-str (dart-tf-x-m-exp '[_ x])) "math.exp")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-loge :added "4.1"}
(fact "emits natural logarithm"
  (string/includes? (pr-str (dart-tf-x-m-loge '[_ x])) "math.log")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-log10 :added "4.1"}
(fact "emits base ten logarithm"
  (let [out (pr-str (dart-tf-x-m-log10 '[_ x]))]
    [(string/includes? out "math.log")
     (string/includes? out "math.ln10")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-max :added "4.1"}
(fact "selects the greater value"
  (let [out (pr-str (dart-tf-x-m-max '[_ a b]))]
    [(string/includes? out ">")
     (string/includes? out "a")
     (string/includes? out "b")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-min :added "4.1"}
(fact "selects the lesser value"
  (let [out (pr-str (dart-tf-x-m-min '[_ a b]))]
    [(string/includes? out "<")
     (string/includes? out "a")
     (string/includes? out "b")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-mod :added "4.1"}
(fact "emits modulo"
  (string/includes? (pr-str (dart-tf-x-m-mod '[_ a b])) "%")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-pow :added "4.1"}
(fact "emits power"
  (string/includes? (pr-str (dart-tf-x-m-pow '[_ a b])) "math.pow")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-quot :added "4.1"}
(fact "emits integer quotient"
  (string/includes? (pr-str (dart-tf-x-m-quot '[_ a b])) "~/")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-cosh :added "4.1"}
(fact "emits hyperbolic cosine from exponentials"
  (let [out (pr-str (dart-tf-x-m-cosh '[_ x]))]
    [(string/includes? out "math.exp")
     (string/includes? out "/")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-sinh :added "4.1"}
(fact "emits hyperbolic sine from exponentials"
  (let [out (pr-str (dart-tf-x-m-sinh '[_ x]))]
    [(string/includes? out "math.exp")
     (string/includes? out "/")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-m-tanh :added "4.1"}
(fact "emits hyperbolic tangent from exponentials"
  (let [out (pr-str (dart-tf-x-m-tanh '[_ x]))]
    [(string/includes? out "math.exp")
     (string/includes? out "/")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-to-string :added "4.1"}
(fact "converts a value to string"
  (string/includes? (pr-str (dart-tf-x-to-string '[_ x])) "toString")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-to-number :added "4.1"}
(fact "converts a value to number"
  (string/includes? (pr-str (dart-tf-x-to-number '[_ x])) "num.parse")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-string? :added "4.1"}
(fact "checks Dart strings"
  (string/includes? (pr-str (dart-tf-x-is-string? '[_ x])) "String")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-number? :added "4.1"}
(fact "checks Dart numeric types"
  (let [out (pr-str (dart-tf-x-is-number? '[_ x]))]
    [(string/includes? out "int")
     (string/includes? out "double")
     (string/includes? out "num")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-integer? :added "4.1"}
(fact "checks Dart integers"
  (string/includes? (pr-str (dart-tf-x-is-integer? '[_ x])) "int")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-boolean? :added "4.1"}
(fact "checks Dart booleans"
  (string/includes? (pr-str (dart-tf-x-is-boolean? '[_ x])) "bool")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-function? :added "4.1"}
(fact "checks Dart functions"
  (let [out (pr-str (dart-tf-x-is-function? '[_ x]))]
    [(string/includes? out "Function")
     (string/includes? out "Closure")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-object? :added "4.1"}
(fact "checks Dart maps"
  (let [out (pr-str (dart-tf-x-is-object? '[_ x]))]
    [(string/includes? out "Map")
     (string/includes? out "LinkedMap")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-is-array? :added "4.1"}
(fact "checks Dart lists"
  (let [out (pr-str (dart-tf-x-is-array? '[_ x]))]
    [(string/includes? out "List")
     (string/includes? out "GrowableList")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-char :added "4.1"}
(fact "gets a string code unit"
  (let [out (pr-str (dart-tf-x-str-char '[_ s i]))]
    [(string/includes? out "codeUnitAt")
     (string/includes? out "x:offset")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-split :added "4.1"}
(fact "splits strings"
  (string/includes? (pr-str (dart-tf-x-str-split '[_ s sep])) "split")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-join :added "4.1"}
(fact "joins strings"
  (string/includes? (pr-str (dart-tf-x-str-join '[_ sep arr])) "join")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-index-of :added "4.1"}
(fact "finds a string index with the portable offset"
  (let [out (pr-str (dart-tf-x-str-index-of '[_ s sub]))]
    [(string/includes? out "indexOf")
     (string/includes? out "x:offset")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-last-index-of :added "4.1"}
(fact "finds the last string index"
  (string/includes? (pr-str (dart-tf-x-str-last-index-of '[_ s sub])) "lastIndexOf")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-substring :added "4.1"}
(fact "extracts a substring"
  (let [out (pr-str (dart-tf-x-str-substring '[_ s start end]))]
    [(string/includes? out "substring")
     (string/includes? out "x:offset")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-to-upper :added "4.1"}
(fact "uppercases strings"
  (string/includes? (pr-str (dart-tf-x-str-to-upper '[_ s])) "toUpperCase")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-to-lower :added "4.1"}
(fact "lowercases strings"
  (string/includes? (pr-str (dart-tf-x-str-to-lower '[_ s])) "toLowerCase")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-to-fixed :added "4.1"}
(fact "formats fixed precision strings"
  (string/includes? (pr-str (dart-tf-x-str-to-fixed '[_ s n])) "toStringAsFixed")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-replace :added "4.1"}
(fact "replaces string values"
  (string/includes? (pr-str (dart-tf-x-str-replace '[_ s pattern replacement])) "replaceAll")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-trim :added "4.1"}
(fact "trims strings"
  (string/includes? (pr-str (dart-tf-x-str-trim '[_ s])) "trim")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-trim-left :added "4.1"}
(fact "trims strings on the left"
  (string/includes? (pr-str (dart-tf-x-str-trim-left '[_ s])) "trimLeft")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-trim-right :added "4.1"}
(fact "trims strings on the right"
  (string/includes? (pr-str (dart-tf-x-str-trim-right '[_ s])) "trimRight")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-starts-with? :added "4.1"}
(fact "checks string prefixes"
  (string/includes? (pr-str (dart-tf-x-str-starts-with? '[_ s prefix])) "startsWith")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-ends-with? :added "4.1"}
(fact "checks string suffixes"
  (string/includes? (pr-str (dart-tf-x-str-ends-with? '[_ s suffix])) "endsWith")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-str-includes? :added "4.1"}
(fact "checks string containment"
  (string/includes? (pr-str (dart-tf-x-str-includes? '[_ s sub])) "contains")
  => true)

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lu-create :added "4.1"}
(fact "creates a lookup map literal"
  (dart-tf-x-lu-create '[_])
  => '{} )

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lu-get :added "4.1"}
(fact "gets a lookup value"
  (dart-tf-x-lu-get '[_ lu obj])
  => '(. lu [obj]))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lu-set :added "4.1"}
(fact "sets a lookup value"
  (dart-tf-x-lu-set '[_ lu obj gid])
  => '(:= (. lu [obj]) gid))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-lu-del :added "4.1"}
(fact "deletes a lookup value"
  (dart-tf-x-lu-del '[_ lu obj])
  => '(. lu (remove obj)))

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-json-compact-expr :added "4.1"}
(fact "builds the compact JSON expression"
  (let [out (pr-str (dart-json-compact-expr 'value))]
    [(string/includes? out "omitNilKeys")
     (string/includes? out "Function")
     (string/includes? out "compact")])
  => [true true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-obj-keys :added "4.1"}
(fact "lists object keys"
  (let [out (pr-str (dart-tf-x-obj-keys '[_ obj]))]
    [(string/includes? out "List<dynamic>")
     (string/includes? out "keys")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-obj-vals :added "4.1"}
(fact "lists object values"
  (let [out (pr-str (dart-tf-x-obj-vals '[_ obj]))]
    [(string/includes? out "List<dynamic>")
     (string/includes? out "values")])
  => [true true])

^{:refer lang.model.v1.spec-xtalk.fn-dart/dart-tf-x-obj-pairs :added "4.1"}
(fact "lists object entries"
  (let [out (pr-str (dart-tf-x-obj-pairs '[_ obj]))]
