(ns lang.core.grammar-registry-test
  (:use code.test)
  (:require [lang.common.book :as book]
            [lang.core.registry :as registry]
            [std.foundation :as foundation]))

^{:refer lang.core.registry/registry-namespace-loaded?}
(fact "requiring the registry does not load model specifications"
  (mapv (fn [namespace-symbol]
          (registry/registry-namespace-loaded? namespace-symbol))
        [(quote lang.model.v1.spec-xtalk)
         (quote lang.model.v1.spec-hara)
         (quote lang.model.v1.spec-postgres)
         (quote lang.model.v1.spec-glsl)
         (quote lang.model.v1.spec-c)
         (quote lang.model.v1.spec-js)
         (quote lang.model.v1.spec-python)
         (quote lang.model.v1.spec-lua)])
  => [false false false false false false false false])

^{:refer lang.core.registry/registry-grammar-list}
(fact "an exact grammar query loads only that grammar and its parent"
  (let [sources (registry/registry-grammar-list {:source/id :c
                                                  :source/kind :grammar})
        states (mapv (fn [namespace-symbol]
                       (:namespace/state (foundation/ns-info namespace-symbol)))
                     [(quote lang.model.v1.spec-xtalk)
                      (quote lang.model.v1.spec-hara)
                      (quote lang.model.v1.spec-postgres)
                      (quote lang.model.v1.spec-glsl)
                      (quote lang.model.v1.spec-c)])]
    [(mapv (fn [source] (:source/id source)) sources)
     states])
  => [[:c] [:loaded :unloaded :unloaded :unloaded :loaded]])

^{:refer lang.core.registry/registry-grammar-load}
(fact "grammar loading is idempotent"
  (let [first-catalog (registry/registry-grammar-load :c)
        second-catalog (registry/registry-grammar-load :c)]
    [(= first-catalog second-catalog)
     (registry/registry-grammar-versions :c)])
  => [true [1]])

(fact "grammar resolution is independent and exactly versioned"
  (let [selection (registry/registry-grammar :c 1)]
    [(:coordinate selection)
     (registry/registry-grammar-versions :c)])
  => [{:grammar/release "foundation-v1"
       :grammar/version 1
       :grammar/id :c
       :grammar/facets []}
      [1]])

(fact "the source grammar set excludes direct target books"
  (set (map (fn [source] (:source/id source))
            (registry/registry-grammar-list {:source/kind :grammar})))
  => #{:xtalk :hara :postgres :glsl :c})

(fact "language books are persistent values pinned to exact grammars"
  (mapv (fn [language]
          (let [value (registry/registry-book language)]
            [(book/book? value)
             (:grammar-coordinate value)]))
        [:xtalk :hara :js :python :lua :postgres :glsl :c])
  => [[true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :xtalk
             :grammar/facets []}]
      [true {:grammar/release "hara-v1"
             :grammar/version 1
             :grammar/id :hara
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :js
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :py
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :lua
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :postgres
             :grammar/facets []}]
      [true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :glsl
             :grammar/facets []}]
      [true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :c
             :grammar/facets []}]])

(fact "direct target books keep their immutable empty provenance"
  (mapv (fn [language]
          [language
           (:provenance (:selection (registry/registry-book language)))])
        [:js :python :lua])
  => [[:js []] [:python []] [:lua []]])
