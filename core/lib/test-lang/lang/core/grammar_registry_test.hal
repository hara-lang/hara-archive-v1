(ns lang.core.grammar-registry-test
  (:use code.test)
  (:require [lang.common.book :as book]
            [lang.core.registry :as registry]))

(fact "grammar resolution is independent and exactly versioned"
  (let [selection (registry/registry-grammar :c 1)]
    [(:coordinate selection)
     (registry/registry-grammar-versions :c)])
  => [{:grammar/release "foundation-v1"
       :grammar/version 1
       :grammar/id :c
       :grammar/facets []}
      [1]])

(fact "the source grammar set excludes direct target books"
  (set (map (fn [source] (:source/id source))
            (registry/registry-grammar-list {:source/kind :grammar})))
  => #{:xtalk :hara :postgres :glsl :c})

(fact "language books are persistent values pinned to exact grammars"
  (mapv (fn [language]
          (let [value (registry/registry-book language)]
            [(book/book? value)
             (:grammar-coordinate value)]))
        [:xtalk :hara :js :python :lua :postgres :glsl :c])
  => [[true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :xtalk
             :grammar/facets []}]
      [true {:grammar/release "hara-v1"
             :grammar/version 1
             :grammar/id :hara
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :js
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :py
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :lua
             :grammar/facets []}]
      [true {:grammar/release "alpha"
             :grammar/version 1
             :grammar/id :postgres
             :grammar/facets []}]
      [true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :glsl
             :grammar/facets []}]
      [true {:grammar/release "foundation-v1"
             :grammar/version 1
             :grammar/id :c
             :grammar/facets []}]])

(fact "direct target books keep their immutable empty provenance"
  (mapv (fn [language]
          [language
           (:provenance (:selection (registry/registry-book language)))])
        [:js :python :lua])
  => [[:js []] [:python []] [:lua []]])
