(ns lang.seedgen.form-common-test
  (:use code.test)
  (:require [std.block.base :as block]
            [std.block.navigate :as nav]
            [lang.seedgen.form-common :as subject]))

(def +sample-source+
  (str "^{:refer demo/example\n"
       "  :setup [(!.js (+ 1 2))\n"
       "          (!.lua (+ 1 2))]}\n"
       "(fact \"demo\"\n"
       "  (!.js (+ 1 2))\n"
       "  => 3)\n\n"
       "(def +k+ 1)\n"))

(def sample-root (nav/parse-root +sample-source+))
(def sample-top-navs (subject/nav-top-levels sample-root))

^{:refer lang.seedgen.form-common/target-normalize-langs}
(fact "normalizes requested runtimes while preserving sentinel cases"
  [(subject/target-normalize-langs :js)
   (subject/target-normalize-langs '("js" :lua))
   (subject/target-normalize-langs :all [:js :lua])
   (subject/target-normalize-langs nil [:js :lua])
   (subject/target-normalize-langs :all)]
  => [[:js]
      [:js :lua]
      [:js :lua]
      [:js :lua]
      :all])

^{:refer lang.seedgen.form-common/nav-meta-block?}
(fact "detects metadata-wrapped top-level forms"
  (let [[fact-nav def-nav] sample-top-navs]
    [(subject/nav-meta-block? fact-nav)
     (subject/nav-meta-block? def-nav)])
  => [true false])

^{:refer lang.seedgen.form-common/nav-meta}
(fact "returns the metadata map location when present"
  (let [[fact-nav] sample-top-navs]
    (some-> fact-nav
            subject/nav-meta
            nav/block
            block/block-value))
  => {:refer 'demo/example
      :setup '[(!.js (+ 1 2))
               (!.lua (+ 1 2))]})

^{:refer lang.seedgen.form-common/nav-body}
(fact "unwraps metadata forms to the underlying body form"
  (let [[fact-nav def-nav] sample-top-navs]
    [(-> fact-nav subject/nav-body nav/value first)
     (-> def-nav subject/nav-body nav/value first)])
  => ['fact 'def])

^{:refer lang.seedgen.form-common/nav-top-levels}
(fact "collects each top-level form from the parsed root"
  (mapv #(-> % nav/block block/block-string)
        sample-top-navs)
  => ["^{:refer demo/example\n  :setup [(!.js (+ 1 2))\n          (!.lua (+ 1 2))]}\n(fact \"demo\"\n  (!.js (+ 1 2))\n  => 3)"
      "(def +k+ 1)"])

^{:refer lang.seedgen.form-common/nav-entry}
(fact "captures the original block and line metadata"
  (let [[fact-nav] sample-top-navs
        entry (subject/nav-entry fact-nav)]
    [(-> entry :form block/block-string)
     (select-keys (:line entry) [:row :col])])
  => ["^{:refer demo/example\n  :setup [(!.js (+ 1 2))\n          (!.lua (+ 1 2))]}\n(fact \"demo\"\n  (!.js (+ 1 2))\n  => 3)"
      {:row 1 :col 1}])

^{:refer lang.seedgen.form-common/nav-map-value}
(fact "finds the value location for a key inside a map"
  (let [[fact-nav] sample-top-navs]
    (some-> fact-nav
            subject/nav-meta
            (subject/nav-map-value :setup)
            nav/block
            block/block-value))
  => '[(!.js (+ 1 2))
       (!.lua (+ 1 2))])

^{:refer lang.seedgen.form-common/nav-vector-items}
(fact "iterates vector items from left to right"
  (let [[fact-nav] sample-top-navs]
    (-> fact-nav
        subject/nav-meta
        (subject/nav-map-value :setup)
        subject/nav-vector-items
        ((fn [items]
           (mapv #(-> % nav/block block/block-value) items)))))
  => '[(!.js (+ 1 2))
       (!.lua (+ 1 2))])

^{:refer lang.seedgen.form-common/item-line-key}
(fact "reduces line maps to a sortable coordinate tuple"
  (subject/item-line-key {:row 3 :col 4 :end-row 5 :end-col 6})
  => [3 4 5 6])

^{:refer lang.seedgen.form-common/item-form}
(fact "returns the stored block for an item entry"
  (let [[fact-nav] sample-top-navs]
    (-> fact-nav subject/nav-entry subject/item-form block/block-string))
  => "^{:refer demo/example\n  :setup [(!.js (+ 1 2))\n          (!.lua (+ 1 2))]}\n(fact \"demo\"\n  (!.js (+ 1 2))\n  => 3)")

^{:refer lang.seedgen.form-common/item-line}
(fact "returns the original line map for an item entry"
  (let [[fact-nav] sample-top-navs]
    (-> fact-nav subject/nav-entry subject/item-line (select-keys [:row :col])))
  => {:row 1 :col 1})

^{:refer lang.seedgen.form-common/item-string}
(fact "renders an item block back to source text"
  (let [[fact-nav] sample-top-navs]
    (-> fact-nav subject/nav-entry subject/item-string))
  => "^{:refer demo/example\n  :setup [(!.js (+ 1 2))\n          (!.lua (+ 1 2))]}\n(fact \"demo\"\n  (!.js (+ 1 2))\n  => 3)")

^{:refer lang.seedgen.form-common/item-value}
(fact "returns the EDN value represented by an item block"
  (let [[fact-nav] sample-top-navs]
    (-> fact-nav subject/nav-entry subject/item-value first))
  => 'fact)

^{:refer lang.seedgen.form-common/item-lang}
(fact "infers the runtime from a dispatch form"
  (let [[fact-nav] sample-top-navs
        setup-item (-> fact-nav
                       subject/nav-meta
                       (subject/nav-map-value :setup)
                       subject/nav-vector-items
                       second
                       subject/nav-entry)]
    (subject/item-lang setup-item))
  => :lua)

^{:refer lang.seedgen.form-common/item-sort}
(fact "sorts item entries by source position"
  (let [[fact-nav] sample-top-navs
        items (-> fact-nav
                  subject/nav-meta
                  (subject/nav-map-value :setup)
                  subject/nav-vector-items)
        [js-item lua-item] (map subject/nav-entry items)]
    (->> [lua-item js-item]
         subject/item-sort
         (mapv subject/item-lang)))
  => [:js :lua])

^{:refer lang.seedgen.form-common/item-classify-langs}
(fact "flattens a classification map into source order"
  (let [[fact-nav] sample-top-navs
        items (-> fact-nav
                  subject/nav-meta
                  (subject/nav-map-value :setup)
                  subject/nav-vector-items)
        [js-item lua-item] (map subject/nav-entry items)]
    (->> {:root [js-item]
          :derived [lua-item]
          :scaffold []}
         subject/item-classify-langs
         (mapv subject/item-lang)))
  => [:js :lua])

^{:refer lang.seedgen.form-common/item-runtime-map}
(fact "indexes classified runtime items by normalized runtime keyword"
  (let [[fact-nav] sample-top-navs
        items (-> fact-nav
                  subject/nav-meta
                  (subject/nav-map-value :setup)
                  subject/nav-vector-items)
        [js-item lua-item] (map subject/nav-entry items)]
    (->> {:root [js-item]
          :derived [lua-item]
          :scaffold []}
         subject/item-runtime-map
         (reduce-kv (fn [out k v]
                      (assoc out k (subject/item-string v)))
                    {})))
  => {:js "(!.js (+ 1 2))"
      :lua "(!.lua (+ 1 2))"})

(pr-str (run {:namespace "lang.seedgen.form-common-test"}))
