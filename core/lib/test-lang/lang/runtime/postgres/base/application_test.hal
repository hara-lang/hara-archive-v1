(ns lang.runtime.postgres.base.application-test
  (:require [lang.runtime.postgres.base.application :as app]
            [lang.core.script :as script])
  (:use code.test))

^{:refer lang.runtime.postgres.base.application/application-string}
(fact "provides Foundation application inspection functions"
  (app/application-string
   {:tables {'users/User {} 'posts/Post {}}})
  => "#pg.app [2]\nposts/Post users/User\n"

  (app/application-string {:tables {}})
  => "#pg.app [0]\n\n"

  (app/app-list-entries {:tables {}}) => nil

  (app/app-get-entry
   {:schema {:tree {"User" {:id :user}}}}
   'User)
  => {:id :user}

  (app/app-get-deps
   {:tables
    {'users/User
     [{:ref {:ns 'ignored.module}}
      {:ref {:ns 'required.module}}]}}
   'users/User)
  => '#{required.module})

^{:refer lang.runtime.postgres.base.application/app-create-raw}
(fact "creates linked schema, pointer, ordering, and typed application data"
  (let [links {'Account {:id 'Account
                         :module 'demo
                         :lang :postgres
                         :section :code}}
        application
        (app/app-create-raw
         {'demo/User
          [:id {:type :uuid :primary true}
           :account-id {:type :ref :ref {:key :Account/id}}]}
         links
         {:tables {} :enums {} :functions {}})]
    [(get-in application [:schema :tree "User" :account-id 0 :ref :link])
     (get-in application [:schema :tree "User" :account-id 1])
     (:lu application)
     (:typed application)])
  => [{:id 'Account :module 'demo :lang :postgres :section :code}
      1
      {:demo/User 0}
      {:tables {} :enums {} :functions {}}])

^{:refer lang.runtime.postgres.base.application/module-typed}
(fact "creates typed table and module function indexes"
  (let [module {:id 'demo.application
                :code
                {'ping
                 {:form-input
                  '(defn.pg ^{:- [:text]} ping [] "pong")}}}
        module-typed (app/module-typed [module])
        application-typed
        (app/app-create-typed
         {'demo.application/User [:id {:type :uuid :primary true}]}
         [module])]
    [(count (:functions module-typed))
     (count (:tables module-typed))
     (count (:tables application-typed))
     (count (:functions application-typed))])
  => [1 0 1 1])

^{:refer lang.runtime.postgres.base.application/app-create}
(fact "creates applications from registered PostgreSQL table entries"
  (let [original-modules (deref script/+modules+)
        module-name 'demo.application
        result
        (try
          (reset! script/+modules+
                  {module-name
                   {:id module-name
                    :static {:application ["portable-app"]}
                    :code
                    {'User
                     {:id 'User
                      :module module-name
                      :op 'deftype
                      :lang :postgres
                      :section :code
                      :static/public true
                      :static/schema-seed
                      {:User {:id {:type :uuid :primary true}}}}}}})
          (let [application (app/app-create "portable-app")]
            [(count (app/app-modules "portable-app"))
             (get-in application [:schema :tree "User" :id 0 :type])
             (get-in application [:pointers 'User :module])])
          (finally
            (reset! script/+modules+ original-modules)))]
    result)
  => [1 :uuid 'demo.application])

^{:refer lang.runtime.postgres.base.application/app-reset}
(fact "rebuilds, lazily types, and clears registered applications"
  (let [original (app/app)
        result
        (try
          (app/app-reset)
          (app/register-app
           "portable-app"
           {:tables {'User [:id {:type :uuid :primary true}]}
            :pointers {}})
          (let [typed-info (app/app-typed "portable-app")
                rebuilt (app/app-rebuild "portable-app")
                cleared (app/app-clear "portable-app")]
            [(count (:tables typed-info))
             (count (:tables (:typed rebuilt)))
             cleared
             (app/app "portable-app")])
          (finally
            (reset! app/*applications* original)))]
    result)
  => [1 1 nil nil])

(pr-str (run '[lang.runtime.postgres.base.application-test]))
