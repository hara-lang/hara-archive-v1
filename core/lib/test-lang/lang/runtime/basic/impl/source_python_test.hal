(ns lang.runtime.basic.impl.source-python-test
  (:use code.test)
  (:require [lang.runtime.basic.impl.source-python :as subject]))

^{:refer lang.runtime.basic.impl.source-python/transport-source :added "4.1"}
(fact "emits the CPython return pipeline with the requested port"
  (let [source (subject/transport-source 45678)]
    [(str/starts-with? source "import ast,json,math,socket,traceback")
     (str/includes? source "127.0.0.1',45678")
     (str/includes? source "ast.parse")
     (str/includes? source "def return_encode(value):")
     (str/includes? source "def return_wrap(thunk):")
     (str/includes? source "def return_eval(source):")
     (str/includes? source "'type':'error'")])
  => [true true true true true true true])

(run {:namespace "lang.runtime.basic.impl.source-python-test"})
