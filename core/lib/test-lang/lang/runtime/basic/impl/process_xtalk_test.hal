(ns lang.runtime.basic.impl.process-xtalk-test
  (:use code.test)
  (:require [lang.core.eval :as evaluation]
            [lang.core.registry :as registry]
            [lang.core.runtime :as runtime]
            [lang.runtime.basic.impl.process-xtalk :as subject]
            [lang.runtime.basic.type-hara :as hara-basic]
            [lang.runtime.standard :as standard]))

(defn await
  [value]
  (evaluation/await value 2000))

^{:refer lang.core.runtime/rt-create :added "4.1"}
(fact "registers host and child-process implementations at the XTalk and Hara coordinates"
  [(registry/registry-runtime-ns :xtalk :host)
   (registry/registry-runtime-ns :hara :host)
   (registry/registry-runtime-ns :xtalk :basic)
   (registry/registry-runtime-ns :hara :basic)
   (:type (runtime/runtime-spec :xtalk :host))
   (:type (runtime/runtime-spec :hara :host))
   (:type (runtime/runtime-spec :xtalk :basic))
   (:type (runtime/runtime-spec :hara :basic))]
  => ['lang.runtime.basic.impl.process-xtalk
      'lang.runtime.basic.impl.process-xtalk
      'lang.runtime.basic.impl.process-hara
      'lang.runtime.basic.impl.process-hara
      :lang/rt.hara-basic
      :lang/rt.hara-basic
      :lang/rt.hara-basic
      :lang/rt.hara-basic])

^{:refer lang.runtime.basic.impl.process-xtalk/+xtalk-host+ :added "4.1"}
(fact "installs the XTalk host runtime without a process transport"
  [(:lang subject/+xtalk-host+)
   (:runtime subject/+xtalk-host+)
   (get-in subject/+xtalk-host+ [:config :transport])]
  => [:xtalk :host :in-process])

^{:refer lang.runtime.basic.impl.process-xtalk/+hara-host+ :added "4.1"}
(fact "installs the explicit Hara host alias without a process transport"
  [(:lang subject/+hara-host+)
   (:runtime subject/+hara-host+)
   (get-in subject/+hara-host+ [:config :transport])]
  => [:hara :host :in-process])

^{:refer lang.runtime.basic.impl.process-xtalk/+init+ :added "4.1"}
(fact "publishes both Hara host runtime coordinates"
  [(:lang subject/+init+)
   (:target subject/+init+)
   (boolean (:xtalk-host subject/+init+))
   (boolean (:hara-host subject/+init+))]
  => [:xtalk :hara true true])

^{:refer lang.runtime.basic.type-hara/raw-eval-hara-basic :added "4.1"}
(fact "persists Hara Vars inside one host runtime namespace"
  (let [instance
        (runtime/rt-start
         (runtime/rt-create
          :xtalk :host
          {:id :xtalk-persistent-test
           :namespace 'lang.xtalk.test.persistent}))
        defined (runtime/rt-raw-eval instance "(def counter 1)")
        incremented
        (runtime/rt-raw-eval instance
                             "(set! counter (+ counter 1))")
        observed (runtime/rt-raw-eval instance "counter")
        state (hara-basic/hara-basic-state instance)
        stopped (runtime/rt-stop instance)]
    [defined
     incremented
     observed
     (:evaluations state)
     (:target state)
     (:status (hara-basic/hara-basic-state stopped))
     (get instance :transport)])
  => [1 2 2 3 :hara :stopped nil])

^{:refer lang.runtime.basic.type-hara/eval-hara-basic :added "4.1"}
(fact "compiles XTalk forms into native Hara arrays and objects on the host"
  (let [instance
        (runtime/rt-start
         (runtime/rt-create
          :xtalk :host
          {:id :xtalk-semantic-test
           :namespace 'lang.xtalk.test.semantic}))
        arithmetic (await (runtime/rt-eval instance '(+ 19 23)))
        mutable-array
        (await
         (runtime/rt-eval
          instance
          '(do
             (var values := [1 2])
             (x:arr-push values 3)
             (x:set-idx values 0 9)
             values)))
        mutable-object
        (await
         (runtime/rt-eval
          instance
          '(do
             (var value := {"a" 1})
             (x:set-key value "b" 2)
             value)))
        early-return
        (await
         (runtime/rt-eval
          instance
          '((fn [value]
              (when (> value 0)
                (return value))
              (return 0))
            7)))
        state (hara-basic/hara-basic-state instance)]
    (runtime/rt-stop instance)
    [arithmetic
     (standard/arr? mutable-array)
     [(standard/arr-get mutable-array 0)
      (standard/arr-get mutable-array 1)
      (standard/arr-get mutable-array 2)]
     (standard/obj? mutable-object)
     [(standard/obj-get mutable-object "a")
      (standard/obj-get mutable-object "b")]
     early-return
     (:evaluations state)
     (:last-compiled? state)])
  => [42 true [9 2 3] true [1 2] 7 4 true])

^{:refer lang.runtime.basic.type-hara/rt-hara-basic:create :added "4.1"}
(fact "isolates persistent Vars by runtime namespace"
  (let [left
        (runtime/rt-start
         (runtime/rt-create
          :xtalk :host
          {:id :xtalk-left
           :namespace 'lang.xtalk.test.left}))
        right
        (runtime/rt-start
         (runtime/rt-create
          :xtalk :host
          {:id :xtalk-right
           :namespace 'lang.xtalk.test.right}))]
    (runtime/rt-raw-eval left "(def value 11)")
    (runtime/rt-raw-eval right "(def value 29)")
    (let [result [(runtime/rt-raw-eval left "value")
                  (runtime/rt-raw-eval right "value")]]
      (runtime/rt-stop left)
      (runtime/rt-stop right)
      result))
  => [11 29])

^{:refer lang.core.runtime/rt-create :added "4.1"}
(fact "provides the explicit Hara alias over the same grammar and evaluator"
  (let [instance
        (runtime/rt-start
         (runtime/rt-create
          :hara :host
          {:id :hara-basic-alias
           :namespace 'lang.xtalk.test.hara_alias}))
        result (await (runtime/rt-eval instance '(x:cat "hara" "-" "xtalk")))
        descriptor [(get instance :lang)
                    (get instance :target)
                    (get-in instance [:book :coordinate])]]
    (runtime/rt-stop instance)
    [result descriptor])
  => ["hara-xtalk"
      [:hara
       :hara
       {:grammar/id :hara
        :grammar/variant :default
        :grammar/version 1}]])

^{:refer lang.runtime.basic.type-hara/stop-hara-basic :added "4.1"}
(fact "rejects evaluation after the runtime is stopped"
  (let [instance
        (runtime/rt-start
         (runtime/rt-create
          :xtalk :host
          {:id :xtalk-stopped-test
           :namespace 'lang.xtalk.test.stopped}))]
    (runtime/rt-stop instance)
    (try
      (runtime/rt-eval instance '(+ 1 2))
      nil
      (catch Throwable error
        [(ex-message error)
         (get (ex-data error) :lang)
         (get-in (ex-data error) [:state :status])])))
  => ["Hara basic runtime is not started"
      :xtalk
      :stopped])
