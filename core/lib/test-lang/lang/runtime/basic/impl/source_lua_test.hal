(ns lang.runtime.basic.impl.source-lua-test
  (:use code.test)
  (:require [lang.runtime.basic.impl.source-lua :as subject]))

^{:refer lang.runtime.basic.impl.source-lua/transport-source :added "4.1"}
(fact "emits the LuaSocket return pipeline with the requested port"
  (let [source (subject/transport-source 45678)]
    [(str/starts-with? source "local socket=")
     (str/includes? source "127.0.0.1',45678")
     (str/includes? source "cjson.decode")
     (str/includes? source "local function return_encode")
     (str/includes? source "local function return_wrap")
     (str/includes? source "local function return_eval")
     (str/includes? source "cjson.array_mt")])
  => [true true true true true true true])

(run {:namespace "lang.runtime.basic.impl.source-lua-test"})
