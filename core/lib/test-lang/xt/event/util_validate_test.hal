(ns xt.event.util-validate-test (:require [lang.core :as l] [xt.lang.common-notify :as notify]) (:use code.test))

^{:seedgen/root {:all true :langs [:js :lua :python]}} (l/script- :js {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-validate :as validate]] :runtime :basic})

(l/script- :lua {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-validate :as validate]] :runtime :basic})

(l/script- :python {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-validate :as validate]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.lang.spec-promise/x:promise-run :added "4.1"} (fact "wraps raw values through the promise interface" (!.js (xt/x:is-function? spec-promise/x:promise-run)) => true (!.lua (xt/x:is-function? spec-promise/x:promise-run)) => true (!.py (xt/x:is-function? spec-promise/x:promise-run)) => true)

^{:refer xt.event.util-validate/validate-step :added "4.1"} (fact "validates a single guard and marks the field" (notify/wait-on :js (var data {:first "hello"}) (var guards [["is-not-empty" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}]]) (var result {:fields {:first {:status "pending"}}}) (validate/validate-step data "first" guards 0 result nil (fn [success out] (repl/notify out)))) => {"fields" {"first" {"status" "ok"}}} (notify/wait-on :lua (var data {:first "hello"}) (var guards [["is-not-empty" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}]]) (var result {:fields {:first {:status "pending"}}}) (validate/validate-step data "first" guards 0 result nil (fn [success out] (repl/notify out)))) => {"fields" {"first" {"status" "ok"}}} (notify/wait-on :python (var data {:first "hello"}) (var guards [["is-not-empty" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}]]) (var result {:fields {:first {:status "pending"}}}) (validate/validate-step data "first" guards 0 result nil (fn [success out] (repl/notify out)))) => {"fields" {"first" {"status" "ok"}}})

^{:refer xt.event.util-validate/validate-field :added "4.1"} (fact "validates a field through ordered guards" (notify/wait-on :js (var data {:first "hello"}) (var check-async (fn [v rec] (return (spec-promise/x:with-delay 50 (fn [] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))))))) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}] ["is-not-empty-2" {:check check-async :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "ok"}}} (notify/wait-on :js (var data {:first "hello"}) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return true)) :message "Must not be empty"}] ["is-not-empty-2" {:check (fn [v rec] (return false)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"message" "Must not be empty" "data" "hello" "status" "errored" "id" "is-not-empty-2"}}} (notify/wait-on :lua (var data {:first "hello"}) (var check-async (fn [v rec] (return (spec-promise/x:with-delay 50 (fn [] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))))))) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}] ["is-not-empty-2" {:check check-async :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "ok"}}} (notify/wait-on :lua (var data {:first "hello"}) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return true)) :message "Must not be empty"}] ["is-not-empty-2" {:check (fn [v rec] (return false)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"message" "Must not be empty" "data" "hello" "status" "errored" "id" "is-not-empty-2"}}} (notify/wait-on :python (var data {:first "hello"}) (var check-async (fn [v rec] (return (spec-promise/x:with-delay 50 (fn [] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))))))) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return (and (xt/x:not-nil? v) (< 0 (xt/x:len v))))) :message "Must not be empty"}] ["is-not-empty-2" {:check check-async :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "ok"}}} (notify/wait-on :python (var data {:first "hello"}) (var validators {:first [["is-not-empty-1" {:check (fn [v rec] (return true)) :message "Must not be empty"}] ["is-not-empty-2" {:check (fn [v rec] (return false)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-field data "first" validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"message" "Must not be empty" "data" "hello" "status" "errored" "id" "is-not-empty-2"}}})

^{:seedgen/base {:lua {:suppress true}} :refer xt.event.util-validate/validate-fields-loop :added "4.1"} (fact "walks fields through a single validation promise chain" (notify/wait-on :js (var data {:last "world" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-fields-loop data validators result ["first" "last"] 0 nil (fn [success out] (repl/notify out)))) => {"::" "validation.result" "status" "ok" "fields" {"first" {"status" "ok"} "last" {"status" "ok"}}} (notify/wait-on :js (var data {:last "" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return false)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-fields-loop data validators result ["first" "last"] 0 nil (fn [success out] (repl/notify out)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"status" "ok"} "last" {"message" "Must not be empty" "data" "" "status" "errored" "id" "is-not-empty"}}} (notify/wait-on :python (var data {:last "world" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-fields-loop data validators result ["first" "last"] 0 nil (fn [success out] (repl/notify out)))) => {"::" "validation.result" "status" "ok" "fields" {"first" {"status" "ok"} "last" {"status" "ok"}}} (notify/wait-on :python (var data {:last "" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return false)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-fields-loop data validators result ["first" "last"] 0 nil (fn [success out] (repl/notify out)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"status" "ok"} "last" {"message" "Must not be empty" "data" "" "status" "errored" "id" "is-not-empty"}}})

^{:seedgen/base {:lua {:suppress true}} :refer xt.event.util-validate/validate-all :added "4.1"} (fact "validates all fields through a single promise chain" (notify/wait-on :js (var data {:last "world" :first "hello"}) (var check-async (fn [v rec] (return (spec-promise/x:with-delay 50 (fn [] (return true)))))) (var validators {:last [["is-not-empty" {:check check-async :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-all data validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "ok" "fields" {"first" {"status" "ok"} "last" {"status" "ok"}}} (notify/wait-on :js (var data {:last "" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return false)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-all data validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"status" "ok"} "last" {"message" "Must not be empty" "data" "" "status" "errored" "id" "is-not-empty"}}} (notify/wait-on :python (var data {:last "world" :first "hello"}) (var check-async (fn [v rec] (return (spec-promise/x:with-delay 50 (fn [] (return true)))))) (var validators {:last [["is-not-empty" {:check check-async :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-all data validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "ok" "fields" {"first" {"status" "ok"} "last" {"status" "ok"}}} (notify/wait-on :python (var data {:last "" :first "hello"}) (var validators {:last [["is-not-empty" {:check (fn [v rec] (return false)) :message "Must not be empty"}]] :first [["is-not-empty" {:check (fn [v rec] (return true)) :message "Must not be empty"}]]}) (var result (validate/create-result validators)) (validate/validate-all data validators result nil (fn [success result] (repl/notify result)))) => {"::" "validation.result" "status" "errored" "fields" {"first" {"status" "ok"} "last" {"message" "Must not be empty" "data" "" "status" "errored" "id" "is-not-empty"}}})

^{:refer xt.event.util-validate/create-result :added "4.1"} (fact "creates a pending validation result" (!.js (validate/create-result {:last [] :first []})) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "pending"} "last" {"status" "pending"}}} (!.lua (validate/create-result {:last [] :first []})) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "pending"} "last" {"status" "pending"}}} (!.py (validate/create-result {:last [] :first []})) => {"::" "validation.result" "status" "pending" "fields" {"first" {"status" "pending"} "last" {"status" "pending"}}})

(comment (s/snapto) (s/run (quote [xt.event.util-validate])) (s/seedgen-langremove (quote [xt.event.util-]) {:lang [:lua] :write true}) (s/seedgen-benchadd (quote [xt.event.util-validate]) {:lang [:ruby :dart] :write true}) (s/seedgen-langadd (quote [xt.event.util-validate]) {:lang [:lua :python] :write true}) (s/seedgen-langremove (quote [xt.event.util-validate]) {:lang [:lua :python] :write true}))
