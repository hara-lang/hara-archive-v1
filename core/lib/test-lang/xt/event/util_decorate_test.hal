(ns xt.event.util-decorate-test (:require [lang.core :as l] [xt.lang.common-notify :as notify]) (:use code.test))

^{:seedgen/root {:all true :langs [:js :lua :python]}} (l/script- :js {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-decorate :as decorate]] :runtime :basic})

(l/script- :lua {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-decorate :as decorate]] :runtime :basic})

(l/script- :python {:require [[xt.lang.spec-base :as xt] [xt.lang.spec-promise :as spec-promise] [xt.lang.common-repl :as repl] [xt.event.util-decorate :as decorate]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.event.util-decorate/incr-fn :added "4.1"} (fact "creates an incrementing id generator" (!.js (var next-id (decorate/incr-fn)) [(next-id) (next-id) (next-id)]) => ["id-0" "id-1" "id-2"] (!.lua (var next-id (decorate/incr-fn)) [(next-id) (next-id) (next-id)]) => ["id-0" "id-1" "id-2"] (!.py (var next-id (decorate/incr-fn)) [(next-id) (next-id) (next-id)]) => ["id-0" "id-1" "id-2"])

^{:refer xt.event.util-decorate/plugin-timing :added "4.1"} (fact "tracks start, end, and elapsed timing" (!.js (var plugin (decorate/plugin-timing {})) ((. plugin ["on_setup"]) []) ((. plugin ["on_teardown"])) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => (contains {"output" (contains {"start" integer? "end" integer? "elapsed" integer?}) "name" "timing"}) (!.lua (var plugin (decorate/plugin-timing {})) ((. plugin ["on_setup"]) []) ((. plugin ["on_teardown"])) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => (contains {"output" (contains {"start" integer? "end" integer? "elapsed" integer?}) "name" "timing"}) (!.py (var plugin (decorate/plugin-timing {})) ((. plugin ["on_setup"]) []) ((. plugin ["on_teardown"])) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => (contains {"output" (contains {"start" integer? "end" integer? "elapsed" integer?}) "name" "timing"}))

^{:refer xt.event.util-decorate/plugin-counts :added "4.1"} (fact "tracks success and error counts" (!.js (var plugin (decorate/plugin-counts {})) ((. plugin ["on_success"]) 1) ((. plugin ["on_error"]) "boom") ((. plugin ["on_success"]) 2) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => {"output" {"success" 2 "error" 1} "name" "counts"} (!.lua (var plugin (decorate/plugin-counts {})) ((. plugin ["on_success"]) 1) ((. plugin ["on_error"]) "boom") ((. plugin ["on_success"]) 2) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => {"output" {"success" 2 "error" 1} "name" "counts"} (!.py (var plugin (decorate/plugin-counts {})) ((. plugin ["on_success"]) 1) ((. plugin ["on_error"]) "boom") ((. plugin ["on_success"]) 2) {"output" (. plugin ["output"]) "name" (. plugin ["name"])}) => {"output" {"success" 2 "error" 1} "name" "counts"})

^{:refer xt.event.util-decorate/to-handle-callback :added "4.1"} (fact "adapts success error and finally callbacks" (!.js [(decorate/to-handle-callback {"error" "B" "success" "A" "finally" "C"}) (xt/x:obj-keys (decorate/to-handle-callback nil))]) => (just-in [{"on_success" "A" "on_teardown" "C" "on_error" "B"} (just ["on_success" "on_error" "on_teardown"] :in-any-order)]) (!.lua [(decorate/to-handle-callback {"error" "B" "success" "A" "finally" "C"}) (xt/x:obj-keys (decorate/to-handle-callback nil))]) => (just-in [{"on_success" "A" "on_teardown" "C" "on_error" "B"} []]) (!.py [(decorate/to-handle-callback {"error" "B" "success" "A" "finally" "C"}) (xt/x:obj-keys (decorate/to-handle-callback nil))]) => (just-in [{"on_success" "A" "on_teardown" "C" "on_error" "B"} (just ["on_success" "on_error" "on_teardown"] :in-any-order)]))

^{:refer xt.lang.spec-promise/x:promise-run :added "4.1"} (fact "wraps a raw value in the promise interface" (notify/wait-on :js (spec-promise/x:promise-then (spec-promise/x:promise-run 42) (repl/>notify))) => 42 (notify/wait-on :lua (spec-promise/x:promise-then (spec-promise/x:promise-run 42) (repl/>notify))) => 42 (notify/wait-on :python (spec-promise/x:promise-then (spec-promise/x:promise-run 42) (repl/>notify))) => 42)

^{:refer xt.event.util-decorate/new-handle :added "4.1"} (fact "creates a decorated handle with plugins" (!.js (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts] {:name "demo" :id-fn (fn [] (return "fixed")) :delay 25})) {"name" (. handle ["name"]) "id" ((. handle ["id_fn"])) "plugin_count" (xt/x:len (. handle ["plugins"])) "delay" (. handle ["delay"])}) => {"name" "demo" "id" "fixed" "plugin_count" 1 "delay" 25} (!.lua (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts] {:name "demo" :id-fn (fn [] (return "fixed")) :delay 25})) {"name" (. handle ["name"]) "id" ((. handle ["id_fn"])) "plugin_count" (xt/x:len (. handle ["plugins"])) "delay" (. handle ["delay"])}) => {"name" "demo" "id" "fixed" "plugin_count" 1 "delay" 25} (!.py (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts] {:name "demo" :id-fn (fn [] (return "fixed")) :delay 25})) {"name" (. handle ["name"]) "id" ((. handle ["id_fn"])) "plugin_count" (xt/x:len (. handle ["plugins"])) "delay" (. handle ["delay"])}) => {"name" "demo" "id" "fixed" "plugin_count" 1 "delay" 25})

^{:refer xt.event.util-decorate/run-handle :added "4.1"} (fact "runs a handle and resolves a receipt with plugin output" (notify/wait-on :js (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts decorate/plugin-timing] {:delay 10})) (spec-promise/x:promise-then (decorate/run-handle handle [] nil) (repl/>notify))) => (contains {"counts" {"success" 1 "error" 0} "timing" (contains {"start" integer? "end" integer? "elapsed" integer?}) "value" 1 "status" "success" "id" "id-0"}) (notify/wait-on :lua (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts decorate/plugin-timing] {:delay 10})) (spec-promise/x:promise-then (decorate/run-handle handle [] nil) (repl/>notify))) => (contains {"counts" {"success" 1 "error" 0} "timing" (contains {"start" integer? "end" integer? "elapsed" integer?}) "value" 1 "status" "success" "id" "id-0"}) (notify/wait-on :python (var handle (decorate/new-handle (fn [] (return 1)) [decorate/plugin-counts decorate/plugin-timing] {:delay 10})) (spec-promise/x:promise-then (decorate/run-handle handle [] nil) (repl/>notify))) => (contains {"counts" {"success" 1 "error" 0} "timing" (contains {"start" integer? "end" integer? "elapsed" integer?}) "value" 1 "status" "success" "id" "id-0"}))

(comment (s/snapto) (s/seedgen-benchadd (quote [xt.event.util-decorate]) {:lang [:ruby :dart] :write true}) (s/seedgen-langadd (quote [xt.event.util-decorate]) {:lang [:lua :python] :write true}) (s/seedgen-langremove (quote [xt.event.util-decorate]) {:lang [:lua :python] :write true}))
