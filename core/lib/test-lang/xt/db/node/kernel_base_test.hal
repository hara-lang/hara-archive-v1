(ns xt.db.node.kernel-base-test (:use code.test) (:require [lang.core :as l] [xt.lang.common-notify :as notify] [scaffold.supabase.local-min :as local-min] [xt.db.node.kernel-base :as kernel] [postgres.core :as pg] [postgres.core.supabase :as s]))

(do (l/script- :postgres {:config {:port (-> local-min/+config+ :db :port) :pass (-> local-min/+config+ :db :password) :user (-> local-min/+config+ :db :user) :startup local-min/start-supabase :host (-> local-min/+config+ :db :host) :dbname (-> local-min/+config+ :db :database) :shutdown local-min/stop-supabase} :emit {:code {:transforms {:entry [(var s/transform-entry)]}}} :require [[postgres.sample.scratch-v0 :as scratch-v0] [postgres.core :as pg] [postgres.core.supabase :as s]] :runtime :jdbc.client}) (defrun.pg __init__ (s/grant-usage #{"scratch_v0"})))

(l/script- :js {:require [[xt.lang.common-data :as xtd] [xt.lang.common-tree :as tree] [xt.lang.common-repl :as repl] [xt.lang.common-protocol :as proto] [xt.lang.spec-base :as xt] [xt.lang.spec-promise :as promise] [xt.db.node.kernel-base :as kernel] [xt.db.system.main :as impl-main] [xt.db.system.impl-common :as impl-common] [xt.db.system.impl-supabase-realtime :as realtime] [xt.db.helpers.data-main-test :as sample] [xt.substrate :as substrate] [xt.substrate.page-core :as page-core] [xt.net.http-fetch :as fetch] [js.net.http-fetch :as js-fetch]] :runtime :basic})

(def.js Schema ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))))

(def.js SchemaLookup ((deref !) (pg/bind-app (pg/app "scratch_v0"))))

(defn.js node-init-postgres [node] (:= node (or node (substrate/node-create {}))) (return (kernel/kernel-setup-main node {"primary" {"defaults" ((deref !) (local-min/+config+ :db)) "type" "postgres"} "caching" {"defaults" {"filename" ":memory:"} "type" "sqlite"}} -/Schema -/SchemaLookup)))

(defn.js node-init-supabase [node] (:= node (or node (substrate/node-create {}))) (return (kernel/kernel-setup-main node {"primary" {"defaults" ((deref !) local-min/+config-supabase-anon+) "type" "supabase"} "caching" {"defaults" {"filename" ":memory:"} "type" "sqlite"}} -/Schema -/SchemaLookup)))

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart :js) (l/rt:teardown :postgres) (l/rt:setup :postgres)]})

^{:refer xt.db.node.kernel-base/get-primary-impl :added "4.1"} (fact "gets the primary impl from a service id" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (repl/notify (kernel/get-primary-impl node "db/primary")))))) => (contains-in {"schema" map? "metadata" {"common_id" "db/common" "caching_id" "db/caching"} "lookup" map? "opts" map? "::" "xt.db.system.impl_postgres/ImplPostgres"}))

^{:refer xt.db.node.kernel-base/get-caching-impl :added "4.1"} (fact "gets the caching impl from a primary service id" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (repl/notify (kernel/get-caching-impl node "db/primary")))))) => (contains-in {"schema" map? "metadata" {"common_id" "db/common" "primary_id" "db/primary"} "lookup" map? "opts" map? "::" "xt.db.system.impl_sqlite/ImplSqlite"}))

^{:refer xt.db.node.kernel-base/kernel-create-config :added "4.1"} (fact "creates a normalized config with default service ids" (!.js (kernel/kernel-create-config {"primary" {"type" "postgres"} "common" {"custom" true} "caching" {"type" "sqlite"}})) => {"primary" {"type" "postgres" "id" "db/primary"} "common" {"custom" true "id" "db/common"} "caching" {"type" "sqlite" "id" "db/caching"}} (!.js (kernel/kernel-create-config {"primary" {"type" "memory"} "caching" {"type" "memory"}})) => {"primary" {"type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"type" "memory" "id" "db/caching"}})

^{:refer xt.db.node.kernel-base/kernel-check-exists :added "4.1"} (fact "checks whether common, primary and caching services are all present" (!.js (var node (substrate/node-create {})) (kernel/kernel-check-exists node {"primary" {"type" "memory"} "caching" {"type" "memory"}})) => false (!.js (var node (substrate/node-create {})) (substrate/set-service node "db/common" {}) (substrate/set-service node "db/primary" {}) (substrate/set-service node "db/caching" {}) (kernel/kernel-check-exists node {"primary" {"type" "memory"} "caching" {"type" "memory"}})) => true)

^{:refer xt.db.node.kernel-base/kernel-setup-single :added "4.1"} (fact "installs a single live impl on the node" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-single node "db/primary" "memory" {} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [out] (repl/notify (substrate/get-service node "db/primary")))))) => (contains-in {"::" "xt.db.system.impl_memory/ImplMemory" "schema" map? "lookup" map?}))

^{:refer xt.db.node.kernel-base/kernel-teardown-single :added "4.1"} (fact "tears down a single base service" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-single node "db/primary" "memory" {} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (kernel/kernel-teardown-single node "db/primary") (repl/notify {"node_returned" (xt/x:not-nil? node) "service_removed" (xt/x:nil? (substrate/get-service node "db/primary"))}))))) => {"node_returned" true "service_removed" true})

^{:refer xt.db.node.kernel-base/kernel-setup-main :added "4.1"} (fact "sets up common, primary and caching services with metadata" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "setup"})

^{:refer xt.db.node.kernel-base/kernel-setup-handler :added "4.1"} (fact "explicitly sets up base services from handler args" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-handler nil [{"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup] nil node) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "setup"})

^{:refer xt.db.node.kernel-base/kernel-teardown-main :added "4.1"} (fact "tears down common, primary and caching services" (notify/wait-on :js (var node (substrate/node-create {})) (var config {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}}) (-> (kernel/kernel-setup-main node config -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (return (kernel/kernel-teardown-main node config)))) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "teardown"})

^{:refer xt.db.node.kernel-base/kernel-teardown-handler :added "4.1"} (fact "tears down base services from a handler arg" (notify/wait-on :js (var node (substrate/node-create {})) (var config {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}}) (-> (kernel/kernel-setup-main node config -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (return (kernel/kernel-teardown-handler nil ["db/primary"] nil node)))) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "teardown"})

^{:refer xt.db.node.kernel-base/kernel-init-main :added "4.1"} (fact "ensures base services are present" (notify/wait-on :js (var node (substrate/node-create {})) (var config {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}}) (-> (kernel/kernel-init-main node config -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (return (kernel/kernel-init-main node config -/Schema -/SchemaLookup)))) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "no_change"})

^{:refer xt.db.node.kernel-base/kernel-init-handler :added "4.1"} (fact "initialises base services from handler args if needed" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-init-handler nil [{"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup] nil node) (repl/notify))) => {"data" {"primary" {"defaults" {} "type" "memory" "id" "db/primary"} "common" {"id" "db/common"} "caching" {"defaults" {} "type" "memory" "id" "db/caching"}} "status" "setup"})

^{:refer xt.db.node.kernel-base/subscribe-db-handler :setup [(l/rt:restart :js)] :added "4.1"} (fact "subscribes to the db handler" (notify/wait-on :js (var impl (impl-main/create-impl "supabase" ((deref !) local-min/+config-supabase-anon+) -/Schema -/SchemaLookup)) (repl/notify (realtime/subscribe impl "default" ["realtime:room:sub-test-1" "realtime:room:sub-test-2"]))) => [true true] (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-supabase node) (promise/x:promise-then (fn [] (return (kernel/subscribe-db-handler nil ["db/primary" "default" ["realtime:room:sub-test-1" "realtime:room:sub-test-2"]] nil node)))) (repl/notify))) => [true true])

^{:refer xt.db.node.kernel-base/unsubscribe-db-handler :setup [(l/rt:restart :js)] :added "4.1"} (fact "unsubscribes from the db handler" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-supabase node) (promise/x:promise-then (fn [] (return (kernel/subscribe-db-handler nil ["db/primary" "default" ["realtime:room:sub-test-1" "realtime:room:sub-test-2"]] nil node)))) (promise/x:promise-then (fn [] (return (kernel/unsubscribe-db-handler nil ["db/primary" "default" ["realtime:room:sub-test-1" "realtime:room:sub-test-2"]] nil node)))) (repl/notify))) => true)

^{:refer xt.db.node.kernel-base/sync-cached-handler :setup [(l/rt:restart :js) (def +logs+ [{"message" "hello" "id" "257553c1-c4f4-44ad-b1b5-092bf825a690"} {"message" "world" "id" "257553c1-c4f4-44ad-b1b5-092bf825a691"}])] :added "4.1"} (fact "sync-cached-handler applies db/sync payload to the paired caching db" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-supabase node) (promise/x:promise-then (fn [] (return (kernel/sync-cached-handler nil ["db/primary" {"db/sync" {"Log" ((deref !) +logs+)}}] nil node)))) (repl/notify))) => true (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-supabase node) (promise/x:promise-then (fn [out] (return (kernel/sync-cached-handler nil ["db/primary" {"db/sync" {"Log" ((deref !) +logs+)}}] nil node)))) (promise/x:promise-then (fn [out] (return (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])))) (repl/notify))) => (contains-in [{"message" "hello" "id" "257553c1-c4f4-44ad-b1b5-092bf825a690"} {"message" "world" "id" "257553c1-c4f4-44ad-b1b5-092bf825a691"}]))

^{:refer xt.db.node.kernel-base/attach-base-model :setup [(l/rt:restart :js)] :added "4.1"} (fact "attach-base-model registers a db listener when options.refresh is set" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (kernel/attach-base-model node "db/caching" "space/a" "group:a" "echo" {"handler" (fn [ctx] (return ctx.args)) "defaults" {"args" [1]}}) (return (-> (page-core/model-refresh node "space/a" "group:a" "echo" {} nil))))) (promise/x:promise-then (fn [] (return (page-core/model-get-output node "space/a" "group:a" "echo")))) (repl/notify))) => [1] (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (kernel/attach-base-model node "db/caching" "space/a" "group:a" "echo" {"handler" (fn [ctx] (return (. ctx ["args"]))) "defaults" {"args" [1]}}) (return (page-core/model-set-input node "space/a" "group:a" "echo" {:data [1 2 3]} {})))) (repl/notify))) => {"pre" [false] "path" ["group:a" "echo"] "main" [true [1 2 3]] "post" [false] "::" "model.run"})

^{:refer xt.db.node.kernel-base/attach-model-handler :added "4.1"} (fact "attach-model-handler attaches a page model to the node" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (kernel/attach-model-handler nil ["db/caching" {"model_id" "echo" "space_id" "room/a" "group_id" "demo"} {"handler" (fn [ctx] (return (. ctx ["args"]))) "defaults" {"args" [1 2 3]}}] nil node) (return (page-core/model-refresh node "room/a" "demo" "echo" {} nil)))) (repl/notify))) => {"pre" [false] "path" ["demo" "echo"] "main" [true [1 2 3]] "post" [false] "::" "model.run"})

^{:refer xt.db.node.kernel-base/detach-base-model :added "4.1"} (fact "detach-base-model removes the model and its db listener" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (kernel/attach-base-model node "db/primary" "room/a" "demo" "refresh-view" {"handler" (fn [ctx] (return [])) "defaults" {"args" []} "options" {"refresh" {"Log" true}}}) (repl/notify (kernel/detach-base-model node "db/primary" "room/a" "demo" "refresh-view")))))) => {"space" "room/a" "model" "refresh-view" "status" "removed" "group" "demo"})

^{:refer xt.db.node.kernel-base/detach-model-handler :added "4.1"} (fact "detach-model-handler detaches a page model from the node" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (kernel/attach-base-model node "db/primary" "room/a" "demo" "echo" {"handler" (fn [ctx] (return [1])) "defaults" {"args" []}}) (return (kernel/detach-model-handler nil ["db/primary" {"model_id" "echo" "space_id" "room/a" "group_id" "demo"}] nil node)))) (repl/notify))) => {"space" "room/a" "model" "echo" "status" "removed" "group" "demo"})

^{:refer xt.db.node.kernel-base/rpc-call-baseline-fn :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "rpc-call-baseline-fn routes rpc args and syncs result to caching" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "table" {"base" "Log" "type" "db/sync"} "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [out] (return [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))) (repl/notify))) => (contains-in [{"message" "hello" "author_id" nil "id" string?} [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/rpc-call-handler :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "rpc-call-handler routes rpc args through a named service" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (return (kernel/rpc-call-handler nil ["db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "table" {"base" "Log" "type" "db/sync"} "return" "jsonb" "id" "log_append_public"} ["hello"]] nil node)))) (promise/x:promise-then (fn [out] (return (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])))) (repl/notify))) => (contains-in [{"message" "hello"}]) (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (return (kernel/rpc-call-handler nil ["db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["world"]] nil node)))) (promise/x:promise-then (fn [out] (return [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))) (repl/notify))) => (contains-in [{"message" "world" "author_id" nil "id" string?} []]))

^{:refer xt.db.node.kernel-base/rpc-create-model :added "4.1"} (fact "rpc-create-model builds a page model spec with an rpc handler" (!.js (var spec (kernel/rpc-create-model "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} {"pipeline" {} "defaults" {"args" ["hello"]} "options" {}})) {"has-main" (xt/x:is-function? (xtd/get-in spec ["handler"])) "defaults" (. spec ["defaults"])}) => {"has-main" true "defaults" {"args" ["hello"]}})

^{:refer xt.db.node.kernel-base/rpc-attach-model :setup [(l/rt:restart :js) (pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "rpc-attach-model attaches and invokes an rpc model" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (kernel/rpc-attach-model nil ["db/primary" {"model_id" "rpc-view" "space_id" "room/a" "service" "db/primary" "group_id" "demo"} {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "table" {"base" "Log" "type" "db/sync"} "return" "jsonb" "id" "log_append_public"} {"pipeline" {} "defaults" {"args" ["hello"]} "options" {}}] nil node) (return (page-core/model-refresh node "room/a" "demo" "rpc-view" {} nil)))) (promise/x:promise-then (fn [out] (repl/notify [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))))) => (contains-in [{"pre" [false] "path" ["demo" "rpc-view"] "main" [true {"message" "hello" "author_id" nil "id" string?}] "post" [false] "::" "model.run"} [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/pull-call-baseline-fn :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "pull-call-baseline-fn pulls data and syncs result to caching" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [out] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (return (kernel/pull-call-baseline-fn node "db/primary" ["Log"])))) (promise/x:promise-then (fn [out] (return [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))) (repl/notify))) => (contains-in [[{"message" "hello" "author_id" nil "id" string?}] [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/pull-call-handler :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "pull-call-handler routes pull args through a named service" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [out] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (return (kernel/pull-call-handler nil ["db/primary" ["Log"]] nil node)))) (promise/x:promise-then (fn [out] (return [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))) (repl/notify))) => (contains-in [[{"message" "hello" "author_id" nil "id" string?}] [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/pull-create-model :added "4.1"} (fact "pull-create-model builds a page model spec with local and remote handlers" (!.js (var spec (kernel/pull-create-model {"primary_id" "db/primary" "caching_id" "db/caching"} ["Log"] {"pipeline" {} "defaults" {} "options" {}})) {"has-main" (xt/x:is-function? (xtd/get-in spec ["handler"])) "defaults" (. spec ["defaults"]) "has-remote" (xt/x:is-function? (xtd/get-in spec ["pipeline" "remote" "handler"]))}) => {"has-main" true "defaults" {} "has-remote" true})

^{:refer xt.db.node.kernel-base/pull-attach-model :setup [(l/rt:restart :js) (pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "pull-attach-model attaches and invokes a pull-view model" (notify/wait-on :js (var node (substrate/node-create {})) (:= (!:G NODE) node) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (kernel/pull-attach-model nil ["db/primary" {"model_id" "active-view" "space_id" "room/a" "group_id" "demo"} ["Log"] {"pipeline" {} "defaults" {"args" []} "options" {"refresh" {"Log" true}}}] nil node) (kernel/pull-attach-model nil ["db/primary" {"model_id" "passive-view" "space_id" "room/a" "group_id" "demo"} ["Log"] {"pipeline" {} "defaults" {"args" []} "options" {"refresh" {"Log" true}}}] nil node) (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (return (page-core/model-refresh-remote node "room/a" "demo" "active-view" nil)))) (repl/notify))) => (contains-in {"pre" [false] "path" ["demo" "active-view"] "remote" [true [{"message" "hello" "author_id" nil "id" string?}]] "post" [false] "::" "model.run"}) (!.js (page-core/model-get-output NODE "room/a" "demo" "passive-view")) => (contains-in [{"message" "hello" "author_id" nil "id" string?}]))

^{:refer xt.db.node.kernel-base/dataview-call-baseline-fn :setup [(pg/t:delete scratch-v0/Log) (l/rt:restart :js)] :added "4.1"} (fact "dataview-call-baseline-fn executes a dataview query and syncs to caching" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [out] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (return (kernel/dataview-call-baseline-fn node "db/primary" {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}})))) (promise/x:promise-then (fn [out] (repl/notify [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))))) => (contains-in [[{"message" "hello" "author_id" nil "id" string?}] [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/dataview-call-handler :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "dataview-call-handler routes dataview args through a named service" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [out] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (return (kernel/dataview-call-handler nil ["db/primary" {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}}] nil node)))) (promise/x:promise-then (fn [out] (repl/notify [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))) (promise/x:promise-catch (fn [err] (repl/notify (. err message)))))) => (contains-in [[{"message" "hello" "author_id" nil "id" string?}] [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/dataview-create-model :added "4.1"} (fact "dataview-create-model builds a page model spec with local and remote handlers" (!.js (var spec (kernel/dataview-create-model "db/primary" {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}} {"pipeline" {} "defaults" {"args" [{"select_args" [] "return_args" []}]} "options" {}})) {"has-main" (xt/x:is-function? (xtd/get-in spec ["handler"])) "defaults" (. spec ["defaults"]) "has-remote" (xt/x:is-function? (xtd/get-in spec ["pipeline" "remote" "handler"]))}) => {"has-main" true "defaults" {"args" [{"select_args" [] "return_args" []}]} "has-remote" true})

^{:refer xt.db.node.kernel-base/dataview-attach-model :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "dataview-attach-model attaches and invokes a dataview model" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [_] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [_] (kernel/dataview-attach-model nil ["db/primary" {"model_id" "dataview-view" "space_id" "room/a" "group_id" "demo"} {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}} {"pipeline" {} "defaults" {"args" [{"select_args" [] "return_args" []}]} "options" {}}] nil node) (return (page-core/model-refresh-remote node "room/a" "demo" "dataview-view" nil)))) (promise/x:promise-then (fn [out] (repl/notify [out (impl-common/pull (kernel/get-caching-impl node "db/primary") ["Log"])]))))) => (contains-in [{"pre" [false] "path" ["demo" "dataview-view"] "remote" [true [{"message" "hello" "author_id" nil "id" string?}]] "post" [false] "::" "model.run"} [{"message" "hello" "author_id" nil "id" string?}]]))

^{:refer xt.db.node.kernel-base/init-handlers :added "4.1"} (fact "init-handlers registers the @xt.db handlers" (!.js (var node (substrate/node-create {})) (kernel/init-handlers node) (xt/x:obj-keys (. node ["handlers"]))) => (contains ["@xt.db/kernel-init" "@xt.db/kernel-setup" "@xt.db/kernel-teardown" "@xt.db/subscribe-db" "@xt.db/unsubscribe-db" "@xt.db/sync-cached" "@xt.db/attach-model" "@xt.db/detach-model" "@xt.db/rpc-call" "@xt.db/rpc-attach-model" "@xt.db/pull-call" "@xt.db/pull-cached" "@xt.db/pull-attach-model" "@xt.db/dataview-call" "@xt.db/dataview-cached" "@xt.db/dataview-attach-model"] :in-any-order))

^{:refer xt.db.node.kernel-base/list-substrate-fn :added "4.1"} (fact "list-substrate-fn lists public vars tagged with :substrate/fn" (sort (map (comp :substrate/fn meta second) (kernel/list-substrate-fn (quote xt.db.node.kernel-base)))) => (quote ("@xt.db/attach-model" "@xt.db/dataview-attach-model" "@xt.db/dataview-call" "@xt.db/detach-model" "@xt.db/kernel-init" "@xt.db/kernel-setup" "@xt.db/kernel-teardown" "@xt.db/pull-attach-model" "@xt.db/pull-cached" "@xt.db/pull-cached" "@xt.db/pull-call" "@xt.db/rpc-attach-model" "@xt.db/rpc-call" "@xt.db/subscribe-db" "@xt.db/sync-cached" "@xt.db/unsubscribe-db")))

^{:refer xt.db.node.kernel-base/pull-cached-handler :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "pull-cached-handler returns data already synced to the caching impl" (notify/wait-on :js (var node (substrate/node-create {})) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [] (return (kernel/pull-call-baseline-fn node "db/primary" ["Log"])))) (promise/x:promise-then (fn [] (return (kernel/pull-cached-handler nil ["db/primary" ["Log"]] nil node)))) (repl/notify))) => (contains-in [{"message" "hello" "author_id" nil "id" string?}]))

^{:refer xt.db.node.kernel-base/dataview-prep-tree :added "4.1"} (fact "prepares a query tree from a dataview spec" (notify/wait-on :js (var node (substrate/node-create {})) (-> (kernel/kernel-setup-main node {"primary" {"defaults" {} "type" "memory"} "caching" {"defaults" {} "type" "memory"}} -/Schema -/SchemaLookup) (promise/x:promise-then (fn [] (return (kernel/dataview-prep-tree (kernel/get-primary-impl node "db/primary") {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}})))) (repl/notify))) => (fn [out] (and (vector? out) (= "Log" (first out)) (map? (second out)))))

^{:refer xt.db.node.kernel-base/dataview-cached-handler :setup [(pg/t:delete scratch-v0/Log)] :added "4.1"} (fact "dataview-cached-handler returns a dataview result from the caching impl" (notify/wait-on :js (var node (substrate/node-create {})) (var dataview {"return_entry" {"view" {"query" ["id" "message"] "table" "Log" "type" "return"} "input" []} "table" "Log" "select_entry" {"view" {"query" {} "table" "Log" "type" "select"} "input" []}}) (-> (-/node-init-postgres node) (promise/x:promise-then (fn [] (return (kernel/rpc-call-baseline-fn node "db/primary" {"schema" "scratch_v0" "flags" {} "input" [{"symbol" "i_message" "type" "text"}] "return" "jsonb" "id" "log_append_public"} ["hello"])))) (promise/x:promise-then (fn [] (return (kernel/dataview-call-baseline-fn node "db/primary" dataview)))) (promise/x:promise-then (fn [] (return (kernel/dataview-cached-handler nil ["db/primary" dataview] nil node)))) (repl/notify))) => (contains-in [{"message" "hello" "author_id" nil "id" string?}]))
