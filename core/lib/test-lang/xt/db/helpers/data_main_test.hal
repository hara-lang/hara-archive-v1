(def +app+ (pg/app "test-db-helpers"))

(def +tree+ (pg/bind-schema (:schema +app+)))

(def.xt Schema ((deref !) +tree+))

(def.xt SchemaCurrency ((deref !) {"Currency" (get-in +tree+ ["Currency"])}))

(def.xt SchemaLookup ((deref !) (pg/bind-app +app+)))
