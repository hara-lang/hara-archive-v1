(ns xt.db.system.impl-sqlite-test (:use code.test) (:require [lang.core :as l] [xt.lang.common-notify :as notify]))

^{:seedgen/root {:dart {:extra [[dart.net.conn-sqlite :as dart-sqlite]]} :ruby {:extra [[ruby.net.conn-sqlite :as ruby-sqlite]]} :js {:extra [[js.net.conn-sqlite :as js-sqlite]]} :all true :python {:extra [[python.net.conn-sqlite :as py-sqlite]]} :lua.nginx {:extra [[lua.nginx.conn-sqlite :as lua-sqlite]]}}} (l/script- :js {:require [[xt.lang.spec-base :as xt] [xt.lang.common-data :as xtd] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.db.system.impl-sqlite :as impl] [xt.db.text.sql-util :as ut] [xt.db.text.sql-table :as sql-table] [xt.db.text.base-flatten :as f] [xt.db.helpers.data-main-test :as sample] [xt.net.conn-sql :as conn-sql] [js.net.conn-sqlite :as js-sqlite]] :runtime :basic})

(l/script- :lua.nginx {:config {:program :resty} :require [[xt.lang.spec-base :as xt] [xt.lang.common-data :as xtd] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.db.system.impl-sqlite :as impl] [xt.db.text.sql-util :as ut] [xt.db.text.sql-table :as sql-table] [xt.db.text.base-flatten :as f] [xt.db.helpers.data-main-test :as sample] [xt.net.conn-sql :as conn-sql] [lua.nginx.conn-sqlite :as lua-sqlite]] :runtime :nginx.instance})

^{:seedgen/base {:lua {:transform (quote {js-sqlite/create lua-sqlite/create})} :dart {:transform (quote {js-sqlite/create dart-sqlite/create})} :ruby {:transform (quote {js-sqlite/create ruby-sqlite/create})} :python {:transform (quote {js-sqlite/create py-sqlite/create})}}} (defn.js sqlite-create [] (return (js-sqlite/create {"filename" ":memory:"})))

(defn.js connect-impl [] (return (-> (impl/impl-sqlite (-/sqlite-create) sample/Schema sample/SchemaLookup) (impl/impl-sqlite-init))))

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:added "4.1" :refer xt.db.system.impl-sqlite/pull} (fact "pull reads tree and shorthand query forms from sqlite impl context" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (impl/record-add impl "Currency" [{"name" "USD" "id" "USD"} {"name" "AUD" "id" "AUD"}]) (repl/notify (impl/pull impl ["Currency"])))))) => (contains [(contains {"name" "USD" "id" "USD"}) (contains {"name" "AUD" "id" "AUD"})] :in-any-order))

^{:added "4.1" :refer xt.db.system.impl-sqlite/pull-async} (fact "pull-async reads through async sqlite semantics" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (impl/record-add impl "Currency" [{"name" "USD" "id" "USD"} {"name" "AUD" "id" "AUD"}]) (return (impl/pull-async impl ["Currency"])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => (contains [(contains {"name" "USD" "id" "USD"}) (contains {"name" "AUD" "id" "AUD"})] :in-any-order))

^{:added "4.1" :refer xt.db.system.impl-sqlite/record-add} (fact "record-add uses stored sqlite context" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (repl/notify (impl/record-add impl "Currency" [{"name" "USD" "id" "USD"} {"name" "AUD" "id" "AUD"}])))))) => [])

^{:added "4.1" :refer xt.db.system.impl-sqlite/record-delete} (fact "record-delete uses stored sqlite context")

^{:added "4.1" :refer xt.db.system.impl-sqlite/clear-db} (fact "clear-db removes all data and keeps schema intact" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (impl/record-add impl "Currency" [{"name" "USD" "id" "USD"} {"name" "AUD" "id" "AUD"}]) (impl/clear-db impl) (repl/notify (impl/pull impl ["Currency"])))))) => empty?)

^{:added "4.1" :refer xt.db.system.impl-sqlite/process-add-event} (fact "process-add-event executes sql upserts through stored sqlite context" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (return (impl/process-add-event impl {"UserAccount" [sample/RootUser]})))) (promise/x:promise-then (fn [out] (repl/notify out))))) => ["UserAccount" "UserProfile"])

^{:added "4.1" :refer xt.db.system.impl-sqlite/process-remove-event} (fact "process-remove-event executes sql deletes through stored sqlite context" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (return (impl/process-remove-event impl {"UserAccount" [sample/RootUser]})))) (promise/x:promise-then (fn [out] (repl/notify out))))) => ["UserAccount" "UserProfile"])

^{:added "4.1" :refer xt.db.system.impl-sqlite/impl-sqlite} (fact "creates the sqlite impl config before connection init" (!.js (impl/impl-sqlite (-/sqlite-create) sample/Schema sample/SchemaLookup)) => map?)

^{:added "4.1" :refer xt.db.system.impl-sqlite/impl-sqlite-init} (fact "impl-sqlite-init wires up js.net.conn-sqlite and stores the connection" (notify/wait-on [:js 5000] (-> (impl/impl-sqlite (-/sqlite-create) sample/Schema sample/SchemaLookup) (impl/impl-sqlite-init) (promise/x:promise-then (fn [impl] (var #{client} impl) (repl/notify (conn-sql/query client "SELECT 1;")))))) => 1)

^{:added "4.1" :refer xt.db.system.impl-sqlite/rpc-call-async} (fact "sqlite impl does not support remote rpc calls" (notify/wait-on :js (-> (-/connect-impl) (promise/x:promise-then (fn [impl] (return (impl/rpc-call-async impl {"id" "demo"} [])))) (promise/x:promise-catch (fn [err] (repl/notify {"has_error" (xt/x:not-nil? err)}))))) => (contains-in {"has_error" true}))
