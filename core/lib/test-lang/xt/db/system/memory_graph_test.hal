(ns xt.db.system.memory-graph-test (:use code.test) (:require [lang.core :as l] [postgres.gen.bind-macro :as gen] [xt.db.helpers.seed-system-test :as data]))

^{:seedgen/root {:all true}} (l/script- :js {:require [[xt.lang.common-data :as xtd] [xt.db.text.base-flatten :as f] [xt.db.text.sql-util :as ut] [xt.db.system.memory-graph :as g] [xt.db.system.memory-util :as util] [xt.db.helpers.data-main-test :as sample]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:added "4.1" :refer xt.db.system.memory-graph/check-ilike-clause} (fact "matches case-insensitive like clauses" (!.js [(g/check-ilike-clause "US Dollar" "%dollar") (g/check-ilike-clause "US Dollar" "%EURO%") (g/check-ilike-clause 1 "%1%")]) => [true false false])

^{:added "4.1" :refer xt.db.system.memory-graph/custom-params} (fact "extracts standard custom controls" (!.js (g/custom-params [{"::" "sql/count"} (ut/ORDER-BY ["id"]) (ut/ORDER-SORT "DESC") (ut/LIMIT 3) (ut/OFFSET 1)])) => {"order_by" ["id"] "offset" 1 "limit" 3 "count" true "order_sort" "desc"})

^{:added "4.1" :refer xt.db.system.memory-graph/check-clause-value} (fact "checks scalar and ref-id clauses against a record" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var account (xtd/get-in rows ["UserAccount" "00000000-0000-0000-0000-000000000000" "record"])) (var profile (xtd/get-in rows ["UserProfile" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "record"])) [(g/check-clause-value account "nickname" "root") (g/check-clause-value profile "account_id" "00000000-0000-0000-0000-000000000000") (g/check-clause-value account "nickname" "other")]) => [true true false])

^{:added "4.1" :refer xt.db.system.memory-graph/check-clause-function} (fact "checks value, forward-link and reverse-link predicates" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var account (xtd/get-in rows ["UserAccount" "00000000-0000-0000-0000-000000000000" "record"])) (var profile (xtd/get-in rows ["UserProfile" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "record"])) [(g/check-clause-function account nil "nickname" (. g/PULL_CHECK ["eq"]) ["root"]) (g/check-clause-function profile "forward" "account" (. g/PULL_CHECK ["eq"]) ["00000000-0000-0000-0000-000000000000"]) (g/check-clause-function account "reverse" "profile" (. g/PULL_CHECK ["eq"]) ["c4643895-b0ce-44cc-b07b-2386bf18d43b"]) (g/check-clause-function account nil "nickname" nil ["root"])]) => [true true true false])

^{:added "4.1" :refer xt.db.system.memory-graph/where-clause} (fact "evaluates scalar, predicate and nested ref clauses" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var record (xtd/get-in rows ["UserAccount" "00000000-0000-0000-0000-000000000000" "record"])) [(g/where-clause rows sample/Schema "UserAccount" record g/where "nickname" "root") (g/where-clause rows sample/Schema "UserAccount" record g/where "nickname" (fn:> [x] (== x "root"))) (g/where-clause rows sample/Schema "UserAccount" record g/where "profile" {"first_name" "Root"})]) => [true true true])

^{:added "4.1" :refer xt.db.system.memory-graph/where} (fact "evaluates function, empty, or-list and map predicates" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var record (xtd/get-in rows ["UserAccount" "00000000-0000-0000-0000-000000000000" "record"])) [(g/where rows sample/Schema "UserAccount" (fn:> [input _table] (== (xtd/get-in input ["data" "nickname"]) "root")) record) (g/where rows sample/Schema "UserAccount" {} record) (g/where rows sample/Schema "UserAccount" [{"nickname" "other"} {"nickname" "root"}] record) (g/where rows sample/Schema "UserAccount" {"nickname" "other"} record)]) => [true true true false])

^{:added "4.1" :refer xt.db.system.memory-graph/data-field} (fact "projects scalar and ref-id data fields" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var profile (xtd/get-in rows ["UserProfile" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "record"])) [(g/data-field profile "first_name") (g/data-field profile "account_id")]) => ["Root" "00000000-0000-0000-0000-000000000000"])

^{:added "4.1" :refer xt.db.system.memory-graph/project-record} (fact "projects one record using selected data and links" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUser]})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (var tree ["UserAccount" {"where" [] "data" ["nickname"] "custom" [] "links" [["profile" "reverse" ["UserProfile" {"where" [] "data" ["first_name"] "custom" [] "links" []}]]]}]) (g/project-record rows sample/Schema tree (xtd/get-in rows ["UserAccount" "00000000-0000-0000-0000-000000000000" "record"]) {} g/pull-entries)) => {"profile" [{"first_name" "Root"}] "nickname" "root"})

^{:added "4.1" :refer xt.db.system.memory-graph/apply-custom} (fact "applies ordering, reversing, offset and limit controls" (!.js (g/apply-custom [{"id" "b"} {"id" "a"} {"id" "c"}] {"order_by" ["id"] "offset" 1 "limit" 1 "count" false "order_sort" "desc"})) => [{"id" "b"}])

^{:added "4.1" :refer xt.db.system.memory-graph/pull-entries} (fact "filters, projects and customises an explicit entry list" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/pull-entries rows sample/Schema ["Currency" {"where" {"id" ["ilike" "xlm%"]} "data" ["id"] "custom" [(ut/ORDER-BY ["id"])] "links" []}] (xtd/obj-vals (xtd/get-in rows ["Currency"])) {})) => [{"id" "XLM"} {"id" "XLM.T"}])

^{:added "4.1" :refer xt.db.system.memory-graph/pull} (fact "pulles tree ir data, query forms, and respects custom controls" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/pull rows sample/Schema ["Currency" {"where" [] "data" ["id"] "custom" [(ut/ORDER-BY ["id"]) (ut/LIMIT 2) (ut/OFFSET 2)] "links" []}] {})) => [{"id" "XLM"} {"id" "XLM.T"}] (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/pull rows sample/Schema ["Currency" {"id" "USD"} ["id" "name"]] {})) => [{"name" "US Dollar" "id" "USD"}])

^{:added "4.1" :refer xt.db.system.memory-graph/view-select} (fact "plans and pulles a select query" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/view-select rows sample/Schema ((deref !) (gen/bind-view data/currency-all-crypto)) [] {})) => (contains [{"id" "XLM"} {"id" "XLM.T"}] :in-any-order))

^{:added "4.1" :refer xt.db.system.memory-graph/view-count} (fact "plans and pulles a count query" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/view-count rows sample/Schema ((deref !) (gen/bind-view data/currency-all-crypto)) [] {})) => 2)

^{:added "4.1" :refer xt.db.system.memory-graph/view-return} (fact "plans and pulles a return query" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/view-return rows sample/Schema ((deref !) (gen/bind-view data/currency-info)) "STATS" [] {})) => [{"id" "STATS" "description" "Default Currency for Statstrade"}])

^{:added "4.1" :refer xt.db.system.memory-graph/view-return-bulk} (fact "plans and pulles a bulk return query" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/view-return-bulk rows sample/Schema ((deref !) (gen/bind-view data/currency-info)) ["STATS" "USD"] [] {})) => (contains [{"id" "STATS" "description" "Default Currency for Statstrade"} {"id" "USD" "description" "Default Current for the United States of America"}] :in-any-order))

^{:added "4.1" :refer xt.db.system.memory-graph/view-combined} (fact "plans and pulles a combined query" (!.js (var rows {}) (var flat (f/flatten-bulk sample/Schema {"Currency" ((deref !) sample/+currency+)})) (util/merge-bulk rows flat nil) (util/add-bulk-links rows sample/Schema flat) (g/view-combined rows sample/Schema ((deref !) (gen/bind-view data/currency-all-crypto)) [] ((deref !) (gen/bind-view data/currency-info)) [] nil {})) => (contains [{"id" "XLM" "description" "Default Currency for the Stellar Blockchain"} {"id" "XLM.T" "description" "Default Currency for the Stellar TestNet Blockchain"}] :in-any-order))

^{:added "4.1" :refer xt.db.system.memory-graph/check-in-clause} (fact "emulates the sql in clause" (!.js [(g/check-in-clause "USD" [["USD" "AUD"]]) (g/check-in-clause "EUR" [["USD" "AUD"]]) (g/check-in-clause "USD" [[]]) (g/check-in-clause 1 [[1 2 3]])]) => [true false false true])

^{:added "4.1" :refer xt.db.system.memory-graph/like-char-at} (fact "gets a single character from a string" (!.js [(g/like-char-at "hello" 0) (g/like-char-at "hello" 4) (g/like-char-at "hello" 10)]) => ["h" "o" ""])

^{:added "4.1" :refer xt.db.system.memory-graph/check-like-clause} (fact "emulates the sql like clause" (!.js [(g/check-like-clause "hello" "h_llo") (g/check-like-clause "hello" "%ello%") (g/check-like-clause "hello" "world") (g/check-like-clause "hello" "%") (g/check-like-clause "hello" "_____") (g/check-like-clause "hello" "______") (g/check-like-clause "hello" "h\\%") (g/check-like-clause "h%" "h\\%") (g/check-like-clause "HELLO" "%hello%") (g/check-like-clause 1 "%1%")]) => [true true false true true false false true false false])
