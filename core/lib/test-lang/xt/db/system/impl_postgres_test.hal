(ns xt.db.system.impl-postgres-test (:require [lang.core :as l] [xt.lang.common-notify :as notify]) (:use code.test))

(l/script- :postgres {:config {:dbname "test-scratch"} :require [[postgres.sample.scratch-v0 :as scratch] [postgres.core :as pg]] :runtime :jdbc.client})

(l/script- :js {:require [[xt.lang.spec-base :as xt] [xt.lang.common-data :as xtd] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.net.conn-sql :as conn-sql] [xt.db.system.impl-postgres :as impl] [xt.db.text.sql-util :as ut] [xt.db.helpers.data-main-test :as sample] [js.net.conn-postgres :as js-postgres]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart) (l/rt:teardown :postgres) (l/rt:setup :postgres)]})

^{:setup [(scratch/log-append-public "hello") (l/rt:restart :js)] :added "4.1" :refer xt.db.system.impl-postgres/pull-async} (fact "pull-async reads through async postgres semantics" (notify/wait-on :js (-> (impl/impl-postgres (js-postgres/create {:database "test-scratch"}) ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))) ((deref !) (pg/bind-app (pg/app "scratch_v0")))) (impl/impl-postgres-init) (promise/x:promise-then (fn [impl] (return (impl/pull-async impl ["Log"])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => (contains-in [{"message" "hello" "author_id" nil "id" string?}]))

^{:added "4.1" :refer xt.db.system.impl-postgres/rpc-call-async} (fact "rpc-call-async compiles snake_case postgres function calls" (notify/wait-on :js (-> (impl/impl-postgres (js-postgres/create {:database "test-scratch"}) ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))) ((deref !) (pg/bind-app (pg/app "scratch_v0")))) (impl/impl-postgres-init) (promise/x:promise-then (fn [impl] (return (impl/rpc-call-async impl {:flags {} :return "jsonb" :input [{:type "text" :symbol "message"}] :id "log_append_public" :schema "scratch_v0"} ["hello"])))) (promise/x:promise-then (fn [out] (repl/notify out))) (promise/x:promise-catch (fn [out] (repl/notify out))))) => (contains-in {"message" "hello" "author_id" nil "id" string?}) (notify/wait-on :js (-> (impl/impl-postgres (js-postgres/create {:database "test-scratch"}) ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))) ((deref !) (pg/bind-app (pg/app "scratch_v0")))) (impl/impl-postgres-init) (promise/x:promise-then (fn [impl] (return (impl/rpc-call-async impl {:flags {} :return "text" :input [] :id "ping" :schema "scratch_v0"} [])))) (promise/x:promise-then (fn [out] (repl/notify out))) (promise/x:promise-catch (fn [out] (repl/notify out))))) => "pong")

^{:added "4.1" :refer xt.db.system.impl-postgres/impl-postgres} (fact "creates the thin postgres impl record with stored context" (!.js (impl/impl-postgres (js-postgres/create {:database "test-scratch"}) ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))) ((deref !) (pg/bind-app (pg/app "scratch_v0"))))) => (contains-in {"schema" map? "client" {"::" "js.net.conn_postgres/PostgresClient" "::/protocols" ["xt.net.conn_sql/ISqlClient"] "defaults" {"database" "test-scratch"}} "::/protocols" ["xt.db.system.impl_common/ISourceRemote"] "lookup" map? "opts" map? "::" "xt.db.system.impl_postgres/ImplPostgres"}))

^{:added "4.1" :refer xt.db.system.impl-postgres/impl-postgres-init} (fact "initialises a postgres connection")

^{:added "4.1" :refer xt.db.system.impl-postgres/stop-db} (fact "closes the postgres client and clears raw connection state" (notify/wait-on :js (-> (impl/impl-postgres (js-postgres/create {:database "test-scratch"}) ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))) ((deref !) (pg/bind-app (pg/app "scratch_v0")))) (impl/impl-postgres-init) (promise/x:promise-then (fn [impl] (var client (xt/x:get-key impl "client")) (var connected (xt/x:not-nil? (xt/x:get-key client "raw"))) (impl/stop-db impl) (var raw (xt/x:get-key client "raw")) (repl/notify {"connected" connected "raw-nil" (xt/x:nil? raw)}))))) => {"connected" true "raw-nil" true})
