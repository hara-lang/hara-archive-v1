(ns xt.db.system.main-test (:use code.test) (:require [lang.core :as l] [xt.lang.common-notify :as notify] [scaffold.supabase.local-min :as local-min]))

(do (l/script- :postgres {:config {:port (-> local-min/+config+ :db :port) :startup local-min/start-supabase :shutdown local-min/stop-supabase :pass (-> local-min/+config+ :db :password) :user (-> local-min/+config+ :db :user) :host (-> local-min/+config+ :db :host) :dbname (-> local-min/+config+ :db :database)} :runtime :jdbc.client :require [[postgres.sample.scratch-v0 :as scratch-v0] [postgres.core :as pg] [postgres.core.supabase :as s]] :emit {:code {:transforms {:entry [(var s/transform-entry)]}}}}) (defrun.pg __init__ (s/grant-usage #{"scratch_v0"})))

(l/script- :js {:require [[xt.lang.common-data :as xtd] [xt.lang.common-repl :as repl] [xt.lang.spec-base :as xt] [xt.lang.spec-promise :as promise] [xt.db.system.impl-common :as impl-common] [xt.db.system.impl-postgres :as impl-postgres] [xt.db.system.main :as main]] :runtime :basic})

(def.js Schema ((deref !) (pg/bind-schema (:schema (pg/app "scratch_v0")))))

(def.js SchemaLookup ((deref !) (pg/bind-app (pg/app "scratch_v0"))))

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart) (l/rt:setup :postgres)]})

^{:added "4.1" :refer xt.db.system.main/create-impl} (fact "creates impls for local and live backends" [(!.js (xtd/get-in (main/create-impl "memory" {} -/Schema -/SchemaLookup) ["::"])) (!.js (xtd/get-in (main/create-impl "sqlite" {"filename" ":memory:"} -/Schema -/SchemaLookup) ["::"])) (!.js (xtd/get-in (main/create-impl "postgres" ((deref !) (local-min/+config+ :db)) -/Schema -/SchemaLookup) ["::"])) (!.js (xtd/get-in (main/create-impl "supabase" {"port" ((deref !) (-> local-min/+config+ :api :port)) "apikey" ((deref !) (-> local-min/+config+ :api :service-key)) "host" "127.0.0.1" "secured" false "basepath" ""} -/Schema -/SchemaLookup) ["::"]))] => ["xt.db.system.impl_memory/ImplMemory" "xt.db.system.impl_sqlite/ImplSqlite" "xt.db.system.impl_postgres/ImplPostgres" "xt.db.system.impl_supabase/ImplSupabase"])

^{:added "4.1" :refer xt.db.system.main/create-impl-init} (fact "initialises postgres impls and leaves the wrapper output usable" (notify/wait-on :js (-> (main/create-impl "postgres" ((deref !) (local-min/+config+ :db)) -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (repl/notify (xt/x:get-key impl "client")))))) => map?)

^{:setup [(l/rt:restart :js)] :added "4.1" :refer xt.db.system.impl-common/pull} (fact "pull reads from the local memory impl" (!.js (main/create-impl "sqlite" {} -/Schema -/SchemaLookup)) (notify/wait-on :js (-> (main/create-impl "sqlite" {} -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (impl-common/record-add impl "Log" [{"message" "hello" "id" "LOG-10"} {"message" "world" "id" "LOG-20"}]) (repl/notify (impl-common/pull impl ["Log"])))))) => (contains [(contains {"message" "hello" "id" "LOG-10"}) (contains {"message" "world" "id" "LOG-20"})] :in-any-order) (notify/wait-on :js (-> (main/create-impl "memory" {} -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (impl-common/record-add impl "Log" [{"message" "hello" "id" "LOG-10"} {"message" "world" "id" "LOG-20"}]) (repl/notify (impl-common/pull impl ["Log"])))))) => (contains [(contains {"message" "hello" "id" "LOG-10"}) (contains {"message" "world" "id" "LOG-20"})] :in-any-order))

^{:setup [(pg/t:delete scratch-v0/Log) (scratch-v0/log-append "hello") (scratch-v0/log-append "world")] :added "4.1" :refer xt.db.system.impl-common/pull-async} (fact "getting same semantics for supabase and postgres" (notify/wait-on :js (-> (main/create-impl "postgres" ((deref !) (:db local-min/+config+)) -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (return (impl-common/pull-async impl ["Log"])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => (contains [(contains {"message" "hello" "author_id" nil "id" string?}) (contains {"message" "world" "author_id" nil "id" string?})] :in-any-order) (notify/wait-on :js (-> (main/create-impl "supabase" ((deref !) local-min/+config-supabase-anon+) -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (return (impl-common/pull-async impl ["Log"])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => (contains [(contains {"message" "hello" "author_id" nil "id" string?}) (contains {"message" "world" "author_id" nil "id" string?})] :in-any-order))

^{:setup [(l/rt:restart :js)] :added "4.1" :refer xt.db.system.impl-common/rpc-call-async} (fact "rpc-call-async reaches the live supabase rpc endpoint" (notify/wait-on :js (-> (main/create-impl "postgres" ((deref !) (:db local-min/+config+)) -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (return (impl-common/rpc-call-async impl {"schema" "scratch_v0" "flags" {} "input" [] "return" "text" "id" "ping"} [])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => "pong" (notify/wait-on :js (-> (main/create-impl "supabase" ((deref !) local-min/+config-supabase-anon+) -/Schema -/SchemaLookup) (main/create-impl-init) (promise/x:promise-then (fn [impl] (return (impl-common/rpc-call-async impl {"schema" "scratch_v0" "flags" {} "input" [] "return" "text" "id" "ping"} [])))) (promise/x:promise-then (fn [out] (repl/notify out))))) => "pong")

^{:added "4.1" :refer xt.db.system.impl-common/record-add} (fact "record-add writes through the local memory impl" (notify/wait-on :js (var impl (main/create-impl "memory" {} -/Schema -/SchemaLookup)) (-> (main/create-impl-init impl) (promise/x:promise-then (fn [impl] (impl-common/record-add impl "Log" [{"message" "delta" "author_id" "00000000-0000-0000-0000-000000000000" "id" "00000000-0000-0000-0000-000000000000"}]))) (promise/x:promise-then (fn [_] (repl/notify (impl-common/pull impl ["Log"])))))) => [{"message" "delta" "id" "00000000-0000-0000-0000-000000000000"}] (notify/wait-on :js (var impl (main/create-impl "sqlite" {} -/Schema -/SchemaLookup)) (-> (main/create-impl-init impl) (promise/x:promise-then (fn [impl] (impl-common/record-add impl "Log" [{"message" "delta" "author_id" "00000000-0000-0000-0000-000000000000" "id" "00000000-0000-0000-0000-000000000000"}]))) (promise/x:promise-then (fn [_] (repl/notify (impl-common/pull impl ["Log"])))))) => [{"message" "delta" "author_id" "00000000-0000-0000-0000-000000000000" "id" "00000000-0000-0000-0000-000000000000"}])

^{:added "4.1" :refer xt.db.system.impl-common/record-delete} (fact "record-delete removes ids through the local memory impl" (!.js (var impl (main/create-impl "memory" {} -/Schema -/SchemaLookup)) (impl-common/record-add impl "Log" [{"message" "root" "id" "LOG-30"}]) (impl-common/record-delete impl "Log" ["LOG-30"]) (xtd/get-in impl ["client" "Log" "LOG-30"])) => nil)

^{:added "4.1" :refer xt.db.system.impl-common/process-add-event} (fact "process-add-event merges nested data into the local memory impl" (!.js (var impl (main/create-impl "memory" {} -/Schema -/SchemaLookup)) (var out (impl-common/process-add-event impl {"Log" [{"message" "root" "id" "LOG-50"}]})) [(xt/x:len out) (xtd/get-in impl ["rows" "Log" "LOG-50" "record" "data" "message"])]) => [0 "root"])

^{:added "4.1" :refer xt.db.system.impl-common/process-remove-event} (fact "process-remove-event removes nested data in lookup order" (!.js (var impl (main/create-impl "memory" {} -/Schema -/SchemaLookup)) (impl-common/process-add-event impl {"Log" [{"message" "root" "id" "LOG-60"}]}) [(impl-common/process-remove-event impl {"Log" [{"message" "root" "id" "LOG-60"}]}) (xtd/get-in impl ["rows" "Log" "LOG-60"])]) => [["Log"] nil])
