(ns xt.db.text.base-flatten-test (:require [lang.core :as l]) (:use code.test))

^{:seedgen/root {:all true}} (l/script- :js {:require [[xt.lang.spec-base :as xt] [xt.lang.common-data :as xtd] [xt.db.text.base-flatten :as f] [xt.db.text.base-schema :as sch] [xt.db.helpers.data-main-test :as sample]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.db.text.base-flatten/flatten-get-links :added "4.0"} (fact "flatten links" (!.js (f/flatten-get-links {:currencies [{:id "hello"}]})) => {"currencies" {"hello" true}})

^{:refer xt.db.text.base-flatten/flatten-merge :added "4.0"} (fact "flatten data" (!.js (f/flatten-merge {} {:id "hello"} {:profile {"profile-id" true}} {})) => {"hello" {"data" {"id" "hello"} "ref_links" {"profile" {"profile-id" true}} "id" "hello" "rev_links" {}}})

^{:refer xt.db.text.base-flatten/flatten-node :added "4.0"} (fact "flatten node" (!.js (var out (f/flatten-node sample/Schema "UserAccount" sample/RootUserFull {} {})) (xtd/obj-keys out)) => (just ["table_map" "data_obj" "ref_obj" "rev_obj"] :in-any-order))

^{:refer xt.db.text.base-flatten/flatten-node.account :setup [(def +table-map-account+ (contains-in {"00000000-0000-0000-0000-000000000000" {"data" {"is_official" false "nickname" "root" "password_updated" number? "id" "00000000-0000-0000-0000-000000000000" "is_super" true "is_suspended" false} "ref_links" {} "id" "00000000-0000-0000-0000-000000000000" "rev_links" {"profile" {"c4643895-b0ce-44cc-b07b-2386bf18d43b" true} "notification" {"d0adc63a-0bfa-41fe-b054-f4fb0cb354bd" true} "organisations" {"ec088f52-310b-491b-a034-d4efc222fd00" true} "wallets" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}}}}))] :added "4.0" :adopt true} (fact "flatten node example for user account" (!.js (-> (f/flatten-node sample/Schema "UserAccount" sample/RootUserFull {} {}) (xt/x:get-key "table_map"))) => +table-map-account+)

^{:refer xt.db.text.base-flatten/flatten-node.profile :setup [(def +table-map-profile+ {"data_obj" {"last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b"} "rev_obj" {} "table_map" {"c4643895-b0ce-44cc-b07b-2386bf18d43b" {"data" {"last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b"} "ref_links" {"account" {"hello" true}} "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "rev_links" {}}} "ref_obj" {"account" ["hello"]}})] :added "4.0" :adopt true} (fact "flatten node example for user account" (!.js (f/flatten-node sample/Schema "UserProfile" {"account" ["hello"] "last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b"} {} {})) => +table-map-profile+)

^{:refer xt.db.text.base-flatten/flatten-linked :setup [(def +table-linked+ {"Organisation" {"ec088f52-310b-491b-a034-d4efc222fd00" {"data" {"name" "root" "id" "ec088f52-310b-491b-a034-d4efc222fd00"} "ref_links" {"owner" {"hello" true}} "id" "ec088f52-310b-491b-a034-d4efc222fd00" "rev_links" {}}} "UserProfile" {"c4643895-b0ce-44cc-b07b-2386bf18d43b" {"data" {"last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b"} "ref_links" {"account" {"hello" true}} "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "rev_links" {}}}})] :added "4.0"} (fact "flatten linked for schema" (!.js (f/flatten-linked sample/Schema "UserAccount" {"profile" [{"last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "picture" {"url" "static/user.jpg" "type" "base"}}] "organisations" [{"name" "root" "id" "ec088f52-310b-491b-a034-d4efc222fd00"}]} "hello" {} f/flatten-obj)) => +table-linked+)

^{:refer xt.db.text.base-flatten/flatten-obj :setup [(def +user-full+ (contains-in {"UserAccount" {"00000000-0000-0000-0000-000000000000" {"data" {"is_official" false "nickname" "root" "password_updated" number? "id" "00000000-0000-0000-0000-000000000000" "is_super" true "is_suspended" false} "ref_links" {} "id" "00000000-0000-0000-0000-000000000000" "rev_links" {"profile" {"c4643895-b0ce-44cc-b07b-2386bf18d43b" true} "notification" {"d0adc63a-0bfa-41fe-b054-f4fb0cb354bd" true} "organisations" {"ec088f52-310b-491b-a034-d4efc222fd00" true} "wallets" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}}}} "Asset" {"63acfd25-4b1b-4de4-aa82-909019c95591" {"data" {"id" "63acfd25-4b1b-4de4-aa82-909019c95591"} "ref_links" {"currency" {"STATS" true}} "id" "63acfd25-4b1b-4de4-aa82-909019c95591" "rev_links" {"linked_wallet" {"6eb2fa48-c753-41c6-abda-c680828da1d2" true}}} "9261d072-b7f5-41df-935a-c36fe13acf14" {"data" {"id" "9261d072-b7f5-41df-935a-c36fe13acf14"} "ref_links" {"currency" {"XLM.T" true}} "id" "9261d072-b7f5-41df-935a-c36fe13acf14" "rev_links" {"linked_wallet" {"2b3d4318-8cea-4420-a31c-f110d8198654" true}}} "9e576e3e-c73e-4d18-92b4-f975c1bed3d4" {"data" {"id" "9e576e3e-c73e-4d18-92b4-f975c1bed3d4"} "ref_links" {"currency" {"USD" true}} "id" "9e576e3e-c73e-4d18-92b4-f975c1bed3d4" "rev_links" {"linked_wallet" {"38889fdc-de34-4161-bb37-f8844d67ee5a" true}}} "222de282-ca29-4d04-81dd-86ec3f9189cf" {"data" {"id" "222de282-ca29-4d04-81dd-86ec3f9189cf"} "ref_links" {"currency" {"XLM" true}} "id" "222de282-ca29-4d04-81dd-86ec3f9189cf" "rev_links" {"linked_wallet" {"4b146b40-947a-42a5-b116-2ad8816c4078" true}}}} "Currency" {"USD" {"data" {"id" "USD"} "ref_links" {} "id" "USD" "rev_links" {"assets" {"9e576e3e-c73e-4d18-92b4-f975c1bed3d4" true}}} "XLM" {"data" {"id" "XLM"} "ref_links" {} "id" "XLM" "rev_links" {"assets" {"222de282-ca29-4d04-81dd-86ec3f9189cf" true}}} "STATS" {"data" {"id" "STATS"} "ref_links" {} "id" "STATS" "rev_links" {"assets" {"63acfd25-4b1b-4de4-aa82-909019c95591" true}}} "XLM.T" {"data" {"id" "XLM.T"} "ref_links" {} "id" "XLM.T" "rev_links" {"assets" {"9261d072-b7f5-41df-935a-c36fe13acf14" true}}}} "UserNotification" {"d0adc63a-0bfa-41fe-b054-f4fb0cb354bd" {"data" {"trading" {} "general" {} "id" "d0adc63a-0bfa-41fe-b054-f4fb0cb354bd" "funding" {}} "ref_links" {"account" {"00000000-0000-0000-0000-000000000000" true}} "id" "d0adc63a-0bfa-41fe-b054-f4fb0cb354bd" "rev_links" {}}} "WalletAsset" {"6eb2fa48-c753-41c6-abda-c680828da1d2" {"data" {"id" "6eb2fa48-c753-41c6-abda-c680828da1d2"} "ref_links" {"asset" {"63acfd25-4b1b-4de4-aa82-909019c95591" true} "wallet" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}} "id" "6eb2fa48-c753-41c6-abda-c680828da1d2" "rev_links" {}} "38889fdc-de34-4161-bb37-f8844d67ee5a" {"data" {"id" "38889fdc-de34-4161-bb37-f8844d67ee5a"} "ref_links" {"asset" {"9e576e3e-c73e-4d18-92b4-f975c1bed3d4" true} "wallet" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}} "id" "38889fdc-de34-4161-bb37-f8844d67ee5a" "rev_links" {}} "4b146b40-947a-42a5-b116-2ad8816c4078" {"data" {"id" "4b146b40-947a-42a5-b116-2ad8816c4078"} "ref_links" {"asset" {"222de282-ca29-4d04-81dd-86ec3f9189cf" true} "wallet" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}} "id" "4b146b40-947a-42a5-b116-2ad8816c4078" "rev_links" {}} "2b3d4318-8cea-4420-a31c-f110d8198654" {"data" {"id" "2b3d4318-8cea-4420-a31c-f110d8198654"} "ref_links" {"asset" {"9261d072-b7f5-41df-935a-c36fe13acf14" true} "wallet" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" true}} "id" "2b3d4318-8cea-4420-a31c-f110d8198654" "rev_links" {}}} "Wallet" {"531f3edb-b9d4-4c8e-8419-22edfe715b15" {"data" {"id" "531f3edb-b9d4-4c8e-8419-22edfe715b15"} "ref_links" {"owner" {"00000000-0000-0000-0000-000000000000" true}} "id" "531f3edb-b9d4-4c8e-8419-22edfe715b15" "rev_links" {"entries" {"6eb2fa48-c753-41c6-abda-c680828da1d2" true "38889fdc-de34-4161-bb37-f8844d67ee5a" true "4b146b40-947a-42a5-b116-2ad8816c4078" true "2b3d4318-8cea-4420-a31c-f110d8198654" true}}}} "Organisation" {"ec088f52-310b-491b-a034-d4efc222fd00" {"data" {"name" "root" "title" "" "id" "ec088f52-310b-491b-a034-d4efc222fd00" "description" nil} "ref_links" {"owner" {"00000000-0000-0000-0000-000000000000" true}} "id" "ec088f52-310b-491b-a034-d4efc222fd00" "rev_links" {}}} "UserProfile" {"c4643895-b0ce-44cc-b07b-2386bf18d43b" {"data" {"city" nil "about" nil "last_name" "User" "language" "en" "first_name" "Root" "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b"} "ref_links" {"account" {"00000000-0000-0000-0000-000000000000" true}} "id" "c4643895-b0ce-44cc-b07b-2386bf18d43b" "rev_links" {}}}}))] :added "4.0"} (fact "flatten data for schema" (!.js (f/flatten-obj sample/Schema "UserAccount" sample/RootUserFull {} {})) => +user-full+)

^{:refer xt.db.text.base-flatten/flatten :added "4.0"} (fact "flattens data schema" (!.js (f/flatten sample/Schema "UserAccount" sample/RootUserFull nil)) => +user-full+)

^{:refer xt.db.text.base-flatten/flatten-bulk :added "4.0"} (fact "flattens bulk data" (!.js (f/flatten-bulk sample/Schema {"UserAccount" [sample/RootUserFull]})) => +user-full+)

(comment (s/run [(quote xt.db.text.base-flatten)]) (s/seedgen-langadd (quote xt.db.text.base-flatten) {:lang [:lua :python] :write true}) (s/seedgen-langremove (quote xt.db.text.base-flatten) {:lang [:lua :python] :write true}))

^{:refer xt.db.text.base-flatten/flatten-bulk-ids :added "4.1"} (fact "prepares ordered delete ids from nested bulk data" (!.js (xtd/arr-map (f/flatten-bulk-ids sample/Schema sample/SchemaLookup {"UserAccount" [sample/RootUserFull]}) (fn [entry] (var [table-name ids] entry) (xtd/arr-sort ids (fn [id] (return id)) xt/x:lt) (return [table-name ids])))) => [["UserAccount" ["00000000-0000-0000-0000-000000000000"]] ["UserProfile" ["c4643895-b0ce-44cc-b07b-2386bf18d43b"]] ["UserNotification" ["d0adc63a-0bfa-41fe-b054-f4fb0cb354bd"]] ["Asset" ["222de282-ca29-4d04-81dd-86ec3f9189cf" "63acfd25-4b1b-4de4-aa82-909019c95591" "9261d072-b7f5-41df-935a-c36fe13acf14" "9e576e3e-c73e-4d18-92b4-f975c1bed3d4"]] ["Wallet" ["531f3edb-b9d4-4c8e-8419-22edfe715b15"]] ["WalletAsset" ["2b3d4318-8cea-4420-a31c-f110d8198654" "38889fdc-de34-4161-bb37-f8844d67ee5a" "4b146b40-947a-42a5-b116-2ad8816c4078" "6eb2fa48-c753-41c6-abda-c680828da1d2"]] ["Organisation" ["ec088f52-310b-491b-a034-d4efc222fd00"]] ["Currency" ["STATS" "USD" "XLM" "XLM.T"]]])
