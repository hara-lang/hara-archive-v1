(ns xt.db.text.sql-raw-test (:require [lang.core :as l] [std.lib.format.prose :as prose]) (:use code.test))

^{:seedgen/root {:all true}} (l/script- :js {:require [[xt.db.text.sql-raw :as raw] [xt.lang.common-lib :as k]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.db.text.sql-raw/raw-delete :added "4.0"} (fact "encodes a delete query" (!.js [(raw/raw-delete "Currency" {:id "XLM"} {}) (raw/raw-delete "Currency" {:id ["in" [["XLM" "USD"]]]} {})]) => ["DELETE FROM Currency WHERE id = 'XLM';" "DELETE FROM Currency WHERE id in ('XLM', 'USD');"])

^{:refer xt.db.text.sql-raw/raw-insert-array :added "4.0"} (fact "constructs an array for insert and upsert" (!.js (raw/raw-insert-array "Currency" ["id" "name" "type"] [{:type "crypto" :name "XLM" :id "XLM"}] {})) => ["INSERT INTO Currency" " (id, name, type)" " VALUES\n ('XLM','XLM','crypto')"])

^{:refer xt.db.text.sql-raw/raw-insert :added "4.0"} (fact "encodes an insert query" (!.js (raw/raw-insert "Currency" ["id" "name" "type"] [{:type "crypto" :name "XLM" :id "XLM"}] {})) => (prose/| "INSERT INTO Currency" " (id, name, type)" " VALUES" " ('XLM','XLM','crypto');"))

^{:refer xt.db.text.sql-raw/raw-upsert :added "4.0"} (fact "encodes an upsert query" (!.js (raw/raw-upsert "Currency" "id" ["id" "name" "type"] [{:type "crypto" :name "XLM" :id "XLM"}] {})) => (prose/| "INSERT INTO Currency" " (id, name, type)" " VALUES" " ('XLM','XLM','crypto')" "ON CONFLICT (id) DO UPDATE SET" "name=coalesce(\"excluded\".name,name)," "type=coalesce(\"excluded\".type,type);"))

^{:refer xt.db.text.sql-raw/raw-upsert.more :adopt true :setup [(def +input+ (prose/| "INSERT INTO Currency" " (id, name, type)" " VALUES" " ('XLM','XLM','crypto')" "ON CONFLICT (id) DO UPDATE SET" "name=coalesce(\"excluded\".name,name)," "type=coalesce(\"excluded\".type,type)" "WHERE \"excluded\".time_updated < time_updated;"))] :added "4.0"} (fact "encodes an upsert query" (!.js (raw/raw-upsert "Currency" "id" ["id" "name" "type"] [{:type "crypto" :name "XLM" :id "XLM"}] {:upsert-clause "\"excluded\".time_updated < time_updated"})) => +input+)

^{:refer xt.db.text.sql-raw/raw-update :added "4.0"} (fact "encodes an update query" (!.js (raw/raw-update "Currency" {:id "XLM"} {:name "Stellar"} {})) => "UPDATE Currency\n SET name = 'Stellar'\n WHERE id = 'XLM';")

^{:refer xt.db.text.sql-raw/raw-select :added "4.0"} (fact "encodes an select query" (!.js (raw/raw-select "Currency" {:id "XLM"} ["id" "name" "type"] {})) => "SELECT id, name, type\n  FROM Currency\n WHERE id = 'XLM';")

(comment (./import))

(comment (s/pedantic [(quote xt.db.text.sql-raw)]) (s/run [(quote xt.db.text.sql-raw)]) (s/seedgen-benchadd (quote [xt.db.text.sql-raw]) {:lang [:dart :julia] :write true}) (s/seedgen-langadd (quote [xt.db.text.sql-raw]) {:lang [:lua :python] :write true}) (s/seedgen-langremove (quote [xt.db.text.sql-raw]) {:lang [:lua :python] :write true}))
