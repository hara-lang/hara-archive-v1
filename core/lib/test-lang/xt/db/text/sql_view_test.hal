(ns xt.db.text.sql-view-test (:require [lang.core :as l] [postgres.gen.bind-macro :as gen] [std.lib.format.prose :as prose] [xt.db.helpers.seed-system-test :as data] [xt.db.helpers.seed-user-test :as user]) (:use code.test))

^{:seedgen/root {:all true}} (l/script- :js {:require [[xt.db.text.sql-view :as v] [xt.db.text.sql-util :as ut] [xt.db.text.sql-raw :as raw] [xt.lang.common-lib :as k] [xt.db.text.base-schema :as sch] [xt.db.text.base-scope :as scope] [xt.db.helpers.data-main-test :as sample]] :runtime :basic})

^{:refer xt.db.text.sql-view/tree-select.organisation-all-as-admin :adopt true :setup [(def +input-organisation-all-as-admin+ {:return "jsonb" :input [{(syntax-quote :type) "uuid" :symbol "i_account_id"}] :id "organisation_all_as_admin" :schema "scratch-sample-db" :flags {:personal true} :view {:table "Organisation" :type "select" :query nil :tag "all_as_admin"}}) (def +check-organisation-all-as-admin+ ["Organisation" {"where" [] "data" ["id"] "custom" [] "links" []}])] :added "4.0" :guard true} (fact "provides a view select query" (!.js (v/tree-select sample/Schema ((deref !) +input-organisation-all-as-admin+) {} {})) => +check-organisation-all-as-admin+)

^{:refer xt.db.text.sql-view/tree-return.organisation-view-default :adopt true :setup [(def +input-organisation-view-default+ {:return "jsonb" :input [{:type "uuid" :symbol "i_organisation_id"}] :id "organisation_view_default" :schema "scratch-sample-db" :flags {:public true} :view {:table "Organisation" :type "return" :query ["*/data"] :tag "view_default"}}) (def +check-organisation-view-default+ ["Organisation" {"where" [{"id" "{{RETURN}}"}] "data" ["id" "name" "title" "description" "tags"] "custom" [] "links" []}])] :added "4.0"} (fact "provides a view return query" (!.js (v/tree-return sample/Schema ((deref !) +input-organisation-view-default+) {"id" "{{RETURN}}"} {} {})) => +check-organisation-view-default+)

^{:refer xt.db.text.sql-view/query-select.organisation-all-as-admin :adopt true :setup [(def +input-organisation-all-as-admin+ {:return "jsonb" :input [{:type "uuid" :symbol "i_account_id"}] :id "organisation_all_as_admin" :schema "scratch-sample-db" :flags {:personal true} :view {:table "Organisation" :type "select" :query nil :tag "all_as_admin"}}) (def +check-organisation-all-as-admin+ [["Organisation" {"where" [] "data" ["id"] "custom" [] "links" []}] "SELECT id FROM Organisation"])] :added "4.0"} (fact "provides a view select query" (!.js [(v/query-select sample/Schema ((deref !) +input-organisation-all-as-admin+) ["00000000-0000-0000-0000-000000000000"] {} true) (v/query-select sample/Schema ((deref !) +input-organisation-all-as-admin+) ["00000000-0000-0000-0000-000000000000"] {} false)]) => +check-organisation-all-as-admin+)

^{:refer xt.db.text.sql-view/tree-base.control :adopt true :setup [(def +check-tree-base-control+ ["RegionCountry" {"where" [] "data" ["id" "name"] "custom" [{"::" "sql/keyword" "name" "LIMIT" "args" [{"::" "sql/keyword" "name" 20}]} {"::" "sql/keyword" "name" "ORDER BY" "args" [{"::" "sql/tuple" "args" [{"::" "sql/column" "name" "name"}]}]}] "links" []}])] :added "4.0"} (fact "creates a tree base" (!.js (v/tree-base sample/Schema "RegionCountry" [] [] ["id" "name" (ut/LIMIT 20) (ut/ORDER-BY ["name"])] {})) => +check-tree-base-control+)

^{:refer xt.db.text.sql-view/tree-control-array :setup [(def +check-tree-control-array+ [{"::" "sql/keyword" "name" "ORDER BY" "args" [{"::" "sql/tuple" "args" [{"::" "sql/column" "name" "name"}]}]} {"::" "sql/keyword" "name" "LIMIT" "args" [{"::" "sql/keyword" "name" 20}]}])] :added "4.0"} (fact "creates a control array" (!.js (v/tree-control-array {:limit 20 :order-by ["name"]})) => +check-tree-control-array+)

^{:refer xt.db.text.sql-view/tree-base :setup [(def +check-tree-base+ ["Currency" {"where" [{"type" "fiat" "id" "USD"} {"type" "fiat" "id" "AUD"}] "data" ["id" "type" "symbol" "native" "decimal" "name" "plural" "description"] "custom" [] "links" []}])] :added "4.0"} (fact "creates a tree base" (!.js (v/tree-base sample/Schema "Currency" [{:id "USD"} {:id "AUD"}] {:type "fiat"} ["*/data"] {})) => +check-tree-base+)

^{:refer xt.db.text.sql-view/tree-count :setup [(def +input-tree-count+ {:return "jsonb" :input [{:type "text" :symbol "i_type"}] :id "currency_by_type" :schema "scratch-sample-db" :flags {:public true} :view {:table "Currency" :type "select" :query {"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" :name "EnumCurrencyType" :schema "scratch-sample-db"}]}} :tag "by_type"}}) (def +check-tree-count+ ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" [] "custom" [{"::" "sql/count"}] "links" []}])] :added "4.0"} (fact "provides a view count query" (!.js (v/tree-count sample/Schema ((deref !) +input-tree-count+) {} {})) => +check-tree-count+)

^{:refer xt.db.text.sql-view/tree-select :setup [(def +input-tree-select+ {:return "jsonb" :input [{:type "text" :symbol "i_type"}] :id "currency_by_type" :schema "scratch-sample-db" :flags {:public true} :view {:table "Currency" :type "select" :query {"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" :name "EnumCurrencyType" :schema "scratch-sample-db"}]}} :tag "by_type"}}) (def +check-tree-select+ ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" ["id"] "custom" [] "links" []}])] :added "4.0"} (fact "provides a view select query" (!.js (v/tree-select sample/Schema ((deref !) +input-tree-select+) {} {})) => +check-tree-select+)

^{:refer xt.db.text.sql-view/tree-return :setup [(def +return+ (gen/bind-view data/currency-default)) (def +out+ ["Currency" {"where" [{"id" "{{RETURN}}"}] "data" ["id" "type" "symbol" "native" "decimal" "name" "plural" "description"] "custom" [] "links" []}])] :added "4.0"} (fact "provides a view return query" (!.js (v/tree-return sample/Schema ((deref !) +return+) {"id" "{{RETURN}}"} {} {})) => +out+)

^{:refer xt.db.text.sql-view/tree-combined :setup [(def +select+ (gen/bind-view user/organisation-all-as-admin)) (def +return+ (gen/bind-view user/organisation-view-membership)) (def +out+ ["Organisation" {"where" [] "data" ["id" "name" "title" "description" "tags"] "custom" [] "links" [["access" "reverse" ["OrganisationAccess" {"where" [{"organisation" ["eq" ["Organisation.id"]]}] "data" ["id" "role"] "custom" [] "links" [["account" "forward" ["UserAccount" {"where" [{"id" ["eq" ["OrganisationAccess.account_id"]]}] "data" ["id" "nickname"] "custom" [] "links" []}]]]}]]]}])] :added "4.0"} (fact "provides a view return query" (!.js (v/tree-combined sample/Schema ((deref !) +select+) ((deref !) +return+) nil {} {})) => +out+)

^{:refer xt.db.text.sql-view/query-fill-input :setup [(def +out+ ["Organisation" {"where" [] "data" ["id"] "custom" [] "links" []}])] :added "4.0"} (fact "fills out the tree for a given input" (!.js (var entry ((deref !) (gen/bind-view user/organisation-all-as-member))) (var tree (v/tree-select sample/Schema entry {} {})) (v/query-fill-input tree ["<ORG-ID>"] (. entry ["input"]) false)) => +out+)

^{:refer xt.db.text.sql-view/query-select :setup [(def +select+ (gen/bind-view data/currency-all-crypto)) (def +out+ [["Currency" {"where" [{"type" "crypto"}] "data" ["id"] "custom" [] "links" []}] "SELECT id FROM Currency\n  WHERE type = 'crypto'"])] :added "4.0"} (fact "provides a view select query" (!.js [(v/query-select sample/Schema ((deref !) +select+) [] {} true) (v/query-select sample/Schema ((deref !) +select+) [] {} false)]) => +out+)

^{:refer xt.db.text.sql-view/query-count :setup [(def +select+ (gen/bind-view data/currency-all-crypto)) (def +out+ [["Currency" {"where" [{"type" "crypto"}] "data" [] "custom" [{"::" "sql/count"}] "links" []}] "SELECT count(*) FROM Currency\n  WHERE type = 'crypto'"])] :added "4.0"} (fact "provides the count statement" (!.js [(v/query-count sample/Schema ((deref !) +select+) [] {} true) (v/query-count sample/Schema ((deref !) +select+) [] {} false)]) => +out+)

^{:refer xt.db.text.sql-view/query-return :setup [(def +return+ (gen/bind-view data/currency-info)) (def +out+ [["Currency" {"where" [{"id" "STATS"}] "data" ["id" "description"] "custom" [] "links" []}] "SELECT id, description FROM Currency\n  WHERE id = 'STATS'"])] :added "4.0"} (fact "provides a view return query" (!.js [(v/query-return sample/Schema ((deref !) +return+) "STATS" [] {} true) (v/query-return sample/Schema ((deref !) +return+) "STATS" [] {} false)]) => +out+)

^{:refer xt.db.text.sql-view/query-return-bulk :added "4.0"} (fact "creates a bulk return statement" (!.js (v/query-return-bulk sample/Schema ((deref !) +return+) ["STATS" "USD"] [] {} false)) => "SELECT id, description FROM Currency\n  WHERE id in ('STATS', 'USD')")

^{:refer xt.db.text.sql-view/query-combined :setup [(def +select+ (gen/bind-view data/currency-all-crypto)) (def +return+ (gen/bind-view data/currency-info)) (def +out+ [["Currency" {"where" [{"type" "crypto"}] "data" ["id" "description"] "custom" [] "links" []}] "SELECT id, description FROM Currency\n  WHERE type = 'crypto'"])] :added "4.0"} (fact "provides a view combine query" (!.js [(v/query-combined sample/Schema ((deref !) +select+) [] ((deref !) +return+) [] nil {} true) (v/query-combined sample/Schema ((deref !) +select+) [] ((deref !) +return+) [] nil {} false)]) => +out+)

(comment (s/pedantic [(quote xt.db.text.sql-view)]) (s/run [(quote xt.db.text.sql-view)]) (s/seedgen-benchadd (quote [xt.db.text.sql-view]) {:lang [:dart :julia] :write true}) (s/seedgen-langadd (quote [xt.db.text.sql-view]) {:lang [:lua :python] :write true}) (s/seedgen-langremove (quote [xt.db.text.sql-view]) {:lang [:lua :python] :write true}))
