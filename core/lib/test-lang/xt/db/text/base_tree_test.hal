(ns xt.db.text.base-tree-test (:require [lang.core :as l]) (:use code.test))

^{:seedgen/root {:all true}} (l/script- :js {:require [[xt.db.text.base-tree :as v] [xt.db.text.sql-util :as ut] [xt.db.helpers.data-main-test :as sample] [xt.lang.spec-base :as xt] [xt.lang.common-data :as xtd]] :runtime :basic})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.db.text.base-tree/tree-control-array :setup [(def +check-tree-control-array+ [{"::" "sql/keyword" "name" "ORDER BY" "args" [{"::" "sql/tuple" "args" [{"::" "sql/column" "name" "name"}]}]} {"::" "sql/keyword" "name" "LIMIT" "args" [{"::" "sql/keyword" "name" 20}]}])] :added "4.1"} (fact "creates a control array" (!.js (v/tree-control-array {:limit 20 :order-by ["name"]})) => +check-tree-control-array+)

^{:refer xt.db.text.base-tree/tree-base :setup [(def +check-tree-base+ ["Currency" {"where" [{"type" "fiat" "id" "USD"} {"type" "fiat" "id" "AUD"}] "data" ["id" "type" "symbol" "native" "decimal" "name" "plural" "description"] "custom" [] "links" []}])] :added "4.1"} (fact "creates a tree base" (!.js (v/tree-base sample/Schema "Currency" [{"id" "USD"} {"id" "AUD"}] {:type "fiat"} ["*/data"] {})) => +check-tree-base+)

^{:refer xt.db.text.base-tree/tree-count :setup [(def +input-tree-count+ {:view {:type "select" :query {"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" :name "EnumCurrencyType" :schema "scratch-sample-db"}]}} :tag "by_type" :table "Currency"} :return "jsonb" :input [{:type "text" :symbol "i_type"}] :id "currency_by_type" :schema "scratch-sample-db" :flags {:public true}}) (def +check-tree-count+ ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" [] "custom" [{"::" "sql/count"}] "links" []}])] :added "4.1"} (fact "provides a count tree" (!.js (v/tree-count sample/Schema ((deref !) +input-tree-count+) {} {})) => +check-tree-count+)

^{:refer xt.db.text.base-tree/tree-select :setup [(def +input-tree-select+ {:view {:type "select" :query {"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" :name "EnumCurrencyType" :schema "scratch-sample-db"}]}} :tag "by_type" :table "Currency"} :return "jsonb" :input [{:type "text" :symbol "i_type"}] :id "currency_by_type" :schema "scratch-sample-db" :flags {:public true}}) (def +check-tree-select+ ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "{{i_type}}"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" ["id"] "custom" [] "links" []}])] :added "4.1"} (fact "provides a select tree" (!.js (v/tree-select sample/Schema ((deref !) +input-tree-select+) {} {})) => +check-tree-select+)

^{:refer xt.db.text.base-tree/tree-return :setup [(def +input-tree-return+ {:view {:type "return" :query ["id" "description"] :table "Currency"}}) (def +check-tree-return+ ["Currency" {"where" [{"id" "{{RETURN}}"}] "data" ["id" "description"] "custom" [] "links" []}])] :added "4.1"} (fact "provides a return tree" (!.js (v/tree-return sample/Schema ((deref !) +input-tree-return+) {"id" "{{RETURN}}"} {} {})) => +check-tree-return+)

^{:refer xt.db.text.base-tree/tree-combined :setup [(def +input-tree-combined-select+ {:view {:type "select" :query {"type" "fiat"} :table "Currency"} :control {:limit 5}}) (def +input-tree-combined-return+ {:view {:type "return" :query ["id" "name"] :table "Currency"}}) (def +check-tree-combined+ ["Currency" {"where" [{"type" "fiat"}] "data" ["id" "name"] "custom" [{"::" "sql/keyword" "name" "LIMIT" "args" [{"::" "sql/keyword" "name" 5}]}] "links" []}])] :added "4.1"} (fact "provides a combined tree" (!.js (v/tree-combined sample/Schema ((deref !) +input-tree-combined-select+) ((deref !) +input-tree-combined-return+) nil {} {})) => +check-tree-combined+)

^{:refer xt.db.text.base-tree/tree-fill-input :added "4.1"} (fact "fills placeholders from the input spec" (!.js (v/tree-fill-input ["Currency" {"where" [{"type" "{{i_type}}"}] "data" ["id"] "custom" [] "links" []}] ["fiat"] [{"symbol" "i_type" "type" "text"}] false)) => ["Currency" {"where" [{"type" "fiat"}] "data" ["id"] "custom" [] "links" []}])

^{:refer xt.db.text.base-tree/plan-select :added "4.1"} (fact "plans a select tree with filled input" (!.js (v/plan-select sample/Schema ((deref !) +input-tree-select+) ["fiat"] {})) => ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "fiat"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" ["id"] "custom" [] "links" []}])

^{:refer xt.db.text.base-tree/plan-count :added "4.1"} (fact "plans a count tree with filled input" (!.js (v/plan-count sample/Schema ((deref !) +input-tree-count+) ["crypto"] {})) => ["Currency" {"where" [{"type" {"::" "sql/cast" "args" [{"::" "sql/arg" "name" "crypto"} {"::" "sql/defenum" "schema" "scratch-sample-db" "name" "EnumCurrencyType"}]}}] "data" [] "custom" [{"::" "sql/count"}] "links" []}])

^{:refer xt.db.text.base-tree/plan-return :setup [(def +input-plan-return+ {:view {:type "return" :query ["id" "description" {"::" "sql/arg" "name" "{{i_note}}"}] :table "Currency"} :input [{:type "text" :symbol "i_currency_id"} {:type "text" :symbol "i_note"}]})] :added "4.1"} (fact "plans a return tree and drops the first input placeholder" (!.js (v/plan-return sample/Schema ((deref !) +input-plan-return+) "STATS" ["hello"] {})) => ["Currency" {"where" [{"id" "STATS"}] "data" ["id" "description"] "custom" [{"::" "sql/arg" "name" "hello"}] "links" []}])

^{:refer xt.db.text.base-tree/plan-return-bulk :setup [(def +input-plan-return-bulk+ {:view {:type "return" :query ["id" "description"] :table "Currency"} :input [{:type "text" :symbol "i_currency_id"}]})] :added "4.1"} (fact "plans a bulk return tree" (!.js (v/plan-return-bulk sample/Schema ((deref !) +input-plan-return-bulk+) ["STATS" "USD"] [] {})) => ["Currency" {"where" [{"id" ["in" [["STATS" "USD"]]]}] "data" ["id" "description"] "custom" [] "links" []}])

^{:refer xt.db.text.base-tree/plan-combined :setup [(def +input-plan-combined-select+ {:view {:type "select" :query {"type" "{{i_type}}"} :table "Currency"} :control {:limit 2} :input [{:type "text" :symbol "i_type"}]}) (def +input-plan-combined-return+ {:view {:type "return" :query ["id" {"::" "sql/arg" "name" "{{i_note}}"}] :table "Currency"} :input [{:type "text" :symbol "i_currency_id"} {:type "text" :symbol "i_note"}]})] :added "4.1"} (fact "plans a combined tree with filled select and return input" (!.js (v/plan-combined sample/Schema ((deref !) +input-plan-combined-select+) ["fiat"] ((deref !) +input-plan-combined-return+) ["note"] nil {} true)) => ["Currency" {"where" [{"type" "fiat"}] "data" ["id"] "custom" [{"::" "sql/arg" "name" "note"} {"::" "sql/keyword" "name" "LIMIT" "args" [{"::" "sql/keyword" "name" 2}]}] "links" []}])

^{:refer xt.db.text.base-tree/plan-view-check :added "4.1"} (fact "checks query arguments against the entry input" (!.js [(v/plan-view-check {"input" [{"symbol" "i_type" "type" "text"}]} ["fiat"] false) (v/plan-view-check {"input" [{"symbol" "i_type" "type" "text"}]} [1] false)]) => [[true nil] [false {"data" {"input" 1 "spec" {"symbol" "i_type" "type" "text"}} "status" "error" "tag" "net/arg-typecheck-failed"}]])

^{:refer xt.db.text.base-tree/plan-view :setup [(def +input-plan-view-select+ {:view {:type "select" :query {"type" "{{i_type}}"} :table "Currency"} :control {:limit 2} :input [{"symbol" "i_type" "type" "text"}]}) (def +input-plan-view-return+ {:view {:type "return" :query ["id" {"::" "sql/arg" "name" "{{i_note}}"}] :table "Currency"} :input [{"symbol" "i_currency_id" "type" "text"} {"symbol" "i_note" "type" "text"}]})] :added "4.1"} (fact "plans a db query from entries and schema" (!.js (var [ok tree] (v/plan-view sample/Schema {:return-args ["note"] :select-args ["fiat"] :table "Currency" :return-entry ((deref !) +input-plan-view-return+) :select-entry ((deref !) +input-plan-view-select+)})) [ok (xt/x:first tree) (xtd/get-in tree [1 "where" 0 "type"]) (xtd/get-in tree [1 "data"])]) => [true "Currency" "fiat" ["id"]] (!.js (var [ok tree] (v/plan-view sample/Schema {:select-args ["fiat"] :table "Currency" :select-entry ((deref !) +input-plan-view-select+)})) [ok (xt/x:first tree) (xtd/get-in tree [1 "where" 0 "type"]) (xtd/get-in tree [1 "data"])]) => [true "Currency" "fiat" ["id"]] (!.js (var [ok tree] (v/plan-view sample/Schema {:return-args ["hello"] :table "Currency" :return-entry ((deref !) +input-plan-return+) :return-id "STATS"})) [ok (xt/x:first tree) (xtd/get-in tree [1 "where" 0 "id"]) (xtd/get-in tree [1 "data"])]) => [true "Currency" "STATS" ["id" "description"]] (!.js (var [ok tree] (v/plan-view sample/Schema {:return-bulk ["STATS" "USD"] :return-args [] :table "Currency" :return-entry ((deref !) +input-plan-return-bulk+)})) [ok (xt/x:first tree) (xtd/get-in tree [1 "where" 0 "id"])]) => [true "Currency" ["in" [["STATS" "USD"]]]])
