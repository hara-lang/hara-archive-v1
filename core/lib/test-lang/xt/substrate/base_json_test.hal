(ns xt.substrate.base-json-test (:use code.test) (:require [lang.core :as l]))

^{:seedgen/root {:all true}} (l/script- :js {:runtime :basic :require [[xt.substrate.base-frame :as frame] [xt.substrate.base-json :as node-json] [xt.substrate.base-router :as router] [xt.lang.spec-base :as xt]]})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.substrate.base-json/frame-kind? :added "4.1"} (fact "recognises supported JSON wire kinds" (!.js [(node-json/frame-kind? frame/KIND_REQUEST) (node-json/frame-kind? frame/KIND_RESPONSE) (node-json/frame-kind? frame/KIND_STREAM) (node-json/frame-kind? router/KIND_SUBSCRIBE) (node-json/frame-kind? "unknown")]) => [true true true true false])

^{:refer xt.substrate.base-json/valid-frame? :added "4.1"} (fact "validates request, response and stream frames" (!.js [(node-json/valid-frame? {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-1" "args" ["ping"]}) (node-json/valid-frame? {"space" "room/a" "reply_to" "req-1" "status" "ok" "kind" "response" "id" "res-1"}) (node-json/valid-frame? {"space" "room/a" "signal" "demo/update" "kind" "stream" "id" "evt-1"}) (node-json/valid-frame? {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-2" "args" {"bad" true}}) (node-json/valid-frame? {"space" "room/a" "kind" "invalid" "id" "req-3"})]) => [true true true false false])

^{:refer xt.substrate.base-json/normalize-error :added "4.1"} (fact "normalises arbitrary errors into JSON-safe maps" (!.js [(node-json/normalize-error nil) (node-json/normalize-error "broken") (node-json/normalize-error {"error" "denied"}) (node-json/normalize-error {"status" "error"}) (node-json/normalize-error 42)]) => [nil {"message" "broken"} {"message" "denied" "error" "denied"} {"message" "error" "status" "error"} {"message" "42"}])

^{:refer xt.substrate.base-json/normalize-frame :added "4.1"} (fact "normalises response error payloads before emission" (!.js [(node-json/normalize-frame {"space" "room/a" "error" {"error" "denied"} "reply_to" "req-1" "status" "error" "kind" "response" "id" "res-1"}) (node-json/normalize-frame {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-1" "args" []})]) => [{"space" "room/a" "error" {"message" "denied" "error" "denied"} "reply_to" "req-1" "status" "error" "kind" "response" "id" "res-1"} {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-1" "args" []}])

^{:refer xt.substrate.base-json/encode-frame :added "4.1"} (fact "encodes validated frames as JSON text" (!.js (xt/x:json-decode (node-json/encode-frame {"space" "room/a" "error" {"error" "denied"} "reply_to" "req-1" "status" "error" "kind" "response" "id" "res-1"}))) => {"space" "room/a" "error" {"message" "denied" "error" "denied"} "reply_to" "req-1" "status" "error" "kind" "response" "id" "res-1"})

^{:refer xt.substrate.base-json/decode-frame :added "4.1"} (fact "decodes JSON text and validates direct frame inputs" (!.js [(node-json/decode-frame "{\"kind\":\"stream\",\"id\":\"evt-1\",\"space\":\"room/a\",\"signal\":\"demo/update\",\"data\":{\"ok\":true}}") (node-json/decode-frame {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-1" "args" ["ping"]})]) => [{"space" "room/a" "signal" "demo/update" "data" {"ok" true} "kind" "stream" "id" "evt-1"} {"space" "room/a" "kind" "request" "action" "demo/echo" "id" "req-1" "args" ["ping"]}])
