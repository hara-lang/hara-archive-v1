(ns xt.substrate.walkthrough.s03-transport-test (:use code.test) (:require [lang.core :as l] [xt.lang.common-notify :as notify]))

^{:seedgen/root {:all true :langs [:js :lua :python]}} (l/script- :js {:runtime :basic :require [[xt.lang.spec-base :as xt] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.substrate :as substrate] [xt.substrate.base-frame :as frame] [xt.substrate.transport-memory :as transport-memory]]})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.substrate.walkthrough.s03-transport-test/demo-000-stream-frame-basic} (fact "frame transport with trigger" (!.js (frame/stream-frame "space/a" "event/ping" {"data" 1} {})) => (contains {"meta" {} "space" "space/a" "signal" "event/ping" "data" {"data" 1} "kind" "stream" "id" string?}) (notify/wait-on :js (var server (substrate/node-create {"id" "server" "triggers" {"event/ping" {"meta" {"kind" "stream"} "fn" (fn [space stream node] (repl/notify stream))}}})) (var client (substrate/node-create {"id" "client"})) (substrate/attach-transport client "server" {"send_fn" (fn [frame] (return (substrate/receive-frame server frame {"transport_id" "client"})))}) (var frame (frame/stream-frame "space/a" "event/ping" {"data" 1} {})) (substrate/transport-send client "server" frame)) => (contains {"meta" {} "space" "space/a" "signal" "event/ping" "data" {"data" 1} "kind" "stream" "id" string?}))

^{:refer xt.substrate.walkthrough.s03-transport-test/demo-001-stream-frame-trigger} (fact "frame transport with trigger" (notify/wait-on :js (var server (substrate/node-create {"id" "server" "triggers" {"event/ping" {"meta" {"kind" "stream"} "fn" (fn [space stream node] (var data (xt/x:get-key stream "data")) (var current-state (substrate/get-space-state node (. space ["id"]))) (substrate/set-space-state node (. space ["id"]) (xt/x:obj-assign (or current-state {}) {"pinged" data})) (repl/notify space))}}})) (var client (substrate/node-create {"id" "client"})) (substrate/attach-transport client "server" {"send_fn" (fn [frame] (return (substrate/receive-frame server frame {"transport_id" "client"})))}) (var frame (frame/stream-frame "space/a" "event/ping" {"data" 1} {})) (substrate/transport-send client "server" frame)) => {"meta" {} "state" {"pinged" {"data" 1}} "id" "space/a"})

^{:refer xt.substrate.walkthrough.s03-transport-test/demo-002-request-frame-handle} (fact "frame transport with request" (!.js (frame/request-frame "space/a" "demo/echo" ["ping"] {})) => (contains-in {"meta" {} "space" "space/a" "kind" "request" "action" "demo/echo" "id" string? "args" ["ping"]}) (notify/wait-on :js (var server (substrate/node-create {"handlers" {"demo/echo" {"meta" {"kind" "request"} "fn" (fn [space args request node] (return {"pong" true "args" args}))}} "id" "server"})) (var client (substrate/node-create {"id" "client"})) (substrate/attach-transport client "server" {"send_fn" (fn [frame] (return (substrate/receive-frame server frame {"transport_id" "client"})))}) (substrate/attach-transport server "client" {"send_fn" (fn [frame] (return (substrate/receive-frame client frame {"transport_id" "server"})))}) (-> (substrate/request client "space/a" "demo/echo" ["ping"] {}) (promise/x:promise-then (fn [out] (repl/notify out))))) => {"pong" true "args" ["ping"]})
