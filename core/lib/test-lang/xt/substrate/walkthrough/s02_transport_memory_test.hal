(ns xt.substrate.walkthrough.s02-transport-memory-test (:use code.test) (:require [lang.core :as l] [xt.lang.common-notify :as notify]))

^{:seedgen/root {:all true :langs [:js :lua :python]}} (l/script- :js {:runtime :basic :require [[xt.lang.spec-base :as xt] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.substrate :as event-node] [xt.substrate.transport-memory :as transport-memory]]})

(fact:global {:teardown [(l/rt:stop)] :setup [(l/rt:restart)]})

^{:refer xt.substrate.walkthroug.s02-transport-memory-test/f00-memory-pair :added "4.1"} (fact "two nodes talk to each other over the memory transport" (notify/wait-on :js (var server (event-node/node-create {"handlers" {"demo/echo" {"meta" {"kind" "request"} "fn" (fn [space args request server-node] (return {"server" (. server-node ["id"]) "space" (. space ["id"]) "action" (. request ["action"]) "args" args}))}} "id" "server"})) (var client (event-node/node-create {"id" "client"})) (var wire (transport-memory/memory-pair {"left_id" "client" "right_id" "server"})) (-> (promise/x:promise-all [(event-node/attach-transport client "server" (transport-memory/text-endpoint (. wire ["left"]))) (event-node/attach-transport server "client" (transport-memory/text-endpoint (. wire ["right"])))]) (promise/x:promise-then (fn [_] (return (event-node/request client "room/a" "demo/echo" ["ping"] nil)))) (repl/notify))) => {"server" "server" "space" "room/a" "action" "demo/echo" "args" ["ping"]})
