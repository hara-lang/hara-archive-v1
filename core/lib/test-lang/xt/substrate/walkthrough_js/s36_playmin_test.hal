(ns xt.substrate.walkthrough-js.s36-playmin-test "Walkthrough test demonstrating js.react.ext-page against a substrate node\n   running inside a browser page served by the `:playground` runtime.\n\n   The `:playground` runtime starts an http-kit server that serves an HTML\n   page with an embedded WebSocket eval client. A headless Chrome instance is\n   navigated to that page, the substrate/React modules are scaffolded into the\n   browser over the WebSocket, and then `!.js` forms drive substrate page\n   models through `js.react.ext-page`." (:use code.test) (:require [lang.core :as l] [std.lib.component :as component] [xt.lang.common-notify :as notify]))

(require (quote [tahto.runtime.js-playground :as js-playground]) (quote [tahto.runtime.chromedriver :as chromedriver]))

(l/script- :js {:emit {:lang/jsx false} :config {:port 0} :require [[xt.lang.spec-base :as xt] [xt.lang.common-repl :as repl] [xt.lang.spec-promise :as promise] [xt.event.base-model :as event-model] [js.react :as r] [tahto.runtime.js-playground.client :as client]] :test-mode true :runtime :playground})

(defn- wait-for-channel "waits up to 5s for the playground websocket channel to be connected" [rt] (let [channel (:channel rt)] (loop [i 0] (when (and (< i 50) (not (deref channel))) (Thread/sleep 100) (recur (inc i))))))

(fact:global {:teardown [(l/rt:stop) (component/stop +browser+)] :setup [(l/rt:restart :js) (def +url+ (js-playground/play-url (l/rt :js))) (def +browser+ (chromedriver/browser {})) (chromedriver/goto +url+ 5000 +browser+) (wait-for-channel (l/rt :js))]})

^{:adopt true :refer xt.substrate.walkthrough-js.s35-playground-test/CANARY :added "4.1"}
(fact "basic eval reaches the playground-served browser" (!.js (+ 1 2 3)) => 6)

(comment (!.js (window.PLAYGROUND.setStage [:div "hello world"])) (!.js (+ 1 2 3)))
