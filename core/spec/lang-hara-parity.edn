{:reference
 {:repository "zcaudate-xyz/foundation-base"
  :commit "f909a44ad504cc6c9f44248d59ec3148261a48d7"
  :xtalk-grammar "src/tahto/model/spec_xtalk.clj"
  :xtalk-runtime "src/tahto/runtime/basic/impl/process_xtalk.clj"}

 :target
 {:grammar "lib/src/lang/model/v1/spec_hara.hal"
  :emitter "lib/src/lang/model/v1/spec_hara/emit.hal"
  :runtime "lib/src/lang/runtime/basic/type_hara.hal"
  :host-registration "lib/src/lang/runtime/basic/impl/process_xtalk.hal"
  :process-registration "lib/src/lang/runtime/basic/impl/process_hara.hal"
  :standard-facade "lib/src/lang/runtime/standard.hal"}

 :architecture
 {:xtalk
  "The target-neutral parent grammar and public semantic runtime coordinate."
  :hara
  "The concrete child grammar and Hara execution target."
  :standard
  "A thin XTalk-to-Hara naming facade over existing std.native types and methods."
  :coordinates
  {[:xtalk :host] :canonical-in-process
   [:hara :host] :explicit-host-alias
   [:xtalk :basic] :canonical-child-process
   [:hara :basic] :explicit-child-alias}
  :transport {:host :in-process
              :basic :process-socket}
  :child-process true
  :wire-protocol :json-lines}

 :grammar
 {:coordinate {:grammar/id :hara
               :grammar/variant :default
               :grammar/version 1}
  :parent {:grammar/id :xtalk
           :grammar/version 1}
  :emission :hara-source
  :module-symbols :flattened-vars
  :mutable-bindings :hara-atoms
  :array-values :std.native.Arr
  :object-values :std.native.Obj
  :returns :tagged-local-unwind}

 :runtime
 {:state :persistent-hara-child-namespace
  :semantic-input "XTalk AST compiled through the :hara grammar"
  :raw-input "Already-emitted Hara source"
  :result "JSON-decoded transfer-safe Hara value"
  :lifecycle [:created :started :stopped]
  :state-fields
  [:status :target :namespace :transport :evaluations :last-source
   :last-result :last-compiled? :last-error]}

 :collection-model
 {:array-storage :std.native.Arr
  :object-storage :std.native.Obj
  :array-identity :native
  :object-identity :native
  :literal-lowering {:vector :std.native.Arr/new
                     :map :std.native.Obj/new}
  :facade-policy
  "Map XTalk names and return conventions onto std.native operations; do not implement a parallel collection model."
  :semantic-glue
  [:defaulted-read :nested-path-dispatch :in-place-reverse]}

 :ported-surface
 {:control
  [:do :if :when :cond :br* :while :for:index :for:array :for:object
   :for:iter :try :catch :finally :return]
  :definitions [:fn :defn :def :defglobal]
  :mutation
  [:var := :+= :-= :*= :++ :-- x:set-key x:set-idx x:del-key
   x:obj-assign x:arr-push x:arr-pop x:arr-push-first
   x:arr-pop-first x:arr-remove x:arr-insert x:arr-reverse]
  :data
  [:std.native.Arr :std.native.Obj :sets :module-symbols :member-index]
  :portable-operations
  [:type-predicates :arrays :objects :strings :json :math :bits :apply]}

 :intentional-differences
 [{:foundation "The historical :xtalk runtime executes emitted Scheme through Chez."
   :hara "The :xtalk :host runtime evaluates in the current Hara kernel, while :xtalk :basic compiles to Hara and evaluates in a persistent Hara child process."
   :reason "The host coordinate keeps an in-process development path; the basic coordinate provides process isolation through the existing loopback socket and JSON-line transport."}
  {:foundation "Mutable target languages permit both binding reassignment and native collection mutation."
   :hara "Rebindable lexical variables use atoms, while arrays and objects remain direct std.native.Arr and std.native.Obj values."
   :reason "Hara bindings are immutable, but its native collection types already provide the XTalk mutation model one-for-one."}
  {:foundation "Target return statements are native control flow."
   :hara "Function-local return uses a tagged exception caught at the function boundary."
   :reason "Preserves early-return semantics without adding a new Hara special form."}]

 :deferred
 [:break-and-continue-unwind
  :generator-yield
  :filesystem-and-shell-capabilities
  :iterator-object-protocol-parity
  :complete-promise-operation-parity
  :full-xt-lang-corpus]

 :tests
 [{:path "lib/test-lang/lang/model/v1/spec_hara_test.hal"
   :facts 7}
  {:path "lib/test-lang/lang/runtime/standard_test.hal"
   :facts 6}
  {:path "lib/test-lang/lang/runtime/basic/impl/process_xtalk_test.hal"
   :facts 9}
  {:path "lib/test-lang/lang/runtime/basic/impl/process_hara_test.hal"
   :facts 8}
  {:path "lib/test-lang/lang/runtime/basic/transport_node_test.hal"
   :facts 8}
  {:path "lib/test-lang/lang/runtime/basic/type_common_test.hal"
   :facts 1}
  {:path "lib/test-lang/lang/runtime/basic/type_hara_test.hal"
   :facts 16}]

 :acceptance
 ["The :hara grammar resolves as a versioned child of :xtalk."
  "The :xtalk and :hara :host coordinates evaluate in the current Hara kernel without a child process."
  "The :xtalk and :hara :basic coordinates launch a persistent Hara child through tool.sh and the loopback socket transport."
  "The child evaluates JSON-line requests in one persistent namespace and returns JSON response envelopes."
  "Raw Hara definitions persist within a runtime namespace."
  "Separate host runtime namespaces isolate their persistent Vars, while child identity remains process-local."
  "XTalk vector and map literals produce std.native.Arr and std.native.Obj in the evaluator that owns them."
  "Collection mutations preserve native identity and XTalk return contracts."
  "lang.runtime.standard contains naming and semantic glue, not collection storage."
  "Canonical HAL sources and Rust packaged snapshots are identical."]}
